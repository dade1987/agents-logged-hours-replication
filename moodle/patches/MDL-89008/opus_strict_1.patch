+
+    /**
+     * Test that the maximum recording size respects the moodle/course:ignorefilesizelimits capability.
+     *
+     * @return void
+     */
+    public function test_maxrecsize_ignorefilesizelimits(): void {
+        global $DB;
+
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course();
+        $user = $generator->create_and_enrol($course, 'editingteacher');
+        $context = \context_course::instance($course->id);
+        $this->setUser($user);
+
+        $limit = 5 * 1024 * 1024;
+        $options = ['maxfiles' => 1, 'maxbytes' => $limit];
+        $expectedlimited = min(get_max_upload_file_size(), $limit);
+
+        // Without the capability, the limit is applied.
+        $teacherrole = $DB->get_record('role', ['shortname' => 'editingteacher']);
+        assign_capability('moodle/course:ignorefilesizelimits', CAP_PROHIBIT, $teacherrole->id, $context->id, true);
+        accesslib_clear_all_caches_for_unit_testing();
+        $config = plugininfo::get_plugin_configuration_for_context($context, $options, []);
+        $this->assertEquals($expectedlimited, $config['data']['params']['maxrecsize']);
+
+        // With the capability, only the server limit is applied.
+        assign_capability('moodle/course:ignorefilesizelimits', CAP_ALLOW, $teacherrole->id, $context->id, true);
+        accesslib_clear_all_caches_for_unit_testing();
+        $config = plugininfo::get_plugin_configuration_for_context($context, $options, []);
+        $this->assertEquals(get_max_upload_file_size(), $config['data']['params']['maxrecsize']);
+
+        // A maxbytes value of USER_CAN_IGNORE_FILE_SIZE_LIMITS must not result in a negative limit.
+        $options['maxbytes'] = USER_CAN_IGNORE_FILE_SIZE_LIMITS;
+        $config = plugininfo::get_plugin_configuration_for_context($context, $options, []);
+        $this->assertEquals(get_max_upload_file_size(), $config['data']['params']['maxrecsize']);
+    }
 }
