+    /**
+     * Test that users with moodle/course:ignorefilesizelimits are not limited in recording size.
+     *
+     * @covers \tiny_recordrtc\plugininfo::get_plugin_configuration_for_context
+     */
+    public function test_maxrecsize_ignorefilesizelimits(): void {
+        global $DB;
+
+        $generator = $this->getDataGenerator();
+        $context = \context_system::instance();
+        $user = $generator->create_user();
+        $this->setUser($user);
+
+        // Without the capability, the limit is the minimum of the upload limit and the module limit.
+        $config = plugininfo::get_plugin_configuration_for_context($context, ['maxbytes' => 1024], []);
+        $this->assertEquals(min(get_max_upload_file_size(), 1024), $config['data']['params']['maxrecsize']);
+        $config = plugininfo::get_plugin_configuration_for_context($context, [], []);
+        $this->assertEquals(get_max_upload_file_size(), $config['data']['params']['maxrecsize']);
+        $external = plugininfo::get_plugin_configuration_for_external($context);
+        $this->assertSame((string) get_max_upload_file_size(), $external['maxrecsize']);
+
+        // With the capability, no limit should be applied.
+        $roleid = $generator->create_role();
+        assign_capability('moodle/course:ignorefilesizelimits', CAP_ALLOW, $roleid, $context->id);
+        role_assign($roleid, $user->id, $context->id);
+        accesslib_clear_all_caches_for_unit_testing();
+
+        $config = plugininfo::get_plugin_configuration_for_context($context, ['maxbytes' => 1024], []);
+        $this->assertEquals(USER_CAN_IGNORE_FILE_SIZE_LIMITS, $config['data']['params']['maxrecsize']);
+        $external = plugininfo::get_plugin_configuration_for_external($context);
+        $this->assertSame((string) USER_CAN_IGNORE_FILE_SIZE_LIMITS, $external['maxrecsize']);
+    }
+
