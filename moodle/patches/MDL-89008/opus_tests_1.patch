+
+    /**
+     * Test that the maximum recording size respects the moodle/course:ignorefilesizelimits capability.
+     */
+    public function test_maxrecsize_ignorefilesizelimits(): void {
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course();
+        $user = $generator->create_and_enrol($course, 'editingteacher');
+        $context = \context_course::instance($course->id);
+        $this->setUser($user);
+
+        $phplimit = get_max_upload_file_size();
+        $modulelimit = 1024;
+        $options = ['maxbytes' => $modulelimit, 'maxfiles' => 1];
+
+        // Without the capability, the module limit applies.
+        $roleid = $this->getDataGenerator()->create_role();
+        assign_capability('moodle/course:ignorefilesizelimits', CAP_PROHIBIT, $roleid, $context->id);
+        role_assign($roleid, $user->id, $context->id);
+        $config = plugininfo::get_plugin_configuration_for_context($context, $options, []);
+        $this->assertEquals(min($phplimit, $modulelimit), $config['data']['params']['maxrecsize']);
+
+        // With the capability, only the PHP limit applies.
+        role_unassign($roleid, $user->id, $context->id);
+        assign_capability('moodle/course:ignorefilesizelimits', CAP_ALLOW, $roleid, $context->id, true);
+        role_assign($roleid, $user->id, $context->id);
+        $config = plugininfo::get_plugin_configuration_for_context($context, $options, []);
+        $this->assertEquals($phplimit, $config['data']['params']['maxrecsize']);
+
+        // A maxbytes of USER_CAN_IGNORE_FILE_SIZE_LIMITS must never produce a negative limit.
+        $config = plugininfo::get_plugin_configuration_for_context($context,
+            ['maxbytes' => USER_CAN_IGNORE_FILE_SIZE_LIMITS, 'maxfiles' => 1], []);
+        $this->assertEquals($phplimit, $config['data']['params']['maxrecsize']);
+    }
 }
