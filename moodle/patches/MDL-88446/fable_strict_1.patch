+    /**
+     * Test that a YouTube embed processed after an Ogv.JS supported media (e.g. .webm/.ogv)
+     * by the same plugin instance does not inherit the OgvJS techOrder (MDL-88446).
+     */
+    public function test_youtube_after_ogv_media(): void {
+        set_config('youtube', 1, 'media_videojs');
+        set_config('videoextensions', '.webm,.ogv,.mp4', 'media_videojs');
+
+        $manager = core_media_manager::instance();
+
+        // First embed an Ogv.JS supported media, this sets the ogvtech flag on the plugin instance.
+        $t = $manager->embed_url(new moodle_url('http://example.org/1.webm'));
+        $this->assertStringContainsString('mediaplugin_videojs', $t);
+        $this->assertStringContainsString('&quot;techOrder&quot;: [&quot;OgvJS&quot;]', $t);
+
+        // Now embed a YouTube video with the same manager/plugin instance.
+        $t = $manager->embed_url(new moodle_url('http://www.youtube.com/watch?v=vyrwMmsufJc'));
+        $this->youtube_plugin_engaged($t);
+        $this->assertStringNotContainsString('OgvJS', $t);
+
+        // And an Ogv.JS media again, to be sure the flag is still set when it should be.
+        $t = $manager->embed_url(new moodle_url('http://example.org/2.ogv'));
+        $this->assertStringContainsString('&quot;techOrder&quot;: [&quot;OgvJS&quot;]', $t);
+        $this->assertStringNotContainsString('youtube', $t);
+    }
+
