+    /**
+     * Test that embedding an OGV/WebM video before a YouTube video does not leak the
+     * Ogv.JS tech order into the YouTube embed (MDL-88446).
+     */
+    public function test_youtube_after_ogv(): void {
+        set_config('youtube', 1, 'media_videojs');
+
+        $manager = core_media_manager::instance();
+
+        // First embed a WebM video, which enables the Ogv.JS tech.
+        $t = $manager->embed_url(new moodle_url('http://example.org/1.webm'));
+        $this->assertStringContainsString('mediaplugin_videojs', $t);
+        $this->assertStringContainsString('&quot;techOrder&quot;: [&quot;OgvJS&quot;]', $t);
+
+        // Then embed a YouTube video using the same manager/plugin instance.
+        $t = $manager->embed_url(new moodle_url('http://www.youtube.com/watch?v=vyrwMmsufJc'));
+        $this->youtube_plugin_engaged($t);
+        $this->assertStringNotContainsString('OgvJS', $t);
+
+        // And a regular non-OGV file after a WebM one must not get the Ogv.JS tech either.
+        $t = $manager->embed_url(new moodle_url('http://example.org/1.webm'));
+        $this->assertStringContainsString('&quot;techOrder&quot;: [&quot;OgvJS&quot;]', $t);
+        $t = $manager->embed_url(new moodle_url('http://example.org/1.mp4'));
+        $this->assertStringContainsString('mediaplugin_videojs', $t);
+        $this->assertStringNotContainsString('OgvJS', $t);
+    }
+
