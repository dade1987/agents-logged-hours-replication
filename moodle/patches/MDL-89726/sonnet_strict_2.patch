--- a/public/lib/classes/output/requirements/import_map.php
+++ b/public/lib/classes/output/requirements/import_map.php
@@ -123,6 +123,26 @@ class import_map implements \JsonSerializable {
         return $importmap;
     }
 
+    /**
+     * Get the URLs of the concrete import map entries which should be preloaded.
+     *
+     * Only entries which resolve to a single file are included. Prefix entries (those ending in a slash)
+     * and entries for themes other than the current one are skipped.
+     *
+     * @return string[] The list of URLs, in import map order.
+     */
+    public function get_preload_urls(): array {
+        $urls = [];
+        foreach ($this->jsonSerialize()['imports'] as $specifier => $url) {
+            if (str_ends_with($specifier, '/') || str_contains($specifier, '/theme-')) {
+                continue;
+            }
+            $urls[] = $url;
+        }
+
+        return array_values(array_unique($urls));
+    }
+
