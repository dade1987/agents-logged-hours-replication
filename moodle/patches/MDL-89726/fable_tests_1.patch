@@ -98,6 +98,43 @@ final class outputrequirementslib_test extends \advanced_testcase {
         $this->assertFalse(strpos($requirecode, '\\'), "Output contains backslashes: " . $requirecode);
     }
 
+    /**
+     * get_import_map() emits the importmap script tag followed by modulepreload links for concrete entries.
+     */
+    public function test_get_import_map_emits_modulepreload_links(): void {
+        $this->resetAfterTest();
+
+        $page = new \moodle_page();
+        $output = $page->requires->get_import_map($page);
+        $themename = $page->theme->name;
+
+        $importmappos = strpos($output, '<script type="importmap">');
+        $this->assertNotFalse($importmappos, "Output does not contain an importmap script tag: {$output}");
+
+        $importmap = \core\di::get(\core\output\requirements\import_map::class);
+        $preloadurls = $importmap->get_preload_urls();
+        $this->assertNotEmpty($preloadurls);
+
+        foreach (['react', 'react-dom', 'tabbable', 'bootstrap', '@moodlehq/design-system'] as $specifier) {
+            $this->assertArrayHasKey($specifier, $preloadurls);
+            $link = '<link rel="modulepreload" href="' . s($preloadurls[$specifier]) . '"';
+            $linkpos = strpos($output, $link);
+            $this->assertNotFalse($linkpos, "Output does not contain modulepreload link for {$specifier}: {$output}");
+            // The modulepreload links must be emitted after the import map.
+            $this->assertGreaterThan($importmappos, $linkpos);
+        }
+
+        // The design system preload must reference the active theme.
+        $this->assertStringContainsString(
+            "@moodlehq/design-system/theme-{$themename}/index.js",
+            $preloadurls['@moodlehq/design-system'],
+        );
+
+        // Prefix entries must never be preloaded.
+        $this->assertStringNotContainsString('<link rel="modulepreload" href="' . s($preloadurls['react']) . '/', $output);
+        $this->assertSame(count($preloadurls), substr_count($output, '<link rel="modulepreload"'));
+    }
+
