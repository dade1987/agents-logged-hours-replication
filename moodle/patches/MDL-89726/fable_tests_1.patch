diff --git a/public/lib/classes/output/requirements/import_map.php b/public/lib/classes/output/requirements/import_map.php
index 7c1b1e5f69b..f96922c5c82 100644
--- a/public/lib/classes/output/requirements/import_map.php
+++ b/public/lib/classes/output/requirements/import_map.php
@@ -123,6 +123,45 @@ class import_map implements \JsonSerializable {
         return $importmap;
     }
 
+    /**
+     * Get the list of URLs which should be preloaded as modules.
+     *
+     * Only concrete (non-prefix) import map entries are returned, that is entries whose specifier does not
+     * end with a trailing slash (for example `react`, `react-dom`, `tabbable`, `bootstrap`, and the design
+     * system bundle). Prefix entries (for example `@moodle/lms/` or `react/`) cannot be preloaded because they
+     * do not resolve to a single module.
+     *
+     * For themable entries only the URL for the current theme is returned, not the dedicated per-theme entries.
+     *
+     * The resulting URLs are intended to be emitted as `<link rel="modulepreload">` tags *after* the import map
+     * so that the browser can start fetching these foundational dependencies in parallel with page parsing rather
+     * than only discovering them one import-graph level at a time.
+     *
+     * @return string[] The list of URLs to preload, keyed by specifier.
+     */
+    public function get_preload_urls(): array {
+        if (!isset($this->loader)) {
+            throw new \core\exception\coding_exception('Default loader URL must be set before fetching preload URLs.');
+        }
+
+        $urls = [];
+        foreach ($this->imports as $specifier => $importdata) {
+            if (str_ends_with($specifier, '/')) {
+                // Prefix entries do not resolve to a single module and cannot be preloaded.
+                continue;
+            }
+
+            if ($importdata->themable) {
+                $currenttheme = $this->currenttheme ? "/theme-{$this->currenttheme}" : '';
+                $urls[$specifier] = $this->loader_url_for($importdata, "{$specifier}{$currenttheme}");
+            } else {
+                $urls[$specifier] = $this->loader_url_for($importdata, $specifier);
+            }
+        }
+
+        return $urls;
+    }
+
     /**
      * Set the list of available themes by name.
      *
