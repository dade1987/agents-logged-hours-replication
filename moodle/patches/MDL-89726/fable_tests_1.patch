diff --git a/public/lib/tests/output/requirements/import_map_test.php b/public/lib/tests/output/requirements/import_map_test.php
index a69e8d0abd6..b77f75e0287 100644
--- a/public/lib/tests/output/requirements/import_map_test.php
+++ b/public/lib/tests/output/requirements/import_map_test.php
@@ -720,4 +720,66 @@ final class import_map_test extends \advanced_testcase {
 
         $this->assertEquals($expectedpath, $map->get_path_for_script(-1, $requestedpath));
     }
+
+    /**
+     * get_preload_urls() throws a coding_exception when no default loader has been set.
+     */
+    public function test_get_preload_urls_throws_without_loader(): void {
+        $this->expectException(\core\exception\coding_exception::class);
+        (\core\di::get(import_map::class))->get_preload_urls();
+    }
+
+    /**
+     * get_preload_urls() only returns concrete (non-prefix) entries, resolving themable entries to the current theme.
+     */
+    public function test_get_preload_urls_returns_concrete_entries_only(): void {
+        $map = \core\di::get(import_map::class);
+        $map->set_default_loader(new \core\url('https://example.com/esm/12345/'));
+        $map->set_current_theme('boost');
+        $map->set_available_themes(['boost', 'mytheme']);
+        $map->add_import('my-explicit', loader: new \core\url('https://cdn.example.com/my-explicit.js'));
+
+        $urls = $map->get_preload_urls();
+
+        // Standard concrete entries are preloaded.
+        $this->assertEquals('https://example.com/esm/12345/react', $urls['react']);
+        $this->assertEquals('https://example.com/esm/12345/react-dom', $urls['react-dom']);
+        $this->assertEquals('https://example.com/esm/12345/tabbable', $urls['tabbable']);
+        $this->assertEquals('https://example.com/esm/12345/bootstrap/bootstrap.js', $urls['bootstrap']);
+
+        // Themable concrete entries resolve to the active theme only.
+        $this->assertEquals(
+            'https://example.com/esm/12345/@moodlehq/design-system/theme-boost/index.js',
+            $urls['@moodlehq/design-system'],
+        );
+        $this->assertArrayNotHasKey('@moodlehq/design-system/theme-boost', $urls);
+        $this->assertArrayNotHasKey('@moodlehq/design-system/theme-mytheme', $urls);
+        $this->assertArrayNotHasKey('@moodlehq/design-system/theme-original', $urls);
+
+        // Explicit loaders are used verbatim.
+        $this->assertEquals('https://cdn.example.com/my-explicit.js', $urls['my-explicit']);
+
+        // Prefix entries are never preloaded.
+        foreach (array_keys($urls) as $specifier) {
+            $this->assertStringEndsNotWith('/', $specifier);
+        }
+        $this->assertArrayNotHasKey('@moodle/lms/', $urls);
+        $this->assertArrayNotHasKey('react/', $urls);
+        $this->assertArrayNotHasKey('react-dom/', $urls);
+        $this->assertArrayNotHasKey('bootstrap/', $urls);
+        $this->assertArrayNotHasKey('@popperjs/', $urls);
+        $this->assertArrayNotHasKey('@floating-ui/', $urls);
+    }
+
+    /**
+     * get_preload_urls() does not include a theme sub-path for themable entries when no theme is set.
+     */
+    public function test_get_preload_urls_without_current_theme(): void {
+        $map = \core\di::get(import_map::class);
+        $map->set_default_loader(new \core\url('https://example.com/'));
+
+        $urls = $map->get_preload_urls();
+
+        $this->assertEquals('https://example.com/@moodlehq/design-system/index.js', $urls['@moodlehq/design-system']);
+    }
 }
diff --git a/public/lib/tests/outputrequirementslib_test.php b/public/lib/tests/outputrequirementslib_test.php
