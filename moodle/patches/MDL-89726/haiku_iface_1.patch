--- a/public/lib/classes/output/requirements/import_map.php
+++ b/public/lib/classes/output/requirements/import_map.php
@@ -123,6 +123,28 @@ class import_map implements \JsonSerializable {
         return $importmap;
     }
 
+    /**
+     * Get the specifiers of the concrete entries in the import map that should be preloaded.
+     *
+     * Only entries which resolve to a single module are returned. Prefix entries (those ending in
+     * a slash, such as `react/` or `@moodle/lms/`) map to many files and are excluded. Themable
+     * entries are returned by their bare specifier, which is resolved to the current theme when
+     * the import map is serialized.
+     *
+     * @return string[] The list of specifiers to preload.
+     */
+    public function get_preload_specifiers(): array {
+        $specifiers = [];
+        foreach (array_keys($this->imports) as $specifier) {
+            if (str_ends_with($specifier, '/')) {
+                continue;
+            }
+            $specifiers[] = $specifier;
+        }
+
+        return $specifiers;
+    }
+
