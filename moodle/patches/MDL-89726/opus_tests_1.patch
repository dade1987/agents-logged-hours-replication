--- a/public/lib/classes/output/requirements/import_map.php
+++ b/public/lib/classes/output/requirements/import_map.php
@@ -123,6 +123,39 @@ class import_map implements \JsonSerializable {
         return $importmap;
     }
 
+    /**
+     * Get the URLs of the concrete import map entries which should be preloaded.
+     *
+     * Only bare specifiers which map to a single concrete file are included (for example `react`,
+     * `react-dom`, `tabbable`, `bootstrap`, and `@moodlehq/design-system`). Prefix (trailing slash)
+     * entries are excluded because they do not point to a file, and for themable entries only the
+     * active theme's entry is included, rather than the per-theme override entries.
+     *
+     * @return string[] List of URLs, keyed by specifier.
+     */
+    public function get_preload_urls(): array {
+        if (!isset($this->loader)) {
+            throw new \core\exception\coding_exception('Default loader URL must be set before fetching preload URLs.');
+        }
+
+        $urls = [];
+        foreach ($this->imports as $specifier => $importdata) {
+            if (str_ends_with($specifier, '/')) {
+                // Prefix entries do not resolve to a concrete file.
+                continue;
+            }
+
+            if ($importdata->themable) {
+                $currenttheme = $this->currenttheme ? "/theme-{$this->currenttheme}" : '';
+                $urls[$specifier] = $this->loader_url_for($importdata, "{$specifier}{$currenttheme}");
+            } else {
+                $urls[$specifier] = $this->loader_url_for($importdata, $specifier);
+            }
+        }
+
+        return $urls;
+    }
+
     /**
      * Set the list of available themes by name.
      *
