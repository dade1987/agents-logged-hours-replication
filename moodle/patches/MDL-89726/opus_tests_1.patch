         $this->assertEquals($expectedpath, $map->get_path_for_script(-1, $requestedpath));
     }
+
+    /**
+     * get_preload_urls() throws a coding_exception when no default loader has been set.
+     */
+    public function test_get_preload_urls_throws_without_loader(): void {
+        $this->expectException(\core\exception\coding_exception::class);
+        (\core\di::get(import_map::class))->get_preload_urls();
+    }
+
+    /**
+     * get_preload_urls() returns only concrete entries, resolved for the active theme.
+     */
+    public function test_get_preload_urls_returns_concrete_active_theme_entries(): void {
+        $map = \core\di::get(import_map::class);
+        $map->set_default_loader(new \core\url('https://example.com/esm/1/'));
+        $map->set_current_theme('boost');
+        $map->set_available_themes(['boost', 'classic']);
+
+        $urls = $map->get_preload_urls();
+        $data = $map->jsonSerialize();
+
+        $this->assertEquals([
+            '@moodlehq/design-system',
+            'react',
+            'react-dom',
+            'tabbable',
+            'bootstrap',
+        ], array_keys($urls));
+
+        $this->assertEquals('https://example.com/esm/1/react', $urls['react']);
+        $this->assertEquals('https://example.com/esm/1/react-dom', $urls['react-dom']);
+        $this->assertEquals('https://example.com/esm/1/tabbable', $urls['tabbable']);
+        $this->assertEquals('https://example.com/esm/1/bootstrap/bootstrap.js', $urls['bootstrap']);
+        $this->assertEquals(
+            'https://example.com/esm/1/@moodlehq/design-system/theme-boost/index.js',
+            $urls['@moodlehq/design-system'],
+        );
+
+        // Every preload URL must match the URL in the import map for the same specifier.
+        foreach ($urls as $specifier => $url) {
+            $this->assertEquals($data['imports'][$specifier], $url);
+        }
+    }
+
+    /**
+     * get_preload_urls() excludes prefix entries, and includes explicit loader URLs verbatim.
+     */
+    public function test_get_preload_urls_excludes_prefix_entries(): void {
+        $map = \core\di::get(import_map::class);
+        $map->set_default_loader(new \core\url('https://example.com/'));
+        $map->add_import('myprefix/', path: 'lib/myprefix');
+        $map->add_import('explicit', loader: new \core\url('https://cdn.example.com/explicit.js'));
+
+        $urls = $map->get_preload_urls();
+
+        $this->assertArrayNotHasKey('myprefix/', $urls);
+        $this->assertArrayNotHasKey('@moodle/lms/', $urls);
+        $this->assertArrayNotHasKey('react/', $urls);
+        $this->assertEquals('https://cdn.example.com/explicit.js', $urls['explicit']);
+    }
 }
diff --git a/public/lib/tests/outputrequirementslib_test.php b/public/lib/tests/outputrequirementslib_test.php
index 1acd2fe2b6d..c489d4ba0de 100644
--- a/public/lib/tests/outputrequirementslib_test.php
+++ b/public/lib/tests/outputrequirementslib_test.php
@@ -366,4 +366,38 @@ final class outputrequirementslib_test extends \advanced_testcase {
             ],
         ];
     }
+
+    /**
+     * The import map output includes modulepreload links for concrete entries, after the importmap script.
+     */
+    public function test_get_import_map_includes_modulepreload_links(): void {
+        $this->resetAfterTest();
+
+        $page = new \moodle_page();
+        $page->set_url('/index.php');
+        $page->set_context(\context_system::instance());
+
+        $output = $page->requires->get_import_map($page);
+
+        $importmappos = strpos($output, '<script type="importmap">');
+        $this->assertNotFalse($importmappos);
+
+        $this->assertMatchesRegularExpression('#<link rel="modulepreload" href="[^"]*/react"#', $output);
+        $this->assertMatchesRegularExpression('#<link rel="modulepreload" href="[^"]*/react-dom"#', $output);
+        $this->assertMatchesRegularExpression('#<link rel="modulepreload" href="[^"]*/tabbable"#', $output);
+        $this->assertMatchesRegularExpression('#<link rel="modulepreload" href="[^"]*/bootstrap/bootstrap.js"#', $output);
+        $themename = $page->theme->name;
+        $this->assertMatchesRegularExpression(
+            "#<link rel=\"modulepreload\" href=\"[^\"]*/@moodlehq/design-system/theme-{$themename}/index.js\"#",
+            $output,
+        );
+
+        // No prefix entries, or inactive theme entries, are preloaded.
+        $this->assertDoesNotMatchRegularExpression('#<link rel="modulepreload" href="[^"]*/"#', $output);
+        $this->assertDoesNotMatchRegularExpression('#<link rel="modulepreload" href="[^"]*/theme-original/#', $output);
+
+        // All modulepreload links come after the importmap.
+        $firstpreload = strpos($output, '<link rel="modulepreload"');
+        $this->assertGreaterThan($importmappos, $firstpreload);
+    }
 }
