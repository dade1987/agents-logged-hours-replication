diff --git a/public/lib/classes/output/requirements/import_map.php b/public/lib/classes/output/requirements/import_map.php
index 7c1b1e5f69b..9173444336e 100644
--- a/public/lib/classes/output/requirements/import_map.php
+++ b/public/lib/classes/output/requirements/import_map.php
@@ -123,6 +123,26 @@ class import_map implements \JsonSerializable {
         return $importmap;
     }
 
+    /**
+     * Get the specifiers of concrete (non-prefix) import map entries which should be preloaded.
+     *
+     * Prefix entries (those ending in a slash) are excluded, as are the per-theme variants of themable
+     * entries. A themable entry is represented by its plain specifier, which resolves to the active theme.
+     *
+     * @return string[] List of specifiers, each of which is a key in the serialized import map.
+     */
+    public function get_preload_specifiers(): array {
+        $specifiers = [];
+        foreach (array_keys($this->imports) as $specifier) {
+            if (str_ends_with($specifier, '/')) {
+                continue;
+            }
+            $specifiers[] = $specifier;
+        }
+
+        return $specifiers;
+    }
+
