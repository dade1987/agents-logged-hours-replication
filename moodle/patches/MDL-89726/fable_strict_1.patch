+++ b/public/lib/classes/output/requirements/import_map.php
@@ -123,6 +123,42 @@ class import_map implements \JsonSerializable {
         return $importmap;
     }
 
+    /**
+     * Get the list of URLs which should be preloaded using `<link rel="modulepreload">`.
+     *
+     * Only concrete entries (those whose bare specifier resolves to a single module file, such as
+     * `react`, `react-dom`, `tabbable`, `bootstrap`, and the design-system bundle) are returned.
+     * Prefix entries (specifiers ending in `/`) cannot be preloaded because they do not point at a
+     * file, and the per-theme variants of themable entries are excluded so that only the entry
+     * resolved for the active theme is preloaded.
+     *
+     * The returned URLs match those emitted for the same specifiers in {@see jsonSerialize()}.
+     *
+     * @return string[] List of URLs, keyed by specifier.
+     */
+    public function get_preload_urls(): array {
+        if (!isset($this->loader)) {
+            throw new \core\exception\coding_exception('Default loader URL must be set before fetching preload URLs.');
+        }
+
+        $urls = [];
+        foreach ($this->imports as $specifier => $importdata) {
+            if (str_ends_with($specifier, '/')) {
+                // Prefix entries do not point at a concrete module.
+                continue;
+            }
+
+            if ($importdata->themable) {
+                $currenttheme = $this->currenttheme ? "/theme-{$this->currenttheme}" : '';
+                $urls[$specifier] = $this->loader_url_for($importdata, "{$specifier}{$currenttheme}");
+            } else {
+                $urls[$specifier] = $this->loader_url_for($importdata, $specifier);
+            }
+        }
+
+        return $urls;
+    }
+
