diff --git a/public/lib/tests/output/requirements/import_map_test.php b/public/lib/tests/output/requirements/import_map_test.php
index a69e8d0abd6..fa79402597c 100644
--- a/public/lib/tests/output/requirements/import_map_test.php
+++ b/public/lib/tests/output/requirements/import_map_test.php
@@ -720,4 +720,76 @@ final class import_map_test extends \advanced_testcase {
 
         $this->assertEquals($expectedpath, $map->get_path_for_script(-1, $requestedpath));
     }
+
+    /**
+     * get_preload_urls() throws a coding_exception when no default loader has been set.
+     */
+    public function test_get_preload_urls_throws_without_loader(): void {
+        $this->expectException(\core\exception\coding_exception::class);
+        (\core\di::get(import_map::class))->get_preload_urls();
+    }
+
+    /**
+     * get_preload_urls() only returns concrete entries, resolved for the current theme, and excludes
+     * prefix entries and the per-theme variants of themable entries.
+     */
+    public function test_get_preload_urls_returns_concrete_active_theme_entries(): void {
+        $map = \core\di::get(import_map::class);
+        $map->set_default_loader(new \core\url('https://example.com/esm/12345/'));
+        $map->set_current_theme('boost');
+        $map->set_available_themes(['boost', 'mytheme']);
+
+        $urls = $map->get_preload_urls();
+        $data = $map->jsonSerialize();
+
+        // Concrete standard entries are preloaded.
+        foreach (['react', 'react-dom', 'tabbable', 'bootstrap', '@moodlehq/design-system'] as $specifier) {
+            $this->assertArrayHasKey($specifier, $urls);
+            // The preload URL matches the URL in the import map for the same specifier.
+            $this->assertEquals($data['imports'][$specifier], $urls[$specifier]);
+        }
+
+        $this->assertEquals('https://example.com/esm/12345/react', $urls['react']);
+        $this->assertEquals('https://example.com/esm/12345/bootstrap/bootstrap.js', $urls['bootstrap']);
+        $this->assertEquals(
+            'https://example.com/esm/12345/@moodlehq/design-system/theme-boost/index.js',
+            $urls['@moodlehq/design-system'],
+        );
+
+        // Prefix entries are not preloaded.
+        foreach (['@moodle/lms/', 'react/', 'react-dom/', '@popperjs/', '@floating-ui/', 'bootstrap/'] as $specifier) {
+            $this->assertArrayNotHasKey($specifier, $urls);
+        }
+
+        // Per-theme variants of themable entries are not preloaded.
+        $this->assertArrayNotHasKey('@moodlehq/design-system/theme-original', $urls);
+        $this->assertArrayNotHasKey('@moodlehq/design-system/theme-boost', $urls);
+        $this->assertArrayNotHasKey('@moodlehq/design-system/theme-mytheme', $urls);
+    }
+
+    /**
+     * get_preload_urls() uses the plain specifier for themable entries when no current theme is set.
+     */
+    public function test_get_preload_urls_without_current_theme(): void {
+        $map = \core\di::get(import_map::class);
+        $map->set_default_loader(new \core\url('https://example.com/'));
+        $map->add_import('mylib', path: 'lib/mylib', urlsuffix: '/index.js', themable: true);
+
+        $urls = $map->get_preload_urls();
+
+        $this->assertEquals('https://example.com/mylib/index.js', $urls['mylib']);
+    }
+
+    /**
+     * get_preload_urls() returns explicit loader URLs verbatim.
+     */
+    public function test_get_preload_urls_with_explicit_loader(): void {
+        $map = \core\di::get(import_map::class);
+        $map->set_default_loader(new \core\url('https://example.com/'));
+        $map->add_import('my-module', loader: new \core\url('https://cdn.example.com/my-module.js'));
+
+        $urls = $map->get_preload_urls();
+
+        $this->assertEquals('https://cdn.example.com/my-module.js', $urls['my-module']);
+    }
