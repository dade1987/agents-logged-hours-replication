diff --git a/public/lib/classes/output/requirements/page_requirements_manager.php b/public/lib/classes/output/requirements/page_requirements_manager.php
index f13039d2d28..47d4f264621 100644
--- a/public/lib/classes/output/requirements/page_requirements_manager.php
+++ b/public/lib/classes/output/requirements/page_requirements_manager.php
@@ -1063,14 +1063,32 @@ class page_requirements_manager {
         $themes = core_component::get_all_plugins_list('theme');
         $importmap->set_available_themes(array_keys($themes));
 
-        return html_writer::tag(
+        $importmapdata = $importmap->jsonSerialize();
+
+        // The import map must be output before any module-related resource (including modulepreload links),
+        // otherwise browsers will not use it to resolve bare specifiers.
+        $output = html_writer::tag(
             'script',
             json_encode(
-                $importmap,
+                $importmapdata,
                 JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES
             ),
             ['type' => 'importmap'],
         );
+
+        // Preload the concrete, active-theme entries so that the browser can fetch these foundational
+        // dependencies in parallel with page parsing, rather than discovering them one import level at a time.
+        foreach ($importmap->get_preload_specifiers() as $specifier) {
+            if (!isset($importmapdata['imports'][$specifier])) {
+                continue;
+            }
+            $output .= "\n" . html_writer::empty_tag('link', [
+                'rel' => 'modulepreload',
+                'href' => $importmapdata['imports'][$specifier],
+            ]);
+        }
+
+        return $output;
     }
 
