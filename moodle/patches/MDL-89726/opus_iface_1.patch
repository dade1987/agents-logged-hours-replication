diff --git a/public/lib/classes/output/requirements/import_map.php b/public/lib/classes/output/requirements/import_map.php
index 7c1b1e5f69b..f480da934fb 100644
--- a/public/lib/classes/output/requirements/import_map.php
+++ b/public/lib/classes/output/requirements/import_map.php
@@ -123,6 +123,33 @@ class import_map implements \JsonSerializable {
         return $importmap;
     }
 
+    /**
+     * Get the list of import map specifiers which should be preloaded using `modulepreload`.
+     *
+     * Only concrete (non-prefix) specifiers are returned. Prefix specifiers, which end with a trailing slash
+     * (for example `react/` or `@moodle/lms/`), do not identify a single module and cannot be preloaded.
+     *
+     * For themable imports only the default specifier is returned. That entry already resolves to the
+     * active theme's version of the module, so the per-theme entries (e.g. `@moodlehq/design-system/theme-boost`)
+     * are not included.
+     *
+     * The returned specifiers are keys of the serialised import map.
+     *
+     * @return string[]
+     */
+    public function get_preload_specifiers(): array {
+        $specifiers = [];
+        foreach ($this->imports as $specifier => $importdata) {
+            if (str_ends_with($specifier, '/')) {
+                // Prefix entries cannot be preloaded as they do not refer to a single module.
+                continue;
+            }
+            $specifiers[] = $specifier;
+        }
+
+        return $specifiers;
+    }
+
