+    /**
+     * get_preload_specifiers() returns only concrete specifiers which exist in the serialised import map.
+     */
+    public function test_get_preload_specifiers(): void {
+        $map = \core\di::get(import_map::class);
+        $map->set_default_loader(new \core\url('https://example.com/'));
+        $map->set_current_theme('boost');
+        $map->set_available_themes(['boost', 'classic']);
+
+        $specifiers = $map->get_preload_specifiers();
+
+        $this->assertContains('react', $specifiers);
+        $this->assertContains('react-dom', $specifiers);
+        $this->assertContains('tabbable', $specifiers);
+        $this->assertContains('bootstrap', $specifiers);
+        $this->assertContains('@moodlehq/design-system', $specifiers);
+
+        // Prefix entries and theme-specific entries are not preloaded.
+        $this->assertNotContains('react/', $specifiers);
+        $this->assertNotContains('@moodle/lms/', $specifiers);
+        $this->assertNotContains('@moodlehq/design-system/theme-boost', $specifiers);
+        foreach ($specifiers as $specifier) {
+            $this->assertStringEndsNotWith('/', $specifier);
+        }
+
+        $data = $map->jsonSerialize();
+        foreach ($specifiers as $specifier) {
+            $this->assertArrayHasKey($specifier, $data['imports']);
+        }
+        $this->assertEquals(
+            'https://example.com/@moodlehq/design-system/theme-boost/index.js',
+            $data['imports']['@moodlehq/design-system'],
+        );
+    }
+
