+        $map->set_current_theme('boost');
+        $map->set_available_themes(['boost']);
+        $map->add_import('mylib', path: 'lib/mylib/index', themable: true);
+        $map->add_import('myprefix/', path: 'lib/myprefix');
+
+        $specifiers = $map->get_preload_specifiers();
+        $this->assertContains('mylib', $specifiers);
+        $this->assertNotContains('myprefix/', $specifiers);
