@@ -123,6 +123,38 @@ class import_map implements \JsonSerializable {
         return $importmap;
     }
 
+    /**
+     * Get the list of import map specifiers that should be preloaded via `<link rel="modulepreload">`.
+     *
+     * Only concrete (non-prefix) specifiers are candidates for preloading: a prefix specifier such as
+     * `@moodle/lms/` or `react/` maps a whole namespace to a directory and therefore does not identify
+     * a single module that could be fetched ahead of time. The concrete entries (for example `react`,
+     * `react-dom`, `tabbable`, `bootstrap` and the design-system bundle) are foundational dependencies
+     * imported by virtually every ESM page, so hinting them to the browser lets it fetch them in parallel
+     * with page parsing instead of discovering them one import-graph level at a time.
+     *
+     * For themable entries only the default (active-theme) specifier is returned, which resolves to the
+     * active theme's override, or the default implementation, exactly as the import map itself does.
+     * The per-theme variants (`<specifier>/theme-<name>`) are not preloaded as only one of them is used.
+     *
+     * The returned specifiers are keys of the `imports` array produced by {@see jsonSerialize()}.
+     *
+     * @return string[] The list of bare specifiers to preload.
+     */
+    public function get_preload_specifiers(): array {
+        $specifiers = [];
+
+        foreach (array_keys($this->imports) as $specifier) {
+            if (str_ends_with($specifier, '/')) {
+                // Prefix specifiers map to a directory and cannot be preloaded as a single module.
+                continue;
+            }
+            $specifiers[] = $specifier;
+        }
+
+        return $specifiers;
+    }
+
