@@ -123,6 +123,39 @@ class import_map implements \JsonSerializable {
         return $importmap;
     }
 
+    /**
+     * Get the list of URLs which should be preloaded using `<link rel="modulepreload">`.
+     *
+     * Only concrete entries are included - that is entries which resolve to a single module file.
+     * Prefix entries (those whose specifier ends with a `/`) cannot be preloaded as they do not refer to a file.
+     *
+     * For themable entries, only the entry for the active theme is included, rather than one entry per available theme.
+     *
+     * @return string[] The list of unique URLs to preload.
+     */
+    public function get_preload_urls(): array {
+        if (!isset($this->loader)) {
+            throw new \core\exception\coding_exception('Default loader URL must be set before fetching preload URLs.');
+        }
+
+        $urls = [];
+        foreach ($this->imports as $specifier => $importdata) {
+            if (str_ends_with($specifier, '/')) {
+                // Prefix entries do not resolve to a concrete module and cannot be preloaded.
+                continue;
+            }
+
+            if ($importdata->themable && $this->currenttheme) {
+                // Only preload the active theme's version of the module.
+                $specifier = "{$specifier}/theme-{$this->currenttheme}";
+            }
+
+            $urls[] = $this->loader_url_for($importdata, $specifier);
+        }
+
+        return array_values(array_unique($urls));
+    }
+
     /**
      * Set the list of available themes by name.
