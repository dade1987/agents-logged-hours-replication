+    /**
+     * get_preload_urls() returns only concrete, active-theme entries for the standard imports.
+     */
+    public function test_get_preload_urls_standard_imports(): void {
+        $map = \core\di::get(import_map::class);
+        $map->set_default_loader(new \core\url('https://example.com/esm/12345/'));
+        $map->set_current_theme('boost');
+        $map->set_available_themes(['boost', 'classic']);
+
+        $urls = $map->get_preload_urls();
+
+        $base = 'https://example.com/esm/12345/';
+        $this->assertContains("{$base}react", $urls);
+        $this->assertContains("{$base}react-dom", $urls);
+        $this->assertContains("{$base}tabbable", $urls);
+        $this->assertContains("{$base}bootstrap/bootstrap.js", $urls);
+        $this->assertContains("{$base}@moodlehq/design-system/theme-boost/index.js", $urls);
+
+        // Prefix entries and other themes are never preloaded.
+        $this->assertNotContains("{$base}@moodle/lms/", $urls);
+        $this->assertNotContains("{$base}@moodle/lms/theme-boost/", $urls);
+        $this->assertNotContains("{$base}react/", $urls);
+        $this->assertNotContains("{$base}@moodlehq/design-system/theme-classic/index.js", $urls);
+        $this->assertNotContains("{$base}@moodlehq/design-system/theme-original/index.js", $urls);
+        foreach ($urls as $url) {
+            $this->assertStringEndsNotWith('/', $url);
+        }
+        $this->assertCount(count(array_unique($urls)), $urls);
+    }
+
+    /**
