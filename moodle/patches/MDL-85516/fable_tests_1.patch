+    /**
+     * Test that users suspended at system level are treated the same way as users whose enrolment is suspended
+     * at course level: hidden when only active users are shown, visible (and flagged as suspended) otherwise.
+     *
+     * @covers \assign::list_participants
+     * @covers \assign::is_active_user
+     */
+    public function test_list_participants_system_suspended_users(): void {
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course();
+        $teacher = $this->getDataGenerator()->create_and_enrol($course, 'editingteacher');
+        $student = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $coursesuspendedstudent = $this->getDataGenerator()->create_and_enrol(
+            $course,
+            'student',
+            null,
+            'manual',
+            0,
+            0,
+            ENROL_USER_SUSPENDED
+        );
+        $systemsuspendedstudent = $this->getDataGenerator()->create_and_enrol($course, 'student', ['suspended' => 1]);
+        $nologinstudent = $this->getDataGenerator()->create_and_enrol($course, 'student', ['auth' => 'nologin']);
+
+        $this->setUser($teacher);
+        $assign = $this->create_instance($course);
+
+        // Only active users: all kinds of suspended users are hidden.
+        set_user_preference('grade_report_showonlyactiveenrol', true);
+        $participants = $assign->list_participants(0, true);
+        $this->assertEquals([$student->id], array_keys($participants));
+        $this->assertCount(1, $assign->testable_get_grading_userid_list());
+
+        // Explicitly requesting only active users behaves the same.
+        $participants = $assign->list_participants(0, true, false, true);
+        $this->assertEquals([$student->id], array_keys($participants));
+
+        // All users: suspended users (at course or system level) are shown so they can be graded.
+        $participants = $assign->list_participants(0, true, false, false);
+        $this->assertEqualsCanonicalizing(
+            [$student->id, $coursesuspendedstudent->id, $systemsuspendedstudent->id, $nologinstudent->id],
+            array_keys($participants)
+        );
+
+        // Suspended users are flagged as not active, whatever the level they are suspended at.
+        $this->assertTrue($assign->is_active_user($student->id));
+        $this->assertFalse($assign->is_active_user($coursesuspendedstudent->id));
+        $this->assertFalse($assign->is_active_user($systemsuspendedstudent->id));
+        $this->assertFalse($assign->is_active_user($nologinstudent->id));
+
+        // The teacher can view the submission of a system suspended user as they can view suspended users.
+        $this->assertTrue($assign->can_view_submission($systemsuspendedstudent->id));
+    }
