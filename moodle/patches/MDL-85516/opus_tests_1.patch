+    /**
+     * Users suspended at system level must behave like users with a suspended course enrolment.
+     */
+    public function test_list_participants_system_suspended(): void {
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course();
+        $teacher = $this->getDataGenerator()->create_and_enrol($course, 'editingteacher');
+
+        // Create 3 active students.
+        for ($i = 0; $i < 3; $i++) {
+            $this->getDataGenerator()->create_and_enrol($course, 'student');
+        }
+        // Create 2 students with suspended course enrolment.
+        for ($i = 0; $i < 2; $i++) {
+            $this->getDataGenerator()->create_and_enrol($course, 'student', null, 'manual', 0, 0, ENROL_USER_SUSPENDED);
+        }
+        // Create 1 student suspended at system level and 1 nologin student.
+        $this->getDataGenerator()->create_and_enrol($course, 'student', ['suspended' => 1]);
+        $this->getDataGenerator()->create_and_enrol($course, 'student', ['auth' => 'nologin']);
+
+        $this->setUser($teacher);
+        $assign = $this->create_instance($course, ['grade' => 100]);
+
+        // Showing all users: all suspended users are listed.
+        set_user_preference('grade_report_showonlyactiveenrol', false);
+        $this->assertCount(7, $assign->list_participants(null, true));
+        $this->assertCount(7, $assign->list_participants(null, true, false, false));
+
+        // Showing only active users: neither kind of suspended user is listed.
+        $this->assertCount(3, $assign->list_participants(null, true, false, true));
+    }
