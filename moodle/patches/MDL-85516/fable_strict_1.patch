+    /**
+     * Users suspended at system level must be treated the same as users with a suspended course enrolment:
+     * hidden when only active participants are shown, visible otherwise.
+     *
+     * @covers \assign::list_participants
+     */
+    public function test_list_participants_system_suspended(): void {
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course();
+        $teacher = $this->getDataGenerator()->create_and_enrol($course, 'editingteacher');
+
+        // Create 5 active students.
+        for ($i = 0; $i < 5; $i++) {
+            $this->getDataGenerator()->create_and_enrol($course, 'student');
+        }
+
+        // Create 3 students with a suspended course enrolment.
+        for ($i = 0; $i < 3; $i++) {
+            $this->getDataGenerator()->create_and_enrol($course, 'student', null, 'manual', 0, 0, ENROL_USER_SUSPENDED);
+        }
+
+        // Create 2 students suspended at system level.
+        for ($i = 0; $i < 2; $i++) {
+            $this->getDataGenerator()->create_and_enrol($course, 'student', ['suspended' => 1]);
+        }
+
+        $this->setUser($teacher);
+        $assign = $this->create_instance($course, ['grade' => 100]);
+
+        // Only active users: both kinds of suspended users are hidden.
+        $this->assertCount(5, $assign->list_participants(null, true, false, true));
+
+        // All users: both kinds of suspended users are shown.
+        $this->assertCount(10, $assign->list_participants(null, true, false, false));
+    }
