+    /**
+     * System-suspended users should be treated like course-suspended users when suspended participants are shown.
+     */
+    public function test_list_participants_system_suspended(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course();
+        $teacher = $this->getDataGenerator()->create_and_enrol($course, 'teacher');
+        $student = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $systemsuspended = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $DB->set_field('user', 'suspended', 1, ['id' => $systemsuspended->id]);
+
+        $this->setUser($teacher);
+        $assign = $this->create_instance($course, ['grade' => 100]);
+
+        // Only active users: the system-suspended student is excluded.
+        set_user_preference('grade_report_showonlyactiveenrol', true);
+        $participants = $assign->list_participants(null, true);
+        $this->assertArrayHasKey($student->id, $participants);
+        $this->assertArrayNotHasKey($systemsuspended->id, $participants);
+
+        // Showing suspended participants: the system-suspended student is included, as for course suspension.
+        set_user_preference('grade_report_showonlyactiveenrol', false);
+        $participants = $assign->list_participants(null, true);
+        $this->assertArrayHasKey($student->id, $participants);
+        $this->assertArrayHasKey($systemsuspended->id, $participants);
+    }
