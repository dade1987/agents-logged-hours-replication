+    /**
+     * Test that users suspended at site level are treated the same as users suspended at course level.
+     *
+     * @covers \assign::list_participants
+     */
+    public function test_list_participants_site_suspended(): void {
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course();
+        $teacher = $this->getDataGenerator()->create_and_enrol($course, 'editingteacher');
+
+        // Create 3 active students.
+        for ($i = 0; $i < 3; $i++) {
+            $this->getDataGenerator()->create_and_enrol($course, 'student');
+        }
+
+        // Create 2 students suspended at course (enrolment) level.
+        for ($i = 0; $i < 2; $i++) {
+            $this->getDataGenerator()->create_and_enrol($course, 'student', null, 'manual', 0, 0, ENROL_USER_SUSPENDED);
+        }
+
+        // Create 4 students suspended at site level.
+        for ($i = 0; $i < 4; $i++) {
+            $this->getDataGenerator()->create_and_enrol($course, 'student', ['suspended' => 1]);
+        }
+
+        $this->setUser($teacher);
+        $assign = $this->create_instance($course, ['grade' => 100]);
+
+        // Only active users.
+        $this->assertCount(3, $assign->list_participants(null, true, false, true));
+
+        // All users, including both course and site level suspended users.
+        $this->assertCount(9, $assign->list_participants(null, true, false, false));
+    }
