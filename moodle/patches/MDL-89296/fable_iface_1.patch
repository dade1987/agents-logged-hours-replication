+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\output;
+
+/**
+ * A renderable which is rendered by mounting a React component.
+ *
+ * This interface behaves in a similar way to {@see named_templatable}, but instead of a Mustache template it
+ * provides the name of a React component (an ESM module specifier such as `@moodle/lms/block_timeline/Timeline`)
+ * and the props that should be passed to it.
+ *
+ * When such a renderable is passed to {@see renderer_base::render()}, the mount point for the component is
+ * generated using {@see html_writer::react_component()} unless the renderer defines a more specific
+ * `render_[renderable]` method, which always takes precedence. This interface takes precedence over
+ * {@see named_templatable} and {@see templatable}.
+ *
+ * @package   core
+ * @copyright 2026 Andrew Lyons <andrew@nicols.co.uk>
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface react_component_renderable extends renderable {
+    /**
+     * Get the name of the React component to mount for this renderable.
+     *
+     * This is the ESM module specifier of the component, for example `@moodle/lms/block_timeline/Timeline`.
+     *
+     * @param renderer_base $renderer The renderer requesting the component name
+     * @return string
+     */
+    public function get_react_component_name(renderer_base $renderer): string;
+
+    /**
+     * Get the props to pass to the React component.
+     *
+     * The returned value is serialised to JSON by the mounting API. It must therefore be JSON serialisable.
+     *
+     * @param renderer_base $renderer The renderer requesting the props
+     * @return array|\stdClass|\JsonSerializable
+     */
+    public function get_react_component_props(renderer_base $renderer): array|\stdClass|\JsonSerializable;
+}
