diff --git a/public/lib/classes/output/html_writer.php b/public/lib/classes/output/html_writer.php
index 30b7b303ad7..c235a2c1dcb 100644
--- a/public/lib/classes/output/html_writer.php
+++ b/public/lib/classes/output/html_writer.php
@@ -897,6 +897,71 @@ class html_writer {
     public static function end_span() {
         return self::end_tag('span');
     }
+
+    /**
+     * Creates a mount point for a React component.
+     *
+     * The returned element is picked up automatically by the React autoinit system, which mounts the specified
+     * component into it, passing the provided props.
+     *
+     * The DOM contract used by the autoinit system (data attributes, prop serialisation, and escaping) is an
+     * internal detail of the frontend platform and should not be relied upon by consumers of this API.
+     *
+     * Example:
+     * <code>
+     * echo html_writer::react_component('@moodle/lms/block_timeline/Timeline', [
+     *     'filter' => 'next30days',
+     *     'limit' => 5,
+     * ]);
+     * </code>
+     *
+     * @param string $modulename The ESM module specifier of the React component, for example
+     *      `@moodle/lms/block_timeline/Timeline`
+     * @param array|string|\stdClass|\JsonSerializable $props The props to pass to the component. If a string is
+     *      provided it must be a valid, already JSON-encoded, string.
+     * @return string HTML code for the mount point
+     * @throws coding_exception If the module name is empty, or the props cannot be serialised
+     */
+    public static function react_component(
+        string $modulename,
+        array|string|\stdClass|\JsonSerializable $props,
+    ): string {
+        $modulename = trim($modulename);
+        if ($modulename === '') {
+            throw new coding_exception('A React component module name must be specified.');
+        }
+
+        if (is_string($props)) {
+            if (!json_validate($props)) {
+                throw new coding_exception('The props provided for a React component must be a valid JSON string.');
+            }
+            // Re-encode the props to guarantee consistent serialisation and escaping.
+            $props = json_decode($props, false, 512, JSON_THROW_ON_ERROR);
+        }
+
+        if ($props === []) {
+            // An empty array would be serialised as a JSON list, but React props must be an object.
+            $props = new \stdClass();
+        }
+
+        try {
+            $encodedprops = json_encode(
+                $props,
+                JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_THROW_ON_ERROR,
+            );
+        } catch (\JsonException $e) {
+            throw new coding_exception(
+                'Unable to serialise the props provided for a React component.',
+                $e->getMessage(),
+            );
+        }
+
+        // Note: The attribute values are escaped by html_writer::attribute().
+        return self::div('', '', [
+            'data-react-component' => $modulename,
+            'data-react-props' => $encodedprops,
+        ]);
+    }
 }
 
