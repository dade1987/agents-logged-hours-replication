+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component(): void {
+        $output = html_writer::react_component('@moodle/lms/block_timeline/Timeline', [
+            'filter' => 'next30days',
+            'limit' => 5,
+            'enabled' => true,
+            'name' => 'Tim & Tom <script>',
+        ]);
+
+        $this->assertStringStartsWith('<div ', $output);
+        $this->assertStringEndsWith('></div>', $output);
+        $this->assertStringContainsString('data-react-component="@moodle/lms/block_timeline/Timeline"', $output);
+        $this->assertMatchesRegularExpression('/data-react-props="([^"]*)"/', $output);
+
+        // The raw HTML must not contain any unescaped tags from the props.
+        $this->assertStringNotContainsString('<script>', $output);
+
+        preg_match('/data-react-props="([^"]*)"/', $output, $matches);
+        $props = json_decode(htmlspecialchars_decode($matches[1]), true);
+        $this->assertSame([
+            'filter' => 'next30days',
+            'limit' => 5,
+            'enabled' => true,
+            'name' => 'Tim & Tom <script>',
+        ], $props);
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_props_types(): void {
+        $expected = ['foo' => 'bar', 'baz' => [1, 2, 3]];
+
+        $object = new \stdClass();
+        $object->foo = 'bar';
+        $object->baz = [1, 2, 3];
+
+        $serializable = new class ($expected) implements \JsonSerializable {
+            /**
+             * Constructor.
+             *
+             * @param array $data
+             */
+            public function __construct(
+                /** @var array The data */
+                private array $data,
+            ) {
+            }
+
+            #[\Override]
+            public function jsonSerialize(): array {
+                return $this->data;
+            }
+        };
+
+        $fromarray = html_writer::react_component('@moodle/lms/core/example', $expected);
+        $this->assertSame($fromarray, html_writer::react_component('@moodle/lms/core/example', $object));
+        $this->assertSame($fromarray, html_writer::react_component('@moodle/lms/core/example', $serializable));
+        $this->assertSame($fromarray, html_writer::react_component('@moodle/lms/core/example', json_encode($expected)));
+
+        preg_match('/data-react-props="([^"]*)"/', $fromarray, $matches);
+        $this->assertSame($expected, json_decode(htmlspecialchars_decode($matches[1]), true));
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_empty_props(): void {
+        $output = html_writer::react_component('@moodle/lms/core/example', []);
+        preg_match('/data-react-props="([^"]*)"/', $output, $matches);
+        $this->assertSame('{}', htmlspecialchars_decode($matches[1]));
+    }
+
+    /**
