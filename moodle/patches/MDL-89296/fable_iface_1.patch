+    public function test_react_component_unicode_props(): void {
+        $output = html_writer::react_component('@moodle/lms/core/example', ['name' => 'Ünïcödé']);
+        $this->assertStringContainsString('Ünïcödé', $output);
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_invalid_json_string(): void {
+        $this->expectException(\core\exception\coding_exception::class);
+        html_writer::react_component('@moodle/lms/core/example', '{not json');
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_empty_module_name(): void {
+        $this->expectException(\core\exception\coding_exception::class);
+        html_writer::react_component('', []);
+    }
 }
