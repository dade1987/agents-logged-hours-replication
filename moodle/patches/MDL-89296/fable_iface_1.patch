+namespace core\output;
+
+use core\fixtures\output\react_and_named_templatable;
+use core\fixtures\output\react_plugin_renderer;
+use core\fixtures\output\react_with_render_method;
+
+/**
+ * Tests for rendering of react_component_renderable instances.
+ *
+ * @package   core
+ * @category  test
+ * @copyright 2026 Andrew Lyons <andrew@nicols.co.uk>
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \core\output\react_component_renderable
+ * @covers    \core\output\renderer_base::render
+ * @covers    \core\output\plugin_renderer_base::render
+ */
+final class react_component_renderable_test extends \advanced_testcase {
+    #[\Override]
+    public static function setUpBeforeClass(): void {
+        global $CFG;
+        parent::setUpBeforeClass();
+        require_once($CFG->libdir . '/tests/fixtures/output/react_component_fixtures.php');
+    }
+
+    /**
+     * Extract the props from a React mount point.
+     *
+     * @param string $html
+     * @return array
+     */
+    private function get_props(string $html): array {
+        $this->assertMatchesRegularExpression('/data-react-props="([^"]*)"/', $html);
+        preg_match('/data-react-props="([^"]*)"/', $html, $matches);
+        return json_decode(htmlspecialchars_decode($matches[1]), true);
+    }
+
+    /**
+     * The core renderer should mount the React component rather than rendering the template.
+     */
+    public function test_render_core_renderer(): void {
+        global $PAGE;
+
+        $renderer = $PAGE->get_renderer('core');
+        $output = $renderer->render(new react_and_named_templatable());
+
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/fixture"', $output);
+        $this->assertSame(['source' => 'react'], $this->get_props($output));
+    }
+
+    /**
+     * The react_component_renderable interface takes precedence over named_templatable in plugin renderers.
+     */
+    public function test_render_plugin_renderer_precedence_over_named_templatable(): void {
+        global $PAGE;
+
+        $renderer = new react_plugin_renderer($PAGE, RENDERER_TARGET_GENERAL);
+        $output = $renderer->render(new react_and_named_templatable());
+
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/fixture"', $output);
+        $this->assertSame(['source' => 'react'], $this->get_props($output));
+    }
+
+    /**
+     * A render_[renderable] method takes precedence over the react_component_renderable interface.
+     */
+    public function test_render_method_precedence_over_react(): void {
+        global $PAGE;
+
+        $renderer = new react_plugin_renderer($PAGE, RENDERER_TARGET_GENERAL);
+        $output = $renderer->render(new react_with_render_method());
+
+        $this->assertSame('Rendered by render_react_with_render_method', $output);
+    }
+
+    /**
+     * A react_component_renderable without a render method is mounted by the core renderer.
+     */
+    public function test_render_stdclass_props(): void {
+        global $PAGE;
+
+        $renderer = $PAGE->get_renderer('core');
+        $output = $renderer->render(new react_with_render_method());
+
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/fixture"', $output);
+        $this->assertSame(['source' => 'react'], $this->get_props($output));
+    }
+
+    /**
+     * The render_from_react_component helper generates a mount point.
+     */
+    public function test_render_from_react_component(): void {
+        global $PAGE;
+
+        $renderer = $PAGE->get_renderer('core');
+        $output = $renderer->render_from_react_component('@moodle/lms/core/fixture', ['a' => 1]);
+
+        $this->assertSame(html_writer::react_component('@moodle/lms/core/fixture', ['a' => 1]), $output);
+    }
+}
