+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+namespace core\output;
+
+/**
+ * Standard API for mounting React components from PHP.
+ *
+ * Feature code only specifies the component identifier and its props. The DOM contract used by the
+ * React autoinit system, and the serialisation of props, are internal to this class.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class react_component {
+    /**
+     * Get the HTML required to mount a React component.
+     *
+     * @param string $component The component identifier, e.g. `@moodle/lms/block_timeline/Timeline`
+     * @param array $props The props to pass to the component
+     * @param array $attributes Additional HTML attributes for the mount element
+     * @return string
+     */
+    public static function mount(string $component, array $props = [], array $attributes = []): string {
+        $attributes['data-react-component'] = $component;
+        $attributes['data-react-props'] = json_encode(
+            $props,
+            JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_PARTIAL_OUTPUT_ON_ERROR
+        );
+
+        return \html_writer::div('', '', $attributes);
+    }
+}
