+
+namespace core\output;
+
+use core\exception\coding_exception;
+
+/**
+ * Standard PHP API for mounting React components.
+ *
+ * Feature code only specifies the component identifier and its props. The DOM contract used by
+ * the React autoinit system (core/react_autoinit), and the serialisation and escaping of props,
+ * are handled internally and may change without requiring changes to consumers.
+ *
+ * Example:
+ * ```php
+ * echo \core\output\react_mount::render('@moodle/lms/block_timeline/Timeline', [
+ *     'limit' => 10,
+ *     'filter' => 'future',
+ * ]);
+ * ```
+ *
+ * @package   core
+ * @category  output
+ * @copyright 2026 Moodle
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+final class react_mount {
+    /** @var string The prefix that every React component identifier must start with. */
+    private const COMPONENT_PREFIX = '@moodle/lms/';
+
+    /** @var string The prefix reserved for attributes generated by this API. */
+    private const RESERVED_ATTRIBUTE_PREFIX = 'data-react-';
+
+    /**
+     * Build the mount point HTML for a React component.
+     *
+     * @param string $component The component identifier, in the form `@moodle/lms/<component>/<module>`.
+     * @param array $props The props to pass to the component. Serialised as a JSON object.
+     * @param string $content Optional inner HTML, such as a loading placeholder. This is not escaped.
+     * @param array $attributes Optional additional HTML attributes for the mount element, such as 'id' or 'class'.
+     *                          The data-react-* attributes are reserved and cannot be set here.
+     * @return string HTML for the mount point.
+     * @throws coding_exception If the component identifier is invalid or a reserved attribute is provided.
+     */
+    public static function render(
+        string $component,
+        array $props = [],
+        string $content = '',
+        array $attributes = [],
+    ): string {
+        self::validate_component($component);
+
+        foreach (array_keys($attributes) as $name) {
+            if (str_starts_with(strtolower((string) $name), self::RESERVED_ATTRIBUTE_PREFIX)) {
+                throw new coding_exception(
+                    "The attribute '{$name}' is reserved for React mount points and cannot be set directly."
+                );
+            }
+        }
+
+        // Props are always a JSON object, even when empty. The HEX flags make the output safe
+        // to embed in an attribute, and the attribute is escaped again by html_writer.
+        $json = json_encode(
+            (object) $props,
+            JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_THROW_ON_ERROR,
+        );
+
+        $mountattributes = [
+            'data-react-component' => $component,
+            'data-react-props' => $json,
+        ] + $attributes;
+
+        return \html_writer::tag('div', $content, $mountattributes);
+    }
+
+    /**
+     * Validate a React component identifier.
+     *
+     * @param string $component The component identifier.
+     * @throws coding_exception If the identifier is not in the form `@moodle/lms/<component>/<module>`.
+     */
+    private static function validate_component(string $component): void {
+        if (
+            !str_starts_with($component, self::COMPONENT_PREFIX)
+            || strlen($component) <= strlen(self::COMPONENT_PREFIX)
+        ) {
+            throw new coding_exception(
+                "Invalid React component '{$component}', expected the format " . self::COMPONENT_PREFIX . '<component>/<module>.'
+            );
+        }
+    }
+}
