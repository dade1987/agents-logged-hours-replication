+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+declare(strict_types=1);
+
+namespace core\output;
+
+use core\exception\coding_exception;
+
+/**
+ * Test renderable which is both a React renderable and a named templatable.
+ *
+ * Used to check the precedence of react_renderable over named_templatable.
+ *
+ * @package   core
+ * @copyright 2026 Moodle
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class react_mount_test_widget implements renderable, react_renderable, named_templatable {
+    #[\Override]
+    public function get_react_component(renderer_base $renderer): string {
+        return '@moodle/lms/core/test_widget';
+    }
+
+    #[\Override]
+    public function export_for_react(renderer_base $renderer): array {
+        return ['title' => 'Hello "world" <b>'];
+    }
+
+    #[\Override]
+    public function get_template_name(renderer_base $renderer): string {
+        return 'core/should_not_be_used';
+    }
+
+    #[\Override]
+    public function export_for_template(renderer_base $output) {
+        return [];
+    }
+}
+
+/**
+ * Unit tests for the React mount API and React renderable rendering.
+ *
+ * @package   core
+ * @copyright 2026 Moodle
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(react_mount::class)]
+final class react_mount_test extends \advanced_testcase {
+    /**
+     * Extract the decoded props from mount point markup.
+     *
+     * @param string $html the mount point markup.
+     * @return mixed the decoded props.
+     */
+    private function decode_props(string $html) {
+        preg_match('/data-react-props="([^"]*)"/', $html, $matches);
+        $this->assertNotEmpty($matches, 'data-react-props attribute not found');
+        return json_decode(htmlspecialchars_decode($matches[1]), true, 512, JSON_THROW_ON_ERROR);
+    }
+
+    /**
+     * The mount point must carry the component and props, with the React DOM contract hidden behind the API.
+     */
+    public function test_render_builds_mount_point(): void {
+        $html = react_mount::render('@moodle/lms/core/test_widget', ['a' => 1]);
+
+        $this->assertStringStartsWith('<div ', $html);
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/test_widget"', $html);
+        $this->assertSame(['a' => 1], $this->decode_props($html));
+    }
+
+    /**
+     * Empty props must still be serialised as a JSON object.
+     */
+    public function test_render_serialises_empty_props_as_object(): void {
+        $html = react_mount::render('@moodle/lms/core/test_widget');
+
+        $this->assertStringContainsString('data-react-props="{}"', $html);
+    }
+
+    /**
+     * Props containing HTML and quote characters must not break out of the attribute.
+     */
+    public function test_render_escapes_props(): void {
+        $html = react_mount::render('@moodle/lms/core/test_widget', ['title' => 'a"b\'c<script>&']);
+
+        $this->assertStringNotContainsString('<script>', $html);
+        $this->assertSame(['title' => 'a"b\'c<script>&'], $this->decode_props($html));
+    }
+
+    /**
+     * Optional content and attributes must be included, and the data-react-* attributes must not be overridden.
+     */
+    public function test_render_accepts_content_and_attributes(): void {
+        $html = react_mount::render(
+            '@moodle/lms/core/test_widget',
+            [],
+            '<p>Loading</p>',
+            ['id' => 'mount', 'class' => 'x'],
+        );
+
+        $this->assertStringContainsString('id="mount"', $html);
+        $this->assertStringContainsString('class="x"', $html);
+        $this->assertStringContainsString('<p>Loading</p></div>', $html);
+    }
+
+    /**
+     * Invalid component identifiers must be rejected.
+     */
+    public function test_render_rejects_invalid_component(): void {
+        $this->expectException(coding_exception::class);
+        react_mount::render('core/test_widget');
+    }
+
+    /**
+     * Reserved data-react-* attributes must be rejected.
+     */
+    public function test_render_rejects_reserved_attributes(): void {
+        $this->expectException(coding_exception::class);
+        react_mount::render('@moodle/lms/core/test_widget', [], '', ['data-react-props' => '{}']);
+    }
+
+    /**
+     * A react_renderable must be mounted, and take precedence over named_templatable.
+     */
+    public function test_renderer_mounts_react_renderable(): void {
+        global $PAGE;
+        $this->resetAfterTest();
+
+        $renderer = $PAGE->get_renderer('core');
+        $html = $renderer->render(new react_mount_test_widget());
+
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/test_widget"', $html);
+        $this->assertSame(['title' => 'Hello "world" <b>'], $this->decode_props($html));
+    }
+}
