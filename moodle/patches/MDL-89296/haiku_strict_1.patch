+
+namespace core\output;
+
+/**
+ * Interface for renderables which are rendered as a React component mount point.
+ *
+ * When a renderable implementing this interface is passed to renderer_base::render(), and no
+ * render_[renderable_name] method exists on the renderer, the React component is mounted using
+ * {@see react_mount::render()}.
+ *
+ * This takes precedence over {@see named_templatable} and {@see templatable}.
+ *
+ * @package   core
+ * @category  output
+ * @copyright 2026 Moodle
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface react_renderable {
+    /**
+     * Get the React component identifier to mount.
+     *
+     * This must be in the form `@moodle/lms/<component>/<module>`.
+     *
+     * @param renderer_base $renderer The renderer requesting the component.
+     * @return string
+     */
+    public function get_react_component(renderer_base $renderer): string;
+
+    /**
+     * Export the props to pass to the React component.
+     *
+     * Props must only contain simple types: array, stdClass, bool, int, float, string or null.
+     *
+     * @param renderer_base $renderer The renderer requesting the props.
+     * @return array
+     */
+    public function export_for_react(renderer_base $renderer): array;
+}
