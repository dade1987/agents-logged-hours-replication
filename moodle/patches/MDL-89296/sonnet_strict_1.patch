+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\output;
+
+/**
+ * Standard API for mounting a React component from PHP.
+ *
+ * Feature code only specifies the component identifier and its props. The DOM contract used by the
+ * core/react_autoinit module and the serialisation of the props are internal to this class.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class react_component {
+    /**
+     * Constructor.
+     *
+     * @param string $component The component identifier, for example '@moodle/lms/block_timeline/Timeline'.
+     * @param array $props The props to pass to the component.
+     */
+    public function __construct(
+        /** @var string The component identifier */
+        protected string $component,
+        /** @var array The component props */
+        protected array $props = [],
+    ) {
+    }
+
+    /**
+     * Create an instance.
+     *
+     * @param string $component The component identifier.
+     * @param array $props The props to pass to the component.
+     * @return self
+     */
+    public static function create(string $component, array $props = []): self {
+        return new self($component, $props);
+    }
+
+    /**
+     * Get the HTML required to mount the component.
+     *
+     * @param array $attributes Optional additional attributes (for example class or id) for the mount element.
+     * @return string
+     */
+    public function render(array $attributes = []): string {
+        // The internal attributes must not be overridden.
+        unset($attributes['data-react-component'], $attributes['data-react-props']);
+
+        $props = json_encode(
+            $this->props,
+            JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_PARTIAL_OUTPUT_ON_ERROR,
+        );
+        if ($props === false || $props === '[]') {
+            // An empty array would be encoded as a JSON list; props are always an object.
+            $props = '{}';
+        }
+
+        return html_writer::div('', '', [
+            'data-react-component' => $this->component,
+            'data-react-props' => $props,
+        ] + $attributes);
+    }
+
+    /**
+     * Get the HTML required to mount the component.
+     *
+     * @return string
+     */
+    public function __toString(): string {
+        return $this->render();
+    }
+}
diff --git a/public/lib/classes/output/react_renderable.php b/public/lib/classes/output/react_renderable.php
