+<?php
+// This file is part of Moodle - http://moodle.org/
+//
+// Moodle is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// Moodle is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\output;
+
+/**
+ * A renderable which is rendered by mounting a React component.
+ *
+ * When rendered using renderer_base::render(), a renderable implementing this interface is turned into the
+ * markup required to mount the React component. It takes precedence over named_templatable and templatable,
+ * but a correctly named render_[renderable] method in the renderer still takes precedence over it.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface react_renderable extends renderable {
+    /**
+     * Get the identifier of the React component to mount, for example '@moodle/lms/block_timeline/Timeline'.
+     *
+     * @param renderer_base $renderer The renderer requesting the component
+     * @return string
+     */
+    public function get_react_component(renderer_base $renderer): string;
+
+    /**
+     * Get the props to pass to the React component.
+     *
+     * The props must be JSON-serialisable. Serialisation and escaping are handled by the react_component class.
+     *
+     * @param renderer_base $renderer The renderer requesting the props
+     * @return array
+     */
+    public function export_props_for_react(renderer_base $renderer): array;
+}
