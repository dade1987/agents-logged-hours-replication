+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\output;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+
+/**
+ * Tests for the React component PHP API.
+ *
+ * @package    core
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[CoversClass(react_component::class)]
+#[CoversClass(renderer_base::class)]
+final class react_component_test extends \advanced_testcase {
+    /**
+     * Extract the mount attributes from rendered HTML.
+     *
+     * @param string $html
+     * @return array [component, decoded props]
+     */
+    private function parse_mount(string $html): array {
+        $this->assertMatchesRegularExpression('/^<div /', $html);
+        $this->assertSame(1, preg_match('/data-react-component="([^"]*)"/', $html, $component));
+        $this->assertSame(1, preg_match('/data-react-props="([^"]*)"/', $html, $props));
+        return [
+            htmlspecialchars_decode($component[1], ENT_QUOTES),
+            json_decode(htmlspecialchars_decode($props[1], ENT_QUOTES), true),
+        ];
+    }
+
+    public function test_render_react_component(): void {
+        global $PAGE;
+        $output = $PAGE->get_renderer('core');
+
+        $props = [
+            'title' => 'It\'s "quoted" & <b>bold</b></div><script>alert(1)</script>',
+            'list' => [1, 2, 3],
+            'unicode' => 'Ünïcødé',
+            'nested' => ['a' => true],
+        ];
+        $html = $output->render(new react_component('@moodle/lms/mod_book/viewer', $props));
+
+        $this->assertStringNotContainsString('<script>', $html);
+        $this->assertStringNotContainsString('<b>', $html);
+        [$component, $decoded] = $this->parse_mount($html);
+        $this->assertSame('@moodle/lms/mod_book/viewer', $component);
+        $this->assertSame($props, $decoded);
+        $this->assertSame($html, $output->react_component('@moodle/lms/mod_book/viewer', $props));
+    }
+
+    public function test_empty_props_are_an_object(): void {
+        global $PAGE;
+        $html = $PAGE->get_renderer('core')->react_component('@moodle/lms/core/example');
+        $this->assertStringContainsString('data-react-props="{}"', $html);
+    }
+
+    public function test_attributes_and_content(): void {
+        global $PAGE;
+        $html = $PAGE->get_renderer('core')->react_component(
+            '@moodle/lms/core/example',
+            ['a' => 1],
+            ['id' => 'foo', 'class' => 'bar', 'data-react-component' => 'evil'],
+            '<p>Loading...</p>',
+        );
+        $this->assertStringContainsString('id="foo"', $html);
+        $this->assertStringContainsString('class="bar"', $html);
+        $this->assertStringNotContainsString('evil', $html);
+        $this->assertStringContainsString('<p>Loading...</p></div>', $html);
+    }
+
+    public function test_empty_component_rejected(): void {
+        $this->expectException(\coding_exception::class);
+        new react_component('');
+    }
+
+    public function test_react_renderable_takes_precedence_over_named_templatable(): void {
+        global $PAGE;
+        $html = $PAGE->get_renderer('core')->render(new react_component_test_widget());
+        [$component, $props] = $this->parse_mount($html);
+        $this->assertSame('@moodle/lms/core/widget', $component);
+        $this->assertSame(['source' => 'react'], $props);
+    }
+
+    public function test_render_method_takes_precedence_over_react_renderable(): void {
+        global $PAGE;
+        $renderer = new react_component_test_renderer($PAGE, RENDERER_TARGET_GENERAL);
+        $this->assertSame('custom', $renderer->render(new react_component_test_widget()));
+    }
+}
+
+/**
+ * Test widget implementing both react_renderable and named_templatable.
+ */
+class react_component_test_widget implements react_renderable, named_templatable {
+    #[\Override]
+    public function get_react_component(renderer_base $output): string {
+        return '@moodle/lms/core/widget';
+    }
+
+    #[\Override]
+    public function export_for_react(renderer_base $output): array {
+        return ['source' => 'react'];
+    }
+
+    #[\Override]
+    public function get_template_name(renderer_base $renderer): string {
+        return 'core/does_not_exist';
+    }
+
+    #[\Override]
+    public function export_for_template(renderer_base $output): array {
+        return ['source' => 'template'];
+    }
+}
+
+/**
+ * Test renderer with a specific render method.
+ */
+class react_component_test_renderer extends renderer_base {
+    /**
+     * Render the test widget.
+     *
+     * @param react_component_test_widget $widget
+     * @return string
+     */
+    protected function render_react_component_test_widget(react_component_test_widget $widget): string {
+        return 'custom';
+    }
+}
