+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\output;
+
+/**
+ * A renderable which is rendered as a React component mount point.
+ *
+ * When a renderable implementing this interface is passed to {@see renderer_base::render()}, the renderer
+ * will generate the React component entrypoint automatically, using the component identifier returned by
+ * {@see self::get_react_component()} and the props returned by {@see self::export_for_react()}.
+ *
+ * This interface has a higher precedence than {@see named_templatable} and {@see templatable}, but a lower
+ * precedence than a correctly named `render_[renderable_name]` method in the renderer, which allows
+ * themes and renderers to override the rendering of the component.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface react_renderable extends renderable {
+    /**
+     * Get the identifier of the React component to mount.
+     *
+     * This must be a fully-qualified ESM specifier, for example `@moodle/lms/block_timeline/Timeline`.
+     *
+     * @param renderer_base $output The renderer requesting the component
+     * @return string
+     */
+    public function get_react_component(renderer_base $output): string;
+
+    /**
+     * Export the props to pass to the React component.
+     *
+     * The data must be serialisable to JSON.
+     *
+     * @param renderer_base $output The renderer requesting the props
+     * @return array|\stdClass|\JsonSerializable
+     */
+    public function export_for_react(renderer_base $output): array|\stdClass|\JsonSerializable;
+}
