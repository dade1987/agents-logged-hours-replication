+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\output;
+
+use core\exception\coding_exception;
+
+/**
+ * A React component mount point.
+ *
+ * This is the supported PHP API for mounting a React component. Feature code only needs to provide the
+ * component identifier and its props; the DOM contract used by the React auto-initialiser, and the
+ * serialisation and escaping of the props, are handled internally.
+ *
+ * ```php
+ * echo $OUTPUT->render(new \core\output\react_component(
+ *     '@moodle/lms/mod_book/viewer',
+ *     ['bookid' => 42, 'title' => 'My book'],
+ * ));
+ * ```
+ *
+ * Alternatively the shorthand {@see renderer_base::react_component()} may be used.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class react_component implements react_renderable {
+    /**
+     * Create a new React component mount point.
+     *
+     * @param string $component The fully-qualified ESM specifier of the component, e.g. `@moodle/lms/mod_book/viewer`
+     * @param array|\stdClass|\JsonSerializable $props The props to pass to the component
+     * @param array $attributes Any additional HTML attributes for the mount element (e.g. id, class)
+     * @param string $content Optional HTML content to display until the component has been mounted
+     */
+    public function __construct(
+        /** @var string The fully-qualified ESM specifier of the component */
+        protected string $component,
+        /** @var array|\stdClass|\JsonSerializable The props to pass to the component */
+        protected array|\stdClass|\JsonSerializable $props = [],
+        /** @var array Additional HTML attributes for the mount element */
+        protected array $attributes = [],
+        /** @var string HTML content to display until the component is mounted */
+        protected string $content = '',
+    ) {
+        if (trim($component) === '') {
+            throw new coding_exception('A React component identifier must be specified.');
+        }
+    }
+
+    #[\Override]
+    public function get_react_component(renderer_base $output): string {
+        return $this->component;
+    }
+
+    #[\Override]
+    public function export_for_react(renderer_base $output): array|\stdClass|\JsonSerializable {
+        return $this->props;
+    }
+
+    /**
+     * Get the additional HTML attributes for the mount element.
+     *
+     * @return array
+     */
+    public function get_attributes(): array {
+        return $this->attributes;
+    }
+
+    /**
+     * Get the HTML content to display until the component is mounted.
+     *
+     * @return string
+     */
+    public function get_content(): string {
+        return $this->content;
+    }
+
+    /**
+     * Generate the HTML for a React component mount point.
+     *
+     * This is an internal implementation detail of the React mounting mechanism and may change.
+     * Feature code should use {@see renderer_base::render()} or {@see renderer_base::react_component()} instead.
+     *
+     * @param string $component The fully-qualified ESM specifier of the component
+     * @param array|\stdClass|\JsonSerializable $props The props to pass to the component
+     * @param array $attributes Additional HTML attributes for the mount element
+     * @param string $content HTML content to display until the component is mounted
+     * @return string
+     * @internal
+     */
+    public static function generate_mount_html(
+        string $component,
+        array|\stdClass|\JsonSerializable $props = [],
+        array $attributes = [],
+        string $content = '',
+    ): string {
+        if (trim($component) === '') {
+            throw new coding_exception('A React component identifier must be specified.');
+        }
+
+        // The mount attributes are reserved and cannot be overridden by the caller.
+        unset($attributes['data-react-component'], $attributes['data-react-props']);
+
+        $attributes = array_merge([
+            'data-react-component' => $component,
+            'data-react-props' => self::serialise_props($props),
+        ], $attributes);
+
+        return html_writer::div($content, '', $attributes);
+    }
+
+    /**
+     * Serialise the props for the React component.
+     *
+     * Props are always serialised as a JSON object. HTML-significant characters are escaped so that the
+     * value is safe to embed in an HTML attribute, regardless of how it is quoted.
+     *
+     * @param array|\stdClass|\JsonSerializable $props
+     * @return string
+     * @internal
+     */
+    public static function serialise_props(array|\stdClass|\JsonSerializable $props): string {
+        if ($props instanceof \JsonSerializable) {
+            $props = $props->jsonSerialize();
+        }
+
+        if ($props === [] || $props === null) {
+            // An empty array would otherwise be serialised as a JSON list.
+            $props = new \stdClass();
+        }
+
+        try {
+            return json_encode(
+                $props,
+                JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS
+                    | JSON_HEX_QUOT | JSON_THROW_ON_ERROR,
+            );
+        } catch (\JsonException $e) {
+            throw new coding_exception('Unable to serialise React component props: ' . $e->getMessage());
+        }
+    }
+}
