+    /**
+     * Render a React component mount point.
+     *
+     * This is called by {@see self::render()} for any renderable implementing {@see react_renderable}
+     * which does not have a more specific render_[widget_name] method.
+     *
+     * @param react_renderable $widget
+     * @return string
+     */
+    public function render_react_component(react_renderable $widget): string {
+        $attributes = [];
+        $content = '';
+        if ($widget instanceof react_component) {
+            $attributes = $widget->get_attributes();
+            $content = $widget->get_content();
+        }
+
+        return react_component::generate_mount_html(
+            $widget->get_react_component($this),
+            $widget->export_for_react($this),
+            $attributes,
+            $content,
+        );
+    }
+
+    /**
+     * Render a React component mount point for the specified component and props.
+     *
+     * The serialisation of the props, and the DOM contract used to mount the component, are handled internally.
+     *
+     * ```php
+     * echo $OUTPUT->react_component('@moodle/lms/mod_book/viewer', ['bookid' => 42]);
+     * ```
+     *
+     * @param string $component The fully-qualified ESM specifier of the component, e.g. `@moodle/lms/mod_book/viewer`
+     * @param array|stdClass|\JsonSerializable $props The props to pass to the component
+     * @param array $attributes Any additional HTML attributes for the mount element (e.g. id, class)
+     * @param string $content Optional HTML content to display until the component has been mounted
+     * @return string
+     */
+    public function react_component(
+        string $component,
+        array|stdClass|\JsonSerializable $props = [],
+        array $attributes = [],
+        string $content = '',
+    ): string {
+        return $this->render(new react_component($component, $props, $attributes, $content));
+    }
