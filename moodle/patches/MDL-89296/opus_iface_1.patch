+
+namespace core\output;
+
+/**
+ * A renderable which is rendered as a React component.
+ *
+ * When a renderable implementing this interface is rendered using {@see renderer_base::render()},
+ * a React component mount point is generated using {@see html_writer::react_component()}.
+ *
+ * This interface takes precedence over {@see named_templatable}, but a correctly named
+ * `render_[renderable_name]` method in the renderer will still take precedence over it.
+ *
+ * @package   core
+ * @copyright Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface react_component_renderable extends renderable {
+    /**
+     * Get the name of the React component module to mount.
+     *
+     * For example '@moodle/lms/block_timeline/Timeline'.
+     *
+     * @param renderer_base $renderer The renderer requesting the component name
+     * @return string
+     */
+    public function get_react_component_name(renderer_base $renderer): string;
+
+    /**
+     * Export the props to pass to the React component.
+     *
+     * @param renderer_base $renderer The renderer used to render the component
+     * @return array|\stdClass|\JsonSerializable
+     */
+    public function export_for_react(renderer_base $renderer): array|\stdClass|\JsonSerializable;
+}
