diff --git a/public/lib/classes/output/html_writer.php b/public/lib/classes/output/html_writer.php
index 30b7b303ad7..bd63289904c 100644
--- a/public/lib/classes/output/html_writer.php
+++ b/public/lib/classes/output/html_writer.php
@@ -846,6 +846,50 @@ class html_writer {
         return self::tag('div', $content, self::add_class($class, $attributes));
     }
 
+    /**
+     * Generate the mount point for a React component.
+     *
+     * The returned HTML is picked up by the React autoinit system, which mounts the specified component
+     * with the supplied props. The DOM contract used for mounting is an internal implementation detail
+     * and callers should not rely upon it.
+     *
+     * @param string $modulename The React component module name, for example '@moodle/lms/block_timeline/Timeline'
+     * @param array|string|\stdClass|\JsonSerializable $props The props to pass to the component.
+     *     A string is treated as an already JSON-encoded representation of the props.
+     * @return string HTML fragment
+     */
+    public static function react_component(
+        string $modulename,
+        array|string|\stdClass|\JsonSerializable $props,
+    ): string {
+        if ($modulename === '') {
+            throw new coding_exception('A React component module name must be specified.');
+        }
+
+        if (is_string($props)) {
+            if ($props === '') {
+                $props = '{}';
+            } else if (!json_validate($props)) {
+                throw new coding_exception('The React component props must be valid JSON when provided as a string.');
+            }
+            $encodedprops = $props;
+        } else {
+            if (is_array($props) && empty($props)) {
+                // Always provide an object for empty props.
+                $props = new \stdClass();
+            }
+            $encodedprops = json_encode(
+                $props,
+                JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_THROW_ON_ERROR,
+            );
+        }
+
+        return self::div('', '', [
+            'data-react-component' => $modulename,
+            'data-react-props' => $encodedprops,
+        ]);
+    }
+
     /**
      * Starts a <div> tag. (Shortcut function.)
      *
