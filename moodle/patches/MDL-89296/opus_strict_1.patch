+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\output\local;
+
+use core\exception\coding_exception;
+use core\output\html_writer;
+
+/**
+ * Internal implementation of the React component mount point DOM contract.
+ *
+ * This class is internal to the output API and must not be used directly by feature code.
+ * Use {@see \core\output\renderer_base::react_component()} or implement
+ * {@see \core\output\react_renderable} instead.
+ *
+ * @package   core
+ * @category  output
+ * @copyright Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @internal
+ */
+final class react_mount {
+    /** @var string The attribute holding the component specifier. */
+    private const COMPONENT_ATTRIBUTE = 'data-react-component';
+
+    /** @var string The attribute holding the serialised props. */
+    private const PROPS_ATTRIBUTE = 'data-react-props';
+
+    /** @var int The JSON encoding flags used when serialising props. */
+    public const JSON_FLAGS = JSON_UNESCAPED_UNICODE
+        | JSON_UNESCAPED_SLASHES
+        | JSON_HEX_TAG
+        | JSON_HEX_AMP
+        | JSON_HEX_APOS
+        | JSON_HEX_QUOT
+        | JSON_THROW_ON_ERROR;
+
+    /**
+     * Serialise props for use by the React autoinit system.
+     *
+     * Props are always serialised as a JSON object.
+     *
+     * @param array|\stdClass|\JsonSerializable $props
+     * @return string
+     */
+    public static function encode_props(array|\stdClass|\JsonSerializable $props): string {
+        if ($props instanceof \JsonSerializable) {
+            $props = $props->jsonSerialize();
+        }
+        if (is_array($props)) {
+            // Props are always an object, even when empty.
+            $props = (object) $props;
+        }
+        if (!is_object($props)) {
+            throw new coding_exception('React component props must serialise to a JSON object.');
+        }
+
+        try {
+            return json_encode($props, self::JSON_FLAGS);
+        } catch (\JsonException $e) {
+            throw new coding_exception('Unable to serialise React component props: ' . $e->getMessage());
+        }
+    }
+
+    /**
+     * Generate the mount point HTML for a React component.
+     *
+     * @param string $component The fully-qualified ESM specifier, for example `@moodle/lms/block_timeline/Timeline`
+     * @param array|\stdClass|\JsonSerializable $props The props to pass to the component
+     * @param array $attributes Any additional HTML attributes for the mount element (for example id or class)
+     * @param string $content Optional HTML content (for example a loading placeholder) to place inside the mount element
+     * @return string
+     */
+    public static function render(
+        string $component,
+        array|\stdClass|\JsonSerializable $props = [],
+        array $attributes = [],
+        string $content = '',
+    ): string {
+        $component = trim($component);
+        if ($component === '') {
+            throw new coding_exception('A React component specifier must be provided.');
+        }
+
+        foreach (array_keys($attributes) as $name) {
+            if (in_array(strtolower((string) $name), [self::COMPONENT_ATTRIBUTE, self::PROPS_ATTRIBUTE], true)) {
+                throw new coding_exception("The '{$name}' attribute is reserved for the React mount point.");
+            }
+        }
+
+        $attributes = array_merge($attributes, [
+            self::COMPONENT_ATTRIBUTE => $component,
+            self::PROPS_ATTRIBUTE => self::encode_props($props),
+        ]);
+
+        return html_writer::div($content, '', $attributes);
+    }
+}
