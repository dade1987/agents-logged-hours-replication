+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+declare(strict_types=1);
+
+namespace core\output;
+
+use core\exception\coding_exception;
+use core\output\local\react_mount;
+
+/**
+ * Unit tests for the React component mount API.
+ *
+ * @package    core
+ * @category   test
+ * @copyright  Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(react_mount::class)]
+#[\PHPUnit\Framework\Attributes\CoversClass(renderer_base::class)]
+final class react_component_test extends \advanced_testcase {
+    /**
+     * Extract and decode the props from the mount point markup.
+     *
+     * @param string $html
+     * @return mixed
+     */
+    private function get_props(string $html): mixed {
+        $this->assertSame(1, preg_match('/data-react-props="([^"]*)"/', $html, $matches));
+        return json_decode(htmlspecialchars_decode($matches[1], ENT_QUOTES));
+    }
+
+    public function test_react_component_basic(): void {
+        global $PAGE;
+        $output = $PAGE->get_renderer('core');
+
+        $html = $output->react_component('@moodle/lms/mod_book/viewer', [
+            'title' => 'A "quoted" <b>title</b> & \'more\'',
+            'count' => 3,
+            'list' => ['a', 'b'],
+        ]);
+
+        $this->assertStringStartsWith('<div', $html);
+        $this->assertStringContainsString('data-react-component="@moodle/lms/mod_book/viewer"', $html);
+        $this->assertStringNotContainsString('<b>', $html);
+
+        $props = $this->get_props($html);
+        $this->assertSame('A "quoted" <b>title</b> & \'more\'', $props->title);
+        $this->assertSame(3, $props->count);
+        $this->assertSame(['a', 'b'], $props->list);
+    }
+
+    public function test_react_component_empty_props_is_object(): void {
+        global $PAGE;
+        $output = $PAGE->get_renderer('core');
+
+        $html = $output->react_component('@moodle/lms/mod_book/viewer');
+        $this->assertStringContainsString('data-react-props="{}"', $html);
+    }
+
+    public function test_react_component_attributes_and_content(): void {
+        global $PAGE;
+        $output = $PAGE->get_renderer('core');
+
+        $html = $output->react_component(
+            '@moodle/lms/mod_book/viewer',
+            (object) ['a' => 1],
+            ['id' => 'example', 'class' => 'wrapper'],
+            '<p>Loading...</p>',
+        );
+        $this->assertStringContainsString('id="example"', $html);
+        $this->assertStringContainsString('class="wrapper"', $html);
+        $this->assertStringContainsString('><p>Loading...</p></div>', $html);
+        $this->assertEquals((object) ['a' => 1], $this->get_props($html));
+    }
+
+    public function test_react_component_reserved_attribute(): void {
+        global $PAGE;
+        $output = $PAGE->get_renderer('core');
+
+        $this->expectException(coding_exception::class);
+        $output->react_component('@moodle/lms/mod_book/viewer', [], ['data-react-props' => '{}']);
+    }
+
+    public function test_react_component_empty_component(): void {
+        global $PAGE;
+        $output = $PAGE->get_renderer('core');
+
+        $this->expectException(coding_exception::class);
+        $output->react_component('');
+    }
+
+    /**
+     * Get a renderable implementing both react_renderable and named_templatable.
+     *
+     * @return react_renderable
+     */
+    private function get_renderable(): react_renderable {
+        return new class implements react_renderable, named_templatable {
+            public function get_react_component(renderer_base $renderer): string {
+                return '@moodle/lms/core/example';
+            }
+
+            public function export_for_react(renderer_base $renderer): array {
+                return ['value' => 'react'];
+            }
+
+            public function get_template_name(renderer_base $renderer): string {
+                return 'core/does_not_exist';
+            }
+
+            public function export_for_template(renderer_base $output): array {
+                return [];
+            }
+        };
+    }
+
+    public function test_render_react_renderable_has_precedence_over_named_templatable(): void {
+        global $PAGE;
+        $output = $PAGE->get_renderer('core');
+
+        $html = $output->render($this->get_renderable());
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/example"', $html);
+        $this->assertEquals((object) ['value' => 'react'], $this->get_props($html));
+    }
+
+    public function test_render_method_has_precedence_over_react_renderable(): void {
+        global $PAGE;
+        $widget = new react_component_test_widget();
+        $renderer = new react_component_test_renderer($PAGE, RENDERER_TARGET_GENERAL);
+        $this->assertSame('custom render method', $renderer->render($widget));
+
+        // A renderer without the method uses the React interface.
+        $html = (new renderer_base($PAGE, RENDERER_TARGET_GENERAL))->render($widget);
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/widget"', $html);
+    }
+}
+
+/**
+ * Test widget implementing react_renderable.
+ *
+ * @package    core
+ * @copyright  Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class react_component_test_widget implements react_renderable {
+    #[\Override]
+    public function get_react_component(renderer_base $renderer): string {
+        return '@moodle/lms/core/widget';
+    }
+
+    #[\Override]
+    public function export_for_react(renderer_base $renderer): array {
+        return [];
+    }
+}
+
+/**
+ * Test renderer providing a specific render method.
+ *
+ * @package    core
+ * @copyright  Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class react_component_test_renderer extends renderer_base {
+    /**
+     * Render the test widget.
+     *
+     * @param react_component_test_widget $widget
+     * @return string
+     */
+    protected function render_react_component_test_widget(react_component_test_widget $widget): string {
+        return 'custom render method';
+    }
+}
