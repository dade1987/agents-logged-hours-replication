+    /**
+     * Render the entry point (mount point) for a React component.
+     *
+     * The React autoinit system will mount the named component on the generated element, passing it the
+     * supplied props. Serialisation and escaping of the props is handled internally.
+     *
+     * Example:
+     * ```
+     * echo $OUTPUT->react_component('@moodle/lms/block_timeline/Timeline', [
+     *     'limit' => 5,
+     * ]);
+     * ```
+     *
+     * @param string $component The fully-qualified ESM specifier, in the form `@moodle/lms/<component>/<module>`
+     * @param array|stdClass|\JsonSerializable $props The props to pass to the component
+     * @param array $attributes Optional additional HTML attributes for the mount element, for example `id` or `class`
+     * @param string $content Optional HTML to place inside the mount element until the component mounts
+     * @return string The HTML for the mount point
+     */
+    public function react_component(
+        string $component,
+        array|stdClass|\JsonSerializable $props = [],
+        array $attributes = [],
+        string $content = '',
+    ): string {
+        return local\react_mount::render($component, $props, $attributes, $content);
+    }
