+
+namespace core\output;
+
+/**
+ * A renderable which is rendered as a React component mount point.
+ *
+ * This interface provides a simple migration path from templates to React, in a similar way to
+ * {@see named_templatable}. When a renderable implementing this interface is passed to
+ * {@see renderer_base::render()}, the renderer generates the React entry point for the named
+ * component, using the exported props.
+ *
+ * The precedence when rendering is:
+ * 1. A correctly named `render_[renderable]` method in the renderer;
+ * 2. This interface;
+ * 3. {@see named_templatable};
+ * 4. {@see templatable}.
+ *
+ * @package   core
+ * @category  output
+ * @copyright Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface react_renderable extends renderable {
+    /**
+     * Get the fully-qualified ESM specifier of the React component to mount.
+     *
+     * For example `@moodle/lms/block_timeline/Timeline`.
+     *
+     * @param renderer_base $renderer The renderer requesting the component name
+     * @return string
+     */
+    public function get_react_component(renderer_base $renderer): string;
+
+    /**
+     * Export the props to pass to the React component.
+     *
+     * The returned data must be JSON-serialisable. Serialisation and escaping is handled by the renderer.
+     *
+     * @param renderer_base $renderer The renderer requesting the props
+     * @return array|\stdClass|\JsonSerializable
+     */
+    public function export_for_react(renderer_base $renderer): array|\stdClass|\JsonSerializable;
+}
