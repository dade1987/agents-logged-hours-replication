+namespace block_timeline\output;
+
+use core\output\react_renderable;
+use core\output\renderer_base;
+
+/**
+ * The main content of the Timeline block.
+ *
+ * This renderable mounts the Timeline React component.
+ *
+ * @package    block_timeline
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class main implements react_renderable {
+    /**
+     * Constructor.
+     *
+     * @param string $order The sort order to use (one of the BLOCK_TIMELINE_SORT_BY_* constants)
+     * @param string $filter The filter to use (one of the BLOCK_TIMELINE_FILTER_BY_* constants)
+     * @param int $limit The number of items to show
+     * @param bool $hasenrolledcourses Whether the current user has any enrolled courses
+     */
+    public function __construct(
+        /** @var string The sort order to use */
+        protected readonly string $order,
+        /** @var string The filter to use */
+        protected readonly string $filter,
+        /** @var int The number of items to show */
+        protected readonly int $limit,
+        /** @var bool Whether the current user has any enrolled courses */
+        protected readonly bool $hasenrolledcourses,
+    ) {
+    }
+
+    #[\Override]
+    public function get_react_component(renderer_base $renderer): string {
+        return '@moodle/lms/block_timeline/Timeline';
+    }
+
+    #[\Override]
+    public function export_for_react(renderer_base $renderer): array {
+        return [
+            'midnight'           => usergetmidnight(time()),
+            'filter'             => $this->filter,
+            'order'              => $this->order,
+            'limit'              => $this->limit,
+            'nocoursesurl'       => $renderer->image_url('courses', 'block_timeline')->out(false),
+            'noeventsurl'        => $renderer->image_url('activities', 'block_timeline')->out(false),
+            'hasenrolledcourses' => $this->hasenrolledcourses,
+        ];
+    }
+}
