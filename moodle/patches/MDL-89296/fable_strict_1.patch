+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component(): void {
+        $html = html_writer::react_component(
+            '@moodle/lms/mod_book/viewer',
+            ['title' => 'My <Book> & "friends"', 'count' => 2, 'tags' => ['a', 'b'], 'unicode' => 'ü'],
+        );
+
+        $this->assertStringStartsWith('<div ', $html);
+        $this->assertStringEndsWith('></div>', $html);
+        $this->assertStringContainsString('data-react-component="@moodle/lms/mod_book/viewer"', $html);
+        $this->assertMatchesRegularExpression('/data-react-props="([^"]*)"/', $html);
+
+        // The props must round-trip through HTML attribute decoding and JSON decoding.
+        preg_match('/data-react-props="([^"]*)"/', $html, $matches);
+        $props = json_decode(htmlspecialchars_decode($matches[1]), true);
+        $this->assertSame(
+            ['title' => 'My <Book> & "friends"', 'count' => 2, 'tags' => ['a', 'b'], 'unicode' => 'ü'],
+            $props,
+        );
+
+        // No unescaped angle brackets should be present within the attribute.
+        $this->assertStringNotContainsString('<Book>', $html);
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_empty_props(): void {
+        $html = html_writer::react_component('@moodle/lms/mod_book/viewer');
+        $this->assertStringContainsString('data-react-props="{}"', $html);
+
+        $html = html_writer::react_component('@moodle/lms/mod_book/viewer', new \stdClass());
+        $this->assertStringContainsString('data-react-props="{}"', $html);
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_content_and_attributes(): void {
+        $html = html_writer::react_component(
+            '@moodle/lms/mod_book/viewer',
+            ['title' => 'Book'],
+            '<p>Loading...</p>',
+            ['id' => 'book-viewer', 'class' => 'viewer'],
+        );
+
+        $this->assertStringContainsString('id="book-viewer"', $html);
+        $this->assertStringContainsString('class="viewer"', $html);
+        $this->assertStringContainsString('data-react-component="@moodle/lms/mod_book/viewer"', $html);
+        $this->assertStringEndsWith('><p>Loading...</p></div>', $html);
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_invalid_component(): void {
+        $this->expectException(\core\exception\coding_exception::class);
+        html_writer::react_component('mod_book/viewer');
+    }
 }
