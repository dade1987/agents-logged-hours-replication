+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+declare(strict_types=1);
+
+namespace core\output;
+
+use core\output\fixtures\react_named_templatable_widget;
+use core\output\fixtures\react_overridden_widget;
+use core\output\fixtures\react_renderer;
+use core\output\fixtures\react_widget;
+
+/**
+ * Unit tests for rendering of react_renderable instances.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(renderer_base::class)]
+#[\PHPUnit\Framework\Attributes\CoversClass(plugin_renderer_base::class)]
+#[\PHPUnit\Framework\Attributes\CoversClass(html_writer::class)]
+final class react_renderable_test extends \advanced_testcase {
+    #[\Override]
+    public static function setUpBeforeClass(): void {
+        global $CFG;
+        parent::setUpBeforeClass();
+        require_once($CFG->libdir . '/tests/fixtures/output/react_renderable_fixtures.php');
+    }
+
+    /**
+     * Get a page suitable for rendering.
+     *
+     * @return \moodle_page
+     */
+    private function get_page(): \moodle_page {
+        $page = new \moodle_page();
+        $page->set_url('/');
+        $page->set_context(\core\context\system::instance());
+        return $page;
+    }
+
+    /**
+     * Extract and decode the props from a React mount point.
+     *
+     * @param string $html
+     * @return array
+     */
+    private function decode_props(string $html): array {
+        preg_match('/data-react-props="([^"]*)"/', $html, $matches);
+        $this->assertNotEmpty($matches, 'data-react-props attribute not found');
+        return json_decode(htmlspecialchars_decode($matches[1]), true);
+    }
+
+    /**
+     * The render_react_component method generates a mount point.
+     */
+    public function test_render_react_component(): void {
+        $renderer = new core_renderer($this->get_page(), RENDERER_TARGET_GENERAL);
+
+        $html = $renderer->render_react_component('@moodle/lms/mod_book/viewer', ['title' => 'Book & "Co"']);
+
+        $this->assertStringContainsString('data-react-component="@moodle/lms/mod_book/viewer"', $html);
+        $this->assertSame(['title' => 'Book & "Co"'], $this->decode_props($html));
+        $this->assertSame(
+            html_writer::react_component('@moodle/lms/mod_book/viewer', ['title' => 'Book & "Co"']),
+            $html,
+        );
+    }
+
+    /**
+     * A react_renderable is rendered as a React mount point by render().
+     */
+    public function test_render_react_renderable(): void {
+        $renderer = new core_renderer($this->get_page(), RENDERER_TARGET_GENERAL);
+
+        $html = $renderer->render(new react_widget());
+
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/fixtures/react_widget"', $html);
+        $this->assertSame(['title' => 'Hello <World>', 'count' => 3], $this->decode_props($html));
+    }
+
+    /**
+     * A react_renderable takes precedence over named_templatable.
+     */
+    public function test_render_react_renderable_precedence_over_named_templatable(): void {
+        $renderer = new core_renderer($this->get_page(), RENDERER_TARGET_GENERAL);
+
+        // If the named_templatable path were taken, the non-existent template would throw.
+        $html = $renderer->render(new react_named_templatable_widget());
+
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/fixtures/react_widget"', $html);
+        $this->assertSame(['title' => 'Hello <World>', 'count' => 3], $this->decode_props($html));
+    }
+
+    /**
+     * A render_[renderable] method takes precedence over react_renderable.
+     */
+    public function test_render_method_precedence_over_react_renderable(): void {
+        $renderer = new react_renderer($this->get_page(), RENDERER_TARGET_GENERAL);
+
+        $this->assertSame(
+            'Rendered by render_react_overridden_widget',
+            $renderer->render(new react_overridden_widget()),
+        );
+
+        // Other react renderables are still rendered as React mount points by the same renderer.
+        $html = $renderer->render(new react_widget());
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/fixtures/react_widget"', $html);
+    }
+
+    /**
+     * Plugin renderers also render react_renderable instances, with the same precedence rules.
+     */
+    public function test_plugin_renderer_render_react_renderable(): void {
+        $page = $this->get_page();
+        $renderer = new class ($page, RENDERER_TARGET_GENERAL) extends plugin_renderer_base {
+            /**
+             * Render the react_overridden_widget using a render method.
+             *
+             * @param react_overridden_widget $widget
+             * @return string
+             */
+            protected function render_react_overridden_widget(react_overridden_widget $widget): string {
+                return 'Rendered by plugin render_react_overridden_widget';
+            }
+        };
+
+        $html = $renderer->render(new react_named_templatable_widget());
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/fixtures/react_widget"', $html);
+        $this->assertSame(['title' => 'Hello <World>', 'count' => 3], $this->decode_props($html));
+
+        $this->assertSame(
+            'Rendered by plugin render_react_overridden_widget',
+            $renderer->render(new react_overridden_widget()),
+        );
+    }
+}
