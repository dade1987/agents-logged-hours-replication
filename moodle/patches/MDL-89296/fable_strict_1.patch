+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\output;
+
+/**
+ * A renderable which is rendered by mounting a React component.
+ *
+ * This interface behaves in a similar way to {@see named_templatable} and provides a simple migration path from
+ * mustache templates to React components. When a renderable implementing this interface is passed to
+ * {@see renderer_base::render()}, the renderer will generate the React mount point for the component returned by
+ * {@see get_react_component()} using the props returned by {@see export_for_react()}.
+ *
+ * Precedence within {@see renderer_base::render()}:
+ * - a `render_[renderable_name]` method on the renderer always takes precedence;
+ * - this interface takes precedence over {@see named_templatable} and {@see templatable}.
+ *
+ * Example:
+ *
+ * ```
+ * class main implements \core\output\react_renderable {
+ *     public function get_react_component(\core\output\renderer_base $renderer): string {
+ *         return '@moodle/lms/block_timeline/Timeline';
+ *     }
+ *
+ *     public function export_for_react(\core\output\renderer_base $renderer): array {
+ *         return ['filter' => $this->filter];
+ *     }
+ * }
+ *
+ * echo $OUTPUT->render(new main());
+ * ```
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface react_renderable extends renderable {
+    /**
+     * Get the fully-qualified React component specifier to mount.
+     *
+     * The specifier must be in the form `@moodle/lms/<component>/<module>`, for example
+     * `@moodle/lms/block_timeline/Timeline`.
+     *
+     * @param renderer_base $renderer The renderer requesting the component
+     * @return string
+     */
+    public function get_react_component(renderer_base $renderer): string;
+
+    /**
+     * Export the props which will be passed to the React component.
+     *
+     * The returned data must be made up of only simple types which can be serialised to JSON:
+     * array, stdClass, bool, int, float, string and null.
+     *
+     * @param renderer_base $renderer Used to do a final render of any components that need to be rendered for export.
+     * @return array|\stdClass
+     */
+    public function export_for_react(renderer_base $renderer): array|\stdClass;
+}
