+
+namespace core\output;
+
+/**
+ * A templatable which is rendered as a React component instead of a Mustache template.
+ *
+ * The props of the component are provided by {@see templatable::export_for_template()}.
+ * When rendered via renderer_base::render() this has a higher priority than named_templatable,
+ * and a lower priority than a specific render_[renderable] method on the renderer.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface react_component_renderable extends templatable {
+    /**
+     * Get the identifier of the React component to mount.
+     *
+     * For example: `@moodle/lms/block_timeline/Timeline`.
+     *
+     * @param renderer_base $renderer The renderer requesting the component name
+     * @return string
+     */
+    public function get_react_component_name(renderer_base $renderer): string;
+}
