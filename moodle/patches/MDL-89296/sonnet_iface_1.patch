diff --git a/public/lib/classes/output/html_writer.php b/public/lib/classes/output/html_writer.php
index 30b7b303ad7..bca6f4a2b38 100644
--- a/public/lib/classes/output/html_writer.php
+++ b/public/lib/classes/output/html_writer.php
@@ -834,6 +834,36 @@ class html_writer {
         return $attributes;
     }
 
+    /**
+     * Generate the mount point for a React component.
+     *
+     * The DOM contract used by the React autoinit system is an implementation detail of this method.
+     *
+     * @param string $modulename The component identifier, e.g. `@moodle/lms/block_timeline/Timeline`
+     * @param array|string|\stdClass|\JsonSerializable $props The props, or a JSON encoded string of props
+     * @return string HTML
+     */
+    public static function react_component(
+        string $modulename,
+        array|string|\stdClass|\JsonSerializable $props = [],
+    ): string {
+        if (is_string($props)) {
+            // A string is treated as already JSON encoded props; re-encode for consistent escaping.
+            $decoded = json_decode($props);
+            $props = (json_last_error() === JSON_ERROR_NONE) ? $decoded : $props;
+        }
+
+        $encoded = json_encode($props, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS);
+        if ($encoded === false) {
+            throw new coding_exception('React component props could not be encoded as JSON: ' . json_last_error_msg());
+        }
+
+        return self::div('', '', [
+            'data-react-component' => $modulename,
+            'data-react-props' => $encoded,
+        ]);
+    }
+
     /**
      * Creates a <div> tag. (Shortcut function.)
      *
