--- a/public/lib/tests/output/html_writer_test.php
+++ b/public/lib/tests/output/html_writer_test.php
@@ -363,4 +363,66 @@ EOF;
 EOF;
         $this->assertSame($expected, $output);
     }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_with_array_props(): void {
+        $output = html_writer::react_component('@moodle/lms/mod_book/viewer', ['label' => 'Save']);
+        $this->assertSame(
+            '<div data-react-component="@moodle/lms/mod_book/viewer" data-react-props="{&quot;label&quot;:&quot;Save&quot;}"></div>',
+            $output
+        );
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_with_empty_props(): void {
+        $output = html_writer::react_component('@moodle/lms/mod_book/viewer', []);
+        $this->assertStringContainsString('data-react-props="{}"', $output);
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_with_stdclass_props(): void {
+        $props = new \stdClass();
+        $props->title = 'Book';
+        $output = html_writer::react_component('@moodle/lms/mod_book/viewer', $props);
+        $this->assertStringContainsString('data-react-props="{&quot;title&quot;:&quot;Book&quot;}"', $output);
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_with_json_string_props(): void {
+        $output = html_writer::react_component('@moodle/lms/mod_book/viewer', '{"title":"Book"}');
+        $this->assertStringContainsString('data-react-props="{&quot;title&quot;:&quot;Book&quot;}"', $output);
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_escapes_props(): void {
+        $output = html_writer::react_component('@moodle/lms/mod_book/viewer', ['html' => '<script>alert(1)</script>']);
+        $this->assertStringNotContainsString('<script>', $output);
+        $this->assertStringContainsString('\\u003Cscript\\u003E', $output);
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_invalid_json_string_props(): void {
+        $this->expectException(\core\exception\coding_exception::class);
+        html_writer::react_component('@moodle/lms/mod_book/viewer', '{invalid');
+    }
+
+    /**
+     * @covers ::react_component
+     */
+    public function test_react_component_empty_modulename(): void {
+        $this->expectException(\core\exception\coding_exception::class);
+        html_writer::react_component('', []);
+    }
 }
