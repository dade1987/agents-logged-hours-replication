+
+namespace core\output;
+
+/**
+ * A renderable which is rendered as a React component mount point.
+ *
+ * When a renderable implementing this interface is passed to a renderer's render() method, the mount point is
+ * generated using {@see \core\output\html_writer::react_component()}. A specific render_[renderable] method on the
+ * renderer takes precedence over this interface, and this interface takes precedence over named_templatable.
+ *
+ * @package   core
+ * @category  output
+ * @copyright 2026 Moodle
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface react_component_renderable extends renderable {
+    /**
+     * Get the fully-qualified React component identifier to mount.
+     *
+     * @return string For example '@moodle/lms/block_timeline/Timeline'.
+     */
+    public function get_react_component(): string;
+
+    /**
+     * Get the props to pass to the React component.
+     *
+     * @return array|string|\stdClass|\JsonSerializable A string must already be valid JSON.
+     */
+    public function get_react_props(): array|string|\stdClass|\JsonSerializable;
+}
