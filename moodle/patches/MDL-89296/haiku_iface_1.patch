diff --git a/public/lib/classes/output/html_writer.php b/public/lib/classes/output/html_writer.php
index 30b7b303ad7..0809d0ef795 100644
--- a/public/lib/classes/output/html_writer.php
+++ b/public/lib/classes/output/html_writer.php
@@ -866,6 +866,47 @@ class html_writer {
         return self::end_tag('div');
     }
 
+    /**
+     * Generates the mount point for a React component.
+     *
+     * This hides the DOM contract used by the React autoinit system (core/react_autoinit) from feature code.
+     * Callers only provide the component identifier and its props; the props are serialised and escaped here.
+     *
+     * @param string $modulename The fully-qualified component identifier, e.g. '@moodle/lms/block_timeline/Timeline'.
+     * @param array|string|\stdClass|\JsonSerializable $props The component props. A string must already be valid JSON.
+     * @return string HTML fragment for the mount point.
+     * @throws coding_exception If the module name is empty, the props cannot be serialised or the JSON string is invalid.
+     */
+    public static function react_component(
+        string $modulename,
+        array|string|\stdClass|\JsonSerializable $props,
+    ): string {
+        if (trim($modulename) === '') {
+            throw new coding_exception('A React component module name must be provided.');
+        }
+
+        $flags = JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT;
+        if (is_string($props)) {
+            if (!json_validate($props)) {
+                throw new coding_exception('React component props passed as a string must be valid JSON.');
+            }
+            $json = $props;
+        } else if (is_array($props) && empty($props)) {
+            // An empty array would otherwise serialise as a JSON list, but component props must be an object.
+            $json = '{}';
+        } else {
+            $json = json_encode($props, $flags);
+            if ($json === false) {
+                throw new coding_exception('React component props could not be serialised: ' . json_last_error_msg());
+            }
+        }
+
+        return self::div('', '', [
+            'data-react-component' => $modulename,
+            'data-react-props' => $json,
+        ]);
+    }
+
     /**
      * Creates a <span> tag. (Shortcut function.)
      *
