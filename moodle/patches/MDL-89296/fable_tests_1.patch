@@ -136,6 +136,112 @@ final class html_writer_test extends \basic_testcase {
     /**
      * @covers ::div
      */
+    /**
+     * Test the generation of a React component mount point.
+     */
+    public function test_react_component(): void {
+        // Component and props only.
+        $this->assertSame(
+            '<div data-react-component="@moodle/lms/mod_book/viewer" data-react-props="{&quot;title&quot;:&quot;My Book&quot;}">'
+                . '</div>',
+            html_writer::react_component('@moodle/lms/mod_book/viewer', ['title' => 'My Book'])
+        );
+
+        // Props as an object.
+        $this->assertSame(
+            '<div data-react-component="@moodle/lms/mod_book/viewer" data-react-props="{&quot;title&quot;:&quot;My Book&quot;}">'
+                . '</div>',
+            html_writer::react_component('@moodle/lms/mod_book/viewer', (object) ['title' => 'My Book'])
+        );
+
+        // Empty props are always serialised as an object.
+        $this->assertSame(
+            '<div data-react-component="@moodle/lms/mod_book/viewer" data-react-props="{}"></div>',
+            html_writer::react_component('@moodle/lms/mod_book/viewer')
+        );
+
+        // Additional attributes and placeholder content.
+        $this->assertSame(
+            '<div id="viewer" class="frog" data-react-component="@moodle/lms/mod_book/viewer" data-react-props="{}">'
+                . '<p>Loading...</p></div>',
+            html_writer::react_component(
+                '@moodle/lms/mod_book/viewer',
+                [],
+                ['id' => 'viewer', 'class' => 'frog'],
+                '<p>Loading...</p>',
+            )
+        );
+
+        // The React attributes cannot be overridden through the attributes.
+        $this->assertSame(
+            '<div data-react-component="@moodle/lms/mod_book/viewer" data-react-props="{}"></div>',
+            html_writer::react_component(
+                '@moodle/lms/mod_book/viewer',
+                [],
+                ['data-react-component' => 'other', 'data-react-props' => 'other'],
+            )
+        );
+    }
+
+    /**
+     * Test that the props of a React component are escaped and can be decoded back.
+     */
+    public function test_react_component_escaping(): void {
+        $props = [
+            'title' => '<script>alert("x")</script> & \'quotes\'',
+            'url' => 'https://example.com/?a=1&b=2',
+            'unicode' => 'Ünïcødé',
+            'nested' => ['list' => [1, 2.5, true, null], 'object' => ['key' => 'value']],
+        ];
+        $html = html_writer::react_component('@moodle/lms/mod_book/viewer', $props);
+
+        // No raw HTML special characters in the output.
+        $this->assertStringNotContainsString('<script>', $html);
+        $this->assertStringNotContainsString("'", $html);
+        $this->assertStringNotContainsString('&b=', $html);
+
+        // The attribute value decodes to the original props after a single level of HTML decoding.
+        preg_match('/data-react-props="([^"]*)"/', $html, $matches);
+        $this->assertNotEmpty($matches);
+        $this->assertSame($props, json_decode(htmlspecialchars_decode($matches[1], ENT_QUOTES), true));
+    }
+
+    /**
+     * Test that an invalid component specifier is rejected.
+     *
+     * @param string $component
+     */
+    #[\PHPUnit\Framework\Attributes\DataProvider('react_component_invalid_provider')]
+    public function test_react_component_invalid_component(string $component): void {
+        $this->expectException(\core\exception\coding_exception::class);
+        html_writer::react_component($component);
+    }
+
+    /**
+     * Data provider for test_react_component_invalid_component.
+     *
+     * @return array
+     */
+    public static function react_component_invalid_provider(): array {
