diff --git a/public/lib/classes/output/html_writer.php b/public/lib/classes/output/html_writer.php
index 30b7b303ad7..30148162db6 100644
--- a/public/lib/classes/output/html_writer.php
+++ b/public/lib/classes/output/html_writer.php
@@ -846,6 +846,68 @@ class html_writer {
         return self::tag('div', $content, self::add_class($class, $attributes));
     }
 
+    /**
+     * Creates a mount point for a React component.
+     *
+     * The returned element is picked up by the `core/react_autoinit` module which imports the component
+     * module and mounts it, passing the supplied props. The DOM contract used by the autoinit system
+     * (the `data-*` attributes and the way the props are serialised) is an internal detail of the
+     * frontend platform and consumers should not rely upon it.
+     *
+     * The component must be a fully-qualified ESM specifier in the form `@moodle/lms/<component>/<module>`,
+     * for example `@moodle/lms/block_timeline/Timeline`. The module must have a default-exported React
+     * function component.
+     *
+     * The props must be JSON serialisable: only simple types (array, stdClass, bool, int, float, string, null)
+     * are supported.
+     *
+     * @param string $component The component specifier in `@moodle/lms/<component>/<module>` format.
+     * @param array|\stdClass $props The props to pass to the component.
+     * @param null|array $attributes Optional other attributes for the mount element (e.g. 'id', 'class').
+     * @param string $content Optional placeholder content shown until the component is mounted.
+     * @return string HTML code for the mount point.
+     * @throws coding_exception If the component specifier is invalid or the props cannot be serialised.
+     */
+    public static function react_component(
+        string $component,
+        array|\stdClass $props = [],
+        ?array $attributes = null,
+        string $content = '',
+    ): string {
+        if (!self::is_valid_react_component($component)) {
+            throw new coding_exception(
+                'Invalid React component specifier. Expected the format @moodle/lms/<component>/<module>.',
+                $component,
+            );
+        }
+
+        try {
+            $encodedprops = json_encode(
+                (object) $props,
+                JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS,
+            );
+        } catch (\JsonException $e) {
+            throw new coding_exception('Unable to serialise the React component props.', $e->getMessage());
+        }
+
+        $attributes = (array) $attributes;
+        unset($attributes['data-react-component'], $attributes['data-react-props']);
+        $attributes['data-react-component'] = $component;
+        $attributes['data-react-props'] = $encodedprops;
+
+        return self::tag('div', $content, $attributes);
+    }
+
+    /**
+     * Check whether the supplied value is a valid React component specifier.
+     *
+     * @param string $component The component specifier.
+     * @return bool
+     */
+    protected static function is_valid_react_component(string $component): bool {
+        return (bool) preg_match('#^@moodle/lms/[a-z][a-z0-9_]*/[^\s/][^\s]*$#', $component);
+    }
+
     /**
      * Starts a <div> tag. (Shortcut function.)
      *
