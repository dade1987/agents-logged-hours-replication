+namespace core\output;
+
+/**
+ * Interface marking a renderable which is rendered by mounting a React component.
+ *
+ * When a renderable implementing this interface is passed to {@see renderer_base::render()}, and no
+ * `render_[renderable]` method exists in the renderer, a React mount point for the component returned by
+ * {@see react_renderable::get_react_component()} is generated with the props returned by
+ * {@see react_renderable::export_for_react()}.
+ *
+ * This interface has a higher precedence than {@see named_templatable} and {@see templatable}, and a
+ * lower precedence than a correctly named `render_[renderable]` method in the renderer, which allows a
+ * theme to override the output.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface react_renderable extends renderable {
+    /**
+     * Get the React component to mount for this renderable.
+     *
+     * The component must be a fully-qualified ESM specifier in the form `@moodle/lms/<component>/<module>`,
+     * for example `@moodle/lms/block_timeline/Timeline`.
+     *
+     * @param renderer_base $renderer The renderer requesting the component
+     * @return string
+     */
+    public function get_react_component(renderer_base $renderer): string;
+
+    /**
+     * Export the props to pass to the React component.
+     *
+     * The props must be JSON serialisable. This means:
+     * 1. No complex types - only stdClass, array, int, string, float, bool, null
+     * 2. Any additional info that is required by the component is pre-calculated (e.g. capability checks).
+     *
+     * @param renderer_base $renderer The renderer requesting the props
+     * @return \stdClass|array
+     */
+    public function export_for_react(renderer_base $renderer): \stdClass|array;
+}
