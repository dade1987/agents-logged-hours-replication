+declare(strict_types=1);
+
+namespace core\output;
+
+/**
+ * Unit tests for rendering react_renderable renderables.
+ *
+ * @package    core
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(renderer_base::class)]
+#[\PHPUnit\Framework\Attributes\CoversClass(react_renderable::class)]
+final class react_renderable_test extends \advanced_testcase {
+    /**
+     * A react_renderable is rendered as a React mount point.
+     */
+    public function test_render_react_renderable(): void {
+        global $PAGE;
+
+        $renderer = new renderer_base($PAGE, RENDERER_TARGET_GENERAL);
+        $widget = new class implements react_renderable {
+            #[\Override]
+            public function get_react_component(renderer_base $renderer): string {
+                return '@moodle/lms/core/example';
+            }
+
+            #[\Override]
+            public function export_for_react(renderer_base $renderer): \stdClass|array {
+                return ['title' => 'Hello'];
+            }
+        };
+
+        $this->assertSame(
+            $renderer->render_react_component('@moodle/lms/core/example', ['title' => 'Hello']),
+            $renderer->render($widget),
+        );
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/example"', $renderer->render($widget));
+    }
+
+    /**
+     * A react_renderable takes precedence over named_templatable and templatable.
+     */
+    public function test_render_react_renderable_precedence_over_templatable(): void {
+        global $PAGE;
+
+        $renderer = new renderer_base($PAGE, RENDERER_TARGET_GENERAL);
+        $widget = new class implements react_renderable, named_templatable {
+            #[\Override]
+            public function get_react_component(renderer_base $renderer): string {
+                return '@moodle/lms/core/example';
+            }
+
+            #[\Override]
+            public function export_for_react(renderer_base $renderer): \stdClass|array {
+                return ['title' => 'Hello'];
+            }
+
+            #[\Override]
+            public function get_template_name(renderer_base $renderer): string {
+                throw new \Exception('The template name should not be requested.');
+            }
+
+            #[\Override]
+            public function export_for_template(renderer_base $output) {
+                throw new \Exception('The template context should not be requested.');
+            }
+        };
+
+        $this->assertStringContainsString('data-react-component="@moodle/lms/core/example"', $renderer->render($widget));
+    }
+
+    /**
+     * A render_[renderable] method takes precedence over react_renderable.
+     */
+    public function test_render_method_precedence_over_react_renderable(): void {
+        global $PAGE;
+
+        $renderer = new class ($PAGE, RENDERER_TARGET_GENERAL) extends renderer_base {
+            /**
+             * Render the example widget.
+             *
+             * @param react_renderable $widget
+             * @return string
+             */
+            protected function render_example_react_widget(react_renderable $widget): string {
+                return 'rendered by render_example_react_widget';
+            }
+        };
+
+        $this->assertSame('rendered by render_example_react_widget', $renderer->render(new example_react_widget()));
+    }
+}
+
+/**
+ * Example react renderable used for testing render_ method precedence.
+ *
+ * @package    core
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class example_react_widget implements react_renderable {
+    #[\Override]
+    public function get_react_component(renderer_base $renderer): string {
+        throw new \Exception('The React component should not be requested.');
+    }
+
+    #[\Override]
+    public function export_for_react(renderer_base $renderer): \stdClass|array {
+        throw new \Exception('The React props should not be requested.');
+    }
+}
