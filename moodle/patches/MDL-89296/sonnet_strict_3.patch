+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\output;
+
+/**
+ * Standard API for mounting React components from PHP.
+ *
+ * Feature code only specifies the component identifier and its props. The DOM contract used by the
+ * React autoinit system, and the serialisation of props, are internal details of this class.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class react {
+    /**
+     * Get the HTML for a mount point for a React component.
+     *
+     * @param string $component Fully-qualified ESM specifier, e.g. '@moodle/lms/block_timeline/Timeline'
+     * @param array $props Props to pass to the component (must be JSON serialisable)
+     * @param array $attributes Optional additional HTML attributes for the mount element (e.g. id, class)
+     * @param string $content Optional HTML content to display until the component has mounted
+     * @return string HTML
+     */
+    public static function mount(
+        string $component,
+        array $props = [],
+        array $attributes = [],
+        string $content = '',
+    ): string {
+        $attrs = ' data-react-component="' . s($component) . '"';
+        $encoded = json_encode($props, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS);
+        if ($encoded === false) {
+            throw new \coding_exception('React component props could not be encoded as JSON: ' . json_last_error_msg());
+        }
+        $attrs .= ' data-react-props="' . s($encoded) . '"';
+
+        foreach ($attributes as $name => $value) {
+            if ($name === 'data-react-component' || $name === 'data-react-props') {
+                continue;
+            }
+            if ($value === null || $value === false) {
+                continue;
+            }
+            if ($value === true) {
+                $attrs .= ' ' . s($name);
+                continue;
+            }
+            $attrs .= ' ' . s($name) . '="' . s($value) . '"';
+        }
+
+        return '<div' . $attrs . '>' . $content . '</div>';
+    }
+}
diff --git a/public/lib/classes/output/renderable_react_component.php b/public/lib/classes/output/renderable_react_component.php
