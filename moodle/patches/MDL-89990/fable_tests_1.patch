diff --git a/public/lib/tests/oauth2_test.php b/public/lib/tests/oauth2_test.php
index be2f9d736b3..6a186e654d9 100644
--- a/public/lib/tests/oauth2_test.php
+++ b/public/lib/tests/oauth2_test.php
@@ -210,6 +210,137 @@ final class oauth2_test extends \advanced_testcase {
         $this->assertTrue((bool)$check->get('enabled'));
     }
 
+    /**
+     * Tests that CRUD operations on issuers, endpoints and user field mappings are logged to the config log.
+     */
+    public function test_config_log(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        // Create an issuer.
+        $data = (object) [
+            'name' => 'My issuer',
+            'clientid' => 'myclientid',
+            'clientsecret' => 'mysecret',
+            'baseurl' => '',
+            'image' => '',
+            'loginscopes' => 'openid',
+            'loginscopesoffline' => 'openid',
+            'loginparams' => '',
+            'loginparamsoffline' => '',
+            'alloweddomains' => '',
+            'enabled' => 1,
+            'showonloginpage' => issuer::SERVICEONLY,
+            'servicetype' => '',
+        ];
+        $issuer = api::create_issuer($data);
+        $issuerid = $issuer->get('id');
+
+        $log = $DB->get_record('config_log', ['name' => 'oauth2_issuer_created'], '*', MUST_EXIST);
+        $this->assertEquals('core', $log->plugin);
+        $this->assertEquals('', $log->oldvalue);
+        $this->assertStringContainsString("issuer {$issuerid} (My issuer)", $log->value);
+        $this->assertStringContainsString('"clientid":"myclientid"', $log->value);
+        // The client secret must never be logged.
+        $this->assertStringNotContainsString('mysecret', $log->value);
+        $this->assertStringContainsString('"clientsecret":"********"', $log->value);
+        $this->assertEquals(get_admin()->id, $log->userid);
+
+        // Update the issuer.
+        $data->id = $issuerid;
+        $data->name = 'My renamed issuer';
+        $data->clientid = 'mynewclientid';
+        api::update_issuer($data);
+
+        $log = $DB->get_record('config_log', ['name' => 'oauth2_issuer_updated'], '*', MUST_EXIST);
+        $this->assertStringContainsString("issuer {$issuerid} (My renamed issuer)", $log->oldvalue);
+        $this->assertStringContainsString('"name":"My issuer"', $log->oldvalue);
+        $this->assertStringContainsString('"clientid":"myclientid"', $log->oldvalue);
+        $this->assertStringContainsString('"name":"My renamed issuer"', $log->value);
+        $this->assertStringContainsString('"clientid":"mynewclientid"', $log->value);
+        // Only the changed fields are logged.
+        $this->assertStringNotContainsString('loginscopes', $log->value);
+        $this->assertStringNotContainsString('clientsecret', $log->value);
+
+        // Updating an issuer without changing anything does not log anything.
+        api::update_issuer($data);
+        $this->assertEquals(1, $DB->count_records('config_log', ['name' => 'oauth2_issuer_updated']));
+
+        // Disable and enable the issuer.
+        api::disable_issuer($issuerid);
+        $log = $DB->get_record('config_log', ['name' => 'oauth2_issuer_disabled'], '*', MUST_EXIST);
+        $this->assertStringContainsString('"enabled":"1"', $log->oldvalue);
+        $this->assertStringContainsString('"enabled":0', $log->value);
+        api::enable_issuer($issuerid);
+        $log = $DB->get_record('config_log', ['name' => 'oauth2_issuer_enabled'], '*', MUST_EXIST);
+        $this->assertStringContainsString('"enabled":"0"', $log->oldvalue);
+        $this->assertStringContainsString('"enabled":1', $log->value);
+
+        // Create, update and delete an endpoint.
+        $endpoint = api::create_endpoint((object) [
+            'issuerid' => $issuerid,
+            'name' => 'my_endpoint',
+            'url' => 'https://example.com/my',
+        ]);
+        $endpointid = $endpoint->get('id');
+        $log = $DB->get_record('config_log', ['name' => 'oauth2_endpoint_created'], '*', MUST_EXIST);
+        $this->assertEquals('', $log->oldvalue);
+        $this->assertStringContainsString("endpoint {$endpointid} (my_endpoint)", $log->value);
+        $this->assertStringContainsString('"url":"https://example.com/my"', $log->value);
+
+        api::update_endpoint((object) [
+            'id' => $endpointid,
+            'issuerid' => $issuerid,
+            'name' => 'my_endpoint',
+            'url' => 'https://example.com/other',
+        ]);
+        $log = $DB->get_record('config_log', ['name' => 'oauth2_endpoint_updated'], '*', MUST_EXIST);
+        $this->assertStringContainsString('"url":"https://example.com/my"', $log->oldvalue);
+        $this->assertStringContainsString('"url":"https://example.com/other"', $log->value);
+
+        api::delete_endpoint($endpointid);
+        $log = $DB->get_record('config_log', ['name' => 'oauth2_endpoint_deleted'], '*', MUST_EXIST);
+        $this->assertStringContainsString("endpoint {$endpointid} (my_endpoint)", $log->oldvalue);
+        $this->assertStringContainsString('"url":"https://example.com/other"', $log->oldvalue);
+        $this->assertEquals('', $log->value);
+
+        // Create, update and delete a user field mapping.
+        $mapping = api::create_user_field_mapping((object) [
+            'issuerid' => $issuerid,
+            'externalfield' => 'given_name',
+            'internalfield' => 'firstname',
+        ]);
+        $mappingid = $mapping->get('id');
+        $log = $DB->get_record('config_log', ['name' => 'oauth2_user_field_mapping_created'], '*', MUST_EXIST);
+        $this->assertEquals('', $log->oldvalue);
+        $this->assertStringContainsString("user_field_mapping {$mappingid} (given_name -> firstname)", $log->value);
+
+        api::update_user_field_mapping((object) [
+            'id' => $mappingid,
+            'issuerid' => $issuerid,
+            'externalfield' => 'given_name',
+            'internalfield' => 'lastname',
+        ]);
+        $log = $DB->get_record('config_log', ['name' => 'oauth2_user_field_mapping_updated'], '*', MUST_EXIST);
+        $this->assertStringContainsString('"internalfield":"firstname"', $log->oldvalue);
+        $this->assertStringContainsString('"internalfield":"lastname"', $log->value);
+
+        api::delete_user_field_mapping($mappingid);
+        $log = $DB->get_record('config_log', ['name' => 'oauth2_user_field_mapping_deleted'], '*', MUST_EXIST);
+        $this->assertStringContainsString('"internalfield":"lastname"', $log->oldvalue);
+        $this->assertEquals('', $log->value);
+
+        // Delete the issuer.
+        api::delete_issuer($issuerid);
+        $log = $DB->get_record('config_log', ['name' => 'oauth2_issuer_deleted'], '*', MUST_EXIST);
+        $this->assertStringContainsString("issuer {$issuerid} (My renamed issuer)", $log->oldvalue);
+        $this->assertStringContainsString('"clientid":"mynewclientid"', $log->oldvalue);
+        $this->assertStringNotContainsString('mysecret', $log->oldvalue);
+        $this->assertEquals('', $log->value);
+    }
+
