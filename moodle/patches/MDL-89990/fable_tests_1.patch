 class api {
 
+    /**
+     * Add an entry to the admin config log for a change to an OAuth2 object (issuer, endpoint or user field mapping).
+     *
+     * The log entry contains a description of the changed object (and, for updates, the values before
+     * and after the change) so that OAuth2 configuration changes can be reviewed in the config changes report.
+     * Sensitive values (the client secret) are never written to the log.
+     *
+     * @param string $name The config log name, e.g. 'oauth2_issuer_created'.
+     * @param \core\persistent $object The OAuth2 object that was created, updated or deleted.
+     * @param stdClass|null $oldrecord The record before the change (for updates and deletions), or null for creations.
+     * @param stdClass|null $newrecord The record after the change (for creations and updates), or null for deletions.
+     */
+    public static function add_to_config_log(
+        string $name,
+        \core\persistent $object,
+        ?stdClass $oldrecord = null,
+        ?stdClass $newrecord = null,
+    ): void {
+        $sensitive = ['clientsecret'];
+        $ignored = ['id', 'usermodified', 'timecreated', 'timemodified'];
+
+        $describe = function (?stdClass $record) use ($sensitive, $ignored): string {
+            if ($record === null) {
+                return '';
+            }
+            $values = [];
+            foreach ((array) $record as $key => $value) {
+                if (in_array($key, $ignored, true)) {
+                    continue;
+                }
+                if (in_array($key, $sensitive, true)) {
+                    $value = empty($value) ? '' : '********';
+                }
+                $values[$key] = $value;
+            }
+            return json_encode($values, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
+        };
+
+        if ($oldrecord !== null && $newrecord !== null) {
+            // Only log the properties that have actually changed.
+            $oldvalues = (array) $oldrecord;
+            $newvalues = (array) $newrecord;
+            foreach ($ignored as $key) {
+                unset($oldvalues[$key], $newvalues[$key]);
+            }
+            $changed = [];
+            foreach ($newvalues as $key => $value) {
+                if (!array_key_exists($key, $oldvalues) || (string) $oldvalues[$key] !== (string) $value) {
+                    $changed[$key] = true;
+                }
+            }
+            foreach ($oldvalues as $key => $value) {
+                if (!array_key_exists($key, $newvalues)) {
+                    $changed[$key] = true;
+                }
+            }
+            if (empty($changed)) {
+                // Nothing has changed, nothing to log.
+                return;
+            }
+            $oldrecord = (object) (['id' => $oldrecord->id ?? null] + array_intersect_key($oldvalues, $changed));
+            $newrecord = (object) (['id' => $newrecord->id ?? null] + array_intersect_key($newvalues, $changed));
+        }
+
+        // Prefix the log values with the object type and id so the entry can be related to the actual object.
+        // Note: the id is taken from the records as a deleted persistent no longer has an id.
+        $id = $newrecord->id ?? $oldrecord->id ?? $object->get('id');
+        $parts = explode('\\', get_class($object));
+        $prefix = end($parts) . ' ' . $id;
+        if ($object instanceof issuer) {
+            $prefix .= ' (' . $object->get('name') . ')';
+        } else if ($object instanceof endpoint) {
+            $prefix .= ' (' . $object->get('name') . ')';
+        } else if ($object instanceof user_field_mapping) {
+            $prefix .= ' (' . $object->get('externalfield') . ' -> ' . $object->get('internalfield') . ')';
+        }
+
+        $oldvalue = $oldrecord === null ? '' : $prefix . ': ' . $describe($oldrecord);
+        $value = $newrecord === null ? '' : $prefix . ': ' . $describe($newrecord);
+
+        add_to_config_log($name, $oldvalue, $value, 'core');
+    }
+
