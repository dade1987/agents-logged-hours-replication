+    /**
+     * Test that administrative changes to a client are recorded in the config changes log.
+     *
+     * @return void
+     */
+    public function test_changes_are_recorded_in_config_log(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $manager = $this->get_manager();
+        $client = $this->create_fixture_client($manager, ['https://example.com/callback']);
+        $plugin = client_manager::CONFIG_LOG_PLUGIN_PREFIX . $client->clientidentifier;
+
+        $getlogs = fn(string $name): array => array_values($DB->get_records(
+            'config_log',
+            ['plugin' => $plugin, 'name' => $name],
+            'id ASC',
+        ));
+
+        // Creation.
+        $logs = $getlogs('client_created');
+        $this->assertCount(1, $logs);
+        $this->assertNull($logs[0]->oldvalue);
+        $created = json_decode($logs[0]->value, true);
+        $this->assertEquals('Test client', $created['name']);
+        $this->assertEquals(['https://example.com/callback'], $created['redirecturis']);
+        $this->assertEquals(get_admin()->id, $logs[0]->userid);
+
+        // Update: only changed fields are logged.
+        $manager->update_client($client->id, ['name' => 'Renamed client', 'description' => $client->description]);
+        $logs = $getlogs('name');
+        $this->assertCount(1, $logs);
+        $this->assertEquals('Test client', $logs[0]->oldvalue);
+        $this->assertEquals('Renamed client', $logs[0]->value);
+        $this->assertCount(0, $getlogs('description'));
+
+        // Redirect URIs.
+        $manager->add_redirect_uri($client->id, 'https://example.com/other');
+        $manager->add_redirect_uri($client->id, 'https://example.com/other');
+        $logs = $getlogs('redirecturi_added');
+        $this->assertCount(1, $logs);
+        $this->assertEquals('https://example.com/other', $logs[0]->value);
+
+        $manager->remove_redirect_uri($client->id, 'https://example.com/callback');
+        $manager->remove_redirect_uri($client->id, 'https://example.com/callback');
+        $logs = $getlogs('redirecturi_removed');
+        $this->assertCount(1, $logs);
+        $this->assertEquals('https://example.com/callback', $logs[0]->oldvalue);
+
+        // Secrets: the plain text secret must never be logged.
+        $secret = $manager->create_secret($client->id);
+        $logs = $getlogs('secret_created');
+        $this->assertCount(1, $logs);
+        $secretid = (int) $logs[0]->value;
+        $this->assertTrue($DB->record_exists('oauth2_server_client_secrets', ['id' => $secretid]));
+        $this->assertFalse($DB->record_exists_select(
+            'config_log',
+            $DB->sql_like('value', ':secret'),
+            ['secret' => '%' . $DB->sql_like_escape($secret) . '%'],
+        ));
+
+        $manager->revoke_secret($secretid);
+        $manager->revoke_secret($secretid);
+        $logs = $getlogs('secret_revoked');
+        $this->assertCount(1, $logs);
+        $this->assertEquals($secretid, $logs[0]->oldvalue);
+
+        // Status changes.
+        $manager->disable_client($client->id);
+        $manager->reactivate_client($client->id);
+        $logs = $getlogs('status');
+        $this->assertCount(2, $logs);
+        $this->assertEquals(['active', 'disabled'], [$logs[0]->oldvalue, $logs[0]->value]);
+        $this->assertEquals(['disabled', 'active'], [$logs[1]->oldvalue, $logs[1]->value]);
+
+        // Deletion.
+        $manager->disable_client($client->id);
+        $manager->delete_client($client->id);
+        $logs = $getlogs('client_deleted');
+        $this->assertCount(1, $logs);
+        $this->assertNull($logs[0]->value);
+        $deleted = json_decode($logs[0]->oldvalue, true);
+        $this->assertEquals('Renamed client', $deleted['name']);
+        $this->assertEquals(['https://example.com/other'], $deleted['redirecturis']);
+    }
 }
