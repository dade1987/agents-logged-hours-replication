+    /**
+     * Record an administrative change to a client in the config changes log.
+     *
+     * Each change is logged against a pseudo plugin name which carries the client identifier, so that the
+     * config changes report shows which client was affected.
+     *
+     * @param string $clientidentifier The public client identifier.
+     * @param string $name The name of the property or action which changed.
+     * @param string|null $oldvalue The previous value.
+     * @param string|null $value The new value.
+     * @return void
+     */
+    protected function log_config_change(
+        string $clientidentifier,
+        string $name,
+        ?string $oldvalue,
+        ?string $value,
+    ): void {
+        add_to_config_log($name, $oldvalue, $value, self::CONFIG_LOG_PLUGIN_PREFIX . $clientidentifier);
+    }
+
+    /**
+     * Build a summary of a client suitable for the config changes log.
+     *
+     * @param \stdClass $record The client record.
+     * @param string[] $redirecturis The redirect URIs of the client.
+     * @return string The JSON encoded summary.
+     */
+    protected function describe_client(\stdClass $record, array $redirecturis): string {
+        return json_encode([
+            'name' => $record->name,
+            'description' => $record->description,
+            'clientidentifier' => $record->clientidentifier,
+            'ownercontext' => (int) $record->ownercontext,
+            'status' => $this->get_status_name((int) $record->status),
+            'isconfidential' => (int) $record->isconfidential,
+            'granttypes' => $record->granttypes,
+            'ispkcerequired' => (int) $record->ispkcerequired,
+            'scopes' => $record->scopes ?? '',
+            'redirecturis' => array_values($redirecturis),
+        ], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
+    }
+
+    /**
+     * Get a readable name for a client status, for the config changes log.
+     *
+     * @param int $status The client status.
+     * @return string The status name.
+     */
+    protected function get_status_name(int $status): string {
+        return match ($status) {
+            client_entity::STATUS_ACTIVE => 'active',
+            client_entity::STATUS_DISABLED => 'disabled',
+            default => (string) $status,
+        };
+    }
+
