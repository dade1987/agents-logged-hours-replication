+    /**
+     * Add an entry to the config log for a change made to OAuth 2 configuration.
+     *
+     * @param string $name The log entry name.
+     * @param mixed $oldvalue Previous value.
+     * @param mixed $value New value.
+     * @param string|null $extra Optional description appended to the new value.
+     */
+    protected static function log_change(string $name, $oldvalue, $value, ?string $extra = null): void {
+        if ($extra !== null) {
+            $value = "{$value} {$extra}";
+        }
+        add_to_config_log('oauth2_' . $name, $oldvalue, $value, 'core');
+    }
+
+    /**
+     * Build a short description of an OAuth 2 persistent object for logging.
+     *
+     * @param \core\persistent $persistent
+     * @return string
+     */
+    protected static function describe(\core\persistent $persistent): string {
+        $class = (new \ReflectionClass($persistent))->getShortName();
+        $label = $persistent->get('id');
+        if ($persistent instanceof issuer) {
+            $label .= ' (' . $persistent->get('name') . ')';
+        } else if ($persistent instanceof endpoint || $persistent instanceof user_field_mapping) {
+            $label .= ' (issuer ' . $persistent->get('issuerid') . ')';
+        }
+        return "{$class} {$label}";
+    }
