@@ -210,6 +210,74 @@ final class oauth2_test extends \advanced_testcase {
         $this->assertTrue((bool)$check->get('enabled'));
     }
 
+    /**
+     * Tests that creating, updating and deleting an issuer is logged to the config log.
+     *
+     * @covers \core\oauth2\issuer
+     */
+    public function test_issuer_config_log(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        // Create.
+        $DB->delete_records('config_log');
+        $data = (object) [
+            'name' => 'Test issuer',
+            'clientid' => 'myclientid',
+            'clientsecret' => 'mysecret',
+            'baseurl' => '',
+        ];
+        $issuer = api::create_issuer($data);
+        $issuerid = $issuer->get('id');
+        $prefix = 'issuer_' . $issuerid . '_';
+
+        $log = $DB->get_record('config_log', ['plugin' => 'core_oauth2', 'name' => $prefix . 'name']);
+        $this->assertNotEmpty($log);
+        $this->assertNull($log->oldvalue);
+        $this->assertEquals('Test issuer', $log->value);
+
+        $log = $DB->get_record('config_log', ['plugin' => 'core_oauth2', 'name' => $prefix . 'clientid']);
+        $this->assertEquals('myclientid', $log->value);
+
+        // The secret must never be stored in clear text.
+        $log = $DB->get_record('config_log', ['plugin' => 'core_oauth2', 'name' => $prefix . 'clientsecret']);
+        $this->assertEquals('********', $log->value);
+        $this->assertFalse($DB->record_exists_select('config_log', $DB->sql_like('value', ':value'),
+            ['value' => '%mysecret%']));
+
+        // Update.
+        $DB->delete_records('config_log');
+        $data = $issuer->to_record();
+        $data->name = 'Renamed issuer';
+        api::update_issuer($data);
+        $logs = $DB->get_records('config_log', ['plugin' => 'core_oauth2']);
+        $this->assertCount(1, $logs);
+        $log = reset($logs);
+        $this->assertEquals($prefix . 'name', $log->name);
+        $this->assertEquals('Test issuer', $log->oldvalue);
+        $this->assertEquals('Renamed issuer', $log->value);
+
+        // Disable.
+        $DB->delete_records('config_log');
+        api::disable_issuer($issuerid);
+        $log = $DB->get_record('config_log', ['plugin' => 'core_oauth2', 'name' => $prefix . 'enabled']);
+        $this->assertEquals('1', $log->oldvalue);
+        $this->assertEquals('0', $log->value);
+
+        // Updating without changes does not log anything.
+        $DB->delete_records('config_log');
+        api::disable_issuer($issuerid);
+        $this->assertEquals(0, $DB->count_records('config_log', ['plugin' => 'core_oauth2']));
+
+        // Delete.
+        api::delete_issuer($issuerid);
+        $log = $DB->get_record('config_log', ['plugin' => 'core_oauth2', 'name' => $prefix . 'name']);
+        $this->assertEquals('Renamed issuer', $log->oldvalue);
+        $this->assertNull($log->value);
+    }
