@@ -57,6 +57,56 @@ final class base_test extends \advanced_testcase {
         );
     }
 
+    /**
+     * Test that static methods overridden in a child class are used by the base class (late static binding).
+     */
+    public function test_child_static_override(): void {
+        $contextid = 1;
+        // Create an anonymous class that extends the base class and overrides a static method.
+        $action = new class($contextid) extends \core_ai\aiactions\base {
+            /**
+             * Override the basename so it points at an existing action.
+             *
+             * @return string
+             */
+            public static function get_basename(): string {
+                return 'generate_text';
+            }
+
+            /**
+             * Store the response.
+             * @param response_base $response
+             * @return int
+             */
+            public function store(response_base $response): int {
+                return 0;
+            }
+        };
+
+        // The base class methods must call the overridden get_basename() via static::.
+        $this->assertEquals(
+            get_string('action_generate_text', 'core_ai'),
+            $action::get_name()
+        );
+        $this->assertEquals(
+            get_string('action_generate_text_desc', 'core_ai'),
+            $action::get_description()
+        );
+        $this->assertEquals(
+            get_string('action_generate_text_instruction', 'core_ai'),
+            $action::get_system_instruction()
+        );
+        $this->assertEquals(
+            aiactions\responses\response_generate_text::class,
+            $action::get_response_classname()
+        );
+
+        // Table name is derived from the overridden basename too.
+        $reflection = new ReflectionClass($action);
+        $method = $reflection->getMethod('get_tablename');
+        $this->assertEquals('ai_action_generate_text', $method->invoke($action));
+    }
+
     /**
      * Test that every action class implements a constructor.
      */
