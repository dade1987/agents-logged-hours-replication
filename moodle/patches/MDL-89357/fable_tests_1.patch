+    /**
+     * Test that static methods overridden in a child class are used by the base class (late static binding).
+     */
+    public function test_late_static_binding(): void {
+        $this->resetAfterTest();
+
+        // Create an anonymous class that extends the base class and overrides get_basename().
+        $action = new class(1) extends \core_ai\aiactions\base {
+            /**
+             * Override the basename so that it matches an existing action.
+             *
+             * @return string
+             */
+            public static function get_basename(): string {
+                return 'generate_text';
+            }
+
+            /**
+             * Store the response.
+             *
+             * @param response_base $response
+             * @return int
+             */
+            public function store(response_base $response): int {
+                return 0;
+            }
+
+            /**
+             * Expose the protected table name.
+             *
+             * @return string
+             */
+            public function expose_tablename(): string {
+                return $this->get_tablename();
+            }
+        };
+
+        // Each base class method must use the overridden get_basename() rather than the one of the class
+        // where the method is defined.
+        $this->assertEquals(get_string('action_generate_text', 'core_ai'), $action::get_name());
+        $this->assertEquals(get_string('action_generate_text_desc', 'core_ai'), $action::get_description());
+        $this->assertEquals(
+            get_string('action_generate_text_instruction', 'core_ai'),
+            $action::get_system_instruction()
+        );
+        $this->assertEquals(
+            aiactions\responses\response_generate_text::class,
+            $action::get_response_classname()
+        );
+        $this->assertEquals('ai_action_generate_text', $action->expose_tablename());
+    }
+
     /**
      * Test that every action class implements a constructor.
      */
