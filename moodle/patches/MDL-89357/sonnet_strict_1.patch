--- a/public/ai/tests/aiactions/base_test.php
+++ b/public/ai/tests/aiactions/base_test.php
@@ -29,6 +29,30 @@ use ReflectionClass;
  * @covers     \core_ai\aiactions\base
  */
 final class base_test extends \advanced_testcase {
+    /**
+     * Test that static methods of the base class use late static binding.
+     */
+    public function test_late_static_binding(): void {
+        $action = new class (1, 1, 'test') extends generate_text {
+            /**
+             * Override basename.
+             *
+             * @return string
+             */
+            public static function get_basename(): string {
+                return 'summarise_text';
+            }
+        };
+        $class = get_class($action);
+        $this->assertEquals('summarise_text', $class::get_basename());
+        $this->assertEquals(summarise_text::get_name(), $class::get_name());
+        $this->assertEquals(summarise_text::get_description(), $class::get_description());
+        $this->assertEquals(
+            responses\response_summarise_text::class,
+            $class::get_response_classname(),
+        );
+    }
+
     /**
      * Test get_basename.
      */
