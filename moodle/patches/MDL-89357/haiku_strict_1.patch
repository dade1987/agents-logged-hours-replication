+    /**
+     * Test that child classes overriding static methods are invoked from base class context.
+     */
+    public function test_static_override_is_used_by_base(): void {
+        $child = new class(1) extends \core_ai\aiactions\base {
+            /**
+             * Store the response.
+             * @param response_base $response
+             * @return int
+             */
+            public function store(response_base $response): int {
+                return 0;
+            }
+
+            /**
+             * Override the basename so the base class must late bind to this implementation.
+             *
+             * @return string
+             */
+            public static function get_basename(): string {
+                return 'summarise_text';
+            }
+        };
+        $classname = get_class($child);
+
+        $this->assertEquals(
+            get_string('action_summarise_text', 'core_ai'),
+            $classname::get_name()
+        );
+        $this->assertEquals(
+            get_string('action_summarise_text_desc', 'core_ai'),
+            $classname::get_description()
+        );
+        $this->assertEquals(
+            responses::class . '\\response_summarise_text',
+            $classname::get_response_classname()
+        );
+    }
