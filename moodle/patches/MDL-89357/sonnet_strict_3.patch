diff --git a/public/ai/tests/aiactions/base_test.php b/public/ai/tests/aiactions/base_test.php
index f9894e3493e..4b589414bca 100644
--- a/public/ai/tests/aiactions/base_test.php
+++ b/public/ai/tests/aiactions/base_test.php
@@ -102,4 +102,31 @@ final class base_test extends \advanced_testcase {
         }
     }
 
+    /**
+     * Test that static methods called from the base class use late static binding.
+     */
+    public function test_late_static_binding(): void {
+        $child = new class(1) extends \core_ai\aiactions\base {
+            /**
+             * Store the response.
+             * @param response_base $response
+             * @return int
+             */
+            public function store(response_base $response): int {
+                return 0;
+            }
+
+            /**
+             * Overridden basename.
+             * @return string
+             */
+            public static function get_basename(): string {
+                return 'summarise_text';
+            }
+        };
+        $class = get_class($child);
+        $this->assertEquals(\core_ai\aiactions\summarise_text::get_name(), $class::get_name());
+        $this->assertEquals(\core_ai\aiactions\summarise_text::get_description(), $class::get_description());
+        $this->assertEquals(\core_ai\aiactions\responses\response_summarise_text::class, $class::get_response_classname());
+    }
 }
