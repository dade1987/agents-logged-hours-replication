diff --git a/public/mod/quiz/tests/external/get_users_in_report_test.php b/public/mod/quiz/tests/external/get_users_in_report_test.php
index 0977c63c29b..0b58d64e923 100644
--- a/public/mod/quiz/tests/external/get_users_in_report_test.php
+++ b/public/mod/quiz/tests/external/get_users_in_report_test.php
@@ -101,4 +101,38 @@ final class get_users_in_report_test extends \advanced_testcase {
         )['users'];
         $this->assertCount(1, $users);
     }
+
+    /**
+     * Test that the extra fields returned by the service include resolved display names,
+     * including for custom profile fields which do not have a language string.
+     */
+    public function test_get_users_in_report_extrafields(): void {
+        $this->resetAfterTest();
+
+        $dg = $this->getDataGenerator();
+        $this->setAdminUser();
+
+        // Create a custom profile field and make it an identity field.
+        $dg->create_custom_profile_field(['datatype' => 'text', 'shortname' => 'fruit', 'name' => 'Favourite fruit']);
+        set_config('showuseridentity', 'email,profile_field_fruit');
+
+        $course = $dg->create_course();
+        $quiz = $dg->get_plugin_generator('mod_quiz')->create_instance(['course' => $course->id]);
+
+        $result = get_users_in_report::execute(
+            $quiz->cmid,
+            'overview',
+            '{"attempts":"enrolled_with","onlygraded":"","search":"","onlyregraded":""}'
+        );
+        $result = \core_external\external_api::clean_returnvalue(get_users_in_report::execute_returns(), $result);
+
+        // No debugging about a missing 'profile_field_fruit' language string should have been emitted.
+        $this->assertDebuggingNotCalled();
+
+        $this->assertSame([
+            ['name' => 'fullname', 'displayname' => get_string('fullname')],
+            ['name' => 'email', 'displayname' => get_string('email')],
+            ['name' => 'profile_field_fruit', 'displayname' => 'Favourite fruit'],
+        ], $result['extrafields']);
+    }
 }
