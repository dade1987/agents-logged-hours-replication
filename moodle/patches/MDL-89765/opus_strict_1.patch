diff --git a/public/mod/quiz/tests/external/get_users_in_report_test.php b/public/mod/quiz/tests/external/get_users_in_report_test.php
index 0977c63c29b..1e993bf3055 100644
--- a/public/mod/quiz/tests/external/get_users_in_report_test.php
+++ b/public/mod/quiz/tests/external/get_users_in_report_test.php
@@ -101,4 +101,40 @@ final class get_users_in_report_test extends \advanced_testcase {
         )['users'];
         $this->assertCount(1, $users);
     }
+
+    /**
+     * Test that the extra field labels are resolved correctly, including custom profile fields.
+     */
+    public function test_get_users_in_report_extrafield_labels(): void {
+        $this->resetAfterTest();
+
+        $dg = $this->getDataGenerator();
+        $dg->create_custom_profile_field([
+            'shortname' => 'fruit',
+            'name' => 'Favourite fruit',
+            'datatype' => 'text',
+        ]);
+        set_config('showuseridentity', 'email,profile_field_fruit');
+
+        $course = $dg->create_course();
+        $quiz = $dg->get_plugin_generator('mod_quiz')->create_instance(['course' => $course->id, 'sumgrades' => 1]);
+        $u1 = $dg->create_user();
+        $dg->enrol_user($u1->id, $course->id, 'student');
+        $this->setAdminUser();
+
+        $result = get_users_in_report::execute(
+            $quiz->cmid,
+            'overview',
+            '{"attempts":"enrolled_with","onlygraded":"","search":"","onlyregraded":""}'
+        );
+        $result = \core_external\external_api::clean_returnvalue(get_users_in_report::execute_returns(), $result);
+
+        $this->assertEquals(['fullname', 'email', 'profile_field_fruit'], $result['extrafields']);
+        $this->assertEquals([
+            ['field' => 'fullname', 'label' => get_string('fullname')],
+            ['field' => 'email', 'label' => get_string('email')],
+            ['field' => 'profile_field_fruit', 'label' => 'Favourite fruit'],
+        ], $result['extrafieldlabels']);
+        $this->assertDebuggingNotCalled();
+    }
 }
