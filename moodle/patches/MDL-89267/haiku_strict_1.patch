+    /**
+     * Make room for a question version with the given version number in a question bank entry.
+     *
+     * If the version number is already in use, each existing version (and any references to it) with that number or
+     * higher is moved up by one. This must be called inside a transaction.
+     *
+     * @param int $questionbankentryid the question bank entry the version is going to be added to
+     * @param int $version the version number the new version will use
+     */
+    protected function make_room_for_version(int $questionbankentryid, int $version): void {
+        global $DB;
+
+        if (!$DB->record_exists('question_versions', [
+            'questionbankentryid' => $questionbankentryid,
+            'version' => $version,
+        ])) {
+            return;
+        }
+        // We'll update each higher version and any references one-at-a-time, starting with the highest, to avoid
+        // creating a duplicate questionbankentryid-version combination in question_versions.
+        $moveversions = $DB->get_records_select(
+            'question_versions',
+            'questionbankentryid = :questionbankentryid AND version >= :oldversion',
+            [
+                'questionbankentryid' => $questionbankentryid,
+                'oldversion' => $version,
+            ],
+            'version DESC',
+        );
+        foreach ($moveversions as $moveversion) {
+            $DB->set_field(
+                'question_versions',
+                'version',
+                $moveversion->version + 1,
+                [
+                    'questionbankentryid' => $moveversion->questionbankentryid,
+                    'version' => $moveversion->version,
+                ]
+            );
+            $DB->set_field(
+                'question_references',
+                'version',
+                $moveversion->version + 1,
+                [
+                    'questionbankentryid' => $moveversion->questionbankentryid,
+                    'version' => $moveversion->version,
+                ]
+            );
+        }
+        // Ensure the nextversion value has been initialised, and increment it to account for the additional version.
+        versions::get_next_version($questionbankentryid);
+    }
+
+    /**
+     * Move the question versions restored so far into an existing question bank entry, and delete the entry created
+     * for them.
+     *
+     * This happens when a missing version of a question was restored before a surviving version, so a new question bank
+     * entry was created for the missing version, but the surviving version belongs to an existing question bank entry.
+     *
+     * @param int $fromqbeid the question bank entry created by this restore, which is deleted once it is emptied
+     * @param int $toqbeid the existing question bank entry that the versions are moved to
+     */
+    protected function merge_question_bank_entry(int $fromqbeid, int $toqbeid): void {
+        global $DB;
+
+        $transaction = $DB->start_delegated_transaction();
+        $versions = $DB->get_records('question_versions', ['questionbankentryid' => $fromqbeid], 'version ASC');
+        foreach ($versions as $version) {
+            $this->make_room_for_version($toqbeid, $version->version);
+            $DB->set_field('question_versions', 'questionbankentryid', $toqbeid, ['id' => $version->id]);
+        }
+        // No question references can point at an entry created by this restore yet, so it is safe to delete it.
+        $DB->delete_records('question_bank_entries', ['id' => $fromqbeid]);
+        $transaction->allow_commit();
+    }
