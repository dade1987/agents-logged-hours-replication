+    /**
+     * Move all versions from a question bank entry created during this restore into an existing entry, then remove it.
+     *
+     * @param int $fromentryid The question bank entry created by restore.
+     * @param int $toentryid The pre-existing question bank entry that should hold the versions.
+     */
+    protected function merge_question_bank_entry(int $fromentryid, int $toentryid): void {
+        global $DB;
+
+        $transaction = $DB->start_delegated_transaction();
+        $moving = $DB->get_records('question_versions', ['questionbankentryid' => $fromentryid], 'version ASC');
+        foreach ($moving as $movingversion) {
+            if (
+                $DB->record_exists(
+                    'question_versions',
+                    ['questionbankentryid' => $toentryid, 'version' => $movingversion->version],
+                )
+            ) {
+                // Make room, moving higher versions (and their references) up one at a time, highest first.
+                $moveversions = $DB->get_records_select(
+                    'question_versions',
+                    'questionbankentryid = :questionbankentryid AND version >= :oldversion',
+                    ['questionbankentryid' => $toentryid, 'oldversion' => $movingversion->version],
+                    'version DESC',
+                );
+                foreach ($moveversions as $moveversion) {
+                    $DB->set_field('question_versions', 'version', $moveversion->version + 1, [
+                        'questionbankentryid' => $toentryid,
+                        'version' => $moveversion->version,
+                    ]);
+                    $DB->set_field('question_references', 'version', $moveversion->version + 1, [
+                        'questionbankentryid' => $toentryid,
+                        'version' => $moveversion->version,
+                    ]);
+                }
+                versions::get_next_version($toentryid);
+            }
+            $DB->set_field('question_versions', 'questionbankentryid', $toentryid, ['id' => $movingversion->id]);
+        }
+        $DB->delete_records('question_bank_entries', ['id' => $fromentryid]);
+        $transaction->allow_commit();
+    }
