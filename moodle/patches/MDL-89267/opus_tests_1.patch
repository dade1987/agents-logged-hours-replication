+    /**
+     * Restoring a deleted version keeps it in the original question bank entry, whatever order the versions are restored in.
+     *
+     * @dataProvider restore_deleted_first_version_provider
+     * @param bool $reverse whether to reverse the order of the versions in the backup file.
+     */
+    public function test_restore_backup_containing_deleted_first_version(bool $reverse): void {
+        global $CFG, $DB;
+        self::setAdminUser();
+        $this->resetAfterTest();
+        $questiongenerator = self::getDataGenerator()->get_plugin_generator('core_question');
+        $testdata = $this->add_course_quiz_and_qbank();
+        $questionv1 = $testdata->qbankquestion;
+        $questionv2 = $questiongenerator->update_question($questionv1, null, ['name' => 'Version 2']);
+        $qbeid = $questionv1->questionbankentryid;
+
+        $backupid = $this->backup_course_module($testdata->quiz->cmid);
+
+        if ($reverse) {
+            // Reverse the order of the question versions within each question bank entry in the backup.
+            $xmlfile = $CFG->tempdir . '/backup/' . $backupid . '/questions.xml';
+            $dom = new \DOMDocument();
+            $dom->preserveWhiteSpace = false;
+            $dom->load($xmlfile);
+            foreach ($dom->getElementsByTagName('question_version') as $versionlist) {
+                $children = [];
+                foreach (iterator_to_array($versionlist->childNodes) as $child) {
+                    if ($child instanceof \DOMElement) {
+                        $children[] = $versionlist->removeChild($child);
+                    }
+                }
+                foreach (array_reverse($children) as $child) {
+                    $versionlist->appendChild($child);
+                }
+            }
+            $dom->save($xmlfile);
+        }
+
+        // Version 1 is not in use (the quiz uses the latest version), so it is actually deleted.
+        question_delete_question($questionv1->id);
+        $this->assertFalse($DB->record_exists('question', ['id' => $questionv1->id]));
+        $qbecount = $DB->count_records('question_bank_entries', ['questioncategoryid' => $testdata->qbankcategory->id]);
+
+        $this->restore_to_course($backupid, $testdata->course->id);
+
+        // No new question bank entry has been created, and version 1 has been restored into the original entry.
+        $this->assertEquals(
+            $qbecount,
+            $DB->count_records('question_bank_entries', ['questioncategoryid' => $testdata->qbankcategory->id]),
+        );
+        $versions = $DB->get_records(
+            'question_versions',
+            ['questionbankentryid' => $qbeid],
+            fields: 'version, questionid, status',
+        );
+        $this->assertCount(2, $versions);
+        $this->assertEquals('bank question', $DB->get_field('question', 'name', ['id' => $versions[1]->questionid]));
+        $this->assertEquals($questionv2->id, $versions[2]->questionid);
+
+        // The quiz references in the restored course point at the original entry.
+        $restoredquiz = $DB->get_records('quiz', ['course' => $testdata->course->id], 'id DESC', 'id', 0, 1);
+        $restoredquiz = reset($restoredquiz);
+        $structure = quiz_settings::create($restoredquiz->id)->get_structure();
+        $this->assertEquals($questionv2->id, $structure->get_question_in_slot(1)->questionid);
+    }
+
+    /**
+     * Data provider for {@see test_restore_backup_containing_deleted_first_version}.
+     *
+     * @return array
+     */
+    public static function restore_deleted_first_version_provider(): array {
+        return [
+            'Original order' => [false],
+            'Reversed order' => [true],
+        ];
+    }
