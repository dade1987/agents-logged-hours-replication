+    /**
+     * Make room for a version number in a question bank entry.
+     *
+     * If the version number is already used in the entry (for example, because the backed up version was deleted
+     * and a new one created in its place), increase the version numbers of the conflicting versions, and of any
+     * references to them, to free up the requested version number.
+     *
+     * @param int $questionbankentryid the question bank entry.
+     * @param int $version the version number that needs to be free.
+     */
+    protected function make_room_for_version(int $questionbankentryid, int $version): void {
+        global $DB;
+
+        if (
+            !$DB->record_exists(
+                'question_versions',
+                [
+                    'questionbankentryid' => $questionbankentryid,
+                    'version' => $version,
+                ],
+            )
+        ) {
+            return;
+        }
+
+        // We'll update each higher version and any references one-at-a-time, starting with the highest, to avoid
+        // creating a duplicate questionbankentryid-version combination in question_versions.
+        $moveversions = $DB->get_records_select(
+            'question_versions',
+            'questionbankentryid = :questionbankentryid AND version >= :oldversion',
+            [
+                'questionbankentryid' => $questionbankentryid,
+                'oldversion' => $version,
+            ],
+            'version DESC',
+        );
+        foreach ($moveversions as $moveversion) {
+            $DB->set_field(
+                'question_versions',
+                'version',
+                $moveversion->version + 1,
+                [
+                    'questionbankentryid' => $moveversion->questionbankentryid,
+                    'version' => $moveversion->version,
+                ]
+            );
+            $DB->set_field(
+                'question_references',
+                'version',
+                $moveversion->version + 1,
+                [
+                    'questionbankentryid' => $moveversion->questionbankentryid,
+                    'version' => $moveversion->version,
+                ]
+            );
+        }
+        // Ensure the nextversion value has been initialised, and increment it to account for the additional version.
+        versions::get_next_version($questionbankentryid);
+    }
+
+    /**
+     * Move all versions from a question bank entry created by this restore into an existing entry, then delete it.
+     *
+     * @param int $createdqbeid the question bank entry created by this restore.
+     * @param int $existingqbeid the existing question bank entry the versions belong in.
+     */
+    protected function merge_created_question_bank_entry(int $createdqbeid, int $existingqbeid): void {
+        global $DB;
+
+        $transaction = $DB->start_delegated_transaction();
+        $createdversions = $DB->get_records(
+            'question_versions',
+            ['questionbankentryid' => $createdqbeid],
+            'version ASC',
+        );
+        foreach ($createdversions as $createdversion) {
+            $this->make_room_for_version($existingqbeid, $createdversion->version);
+            $DB->set_field(
+                'question_versions',
+                'questionbankentryid',
+                $existingqbeid,
+                ['id' => $createdversion->id],
+            );
+        }
+        // Nothing else refers to the created entry yet, as question references are restored later.
+        $DB->delete_records('question_bank_entries', ['id' => $createdqbeid]);
+        $transaction->allow_commit();
+    }
