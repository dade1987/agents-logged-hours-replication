+    /**
+     * Restore a backup where the first version of a question was deleted, but a later version still exists.
+     *
+     * The deleted version must be restored into the question bank entry of the surviving version, regardless of the
+     * order in which the versions are processed during the restore (MDL-89267).
+     */
+    public function test_restore_deleted_version_into_existing_entry(): void {
+        global $DB;
+        self::setAdminUser();
+        $this->resetAfterTest();
+        $questiongenerator = self::getDataGenerator()->get_plugin_generator('core_question');
+        $testdata = $this->add_course_quiz_and_qbank();
+        $questionv1 = $testdata->qbankquestion;
+        // The quiz already uses the "always latest" version of this question.
+        $questionv2 = $questiongenerator->update_question($questionv1, null, ['name' => 'Version 2']);
+
+        $qbe = get_question_bank_entry($questionv1->id);
+        $entrycount = $DB->count_records('question_bank_entries', ['questioncategoryid' => $qbe->questioncategoryid]);
+
+        $backupid = $this->backup_course_module($testdata->quiz->cmid);
+
+        // Delete version 1, leaving version 2 in the original question bank entry.
+        question_delete_question($questionv1->id);
+        $this->assertFalse($DB->record_exists('question', ['id' => $questionv1->id]));
+        $this->assertCount(1, $DB->get_records('question_versions', ['questionbankentryid' => $qbe->id]));
+
+        $this->restore_to_course($backupid, $testdata->course->id);
+
+        // No new question bank entry has been created, both versions are in the original entry.
+        $this->assertEquals(
+            $entrycount,
+            $DB->count_records('question_bank_entries', ['questioncategoryid' => $qbe->questioncategoryid]),
+        );
+        $versions = $DB->get_records(
+            'question_versions',
+            ['questionbankentryid' => $qbe->id],
+            fields: 'version, questionid, status',
+        );
+        $this->assertCount(2, $versions);
+        $this->assertEquals($questionv1->name, $DB->get_field('question', 'name', ['id' => $versions[1]->questionid]));
+        $this->assertEquals(question_version_status::QUESTION_STATUS_READY, $versions[1]->status);
+        $this->assertEquals($questionv2->id, $versions[2]->questionid);
+        $this->assertEquals(question_version_status::QUESTION_STATUS_READY, $versions[2]->status);
+    }
+
