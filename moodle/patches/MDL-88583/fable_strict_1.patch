@@ -179,6 +179,36 @@ final class plugin_test extends \advanced_testcase {
         $this->assertNull(\core_customfield\data_controller::create($this->cfdata[1]->get('id'))->export_value());
     }
 
+    /**
+     * Test that the editor options always use the data context, even before the data record has been saved
+     */
+    public function test_value_editor_options_context(): void {
+        $rcm = new \ReflectionMethod(data_controller::class, 'value_editor_options');
+
+        // Existing data record: context is the course context.
+        $options = $rcm->invoke($this->cfdata[1]);
+        $this->assertEquals(\context_course::instance($this->courses[1]->id)->id, $options['context']->id);
+
+        // Data record that does not exist yet, but the instance (course) is known: context must still be the
+        // course context (and not fall back to the system / configuration context).
+        $d = \core_customfield\data_controller::create(0, (object)['instanceid' => $this->courses[3]->id],
+            $this->cfields[3]);
+        $this->assertEmpty($d->get('id'));
+        $options = $rcm->invoke($d);
+        $this->assertEquals(\context_course::instance($this->courses[3]->id)->id, $options['context']->id);
+
+        // The default value is still available when preparing the form for a non-existing data record.
+        $instance = (object)['id' => $this->courses[3]->id];
+        $d->instance_form_before_set_data($instance);
+        $formelementname = (new \ReflectionMethod(data_controller::class, 'get_form_element_name'))->invoke($d);
+        $this->assertEquals('Value3', $instance->{$formelementname}['text']);
+
+        // Instance is not known yet (for example a new course): fall back to the system context.
+        $d = \core_customfield\data_controller::create(0, null, $this->cfields[3]);
+        $options = $rcm->invoke($d);
+        $this->assertEquals(\context_system::instance()->id, $options['context']->id);
+    }
+
     /**
      * Test for data_controller::get_value and export_value
      */
