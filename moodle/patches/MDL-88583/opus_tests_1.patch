+    /**
+     * Test that the editor options use the instance context, even before the data record exists
+     */
+    public function test_value_editor_options_context(): void {
+        $method = new \ReflectionMethod(data_controller::class, 'value_editor_options');
+
+        // Existing data record.
+        $options = $method->invoke($this->cfdata[1]);
+        $this->assertEquals(context_course::instance($this->courses[1]->id)->id, $options['context']->id);
+
+        // No data record yet, but instance is known.
+        $d = \core_customfield\data_controller::create(0, (object)['instanceid' => $this->courses[3]->id],
+            $this->cfields[1]);
+        $this->assertEmpty($d->get('id'));
+        $options = $method->invoke($d);
+        $this->assertEquals(context_course::instance($this->courses[3]->id)->id, $options['context']->id);
+
+        // Instance not known, falls back to the configuration context.
+        $d = \core_customfield\data_controller::create(0, null, $this->cfields[1]);
+        $options = $method->invoke($d);
+        $this->assertEquals(context_system::instance()->id, $options['context']->id);
+    }
