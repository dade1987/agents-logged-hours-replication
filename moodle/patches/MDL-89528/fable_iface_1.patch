--- a/public/lib/classes/di.php
+++ b/public/lib/classes/di.php
@@ -62,6 +62,32 @@ class di {
         return self::get_container()->get($id);
     }
 
+    /**
+     * Create a new instance of the specified class, resolving its dependencies using the container.
+     *
+     * Unlike `get()`, this method always creates a new instance of the requested class, and allows additional
+     * parameters to be passed to the constructor. Any parameters which are not provided will be resolved by the
+     * container.
+     *
+     * This is a shortcut helper for \core\di::get_container()->make($name, $params).
+     *
+     * @param string $name The class name or identifier of the entry to create
+     * @param array $params Parameters to pass to the constructor, indexed by parameter name
+     * @return mixed The new instance
+     */
+    public static function make(
+        string $name,
+        array $params = [],
+    ): mixed {
+        // Please note that the `make` method is not a part of the PSR-11 standard.
+        // We currently make use of PHP-DI which does have this method, but its use is not guaranteed.
+        // If Moodle switches to alternative DI resolution, this method _must_ be updated to work with it.
+
+        /** @var \DI\Container */
+        $container = self::get_container();
+        return $container->make($name, $params);
+    }
+
     /**
