diff --git a/public/lib/tests/di_test.php b/public/lib/tests/di_test.php
index b99707f5aeb..2cf0539e19e 100644
--- a/public/lib/tests/di_test.php
+++ b/public/lib/tests/di_test.php
@@ -159,4 +159,128 @@ final class di_test extends \advanced_testcase {
             $stringmanager,
         );
     }
+    /**
+     * Test that the make method creates a new instance each time, with resolved dependencies.
+     */
+    public function test_make(): void {
+        $client = di::make(http_client::class);
+        $this->assertInstanceOf(http_client::class, $client);
+
+        // The make method always returns a new instance.
+        $this->assertNotSame($client, di::make(http_client::class));
+        $this->assertNotSame($client, di::get(http_client::class));
+    }
+
+    /**
+     * Test that the make method accepts constructor parameters and resolves the remainder from the container.
+     */
+    public function test_make_with_params(): void {
+        $instance = di::make(
+            di_test_make_fixture::class,
+            ['name' => 'example'],
+        );
+
+        $this->assertInstanceOf(di_test_make_fixture::class, $instance);
+        $this->assertSame('example', $instance->name);
+        $this->assertSame(di::get(\moodle_database::class), $instance->db);
+        $this->assertSame(di::get(hook\manager::class), $instance->hookmanager);
+    }
+
+    /**
+     * Test that attribute-based injection is supported via the Inject attribute.
+     */
+    public function test_attribute_injection(): void {
+        $instance = di::get(di_test_inject_fixture::class);
+
+        $this->assertInstanceOf(di_test_inject_fixture::class, $instance);
+        $this->assertSame(di::get(hook\manager::class), $instance->get_hook_manager());
+        $this->assertSame(di::get(\moodle_database::class), $instance->get_db());
+    }
+
+    /**
+     * Test that dependencies can be injected on to an existing instance.
+     */
+    public function test_inject_on(): void {
+        $instance = new di_test_inject_fixture();
+        $this->assertFalse($instance->has_hook_manager());
+
+        /** @var \DI\Container $container */
+        $container = di::get_container();
+        $result = $container->injectOn($instance);
+
+        $this->assertSame($instance, $result);
+        $this->assertTrue($instance->has_hook_manager());
+        $this->assertSame(di::get(hook\manager::class), $instance->get_hook_manager());
+        $this->assertSame(di::get(\moodle_database::class), $instance->get_db());
+    }
+}
