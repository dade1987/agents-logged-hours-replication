+namespace core\fixtures;
+
+use core\clock;
+use core\http_client;
+use DI\Attribute\Inject;
+
+/**
+ * Fixture class which uses attribute-based property injection.
+ *
+ * @package    core
+ * @copyright  2025 Andrew Lyons <andrew@nicols.co.uk>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class di_attribute_injection {
+    /** @var http_client The http client, injected by the container */
+    #[Inject]
+    public http_client $client;
+
+    /** @var clock The clock, injected by the container */
+    #[Inject]
+    public clock $clock;
+
+    /** @var string A property which is not injected */
+    public string $notinjected = 'unchanged';
+
+    /**
+     * Fetch the injected client.
+     *
+     * @return http_client
+     */
+    public function get_client(): http_client {
+        return $this->client;
+    }
+}
+
+/**
+ * Fixture class which uses injectOn to inject dependencies into an existing instance.
+ *
+ * @package    core
+ * @copyright  2025 Andrew Lyons <andrew@nicols.co.uk>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class di_attribute_injection_inject_on {
+    /** @var http_client The http client, injected by the container */
+    #[Inject]
+    private http_client $client;
+
+    /**
+     * Constructor which injects dependencies onto this instance.
+     */
+    public function __construct() {
+        /** @var \DI\Container $container */
+        $container = \core\di::get_container();
+        $container->injectOn($this);
+    }
+
+    /**
+     * Fetch the injected client.
+     *
+     * @return http_client
+     */
+    public function get_client(): http_client {
+        return $this->client;
+    }
+}
