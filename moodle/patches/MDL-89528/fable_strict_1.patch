+namespace core\fixtures\di;
+
+use DI\Attribute\Inject;
+
+/**
+ * Fixture classes for testing attribute-based dependency injection.
+ *
+ * @package   core
+ * @copyright 2025 Andrew Lyons <andrew@nicols.co.uk>
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class attribute_injection {
+    /** @var \moodle_database The database, injected via attribute */
+    #[Inject]
+    private \moodle_database $db;
+
+    /** @var \core\clock The clock, injected via attribute */
+    #[Inject]
+    private \core\clock $clock;
+
+    /** @var \core_string_manager|null The string manager, injected via a method attribute */
+    private ?\core_string_manager $stringmanager = null;
+
+    /**
+     * Setter injection via attribute.
+     *
+     * @param \core_string_manager $stringmanager
+     */
+    #[Inject]
+    public function set_string_manager(\core_string_manager $stringmanager): void {
+        $this->stringmanager = $stringmanager;
+    }
+
+    /**
+     * Get the injected database.
+     *
+     * @return \moodle_database|null
+     */
+    public function get_db(): ?\moodle_database {
+        return $this->db ?? null;
+    }
+
+    /**
+     * Get the injected clock.
+     *
+     * @return \core\clock|null
+     */
+    public function get_clock(): ?\core\clock {
+        return $this->clock ?? null;
+    }
+
+    /**
+     * Get the injected string manager.
+     *
+     * @return \core_string_manager|null
+     */
+    public function get_string_manager(): ?\core_string_manager {
+        return $this->stringmanager;
+    }
+}
+
+/**
+ * Fixture class which injects dependencies on itself from the constructor.
+ *
+ * @package   core
+ * @copyright 2025 Andrew Lyons <andrew@nicols.co.uk>
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class attribute_injection_on_instance {
+    /** @var \moodle_database The database, injected via attribute */
+    #[Inject]
+    private \moodle_database $db;
+
+    /**
+     * Constructor which uses injectOn to inject dependencies on an existing instance.
+     */
+    public function __construct() {
+        /** @var \DI\Container $container */
+        $container = \core\di::get_container();
+        $container->injectOn($this);
+    }
+
+    /**
+     * Get the injected database.
+     *
+     * @return \moodle_database|null
+     */
+    public function get_db(): ?\moodle_database {
+        return $this->db ?? null;
+    }
+}
