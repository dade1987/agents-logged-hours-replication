index 00000000000..e133f30277e
--- /dev/null
+++ b/.upgradenotes/MDL-89528-2026102400000000.yml
@@ -0,0 +1,11 @@
+issueNumber: MDL-89528
+notes:
+  core:
+    - message: >-
+        The Dependency Injection container now supports attribute-based
+        injection using the `#[\DI\Attribute\Inject]` attribute on properties
+        and methods. This also allows dependencies to be injected on to an
+        existing instance using `\core\di::get_container()->injectOn($this)`,
+        which is useful when migrating legacy classes and in routed
+        controllers.
+      type: improved
diff --git a/public/lib/classes/di.php b/public/lib/classes/di.php
index 46dd11354eb..7fb8fd1345e 100644
--- a/public/lib/classes/di.php
+++ b/public/lib/classes/di.php
@@ -89,10 +89,22 @@ class di {
         // Configure the Container builder.
         $builder = new \DI\ContainerBuilder();
 
-        // At the moment we are using autowiring, but not automatic attribute injection.
-        // Automatic attribute injection is a php-di specific feature.
+        // Enable autowiring of constructor arguments.
         $builder->useAutowiring(true);
 
+        // Enable attribute-based injection (e.g. #[\DI\Attribute\Inject]) for properties and methods.
+        // Note: Attribute injection is a PHP-DI specific feature and is not a part of the PSR-11 standard.
+        // It is enabled to support injection into controllers, and the migration of legacy classes via
+        // the `injectOn()` method, for example:
+        //
+        //     #[\DI\Attribute\Inject]
+        //     private \moodle_database $db;
+        //
+        //     public function __construct() {
+        //         \core\di::get_container()->injectOn($this);
+        //     }
+        $builder->useAttributes(true);
+
         if (!$CFG->debugdeveloper) {
             // Enable compilation of the container and write proxies to disk in production.
             // See https://php-di.org/doc/performances.html for information.
diff --git a/public/lib/tests/di_test.php b/public/lib/tests/di_test.php
index b99707f5aeb..4fba0f9b647 100644
--- a/public/lib/tests/di_test.php
+++ b/public/lib/tests/di_test.php
@@ -159,4 +159,47 @@ final class di_test extends \advanced_testcase {
             $stringmanager,
         );
     }
+
+    /**
+     * Test that properties and methods marked with the Inject attribute are injected when fetched from the container.
+     */
+    public function test_attribute_injection(): void {
+        global $CFG, $DB;
+
+        require_once($CFG->libdir . '/tests/fixtures/di/attribute_injection.php');
+
+        $instance = di::get(\core\fixtures\di\attribute_injection::class);
+        $this->assertInstanceOf(\core\fixtures\di\attribute_injection::class, $instance);
+
+        // Property injection.
+        $this->assertSame($DB, $instance->get_db());
+        $this->assertInstanceOf(clock::class, $instance->get_clock());
+
+        // Method injection.
+        $this->assertSame(get_string_manager(), $instance->get_string_manager());
+    }
+
+    /**
+     * Test that dependencies can be injected on to an existing instance using injectOn.
+     */
+    public function test_attribute_injection_on_instance(): void {
+        global $CFG, $DB;
+
+        require_once($CFG->libdir . '/tests/fixtures/di/attribute_injection.php');
+
+        // The constructor calls injectOn with the container.
+        $instance = new \core\fixtures\di\attribute_injection_on_instance();
+        $this->assertSame($DB, $instance->get_db());
+
+        // Injection also works when explicitly called on an instance.
+        $instance = (new \ReflectionClass(\core\fixtures\di\attribute_injection::class))
+            ->newInstanceWithoutConstructor();
+        $this->assertNull($instance->get_db());
+
+        /** @var \DI\Container $container */
+        $container = di::get_container();
+        $container->injectOn($instance);
+        $this->assertSame($DB, $instance->get_db());
+        $this->assertSame(get_string_manager(), $instance->get_string_manager());
+    }
 }
