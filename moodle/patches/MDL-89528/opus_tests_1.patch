+namespace core\tests\di;
+
+/**
+ * Fixture class used to test attribute-based property injection.
+ *
+ * @package   core
+ * @copyright 2025 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class attribute_injected_class {
+    /** @var \core\hook\manager The hook manager */
+    #[\DI\Attribute\Inject]
+    public \core\hook\manager $hookmanager;
+}
diff --git a/public/lib/tests/di_test.php b/public/lib/tests/di_test.php
index b99707f5aeb..ba16d36e337 100644
--- a/public/lib/tests/di_test.php
+++ b/public/lib/tests/di_test.php
@@ -159,4 +159,33 @@ final class di_test extends \advanced_testcase {
             $stringmanager,
         );
     }
+
+    /**
+     * Test that attribute-based property injection works via injectOn.
+     */
+    public function test_inject_on_with_attributes(): void {
+        $instance = new class () {
+            /** @var \core_string_manager The string manager */
+            #[\DI\Attribute\Inject]
+            public \core_string_manager $stringmanager;
+
+            /**
+             * Constructor.
+             */
+            public function __construct() {
+                \core\di::get_container()->injectOn($this);
+            }
+        };
+
+        $this->assertSame(get_string_manager(), $instance->stringmanager);
+    }
+
+    /**
+     * Test that attribute-based property injection works when fetching from the container.
+     */
+    public function test_get_with_attribute_injection(): void {
+        $instance = di::get(\core\tests\di\attribute_injected_class::class);
+        $this->assertInstanceOf(hook\manager::class, $instance->hookmanager);
+        $this->assertSame(hook\manager::get_instance(), $instance->hookmanager);
+    }
 }
