+namespace core_question\statistics\questions;
+
+/**
+ * Unit tests for {@see all_calculated_for_qubaid_condition}.
+ *
+ * @package    core_question
+ * @copyright  The Open University
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \core_question\statistics\questions\all_calculated_for_qubaid_condition
+ */
+final class all_calculated_for_qubaid_condition_test extends \advanced_testcase {
+
+    public function test_get_cached_skips_stats_for_unknown_slots(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $qubaids = new \qubaid_list([1, 2, 3]);
+        $timemodified = time();
+        $base = [
+            'hashcode' => $qubaids->get_hash_code(),
+            'timemodified' => $timemodified,
+            'questionid' => 123,
+            'slot' => 7,
+            'subquestion' => 0,
+            's' => 1,
+            'facility' => 0.5,
+        ];
+        // Main stats for a slot that is not an analysable question.
+        $DB->insert_record('question_statistics', (object) ($base + ['variant' => null]));
+        // Variant stats for the same slot.
+        $DB->insert_record('question_statistics', (object) ($base + ['variant' => 1]));
+
+        $stats = new all_calculated_for_qubaid_condition();
+        $stats->get_cached($qubaids);
+
+        $this->assertDebuggingCalledCount(2);
+        $this->assertArrayNotHasKey(7, $stats->questionstats);
+    }
+}
