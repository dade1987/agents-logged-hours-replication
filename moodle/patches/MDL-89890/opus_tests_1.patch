+namespace mod_forum\output;
+
+use moodle_url;
+
+/**
+ * Tests for the subscription_actionbar output class.
+ *
+ * @package    mod_forum
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \mod_forum\output\subscription_actionbar
+ */
+final class subscription_actionbar_test extends \advanced_testcase {
+    #[\Override]
+    public static function setUpBeforeClass(): void {
+        global $CFG;
+        require_once($CFG->dirroot . '/mod/forum/lib.php');
+        parent::setUpBeforeClass();
+    }
+
+    /**
+     * Test the exported template data keeps backwards compatible url_select data.
+     */
+    public function test_export_for_template(): void {
+        global $PAGE;
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $course = $this->getDataGenerator()->create_course();
+        $forum = $this->getDataGenerator()->create_module('forum',
+            ['course' => $course->id, 'forcesubscribe' => FORUM_CHOOSESUBSCRIBE]);
+        $url = new moodle_url('/mod/forum/subscribers.php', ['id' => $forum->id]);
+        $PAGE->set_url($url);
+        $output = $PAGE->get_renderer('mod_forum');
+
+        $actionbar = new subscription_actionbar($forum->id, $url, $forum, 0);
+        $data = $actionbar->export_for_template($output);
+
+        $this->assertArrayHasKey('subscriptionoptions', $data);
+
+        // New select_menu data.
+        $this->assertArrayHasKey('viewandmanageselectmenu', $data);
+        $menu = (array) $data['viewandmanageselectmenu'];
+        $this->assertEquals('selectviewandmanagesubscribers', $menu['name']);
+        $this->assertArrayHasKey('baseid', $menu);
+
+        // Legacy url_select data, used by template overrides with core/url_select.
+        $this->assertArrayHasKey('viewandmanageselect', $data);
+        $legacy = (array) $data['viewandmanageselect'];
+        $this->assertEquals('selectviewandmanagesubscribers', $legacy['formid']);
+        $this->assertArrayHasKey('action', $legacy);
+        $this->assertArrayHasKey('sesskey', $legacy);
+        $this->assertCount(2, $legacy['options']);
+        $this->assertStringContainsString('edit=on', ((array) $legacy['options'][1])['value']);
+
+        // The legacy data must still render a working url_select.
+        $html = $output->render_from_template('core/url_select', $legacy);
+        $this->assertStringContainsString('id="selectviewandmanagesubscribers"', $html);
+        $this->assertStringContainsString('jumpto.php', $html);
+
+        // The core template renders the select menu.
+        $html = $output->render_from_template('mod_forum/forum_subscription_action', $data);
+        $this->assertStringContainsString('tertiary-navigation-selector', $html);
+
+        // Forced subscription does not show the view/manage selector.
+        $forum->forcesubscribe = FORUM_FORCESUBSCRIBE;
+        $actionbar = new subscription_actionbar($forum->id, $url, $forum, 0);
+        $data = $actionbar->export_for_template($output);
+        $this->assertArrayNotHasKey('viewandmanageselectmenu', $data);
+        $this->assertArrayNotHasKey('viewandmanageselect', $data);
+    }
+}
