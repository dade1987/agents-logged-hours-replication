+namespace mod_forum\output;
+
+use moodle_url;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once($CFG->dirroot . '/mod/forum/lib.php');
+
+/**
+ * Tests for the subscription action bar output class.
+ *
+ * @package   mod_forum
+ * @category  test
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \mod_forum\output\subscription_actionbar
+ */
+final class subscription_actionbar_test extends \advanced_testcase {
+    /**
+     * Create a forum with the given subscription mode and return it.
+     *
+     * @param int $mode The forum subscription mode.
+     * @return \stdClass
+     */
+    private function create_forum(int $mode): \stdClass {
+        $course = $this->getDataGenerator()->create_course();
+        return $this->getDataGenerator()->create_module('forum', [
+            'course' => $course->id,
+            'forcesubscribe' => $mode,
+        ]);
+    }
+
+    /**
+     * Convert an absolute url into the wwwroot relative form used by url_select.
+     *
+     * @param string $url The absolute url.
+     * @return string
+     */
+    private function local_url(string $url): string {
+        global $CFG;
+        return str_replace($CFG->wwwroot, '', $url);
+    }
+
+    /**
+     * Test that both the new select menu data and the legacy url select data are exported.
+     */
+    public function test_export_for_template_exports_view_manage_select(): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $forum = $this->create_forum(FORUM_CHOOSESUBSCRIBE);
+        $url = new moodle_url('/mod/forum/subscribers.php', ['id' => $forum->id]);
+        $output = $PAGE->get_renderer('mod_forum');
+
+        $actionbar = new subscription_actionbar($forum->id, $url, $forum, 0);
+        $data = $actionbar->export_for_template($output);
+
+        $this->assertArrayHasKey('subscriptionoptions', $data);
+        $this->assertArrayHasKey('viewandmanageselectmenu', $data);
+        $this->assertArrayHasKey('viewandmanageselect', $data);
+
+        $managelink = (new moodle_url('/mod/forum/subscribers.php', ['id' => $forum->id, 'edit' => 'on']))->out(false);
+        $viewlink = (new moodle_url('/mod/forum/subscribers.php', ['id' => $forum->id, 'edit' => 'off']))->out(false);
+
+        // The new context is select_menu data, consumed by core/tertiary_navigation_selector.
+        $selectmenu = $data['viewandmanageselectmenu'];
+        $this->assertSame('selectviewandmanagesubscribers', $selectmenu->name);
+        $this->assertSame($viewlink, $selectmenu->value);
+        $this->assertObjectHasProperty('baseid', $selectmenu);
+        $this->assertSame(get_string('forum:viewsubscribers', 'forum'), $selectmenu->selectedoption);
+        $this->assertEqualsCanonicalizing(
+            [$viewlink, $managelink],
+            array_map(fn($option) => $option['value'], $selectmenu->options),
+        );
+
+        // The legacy context is url_select data, so that template overrides using core/url_select keep working.
+        // Note that url_select stores its option values as local (wwwroot relative) urls.
+        $urlselect = $data['viewandmanageselect'];
+        $this->assertSame('selectviewandmanagesubscribers', $urlselect->formid);
+        $this->assertObjectHasProperty('action', $urlselect);
+        $this->assertObjectHasProperty('sesskey', $urlselect);
+        $this->assertEqualsCanonicalizing(
+            [$this->local_url($viewlink), $this->local_url($managelink)],
+            array_map(fn($option) => $option['value'], $urlselect->options),
+        );
+        $selected = array_values(array_filter($urlselect->options, fn($option) => !empty($option['selected'])));
+        $this->assertCount(1, $selected);
+        $this->assertSame($this->local_url($viewlink), $selected[0]['value']);
+
+        // The legacy data must render with the core/url_select template.
+        $html = $output->render_from_template('core/url_select', $urlselect);
+        $this->assertStringContainsString('id="selectviewandmanagesubscribers"', $html);
+        $this->assertStringContainsString(get_string('managesubscriptionson', 'forum'), $html);
+
+        // The current template renders the tertiary navigation selector.
+        $html = $output->subscription_actionbar($actionbar);
+        $this->assertStringContainsString('tertiary-navigation-selector', $html);
+        $this->assertStringContainsString(get_string('managesubscriptionson', 'forum'), $html);
+    }
+
+    /**
+     * Test that the manage view selects the manage option and hides the subscription mode selector.
+     */
+    public function test_export_for_template_manage_view(): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $forum = $this->create_forum(FORUM_CHOOSESUBSCRIBE);
+        $url = new moodle_url('/mod/forum/subscribers.php', ['id' => $forum->id, 'edit' => 'on']);
+        $output = $PAGE->get_renderer('mod_forum');
+
+        $actionbar = new subscription_actionbar($forum->id, $url, $forum, 1);
+        $data = $actionbar->export_for_template($output);
+
+        $managelink = (new moodle_url('/mod/forum/subscribers.php', ['id' => $forum->id, 'edit' => 'on']))->out(false);
+
+        $this->assertArrayNotHasKey('subscriptionoptions', $data);
+        $this->assertSame($managelink, $data['viewandmanageselectmenu']->value);
+        $this->assertSame(get_string('managesubscriptionson', 'forum'), $data['viewandmanageselectmenu']->selectedoption);
+
+        $selected = array_values(array_filter($data['viewandmanageselect']->options, fn($option) => !empty($option['selected'])));
+        $this->assertCount(1, $selected);
+        $this->assertSame($this->local_url($managelink), $selected[0]['value']);
+    }
+
+    /**
+     * Test that no view/manage selector is exported for forced subscription forums.
+     */
+    public function test_export_for_template_forced_subscription(): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $forum = $this->create_forum(FORUM_FORCESUBSCRIBE);
+        $url = new moodle_url('/mod/forum/subscribers.php', ['id' => $forum->id]);
+        $output = $PAGE->get_renderer('mod_forum');
+
+        $actionbar = new subscription_actionbar($forum->id, $url, $forum, 0);
+        $data = $actionbar->export_for_template($output);
+
+        $this->assertArrayHasKey('subscriptionoptions', $data);
+        $this->assertArrayNotHasKey('viewandmanageselectmenu', $data);
+        $this->assertArrayNotHasKey('viewandmanageselect', $data);
+    }
+}
