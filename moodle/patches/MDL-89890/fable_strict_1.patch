+namespace mod_forum;
+
+use mod_forum\output\subscription_actionbar;
+use moodle_url;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once("{$CFG->dirroot}/mod/forum/lib.php");
+
+/**
+ * Tests for the subscription action bar output component.
+ *
+ * @package    mod_forum
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \mod_forum\output\subscription_actionbar
+ */
+final class output_subscription_actionbar_test extends \advanced_testcase {
+    /**
+     * Test the data exported for the view/manage subscribers selector.
+     *
+     * The selector is rendered using core/tertiary_navigation_selector, but the exported data must also
+     * remain compatible with core/url_select so that overridden templates keep working.
+     */
+    public function test_export_for_template_view_manage_select(): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $course = $this->getDataGenerator()->create_course();
+        $forum = $this->getDataGenerator()->create_module('forum', [
+            'course' => $course->id,
+            'forcesubscribe' => FORUM_CHOOSESUBSCRIBE,
+        ]);
+
+        $url = new moodle_url('/mod/forum/subscribers.php', ['id' => $forum->id]);
+        $actionbar = new subscription_actionbar($forum->id, $url, $forum, 0);
+        $output = $PAGE->get_renderer('mod_forum');
+        $data = $actionbar->export_for_template($output);
+
+        $this->assertArrayHasKey('subscriptionoptions', $data);
+        $this->assertArrayHasKey('viewandmanageselect', $data);
+
+        $select = $data['viewandmanageselect'];
+
+        // The select_menu (core/tertiary_navigation_selector) data.
+        $this->assertSame('selectviewandmanagesubscribers', $select->name);
+        $this->assertNotEmpty($select->baseid);
+        $this->assertSame(get_string('forum:viewsubscribers', 'forum'), $select->selectedoption);
+        $this->assertSame(get_string('subscribers', 'forum'), $select->label);
+        $this->assertCount(2, $select->options);
+        $this->assertTrue($select->options[0]['selected']);
+        $this->assertFalse($select->options[1]['selected']);
+        $this->assertStringContainsString('edit=off', $select->options[0]['value']);
+        $this->assertStringContainsString('edit=on', $select->options[1]['value']);
+        $this->assertSame($select->options[0]['value'], $select->value);
+
+        // The legacy core/url_select compatible data.
+        $this->assertSame('selectviewandmanagesubscribers', $select->formid);
+        $this->assertNotEmpty($select->id);
+        $this->assertSame(sesskey(), $select->sesskey);
+        $this->assertSame((new moodle_url('/course/jumpto.php'))->out(false), $select->action);
+        $this->assertObjectHasProperty('classes', $select);
+
+        // Both the new and the legacy templates must render the selector.
+        $html = $output->render_from_template('core/tertiary_navigation_selector', $select);
+        $this->assertStringContainsString('tertiary-navigation-selector', $html);
+        $html = $output->render_from_template('core/url_select', $select);
+        $this->assertStringContainsString('id="selectviewandmanagesubscribers"', $html);
+        $this->assertStringContainsString('edit=on', $html);
+
+        // Manage subscribers view.
+        $actionbar = new subscription_actionbar($forum->id, $url, $forum, 1);
+        $data = $actionbar->export_for_template($output);
+        $this->assertArrayNotHasKey('subscriptionoptions', $data);
+        $select = $data['viewandmanageselect'];
+        $this->assertSame(get_string('managesubscriptionson', 'forum'), $select->selectedoption);
+        $this->assertFalse($select->options[0]['selected']);
+        $this->assertTrue($select->options[1]['selected']);
+
+        // Forced subscription: no view/manage selector.
+        $forum->forcesubscribe = FORUM_FORCESUBSCRIBE;
+        $actionbar = new subscription_actionbar($forum->id, $url, $forum, 0);
+        $data = $actionbar->export_for_template($output);
+        $this->assertArrayNotHasKey('viewandmanageselect', $data);
+        $this->assertArrayHasKey('subscriptionoptions', $data);
+    }
+}
