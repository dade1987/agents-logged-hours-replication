+#[\PHPUnit\Framework\Attributes\CoversClass(footer_content::class)]
+final class footer_content_test extends \advanced_testcase {
+    /**
+     * Test the previous/next links on the first, middle and last activities of a course.
+     */
+    public function test_export_for_template_boundaries(): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $generator = $this->getDataGenerator();
+
+        $course = $generator->create_course(['format' => 'topics', 'enablelinearnav' => 1, 'numsections' => 2]);
+        $page1 = $generator->create_module('page', ['course' => $course->id, 'section' => 1]);
+        $page2 = $generator->create_module('page', ['course' => $course->id, 'section' => 1]);
+        $page3 = $generator->create_module('page', ['course' => $course->id, 'section' => 2]);
+
+        $student = $generator->create_user();
+        $generator->enrol_user($student->id, $course->id, 'student');
+        $this->setUser($student);
+
+        $output = $PAGE->get_renderer('core');
+        $modinfo = get_fast_modinfo($course);
+        $courseurl = (new \core\url('/course/view.php', ['id' => $course->id]))->out(false);
+
+        // First activity: no "Previous" link, but a "Next" link.
+        $data = (new footer_content($modinfo->get_cm($page1->cmid)))->export_for_template($output);
+        $this->assertNull($data['previousurl']);
+        $this->assertNotNull($data['nexturl']);
+        $this->assertStringContainsString('/cms/' . $page1->cmid . '/next', $data['nexturl']);
+        $this->assertNull($data['courseurl']);
+
+        // Middle activity: both links.
+        $data = (new footer_content($modinfo->get_cm($page2->cmid)))->export_for_template($output);
+        $this->assertNotNull($data['previousurl']);
+        $this->assertStringContainsString('/cms/' . $page2->cmid . '/previous', $data['previousurl']);
+        $this->assertNotNull($data['nexturl']);
+        $this->assertNull($data['courseurl']);
+
+        // Last activity: "Previous" link and "Go to course" link instead of "Next".
+        $data = (new footer_content($modinfo->get_cm($page3->cmid)))->export_for_template($output);
+        $this->assertNotNull($data['previousurl']);
+        $this->assertNull($data['nexturl']);
+        $this->assertEquals($courseurl, $data['courseurl']);
+
+        // The rendered footer must contain the "Go to course" link pointing to the course page.
+        $html = $output->render(new footer_content($modinfo->get_cm($page3->cmid)));
+        $this->assertStringContainsString(get_string('gotocourse', 'core_courseformat'), $html);
+        $this->assertStringContainsString('href="' . $courseurl . '"', $html);
+        $this->assertStringNotContainsString(get_string('next', 'core'), $html);
+    }
+
+    /**
+     * Test that a course with a single activity shows only the "Go to course" link.
+     */
+    public function test_export_for_template_single_activity(): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $generator = $this->getDataGenerator();
+
+        $course = $generator->create_course(['format' => 'topics', 'enablelinearnav' => 1]);
+        $page1 = $generator->create_module('page', ['course' => $course->id]);
+
+        $student = $generator->create_user();
+        $generator->enrol_user($student->id, $course->id, 'student');
+        $this->setUser($student);
+
+        $output = $PAGE->get_renderer('core');
+        $modinfo = get_fast_modinfo($course);
+
+        $data = (new footer_content($modinfo->get_cm($page1->cmid)))->export_for_template($output);
+        $this->assertNull($data['previousurl']);
+        $this->assertNull($data['nexturl']);
+        $this->assertEquals(
+            (new \core\url('/course/view.php', ['id' => $course->id]))->out(false),
+            $data['courseurl'],
+        );
+    }
+
+    /**
+     * Test that hidden activities and labels are ignored when detecting the first and last activities.
+     */
+    public function test_export_for_template_hidden_activities(): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $generator = $this->getDataGenerator();
+
+        $course = $generator->create_course(['format' => 'topics', 'enablelinearnav' => 1, 'numsections' => 2]);
+        $hiddenfirst = $generator->create_module('page', ['course' => $course->id, 'section' => 1, 'visible' => 0]);
+        $page1 = $generator->create_module('page', ['course' => $course->id, 'section' => 1]);
+        $page2 = $generator->create_module('page', ['course' => $course->id, 'section' => 1]);
+        $hiddenlast = $generator->create_module('page', ['course' => $course->id, 'section' => 2, 'visible' => 0]);
+        $generator->create_module('label', ['course' => $course->id, 'section' => 2]);
+
+        $student = $generator->create_user();
+        $generator->enrol_user($student->id, $course->id, 'student');
+        $teacher = $generator->create_user();
+        $generator->enrol_user($teacher->id, $course->id, 'editingteacher');
+
+        $output = $PAGE->get_renderer('core');
+        $courseurl = (new \core\url('/course/view.php', ['id' => $course->id]))->out(false);
+
+        // For a student, the hidden activities are not accessible, so page1 is the first and page2 is the last.
+        $this->setUser($student);
+        $modinfo = get_fast_modinfo($course);
+
+        $data = (new footer_content($modinfo->get_cm($page1->cmid)))->export_for_template($output);
+        $this->assertNull($data['previousurl']);
+        $this->assertNotNull($data['nexturl']);
+        $this->assertNull($data['courseurl']);
+
+        $data = (new footer_content($modinfo->get_cm($page2->cmid)))->export_for_template($output);
+        $this->assertNotNull($data['previousurl']);
+        $this->assertNull($data['nexturl']);
+        $this->assertEquals($courseurl, $data['courseurl']);
+
+        // For a teacher, the hidden activities are accessible, so they are the first and last ones.
+        $this->setUser($teacher);
+        $modinfo = get_fast_modinfo($course);
+
+        $data = (new footer_content($modinfo->get_cm($hiddenfirst->cmid)))->export_for_template($output);
+        $this->assertNull($data['previousurl']);
+        $this->assertNotNull($data['nexturl']);
+        $this->assertNull($data['courseurl']);
+
+        $data = (new footer_content($modinfo->get_cm($page1->cmid)))->export_for_template($output);
+        $this->assertNotNull($data['previousurl']);
+        $this->assertNotNull($data['nexturl']);
+        $this->assertNull($data['courseurl']);
+
+        $data = (new footer_content($modinfo->get_cm($page2->cmid)))->export_for_template($output);
+        $this->assertNotNull($data['previousurl']);
+        $this->assertNotNull($data['nexturl']);
+        $this->assertNull($data['courseurl']);
+
+        $data = (new footer_content($modinfo->get_cm($hiddenlast->cmid)))->export_for_template($output);
+        $this->assertNotNull($data['previousurl']);
+        $this->assertNull($data['nexturl']);
+        $this->assertEquals($courseurl, $data['courseurl']);
+    }
+
+    /**
+     * Test that activities inside subsections are considered in their position in the course.
+     */
+    public function test_export_for_template_subsections(): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $generator = $this->getDataGenerator();
+
+        $course = $generator->create_course(['format' => 'topics', 'enablelinearnav' => 1, 'numsections' => 1]);
+        $page1 = $generator->create_module('page', ['course' => $course->id, 'section' => 1]);
+        $subsection = $generator->create_module('subsection', ['course' => $course->id, 'section' => 1]);
+        $modinfo = get_fast_modinfo($course);
+        $delegatedsection = $modinfo->get_cm($subsection->cmid)->get_delegated_section_info();
+        $page2 = $generator->create_module('page', ['course' => $course->id, 'section' => $delegatedsection->sectionnum]);
+
+        $student = $generator->create_user();
+        $generator->enrol_user($student->id, $course->id, 'student');
+        $this->setUser($student);
+
+        $output = $PAGE->get_renderer('core');
+        $modinfo = get_fast_modinfo($course);
+        $courseurl = (new \core\url('/course/view.php', ['id' => $course->id]))->out(false);
+
+        $data = (new footer_content($modinfo->get_cm($page1->cmid)))->export_for_template($output);
+        $this->assertNull($data['previousurl']);
+        $this->assertNotNull($data['nexturl']);
+        $this->assertNull($data['courseurl']);
+
+        // The activity in the subsection is the last activity of the course.
+        $data = (new footer_content($modinfo->get_cm($page2->cmid)))->export_for_template($output);
+        $this->assertNotNull($data['previousurl']);
+        $this->assertNull($data['nexturl']);
+        $this->assertEquals($courseurl, $data['courseurl']);
+    }
+}
