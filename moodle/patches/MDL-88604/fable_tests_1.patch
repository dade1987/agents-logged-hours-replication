+    /**
+     * Get all the course modules that can be reached using the linear navigation, in course order.
+     *
+     * Delegated sections (sub-sections) are expanded in the position of their parent module and
+     * orphaned sections are ignored, so the result follows the order in which a user would navigate
+     * through the course using the "Previous" and "Next" controls.
+     *
+     * @param modinfo $modinfo
+     * @return cm_info[] The navigable course modules, indexed by course module id.
+     */
+    public static function get_all_navigable_cms(modinfo $modinfo): array {
+        $result = [];
+        foreach ($modinfo->get_section_info_all() as $section) {
+            if ($section->is_delegated() || $section->is_orphan()) {
+                // Delegated sections are included through their parent section.
+                continue;
