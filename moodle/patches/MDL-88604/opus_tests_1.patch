+    /**
+     * Calculate whether the current course module is the first and/or the last navigable
+     * activity of the course for the current user.
+     *
+     * Only activities the user can navigate to are considered (hidden, stealth, or
+     * activities without a view page are ignored), following the same rules as the
+     * course navigation controller.
+     *
+     * @return bool[] An array with two booleans: [isfirst, islast].
+     */
+    private function get_course_position(): array {
+        $modinfo = $this->cminfo->get_modinfo();
+
+        $cms = [];
+        foreach ($modinfo->get_listed_section_info_all() as $section) {
+            if ($section->is_delegated()) {
+                continue;
+            }
+            $cms = array_merge($cms, $this->get_all_section_cms($section));
+        }
+
+        $hasprevious = false;
+        $hasnext = false;
+        $found = false;
+        foreach ($cms as $cm) {
+            if ($cm->id == $this->cminfo->id) {
+                $found = true;
+                continue;
+            }
+            if (!$this->is_valid_cm($cm)) {
+                continue;
+            }
+            if ($found) {
+                $hasnext = true;
+                break;
+            }
+            $hasprevious = true;
+        }
+
+        if (!$found) {
+            // The current activity is not part of the course structure (e.g. an orphaned activity).
+            // Keep the default navigation.
+            return [false, false];
+        }
+
+        return [!$hasprevious, !$hasnext];
+    }
+
+    /**
+     * Get all course modules in a section in order, including also activities inside sub-sections.
+     *
+     * @param section_info $section
+     * @return cm_info[]
+     */
+    private function get_all_section_cms(section_info $section): array {
+        $sectioncms = [];
+        foreach ($section->get_sequence_cm_infos() as $cm) {
+            $delegatedsection = $cm->get_delegated_section_info();
+            if ($delegatedsection) {
+                $sectioncms = array_merge(
+                    $sectioncms,
+                    $this->get_all_section_cms($delegatedsection),
+                );
+            } else {
+                $sectioncms[] = $cm;
+            }
+        }
+        return $sectioncms;
+    }
+
+    /**
+     * Check if a course module is a valid navigation target for the current user.
+     *
+     * @param cm_info $cm The course module to check.
+     * @return bool
+     */
+    private function is_valid_cm(cm_info $cm): bool {
+        return
+            // Skip modules that don't have a URL (like labels).
+            !empty($cm->get_navigation_url())
+            // Skip modules that are not visible to the user.
+            && $cm->is_visible_on_course_page()
+            // Skip modules that are not displayable.
+            && modinfo::is_mod_type_visible_on_course($cm->modname);
+    }
+
