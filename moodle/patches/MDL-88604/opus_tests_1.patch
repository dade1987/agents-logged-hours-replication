+namespace core_courseformat\output\local\linearnavigation;
+
+/**
+ * Tests for the linear navigation footer content.
+ *
+ * @package    core_courseformat
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(footer_content::class)]
+final class footer_content_test extends \advanced_testcase {
+    /**
+     * Export the footer content data for a given activity and the current user.
+     *
+     * @param \stdClass $course
+     * @param int $cmid
+     * @return array
+     */
+    private function export(\stdClass $course, int $cmid): array {
+        global $PAGE;
+        $cm = get_fast_modinfo($course)->get_cm($cmid);
+        $footer = new footer_content($cm);
+        return $footer->export_for_template($PAGE->get_renderer('core'));
+    }
+
+    /**
+     * Test the previous and next links at the course boundaries.
+     */
+    public function test_export_for_template_boundaries(): void {
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course(['numsections' => 3, 'enablelinearnav' => 1]);
+        $student = $this->getDataGenerator()->create_and_enrol($course, 'student');
+
+        $label = $this->getDataGenerator()->create_module('label', ['course' => $course->id, 'section' => 0]);
+        $page1 = $this->getDataGenerator()->create_module('page', ['course' => $course->id, 'section' => 1]);
+        $page2 = $this->getDataGenerator()->create_module('page', ['course' => $course->id, 'section' => 1]);
+        $page3 = $this->getDataGenerator()->create_module('page', ['course' => $course->id, 'section' => 2]);
+        $hidden = $this->getDataGenerator()->create_module(
+            'page',
+            ['course' => $course->id, 'section' => 3, 'visible' => 0],
+        );
+
+        $this->setUser($student);
+        $courseurl = (new \core\url('/course/view.php', ['id' => $course->id]))->out(false);
+
+        // First activity: no previous link (labels are ignored).
+        $data = $this->export($course, $page1->cmid);
+        $this->assertEmpty($data['previousurl']);
+        $this->assertNotEmpty($data['nexturl']);
+        $this->assertEmpty($data['courseurl']);
+
+        // Middle activity: both links.
+        $data = $this->export($course, $page2->cmid);
+        $this->assertNotEmpty($data['previousurl']);
+        $this->assertNotEmpty($data['nexturl']);
+        $this->assertEmpty($data['courseurl']);
+
+        // Last accessible activity (the following one is hidden): go to course link.
+        $data = $this->export($course, $page3->cmid);
+        $this->assertNotEmpty($data['previousurl']);
+        $this->assertEmpty($data['nexturl']);
+        $this->assertEquals($courseurl, $data['courseurl']);
+
+        // A teacher can see the hidden activity, so page3 is not the last one.
+        $this->setAdminUser();
+        $data = $this->export($course, $page3->cmid);
+        $this->assertNotEmpty($data['nexturl']);
+        $this->assertEmpty($data['courseurl']);
+
+        $data = $this->export($course, $hidden->cmid);
+        $this->assertNotEmpty($data['previousurl']);
+        $this->assertEmpty($data['nexturl']);
+        $this->assertEquals($courseurl, $data['courseurl']);
+    }
+
+    /**
+     * Test a course with a single activity.
+     */
+    public function test_export_for_template_single_activity(): void {
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course(['numsections' => 1, 'enablelinearnav' => 1]);
+        $student = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $page = $this->getDataGenerator()->create_module('page', ['course' => $course->id, 'section' => 1]);
+
+        $this->setUser($student);
+        $data = $this->export($course, $page->cmid);
+        $this->assertEmpty($data['previousurl']);
+        $this->assertEmpty($data['nexturl']);
+        $this->assertEquals(
+            (new \core\url('/course/view.php', ['id' => $course->id]))->out(false),
+            $data['courseurl'],
+        );
+    }
+}
