@@ -47,23 +47,96 @@ class footer_content implements named_templatable, renderable {
 
     #[\Override]
     public function export_for_template(renderer_base $output) {
-        // Get previous and next URLs for the current course module.
-        $previousurl = util::get_path_for_callable(
-            [course_navigation::class, 'cm_previous_element'],
-            ['cm' => $this->cminfo->id],
-        );
-        $nexturl = util::get_path_for_callable(
-            [course_navigation::class, 'cm_next_element'],
-            ['cm' => $this->cminfo->id],
-        );
+        [$isfirst, $islast] = $this->get_boundaries();
+
+        // The previous link is hidden on the first activity of the course.
+        $previousurl = '';
+        if (!$isfirst) {
+            $previousurl = util::get_path_for_callable(
+                [course_navigation::class, 'cm_previous_element'],
+                ['cm' => $this->cminfo->id],
+            )->out(false);
+        }
+
+        // The next link is replaced by a link to the course on the last activity.
+        $nexturl = '';
+        $courseurl = '';
+        if ($islast) {
+            $courseurl = course_get_url($this->cminfo->course)->out(false);
+        } else {
+            $nexturl = util::get_path_for_callable(
+                [course_navigation::class, 'cm_next_element'],
+                ['cm' => $this->cminfo->id],
+            )->out(false);
+        }
 
         return [
-            'previousurl' => $previousurl->out(false),
-            'nexturl' => $nexturl->out(false),
+            'previousurl' => $previousurl,
+            'nexturl' => $nexturl,
+            'courseurl' => $courseurl,
             'completion' => $this->export_completion($output),
         ];
     }
 
+    /**
+     * Check if the current activity is the first and/or the last navigable activity of the course.
+     *
+     * @return bool[] [isfirst, islast]
+     */
+    private function get_boundaries(): array {
+        $modinfo = $this->cminfo->get_modinfo();
+        $navigable = [];
+        foreach ($modinfo->get_section_info_all() as $section) {
+            if ($section->is_delegated()) {
+                // Delegated sections are traversed through their parent module.
+                continue;
+            }
+            $navigable = array_merge($navigable, $this->get_navigable_cms($section));
+        }
+        if (empty($navigable)) {
+            return [true, true];
+        }
+        $first = reset($navigable);
+        $last = end($navigable);
+        return [
+            $first === $this->cminfo->id,
+            $last === $this->cminfo->id,
+        ];
+    }
+
+    /**
+     * Get the ids of the navigable course modules of a section, including those in subsections.
+     *
+     * The current activity is always considered navigable.
+     *
+     * @param \section_info $section
+     * @return int[]
+     */
+    private function get_navigable_cms(\section_info $section): array {
+        $result = [];
+        foreach ($section->get_sequence_cm_infos() as $cm) {
+            $delegated = $cm->get_delegated_section_info();
+            if ($delegated) {
+                $result = array_merge($result, $this->get_navigable_cms($delegated));
+            } else if ($cm->id == $this->cminfo->id || $this->is_valid_cm($cm)) {
+                $result[] = (int) $cm->id;
+            }
+        }
+        return $result;
+    }
+
+    /**
+     * Check if a course module can be a navigation target (same rules as the navigation route).
+     *
+     * @param cm_info $cm
+     * @return bool
+     */
+    private function is_valid_cm(cm_info $cm): bool {
+        return !empty($cm->get_navigation_url())
+            && $cm->is_visible_on_course_page()
+            && \core_course\modinfo::is_mod_type_visible_on_course($cm->modname);
+    }
+
     /**
      * Export the activity completion control to display in the footer.
      *
