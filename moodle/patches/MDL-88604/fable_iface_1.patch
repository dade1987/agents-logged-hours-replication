+    /**
+     * Test get_adjacent_section.
+     */
+    public function test_get_adjacent_section(): void {
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course(['numsections' => 3]);
+        $sectioninfo = get_fast_modinfo($course)->get_section_info(2);
+        formatactions::section($course)->update($sectioninfo, ['visible' => false]);
+        $student = $generator->create_and_enrol($course, 'student');
+        $teacher = $generator->create_and_enrol($course, 'editingteacher');
+
+        $controller = new course_navigation();
+
+        // Student: hidden sections are skipped.
+        $this->setUser($student);
+        $modinfo = get_fast_modinfo($course->id, $student->id);
+        $this->assertEquals(1, $controller->get_adjacent_section($modinfo, $modinfo->get_section_info(0), 'next')->sectionnum);
+        $this->assertEquals(3, $controller->get_adjacent_section($modinfo, $modinfo->get_section_info(1), 'next')->sectionnum);
+        $this->assertNull($controller->get_adjacent_section($modinfo, $modinfo->get_section_info(3), 'next'));
+        $this->assertNull($controller->get_adjacent_section($modinfo, $modinfo->get_section_info(0), 'previous'));
+        $this->assertEquals(1, $controller->get_adjacent_section($modinfo, $modinfo->get_section_info(1), 'previous')->sectionnum);
+        $this->assertEquals(3, $controller->get_adjacent_section($modinfo, $modinfo->get_section_info(3), 'previous')->sectionnum);
+
+        // Teacher: hidden sections are navigable.
+        $this->setUser($teacher);
+        $modinfo = get_fast_modinfo($course->id, $teacher->id);
+        $this->assertEquals(2, $controller->get_adjacent_section($modinfo, $modinfo->get_section_info(1), 'next')->sectionnum);
+        $this->assertEquals(2, $controller->get_adjacent_section($modinfo, $modinfo->get_section_info(2), 'previous')->sectionnum);
+    }
