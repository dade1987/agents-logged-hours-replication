+// along with Moodle.  If not, see <https://www.gnu.org/licenses/>.
+
+namespace core_courseformat\output\local\linearnavigation;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+
+/**
+ * Tests for the linear navigation footer content.
+ *
+ * @package    core_courseformat
+ * @copyright  2025 Laurent David <laurent.david@moodle.com>
+ * @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[CoversClass(footer_content::class)]
+final class footer_content_test extends \advanced_testcase {
+    /**
+     * Test the previous/next/course links exported for the template.
+     */
+    public function test_export_for_template(): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course(['numsections' => 1]);
+        $student = $generator->create_and_enrol($course, 'student');
+
+        // Section 0: cm1, cm2. Section 1: cm3, cm4 (hidden).
+        $cm1 = $generator->create_module('page', ['course' => $course->id, 'section' => 0]);
+        $cm2 = $generator->create_module('page', ['course' => $course->id, 'section' => 0]);
+        $cm3 = $generator->create_module('page', ['course' => $course->id, 'section' => 1]);
+        $cm4 = $generator->create_module('page', ['course' => $course->id, 'section' => 1, 'visible' => 0]);
+
+        $this->setUser($student);
+        $renderer = $PAGE->get_renderer('core');
+        $modinfo = get_fast_modinfo($course->id, $student->id);
+        $courseurl = course_get_url($course)->out(false);
+
+        // First activity of the course: no previous link.
+        $data = (new footer_content($modinfo->get_cm($cm1->cmid)))->export_for_template($renderer);
+        $this->assertNull($data['previousurl']);
+        $this->assertNotEmpty($data['nexturl']);
+        $this->assertNull($data['courseurl']);
+
+        // Middle activity: both links.
+        $data = (new footer_content($modinfo->get_cm($cm2->cmid)))->export_for_template($renderer);
+        $this->assertNotEmpty($data['previousurl']);
+        $this->assertNotEmpty($data['nexturl']);
+        $this->assertNull($data['courseurl']);
+
+        // Last visible activity of the course (next one is hidden): "Go to course" link.
+        $data = (new footer_content($modinfo->get_cm($cm3->cmid)))->export_for_template($renderer);
+        $this->assertNotEmpty($data['previousurl']);
+        $this->assertNull($data['nexturl']);
+        $this->assertEquals($courseurl, $data['courseurl']);
+
+        // Teachers can see the hidden activity, so cm3 is not the last one for them.
+        $this->setAdminUser();
+        $modinfo = get_fast_modinfo($course->id);
+        $data = (new footer_content($modinfo->get_cm($cm3->cmid)))->export_for_template($renderer);
+        $this->assertNotEmpty($data['nexturl']);
+        $this->assertNull($data['courseurl']);
+        $data = (new footer_content($modinfo->get_cm($cm4->cmid)))->export_for_template($renderer);
+        $this->assertNull($data['nexturl']);
+        $this->assertEquals($courseurl, $data['courseurl']);
+    }
+}
