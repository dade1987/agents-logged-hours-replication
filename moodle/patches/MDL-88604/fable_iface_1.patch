+    /**
+     * Get the section page to navigate to from the current section in the given direction.
+     *
+     * Section pages are part of the linear navigation flow: a section page is displayed before
+     * the activities it contains. This means that:
+     * - When going "next" from the last activity of a section, the next listed section page is used.
+     * - When going "previous" from the first activity of a section, the current section page is used
+     *   (the section page is what comes right before its first activity).
+     *
+     * Hidden sections, sections with hidden restrictions, and delegated sections are skipped.
+     * The general section (section 0) has no section page, so navigating "previous" from it
+     * returns null (back to the course page).
+     *
+     * @param modinfo $modinfo
+     * @param section_info $currentsection
+     * @param string $direction 'next' or 'previous' to indicate the direction of the navigation.
+     * @return section_info|null The section to navigate to, or null if there is none (course page).
+     */
+    public function get_adjacent_section(
+        modinfo $modinfo,
+        section_info $currentsection,
+        string $direction,
+    ): ?section_info {
+        if ($direction === 'previous') {
+            $sectionnum = (int) $currentsection->sectionnum;
+            $step = -1;
+        } else {
+            $sectionnum = (int) $currentsection->sectionnum + 1;
+            $step = 1;
+        }
+
+        $lastsectionnum = max(array_keys($modinfo->get_section_info_all()) ?: [0]);
+        for (; $sectionnum >= 0 && $sectionnum <= $lastsectionnum; $sectionnum += $step) {
+            if ($direction === 'previous' && $sectionnum === 0) {
+                // The general section has no section page: going previous means going to the course page.
+                return null;
+            }
+            $section = $modinfo->get_section_info($sectionnum);
+            if ($section === null) {
+                continue;
+            }
+            // If the section is hidden, or its restrictions are hidden (eye closed),
+            // or it is delegated, find the next available section.
+            if (
+                (!$section->uservisible && (!$section->visible || !$section->availableinfo))
+                || $section->is_delegated()
+            ) {
+                continue;
+            }
+            return $section;
+        }
+
+        // No more sections.
+        return null;
+    }
+
