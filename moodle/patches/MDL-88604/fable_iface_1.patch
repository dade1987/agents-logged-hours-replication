+    /**
+     * Get the next or previous navigable course module in a list of course modules.
+     *
+     * @param cm_info $cm The current course module.
+     * @param cm_info[] $cms The ordered list of course modules (usually all the section cms).
+     * @param string $direction 'next' or 'previous'.
+     * @return cm_info|null The adjacent navigable course module, or null if there is none.
+     */
+    private function get_adjacent_cm(cm_info $cm, array $cms, string $direction): ?cm_info {
+        $cms = array_values($cms);
+        $cmindex = $this->get_cm_index($cm, $cms);
+        if ($cmindex === null) {
+            return null;
+        }
+        $step = ($direction === 'previous') ? -1 : 1;
+        $cmcount = count($cms);
+        for ($index = $cmindex + $step; $index >= 0 && $index < $cmcount; $index += $step) {
+            if ($this->is_valid_cm($cms[$index])) {
+                return $cms[$index];
+            }
+        }
+        return null;
+    }
