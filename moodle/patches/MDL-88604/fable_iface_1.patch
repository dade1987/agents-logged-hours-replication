+
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course(['numsections' => 2]);
+        foreach ($sectionsdef as $section) {
+            $sectioninfo = get_fast_modinfo($course)->get_section_info($section['section']);
+            if (isset($section['hidden'])) {
+                formatactions::section($course)->update($sectioninfo, ['visible' => !$section['hidden']]);
+            } else if (isset($section['available'])) {
+                formatactions::section($course)->update($sectioninfo, ['availability' => $section['available']]);
+            }
+        }
+        $user = $generator->create_and_enrol($course, $role, ['email' => $role . '@moodle.invalid']);
+        $cms = [];
+        foreach ($cmsdef as $cmdef) {
+            $cms[$cmdef['name']] = $this->create_module_or_subsection(
+                courseid: $course->id,
+                key: $cmdef['name'],
+                type: $cmdef['type'] ?? 'assign',
+                options: $cmdef['options'] ?? [],
+            );
+        }
+
+        $this->setUser($user);
+        $modinfo = get_fast_modinfo($course->id, $user->id);
+        $cm = $modinfo->get_cm($cms[$current]->cmid);
+
+        $controller = new course_navigation();
+        $section = $controller->get_section($cm);
+        $this->assertNotNull($section);
+        $this->assertFalse($section->is_delegated());
+        $allsectioncms = $controller->get_all_section_cms($modinfo, $section);
+
+        $this->assertEquals(
+            $expectedfirst,
+            $controller->is_first_navigable($cm, $modinfo, $allsectioncms),
+            'Unexpected first navigable result.',
+        );
+        $this->assertEquals(
+            $expectedlast,
+            $controller->is_last_navigable($cm, $modinfo, $allsectioncms),
+            'Unexpected last navigable result.',
+        );
+    }
