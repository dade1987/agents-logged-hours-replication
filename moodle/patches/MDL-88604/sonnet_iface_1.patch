@@ -191,6 +191,113 @@ class course_navigation {
         return $sectioncms;
     }
 
+    /**
+     * Get the adjacent navigable (non delegated, available) section.
+     *
+     * @param modinfo $modinfo
+     * @param section_info $currentsection
+     * @param string $direction 'next' or 'previous'.
+     * @return section_info|null The section, or null if there are no more sections in that direction.
+     */
+    public function get_adjacent_section(
+        modinfo $modinfo,
+        section_info $currentsection,
+        string $direction,
+    ): ?section_info {
+        $step = ($direction === 'previous') ? -1 : 1;
+        $sectionnum = $currentsection->sectionnum + $step;
+        while ($sectionnum >= 0) {
+            $section = $modinfo->get_section_info($sectionnum);
+            if ($section === null) {
+                return null;
+            }
+            $hidden = !$section->uservisible && (!$section->visible || !$section->availableinfo);
+            if (!$hidden && !$section->is_delegated()) {
+                return $section;
+            }
+            $sectionnum += $step;
+        }
+        return null;
+    }
+
+    /**
+     * Check if there is any navigable activity in the given direction, starting from a position.
+     *
+     * @param cm_info $cm
+     * @param modinfo $modinfo
+     * @param cm_info[] $allsectioncms
+     * @param string $direction 'next' or 'previous'.
+     * @return bool
+     */
+    private function has_navigable_in_direction(
+        cm_info $cm,
+        modinfo $modinfo,
+        array $allsectioncms,
+        string $direction,
+    ): bool {
+        $allsectioncms = array_values($allsectioncms);
+        $cmindex = array_search($cm, $allsectioncms, true);
+        if ($cmindex === false) {
+            foreach ($allsectioncms as $index => $candidate) {
+                if ($candidate->id == $cm->id) {
+                    $cmindex = $index;
+                    break;
+                }
+            }
+        }
+        $step = ($direction === 'previous') ? -1 : 1;
+        if ($cmindex !== false) {
+            $count = count($allsectioncms);
+            for ($i = $cmindex + $step; $i >= 0 && $i < $count; $i += $step) {
+                if ($this->is_valid_cm($allsectioncms[$i])) {
+                    return true;
+                }
+            }
+        }
+
+        $section = $this->get_section($cm);
+        while ($section = ($section ? $this->get_adjacent_section($modinfo, $section, $direction) : null)) {
+            foreach ($this->get_all_section_cms($modinfo, $section) as $othercm) {
+                if ($this->is_valid_cm($othercm)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Check if the course module is the first navigable activity of the course.
+     *
+     * @param cm_info $cm
+     * @param modinfo $modinfo
+     * @param cm_info[] $allsectioncms All the course modules of the cm section.
+     * @return bool
+     */
+    public function is_first_navigable(
+        cm_info $cm,
+        modinfo $modinfo,
+        array $allsectioncms,
+    ): bool {
+        return !$this->has_navigable_in_direction($cm, $modinfo, $allsectioncms, 'previous');
+    }
+
+    /**
+     * Check if the course module is the last navigable activity of the course.
+     *
+     * @param cm_info $cm
+     * @param modinfo $modinfo
+     * @param cm_info[] $allsectioncms All the course modules of the cm section.
+     * @return bool
+     */
+    public function is_last_navigable(
+        cm_info $cm,
+        modinfo $modinfo,
+        array $allsectioncms,
+    ): bool {
+        return !$this->has_navigable_in_direction($cm, $modinfo, $allsectioncms, 'next');
+    }
+
