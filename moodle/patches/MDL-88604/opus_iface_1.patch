+    /**
+     * Test the first and last navigable elements detection.
+     *
+     * @param array $cmsdef
+     * @param array $expectedfirst Names of the modules expected to be the first navigable.
+     * @param array $expectedlast Names of the modules expected to be the last navigable.
+     * @param int $numsections
+     * @param array $sectionsdef
+     */
+    #[DataProvider('first_last_navigable_provider')]
+    public function test_is_first_last_navigable(
+        array $cmsdef,
+        array $expectedfirst,
+        array $expectedlast,
+        int $numsections = 2,
+        array $sectionsdef = [],
+    ): void {
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course(['numsections' => $numsections]);
+        foreach ($sectionsdef as $section) {
+            $sectioninfo = get_fast_modinfo($course)->get_section_info($section['section']);
+            formatactions::section($course)->update($sectioninfo, ['visible' => !$section['hidden']]);
+        }
+        $user = $generator->create_and_enrol($course, 'student');
+        foreach ($cmsdef as $cmdef) {
+            $this->create_module_or_subsection(
+                courseid: $course->id,
+                key: $cmdef['name'],
+                type: $cmdef['type'] ?? 'assign',
+                options: $cmdef['options'] ?? [],
+            );
+        }
+
+        $this->setUser($user);
+        $modinfo = modinfo::instance($course->id);
+        $navigation = new course_navigation();
+        foreach ($modinfo->get_cms() as $cm) {
+            if ($cm->modname === 'subsection' || !$cm->uservisible || empty($cm->get_navigation_url())) {
+                continue;
+            }
+            $section = $navigation->get_section($cm);
+            $this->assertNotNull($section);
+            $this->assertFalse($section->is_delegated());
+            $allsectioncms = $navigation->get_all_section_cms($modinfo, $section);
+            $this->assertEquals(
+                in_array($cm->name, $expectedfirst),
+                $navigation->is_first_navigable($cm, $modinfo, $allsectioncms),
+                "Unexpected first navigable value for {$cm->name}",
