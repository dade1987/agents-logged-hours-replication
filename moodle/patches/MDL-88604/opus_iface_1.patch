+            'numsections' => 0,
+        ];
+    }
+
+    /**
+     * Test get_adjacent_section.
+     */
+    public function test_get_adjacent_section(): void {
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course(['numsections' => 3]);
+        $sectioninfo = get_fast_modinfo($course)->get_section_info(2);
+        formatactions::section($course)->update($sectioninfo, ['visible' => false]);
+        $user = $generator->create_and_enrol($course, 'student');
+
+        $this->setUser($user);
+        $modinfo = modinfo::instance($course->id);
+        $navigation = new course_navigation();
+
+        $this->assertNull($navigation->get_adjacent_section($modinfo, $modinfo->get_section_info(0), 'previous'));
+        $this->assertEquals(1, $navigation->get_adjacent_section($modinfo, $modinfo->get_section_info(0), 'next')->sectionnum);
+        // Section 2 is hidden for students.
+        $this->assertEquals(3, $navigation->get_adjacent_section($modinfo, $modinfo->get_section_info(1), 'next')->sectionnum);
+        $this->assertEquals(1, $navigation->get_adjacent_section($modinfo, $modinfo->get_section_info(3), 'previous')->sectionnum);
+        $this->assertNull($navigation->get_adjacent_section($modinfo, $modinfo->get_section_info(3), 'next'));
+    }
