+    /**
+     * Check if the current course module is the first navigable activity of the course.
+     *
+     * @param cm_info[] $navigablecms The navigable course modules in course order.
+     * @return bool
+     */
+    private function is_first_cm(array $navigablecms): bool {
+        $first = reset($navigablecms);
+        return $first === false || $first->id == $this->cminfo->id;
+    }
+
+    /**
+     * Check if the current course module is the last navigable activity of the course.
+     *
+     * @param cm_info[] $navigablecms The navigable course modules in course order.
+     * @return bool
+     */
+    private function is_last_cm(array $navigablecms): bool {
+        $last = end($navigablecms);
+        return $last === false || $last->id == $this->cminfo->id;
+    }
+
+    /**
+     * Get all the course modules the user can navigate to, in course order.
+     *
+     * The current course module is always included so its position can be determined.
+     * Activities inside delegated sections (subsections) are included in the position
+     * of the delegating module.
+     *
+     * @return cm_info[]
+     */
+    private function get_navigable_cms(): array {
+        $modinfo = $this->cminfo->get_modinfo();
+        $result = [];
+        foreach ($modinfo->get_listed_section_info_all() as $section) {
+            foreach ($this->get_all_section_cms($section) as $cm) {
+                if ($cm->id == $this->cminfo->id || $this->is_navigable_cm($cm)) {
+                    $result[] = $cm;
+                }
+            }
+        }
+        return $result;
+    }
+
+    /**
+     * Get all course modules in a section in order, including also activities inside sub-sections.
+     *
+     * @param \section_info $section
+     * @return cm_info[]
+     */
+    private function get_all_section_cms(\section_info $section): array {
+        $sectioncms = [];
+        foreach ($section->get_sequence_cm_infos() as $cm) {
+            $delegatedsection = $cm->get_delegated_section_info();
+            if ($delegatedsection) {
+                $sectioncms = array_merge($sectioncms, $this->get_all_section_cms($delegatedsection));
+            } else {
+                $sectioncms[] = $cm;
+            }
+        }
+        return $sectioncms;
+    }
+
+    /**
+     * Check if a course module can be reached using the linear navigation.
+     *
+     * The same criteria as the course navigation controller are used.
+     *
+     * @param cm_info $cm The course module to check.
+     * @return bool
+     */
+    private function is_navigable_cm(cm_info $cm): bool {
+        return
+            // Skip modules that don't have a URL (like labels).
+            !empty($cm->get_navigation_url())
+            // Skip modules that are not visible to the user.
+            && $cm->is_visible_on_course_page()
+            // Skip modules that are not displayable.
+            && \core_course\modinfo::is_mod_type_visible_on_course($cm->modname);
+    }
+
