+namespace core_courseformat\output\local\linearnavigation;
+
+/**
+ * Tests for the linear navigation footer content.
+ *
+ * @package    core_courseformat
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(footer_content::class)]
+final class footer_content_test extends \advanced_testcase {
+    /**
+     * Test the previous, next and course links for first, middle and last activities.
+     */
+    public function test_export_for_template_boundaries(): void {
+        global $PAGE;
+        $this->resetAfterTest();
+
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course(['format' => 'topics', 'numsections' => 2, 'enablelinearnav' => 1]);
+        $student = $generator->create_and_enrol($course, 'student');
+        $teacher = $generator->create_and_enrol($course, 'editingteacher');
+
+        $hiddenfirst = $generator->create_module('page', ['course' => $course->id, 'section' => 1, 'visible' => 0]);
+        $first = $generator->create_module('page', ['course' => $course->id, 'section' => 1]);
+        $generator->create_module('label', ['course' => $course->id, 'section' => 1]);
+        $middle = $generator->create_module('page', ['course' => $course->id, 'section' => 2]);
+        $last = $generator->create_module('page', ['course' => $course->id, 'section' => 2]);
+        $hiddenlast = $generator->create_module('page', ['course' => $course->id, 'section' => 2, 'visible' => 0]);
+
+        $output = $PAGE->get_renderer('core');
+        $courseurl = (new \core\url('/course/view.php', ['id' => $course->id]))->out(false);
+
+        $this->setUser($student);
+        $modinfo = get_fast_modinfo($course, $student->id);
+
+        $data = (new footer_content($modinfo->get_cm($first->cmid)))->export_for_template($output);
+        $this->assertEmpty($data['previousurl']);
+        $this->assertNotEmpty($data['nexturl']);
+        $this->assertEmpty($data['courseurl']);
+
+        $data = (new footer_content($modinfo->get_cm($middle->cmid)))->export_for_template($output);
+        $this->assertNotEmpty($data['previousurl']);
+        $this->assertNotEmpty($data['nexturl']);
+        $this->assertEmpty($data['courseurl']);
+
+        $data = (new footer_content($modinfo->get_cm($last->cmid)))->export_for_template($output);
+        $this->assertNotEmpty($data['previousurl']);
+        $this->assertEmpty($data['nexturl']);
+        $this->assertEquals($courseurl, $data['courseurl']);
+
+        // Teachers can see the hidden activities, so they are part of the navigation.
+        $this->setUser($teacher);
+        $modinfo = get_fast_modinfo($course, $teacher->id);
+
+        $data = (new footer_content($modinfo->get_cm($first->cmid)))->export_for_template($output);
+        $this->assertNotEmpty($data['previousurl']);
+
+        $data = (new footer_content($modinfo->get_cm($last->cmid)))->export_for_template($output);
+        $this->assertNotEmpty($data['nexturl']);
+        $this->assertEmpty($data['courseurl']);
+
+        $data = (new footer_content($modinfo->get_cm($hiddenfirst->cmid)))->export_for_template($output);
+        $this->assertEmpty($data['previousurl']);
+
+        $data = (new footer_content($modinfo->get_cm($hiddenlast->cmid)))->export_for_template($output);
+        $this->assertEmpty($data['nexturl']);
+        $this->assertEquals($courseurl, $data['courseurl']);
+    }
+}
