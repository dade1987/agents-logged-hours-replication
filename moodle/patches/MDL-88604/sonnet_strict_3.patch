+    /**
+     * Find out if the current activity is the first and/or the last navigable activity of the course.
+     *
+     * Activities that are hidden or not accessible to the user are ignored.
+     *
+     * @return bool[] Array with two booleans: is the first activity, is the last activity.
+     */
+    private function get_boundaries(): array {
+        $modinfo = $this->cminfo->get_modinfo();
+        $navigable = [];
+        foreach ($modinfo->get_section_info_all() as $section) {
+            if ($section->is_delegated()) {
+                // Delegated section activities are collected from their parent section.
+                continue;
+            }
+            foreach ($this->get_section_cms($section) as $cm) {
+                if ($cm->id == $this->cminfo->id || $this->is_valid_cm($cm)) {
+                    $navigable[] = $cm->id;
+                }
+            }
+        }
+        $position = array_search($this->cminfo->id, $navigable);
+        if ($position === false) {
+            return [false, false];
+        }
+        return [$position === 0, $position === count($navigable) - 1];
+    }
+
+    /**
+     * Get all course modules of a section in order, including the ones inside delegated sections.
+     *
+     * @param section_info $section
+     * @return cm_info[]
+     */
+    private function get_section_cms(section_info $section): array {
+        $result = [];
+        foreach ($section->get_sequence_cm_infos() as $cm) {
+            $delegated = $cm->get_delegated_section_info();
+            if ($delegated) {
+                $result = array_merge($result, $this->get_section_cms($delegated));
+            } else {
+                $result[] = $cm;
+            }
+        }
+        return $result;
+    }
+
+    /**
+     * Check if a course module can be a navigation target (same rules as the navigation controller).
+     *
+     * @param cm_info $cm
+     * @return bool
+     */
+    private function is_valid_cm(cm_info $cm): bool {
+        return !empty($cm->get_navigation_url())
+            && $cm->is_visible_on_course_page()
+            && modinfo::is_mod_type_visible_on_course($cm->modname);
+    }
+
     /**
      * Export the activity completion control to display in the footer.
      *
