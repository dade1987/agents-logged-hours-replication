+    /**
+     * Check whether the current activity is the first and/or the last navigable activity of the course.
+     *
+     * Only activities the current user can see and that have a navigation URL are taken into account.
+     *
+     * @return bool[] Array with two booleans: [is first, is last].
+     */
+    private function get_boundaries(): array {
+        $modinfo = $this->cminfo->get_modinfo();
+        $navigable = [];
+        foreach ($modinfo->get_section_info_all() as $section) {
+            if ($section->is_delegated()) {
+                // Delegated section activities are collected from the parent section.
+                continue;
+            }
+            $this->collect_navigable_cms($section, $navigable);
+        }
+        if (empty($navigable)) {
+            return [true, true];
+        }
+        $ids = array_keys($navigable);
+        $currentid = (int) $this->cminfo->id;
+        return [reset($ids) === $currentid, end($ids) === $currentid];
+    }
+
+    /**
+     * Collect, in course order, the navigable activities of a section (including delegated subsections).
+     *
+     * @param \section_info $section
+     * @param array $navigable Navigable cm_info instances indexed by cm id.
+     */
+    private function collect_navigable_cms(\section_info $section, array &$navigable): void {
+        foreach ($section->get_sequence_cm_infos() as $cm) {
+            $delegated = $cm->get_delegated_section_info();
+            if ($delegated) {
+                $this->collect_navigable_cms($delegated, $navigable);
+                continue;
+            }
+            if (
+                $cm->id == $this->cminfo->id
+                || (
+                    !empty($cm->get_navigation_url())
+                    && $cm->is_visible_on_course_page()
+                    && \core_course\modinfo::is_mod_type_visible_on_course($cm->modname)
+                )
+            ) {
+                $navigable[(int) $cm->id] = $cm;
+            }
+        }
+    }
+
