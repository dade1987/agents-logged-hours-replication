diff --git a/public/question/type/multichoice/tests/walkthrough_test.php b/public/question/type/multichoice/tests/walkthrough_test.php
index c09e39dd3e3..b8fd8f3af20 100644
--- a/public/question/type/multichoice/tests/walkthrough_test.php
+++ b/public/question/type/multichoice/tests/walkthrough_test.php
@@ -302,10 +302,36 @@ final class walkthrough_test extends \qbehaviour_walkthrough_test_base {
         $this->render();
 
         // Check for 'Show standard instruction'.
+        $legendid = $this->quba->get_question_attempt($this->slot)->get_outer_question_div_unique_id() . '-legend';
         $standardinstruction = \html_writer::tag('legend', get_string('answer'), [
+            'id' => $legendid,
             'class' => 'prompt h6 fw-normal visually-hidden',
         ]);
         $this->assertStringContainsString($standardinstruction, $this->currentoutput);
     }
 
+    /**
+     * Test that the group of choices is labelled by the question text, so that screen readers announce it.
+     *
+     * @covers \qtype_multichoice_renderer_base::formulation_and_controls
+     */
+    public function test_choices_group_is_labelled_by_question_text(): void {
+        $mc = \test_question_maker::make_a_multichoice_single_question();
+        $mc->showstandardinstruction = false;
+
+        $this->start_attempt_at_question($mc, 'deferredfeedback', 3);
+        $this->render();
+
+        $qa = $this->quba->get_question_attempt($this->slot);
+        $qtextid = $qa->get_outer_question_div_unique_id() . '-qtext';
+        $legendid = $qa->get_outer_question_div_unique_id() . '-legend';
+
+        // The question text has an id.
+        $this->assertStringContainsString('class="qtext" id="' . $qtextid . '"', $this->currentoutput);
+        // The legend has an id.
+        $this->assertStringContainsString('<legend id="' . $legendid . '"', $this->currentoutput);
+        // The fieldset is labelled by the question text first, and then the legend.
+        $this->assertStringContainsString('aria-labelledby="' . $qtextid . ' ' . $legendid . '"', $this->currentoutput);
+    }
+
 }
