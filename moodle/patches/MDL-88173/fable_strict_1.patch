@@ -304,8 +304,28 @@ final class walkthrough_test extends \qbehaviour_walkthrough_test_base {
         // Check for 'Show standard instruction'.
         $standardinstruction = \html_writer::tag('legend', get_string('answer'), [
             'class' => 'prompt h6 fw-normal visually-hidden',
+            'id' => $this->get_question_attempt()->get_outer_question_div_unique_id() . '-legend',
         ]);
         $this->assertStringContainsString($standardinstruction, $this->currentoutput);
     }
 
+    public function test_radio_group_is_labelled_by_question_text(): void {
+
+        // Create a multichoice, single question.
+        $mc = \test_question_maker::make_a_multichoice_single_question();
+
+        $this->start_attempt_at_question($mc, 'deferredfeedback', 3);
+        $this->render();
+
+        $uniqueid = $this->get_question_attempt()->get_outer_question_div_unique_id();
+        $qtextid = $uniqueid . '-qtext';
+        $legendid = $uniqueid . '-legend';
+
+        // The question text must have the id that the fieldset refers to.
+        $this->assertStringContainsString('id="' . $qtextid . '"', $this->currentoutput);
+        // The fieldset must be labelled by the question text as well as the legend.
+        $this->assertStringContainsString('aria-labelledby="' . $qtextid . ' ' . $legendid . '"', $this->currentoutput);
+        $this->assertStringContainsString('id="' . $legendid . '"', $this->currentoutput);
+    }
+
 }
