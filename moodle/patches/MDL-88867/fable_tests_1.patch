+    /**
+     * Test get_config returns the showlogoinappheader setting according to its value.
+     */
+    public function test_get_config_showlogoinappheader(): void {
+        $this->resetAfterTest(true);
+
+        // Disabled by default.
+        $result = external::get_config('mobileapp');
+        $result = external_api::clean_returnvalue(external::get_config_returns(), $result);
+        $settings = array_column($result['settings'], 'value', 'name');
+        $this->assertArrayHasKey('tool_mobile_showlogoinappheader', $settings);
+        $this->assertEquals(0, $settings['tool_mobile_showlogoinappheader']);
+
+        // Enable the setting.
+        set_config('showlogoinappheader', 1, 'tool_mobile');
+        $result = external::get_config('mobileapp');
+        $result = external_api::clean_returnvalue(external::get_config_returns(), $result);
+        $settings = array_column($result['settings'], 'value', 'name');
+        $this->assertEquals(1, $settings['tool_mobile_showlogoinappheader']);
+    }
+
