@@ -262,4 +262,26 @@ final class recalculate_test extends \advanced_testcase {
         $this->assertNotNull(recalculate::task_due_in($quizid1));
         $this->assertNull(recalculate::task_due_in($quizid2));
     }
+
+    /**
+     * task_due_in should ignore tasks that have exhausted their retries, and "recalculate now" should requeue them.
+     */
+    public function test_task_due_in_ignores_failed_tasks(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $this->mock_clock_with_frozen();
+        $quizid = $this->create_quiz_id();
+
+        recalculate::queue_future_run($quizid);
+        $this->assertNotNull(recalculate::task_due_in($quizid));
+
+        // Simulate the task having exhausted all of its retries.
+        $DB->set_field('task_adhoc', 'attemptsavailable', 0, ['component' => 'quiz_statistics']);
+        $DB->set_field('task_adhoc', 'nextruntime', 1, ['component' => 'quiz_statistics']);
+        $this->assertNull(recalculate::task_due_in($quizid));
+
+        // Requesting a recalculation now should make the task pending again.
+        recalculate::queue_future_run($quizid, true);
+        $this->assertSame(0, recalculate::task_due_in($quizid));
+    }
