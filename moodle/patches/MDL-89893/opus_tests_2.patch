@@ -135,12 +135,14 @@ class recalculate extends \core\task\adhoc_task {
     /**
      * Check if there is a pending task for a given quiz.
      *
+     * Tasks that have exhausted all their retries are not considered pending, as cron will not run them.
+     *
      * @param int $quizid
      * @return ?int Null for no task, or number of seconds until the task is scheduled to run.
      */
     public static function task_due_in(int $quizid): ?int {
         $task = self::instance($quizid);
-        $scheduledtask = manager::get_queued_adhoc_task_record($task);
+        $scheduledtask = manager::get_queued_adhoc_task_record($task, false);
         if (!$scheduledtask) {
             return null;
         }
diff --git a/public/mod/quiz/report/statistics/tests/recalculate_test.php b/public/mod/quiz/report/statistics/tests/recalculate_test.php
index 62de45e5f8d..c7c9e02a110 100644
--- a/public/mod/quiz/report/statistics/tests/recalculate_test.php
+++ b/public/mod/quiz/report/statistics/tests/recalculate_test.php
@@ -262,4 +262,31 @@ final class recalculate_test extends \advanced_testcase {
         $this->assertNotNull(recalculate::task_due_in($quizid1));
         $this->assertNull(recalculate::task_due_in($quizid2));
     }
+
+    /**
+     * task_due_in should return null when the only queued task has exhausted all its retries.
+     */
+    public function test_task_due_in_is_null_for_task_with_no_retries_left(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $this->mock_clock_with_frozen();
+        $quizid = $this->create_quiz_id();
+
+        recalculate::queue_future_run($quizid);
+        $this->assertNotNull(recalculate::task_due_in($quizid));
+
+        $taskrecord = manager::get_queued_adhoc_task_record(recalculate::instance($quizid));
+        $DB->update_record('task_adhoc', (object) [
+            'id' => $taskrecord->id,
+            'attemptsavailable' => 0,
+            'faildelay' => DAYSECS,
+            'nextruntime' => 1,
+        ]);
+
+        $this->assertNull(recalculate::task_due_in($quizid));
+
+        // Recalculating now should queue a task that is pending again.
+        recalculate::queue_future_run($quizid, true);
+        $this->assertSame(0, recalculate::task_due_in($quizid));
+    }
 }
