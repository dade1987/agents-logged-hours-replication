     }
 
+    /**
+     * Test that orphaned adhoc tasks whose class no longer exists do not block other tasks.
+     *
+     * @covers \core\task\manager::get_next_adhoc_task
+     */
+    public function test_get_next_adhoc_task_missing_class(): void {
+        global $DB;
+
+        $this->resetAfterTest(true);
+
+        $clock = $this->mock_clock_with_frozen();
+
+        // Queue a task, and then make it orphaned by pointing it at a class that does not exist.
+        $orphan = new adhoc_test_task();
+        $orphan->set_next_run_time($clock->time() - 10);
+        $orphanid = manager::queue_adhoc_task($orphan);
+        $DB->set_field('task_adhoc', 'classname', '\\mod_removedplugin\\task\\missing_task', ['id' => $orphanid]);
+        $DB->set_field('task_adhoc', 'component', 'mod_removedplugin', ['id' => $orphanid]);
+
+        // Queue a valid task.
+        $valid = new adhoc_test2_task();
+        $valid->set_next_run_time($clock->time() - 5);
+        manager::queue_adhoc_task($valid);
+
+        // The valid task should be returned, without an exception being thrown for the orphan.
+        $task = manager::get_next_adhoc_task($clock->time());
+        $this->assertInstanceOf(adhoc_test2_task::class, $task);
+        $task->execute();
+        manager::adhoc_task_complete($task);
+
+        // Only the orphan remains, and it is skipped.
+        $this->assertNull(manager::get_next_adhoc_task($clock->time()));
+        $this->resetDebugging();
+    }
+
     /**
      * Test adhoc task failure retry backoff.
      */
