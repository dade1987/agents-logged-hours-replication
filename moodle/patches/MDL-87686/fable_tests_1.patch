diff --git a/public/lib/tests/task/adhoc_task_test.php b/public/lib/tests/task/adhoc_task_test.php
index 11c0bffd5d0..a6868a49167 100644
--- a/public/lib/tests/task/adhoc_task_test.php
+++ b/public/lib/tests/task/adhoc_task_test.php
@@ -101,6 +101,45 @@ final class adhoc_task_test extends \advanced_testcase {
         manager::adhoc_task_complete($task);
     }
 
+    /**
+     * Test that an orphaned adhoc task (whose class no longer exists, e.g. after a plugin
+     * has been removed) does not block other adhoc tasks from being returned.
+     *
+     * @covers ::get_next_adhoc_task
+     */
+    public function test_get_next_adhoc_task_orphaned_class(): void {
+        global $DB;
+
+        $this->resetAfterTest(true);
+
+        $clock = $this->mock_clock_with_frozen();
+
+        // Queue a valid adhoc task.
+        $task = new adhoc_test_task();
+        manager::queue_adhoc_task($task);
+
+        // Insert an orphaned adhoc task for a class that does not exist.
+        $record = manager::record_from_adhoc_task($task);
+        $record->classname = '\\mod_removed\\task\\does_not_exist';
+        $record->component = 'mod_removed';
+        $DB->insert_record('task_adhoc', $record);
+
+        // The valid task must still be returned, with the orphaned task being skipped.
+        $next = manager::get_next_adhoc_task($clock->time());
+        $this->assertDebuggingCalled("Failed to load task: {$record->classname}");
+        $this->assertInstanceOf(adhoc_test_task::class, $next);
+        $next->execute();
+        manager::adhoc_task_complete($next);
+
+        // The orphaned task is still skipped when no other task is available, with no exception thrown.
+        $this->assertNull(manager::get_next_adhoc_task($clock->time()));
+        $this->resetDebugging();
+
+        // Same when concurrency limits are not checked.
+        $this->assertNull(manager::get_next_adhoc_task($clock->time(), false));
+        $this->resetDebugging();
+    }
+
