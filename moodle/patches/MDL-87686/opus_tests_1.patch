--- a/public/lib/tests/task/adhoc_task_test.php
+++ b/public/lib/tests/task/adhoc_task_test.php
@@ -75,6 +75,38 @@ final class adhoc_task_test extends \advanced_testcase {
         manager::adhoc_task_complete($task);
     }
 
+    /**
+     * Test that orphaned adhoc tasks (whose class no longer exists) do not block other tasks.
+     */
+    public function test_get_next_adhoc_task_with_missing_class(): void {
+        global $DB;
+
+        $this->resetAfterTest(true);
+
+        $clock = $this->mock_clock_with_frozen();
+
+        // Queue a valid adhoc task.
+        manager::queue_adhoc_task(new adhoc_test_task());
+
+        // Insert an orphaned adhoc task for a class which no longer exists (e.g. plugin removed).
+        $DB->insert_record('task_adhoc', (object) [
+            'component' => 'mod_removed',
+            'classname' => '\\mod_removed\\task\\orphaned_task',
+            'nextruntime' => $clock->time() - 1,
+            'faildelay' => 0,
+            'customdata' => '',
+            'blocking' => 0,
+            'timecreated' => $clock->time() - 1,
+        ]);
+
+        // The valid task should still be returned.
+        $task = manager::get_next_adhoc_task($clock->time());
+        $this->assertDebuggingCalled("Failed to load task: \\mod_removed\\task\\orphaned_task");
+        $this->assertInstanceOf(adhoc_test_task::class, $task);
+        $task->execute();
+        manager::adhoc_task_complete($task);
+    }
+
     /**
      * Test basic adhoc task execution.
      */
