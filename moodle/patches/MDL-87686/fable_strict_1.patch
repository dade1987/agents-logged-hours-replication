@@ -101,6 +101,45 @@ final class adhoc_task_test extends \advanced_testcase {
         manager::adhoc_task_complete($task);
     }
 
+    /**
+     * Test that an orphaned adhoc task (e.g. from a removed plugin) does not block the rest of the queue.
+     */
+    public function test_get_next_adhoc_task_orphaned_class(): void {
+        global $DB;
+
+        $this->resetAfterTest(true);
+
+        $clock = $this->mock_clock_with_frozen();
+
+        // Queue a valid adhoc task.
+        $task = new adhoc_test_task();
+        manager::queue_adhoc_task($task);
+
+        // Insert an orphaned adhoc task whose class no longer exists (plugin removed).
+        $record = new \stdClass();
+        $record->classname = '\\mod_removed\\task\\does_not_exist';
+        $record->component = 'mod_removed';
+        $record->nextruntime = $clock->time() - 1;
+        $record->faildelay = 0;
+        $record->customdata = null;
+        $record->userid = null;
+        $record->timecreated = $clock->time();
+        $DB->insert_record('task_adhoc', $record);
+
+        // The valid task must still be returned, and the orphaned task must only emit debugging output.
+        $task = manager::get_next_adhoc_task($clock->time());
+        $this->assertNotEmpty($this->getDebuggingMessages());
+        $this->resetDebugging();
+        $this->assertInstanceOf('\\core\\task\\adhoc_test_task', $task);
+        $task->execute();
+        manager::adhoc_task_complete($task);
+
+        // The orphaned task is skipped and nothing else is returned.
+        $this->assertNull(manager::get_next_adhoc_task($clock->time()));
+        $this->assertNotEmpty($this->getDebuggingMessages());
+        $this->resetDebugging();
+    }
+
     /**
      * Test adhoc task failure retry backoff.
      */
