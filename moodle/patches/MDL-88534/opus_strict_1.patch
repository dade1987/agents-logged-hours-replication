+
+    /**
+     * The recalculation delay should be configurable.
+     *
+     * @return void
+     */
+    public function test_queue_task_with_configured_delay(): void {
+        [$user, $quiz] = $this->create_test_data();
+        set_config('recalculationdelay', WEEKSECS, 'quiz_statistics');
+        $this->assertEquals(WEEKSECS, recalculate::get_delay());
+
+        $this->attempt_quiz($quiz, $user);
+
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $this->assertEqualsWithDelta(time() + WEEKSECS, $task->get_next_run_time(), 1);
+    }
+
+    /**
+     * Without a configured value, the default delay is used.
+     *
+     * @return void
+     */
+    public function test_default_delay(): void {
+        $this->resetAfterTest();
+        unset_config('recalculationdelay', 'quiz_statistics');
+        $this->assertEquals(recalculate::DELAY, recalculate::get_delay());
+    }
+
+    /**
+     * Queueing a recalculation when one is already pending should push the pending one back (de-bounce).
+     *
+     * @return void
+     */
+    public function test_queue_future_run_debounces(): void {
+        global $DB;
+        [, $quiz] = $this->create_test_data();
+
+        $this->assertTrue(recalculate::queue_future_run($quiz->id));
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+
+        // Pretend the task was queued a while ago.
+        $DB->set_field('task_adhoc', 'nextruntime', time() + 10, ['id' => $task->get_id()]);
+
+        $this->assertFalse(recalculate::queue_future_run($quiz->id));
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
