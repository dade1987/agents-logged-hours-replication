         $this->assert_task_is_queued_for_quiz($task, $quiz);
     }
 
+    /**
+     * Each new submission pushes the scheduled run time of an already-queued task back (de-bounce).
+     *
+     * @return void
+     */
+    public function test_queue_task_is_debounced_on_submission(): void {
+        global $DB;
+        [$user1, $quiz] = $this->create_test_data();
+        $user2 = $this->getDataGenerator()->create_user();
+
+        $this->attempt_quiz($quiz, $user1);
+
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $this->assert_task_is_queued_for_quiz($task, $quiz);
+
+        // Pretend the task was queued some time ago, so it is now due much sooner than the configured delay.
+        $DB->set_field('task_adhoc', 'nextruntime', time() + 10, ['id' => $task->get_id()]);
+
+        $this->attempt_quiz($quiz, $user2);
+
+        // Still only one task, but its run time has been pushed back by the full delay again.
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $this->assert_task_is_queued_for_quiz($task, $quiz);
+    }
+
+    /**
+     * The delay before recalculating is taken from the recalculatedelay setting.
+     *
+     * @return void
+     */
+    public function test_queue_task_uses_configured_delay(): void {
+        [$user, $quiz] = $this->create_test_data();
+
+        set_config('recalculatedelay', WEEKSECS, 'quiz_statistics');
+        $this->assertEquals(WEEKSECS, recalculate::get_delay());
+
+        $this->attempt_quiz($quiz, $user);
+
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $this->assertEqualsWithDelta(time() + WEEKSECS, $task->get_next_run_time(), 1);
+
+        // An unset or invalid setting falls back to the default delay.
+        unset_config('recalculatedelay', 'quiz_statistics');
+        $this->assertEquals(recalculate::DELAY, recalculate::get_delay());
+        set_config('recalculatedelay', 'notanumber', 'quiz_statistics');
+        $this->assertEquals(recalculate::DELAY, recalculate::get_delay());
+    }
+
     /**
      * Attempting different quizzes will queue a task for each.
      *
