 class recalculate extends \core\task\adhoc_task {
     /**
-     * The time to delay queued runs by, to prevent repeated recalculations.
+     * The default time to delay queued runs by, to prevent repeated recalculations.
+     *
+     * The actual delay used is the quiz_statistics/recalculatedelay admin setting, see {@see self::get_delay()}.
      */
     const DELAY = HOURSECS;
 
+    /**
+     * Get the configured delay (in seconds) to wait after the last change before recalculating statistics.
+     *
+     * This is read from the quiz_statistics/recalculatedelay setting, falling back to {@see self::DELAY}
+     * if the setting is not set or invalid.
+     *
+     * @return int number of seconds.
+     */
+    public static function get_delay(): int {
+        $delay = get_config('quiz_statistics', 'recalculatedelay');
+        if ($delay === false || $delay === null || $delay === '' || !is_numeric($delay) || (int) $delay < 0) {
+            return self::DELAY;
+        }
+        return (int) $delay;
+    }
+
     /**
      * Create a new instance of the task.
      *
@@ -103,15 +121,33 @@ class recalculate extends \core\task\adhoc_task {
      * Queue an instance of this task to happen after a delay.
      *
      * Multiple events may happen over a short period that require a recalculation. Rather than
-     * run the recalculation each time, this will queue a single run of the task for a given quiz,
-     * within the delay period.
+     * run the recalculation each time, this will queue a single run of the task for a given quiz.
+     * The run is de-bounced: each time this is called, the next run time of the queued task is
+     * pushed back by the configured delay (quiz_statistics/recalculatedelay), so the recalculation
+     * only happens once the stream of changes to the quiz has stopped for the delay period.
      *
      * @param int $quizid The quiz to run the recalculation for.
-     * @return bool true of the task was queued.
+     * @return bool true if the task was queued or rescheduled.
      */
     public static function queue_future_run(int $quizid): bool {
         $task = self::instance($quizid);
-        $task->set_next_run_time(time() + self::DELAY);
-        return \core\task\manager::queue_adhoc_task($task, true);
+        $task->set_next_run_time(time() + self::get_delay());
+        \core\task\manager::reschedule_or_queue_adhoc_task($task);
+        return true;
+    }
+
+    /**
+     * Queue an instance of this task to run as soon as possible.
+     *
+     * If a delayed run is already queued for this quiz, it is brought forward to run immediately.
+     *
+     * @param int $quizid The quiz to run the recalculation for.
+     * @return bool true if the task was queued or rescheduled.
+     */
+    public static function queue_immediate_run(int $quizid): bool {
+        $task = self::instance($quizid);
+        $task->set_next_run_time(time() - 1);
+        \core\task\manager::reschedule_or_queue_adhoc_task($task);
+        return true;
     }
 }
