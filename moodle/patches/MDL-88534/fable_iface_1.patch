+    public static function task_due_in(int $quizid): ?int {
+        $task = self::instance($quizid);
+        $record = \core\task\manager::get_queued_adhoc_task_record($task);
+        if (!$record) {
+            return null;
+        }
+        $time = \core\di::get(\core\clock::class)->time();
+        return max(0, (int) $record->nextruntime - $time);
     }
 }
