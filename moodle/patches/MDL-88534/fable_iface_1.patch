+namespace quiz_statistics\task;
+
+use core\task\manager;
+
+/**
+ * Unit tests for the recalculate ad-hoc task queuing.
+ *
+ * @package   quiz_statistics
+ * @copyright 2026 onwards Catalyst IT
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \quiz_statistics\task\recalculate
+ */
+final class recalculate_test extends \advanced_testcase {
+    /**
+     * Queuing a run uses the configured delay.
+     */
+    public function test_queue_future_run_uses_configured_delay(): void {
+        $this->resetAfterTest();
+        set_config('recalculatedelay', DAYSECS, 'quiz_statistics');
+
+        $this->assertNull(recalculate::task_due_in(1));
+
+        recalculate::queue_future_run(1);
+
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $this->assertEquals(1, $task->get_custom_data()->quizid);
+        $this->assertEqualsWithDelta(time() + DAYSECS, $task->get_next_run_time(), 1);
+        $this->assertEqualsWithDelta(DAYSECS, recalculate::task_due_in(1), 1);
+    }
+
+    /**
+     * The default delay is used when the setting is not set.
+     */
+    public function test_queue_future_run_default_delay(): void {
+        $this->resetAfterTest();
+        unset_config('recalculatedelay', 'quiz_statistics');
+
+        recalculate::queue_future_run(1);
+
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $this->assertEqualsWithDelta(time() + recalculate::DELAY, $task->get_next_run_time(), 1);
+    }
+
+    /**
+     * Queuing repeatedly de-bounces: a single task is kept, and its run time is pushed back.
+     */
+    public function test_queue_future_run_debounce(): void {
+        $this->resetAfterTest();
+        set_config('recalculatedelay', HOURSECS, 'quiz_statistics');
+
+        $clock = $this->mock_clock_with_frozen();
+
+        recalculate::queue_future_run(1);
+        $this->assertEquals(HOURSECS, recalculate::task_due_in(1));
+
+        $clock->bump(MINSECS * 30);
+        $this->assertEquals(HOURSECS - MINSECS * 30, recalculate::task_due_in(1));
+
+        recalculate::queue_future_run(1);
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $this->assertEquals(HOURSECS, recalculate::task_due_in(1));
+
+        // A different quiz gets its own task.
+        recalculate::queue_future_run(2);
+        $this->assertCount(2, manager::get_adhoc_tasks(recalculate::class));
+        $this->assertEquals(HOURSECS, recalculate::task_due_in(2));
+    }
+
+    /**
+     * Queuing with $now brings an existing task forward, and a later delayed queue does not push it back out.
+     */
+    public function test_queue_future_run_now(): void {
+        $this->resetAfterTest();
+        set_config('recalculatedelay', WEEKSECS, 'quiz_statistics');
+        $this->mock_clock_with_frozen();
+
+        recalculate::queue_future_run(1);
+        $this->assertEquals(WEEKSECS, recalculate::task_due_in(1));
+
+        recalculate::queue_future_run(1, true);
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $this->assertEquals(0, recalculate::task_due_in(1));
+
+        // Queuing now when nothing is queued also works.
+        recalculate::queue_future_run(2, true);
+        $this->assertEquals(0, recalculate::task_due_in(2));
+    }
+}
