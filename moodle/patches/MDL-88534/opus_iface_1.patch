diff --git a/public/mod/quiz/report/statistics/tests/task/recalculate_test.php b/public/mod/quiz/report/statistics/tests/task/recalculate_test.php
new file mode 100644
index 00000000000..78eced22a8f
--- /dev/null
+++ b/public/mod/quiz/report/statistics/tests/task/recalculate_test.php
@@ -0,0 +1,74 @@
+<?php
