+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace quiz_statistics\task;
+
+use core\task\manager;
+
+/**
+ * Tests for the recalculate task queueing (configurable de-bounce).
+ *
+ * @package    quiz_statistics
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \quiz_statistics\task\recalculate
+ */
+final class recalculate_test extends \advanced_testcase {
+    public function test_task_due_in_none_queued(): void {
+        $this->resetAfterTest();
+        $this->assertNull(recalculate::task_due_in(123));
+    }
+
+    public function test_queue_future_run_default_delay(): void {
+        $this->resetAfterTest();
+        recalculate::queue_future_run(5);
+        $this->assertCount(1, manager::get_adhoc_tasks(recalculate::class));
+        $this->assertEqualsWithDelta(HOURSECS, recalculate::task_due_in(5), 2);
+    }
+
+    public function test_queue_future_run_configured_delay_and_debounce(): void {
+        global $DB;
+        $this->resetAfterTest();
+        set_config('recalculatedelay', WEEKSECS, 'quiz_statistics');
+
+        recalculate::queue_future_run(5);
+        $this->assertEqualsWithDelta(WEEKSECS, recalculate::task_due_in(5), 2);
+
+        // Simulate time passing by moving the queued task closer.
+        $DB->set_field('task_adhoc', 'nextruntime', time() + DAYSECS, ['classname' => '\\' . recalculate::class]);
+        $this->assertEqualsWithDelta(DAYSECS, recalculate::task_due_in(5), 2);
+
+        // A further request pushes the run time back (de-bounce), without queueing another task.
+        recalculate::queue_future_run(5);
+        $this->assertCount(1, manager::get_adhoc_tasks(recalculate::class));
+        $this->assertEqualsWithDelta(WEEKSECS, recalculate::task_due_in(5), 2);
+
+        // Other quizzes are independent.
+        $this->assertNull(recalculate::task_due_in(6));
+    }
+
+    public function test_queue_future_run_now(): void {
+        $this->resetAfterTest();
+        recalculate::queue_future_run(5);
+        recalculate::queue_future_run(5, true);
+        $this->assertCount(1, manager::get_adhoc_tasks(recalculate::class));
+        $this->assertEquals(0, recalculate::task_due_in(5));
+
+        // A subsequent delayed request does not postpone an imminent run.
+        recalculate::queue_future_run(5);
+        $this->assertEquals(0, recalculate::task_due_in(5));
+    }
+}
