diff --git a/public/mod/quiz/report/statistics/tests/quiz_attempt_submitted_test.php b/public/mod/quiz/report/statistics/tests/quiz_attempt_submitted_test.php
index a2933c36e46..c73edc2736e 100644
--- a/public/mod/quiz/report/statistics/tests/quiz_attempt_submitted_test.php
+++ b/public/mod/quiz/report/statistics/tests/quiz_attempt_submitted_test.php
@@ -133,4 +133,49 @@ final class quiz_attempt_submitted_test extends \advanced_testcase {
         $task2 = array_shift($tasks);
         $this->assert_task_is_queued_for_quiz($task2, $quiz2);
     }
+
+    /**
+     * The recalculation delay should be configurable.
+     *
+     * @covers \quiz_statistics\task\recalculate::queue_future_run
+     * @return void
+     */
+    public function test_queue_task_uses_configured_delay(): void {
+        [$user, $quiz] = $this->create_test_data();
+        set_config('recalculatedelay', WEEKSECS, 'quiz_statistics');
+        $this->assertEquals(WEEKSECS, recalculate::get_delay());
+
+        $this->attempt_quiz($quiz, $user);
+
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $this->assertEqualsWithDelta(time() + WEEKSECS, $task->get_next_run_time(), 1);
+    }
+
+    /**
+     * Further submissions should push back (de-bounce) the already queued task.
+     *
+     * @covers \quiz_statistics\task\recalculate::queue_future_run
+     * @return void
+     */
+    public function test_queue_task_is_debounced(): void {
+        global $DB;
+        [$user1, $quiz] = $this->create_test_data();
+        $user2 = $this->getDataGenerator()->create_user();
+
+        $this->attempt_quiz($quiz, $user1);
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+
+        // Simulate the task having been queued a while ago.
+        $DB->set_field('task_adhoc', 'nextruntime', time() + 60, ['id' => $task->get_id()]);
+
+        $this->attempt_quiz($quiz, $user2);
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $this->assert_task_is_queued_for_quiz($task, $quiz);
+    }
 }
