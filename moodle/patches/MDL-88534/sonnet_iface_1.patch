diff --git a/public/mod/quiz/report/statistics/classes/task/recalculate.php b/public/mod/quiz/report/statistics/classes/task/recalculate.php
index 5d4f3c5a214..cc2e92aa23a 100644
--- a/public/mod/quiz/report/statistics/classes/task/recalculate.php
+++ b/public/mod/quiz/report/statistics/classes/task/recalculate.php
@@ -100,18 +100,45 @@ class recalculate extends \core\task\adhoc_task {
     }
 
     /**
-     * Queue an instance of this task to happen after a delay.
+     * Queue (or re-schedule) a run of this task, de-bouncing repeated requests.
      *
      * Multiple events may happen over a short period that require a recalculation. Rather than
-     * run the recalculation each time, this will queue a single run of the task for a given quiz,
-     * within the delay period.
+     * run the recalculation each time, a single task is kept for a given quiz, and each call pushes
+     * its run time back by the configured delay, so it only runs once activity has stopped.
      *
      * @param int $quizid The quiz to run the recalculation for.
-     * @return bool true of the task was queued.
+     * @param bool $now If true, run as soon as possible rather than after the configured delay.
      */
-    public static function queue_future_run(int $quizid): bool {
+    public static function queue_future_run(int $quizid, bool $now = false): void {
         $task = self::instance($quizid);
-        $task->set_next_run_time(time() + self::DELAY);
-        return \core\task\manager::queue_adhoc_task($task, true);
+        $task->set_next_run_time(time() + ($now ? 0 : self::get_delay()));
+        \core\task\manager::reschedule_or_queue_adhoc_task($task);
+    }
+
+    /**
+     * Get the configured delay, in seconds.
+     *
+     * @return int
+     */
+    public static function get_delay(): int {
+        $delay = get_config('quiz_statistics', 'recalculatedelay');
+        if ($delay === false || $delay === null || $delay === '') {
+            return self::DELAY;
+        }
+        return max(0, (int) $delay);
+    }
+
+    /**
+     * Get the number of seconds until the queued task for a quiz is due.
+     *
+     * @param int $quizid
+     * @return int|null Seconds until due (0 if overdue), or null if no task is queued.
+     */
+    public static function task_due_in(int $quizid): ?int {
+        $record = \core\task\manager::get_queued_adhoc_task_record(self::instance($quizid));
+        if (!$record) {
+            return null;
+        }
+        return max(0, (int) $record->nextruntime - time());
     }
 }
