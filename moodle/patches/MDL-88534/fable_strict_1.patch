+    public function test_queue_task_is_debounced_on_further_submissions(): void {
+        [$user1, $quiz] = $this->create_test_data();
+        $user2 = $this->getDataGenerator()->create_user();
+        $clock = $this->mock_clock_with_frozen();
+
+        $this->attempt_quiz($quiz, $user1);
+
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $firstruntime = $task->get_next_run_time();
+        $this->assertEquals($clock->time() + recalculate::get_delay(), $firstruntime);
+
+        // Time passes, but not enough for the task to run.
+        $clock->bump(MINSECS * 30);
+        $this->attempt_quiz($quiz, $user2);
+
+        $tasks = manager::get_adhoc_tasks(recalculate::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $this->assert_task_is_queued_for_quiz($task, $quiz);
+        $this->assertEquals($firstruntime + MINSECS * 30, $task->get_next_run_time());
