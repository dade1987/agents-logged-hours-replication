+    /**
+     * Calculate the mark deducted from the final grade.
+     *
+     * Penalties are applied to the raw grade. The final grade is then calculated from the raw grade by the gradebook,
+     * applying the grade item multiplicator and offset (and bounding the result), so the deducted mark shown next
+     * to the final grade must be expressed in the same scale as the final grade.
+     *
+     * @param penalty_container $container The penalty container.
+     * @return float The mark deducted from the final grade.
+     */
+    private static function calculate_deducted_final_mark(penalty_container $container): float {
+        if ($container->get_penalty() <= 0) {
+            return 0.0;
+        }
+
+        $gradeitem = $container->get_grade_item();
+        $gradegrade = $container->get_grade_grade();
+        $rawmin = $gradegrade->rawgrademin ?? $gradeitem->grademin;
+        $rawmax = $gradegrade->rawgrademax ?? $gradeitem->grademax;
+
+        $finalbefore = $gradeitem->adjust_raw_grade($container->get_grade_before_penalties(), $rawmin, $rawmax);
+        $finalafter = $gradeitem->adjust_raw_grade($container->get_grade_after_penalties(), $rawmin, $rawmax);
+
+        if ($finalbefore === null || $finalafter === null) {
+            return $container->get_penalty();
+        }
+
+        return max(0.0, (float) $finalbefore - (float) $finalafter);
+    }
+
