diff --git a/public/grade/tests/penalty_manager_test.php b/public/grade/tests/penalty_manager_test.php
index 6e11988a069..fb3a0dc0c90 100644
--- a/public/grade/tests/penalty_manager_test.php
+++ b/public/grade/tests/penalty_manager_test.php
@@ -103,4 +103,42 @@ final class penalty_manager_test extends advanced_testcase {
         // No penalty by default.
         $this->assertEquals(90, $container->get_grade_after_penalties());
     }
+
+    /**
+     * Test that grade item factors (multiplicator and offset) are applied only once when applying penalties.
+     */
+    public function test_apply_grade_penalty_to_user_with_grade_item_factors(): void {
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        penalty_manager::enable_module('assign');
+
+        $user = $this->getDataGenerator()->create_user();
+        $course = $this->getDataGenerator()->create_course();
+        $assign = $this->getDataGenerator()->create_module('assign', ['course' => $course->id]);
+
+        $gradeitem = grade_item::fetch([
+            'courseid' => $course->id,
+            'itemtype' => 'mod',
+            'itemmodule' => 'assign',
+            'iteminstance' => $assign->id,
+            'itemnumber' => 0,
+        ]);
+        $gradeitem->multfactor = 1.5;
+        $gradeitem->plusfactor = 1;
+        $gradeitem->update();
+
+        grade_update('mod/assign', $course->id, 'mod', 'assign', $assign->id, 0, ['userid' => $user->id, 'rawgrade' => 5]);
+        $this->assertEquals(8.5, $gradeitem->get_final($user->id)->finalgrade);
+
+        $this->assertEquals(8.5, penalty_manager::apply_grade_item_factors(5, $gradeitem));
+        $this->assertEquals(8.5, penalty_manager::apply_grade_item_factors(5, $gradeitem, $gradeitem->get_grade($user->id, false)));
+
+        // No penalty: the final grade must not change.
+        penalty_manager::apply_grade_penalty_to_user($user->id, $gradeitem, time(), time());
+        $grade = $gradeitem->get_final($user->id);
+        $this->assertEquals(5, $grade->rawgrade);
+        $this->assertEquals(8.5, $grade->finalgrade);
+        $this->assertEquals(0, $grade->deductedmark);
+    }
 }
