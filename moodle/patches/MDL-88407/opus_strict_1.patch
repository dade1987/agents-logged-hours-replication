     /**
      * Get the grade before penalties are applied.
      *
+     * This is the raw grade, as the penalised grade is saved back as the raw grade of the grade item.
+     * Using the final grade would cause grade item adjustments (such as multiplicator and offset)
+     * to be applied twice.
+     *
      * @return float The grade before penalties are applied
      */
     public function get_grade_before_penalties(): float {
-        return $this->gradegrade->finalgrade;
+        return (float) $this->gradegrade->rawgrade;
     }
 
