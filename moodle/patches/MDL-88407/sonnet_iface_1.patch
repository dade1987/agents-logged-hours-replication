+    /**
+     * Apply the grade item factors (multiplicator and offset) to a raw grade.
+     *
+     * @param float $rawgrade The raw grade.
+     * @param grade_item $gradeitem The grade item.
+     * @param grade_grade|null $usergrade The user grade, used to get the raw grade range if available.
+     * @return float|null The grade after the factors are applied, or null if it cannot be calculated.
+     */
+    public static function apply_grade_item_factors(
+        float $rawgrade,
+        grade_item $gradeitem,
+        ?grade_grade $usergrade = null,
+    ): ?float {
+        if ($usergrade !== null && isset($usergrade->rawgrademin) && isset($usergrade->rawgrademax)) {
+            $rawmin = $usergrade->rawgrademin;
+            $rawmax = $usergrade->rawgrademax;
+        } else {
+            $rawmin = $gradeitem->grademin;
+            $rawmax = $gradeitem->grademax;
+        }
+        return $gradeitem->adjust_raw_grade($rawgrade, $rawmin, $rawmax);
+    }
+
+    /**
+     * Reverse the grade item factors (multiplicator and offset) so the result can be passed to update_raw_grade().
+     *
+     * @param float $finalgrade The final grade.
+     * @param grade_item $gradeitem The grade item.
+     * @return float The raw grade.
+     */
+    private static function remove_grade_item_factors(float $finalgrade, grade_item $gradeitem): float {
+        if ($gradeitem->gradetype != GRADE_TYPE_VALUE) {
+            return $finalgrade;
+        }
+        $mult = (float) $gradeitem->multfactor;
+        if ($mult == 0.0) {
+            return $finalgrade;
+        }
+        return ($finalgrade - (float) $gradeitem->plusfactor) / $mult;
+    }
+
