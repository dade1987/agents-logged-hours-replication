+    /**
+     * Test that grade item factors (multiplicator and offset) are only applied once when penalty is enabled.
+     *
+     * @covers \mod_assign\penalty\helper::apply_penalty_to_submission
+     * @covers \core_grades\penalty_manager::apply_grade_item_factors
+     * @covers \assign::calculate_penalised_grade
+     */
+    public function test_apply_penalty_with_grade_item_factors(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        [$course, $student] = $this->set_up_test();
+
+        // Assignment.
+        $duedate = time() + DAYSECS;
+        $generator = $this->getDataGenerator();
+        $assignmentgenerator = $generator->get_plugin_generator('mod_assign');
+        $instance = $assignmentgenerator->create_instance([
+            'course' => $course->id,
+            'duedate' => $duedate,
+            'assignsubmission_onlinetext_enabled' => 1,
+            'gradepenalty' => 1,
+            'grade' => 100,
+        ]);
+        $cm = get_coursemodule_from_instance('assign', $instance->id);
+        $context = \context_module::instance($cm->id);
+        $assign = new mod_assign_testable_assign($context, $cm, $course);
+
+        // Set a multiplicator and offset on the grade item.
+        $gradeitem = grade_item::fetch([
+            'courseid' => $course->id,
+            'itemtype' => 'mod',
+            'itemmodule' => 'assign',
+            'iteminstance' => $instance->id,
+            'itemnumber' => 0,
+        ]);
+        $gradeitem->multfactor = 1.5;
+        $gradeitem->plusfactor = 2;
+        $gradeitem->update();
+
+        // Submit on time and grade.
+        $this->add_submission($student, $assign, 'Sample text');
+        $this->submit_for_grading($student, $assign);
+        $DB->set_field('assign_submission', 'timemodified', $duedate - HOURSECS, ['userid' => $student->id]);
+        $assign->testable_apply_grade_to_user((object)['grade' => 5.0], $student->id, 0);
+        $this->assertdebuggingcalledcount(2);
+
+        // No penalty: the factors must be applied exactly once. 5 * 1.5 + 2 = 9.5.
+        $gradeitem = grade_item::fetch(['id' => $gradeitem->id]);
+        $usergrade = $gradeitem->get_final($student->id);
+        $this->assertEquals(5, $usergrade->rawgrade);
+        $this->assertEquals(9.5, $usergrade->finalgrade);
+        $this->assertEquals(0, $usergrade->deductedmark);
+
+        // The assignment displays the same grade as the gradebook.
+        $assigngrade = $assign->get_user_grade($student->id, false);
+        [$penalisedgrade, $deductedmark] = $assign->calculate_penalised_grade($assigngrade, $gradeitem->get_grade($student->id));
+        $this->assertEquals(9.5, $penalisedgrade);
+        $this->assertEquals(0, $deductedmark);
+
+        // Submit late and grade: 10% of max grade (10 marks) is deducted from the raw grade.
+        $DB->set_field('assign_submission', 'timemodified', $duedate + HOURSECS, ['userid' => $student->id]);
+        $assign->testable_apply_grade_to_user((object)['grade' => 50.0], $student->id, 0);
+        $this->assertdebuggingcalledcount(2);
+
+        // (50 - 10) * 1.5 + 2 = 62.
+        $usergrade = $gradeitem->get_final($student->id);
+        $this->assertEquals(40, $usergrade->rawgrade);
+        $this->assertEquals(62, $usergrade->finalgrade);
+        $this->assertEquals(10, $usergrade->deductedmark);
+
+        $assigngrade = $assign->get_user_grade($student->id, false);
+        [$penalisedgrade, $deductedmark] = $assign->calculate_penalised_grade($assigngrade, $gradeitem->get_grade($student->id));
+        $this->assertEquals(62, $penalisedgrade);
+        $this->assertEquals(10, $deductedmark);
+    }
 }
