+    /**
+     * Apply the grade item factors (multiplicator and offset) to a raw grade.
+     *
+     * Penalties are calculated and deducted on the raw grade reported by the activity. The gradebook then
+     * applies the grade item factors when it converts the raw grade to the final grade. Activities that need
+     * to display a penalised grade which is consistent with the gradebook final grade should use this method
+     * to apply the same factors to their penalised raw grade.
+     *
+     * @param float $rawgrade The raw (penalised) grade.
+     * @param grade_item $gradeitem The grade item.
+     * @param grade_grade|null $usergrade The user grade record, if available. It is used to get the raw grade range.
+     * @return float|null The grade with the grade item factors applied, or null if it cannot be calculated.
+     */
+    public static function apply_grade_item_factors(
+        float $rawgrade,
+        grade_item $gradeitem,
+        ?grade_grade $usergrade = null,
+    ): ?float {
+        $rawmin = $gradeitem->grademin;
+        $rawmax = $gradeitem->grademax;
+
+        if ($usergrade !== null) {
+            if (isset($usergrade->rawgrademin)) {
+                $rawmin = $usergrade->rawgrademin;
+            }
+            if (isset($usergrade->rawgrademax)) {
+                $rawmax = $usergrade->rawgrademax;
+            }
+        }
+
+        $result = $gradeitem->adjust_raw_grade($rawgrade, $rawmin, $rawmax);
+
+        return is_null($result) ? null : (float) $result;
+    }
