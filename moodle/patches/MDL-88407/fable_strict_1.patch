@@ -104,10 +104,14 @@ final class penalty_container {
     /**
      * Get the grade before penalties are applied.
      *
+     * This is the raw grade of the user, i.e. the grade as reported by the activity module before any
+     * gradebook adjustments (multiplicator, offset, ...) are applied. The penalised grade is written back as the
+     * raw grade, so the gradebook will apply the multiplicator and offset exactly once when computing the final grade.
+     *
      * @return float The grade before penalties are applied
      */
     public function get_grade_before_penalties(): float {
-        return $this->gradegrade->finalgrade;
+        return (float) ($this->gradegrade->rawgrade ?? 0);
     }
 
     /**
