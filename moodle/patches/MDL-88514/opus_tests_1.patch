+    /**
+     * Test that user and group overrides are taken into account by submissions_open,
+     * even when the check is made by someone other than the student (e.g. a teacher).
+     *
+     * @covers \assign::submissions_open
+     */
+    public function test_submissions_open_with_overrides(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course();
+        $teacher = $this->getDataGenerator()->create_and_enrol($course, 'editingteacher');
+        $student = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $groupstudent = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $nocutoffstudent = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $earlystudent = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $otherstudent = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $group = $this->getDataGenerator()->create_group(['courseid' => $course->id]);
+        groups_add_member($group, $groupstudent);
+
+        $now = time();
+        $tomorrow = $now + DAYSECS;
+        $yesterday = $now - DAYSECS;
+        $twodaysago = $now - 2 * DAYSECS;
+        $nextweek = $now + WEEKSECS;
+
+        $this->setAdminUser();
+        $assign = $this->create_instance($course, ['duedate' => $twodaysago, 'cutoffdate' => $yesterday]);
+        $assignid = $assign->get_instance()->id;
+        $base = [
+            'assignid' => $assignid,
+            'userid' => null,
+            'groupid' => null,
+            'sortorder' => null,
+            'allowsubmissionsfromdate' => null,
+            'duedate' => null,
+            'cutoffdate' => null,
+            'timelimit' => null,
+        ];
+        $DB->insert_record('assign_overrides', (object) array_merge($base,
+            ['userid' => $student->id, 'cutoffdate' => $tomorrow]));
+        $DB->insert_record('assign_overrides', (object) array_merge($base,
+            ['groupid' => $group->id, 'sortorder' => 1, 'cutoffdate' => $tomorrow]));
+        $DB->insert_record('assign_overrides', (object) array_merge($base,
+            ['userid' => $nocutoffstudent->id, 'cutoffdate' => 0]));
+
+        $this->setUser($teacher);
+        $assign = new mod_assign_testable_assign($assign->get_context(), $assign->get_course_module(), $course);
+        $this->assertTrue($assign->testable_submissions_open($student->id));
+        $this->assertTrue($assign->testable_submissions_open($groupstudent->id));
+        $this->assertTrue($assign->testable_submissions_open($nocutoffstudent->id));
+        $this->assertFalse($assign->testable_submissions_open($otherstudent->id));
+
+        // An override can also close submissions earlier for a given user.
+        $this->setAdminUser();
+        $assign = $this->create_instance($course, ['duedate' => $tomorrow, 'cutoffdate' => $nextweek]);
+        $DB->insert_record('assign_overrides', (object) array_merge($base,
+            ['assignid' => $assign->get_instance()->id, 'userid' => $earlystudent->id,
+                'duedate' => $twodaysago, 'cutoffdate' => $yesterday]));
+        $this->setUser($teacher);
+        $assign = new mod_assign_testable_assign($assign->get_context(), $assign->get_course_module(), $course);
+        $this->assertFalse($assign->testable_submissions_open($earlystudent->id));
+        $this->assertTrue($assign->testable_submissions_open($otherstudent->id));
+    }
