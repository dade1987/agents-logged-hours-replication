+namespace mod_bigbluebuttonbn;
+
+use advanced_testcase;
+
+/**
+ * Tests for mod_bigbluebuttonbn\settings.
+ *
+ * @package   mod_bigbluebuttonbn
+ * @copyright 2025 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \mod_bigbluebuttonbn\settings
+ */
+final class settings_test extends advanced_testcase {
+    /**
+     * Default list of recording formats.
+     */
+    public function test_get_recording_formats_options_default(): void {
+        $this->resetAfterTest();
+        unset_config('bigbluebuttonbn_recording_formats');
+        set_config('bigbluebuttonbn_recording_safe_formats', 'video,presentation');
+        $options = settings::get_recording_formats_options();
+        $this->assertEquals(
+            ['notes', 'podcast', 'presentation', 'screenshare', 'statistics', 'video'],
+            array_keys($options)
+        );
+        $this->assertEquals('Presentation', $options['presentation']);
+    }
+
+    /**
+     * Extended list of recording formats, including selected safe formats not in the list.
+     */
+    public function test_get_recording_formats_options_extended(): void {
+        $this->resetAfterTest();
+        set_config('bigbluebuttonbn_recording_formats', ' presentation, video ,transcript,,video');
+        set_config('bigbluebuttonbn_recording_safe_formats', 'video,customformat');
+        $options = settings::get_recording_formats_options();
+        $this->assertEquals(['customformat', 'presentation', 'transcript', 'video'], array_keys($options));
+        $this->assertEquals('Transcript', $options['transcript']);
+    }
+}
