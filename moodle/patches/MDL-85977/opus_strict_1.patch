+    /**
+     * Get the list of recording formats that can be selected as safe formats.
+     *
+     * The list is built from the configurable list of available recording formats (bigbluebuttonbn_recording_formats),
+     * to which the currently selected safe formats are added, so they are never lost.
+     *
+     * @return array associative array of format => display name
+     */
+    public static function get_recording_formats_options(): array {
+        $formats = self::parse_formats_list(config::get('recording_formats'));
+        $safeformats = self::parse_formats_list(config::get('recording_safe_formats'));
+        $formats = array_unique(array_merge($formats, $safeformats));
+        $options = [];
+        foreach ($formats as $format) {
+            $options[$format] = \mod_bigbluebuttonbn\local\bigbluebutton\recordings\recording_data::type_text($format);
+        }
+        ksort($options);
+        return $options;
+    }
+
+    /**
+     * Parse a comma separated list of formats into an array of clean format names.
+     *
+     * @param string $formatlist
+     * @return array
+     */
+    protected static function parse_formats_list(string $formatlist): array {
+        $formats = [];
+        foreach (explode(',', $formatlist) as $format) {
+            $format = clean_param(trim($format), PARAM_ALPHANUMEXT);
+            if ($format !== '') {
+                $formats[] = $format;
+            }
+        }
+        return array_values(array_unique($formats));
+    }
+
