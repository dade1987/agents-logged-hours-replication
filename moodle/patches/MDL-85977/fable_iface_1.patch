+namespace mod_bigbluebuttonbn\local\admin;
+
+use admin_setting_configmultiselect;
+use core_text;
+
+/**
+ * Multiselect admin setting which also allows the administrator to type new entries (tags).
+ *
+ * This is used for the list of "safe" recording formats: the list of known formats is provided as
+ * choices, but new formats (not yet known by the plugin) can be added freely by the administrator
+ * without having to modify the source code or to lock the setting in config.php.
+ *
+ * @package   mod_bigbluebuttonbn
+ * @copyright 2025 onwards, Blindside Networks Inc
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class setting_configmultiselect_tags extends admin_setting_configmultiselect {
+    /** @var string Placeholder text for an empty list. */
+    protected string $placeholder = '';
+
+    /** @var string String that is shown when there are no selections. */
+    protected string $noselectionstring = '';
+
+    /** @var bool Show suggestions by default - but this can be turned off. */
+    protected bool $showsuggestions = true;
+
+    /** @var array The base (known) choices, as given to the constructor. */
+    protected array $basechoices = [];
+
+    /**
+     * Constructor.
+     *
+     * @param string $name unique ascii name, either 'mysetting' for settings that in config, or 'myplugin/mysetting'
+     * for ones in config_plugins.
+     * @param string $visiblename localised
+     * @param string $description long localised info
+     * @param array $defaultsetting array of selected items
+     * @param array $choices known options for the autocomplete field (value => label)
+     * @param string $placeholder placeholder text for an empty list
+     * @param string $noselectionstring string that is shown when there are no selections
+     * @param bool $showsuggestions show suggestions by default
+     */
+    public function __construct(
+        string $name,
+        string $visiblename,
+        string $description,
+        array $defaultsetting,
+        array $choices,
+        string $placeholder,
+        string $noselectionstring,
+        bool $showsuggestions = true
+    ) {
+        $this->placeholder = $placeholder;
+        $this->noselectionstring = $noselectionstring;
+        $this->showsuggestions = $showsuggestions;
+        $this->basechoices = $choices;
+        parent::__construct($name, $visiblename, $description, $defaultsetting, $choices);
+    }
+
+    /**
+     * Get the list of choices: the known choices merged with the currently saved values and the defaults.
+     *
+     * Any saved value that is not part of the known choices is added to the list, so it can be displayed
+     * as selected and kept when the setting is saved again.
+     *
+     * @return array value => label
+     */
+    public function get_choices(): array {
+        $choices = $this->basechoices;
+        $extravalues = [];
+        $default = $this->get_defaultsetting();
+        if (is_array($default)) {
+            $extravalues = array_merge($extravalues, $default);
+        }
+        $current = $this->get_setting();
+        if (is_array($current)) {
+            $extravalues = array_merge($extravalues, $current);
+        }
+        foreach ($extravalues as $value) {
+            $value = $this->clean_value((string) $value);
+            if ($value === '' || array_key_exists($value, $choices)) {
+                continue;
+            }
+            $choices[$value] = $this->resolve_label($value);
+        }
+        return $choices;
+    }
+
+    /**
+     * Load the choices: known choices plus any saved value.
+     *
+     * @return bool true if the choices are loaded.
+     */
+    public function load_choices(): bool {
+        $this->choices = $this->get_choices();
+        return true;
+    }
+
+    /**
+     * Save the setting.
+     *
+     * Unlike the parent class, values which are not part of the known choices are accepted (tags),
+     * as long as they are valid format names.
+     *
+     * @param array $data
+     * @return string empty string if ok, string error message otherwise
+     */
+    public function write_setting($data): string {
+        if (!is_array($data)) {
+            return ''; // Ignore it.
+        }
+        unset($data['xxxxx']);
+
+        $save = [];
+        foreach ($data as $value) {
+            if (!is_scalar($value)) {
+                continue;
+            }
+            $value = $this->clean_value((string) $value);
+            if ($value === '' || in_array($value, $save, true)) {
+                continue;
+            }
+            $save[] = $value;
+        }
+
+        return ($this->config_write($this->name, implode(',', $save)) ? '' : get_string('errorsetting', 'admin'));
+    }
+
+    /**
+     * Resolve the label to display for a given value.
+     *
+     * If the value is one of the known choices, its label is used. Otherwise, if a language string
+     * exists for this format ('view_recording_format_<value>'), it is used. If none is found, the raw
+     * value is displayed.
+     *
+     * @param string $value
+     * @return string
+     */
+    protected function resolve_label(string $value): string {
+        if (array_key_exists($value, $this->basechoices)) {
+            return (string) $this->basechoices[$value];
+        }
+        $stringmanager = get_string_manager();
+        $identifier = 'view_recording_format_' . $value;
+        if ($stringmanager->string_exists($identifier, 'mod_bigbluebuttonbn')) {
+            return get_string($identifier, 'mod_bigbluebuttonbn');
+        }
+        return $value;
+    }
+
+    /**
+     * Clean a value so it can be safely stored as a comma separated list.
+     *
+     * @param string $value
+     * @return string the cleaned value ('' if invalid)
+     */
+    protected function clean_value(string $value): string {
+        $value = trim(core_text::strtolower($value));
+        return clean_param($value, PARAM_ALPHANUMEXT);
+    }
+
+    #[\Override]
+    public function output_html($data, $query = '') {
+        global $OUTPUT;
+
+        $this->load_choices();
+
+        $default = $this->get_defaultsetting();
+        if (empty($default)) {
+            $default = [];
+        }
+        if (is_null($data)) {
+            $data = [];
+        }
+
+        $defaults = [];
+        $options = [];
+        foreach ($this->choices as $value => $name) {
+            if (in_array($value, $default)) {
+                $defaults[] = $name;
+            }
+            $options[] = [
+                'value' => $value,
+                'text' => $name,
+                'selected' => in_array($value, $data),
+                'disabled' => false,
+            ];
+        }
+        // Make sure values currently submitted/selected but not in the choices are displayed too.
+        foreach ($data as $value) {
+            $value = $this->clean_value((string) $value);
+            if ($value === '' || array_key_exists($value, $this->choices)) {
+                continue;
+            }
+            $this->choices[$value] = $this->resolve_label($value);
+            $options[] = [
+                'value' => $value,
+                'text' => $this->choices[$value],
+                'selected' => true,
+                'disabled' => false,
+            ];
+        }
+
+        $context = [
+            'id' => $this->get_id(),
+            'name' => $this->get_full_name(),
+            'options' => $options,
+            'tags' => true,
+            'ajax' => '',
+            'placeholder' => $this->placeholder,
+            'casesensitive' => false,
+            'multiple' => true,
+            'showsuggestions' => $this->showsuggestions,
+            'noselectionstring' => $this->noselectionstring,
+            'manageurl' => '',
+            'managetext' => '',
+        ];
+
+        if (!empty($defaults)) {
+            $defaultinfo = implode(', ', $defaults);
+        } else {
+            $defaultinfo = get_string('none');
+        }
+
+        $element = $OUTPUT->render_from_template('core_admin/local/settings/autocomplete', $context);
+
+        return format_admin_setting($this, $this->visiblename, $element, $this->description, true, '', $defaultinfo, $query);
+    }
+}
