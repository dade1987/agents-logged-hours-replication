+namespace mod_bigbluebuttonbn\local\admin;
+
+/**
+ * Tests for the multiselect with tags admin setting.
+ *
+ * @package   mod_bigbluebuttonbn
+ * @copyright 2025 onwards, Blindside Networks Inc
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \mod_bigbluebuttonbn\local\admin\setting_configmultiselect_tags
+ */
+final class setting_configmultiselect_tags_test extends \advanced_testcase {
+    /**
+     * Create a setting instance for the tests.
+     *
+     * @return setting_configmultiselect_tags
+     */
+    private function create_setting(): setting_configmultiselect_tags {
+        return new setting_configmultiselect_tags(
+            'bigbluebuttonbn_recording_safe_formats',
+            'Safe formats',
+            'Description',
+            ['video', 'presentation'],
+            [
+                'presentation' => 'Presentation',
+                'video' => 'Video',
+            ],
+            'Placeholder',
+            'No selection',
+        );
+    }
+
+    /**
+     * Known choices and saved values are both part of the choices.
+     */
+    public function test_get_choices(): void {
+        $this->resetAfterTest();
+        $setting = $this->create_setting();
+        $this->assertSame(['presentation' => 'Presentation', 'video' => 'Video'], $setting->get_choices());
+
+        set_config('bigbluebuttonbn_recording_safe_formats', 'video,transcript,podcast');
+        $choices = $setting->get_choices();
+        $this->assertSame('Presentation', $choices['presentation']);
+        $this->assertSame('Video', $choices['video']);
+        $this->assertSame('transcript', $choices['transcript']);
+        $this->assertSame(get_string('view_recording_format_podcast', 'mod_bigbluebuttonbn'), $choices['podcast']);
+        $this->assertTrue($setting->load_choices());
+    }
+
+    /**
+     * Values which are not part of the known choices can be saved.
+     */
+    public function test_write_setting(): void {
+        $this->resetAfterTest();
+        $setting = $this->create_setting();
+        $this->assertSame('', $setting->write_setting([
+            'xxxxx' => '_qf__force_multiselect_submission',
+            'video',
+            'Transcript',
+            ' podcast ',
+            'video',
+            'not valid!',
+            '',
+        ]));
+        $this->assertSame('video,transcript,podcast', get_config('core', 'bigbluebuttonbn_recording_safe_formats'));
+        $this->assertSame(['video', 'transcript', 'podcast'], $setting->get_setting());
+        $this->assertArrayHasKey('transcript', $setting->get_choices());
+
+        $this->assertSame('', $setting->write_setting([]));
+        $this->assertSame('', get_config('core', 'bigbluebuttonbn_recording_safe_formats'));
+        $this->assertSame([], $setting->get_setting());
+
+        $this->assertSame('', $setting->write_setting('notanarray'));
+    }
+
+    /**
+     * The setting can be rendered, including unknown values.
+     */
+    public function test_output_html(): void {
+        $this->resetAfterTest();
+        $this->setAdminUser();
+        $setting = $this->create_setting();
+        $html = $setting->output_html(['video', 'transcript']);
+        $this->assertStringContainsString('value="video" selected', $html);
+        $this->assertStringContainsString('value="transcript" selected', $html);
+        $this->assertStringContainsString('value="presentation"', $html);
+    }
+}
