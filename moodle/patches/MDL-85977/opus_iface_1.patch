+namespace mod_bigbluebuttonbn\local\admin;
+
+use admin_setting_configmultiselect;
+
+/**
+ * Multiple selection setting with autocomplete that also allows new values (tags) to be typed in.
+ *
+ * Values that are not part of the predefined list of choices are accepted and stored, and are then
+ * added to the list of choices so they can be displayed and selected again.
+ *
+ * @package    mod_bigbluebuttonbn
+ * @copyright  2025 onwards, Blindside Networks Inc
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class setting_configmultiselect_tags extends admin_setting_configmultiselect {
+    /** @var string $placeholder Placeholder text for an empty list. */
+    protected string $placeholder;
+
+    /** @var string $noselectionstring String shown when there are no selections. */
+    protected string $noselectionstring;
+
+    /** @var bool $showsuggestions Show suggestions by default. */
+    protected bool $showsuggestions;
+
+    /** @var array $basechoices The predefined choices (value => label). */
+    protected array $basechoices;
+
+    /**
+     * Constructor.
+     *
+     * @param string $name unique ascii name
+     * @param string $visiblename localised name
+     * @param string $description localised long description
+     * @param array $defaultsetting array of default values
+     * @param array $choices array of $value => $label predefined choices
+     * @param string $placeholder placeholder text for the autocomplete field
+     * @param string $noselectionstring text shown when nothing is selected
+     * @param bool $showsuggestions whether suggestions are shown
+     */
+    public function __construct(
+        string $name,
+        string $visiblename,
+        string $description,
+        array $defaultsetting,
+        array $choices,
+        string $placeholder,
+        string $noselectionstring,
+        bool $showsuggestions = true
+    ) {
+        $this->basechoices = $choices;
+        $this->placeholder = $placeholder;
+        $this->noselectionstring = $noselectionstring;
+        $this->showsuggestions = $showsuggestions;
+        parent::__construct($name, $visiblename, $description, $defaultsetting, $choices);
+    }
+
+    /**
+     * Get the list of choices, including any custom value currently stored or used as default.
+     *
+     * @return array value => label
+     */
+    public function get_choices(): array {
+        $this->load_choices();
+        return $this->choices;
+    }
+
+    /**
+     * Load the choices: predefined choices plus default and currently stored values.
+     *
+     * @return bool
+     */
+    public function load_choices(): bool {
+        $choices = is_array($this->choices) ? $this->choices : [];
+        foreach ($this->basechoices as $value => $label) {
+            if (!array_key_exists($value, $choices)) {
+                $choices[$value] = $label;
+            }
+        }
+        $values = [];
+        $default = $this->get_defaultsetting();
+        if (is_array($default)) {
+            $values = array_merge($values, $default);
+        }
+        $current = $this->get_setting();
+        if (is_array($current)) {
+            $values = array_merge($values, $current);
+        }
+        foreach ($values as $value) {
+            $value = $this->clean_value((string) $value);
+            if ($value === '' || array_key_exists($value, $choices)) {
+                continue;
+            }
+            $choices[$value] = $this->resolve_label($value);
+        }
+        $this->choices = $choices;
+        return true;
+    }
+
+    /**
+     * Save the setting. Any non-empty value is accepted (new tags are allowed).
+     *
+     * @param mixed $data array of values
+     * @return string empty string if ok, error message otherwise
+     */
+    public function write_setting($data): string {
+        if (!is_array($data)) {
+            return ''; // Ignore it.
+        }
+        unset($data['xxxxx']);
+
+        $this->load_choices();
+        $save = [];
+        foreach ($data as $value) {
+            if (!is_scalar($value)) {
+                continue;
+            }
+            $value = $this->clean_value((string) $value);
+            if ($value === '' || in_array($value, $save, true)) {
+                continue;
+            }
+            $save[] = $value;
+            if (!array_key_exists($value, $this->choices)) {
+                $this->choices[$value] = $this->resolve_label($value);
+            }
+        }
+
+        return ($this->config_write($this->name, implode(',', $save)) ? '' : get_string('errorsetting', 'admin'));
+    }
+
+    /**
+     * Return the HTML for this setting, enhanced with the autocomplete (tags) widget.
+     *
+     * @param mixed $data array of selected values
+     * @param string $query
+     * @return string
+     */
+    public function output_html($data, $query = '') {
+        global $PAGE;
+
+        $html = parent::output_html($data, $query);
+        if ($html === '') {
+            return $html;
+        }
+
+        $params = [
+            '#' . $this->get_id(),
+            true, // Tags: allow new entries.
+            '',
+            $this->placeholder,
+            false,
+            $this->showsuggestions,
+            $this->noselectionstring,
+        ];
+        $PAGE->requires->js_call_amd('core/form-autocomplete', 'enhance', $params);
+
+        return $html;
+    }
+
+    /**
+     * Resolve the label for a given value.
+     *
+     * Uses the predefined choices first, then a language string 'view_recording_format_<value>'
+     * if it exists, falling back to the raw value.
+     *
+     * @param string $value
+     * @return string
+     */
+    protected function resolve_label(string $value): string {
+        if (array_key_exists($value, $this->basechoices)) {
+            return (string) $this->basechoices[$value];
+        }
+        $stringid = 'view_recording_format_' . $value;
+        $sm = get_string_manager();
+        if ($sm->string_exists($stringid, 'mod_bigbluebuttonbn')) {
+            return get_string($stringid, 'mod_bigbluebuttonbn');
+        }
+        return $value;
+    }
+
+    /**
+     * Clean a single value so it can safely be stored in a comma separated list.
+     *
+     * @param string $value
+     * @return string
+     */
+    protected function clean_value(string $value): string {
+        $value = clean_param($value, PARAM_NOTAGS);
+        $value = str_replace(',', '', $value);
+        return trim($value);
+    }
+}
