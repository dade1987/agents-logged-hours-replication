+namespace mod_bigbluebuttonbn\local\admin;
+
+/**
+ * Tests for the setting_configmultiselect_tags admin setting.
+ *
+ * @package    mod_bigbluebuttonbn
+ * @copyright  2025 onwards, Blindside Networks Inc
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \mod_bigbluebuttonbn\local\admin\setting_configmultiselect_tags
+ */
+final class setting_configmultiselect_tags_test extends \advanced_testcase {
+    /**
+     * Create the setting.
+     *
+     * @return setting_configmultiselect_tags
+     */
+    private function get_setting(): setting_configmultiselect_tags {
+        global $CFG;
+        require_once($CFG->libdir . '/adminlib.php');
+        return new setting_configmultiselect_tags(
+            'bigbluebuttonbn_recording_safe_formats',
+            'Safe formats',
+            'Description',
+            ['video', 'presentation'],
+            [
+                'presentation' => get_string('view_recording_format_presentation', 'mod_bigbluebuttonbn'),
+                'video' => get_string('view_recording_format_video', 'mod_bigbluebuttonbn'),
+            ],
+            'Placeholder',
+            'No selection'
+        );
+    }
+
+    public function test_write_custom_values(): void {
+        $this->resetAfterTest();
+        $setting = $this->get_setting();
+        $this->assertSame('', $setting->write_setting(['xxxxx' => 1, 'video', 'transcript', 'podcast', ' ', 'video']));
+        $this->assertSame('video,transcript,podcast', get_config('core', 'bigbluebuttonbn_recording_safe_formats'));
+        $this->assertSame(['video', 'transcript', 'podcast'], $setting->get_setting());
+
+        $choices = $this->get_setting()->get_choices();
+        $this->assertArrayHasKey('transcript', $choices);
+        $this->assertSame('transcript', $choices['transcript']);
+        $this->assertSame(get_string('view_recording_format_podcast', 'mod_bigbluebuttonbn'), $choices['podcast']);
+        $this->assertArrayHasKey('presentation', $choices);
+    }
+
+    public function test_write_empty_and_invalid(): void {
+        $this->resetAfterTest();
+        $setting = $this->get_setting();
+        $this->assertSame('', $setting->write_setting(['xxxxx' => 1]));
+        $this->assertSame([], $setting->get_setting());
+        $this->assertSame('', $setting->write_setting('notanarray'));
+        $this->assertTrue($setting->load_choices());
+    }
+}
