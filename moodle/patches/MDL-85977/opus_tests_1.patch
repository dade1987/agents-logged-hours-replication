+namespace mod_bigbluebuttonbn\local;
+
+/**
+ * Tests for the config class.
+ *
+ * @package    mod_bigbluebuttonbn
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \mod_bigbluebuttonbn\local\config
+ */
+final class config_test extends \advanced_testcase {
+    /**
+     * Test the default list of recording formats.
+     */
+    public function test_get_recording_formats_default(): void {
+        $this->resetAfterTest();
+        unset_config('bigbluebuttonbn_recording_safe_formats');
+        unset_config('bigbluebuttonbn_recording_formats');
+        $this->assertEquals(
+            ['notes', 'podcast', 'presentation', 'screenshare', 'statistics', 'video'],
+            config::get_recording_formats()
+        );
+    }
+
+    /**
+     * Test the list of recording formats can be extended through settings.
+     */
+    public function test_get_recording_formats_extended(): void {
+        $this->resetAfterTest();
+        set_config('bigbluebuttonbn_recording_formats', ' presentation, video ,transcript,,video');
+        set_config('bigbluebuttonbn_recording_safe_formats', 'video,podcast');
+        $this->assertEquals(['presentation', 'video', 'transcript', 'podcast'], config::get_recording_formats());
+        $this->assertEquals(['video', 'podcast'], config::get_recording_safe_formats());
+    }
+
+    /**
+     * Test an empty list of formats falls back to default.
+     */
+    public function test_get_recording_formats_empty(): void {
+        $this->resetAfterTest();
+        set_config('bigbluebuttonbn_recording_formats', '');
+        set_config('bigbluebuttonbn_recording_safe_formats', '');
+        $this->assertEquals(
+            ['notes', 'podcast', 'presentation', 'screenshare', 'statistics', 'video'],
+            config::get_recording_formats()
+        );
+        $this->assertEquals([], config::get_recording_safe_formats());
+    }
+}
