+    /**
+     * Parse a comma separated list of recording formats into a clean array.
+     *
+     * @param string $formats comma separated list of formats
+     * @return string[] list of unique, trimmed, non empty format names
+     */
+    public static function parse_recording_formats(string $formats): array {
+        $result = [];
+        foreach (explode(',', $formats) as $format) {
+            $format = clean_param(trim($format), PARAM_ALPHANUMEXT);
+            if ($format !== '' && !in_array($format, $result)) {
+                $result[] = $format;
+            }
+        }
+        return $result;
+    }
+
+    /**
+     * Returns the list of recording formats that can be selected as safe formats.
+     *
+     * This is the list defined in the bigbluebuttonbn_recording_formats setting, so new formats can be added
+     * without modifying the code. Formats currently set as safe are also included so they are never lost.
+     *
+     * @return string[] list of format names
+     */
+    public static function get_recording_formats(): array {
+        $formats = self::parse_recording_formats(self::get('recording_formats'));
+        if (empty($formats)) {
+            $formats = self::parse_recording_formats(self::DEFAULT_RECORDING_FORMATS);
+        }
+        foreach (self::get_recording_safe_formats() as $safeformat) {
+            if (!in_array($safeformat, $formats)) {
+                $formats[] = $safeformat;
+            }
+        }
+        return $formats;
+    }
+
+    /**
+     * Returns the list of recording formats that are viewable by everyone.
+     *
+     * @return string[] list of format names
+     */
+    public static function get_recording_safe_formats(): array {
+        return self::parse_recording_formats(self::get('recording_safe_formats'));
+    }
+
