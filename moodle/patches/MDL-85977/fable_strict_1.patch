+namespace mod_bigbluebuttonbn\local;
+
+use advanced_testcase;
+
+/**
+ * Tests for the config class.
+ *
+ * @package   mod_bigbluebuttonbn
+ * @copyright 2025 onwards, Blindside Networks Inc
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \mod_bigbluebuttonbn\local\config
+ */
+final class config_test extends advanced_testcase {
+    /**
+     * Test parsing of a comma separated list of recording formats.
+     *
+     * @param string $formats
+     * @param array $expected
+     * @dataProvider parse_recording_formats_provider
+     */
+    public function test_parse_recording_formats(string $formats, array $expected): void {
+        $this->assertSame($expected, config::parse_recording_formats($formats));
+    }
+
+    /**
+     * Data provider for test_parse_recording_formats.
+     *
+     * @return array
+     */
+    public static function parse_recording_formats_provider(): array {
+        return [
+            'empty' => ['', []],
+            'single' => ['video', ['video']],
+            'several' => ['podcast,presentation,video', ['podcast', 'presentation', 'video']],
+            'spaces and duplicates' => [' podcast , video,,video ', ['podcast', 'video']],
+        ];
+    }
+
+    /**
+     * Test the list of available recording formats can be extended through configuration.
+     */
+    public function test_get_recording_formats(): void {
+        $this->resetAfterTest();
+
+        // Default list of formats.
+        $this->assertSame(config::DEFAULT_RECORDING_FORMATS, config::get_recording_formats());
+
+        // Add a new format without modifying the source code.
+        set_config('bigbluebuttonbn_recording_all_formats', 'podcast,presentation,video,transcript');
+        $this->assertSame(['podcast', 'presentation', 'video', 'transcript'], config::get_recording_formats());
+
+        // Safe formats are always part of the available formats.
+        set_config('bigbluebuttonbn_recording_safe_formats', 'video,presentation,captions');
+        $this->assertSame(['podcast', 'presentation', 'video', 'transcript', 'captions'], config::get_recording_formats());
+    }
+
+    /**
+     * Test the list of safe recording formats.
+     */
+    public function test_get_recording_safe_formats(): void {
+        $this->resetAfterTest();
+
+        set_config('bigbluebuttonbn_recording_safe_formats', '');
+        $this->assertSame([], config::get_recording_safe_formats());
+
+        set_config('bigbluebuttonbn_recording_safe_formats', 'podcast,presentation,video,transcript');
+        $this->assertSame(['podcast', 'presentation', 'video', 'transcript'], config::get_recording_safe_formats());
+    }
+}
