+    /**
+     * Parse a comma separated list of recording formats into a clean array of format names.
+     *
+     * @param string $formats comma separated list of formats
+     * @return string[] list of unique, non empty, trimmed format names
+     */
+    public static function parse_recording_formats(string $formats): array {
+        $formatarray = str_getcsv($formats, escape: '\\');
+        $formatarray = array_map(
+            fn($format) => trim((string) $format),
+            $formatarray
+        );
+        $formatarray = array_filter($formatarray, fn($format) => $format !== '');
+        return array_values(array_unique($formatarray));
+    }
+
+    /**
+     * Get the list of all recording formats that can be produced by the BigBlueButton server.
+     *
+     * The list is composed of the default (official) formats plus any additional format defined
+     * in the bigbluebuttonbn_recording_all_formats setting, so new formats can be added without
+     * modifying the source code.
+     *
+     * @return string[] list of recording format names
+     */
+    public static function get_recording_formats(): array {
+        $formats = self::parse_recording_formats(self::get('recording_all_formats'));
+        // Make sure that formats which are already marked as safe are always available.
+        $formats = array_merge($formats, self::get_recording_safe_formats());
+        return array_values(array_unique($formats));
+    }
+
+    /**
+     * Get the list of recording formats that can be viewed by everyone.
+     *
+     * @return string[] list of recording format names
+     */
+    public static function get_recording_safe_formats(): array {
+        return self::parse_recording_formats(self::get('recording_safe_formats'));
+    }
