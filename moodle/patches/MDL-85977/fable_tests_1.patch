+    /**
+     * Parse a comma separated list of recording format names into a clean array of format identifiers.
+     *
+     * @param string $formats comma separated list of formats
+     * @return string[] list of unique, trimmed, non empty format identifiers
+     */
+    public static function parse_recording_formats(string $formats): array {
+        if (trim($formats) === '') {
+            return [];
+        }
+        $formatlist = str_getcsv($formats, escape: '\\');
+        $formatlist = array_map('trim', $formatlist);
+        $formatlist = array_filter($formatlist, fn($format) => $format !== '');
+        return array_values(array_unique($formatlist));
+    }
+
+    /**
+     * Get the list of all the recording formats that can be selected as safe formats.
+     *
+     * This list is composed of the official formats (see DEFAULT_RECORDING_FORMATS) and can be
+     * extended, without modifying the source code, by defining additional formats either through the
+     * $CFG->bigbluebuttonbn_recording_additional_formats variable in config.php (comma separated list)
+     * or through the $CFG->bigbluebuttonbn['recording_additional_formats'] array entry.
+     *
+     * @return string[] array indexed by format identifier and whose value is the format display name
+     */
+    public static function get_recording_formats(): array {
+        $additionalformats = self::parse_recording_formats(self::get('recording_additional_formats'));
+        $allformats = array_unique(array_merge(self::DEFAULT_RECORDING_FORMATS, $additionalformats));
+        $formats = [];
+        foreach ($allformats as $format) {
+            $formats[$format] = recording_data::type_text($format);
+        }
+        return $formats;
+    }
+
+    /**
+     * Get the list of recording formats that are considered safe, i.e. viewable by everyone.
+     *
+     * @return string[] list of safe format identifiers
+     */
+    public static function get_recording_safe_formats(): array {
+        return self::parse_recording_formats(self::get('recording_safe_formats'));
+    }
+
