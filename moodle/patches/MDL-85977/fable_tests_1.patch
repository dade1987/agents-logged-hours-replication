+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace mod_bigbluebuttonbn\local;
+
+/**
+ * Tests for the config class.
+ *
+ * @package   mod_bigbluebuttonbn
+ * @copyright 2025 onwards, Blindside Networks Inc
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \mod_bigbluebuttonbn\local\config
+ */
+final class config_test extends \advanced_testcase {
+
+    /**
+     * Test parsing of comma separated list of formats.
+     *
+     * @param string $formats
+     * @param array $expected
+     * @dataProvider parse_recording_formats_provider
+     */
+    public function test_parse_recording_formats(string $formats, array $expected): void {
+        $this->assertSame($expected, config::parse_recording_formats($formats));
+    }
+
+    /**
+     * Data provider for test_parse_recording_formats.
+     *
+     * @return array
+     */
+    public static function parse_recording_formats_provider(): array {
+        return [
+            'empty' => ['', []],
+            'spaces only' => ['   ', []],
+            'single' => ['video', ['video']],
+            'multiple' => ['video,presentation', ['video', 'presentation']],
+            'with spaces and duplicates' => [' video , presentation,video,, ', ['video', 'presentation']],
+        ];
+    }
+
+    /**
+     * Test that the default list of recording formats is returned when nothing is defined.
+     */
+    public function test_get_recording_formats_default(): void {
+        $this->resetAfterTest();
+        $formats = config::get_recording_formats();
+        $this->assertSame(config::DEFAULT_RECORDING_FORMATS, array_keys($formats));
+        $this->assertSame(get_string('view_recording_format_video', 'mod_bigbluebuttonbn'), $formats['video']);
+    }
+
+    /**
+     * Test that the list of recording formats can be extended through config.php.
+     */
+    public function test_get_recording_formats_additional(): void {
+        global $CFG;
+        $this->resetAfterTest();
+        $CFG->bigbluebuttonbn_recording_additional_formats = 'transcript, video,chat';
+        $formats = config::get_recording_formats();
+        $this->assertSame(
+            array_merge(config::DEFAULT_RECORDING_FORMATS, ['transcript', 'chat']),
+            array_keys($formats)
+        );
+        // Unknown formats get a capitalised label.
+        $this->assertSame('Transcript', $formats['transcript']);
+        $this->assertSame('Chat', $formats['chat']);
+    }
+
+    /**
+     * Test that the list of recording formats can also be extended through the $CFG->bigbluebuttonbn array.
+     */
+    public function test_get_recording_formats_additional_array(): void {
+        global $CFG;
+        $this->resetAfterTest();
+        $CFG->bigbluebuttonbn = ['recording_additional_formats' => 'transcript'];
+        $this->assertSame(
+            array_merge(config::DEFAULT_RECORDING_FORMATS, ['transcript']),
+            array_keys(config::get_recording_formats())
+        );
+    }
+
+    /**
+     * Test safe formats retrieval.
+     */
+    public function test_get_recording_safe_formats(): void {
+        $this->resetAfterTest();
+        set_config('bigbluebuttonbn_recording_safe_formats', 'video,presentation,transcript');
+        $this->assertSame(['video', 'presentation', 'transcript'], config::get_recording_safe_formats());
+        unset_config('bigbluebuttonbn_recording_safe_formats');
+        $this->assertSame(config::DEFAULT_RECORDING_SAFE_FORMATS, config::get_recording_safe_formats());
+    }
+}
