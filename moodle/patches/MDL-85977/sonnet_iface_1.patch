+namespace mod_bigbluebuttonbn\local\admin;
+
+use core_admin\setting\setting\configmultiselect;
+
+/**
+ * Multiple selection admin setting that also lets the admin enter free-form values (tags).
+ *
+ * The known choices are offered as suggestions, but any additional value can be added.
+ *
+ * @package   mod_bigbluebuttonbn
+ * @copyright 2025 onwards Blindside Networks Inc
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class setting_configmultiselect_tags extends configmultiselect {
+    /** @var string Placeholder displayed in the autocomplete input. */
+    protected string $placeholder;
+
+    /** @var string Text displayed when nothing is selected. */
+    protected string $noselectionstring;
+
+    /** @var bool Whether to show suggestions. */
+    protected bool $showsuggestions;
+
+    /**
+     * Constructor.
+     *
+     * @param string $name unique ascii name
+     * @param string $visiblename localised name
+     * @param string $description localised long description
+     * @param array $defaultsetting array of selected values
+     * @param array $choices array of known value => label
+     * @param string $placeholder placeholder of the autocomplete field
+     * @param string $noselectionstring text displayed when nothing is selected
+     * @param bool $showsuggestions whether to show suggestions
+     */
+    public function __construct(
+        string $name,
+        string $visiblename,
+        string $description,
+        array $defaultsetting,
+        array $choices,
+        string $placeholder,
+        string $noselectionstring,
+        bool $showsuggestions = true
+    ) {
+        $this->placeholder = $placeholder;
+        $this->noselectionstring = $noselectionstring;
+        $this->showsuggestions = $showsuggestions;
+        parent::__construct($name, $visiblename, $description, $defaultsetting, $choices);
+    }
+
+    /**
+     * Get the known choices, plus any currently saved value that is not a known choice.
+     *
+     * @return array value => label
+     */
+    public function get_choices(): array {
+        $choices = $this->choices ?? [];
+        $current = $this->get_setting();
+        if (is_array($current)) {
+            foreach ($current as $value) {
+                if ($value !== '' && !array_key_exists($value, $choices)) {
+                    $choices[$value] = $this->resolve_label($value);
+                }
+            }
+        }
+        return $choices;
+    }
+
+    #[\Override]
+    public function load_choices(): bool {
+        if (!is_array($this->choices)) {
+            $this->choices = [];
+        }
+        return true;
+    }
+
+    /**
+     * Get the label for a value: the known label or the value itself.
+     *
+     * @param string $value
+     * @return string
+     */
+    protected function resolve_label(string $value): string {
+        if (isset($this->choices[$value])) {
+            return (string) $this->choices[$value];
+        }
+        return $value;
+    }
+
+    #[\Override]
+    public function write_setting($data): string {
+        if (!is_array($data)) {
+            return '';
+        }
+        unset($data['xxxxx']);
+
+        $save = [];
+        foreach ($data as $value) {
+            if (!is_scalar($value)) {
+                continue;
+            }
+            $value = trim(str_replace(',', '', (string) $value));
+            $value = clean_param($value, PARAM_ALPHANUMEXT);
+            if ($value === '' || in_array($value, $save, true)) {
+                continue;
+            }
+            $save[] = $value;
+        }
+
+        return ($this->config_write($this->name, implode(',', $save)) ? '' : get_string('errorsetting', 'admin'));
+    }
+
+    #[\Override]
+    public function output_html($data, $query = '') {
+        global $PAGE;
+
+        $this->load_choices();
+        $default = $this->get_defaultsetting();
+        $default = is_array($default) ? $default : [];
+        $data = is_array($data) ? $data : [];
+
+        $choices = $this->get_choices();
+        foreach ($data as $value) {
+            if (!array_key_exists($value, $choices)) {
+                $choices[$value] = $this->resolve_label($value);
+            }
+        }
+
+        $defaults = [];
+        $options = '';
+        foreach ($choices as $value => $label) {
+            $value = (string) $value;
+            if (in_array($value, $default)) {
+                $defaults[] = $label;
+            }
+            $options .= \html_writer::tag('option', s($label), array_filter([
+                'value' => $value,
+                'selected' => in_array($value, $data) ? 'selected' : null,
+            ]));
+        }
+
+        $id = $this->get_id();
+        $attributes = [
+            'id' => $id,
+            'name' => $this->get_full_name() . '[]',
+            'multiple' => 'multiple',
+            'size' => min(10, max(1, count($choices))),
+            'class' => 'form-control',
+        ];
+        if ($this->is_readonly()) {
+            $attributes['disabled'] = 'disabled';
+        }
+        $element = \html_writer::empty_tag('input', [
+            'type' => 'hidden',
+            'name' => $this->get_full_name() . '[xxxxx]',
+            'value' => '1',
+        ]);
+        $element .= \html_writer::tag('select', $options, $attributes);
+
+        if (!$this->is_readonly()) {
+            $PAGE->requires->js_call_amd('core/form-autocomplete', 'enhance', [
+                '#' . $id,
+                true,
+                false,
+                $this->placeholder,
+                false,
+                $this->showsuggestions,
+                $this->noselectionstring,
+            ]);
+        }
+
+        $defaultinfo = !empty($defaults) ? implode(', ', $defaults) : get_string('none');
+
+        return format_admin_setting(
+            $this,
+            $this->visiblename,
+            \html_writer::div($element, 'form-multiselect'),
+            $this->description,
+            true,
+            '',
+            $defaultinfo,
+            $query
+        );
+    }
+}
