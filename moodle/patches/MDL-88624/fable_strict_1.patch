+    /**
+     * Test count_attempts when a user is enrolled with more than one enrolment method.
+     *
+     * @covers ::count_attempts
+     */
+    public function test_count_attempts_multiple_enrolments(): void {
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $course = $this->getDataGenerator()->create_course();
+        $activity = $this->getDataGenerator()->create_module(
+            'h5pactivity',
+            ['course' => $course, 'enabletracking' => 1]
+        );
+        $manager = manager::create_from_instance($activity);
+
+        // User1 is enrolled using the manual method only.
+        $user1 = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        // User2 is enrolled using both the manual and the self enrolment methods.
+        $user2 = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $this->getDataGenerator()->enrol_user($user2->id, $course->id, 'student', 'self');
+
+        // Each user has 3 completed attempts (plus one incomplete).
+        $this->generate_fake_attempts($activity, $user1, 1);
+        $this->generate_fake_attempts($activity, $user2, 1);
+
+        $this->assertEquals(3, $manager->count_attempts($user1->id));
+        $this->assertEquals(3, $manager->count_attempts($user2->id));
+        $this->assertEquals(6, $manager->count_attempts());
+    }
+
