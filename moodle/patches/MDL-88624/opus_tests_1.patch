+    /**
+     * Test count_attempts for all users when a user is enrolled with multiple enrolment methods.
+     */
+    public function test_count_attempts_multiple_enrolments(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $course = $this->getDataGenerator()->create_course();
+        $activity = $this->getDataGenerator()->create_module('h5pactivity',
+                ['course' => $course]);
+
+        $manager = manager::create_from_instance($activity);
+
+        // User enrolled with manual and self enrolment methods.
+        $user1 = $this->getDataGenerator()->create_and_enrol($course, 'student', null, 'manual');
+        $selfplugin = enrol_get_plugin('self');
+        $selfinstance = $DB->get_record('enrol', ['courseid' => $course->id, 'enrol' => 'self'], '*', MUST_EXIST);
+        $selfinstance->status = ENROL_INSTANCE_ENABLED;
+        $DB->update_record('enrol', $selfinstance);
+        $studentrole = $DB->get_field('role', 'id', ['shortname' => 'student']);
+        $selfplugin->enrol_user($selfinstance, $user1->id, $studentrole);
+        $this->generate_fake_attempts($activity, $user1, 1);
+
+        // User enrolled with one method only.
+        $user2 = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $this->generate_fake_attempts($activity, $user2, 1);
+
+        // Each user has 3 completed attempts.
+        $this->assertEquals(6, $manager->count_attempts());
+    }
+
