+namespace test_fixtures\core_renderer;
+
+use core\hook\output\before_help_icon_rendered;
+
+/**
+ * Hook fixture for \core_renderer::render_help_icon.
+ *
+ * @package   core
+ * @category  test
+ * @copyright 2025 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+final class before_help_icon_rendered_fixture {
+    /**
+     * Fixture modifying the context and adding HTML around the help icon.
+     *
+     * @param before_help_icon_rendered $hook
+     */
+    public static function modify(before_help_icon_rendered $hook): void {
+        $hook->get_context()->text .= ' <span class="test-extra-help">Extra help text</span>';
+        $hook->add_before_icon('<span class="test-before-icon">before</span>');
+        $hook->add_after_icon('<span class="test-after-icon">after</span>');
+    }
+
+    /**
+     * Fixture replacing the help icon for a specific identifier only.
+     *
+     * @param before_help_icon_rendered $hook
+     */
+    public static function replace(before_help_icon_rendered $hook): void {
+        if ($hook->get_identifier() === 'coursecategory' && $hook->get_component() === 'core') {
+            $hook->set_replacement('<span class="test-replacement">replaced</span>');
+        }
+    }
+}
