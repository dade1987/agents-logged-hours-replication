+    }
+
+    /**
+     * Test that the before_help_icon_rendered hook can modify the context and add HTML around the icon.
+     */
+    public function test_help_icon_hooked(): void {
+        require_once(__DIR__ . '/fixtures/core_renderer/before_help_icon_rendered_callbacks.php');
+
+        \core\di::set(
+            \core\hook\manager::class,
+            \core\hook\manager::phpunit_get_instance([
+                'test_plugin1' => __DIR__ . '/fixtures/core_renderer/before_help_icon_rendered_hooks.php',
+            ]),
+        );
+
+        $page = new moodle_page();
+        $renderer = new core_renderer($page, RENDERER_TARGET_GENERAL);
+
+        $html = $renderer->help_icon('allowstealthmodules', 'core');
+        $this->assertIsString($html);
+        // The standard icon is still rendered.
+        $this->assertStringContainsString('help-icon', $html);
+        $this->assertStringNotContainsString('test-replacement', $html);
+        // The context was modified (popover content lives in the data-bs-content attribute, so it is escaped).
+        $this->assertStringContainsString('test-extra-help', $html);
+        // HTML was added before and after the icon, in the correct order.
+        $before = strpos($html, 'test-before-icon');
+        $icon = strpos($html, 'help-icon');
+        $after = strpos($html, 'test-after-icon');
+        $this->assertNotFalse($before);
+        $this->assertNotFalse($after);
+        $this->assertLessThan($icon, $before);
+        $this->assertGreaterThan($icon, $after);
+    }
+
+    /**
+     * Test that the before_help_icon_rendered hook can fully replace the help icon output.
+     */
+    public function test_help_icon_hooked_replacement(): void {
+        require_once(__DIR__ . '/fixtures/core_renderer/before_help_icon_rendered_callbacks.php');
+
+        \core\di::set(
+            \core\hook\manager::class,
+            \core\hook\manager::phpunit_get_instance([
+                'test_plugin1' => __DIR__ . '/fixtures/core_renderer/before_help_icon_rendered_hooks.php',
+            ]),
+        );
+
+        $page = new moodle_page();
+        $renderer = new core_renderer($page, RENDERER_TARGET_GENERAL);
+
+        $html = $renderer->help_icon('coursecategory', 'core');
+        $this->assertIsString($html);
+        // The template was not rendered at all.
+        $this->assertStringNotContainsString('help-icon', $html);
+        $this->assertStringNotContainsString('data-bs-toggle', $html);
+        $this->assertStringContainsString('test-replacement', $html);
+        // Before/after HTML still wraps the replacement.
+        $this->assertStringContainsString('test-before-icon', $html);
+        $this->assertStringContainsString('test-after-icon', $html);
+        $this->assertLessThan(strpos($html, 'test-replacement'), strpos($html, 'test-before-icon'));
+        $this->assertGreaterThan(strpos($html, 'test-replacement'), strpos($html, 'test-after-icon'));
+    }
+
