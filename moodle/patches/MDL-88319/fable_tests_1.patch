+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\hook\output;
+
+use core\output\help_icon;
+use core_renderer;
+use moodle_page;
+
+/**
+ * Tests for the before_help_icon_rendered hook.
+ *
+ * @package    core
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(before_help_icon_rendered::class)]
+final class before_help_icon_rendered_test extends \advanced_testcase {
+    /**
+     * Helper: create a hook for a given help icon.
+     *
+     * @param string $identifier
+     * @param string $component
+     * @return before_help_icon_rendered
+     */
+    private function create_hook(string $identifier = 'coursecategory', string $component = 'core'): before_help_icon_rendered {
+        $renderer = new core_renderer(new moodle_page(), RENDERER_TARGET_GENERAL);
+        $helpicon = new help_icon($identifier, $component);
+        $context = $helpicon->export_for_template($renderer);
+
+        return new before_help_icon_rendered($renderer, $helpicon, $context);
+    }
+
+    /**
+     * Test the default state of a freshly created hook.
+     */
+    public function test_defaults(): void {
+        $hook = $this->create_hook();
+
+        $this->assertSame('coursecategory', $hook->get_identifier());
+        $this->assertSame('core', $hook->get_component());
+        $this->assertInstanceOf(help_icon::class, $hook->get_help_icon());
+        $this->assertSame('', $hook->get_before_icon());
+        $this->assertSame('', $hook->get_after_icon());
+        $this->assertFalse($hook->has_replacement());
+        $this->assertNull($hook->get_replacement());
+        $this->assertFalse($hook->isPropagationStopped());
+    }
+
+    /**
+     * Test that the context is exposed and mutable.
+     */
+    public function test_context_is_mutable(): void {
+        $hook = $this->create_hook();
+
+        $context = $hook->get_context();
+        $this->assertInstanceOf(\stdClass::class, $context);
+        $this->assertObjectHasProperty('text', $context);
+        $this->assertObjectHasProperty('title', $context);
+        $this->assertObjectHasProperty('url', $context);
+
+        $context->text .= ' Extra';
+        $context->title = 'New title';
+
+        $this->assertStringEndsWith(' Extra', $hook->get_context()->text);
+        $this->assertSame('New title', $hook->get_context()->title);
+        $this->assertSame($context, $hook->context);
+    }
+
+    /**
+     * Test adding HTML before and after the icon (multiple additions are concatenated in order).
+     */
+    public function test_add_before_and_after_icon(): void {
+        $hook = $this->create_hook();
+
+        $hook->add_before_icon('<b>1</b>');
+        $hook->add_before_icon(null);
+        $hook->add_before_icon('');
+        $hook->add_before_icon('<b>2</b>');
+
+        $hook->add_after_icon('<i>a</i>');
+        $hook->add_after_icon(null);
+        $hook->add_after_icon('<i>b</i>');
+
+        $this->assertSame('<b>1</b><b>2</b>', $hook->get_before_icon());
+        $this->assertSame('<i>a</i><i>b</i>', $hook->get_after_icon());
+    }
+
+    /**
+     * Test setting and clearing a replacement.
+     */
+    public function test_set_replacement(): void {
+        $hook = $this->create_hook();
+
+        $hook->set_replacement('<span>replaced</span>');
+        $this->assertTrue($hook->has_replacement());
+        $this->assertSame('<span>replaced</span>', $hook->get_replacement());
+
+        // An empty string is still a replacement (the icon is hidden).
+        $hook->set_replacement('');
+        $this->assertTrue($hook->has_replacement());
+        $this->assertSame('', $hook->get_replacement());
+
+        $hook->set_replacement(null);
+        $this->assertFalse($hook->has_replacement());
+        $this->assertNull($hook->get_replacement());
+    }
+
+    /**
+     * Test that propagation can be stopped.
+     */
+    public function test_stop_propagation(): void {
+        $hook = $this->create_hook();
+
+        $hook->stop_propagation();
+        $this->assertTrue($hook->isPropagationStopped());
+    }
+}
