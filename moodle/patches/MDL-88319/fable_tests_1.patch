+    public function test_help_icon(): void {
+        $page = new moodle_page();
+        $renderer = new core_renderer($page, RENDERER_TARGET_GENERAL);
+
+        $html = $renderer->help_icon('allowstealthmodules', 'core');
+        $this->assertIsString($html);
