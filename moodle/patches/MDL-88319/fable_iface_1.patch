+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <https://www.gnu.org/licenses/>.
+
+namespace core\hook\output;
+
+use core\output\help_icon;
+
+/**
+ * Tests for the before_help_icon_rendered hook.
+ *
+ * @package    core
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(before_help_icon_rendered::class)]
+final class before_help_icon_rendered_test extends \advanced_testcase {
+    /**
+     * Test the default state of a new hook instance.
+     */
+    public function test_defaults(): void {
+        global $OUTPUT;
+
+        $helpicon = new help_icon('allowstealthmodules', 'core');
+        $context = (object) ['text' => 'Help text'];
+        $hook = new before_help_icon_rendered($OUTPUT, $helpicon, $context);
+
+        $this->assertSame($OUTPUT, $hook->renderer);
+        $this->assertSame($helpicon, $hook->helpicon);
+        $this->assertSame($helpicon, $hook->get_help_icon());
+        $this->assertSame($context, $hook->get_context());
+        $this->assertSame('allowstealthmodules', $hook->get_identifier());
+        $this->assertSame('core', $hook->get_component());
+        $this->assertSame('', $hook->get_before_icon());
+        $this->assertSame('', $hook->get_after_icon());
+        $this->assertNull($hook->get_replacement());
+        $this->assertFalse($hook->has_replacement());
+        $this->assertFalse($hook->isPropagationStopped());
+    }
+
+    /**
+     * Test that the template context is mutable.
+     */
+    public function test_context_is_mutable(): void {
+        global $OUTPUT;
+
+        $helpicon = new help_icon('allowstealthmodules', 'core');
+        $context = (object) ['text' => 'Help text'];
+        $hook = new before_help_icon_rendered($OUTPUT, $helpicon, $context);
+
+        $hook->get_context()->text = 'Modified text';
+        $this->assertSame('Modified text', $context->text);
+
+        $newcontext = (object) ['text' => 'Replaced context'];
+        $hook->set_context($newcontext);
+        $this->assertSame($newcontext, $hook->get_context());
+    }
+
+    /**
+     * Test adding HTML before and after the icon.
+     */
+    public function test_add_before_and_after_icon(): void {
+        global $OUTPUT;
+
+        $hook = new before_help_icon_rendered($OUTPUT, new help_icon('allowstealthmodules', 'core'), new \stdClass());
+
+        $hook->add_before_icon('<b>');
+        $hook->add_before_icon(null);
+        $hook->add_before_icon('');
+        $hook->add_before_icon('<i>');
+        $hook->add_after_icon('</i>');
+        $hook->add_after_icon(null);
+        $hook->add_after_icon('</b>');
+
+        $this->assertSame('<b><i>', $hook->get_before_icon());
+        $this->assertSame('</i></b>', $hook->get_after_icon());
+    }
+
+    /**
+     * Test setting a replacement.
+     */
+    public function test_set_replacement(): void {
+        global $OUTPUT;
+
+        $hook = new before_help_icon_rendered($OUTPUT, new help_icon('allowstealthmodules', 'core'), new \stdClass());
+
+        $hook->set_replacement('<span>Replacement</span>');
+        $this->assertTrue($hook->has_replacement());
+        $this->assertSame('<span>Replacement</span>', $hook->get_replacement());
+
+        // An empty string is still a replacement (it hides the icon).
+        $hook->set_replacement('');
+        $this->assertTrue($hook->has_replacement());
+        $this->assertSame('', $hook->get_replacement());
+
+        $hook->set_replacement(null);
+        $this->assertFalse($hook->has_replacement());
+        $this->assertNull($hook->get_replacement());
+    }
+
+    /**
+     * Test that the hook is dispatched when a help icon is rendered and that the context can be modified.
+     */
+    public function test_render_help_icon_modifies_context(): void {
+        global $OUTPUT;
+
+        $this->resetAfterTest();
+
+        $count = 0;
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook) use (&$count): void {
+            $count++;
+            $hook->get_context()->text = '<p>Custom popover text</p>';
+        });
+
+        $html = $OUTPUT->help_icon('allowstealthmodules', 'core');
+
+        $this->assertSame(1, $count);
+        $this->assertStringContainsString('Custom popover text', $html);
+    }
+
+    /**
+     * Test that HTML added before and after the icon is placed around the standard output.
+     */
+    public function test_render_help_icon_adds_html_around_icon(): void {
+        global $OUTPUT;
+
+        $this->resetAfterTest();
+
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook): void {
+            $hook->add_before_icon('<span class="before-marker"></span>');
+            $hook->add_after_icon('<span class="after-marker"></span>');
+        });
+
+        $html = $OUTPUT->help_icon('allowstealthmodules', 'core');
+
+        $this->assertStringStartsWith('<span class="before-marker"></span>', $html);
+        $this->assertStringEndsWith('<span class="after-marker"></span>', $html);
+        $this->assertStringContainsString('help-icon', $html);
+    }
+
+    /**
+     * Test that a replacement skips the standard template rendering.
+     */
+    public function test_render_help_icon_replacement(): void {
+        global $OUTPUT;
+
+        $this->resetAfterTest();
+
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook): void {
+            $hook->add_before_icon('[before]');
+            $hook->set_replacement('<a href="#">Replacement</a>');
+            $hook->add_after_icon('[after]');
+        });
+
+        $html = $OUTPUT->help_icon('allowstealthmodules', 'core');
+
+        $this->assertSame('[before]<a href="#">Replacement</a>[after]', $html);
+    }
+}
