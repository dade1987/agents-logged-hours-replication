+namespace core\hook\output;
+
+use core\hook\stoppable_trait;
+use core\output\help_icon;
+use Psr\EventDispatcher\StoppableEventInterface;
+use renderer_base;
+use stdClass;
+
+/**
+ * Hook dispatched before a help icon is rendered.
+ *
+ * Subscribers can:
+ * - modify the template context (the popover content) via {@see get_context()};
+ * - inject additional HTML before or after the icon via {@see add_before_icon()} and {@see add_after_icon()};
+ * - replace the help icon output entirely via {@see set_replacement()}.
+ *
+ * @package    core
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\core\attribute\tags('output')]
+#[\core\attribute\label('Allows plugins to extend, augment, or replace the output of a help icon.')]
+final class before_help_icon_rendered implements StoppableEventInterface {
+    use stoppable_trait;
+
+    /** @var string HTML to be placed before the help icon */
+    private string $beforeicon = '';
+
+    /** @var string HTML to be placed after the help icon */
+    private string $aftericon = '';
+
+    /** @var null|string Full replacement HTML for the help icon, or null if no replacement has been set */
+    private ?string $replacement = null;
+
+    /**
+     * Hook dispatched before a help icon is rendered.
+     *
+     * @param renderer_base $renderer The renderer that is rendering the help icon
+     * @param help_icon $helpicon The help icon being rendered
+     * @param stdClass $context The mutable template context used to render the help icon
+     */
+    public function __construct(
+        /** @var renderer_base The renderer that is rendering the help icon */
+        public readonly renderer_base $renderer,
+        /** @var help_icon The help icon being rendered */
+        public readonly help_icon $helpicon,
+        /** @var stdClass The mutable template context */
+        private stdClass $context,
+    ) {
+    }
+
+    /**
+     * Get the mutable template context.
+     *
+     * Any changes made to the returned object affect the rendered popover content.
+     *
+     * @return stdClass
+     */
+    public function get_context(): stdClass {
+        return $this->context;
+    }
+
+    /**
+     * Replace the template context entirely.
+     *
+     * @param stdClass $context
+     */
+    public function set_context(stdClass $context): void {
+        $this->context = $context;
+    }
+
+    /**
+     * Get the help icon being rendered.
+     *
+     * @return help_icon
+     */
+    public function get_help_icon(): help_icon {
+        return $this->helpicon;
+    }
+
+    /**
+     * Get the string identifier of the help string.
+     *
+     * @return string
+     */
+    public function get_identifier(): string {
+        return $this->helpicon->identifier;
+    }
+
+    /**
+     * Get the component of the help string.
+     *
+     * @return string
+     */
+    public function get_component(): string {
+        return $this->helpicon->component;
+    }
+
+    /**
+     * Add HTML to be placed immediately before the help icon.
+     *
+     * @param null|string $html
+     */
+    public function add_before_icon(?string $html): void {
+        if ($html) {
+            $this->beforeicon .= $html;
+        }
+    }
+
+    /**
+     * Add HTML to be placed immediately after the help icon.
+     *
+     * @param null|string $html
+     */
+    public function add_after_icon(?string $html): void {
+        if ($html) {
+            $this->aftericon .= $html;
+        }
+    }
+
+    /**
+     * Get the HTML to be placed before the help icon.
+     *
+     * @return string
+     */
+    public function get_before_icon(): string {
+        return $this->beforeicon;
+    }
+
+    /**
+     * Get the HTML to be placed after the help icon.
+     *
+     * @return string
+     */
+    public function get_after_icon(): string {
+        return $this->aftericon;
+    }
+
+    /**
+     * Provide a full HTML replacement for the help icon.
+     *
+     * When a replacement is set, the default template is not rendered at all.
+     * Any HTML added via {@see add_before_icon()} and {@see add_after_icon()} is still placed around the replacement.
+     *
+     * @param null|string $html The replacement HTML, or null to remove a previously set replacement
+     */
+    public function set_replacement(?string $html): void {
+        $this->replacement = $html;
+    }
+
+    /**
+     * Get the replacement HTML, if any.
+     *
+     * @return null|string
+     */
+    public function get_replacement(): ?string {
+        return $this->replacement;
+    }
+
+    /**
+     * Whether a replacement for the help icon has been provided.
+     *
+     * @return bool
+     */
+    public function has_replacement(): bool {
+        return $this->replacement !== null;
+    }
+}
diff --git a/public/lib/classes/output/core_renderer.php b/public/lib/classes/output/core_renderer.php
index 96247633e67..fd0dd9017f4 100644
--- a/public/lib/classes/output/core_renderer.php
+++ b/public/lib/classes/output/core_renderer.php
@@ -35,6 +35,7 @@ use core\exception\coding_exception;
 use core\hook\manager as hook_manager;
 use core\hook\output\after_standard_main_region_html_generation;
 use core\hook\output\before_footer_html_generation;
+use core\hook\output\before_help_icon_rendered;
 use core\hook\output\before_html_attributes;
 use core\hook\output\before_http_headers;
 use core\hook\output\before_standard_footer_html_generation;
@@ -2255,7 +2256,18 @@ class core_renderer extends renderer_base {
      */
     protected function render_help_icon(help_icon $helpicon) {
         $context = $helpicon->export_for_template($this);
-        return $this->render_from_template('core/help_icon', $context);
+
+        // Allow plugins to modify the popover content, add HTML around the icon, or replace the icon entirely.
+        $hook = new before_help_icon_rendered($this, $helpicon, $context);
+        di::get(hook_manager::class)->dispatch($hook);
+
+        if ($hook->has_replacement()) {
+            $output = $hook->get_replacement();
+        } else {
+            $output = $this->render_from_template('core/help_icon', $hook->get_context());
+        }
+
+        return $hook->get_before_icon() . $output . $hook->get_after_icon();
     }
 
     /**
diff --git a/public/lib/tests/hook/output/before_help_icon_rendered_test.php b/public/lib/tests/hook/output/before_help_icon_rendered_test.php
