+namespace core\hook\output;
+
+/**
+ * Hook dispatched before a help icon is rendered.
+ *
+ * Callbacks may modify the template context, add HTML before or after the icon,
+ * or replace the icon output entirely.
+ *
+ * @package    core
+ * @copyright  2026 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\core\attribute\tags('output')]
+#[\core\attribute\label('Allows plugins to extend, augment or replace the output of help icons')]
+final class before_help_icon_rendered {
+    /** @var string HTML to place before the icon */
+    private string $before = '';
+
+    /** @var string HTML to place after the icon */
+    private string $after = '';
+
+    /** @var string|null Replacement HTML, null when not replaced */
+    private ?string $replacement = null;
+
+    /**
+     * Constructor.
+     *
+     * @param \renderer_base $renderer The renderer
+     * @param \help_icon $helpicon The help icon being rendered
+     * @param \stdClass $context The mutable template context
+     */
+    public function __construct(
+        /** @var \renderer_base The renderer */
+        public readonly \renderer_base $renderer,
+        /** @var \help_icon The help icon being rendered */
+        public readonly \help_icon $helpicon,
+        /** @var \stdClass The mutable template context */
+        public readonly \stdClass $context,
+    ) {
+    }
+
+    /**
+     * Get the mutable template context.
+     *
+     * @return \stdClass
+     */
+    public function get_context(): \stdClass {
+        return $this->context;
+    }
+
+    /**
+     * Add HTML before the help icon.
+     *
+     * @param string|null $html
+     */
+    public function add_before_icon(?string $html): void {
+        if ($html) {
+            $this->before .= $html;
+        }
+    }
+
+    /**
+     * Add HTML after the help icon.
+     *
+     * @param string|null $html
+     */
+    public function add_after_icon(?string $html): void {
+        if ($html) {
+            $this->after .= $html;
+        }
+    }
+
+    /**
+     * Get HTML to place before the icon.
+     *
+     * @return string
+     */
+    public function get_before_icon(): string {
+        return $this->before;
+    }
+
+    /**
+     * Get HTML to place after the icon.
+     *
+     * @return string
+     */
+    public function get_after_icon(): string {
+        return $this->after;
+    }
+
+    /**
+     * Replace the help icon output entirely.
+     *
+     * @param string|null $html Replacement HTML, or null to clear a replacement.
+     */
+    public function set_replacement(?string $html): void {
+        $this->replacement = $html;
+    }
+
+    /**
+     * Whether a replacement has been set.
+     *
+     * @return bool
+     */
+    public function has_replacement(): bool {
+        return $this->replacement !== null;
+    }
+
+    /**
+     * Get the replacement HTML.
+     *
+     * @return string|null
+     */
+    public function get_replacement(): ?string {
+        return $this->replacement;
+    }
+}
