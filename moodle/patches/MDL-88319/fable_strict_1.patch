--- a/public/lib/classes/output/core_renderer.php
+++ b/public/lib/classes/output/core_renderer.php
@@ -35,6 +35,7 @@ use core\exception\coding_exception;
 use core\hook\manager as hook_manager;
 use core\hook\output\after_standard_main_region_html_generation;
 use core\hook\output\before_footer_html_generation;
+use core\hook\output\before_help_icon_rendered;
 use core\hook\output\before_html_attributes;
 use core\hook\output\before_http_headers;
 use core\hook\output\before_standard_footer_html_generation;
@@ -2248,14 +2249,27 @@ class core_renderer extends renderer_base {
     }
 
     /**
-     * Implementation of user image rendering.
+     * Implementation of help icon rendering.
+     *
+     * The {@see before_help_icon_rendered} hook is dispatched before the template is rendered, allowing plugins to
+     * modify the template context, add HTML before or after the icon, or replace the icon output entirely.
      *
      * @param help_icon $helpicon A help icon instance
      * @return string HTML fragment
      */
     protected function render_help_icon(help_icon $helpicon) {
         $context = $helpicon->export_for_template($this);
-        return $this->render_from_template('core/help_icon', $context);
+
+        $hook = new before_help_icon_rendered($this, $helpicon, $context);
+        di::get(hook_manager::class)->dispatch($hook);
+
+        if ($hook->has_replacement()) {
+            $output = $hook->get_replacement();
+        } else {
+            $output = $this->render_from_template('core/help_icon', $hook->get_context());
+        }
+
+        return $hook->get_before_icon() . $output . $hook->get_after_icon();
     }
 
     /**
diff --git a/public/lib/tests/core_renderer_test.php b/public/lib/tests/core_renderer_test.php
index 7e7947c91d4..b7d7fe12d1c 100644
--- a/public/lib/tests/core_renderer_test.php
+++ b/public/lib/tests/core_renderer_test.php
@@ -35,6 +35,7 @@ use moodle_page;
 #[\PHPUnit\Framework\Attributes\CoversClass(\core\hook\output\before_standard_footer_html_generation::class)]
 #[\PHPUnit\Framework\Attributes\CoversClass(\core\hook\output\after_standard_main_region_html_generation::class)]
 #[\PHPUnit\Framework\Attributes\CoversClass(\core\hook\output\before_html_attributes::class)]
+#[\PHPUnit\Framework\Attributes\CoversClass(\core\hook\output\before_help_icon_rendered::class)]
 final class core_renderer_test extends \advanced_testcase {
 
     /**
@@ -561,4 +562,132 @@ EOF
 
         $this->assertNull($renderer->edit_switch());
     }
+
+    /**
+     * The help icon is rendered from the template without a hook being registered.
+     */
+    public function test_before_help_icon_rendered(): void {
+        $page = new moodle_page();
+        $renderer = new core_renderer($page, RENDERER_TARGET_GENERAL);
+
+        $html = $renderer->help_icon('shortnamecourse', 'core');
+        $this->assertIsString($html);
+        $this->assertStringContainsString('The name displayed in areas with limited space', $html);
+        $this->assertStringNotContainsString('Before help icon', $html);
+        $this->assertStringNotContainsString('After help icon', $html);
+        $this->assertStringNotContainsString('Extra help text added by a plugin', $html);
+        $this->assertStringNotContainsString('Replaced help icon', $html);
+    }
+
+    /**
+     * A hook callback can modify the template context and add HTML before and after the help icon.
+     */
+    public function test_before_help_icon_rendered_hooked_augment(): void {
+        require_once(__DIR__ . '/fixtures/core_renderer/before_help_icon_rendered_callbacks.php');
+
+        \core\di::set(
+            \core\hook\manager::class,
+            \core\hook\manager::phpunit_get_instance([
+                'test_plugin1' => __DIR__ . '/fixtures/core_renderer/before_help_icon_rendered_hooks.php',
+            ]),
+        );
+        \test_fixtures\core_renderer\before_help_icon_rendered_callbacks::$mode = 'augment';
+
+        $page = new moodle_page();
+        $renderer = new core_renderer($page, RENDERER_TARGET_GENERAL);
+
+        $html = $renderer->help_icon('shortnamecourse', 'core');
+        $this->assertIsString($html);
+
+        // The default rendering is still present.
+        $this->assertStringContainsString('The name displayed in areas with limited space', $html);
+        $this->assertStringNotContainsString('Replaced help icon', $html);
+
+        // The context was modified.
+        $this->assertStringContainsString('Extra help text added by a plugin', $html);
+
+        // HTML was added before and after the icon, in the right order.
+        $this->assertStringStartsWith('<span class="before-help-icon">Before help icon</span>', $html);
+        $this->assertStringEndsWith('<span class="after-help-icon">After help icon</span>', $html);
+        $this->assertLessThan(
+            strpos($html, 'The name displayed in areas with limited space'),
+            strpos($html, 'Before help icon'),
+        );
+        $this->assertGreaterThan(
+            strpos($html, 'The name displayed in areas with limited space'),
+            strpos($html, 'After help icon'),
+        );
+    }
+
+    /**
+     * A hook callback can replace the help icon output entirely.
+     */
+    public function test_before_help_icon_rendered_hooked_replace(): void {
+        require_once(__DIR__ . '/fixtures/core_renderer/before_help_icon_rendered_callbacks.php');
+
+        \core\di::set(
+            \core\hook\manager::class,
+            \core\hook\manager::phpunit_get_instance([
+                'test_plugin1' => __DIR__ . '/fixtures/core_renderer/before_help_icon_rendered_hooks.php',
+            ]),
+        );
+        \test_fixtures\core_renderer\before_help_icon_rendered_callbacks::$mode = 'replace';
+
+        try {
+            $page = new moodle_page();
+            $renderer = new core_renderer($page, RENDERER_TARGET_GENERAL);
+
+            $html = $renderer->help_icon('shortnamecourse', 'core');
+        } finally {
+            \test_fixtures\core_renderer\before_help_icon_rendered_callbacks::$mode = 'augment';
+        }
+
+        $this->assertSame('<span class="replaced-help-icon">Replaced help icon</span>', $html);
+        $this->assertStringNotContainsString('The name displayed in areas with limited space', $html);
+    }
+
+    /**
+     * Test the hook API directly.
+     */
+    public function test_before_help_icon_rendered_hook_api(): void {
+        $page = new moodle_page();
+        $renderer = new core_renderer($page, RENDERER_TARGET_GENERAL);
+        $helpicon = new \core\output\help_icon('shortnamecourse', 'core');
+        $context = $helpicon->export_for_template($renderer);
+
+        $hook = new \core\hook\output\before_help_icon_rendered($renderer, $helpicon, $context);
+
+        $this->assertSame('shortnamecourse', $hook->get_identifier());
+        $this->assertSame('core', $hook->get_component());
+        $this->assertSame($context, $hook->get_context());
+        $this->assertSame($renderer, $hook->renderer);
+        $this->assertSame($helpicon, $hook->helpicon);
+
+        $this->assertSame('', $hook->get_before_icon());
+        $this->assertSame('', $hook->get_after_icon());
+        $this->assertFalse($hook->has_replacement());
+        $this->assertNull($hook->get_replacement());
+
+        $hook->add_before_icon('<b>1</b>');
+        $hook->add_before_icon(null);
+        $hook->add_before_icon('<b>2</b>');
+        $this->assertSame('<b>1</b><b>2</b>', $hook->get_before_icon());
+
+        $hook->add_after_icon('<i>1</i>');
+        $hook->add_after_icon('');
+        $hook->add_after_icon('<i>2</i>');
+        $this->assertSame('<i>1</i><i>2</i>', $hook->get_after_icon());
+
+        $hook->set_replacement('<span>Replaced</span>');
+        $this->assertTrue($hook->has_replacement());
+        $this->assertSame('<span>Replaced</span>', $hook->get_replacement());
+
+        $hook->set_replacement(null);
+        $this->assertFalse($hook->has_replacement());
+        $this->assertNull($hook->get_replacement());
+
+        // Modifying the context is reflected in the hook.
+        $hook->get_context()->text = 'Modified';
+        $this->assertSame('Modified', $context->text);
+    }
 }
