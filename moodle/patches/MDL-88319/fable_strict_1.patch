+namespace core\hook\output;
+
+use core\output\help_icon;
+use stdClass;
+
+/**
+ * Hook dispatched before a help icon is rendered.
+ *
+ * Callbacks can:
+ * - modify the mutable template context (e.g. `text`, `title`, `url`, `completedoclink`) to change the popover content;
+ * - add HTML before or after the help icon with {@see add_before_icon()} and {@see add_after_icon()};
+ * - replace the whole help icon output with {@see set_replacement()}, skipping the default template rendering.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @property-read \renderer_base $renderer The page renderer object
+ * @property-read help_icon $helpicon The help icon being rendered
+ * @property-read stdClass $context The mutable template context
+ */
+#[\core\attribute\tags('output')]
+#[\core\attribute\label('Allows plugins to extend, augment or replace the help icon output.')]
+final class before_help_icon_rendered {
+    /** @var string HTML to be placed before the help icon */
+    private string $before = '';
+
+    /** @var string HTML to be placed after the help icon */
+    private string $after = '';
+
+    /** @var string|null Full replacement HTML for the help icon, or null to use the default rendering */
+    private ?string $replacement = null;
+
+    /**
+     * Hook constructor.
+     *
+     * @param \renderer_base $renderer The page renderer object
+     * @param help_icon $helpicon The help icon being rendered
+     * @param stdClass $context The mutable template context exported from the help icon
+     */
+    public function __construct(
+        /** @var \renderer_base The page renderer object */
+        public readonly \renderer_base $renderer,
+        /** @var help_icon The help icon being rendered */
+        public readonly help_icon $helpicon,
+        /** @var stdClass The mutable template context */
+        public readonly stdClass $context,
+    ) {
+    }
+
+    /**
+     * Get the string identifier of the help string.
+     *
+     * @return string
+     */
+    public function get_identifier(): string {
+        return $this->helpicon->identifier;
+    }
+
+    /**
+     * Get the component of the help string.
+     *
+     * @return string
+     */
+    public function get_component(): string {
+        return $this->helpicon->component;
+    }
+
+    /**
+     * Get the mutable template context.
+     *
+     * Any properties modified on the returned object are used when rendering the help icon template.
+     *
+     * @return stdClass
+     */
+    public function get_context(): stdClass {
+        return $this->context;
+    }
+
+    /**
+     * Add HTML to be placed immediately before the help icon.
+     *
+     * @param null|string $html
+     */
+    public function add_before_icon(?string $html): void {
+        if ($html) {
+            $this->before .= $html;
+        }
+    }
+
+    /**
+     * Add HTML to be placed immediately after the help icon.
+     *
+     * @param null|string $html
+     */
+    public function add_after_icon(?string $html): void {
+        if ($html) {
+            $this->after .= $html;
+        }
+    }
+
+    /**
+     * Get the HTML collected to be placed before the help icon.
+     *
+     * @return string
+     */
+    public function get_before_icon(): string {
+        return $this->before;
+    }
+
+    /**
+     * Get the HTML collected to be placed after the help icon.
+     *
+     * @return string
+     */
+    public function get_after_icon(): string {
+        return $this->after;
+    }
+
+    /**
+     * Provide a full HTML replacement for the help icon.
+     *
+     * When a replacement is set the default template rendering is skipped entirely.
+     * Any HTML added with {@see add_before_icon()} or {@see add_after_icon()} is still placed around the replacement.
+     *
+     * @param null|string $html The replacement HTML, or null to restore the default rendering
+     */
+    public function set_replacement(?string $html): void {
+        $this->replacement = $html;
+    }
+
+    /**
+     * Whether a replacement for the help icon has been provided.
+     *
+     * @return bool
+     */
+    public function has_replacement(): bool {
+        return $this->replacement !== null;
+    }
+
+    /**
+     * Get the replacement HTML for the help icon, if any.
+     *
+     * @return null|string
+     */
+    public function get_replacement(): ?string {
+        return $this->replacement;
+    }
+}
diff --git a/public/lib/classes/output/core_renderer.php b/public/lib/classes/output/core_renderer.php
