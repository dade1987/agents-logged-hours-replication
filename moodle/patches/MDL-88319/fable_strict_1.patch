+namespace test_fixtures\core_renderer;
+
+/**
+ * Hook fixture callbacks for \core\hook\output\before_help_icon_rendered.
+ *
+ * @package   core
+ * @category  test
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+final class before_help_icon_rendered_callbacks {
+    /** @var string The mode of the fixture: 'augment' or 'replace' */
+    public static string $mode = 'augment';
+
+    /**
+     * Fixture which augments or replaces the help icon output depending on the mode.
+     *
+     * @param \core\hook\output\before_help_icon_rendered $hook
+     */
+    public static function before_help_icon_rendered(
+        \core\hook\output\before_help_icon_rendered $hook,
+    ): void {
+        if (self::$mode === 'replace') {
+            $hook->set_replacement('<span class="replaced-help-icon">Replaced help icon</span>');
+            return;
+        }
+
+        $hook->get_context()->text .= '<p class="extra-help-text">Extra help text added by a plugin</p>';
+        $hook->add_before_icon('<span class="before-help-icon">Before help icon</span>');
+        $hook->add_after_icon('<span class="after-help-icon">After help icon</span>');
+    }
+}
