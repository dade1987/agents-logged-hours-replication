+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\hook\output;
+
+/**
+ * Tests for the before_help_icon_rendered hook.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(before_help_icon_rendered::class)]
+#[\PHPUnit\Framework\Attributes\CoversClass(\core\output\core_renderer::class)]
+final class before_help_icon_rendered_test extends \advanced_testcase {
+    /**
+     * Get a core renderer.
+     *
+     * @return \core\output\core_renderer
+     */
+    private function get_renderer(): \core\output\core_renderer {
+        global $PAGE;
+        return $PAGE->get_renderer('core');
+    }
+
+    /**
+     * Without callbacks, output is the default template.
+     */
+    public function test_default_output(): void {
+        $this->resetAfterTest();
+        $output = $this->get_renderer();
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook): void {
+            $this->assertSame('fullnamecourse', $hook->identifier);
+            $this->assertSame('moodle', $hook->component);
+            $this->assertInstanceOf(\core\output\help_icon::class, $hook->helpicon);
+        });
+        $html = $output->help_icon('fullnamecourse', 'moodle');
+        $this->assertStringContainsString('btn-link', $html);
+        $this->assertStringContainsString('help-icon', $html);
+    }
+
+    /**
+     * Callbacks may modify the template context.
+     */
+    public function test_modify_context(): void {
+        $this->resetAfterTest();
+        $output = $this->get_renderer();
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook): void {
+            $hook->context->text .= '<p>EXTRA_POPOVER_CONTENT</p>';
+        });
+        $html = $output->help_icon('fullnamecourse', 'moodle');
+        $this->assertStringContainsString('EXTRA_POPOVER_CONTENT', $html);
+    }
+
+    /**
+     * Callbacks may add HTML before and after the icon.
+     */
+    public function test_before_and_after(): void {
+        $this->resetAfterTest();
+        $output = $this->get_renderer();
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook): void {
+            $hook->add_before_icon('<span>BEFORE1</span>');
+            $hook->add_before_icon('<span>BEFORE2</span>');
+            $hook->add_after_icon('<span>AFTER</span>');
+        });
+        $html = $output->help_icon('fullnamecourse', 'moodle');
+        $this->assertStringStartsWith('<span>BEFORE1</span><span>BEFORE2</span>', $html);
+        $this->assertStringEndsWith('<span>AFTER</span>', $html);
+        $this->assertStringContainsString('help-icon', $html);
+    }
+
+    /**
+     * Callbacks may replace the icon entirely.
+     */
+    public function test_replacement(): void {
+        $this->resetAfterTest();
+        $output = $this->get_renderer();
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook): void {
+            $hook->set_replacement('<a href="#">REPLACED</a>');
+            $hook->add_after_icon('<span>AFTER</span>');
+        });
+        $html = $output->help_icon('fullnamecourse', 'moodle');
+        $this->assertSame('<a href="#">REPLACED</a><span>AFTER</span>', $html);
+    }
+
+    /**
+     * Replacement can be reset and checked.
+     */
+    public function test_replacement_api(): void {
+        $output = $this->get_renderer();
+        $icon = new \core\output\help_icon('fullnamecourse', 'moodle');
+        $hook = new before_help_icon_rendered($output, $icon, $icon->export_for_template($output));
+        $this->assertFalse($hook->has_replacement());
+        $hook->set_replacement('');
+        $this->assertTrue($hook->has_replacement());
+        $this->assertSame('', $hook->get_replacement());
+        $hook->set_replacement(null);
+        $this->assertFalse($hook->has_replacement());
+        $this->assertSame('', $hook->get_before_icon());
+        $this->assertSame('', $hook->get_after_icon());
+    }
+}
