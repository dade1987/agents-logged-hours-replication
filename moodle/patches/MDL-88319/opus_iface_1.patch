+
+namespace core\hook\output;
+
+/**
+ * Tests for the before_help_icon_rendered hook.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(before_help_icon_rendered::class)]
+final class before_help_icon_rendered_test extends \advanced_testcase {
+    /**
+     * Render a help icon using the page renderer.
+     *
+     * @return string
+     */
+    private function render_icon(): string {
+        global $PAGE;
+        return $PAGE->get_renderer('core')->help_icon('activities', 'moodle');
+    }
+
+    /**
+     * Test the hook accessors.
+     */
+    public function test_accessors(): void {
+        global $PAGE;
+        $renderer = $PAGE->get_renderer('core');
+        $icon = new \core\output\help_icon('activities', 'moodle');
+        $context = (object) ['text' => 'Hello'];
+        $hook = new before_help_icon_rendered($renderer, $icon, $context);
+
+        $this->assertSame($renderer, $hook->renderer);
+        $this->assertSame($icon, $hook->get_help_icon());
+        $this->assertSame('activities', $hook->get_identifier());
+        $this->assertSame('moodle', $hook->get_component());
+        $this->assertSame($context, $hook->get_context());
+        $this->assertSame('', $hook->get_before_icon_html());
+        $this->assertSame('', $hook->get_after_icon_html());
+        $this->assertFalse($hook->has_replacement());
+        $this->assertNull($hook->get_replacement());
+
+        $hook->add_before_icon('<b>1</b>');
+        $hook->add_before_icon('<b>2</b>');
+        $hook->add_after_icon('<i>3</i>');
+        $hook->set_replacement('<span>r</span>');
+        $this->assertSame('<b>1</b><b>2</b>', $hook->get_before_icon_html());
+        $this->assertSame('<i>3</i>', $hook->get_after_icon_html());
+        $this->assertTrue($hook->has_replacement());
+        $this->assertSame('<span>r</span>', $hook->get_replacement());
+    }
+
+    /**
+     * Test that the context can be modified by a callback.
+     */
+    public function test_modify_context(): void {
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook): void {
+            $hook->get_context()->text .= '<p>EXTRA-HELP-CONTENT</p>';
+        });
+        $this->assertStringContainsString('EXTRA-HELP-CONTENT', $this->render_icon());
+    }
+
+    /**
+     * Test that HTML can be added before and after the icon.
+     */
+    public function test_add_before_and_after(): void {
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook): void {
+            $hook->add_before_icon('<span id="before-marker"></span>');
+            $hook->add_after_icon('<span id="after-marker"></span>');
+        });
+        $html = $this->render_icon();
+        $this->assertStringStartsWith('<span id="before-marker"></span>', $html);
+        $this->assertStringEndsWith('<span id="after-marker"></span>', $html);
+        $this->assertStringContainsString('btn-link', $html);
+    }
+
+    /**
+     * Test that the icon can be replaced entirely.
+     */
+    public function test_replacement(): void {
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook): void {
+            $hook->set_replacement('<span>REPLACED</span>');
+            $hook->add_after_icon('<span>AFTER</span>');
+        });
+        $this->assertSame('<span>REPLACED</span><span>AFTER</span>', $this->render_icon());
+    }
+}
