+namespace core\hook\output;
+
+use core\output\help_icon;
+use core\output\renderer_base;
+use stdClass;
+
+/**
+ * Hook dispatched before a help icon is rendered.
+ *
+ * Callbacks may:
+ * - modify the template context (for example the popover text, title, or URL);
+ * - add HTML before or after the help icon;
+ * - replace the help icon output completely.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @property-read renderer_base $renderer The page renderer object
+ * @property-read help_icon $helpicon The help icon being rendered
+ * @property-read stdClass $context The mutable template context
+ */
+#[\core\attribute\tags('output')]
+#[\core\attribute\label('Allows plugins to extend, augment, or replace the output of help icons.')]
+final class before_help_icon_rendered {
+    /** @var string[] HTML fragments to add before the help icon */
+    private array $beforehtml = [];
+
+    /** @var string[] HTML fragments to add after the help icon */
+    private array $afterhtml = [];
+
+    /** @var string|null HTML which completely replaces the help icon */
+    private ?string $replacement = null;
+
+    /**
+     * Constructor for the hook.
+     *
+     * @param renderer_base $renderer The page renderer object
+     * @param help_icon $helpicon The help icon being rendered
+     * @param stdClass $context The template context, which callbacks may modify
+     */
+    public function __construct(
+        /** @var renderer_base The page renderer object */
+        public readonly renderer_base $renderer,
+        /** @var help_icon The help icon being rendered */
+        public readonly help_icon $helpicon,
+        /** @var stdClass The template context used to render the help icon */
+        public readonly stdClass $context,
+    ) {
+    }
+
+    /**
+     * Get the help icon being rendered.
+     *
+     * @return help_icon
+     */
+    public function get_help_icon(): help_icon {
+        return $this->helpicon;
+    }
+
+    /**
+     * Get the string identifier of the help icon.
+     *
+     * @return string
+     */
+    public function get_identifier(): string {
+        return (string) $this->helpicon->identifier;
+    }
+
+    /**
+     * Get the component of the help icon.
+     *
+     * @return string
+     */
+    public function get_component(): string {
+        return (string) $this->helpicon->component;
+    }
+
+    /**
+     * Get the mutable template context.
+     *
+     * Properties of the returned object may be changed directly to alter the rendered output.
+     *
+     * @return stdClass
+     */
+    public function get_context(): stdClass {
+        return $this->context;
+    }
+
+    /**
+     * Add HTML to be output immediately before the help icon.
+     *
+     * @param string $html
+     */
+    public function add_before_icon(string $html): void {
+        $this->beforehtml[] = $html;
+    }
+
+    /**
+     * Add HTML to be output immediately after the help icon.
+     *
+     * @param string $html
+     */
+    public function add_after_icon(string $html): void {
+        $this->afterhtml[] = $html;
+    }
+
+    /**
+     * Get the HTML to be output before the help icon.
+     *
+     * @return string
+     */
+    public function get_before_icon_html(): string {
+        return implode('', $this->beforehtml);
+    }
+
+    /**
+     * Get the HTML to be output after the help icon.
+     *
+     * @return string
+     */
+    public function get_after_icon_html(): string {
+        return implode('', $this->afterhtml);
+    }
+
+    /**
+     * Completely replace the help icon output with the supplied HTML.
+     *
+     * When a replacement is set the default template is not rendered.
+     * Passing null removes any previously set replacement.
+     *
+     * @param string|null $html
+     */
+    public function set_replacement(?string $html): void {
+        $this->replacement = $html;
+    }
+
+    /**
+     * Get the replacement HTML, if any.
+     *
+     * @return string|null
+     */
+    public function get_replacement(): ?string {
+        return $this->replacement;
+    }
+
+    /**
+     * Whether a replacement has been set.
+     *
+     * @return bool
+     */
+    public function has_replacement(): bool {
+        return $this->replacement !== null;
+    }
+}
diff --git a/public/lib/classes/output/core_renderer.php b/public/lib/classes/output/core_renderer.php
index 96247633e67..586db7d313d 100644
--- a/public/lib/classes/output/core_renderer.php
+++ b/public/lib/classes/output/core_renderer.php
@@ -35,6 +35,7 @@ use core\exception\coding_exception;
 use core\hook\manager as hook_manager;
 use core\hook\output\after_standard_main_region_html_generation;
 use core\hook\output\before_footer_html_generation;
+use core\hook\output\before_help_icon_rendered;
 use core\hook\output\before_html_attributes;
 use core\hook\output\before_http_headers;
 use core\hook\output\before_standard_footer_html_generation;
@@ -2255,7 +2256,22 @@ class core_renderer extends renderer_base {
      */
     protected function render_help_icon(help_icon $helpicon) {
         $context = $helpicon->export_for_template($this);
-        return $this->render_from_template('core/help_icon', $context);
+
+        // Allow plugins to modify the context, add content around the icon, or replace it entirely.
+        $hook = new before_help_icon_rendered(
+            renderer: $this,
+            helpicon: $helpicon,
+            context: $context,
+        );
+        di::get(hook_manager::class)->dispatch($hook);
+
+        if ($hook->has_replacement()) {
+            $output = $hook->get_replacement();
+        } else {
+            $output = $this->render_from_template('core/help_icon', $hook->get_context());
+        }
+
+        return $hook->get_before_icon_html() . $output . $hook->get_after_icon_html();
     }
 
     /**
