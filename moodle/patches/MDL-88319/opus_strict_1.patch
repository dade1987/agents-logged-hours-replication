+// along with Moodle.  If not, see <https://www.gnu.org/licenses/>.
+
+namespace core\hook\output;
+
+/**
+ * Tests for before_help_icon_rendered hook.
+ *
+ * @package    core
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(before_help_icon_rendered::class)]
+#[\PHPUnit\Framework\Attributes\CoversMethod(\core\output\core_renderer::class, 'render_help_icon')]
+final class before_help_icon_rendered_test extends \advanced_testcase {
+    /**
+     * Test that without callbacks the default output is unchanged.
+     */
+    public function test_default_output(): void {
+        global $OUTPUT;
+        $this->resetAfterTest();
+
+        $html = $OUTPUT->help_icon('allowstealthmodules', 'moodle');
+        $this->assertStringContainsString('btn-link', $html);
+        $this->assertStringContainsString('/help.php', $html);
+    }
+
+    /**
+     * Test that the hook exposes the help icon data.
+     */
+    public function test_hook_properties(): void {
+        global $OUTPUT;
+        $this->resetAfterTest();
+
+        $captured = null;
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook) use (&$captured) {
+            $captured = $hook;
+        });
+        $OUTPUT->help_icon('allowstealthmodules', 'moodle');
+        $this->stopHookRedirections();
+
+        $this->assertInstanceOf(before_help_icon_rendered::class, $captured);
+        $this->assertSame('allowstealthmodules', $captured->get_identifier());
+        $this->assertSame('moodle', $captured->get_component());
+        $this->assertInstanceOf(\core\output\help_icon::class, $captured->get_help_icon());
+        $this->assertInstanceOf(\stdClass::class, $captured->get_context());
+        $this->assertFalse($captured->has_replacement());
+    }
+
+    /**
+     * Test modifying the template context.
+     */
+    public function test_modify_context(): void {
+        global $OUTPUT;
+        $this->resetAfterTest();
+
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook) {
+            $hook->get_context()->text .= '<p>EXTRA_HELP_CONTENT</p>';
+        });
+        $html = $OUTPUT->help_icon('allowstealthmodules', 'moodle');
+        $this->stopHookRedirections();
+
+        $this->assertStringContainsString('EXTRA_HELP_CONTENT', $html);
+    }
+
+    /**
+     * Test adding HTML before and after the icon.
+     */
+    public function test_add_before_and_after(): void {
+        global $OUTPUT;
+        $this->resetAfterTest();
+
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook) {
+            $hook->add_before_icon('<span>BEFORE1</span>');
+            $hook->add_before_icon('<span>BEFORE2</span>');
+            $hook->add_after_icon('<span>AFTER1</span>');
+            $hook->add_after_icon('<span>AFTER2</span>');
+        });
+        $html = $OUTPUT->help_icon('allowstealthmodules', 'moodle');
+        $this->stopHookRedirections();
+
+        $this->assertStringStartsWith('<span>BEFORE1</span><span>BEFORE2</span>', $html);
+        $this->assertStringEndsWith('<span>AFTER1</span><span>AFTER2</span>', $html);
+        $this->assertStringContainsString('/help.php', $html);
+    }
+
+    /**
+     * Test replacing the icon.
+     */
+    public function test_set_replacement(): void {
+        global $OUTPUT;
+        $this->resetAfterTest();
+
+        $this->redirectHook(before_help_icon_rendered::class, function (before_help_icon_rendered $hook) {
+            $hook->set_replacement('<a href="#">REPLACED</a>');
+        });
+        $html = $OUTPUT->help_icon('allowstealthmodules', 'moodle');
+        $this->stopHookRedirections();
+
+        $this->assertSame('<a href="#">REPLACED</a>', $html);
+    }
+
+    /**
+     * Test the hook API in isolation.
+     */
+    public function test_hook_api(): void {
+        global $PAGE;
+        $this->resetAfterTest();
+
+        $renderer = $PAGE->get_renderer('core');
+        $icon = new \core\output\help_icon('allowstealthmodules', 'moodle');
+        $context = new \stdClass();
+        $hook = new before_help_icon_rendered($renderer, $icon, $context);
+
+        $this->assertSame('', $hook->get_before_icon());
+        $this->assertSame('', $hook->get_after_icon());
+        $this->assertNull($hook->get_replacement());
+        $this->assertSame($context, $hook->get_context());
+
+        $hook->add_before_icon('');
+        $hook->add_after_icon('');
+        $this->assertSame('', $hook->get_before_icon());
+        $this->assertSame('', $hook->get_after_icon());
+
+        $hook->set_replacement('X');
+        $this->assertTrue($hook->has_replacement());
+        $hook->set_replacement(null);
+        $this->assertFalse($hook->has_replacement());
+    }
+}
