+namespace core\hook\output;
+
+/**
+ * Hook to allow subscribers to extend, augment or replace the help icon output.
+ *
+ * Subscribers can:
+ * - modify the popover content by changing the properties of the template context ({@see self::$context});
+ * - add HTML immediately before or after the help icon ({@see self::add_before_icon()}, {@see self::add_after_icon()});
+ * - completely replace the help icon output ({@see self::set_replacement()}), in which case the default template is skipped.
+ *
+ * @package    core
+ * @copyright  2026 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @property-read \renderer_base $renderer The page renderer object
+ * @property-read \help_icon $helpicon The help icon being rendered
+ * @property \stdClass $context The template context used to render the help icon popover
+ */
+#[\core\attribute\tags('output')]
+#[\core\attribute\label('Allows plugins to extend, augment or replace help icon output')]
+final class before_help_icon_rendered {
+    /** @var null|string HTML that completely replaces the default help icon output */
+    private ?string $replacement = null;
+
+    /** @var string HTML to place immediately before the help icon */
+    private string $beforeicon = '';
+
+    /** @var string HTML to place immediately after the help icon */
+    private string $aftericon = '';
+
+    /**
+     * Constructor for the before_help_icon_rendered hook.
+     *
+     * @param \renderer_base $renderer The page renderer object
+     * @param \help_icon $helpicon The help icon being rendered
+     * @param \stdClass $context The template context for the help icon, which subscribers may modify
+     */
+    public function __construct(
+        /** @var \renderer_base The page renderer object */
+        public readonly \renderer_base $renderer,
+        /** @var \help_icon The help icon being rendered */
+        public readonly \help_icon $helpicon,
+        /** @var \stdClass The template context used to render the help icon popover */
+        public \stdClass $context,
+    ) {
+    }
+
+    /**
+     * Add HTML to be placed immediately before the help icon.
+     *
+     * Multiple callbacks may each add HTML; the fragments are appended in dispatch order.
+     *
+     * @param null|string $html A valid HTML fragment
+     */
+    public function add_before_icon(?string $html): void {
+        if ($html) {
+            $this->beforeicon .= $html;
+        }
+    }
+
+    /**
+     * Add HTML to be placed immediately after the help icon.
+     *
+     * Multiple callbacks may each add HTML; the fragments are appended in dispatch order.
+     *
+     * @param null|string $html A valid HTML fragment
+     */
+    public function add_after_icon(?string $html): void {
+        if ($html) {
+            $this->aftericon .= $html;
+        }
+    }
+
+    /**
+     * Get the HTML to be placed immediately before the help icon.
+     *
+     * @return string
+     */
+    public function get_before_icon(): string {
+        return $this->beforeicon;
+    }
+
+    /**
+     * Get the HTML to be placed immediately after the help icon.
+     *
+     * @return string
+     */
+    public function get_after_icon(): string {
+        return $this->aftericon;
+    }
+
+    /**
+     * Replace the entire help icon output with the given HTML.
+     *
+     * When a replacement is set, the default template rendering is skipped.
+     *
+     * @param null|string $html A valid HTML fragment
+     */
+    public function set_replacement(?string $html): void {
+        $this->replacement = $html;
+    }
+
+    /**
+     * Whether a replacement for the help icon output has been provided.
+     *
+     * @return bool
+     */
+    public function has_replacement(): bool {
+        return $this->replacement !== null;
+    }
+
+    /**
+     * Get the replacement HTML for the help icon output.
+     *
+     * @return null|string
+     */
+    public function get_replacement(): ?string {
+        return $this->replacement;
+    }
+}
