+namespace core\hook\output;
+
+use renderer_base;
+use stdClass;
+
+/**
+ * Hook dispatched before a help icon is rendered.
+ *
+ * Allows plugins to modify the template context, add HTML before or after
+ * the help icon, or replace the help icon completely.
+ *
+ * @package    core
+ * @copyright  2025 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\core\attribute\tags('output')]
+#[\core\attribute\label('Allows plugins to extend, augment or replace the help icon output.')]
+final class before_help_icon_rendered {
+    /** @var string HTML to add before the icon */
+    private string $before = '';
+
+    /** @var string HTML to add after the icon */
+    private string $after = '';
+
+    /** @var string|null Full replacement HTML */
+    private ?string $replacement = null;
+
+    /**
+     * Constructor.
+     *
+     * @param renderer_base $renderer The renderer
+     * @param stdClass $context The mutable template context for core/help_icon
+     * @param string $identifier The help string identifier
+     * @param string $component The help string component
+     */
+    public function __construct(
+        /** @var renderer_base The renderer */
+        public readonly renderer_base $renderer,
+        /** @var stdClass The mutable template context */
+        public readonly stdClass $context,
+        /** @var string The help string identifier */
+        public readonly string $identifier = '',
+        /** @var string The help string component */
+        public readonly string $component = '',
+    ) {
+    }
+
+    /**
+     * Add HTML immediately before the help icon.
+     *
+     * @param string $html
+     */
+    public function add_before_icon(string $html): void {
+        $this->before .= $html;
+    }
+
+    /**
+     * Add HTML immediately after the help icon.
+     *
+     * @param string $html
+     */
+    public function add_after_icon(string $html): void {
+        $this->after .= $html;
+    }
+
+    /**
+     * Replace the help icon completely, skipping the default template.
+     *
+     * @param string $html
+     */
+    public function set_replacement(string $html): void {
+        $this->replacement = $html;
+    }
+
+    /**
+     * Whether a replacement has been set.
+     *
+     * @return bool
+     */
+    public function has_replacement(): bool {
+        return $this->replacement !== null;
+    }
+
+    /**
+     * Get the replacement HTML.
+     *
+     * @return string|null
+     */
+    public function get_replacement(): ?string {
+        return $this->replacement;
+    }
+
+    /**
+     * Get HTML to place before the icon.
+     *
+     * @return string
+     */
+    public function get_before_icon(): string {
+        return $this->before;
+    }
+
+    /**
+     * Get HTML to place after the icon.
+     *
+     * @return string
+     */
+    public function get_after_icon(): string {
+        return $this->after;
+    }
+}
