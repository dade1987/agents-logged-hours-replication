+namespace core\hook\output;
+
+use stdClass;
+
+/**
+ * Hook dispatched before a help icon is rendered.
+ *
+ * Callbacks can modify the mutable template context, add HTML before or after
+ * the help icon, or replace the help icon output entirely.
+ *
+ * @package    core
+ * @copyright  2026 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\core\attribute\label('Allows plugins to extend, augment, or replace help icon output')]
+#[\core\attribute\tags('output')]
+final class before_help_icon_rendered {
+    /** @var string HTML to be output before the help icon */
+    private string $beforeicon = '';
+
+    /** @var string HTML to be output after the help icon */
+    private string $aftericon = '';
+
+    /** @var string|null Full replacement HTML, or null to use the default rendering */
+    private ?string $replacement = null;
+
+    /**
+     * Create a new instance of the hook.
+     *
+     * @param stdClass $context The mutable template context for core/help_icon
+     * @param string $identifier The help string identifier
+     * @param string $component The help string component
+     */
+    public function __construct(
+        /** @var stdClass The mutable template context */
+        public readonly stdClass $context,
+        /** @var string The help string identifier */
+        public readonly string $identifier = '',
+        /** @var string The help string component */
+        public readonly string $component = '',
+    ) {
+    }
+
+    /**
+     * Get the mutable template context.
+     *
+     * @return stdClass
+     */
+    public function get_context(): stdClass {
+        return $this->context;
+    }
+
+    /**
+     * Get the help string identifier.
+     *
+     * @return string
+     */
+    public function get_identifier(): string {
+        return $this->identifier;
+    }
+
+    /**
+     * Get the help string component.
+     *
+     * @return string
+     */
+    public function get_component(): string {
+        return $this->component;
+    }
+
+    /**
+     * Add HTML to be rendered immediately before the help icon.
+     *
+     * @param string $html
+     */
+    public function add_before_icon(string $html): void {
+        $this->beforeicon .= $html;
+    }
+
+    /**
+     * Add HTML to be rendered immediately after the help icon.
+     *
+     * @param string $html
+     */
+    public function add_after_icon(string $html): void {
+        $this->aftericon .= $html;
+    }
+
+    /**
+     * Get the HTML to be rendered before the help icon.
+     *
+     * @return string
+     */
+    public function get_before_icon(): string {
+        return $this->beforeicon;
+    }
+
+    /**
+     * Get the HTML to be rendered after the help icon.
+     *
+     * @return string
+     */
+    public function get_after_icon(): string {
+        return $this->aftericon;
+    }
+
+    /**
+     * Replace the help icon completely with the given HTML.
+     *
+     * @param string $html
+     */
+    public function set_replacement(string $html): void {
+        $this->replacement = $html;
+    }
+
+    /**
+     * Whether a replacement has been provided.
+     *
+     * @return bool
+     */
+    public function has_replacement(): bool {
+        return $this->replacement !== null;
+    }
+
+    /**
+     * Get the replacement HTML, if any.
+     *
+     * @return string|null
+     */
+    public function get_replacement(): ?string {
+        return $this->replacement;
+    }
+}
