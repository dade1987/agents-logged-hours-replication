+    public function test_new_page_without_createpage_capability(): void {
+        $this->create_individual_wikis_with_groups();
+
+        $pagetitle = 'Page Title';
+        $pagecontent = 'Page content';
+
+        // Prohibit the createpage capability for students, keeping editpage.
+        $contextcourse = \context_course::instance($this->course->id);
+        assign_capability('mod/wiki:createpage', CAP_PROHIBIT, $this->studentrole->id, $contextcourse->id);
+        accesslib_clear_all_caches_for_unit_testing();
+
+        $this->setUser($this->student);
+
+        // Test on existing subwiki.
+        try {
+            mod_wiki_external::new_page($pagetitle, $pagecontent, 'html', $this->fpsepg1indstu->subwikiid);
+            $this->fail('Exception expected due to missing createpage capability.');
