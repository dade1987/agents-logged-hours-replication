+
+        $this->assertSame([], override_manager::get_effective_open_close_times($quizobj->get_quizid(), $user->id));
+        $this->assertDebuggingCalled();
+
+        $manager = $quizobj->get_override_manager();
+        $manager->save_override([
+            'userid' => $user->id,
+            'timeopen' => 400,
+            'timeclose' => 500,
+            'duedate' => 450,
+        ]);
+
+        $this->assertEquals([
+            'timeopen' => 400,
+            'timeclose' => 500,
+        ], override_manager::get_effective_open_close_times($quizobj->get_quizid(), $user->id));
+        $this->assertDebuggingCalled();
+    }
