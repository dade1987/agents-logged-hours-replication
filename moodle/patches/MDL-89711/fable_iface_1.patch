+    /**
+     * Test the deprecated get_effective_open_close_times() still works, delegating to get_effective_times()
+     * and returning only the timeopen/timeclose keys.
+     */
+    public function test_get_effective_open_close_times_deprecated(): void {
+        $this->setAdminUser();
+        $this->resetAfterTest();
+
+        [$quizobj, $course] = $this->create_quiz_and_course();
+        $user = $this->getDataGenerator()->create_and_enrol($course);
+
+        $manager = $quizobj->get_override_manager();
+        $manager->save_override(['userid' => $user->id, 'timeopen' => 100, 'timeclose' => 200, 'duedate' => 150]);
+
+        $result = override_manager::get_effective_open_close_times($quizobj->get_quizid(), $user->id);
+        $this->assertDebuggingCalledCount(1);
+        $this->assertEquals(['timeopen' => 100, 'timeclose' => 200], $result);
+        $this->assertArrayNotHasKey('duedate', $result);
+    }
