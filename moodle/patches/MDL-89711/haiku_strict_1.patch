+    /**
+     * Test the deprecated get_effective_open_close_times() still returns only the timeopen and timeclose keys.
+     */
+    public function test_get_effective_open_close_times_deprecated(): void {
+        $this->setAdminUser();
+        $this->resetAfterTest();
+
+        [$quizobj, $course] = $this->create_quiz_and_course();
+        $user = $this->getDataGenerator()->create_and_enrol($course);
+        $manager = $quizobj->get_override_manager();
+        $manager->save_override([
+            'userid' => $user->id,
+            'timeopen' => 400,
+            'timeclose' => 500,
+            'duedate' => 450,
+        ]);
+
+        $result = override_manager::get_effective_open_close_times($quizobj->get_quizid(), $user->id);
+        $this->assertDebuggingCalled();
+        $this->assertEquals(['timeopen' => 400, 'timeclose' => 500], $result);
+    }
