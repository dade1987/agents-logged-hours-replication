+    /**
+     * Computes the effective overridden open and close times for a user for a given quiz.
+     *
+     * @param int $quizid The quiz ID.
+     * @param int $userid The user ID.
+     * @return array Array with optional keys 'timeopen' and 'timeclose'.
+     * @deprecated since Moodle 5.3 MDL-89711 - use {@see self::get_effective_times()} instead.
+     * @todo Final deprecation in Moodle 6.0 MDL-89711.
+     */
+    #[\core\attribute\deprecated(
+        'mod_quiz\local\override_manager::get_effective_times',
+        since: '5.3',
+        mdl: 'MDL-89711',
+    )]
+    public static function get_effective_open_close_times(int $quizid, int $userid): array {
+        \core\deprecation::emit_deprecation([self::class, __FUNCTION__]);
+        return array_intersect_key(
+            self::get_effective_times($quizid, $userid),
+            array_flip(['timeopen', 'timeclose']),
+        );
+    }
