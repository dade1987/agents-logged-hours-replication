+    /**
+     * Test the deprecated get_effective_open_close_times() still works, emits a deprecation
+     * warning, and only returns the timeopen/timeclose keys.
+     */
+    public function test_get_effective_open_close_times_deprecated(): void {
+        $this->setAdminUser();
+        $this->resetAfterTest();
+
+        [$quizobj, $course] = $this->create_quiz_and_course();
+        $user = $this->getDataGenerator()->create_and_enrol($course);
+
+        $manager = $quizobj->get_override_manager();
+        $manager->save_override([
+            'userid' => $user->id,
+            'timeopen' => 200,
+            'timeclose' => 300,
+            'duedate' => 250,
+        ]);
+
+        $result = override_manager::get_effective_open_close_times($quizobj->get_quizid(), $user->id);
+        $this->assertDebuggingCalledCount(1);
+
+        // Only timeopen and timeclose are returned, to preserve the original return contract.
+        $this->assertEquals([
+            'timeopen' => 200,
+            'timeclose' => 300,
+        ], $result);
+        $this->assertArrayNotHasKey('duedate', $result);
+    }
+
