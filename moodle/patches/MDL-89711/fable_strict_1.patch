@@ -698,6 +698,31 @@ class override_manager {
         return $result;
     }
 
+    /**
+     * Computes the effective overridden open and close times for a user for a given quiz.
+     *
+     * @param int $quizid The quiz ID.
+     * @param int $userid The user ID.
+     * @return array Array with optional keys 'timeopen' and 'timeclose'.
+     * @since Moodle 5.2
+     * @deprecated Since Moodle 5.3 MDL-82521. Use get_effective_times() instead.
+     * @todo Final deprecation in Moodle 6.1 (MDL-89711).
+     */
+    #[\core\attribute\deprecated(
+        'mod_quiz\local\override_manager::get_effective_times',
+        since: '5.3',
+        reason: 'The method was renamed to get_effective_times() as it now also returns the effective due date',
+        mdl: 'MDL-82521',
+    )]
+    public static function get_effective_open_close_times(int $quizid, int $userid): array {
+        \core\deprecation::emit_deprecation([self::class, __FUNCTION__]);
+
+        $times = self::get_effective_times($quizid, $userid);
+
+        // Preserve the original return contract, which only included the open and close times.
+        return array_intersect_key($times, array_flip(['timeopen', 'timeclose']));
+    }
+
