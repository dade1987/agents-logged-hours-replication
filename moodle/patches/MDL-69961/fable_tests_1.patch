@@ -161,6 +161,73 @@ final class login_lib_test extends \advanced_testcase {
         $sink->clear();
     }
 
+    /**
+     * Generating a new password reset token must invalidate any existing tokens for the user.
+     */
+    public function test_core_login_generate_password_reset_invalidates_existing_tokens(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $user = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+        $otheruser = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+
+        $first = core_login_generate_password_reset($user);
+        $other = core_login_generate_password_reset($otheruser);
+        $this->assertCount(1, $DB->get_records('user_password_resets', ['userid' => $user->id]));
+
+        $second = core_login_generate_password_reset($user);
+        $this->assertNotEquals($first->token, $second->token);
+
+        $records = $DB->get_records('user_password_resets', ['userid' => $user->id]);
+        $this->assertCount(1, $records);
+        $this->assertSame($second->token, reset($records)->token);
+        $this->assertFalse($DB->record_exists('user_password_resets', ['token' => $first->token]));
+
+        // Tokens belonging to other users are not affected.
+        $this->assertTrue($DB->record_exists('user_password_resets', ['id' => $other->id]));
+    }
+
+    /**
+     * Changing the email address of a user must invalidate any existing password reset tokens.
+     */
+    public function test_password_reset_tokens_invalidated_on_email_change(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $user = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+        $otheruser = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+
+        core_login_generate_password_reset($user);
+        $other = core_login_generate_password_reset($otheruser);
+
+        // Updating something other than the email keeps the token.
+        \core\user::update_user((object) ['id' => $user->id, 'city' => 'Perth']);
+        $this->assertTrue($DB->record_exists('user_password_resets', ['userid' => $user->id]));
+
+        // Updating the email address removes the token.
+        \core\user::update_user((object) ['id' => $user->id, 'email' => 'newaddress@example.com']);
+        $this->assertFalse($DB->record_exists('user_password_resets', ['userid' => $user->id]));
+        $this->assertTrue($DB->record_exists('user_password_resets', ['id' => $other->id]));
+    }
+
+    /**
+     * Changing the password of a user must invalidate any existing password reset tokens.
