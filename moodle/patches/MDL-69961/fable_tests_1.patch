+    public function test_update_removes_password_reset_tokens(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $service = $this->get_service();
+        $password = 'samepassword';
+        $user = $this->getDataGenerator()->create_user(['auth' => 'manual', 'password' => $password]);
+        $otheruser = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+
+        $tokenid = $DB->insert_record('user_password_resets', (object) [
+            'timerequested' => time(),
+            'userid' => $user->id,
+            'token' => random_string(32),
+        ]);
+        $othertokenid = $DB->insert_record('user_password_resets', (object) [
+            'timerequested' => time(),
+            'userid' => $otheruser->id,
+            'token' => random_string(32),
+        ]);
+
+        // An unchanged password keeps the token.
+        $service->update($user, $password);
+        $this->assertTrue($DB->record_exists('user_password_resets', ['id' => $tokenid]));
+
+        // A changed password removes the token, but only for this user.
+        $service->update($user, 'newpassword');
+        $this->assertFalse($DB->record_exists('user_password_resets', ['id' => $tokenid]));
+        $this->assertTrue($DB->record_exists('user_password_resets', ['id' => $othertokenid]));
+    }
