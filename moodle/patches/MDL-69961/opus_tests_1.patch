 function core_login_generate_password_reset ($user) {
     global $DB;
+
+    // Remove any existing password reset tokens for this user, only the newest one should be valid.
+    $DB->delete_records('user_password_resets', ['userid' => $user->id]);
+
     $resetrecord = new stdClass();
     $resetrecord->timerequested = time();
     $resetrecord->userid = $user->id;
diff --git a/public/login/tests/login_lib_test.php b/public/login/tests/login_lib_test.php
index ece1da31dcb..949b60631cd 100644
--- a/public/login/tests/login_lib_test.php
+++ b/public/login/tests/login_lib_test.php
@@ -448,4 +448,63 @@ final class login_lib_test extends \advanced_testcase {
         \moodle_phpmailer::$validator = $defaultvalidator;
     }
 
+
+    /**
+     * Generating a new password reset token removes any existing ones for the user.
+     */
+    public function test_core_login_generate_password_reset_removes_existing(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $user = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+        $other = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+
+        $first = core_login_generate_password_reset($user);
+        $otherreset = core_login_generate_password_reset($other);
+        $second = core_login_generate_password_reset($user);
+
+        $records = $DB->get_records('user_password_resets', ['userid' => $user->id]);
+        $this->assertCount(1, $records);
+        $this->assertEquals($second->token, reset($records)->token);
+        $this->assertFalse($DB->record_exists('user_password_resets', ['token' => $first->token]));
+        $this->assertTrue($DB->record_exists('user_password_resets', ['token' => $otherreset->token]));
+    }
+
+    /**
+     * Changing the user email address invalidates password reset tokens.
+     */
+    public function test_password_reset_tokens_removed_on_email_change(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $user = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+        $other = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+        core_login_generate_password_reset($user);
+        core_login_generate_password_reset($other);
+
+        // Updating something other than the email keeps the token.
+        \core\user::update_user((object) ['id' => $user->id, 'firstname' => 'Changed']);
+        $this->assertTrue($DB->record_exists('user_password_resets', ['userid' => $user->id]));
+
+        \core\user::update_user((object) ['id' => $user->id, 'email' => 'newaddress@example.com']);
+        $this->assertFalse($DB->record_exists('user_password_resets', ['userid' => $user->id]));
+        $this->assertTrue($DB->record_exists('user_password_resets', ['userid' => $other->id]));
+    }
+
+    /**
+     * Changing the user password invalidates password reset tokens.
+     */
+    public function test_password_reset_tokens_removed_on_password_change(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $user = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+        $other = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+        core_login_generate_password_reset($user);
+        core_login_generate_password_reset($other);
+
+        update_internal_user_password($user, 'NewPassword!123');
+        $this->assertFalse($DB->record_exists('user_password_resets', ['userid' => $user->id]));
+        $this->assertTrue($DB->record_exists('user_password_resets', ['userid' => $other->id]));
+    }
 }
