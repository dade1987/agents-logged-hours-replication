+    /**
+     * Requesting a password reset again must invalidate the previous token and issue a new one.
+     */
+    public function test_core_login_process_password_reset_new_request_invalidates_previous_token(): void {
+        global $CFG, $DB;
+
+        $this->resetAfterTest();
+        $CFG->protectusernames = 0;
+        $user = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+
+        $sink = $this->redirectEmails();
+
+        [$status] = core_login_process_password_reset($user->username, null);
+        $this->assertSame('emailresetconfirmsent', $status);
+        $first = $DB->get_record('user_password_resets', ['userid' => $user->id], '*', MUST_EXIST);
+
+        // Request again - a new token must be generated and the old one removed.
+        [$status] = core_login_process_password_reset($user->username, null);
+        $this->assertSame('emailresetconfirmsent', $status);
+        $records = $DB->get_records('user_password_resets', ['userid' => $user->id]);
+        $this->assertCount(1, $records);
+        $second = reset($records);
+        $this->assertNotEquals($first->token, $second->token);
+        $this->assertFalse($DB->record_exists('user_password_resets', ['token' => $first->token]));
+        $this->assertNotEmpty($second->timererequested);
+
+        // The new token is the one sent in the latest email.
+        $emails = $sink->get_messages();
+        $this->assertCount(2, $emails);
+        $email = array_pop($emails);
+        $this->assertStringContainsString($second->token, quoted_printable_decode($email->body));
+        $this->assertStringNotContainsString($first->token, quoted_printable_decode($email->body));
+        $sink->clear();
+    }
+
+    /**
+     * Generating a new password reset token must remove any existing tokens for the user.
+     */
+    public function test_core_login_generate_password_reset_removes_existing_tokens(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $user = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+        $otheruser = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+
+        $first = core_login_generate_password_reset($user);
+        $other = core_login_generate_password_reset($otheruser);
+        $second = core_login_generate_password_reset($user);
+
+        $this->assertNotEquals($first->token, $second->token);
+        $this->assertFalse($DB->record_exists('user_password_resets', ['id' => $first->id]));
+        $this->assertTrue($DB->record_exists('user_password_resets', ['id' => $second->id]));
+        // Other users' tokens are not affected.
+        $this->assertTrue($DB->record_exists('user_password_resets', ['id' => $other->id]));
+    }
+
+    /**
+     * Changing the user's email address must invalidate pending password reset tokens.
+     */
+    public function test_password_reset_token_invalidated_on_email_change(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $user = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+        $otheruser = $this->getDataGenerator()->create_user(['auth' => 'manual']);
+
+        core_login_generate_password_reset($user);
+        core_login_generate_password_reset($otheruser);
+        $this->assertTrue($DB->record_exists('user_password_resets', ['userid' => $user->id]));
+
+        // Updating other fields does not invalidate the token.
+        $update = (object) ['id' => $user->id, 'city' => 'Perth'];
+        \core\user::update_user($update, false);
+        $this->assertTrue($DB->record_exists('user_password_resets', ['userid' => $user->id]));
+
+        // Changing the email address invalidates the token.
+        $update = (object) ['id' => $user->id, 'email' => 'newaddress@example.com'];
+        \core\user::update_user($update, false);
+        $this->assertFalse($DB->record_exists('user_password_resets', ['userid' => $user->id]));
+        $this->assertTrue($DB->record_exists('user_password_resets', ['userid' => $otheruser->id]));
+    }
