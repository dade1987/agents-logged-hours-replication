+/**
+ * Invalidate (delete) all password reset tokens belonging to a user.
+ *
+ * This should be called whenever existing forgot password tokens must no longer be accepted, for example
+ * when the user's email address or password is changed, or when a new token is issued.
+ *
+ * @param int $userid The id of the user whose password reset tokens should be invalidated.
+ * @return void
+ */
+function core_login_delete_password_reset_tokens(int $userid): void {
+    global $DB;
+    $DB->delete_records('user_password_resets', ['userid' => $userid]);
+}
