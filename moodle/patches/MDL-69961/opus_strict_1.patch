diff --git a/public/login/tests/login_lib_test.php b/public/login/tests/login_lib_test.php
index ece1da31dcb..21247dda42b 100644
--- a/public/login/tests/login_lib_test.php
+++ b/public/login/tests/login_lib_test.php
@@ -448,4 +448,62 @@ final class login_lib_test extends \advanced_testcase {
         \moodle_phpmailer::$validator = $defaultvalidator;
     }
 
+    /**
+     * Test that generating a new password reset token removes any existing tokens for the user.
+     *
+     * @covers ::core_login_generate_password_reset
+     */
+    public function test_core_login_generate_password_reset_removes_existing(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $user = $this->getDataGenerator()->create_user();
+        $other = $this->getDataGenerator()->create_user();
+        $first = core_login_generate_password_reset($user);
+        $othertoken = core_login_generate_password_reset($other);
+        $second = core_login_generate_password_reset($user);
+
+        $this->assertFalse($DB->record_exists('user_password_resets', ['id' => $first->id]));
+        $this->assertTrue($DB->record_exists('user_password_resets', ['id' => $second->id]));
+        $this->assertEquals(1, $DB->count_records('user_password_resets', ['userid' => $user->id]));
+        $this->assertTrue($DB->record_exists('user_password_resets', ['id' => $othertoken->id]));
+    }
+
+    /**
+     * Test that password reset tokens are removed when the user's email address changes.
+     *
+     * @covers \core\user::update_user
+     */
+    public function test_password_reset_tokens_removed_on_email_change(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $user = $this->getDataGenerator()->create_user(['email' => 'old@example.com']);
+        core_login_generate_password_reset($user);
+
+        // Updating another field keeps the token.
+        \core\user::update_user((object) ['id' => $user->id, 'firstname' => 'Changed'], false, false);
+        $this->assertEquals(1, $DB->count_records('user_password_resets', ['userid' => $user->id]));
+
+        // Changing the email removes the token.
+        \core\user::update_user((object) ['id' => $user->id, 'email' => 'new@example.com'], false, false);
+        $this->assertEquals(0, $DB->count_records('user_password_resets', ['userid' => $user->id]));
+    }
+
+    /**
+     * Test that password reset tokens are removed when the user's password changes.
+     *
+     * @covers ::update_internal_user_password
+     */
+    public function test_password_reset_tokens_removed_on_password_change(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $user = $this->getDataGenerator()->create_user(['password' => 'Password1!']);
+        core_login_generate_password_reset($user);
+        $user = $DB->get_record('user', ['id' => $user->id]);
+
+        update_internal_user_password($user, 'NewPassword1!');
+        $this->assertEquals(0, $DB->count_records('user_password_resets', ['userid' => $user->id]));
+    }
 }
