@@ -1288,9 +1288,12 @@ class theme_config {
             debugging('Error while compiling SCSS: ' . $e->getMessage(), DEBUG_DEVELOPER);
         }
 
-        // Try to save memory.
+        // Try to save memory. The SCSS compiler builds a cyclic graph (each node references its
+        // parent, and each parent references its children), so unsetting the compiler alone is
+        // not enough for the memory to be released. Force a collection of cyclic references.
         $compiler = null;
         unset($compiler);
+        gc_collect_cycles();
 
         return $compiled;
     }
