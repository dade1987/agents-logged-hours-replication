@@ -0,0 +1,10 @@
+issueNumber: MDL-89443
+notes:
+  core:
+    - message: >-
+        The `theme_build_css_for_themes()` function now accepts a new optional
+        `$retaincss` parameter (defaults to `true`). When set to `false`, the
+        generated CSS is not retained in memory and an empty array is returned.
+        This should be used by callers that only need the CSS to be cached,
+        such as `\core\task\build_installed_themes_task`.
+      type: changed
diff --git a/public/lib/classes/output/theme_config.php b/public/lib/classes/output/theme_config.php
