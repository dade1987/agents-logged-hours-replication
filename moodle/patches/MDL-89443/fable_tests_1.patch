diff --git a/public/lib/tests/theme_config_test.php b/public/lib/tests/theme_config_test.php
index 9c375ce12d6..7eb87a82f3d 100644
--- a/public/lib/tests/theme_config_test.php
+++ b/public/lib/tests/theme_config_test.php
@@ -204,4 +204,26 @@ final class theme_config_test extends advanced_testcase {
         // Check that layouts are also from the grandparent.
         $this->assertArrayHasKey('base', $theme->layouts);
     }
+
+    /**
+     * Test that theme_build_css_for_themes only retains the generated CSS when requested.
+     *
+     * @covers ::theme_build_css_for_themes
+     */
+    public function test_theme_build_css_for_themes_retaincss(): void {
+        $this->resetAfterTest();
+
+        $theme = theme_config::load(theme_config::DEFAULT_THEME);
+
+        // By default the generated CSS is returned.
+        $themescss = theme_build_css_for_themes([$theme], ['ltr'], false);
+        $this->assertArrayHasKey($theme->name, $themescss);
+        $this->assertArrayHasKey('ltr', $themescss[$theme->name]);
+        $this->assertNotEmpty($themescss[$theme->name]['ltr']);
+        unset($themescss);
+
+        // When not retaining the CSS, nothing is returned.
+        $themescss = theme_build_css_for_themes([$theme], ['ltr'], false, false, false);
+        $this->assertSame([], $themescss);
+    }
 }
