diff --git a/public/lib/tests/theme_config_test.php b/public/lib/tests/theme_config_test.php
index 9c375ce12d6..b9c53c896d7 100644
--- a/public/lib/tests/theme_config_test.php
+++ b/public/lib/tests/theme_config_test.php
@@ -204,4 +204,31 @@ final class theme_config_test extends advanced_testcase {
         // Check that layouts are also from the grandparent.
         $this->assertArrayHasKey('base', $theme->layouts);
     }
+
+    /**
+     * Test that theme_build_css_for_themes can build and cache CSS without retaining it.
+     *
+     * @covers ::theme_build_css_for_themes
+     */
+    public function test_theme_build_css_for_themes_without_returning_css(): void {
+        $this->resetAfterTest();
+
+        $theme = theme_config::load(theme_config::DEFAULT_THEME);
+        $oldrevision = theme_get_sub_revision_for_theme($theme->name);
+
+        $result = theme_build_css_for_themes([$theme], ['ltr'], true, false, false);
+        $this->assertSame([], $result);
+
+        // The CSS was still built and stored in the local cache.
+        $newrevision = theme_get_sub_revision_for_theme($theme->name);
+        $this->assertGreaterThan($oldrevision, $newrevision);
+        $filename = theme_get_css_filename($theme->name, theme_get_revision(), $newrevision, 'ltr');
+        $this->assertFileExists($filename);
+        $this->assertNotEmpty(file_get_contents($filename));
+
+        // By default the CSS is returned.
+        $result = theme_build_css_for_themes([$theme], ['ltr']);
+        $this->assertArrayHasKey($theme->name, $result);
+        $this->assertNotEmpty($result[$theme->name]['ltr']);
+    }
 }
