@@ -1288,9 +1288,11 @@ class theme_config {
             debugging('Error while compiling SCSS: ' . $e->getMessage(), DEBUG_DEVELOPER);
         }
 
-        // Try to save memory.
-        $compiler = null;
+        // Free the memory used by the compiler. The compiler's internal output tree is cyclic (children reference
+        // their parents and vice versa), so simply unsetting the compiler is not enough for the memory to be
+        // released; the cyclic garbage collector must be run explicitly.
         unset($compiler);
+        gc_collect_cycles();
 
         return $compiled;
     }
