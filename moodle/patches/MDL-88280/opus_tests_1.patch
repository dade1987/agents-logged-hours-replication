+     * The preview question bank must never be returned, even for an admin.
+     */
+    public function test_preview_bank_excluded(): void {
+        global $DB;
+        $this->resetAfterTest();
+        [
+            ,
+            $course2,
+            $course3,
+            ,
+            $quizcontext,
+            $qbank1,
+            $qbank2,
+            $qbank3,
+            $qbank4,
+        ] = $this->create_banks();
+
+        $this->setAdminUser();
+        $previewbank = \core_question\local\bank\question_bank_helper::get_preview_open_instance_type(true);
+        $this->assertNotNull($previewbank);
+        // Simulate a preview bank with an empty name.
+        $DB->set_field('qbank', 'name', '', ['id' => $previewbank->instance]);
+
+        $result = search_shared_banks::execute($quizcontext->id);
+        $values = array_column($result['sharedbanks'], 'value');
+        $this->assertNotContains((int) $previewbank->id, $values);
