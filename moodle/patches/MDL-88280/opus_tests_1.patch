+            [$qbank1->cmid, $qbank2->cmid, $qbank3->cmid, $qbank4->cmid],
+            $values,
+        );
+
+        $result = search_shared_banks::execute($quizcontext->id, 'Test');
+        $values = array_column($result['sharedbanks'], 'value');
+        $this->assertNotContains((int) $previewbank->id, $values);
+    }
