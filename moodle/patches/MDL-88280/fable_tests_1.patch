+    /**
+     * The preview question bank must never be returned, even when it exists on the site and the user is an admin.
+     */
+    public function test_preview_bank_not_returned(): void {
+        global $DB;
+        $this->resetAfterTest();
+        [
+            ,
+            $course2,
+            $course3,
+            ,
+            $quizcontext,
+            $qbank1,
+            $qbank2,
+            $qbank3,
+            $qbank4,
+        ] = $this->create_banks();
+
+        $this->setAdminUser();
+        $previewbank = question_bank_helper::get_preview_open_instance_type(true);
+        $this->assertNotNull($previewbank);
+
+        $expected = [
+            [
+                'label' => "{$course2->shortname} - {$qbank1->name}",
+                'value' => $qbank1->cmid,
+            ],
+            [
+                'label' => "{$course2->shortname} - {$qbank2->name}",
+                'value' => $qbank2->cmid,
+            ],
+            [
+                'label' => "{$course2->shortname} - {$qbank3->name}",
+                'value' => $qbank3->cmid,
+            ],
+            [
+                'label' => "{$course3->shortname} - {$qbank4->name}",
+                'value' => $qbank4->cmid,
+            ],
+        ];
+
+        $result = search_shared_banks::execute($quizcontext->id);
+        $this->assertEquals($expected, $result['sharedbanks']);
+        $this->assertNotContains($previewbank->id, array_column($result['sharedbanks'], 'value'));
+
+        // Searching by the preview bank's name must not return it either.
+        $result = search_shared_banks::execute($quizcontext->id, $previewbank->name);
+        $this->assertNotContains($previewbank->id, array_column($result['sharedbanks'], 'value'));
+
+        // A preview bank with an empty name (see MDL-86099) must not be returned, nor cause an error.
+        $DB->set_field('qbank', 'name', '', ['id' => $previewbank->instance]);
+        rebuild_course_cache($previewbank->course, true);
+        $result = search_shared_banks::execute($quizcontext->id);
+        $this->assertEquals($expected, $result['sharedbanks']);
