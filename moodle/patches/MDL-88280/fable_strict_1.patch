+    /**
+     * The preview bank must never be returned as a shareable (or private) instance, regardless of search term or capabilities.
+     *
+     * @covers ::get_activity_instances_with_shareable_questions
+     * @covers ::get_activity_instances_with_private_questions
+     * @return void
+     */
+    public function test_get_instances_excludes_preview_bank(): void {
+        $this->resetAfterTest();
+        self::setAdminUser();
+
+        $course = self::getDataGenerator()->create_course();
+        $sharedmodgen = self::getDataGenerator()->get_plugin_generator('mod_qbank');
+        $sharedmod = $sharedmodgen->create_instance(['course' => $course, 'name' => 'Shared bank']);
+        $previewbank = question_bank_helper::get_preview_open_instance_type(true);
+        $this->assertNotNull($previewbank);
+
+        $getcmids = static fn(array $banks): array => array_map(
+            static fn(formatted_bank $bank): int => $bank->get_formatted()->modid,
+            $banks,
+        );
+
+        // No parameters.
+        $sharedbanks = question_bank_helper::get_activity_instances_with_shareable_questions();
+        $this->assertEquals([$sharedmod->cmid], $getcmids($sharedbanks));
+
+        // With capabilities (admin has them all, including on the preview bank context).
+        $sharedbanks = question_bank_helper::get_activity_instances_with_shareable_questions(
+            havingcap: ['moodle/question:useall'],
+        );
+        $this->assertEquals([$sharedmod->cmid], $getcmids($sharedbanks));
+
+        // Searching for the preview bank by name returns nothing.
+        $sharedbanks = question_bank_helper::get_activity_instances_with_shareable_questions(search: $previewbank->name);
+        $this->assertEmpty($sharedbanks);
+
+        // Restricting to the preview bank's course returns nothing.
+        $sharedbanks = question_bank_helper::get_activity_instances_with_shareable_questions(
+            incourseids: [$previewbank->course],
+        );
+        $this->assertEmpty($sharedbanks);
+
+        // Requesting the preview bank as the current bank does not sneak it in either.
+        $sharedbanks = question_bank_helper::get_activity_instances_with_shareable_questions(
+            currentbankid: $previewbank->id,
+        );
+        $this->assertEquals([$sharedmod->cmid], $getcmids($sharedbanks));
+
+        // It is not returned as a private instance either.
+        $privatebanks = question_bank_helper::get_activity_instances_with_private_questions(
+            incourseids: [$previewbank->course],
+        );
+        $this->assertEmpty($privatebanks);
+    }
+
