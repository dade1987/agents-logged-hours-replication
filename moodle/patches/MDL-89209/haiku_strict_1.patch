+    /**
+     * Test that executing the task again, when the course modules have already been deleted, does nothing.
+     */
+    public function test_delete_module_execution_is_idempotent(): void {
+        $this->resetAfterTest();
+
+        // Generate test data.
+        $generator = $this->getDataGenerator();
+        $user = $generator->create_user();
+        $course = $generator->create_course();
+        $assign = $generator->create_module('assign', ['course' => $course]);
+        $assigncm = get_coursemodule_from_id('assign', $assign->cmid);
+
+        $removaltask = new \core_course\task\course_delete_modules();
+        $data = [
+            'cms' => [$assigncm],
+            'userid' => $user->id,
+            'realuserid' => $user->id,
+        ];
+        $removaltask->set_custom_data($data);
+        $removaltask->execute();
+        $this->assertCount(0, get_course_mods($course->id));
+
+        // Executing the task again must not throw, as the course module record is now missing.
+        $removaltask->set_custom_data($data);
+        $removaltask->execute();
+        $this->assertCount(0, get_course_mods($course->id));
+    }
