+    /**
+     * Test that the task succeeds when the course module record is already missing (idempotent execution).
+     */
+    public function test_delete_module_already_deleted(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        // Generate test data.
+        $generator = $this->getDataGenerator();
+        $user = $generator->create_user();
+        $course = $generator->create_course();
+        $assign = $generator->create_module('assign', ['course' => $course]);
+        $assigncm = get_coursemodule_from_id('assign', $assign->cmid);
+        $quiz = $generator->create_module('quiz', ['course' => $course]);
+        $quizcm = get_coursemodule_from_id('quiz', $quiz->cmid);
+
+        // Remove the course module record of the assignment directly, so that the task can not find it.
+        $DB->delete_records('course_modules', ['id' => $assigncm->id]);
+
+        // Execute the task with both the missing and the existing course modules.
+        $removaltask = new \core_course\task\course_delete_modules();
+        $data = [
+            'cms' => [$assigncm, $quizcm],
+            'userid' => $user->id,
+            'realuserid' => $user->id,
+        ];
+        $removaltask->set_custom_data($data);
+        $removaltask->execute();
+
+        // No exception was thrown, and the existing module has been deleted.
+        $coursedmodules = get_course_mods($course->id);
+        $this->assertCount(0, $coursedmodules);
+        $this->assertFalse($DB->record_exists('quiz', ['id' => $quiz->id]));
     }
 
