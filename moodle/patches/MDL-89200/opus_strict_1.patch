+    /**
+     * Checks whether the next run time of a scheduled task was brought forward while the task was executing.
+     *
+     * This happens when the task is requested to "Run ASAP" while an existing execution is still in progress. In that
+     * case the requested next run time must be preserved instead of being replaced when the execution completes.
+     *
+     * @param scheduled_task $task The task being executed
+     * @param \stdClass $record The current task_scheduled record of the task
+     * @return bool
+     */
+    protected static function is_run_asap_requested_during_execution(scheduled_task $task, \stdClass $record): bool {
+        $clock = \core\di::get(\core\clock::class);
+
+        $originalnextruntime = $task->get_next_run_time();
+        if (empty($originalnextruntime) || !isset($record->nextruntime)) {
+            return false;
+        }
+
+        $nextruntime = (int) $record->nextruntime;
+        return $nextruntime !== (int) $originalnextruntime && $nextruntime <= $clock->time();
+    }
+
     /**
      * Sets the next run time for a scheduled task.
      *
@@ -1436,6 +1460,10 @@ class manager {
         $record->pid = $pid;
         $DB->update_record('task_scheduled', $record);
 
+        // Remember the next run time this execution was started for, so that any change made to it while the task
+        // is running (for example a "Run ASAP" request) can be detected and preserved when the task finishes.
+        $task->set_next_run_time($record->nextruntime);
+
         self::task_starting($task);
     }
 
