+    /**
+     * Work out the next run time to store when a running scheduled task finishes.
+     *
+     * If the next run time stored in the database was changed while the task was running (for example by a
+     * "Run ASAP" request via {@see set_scheduled_task_nextruntime()}) to a time earlier than the newly
+     * calculated one, that request is preserved so that it is honoured by a subsequent execution instead
+     * of being silently discarded.
+     *
+     * @param scheduled_task $task The task which has just finished running
+     * @param \stdClass $record The current task_scheduled record from the database
+     * @param int $calculated The newly calculated next run time
+     * @return int The next run time to store
+     */
+    protected static function get_preserved_nextruntime(scheduled_task $task, \stdClass $record, int $calculated): int {
+        $loaded = $task->get_next_run_time();
+        if (empty($loaded) || !isset($record->nextruntime)) {
+            // We do not know what the next run time was when the task was loaded, so cannot detect a change.
+            return $calculated;
+        }
+
+        $current = (int) $record->nextruntime;
+        if ($current !== (int) $loaded && $current < $calculated) {
+            // The next run time was brought forward while the task was running. Keep that request.
+            return $current;
+        }
+
+        return $calculated;
+    }
+
