-            'task_scheduled',
-            'nextruntime',
-            $nextruntime,
-            ['classname' => self::get_canonical_class_name($task)]
-        );
+        // Conditional update so that it is atomic with respect to the task starting.
+        $sql = "UPDATE {task_scheduled}
+                   SET nextruntime = :nextruntime
+                 WHERE classname = :classname
+                   AND timestarted IS NULL";
+        $params = [
+            'nextruntime' => $nextruntime,
+            'classname' => self::get_canonical_class_name($task),
+        ];
+        $DB->execute($sql, $params);
+        // Verify the result, as execute() does not report affected rows.
+        $record = $DB->get_record('task_scheduled', ['classname' => $params['classname']], 'id, nextruntime, timestarted');
