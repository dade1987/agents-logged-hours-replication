+    /**
+     * Test that cleanup() copes with more orphaned tag instances than the batch size (MDL-87395).
+     *
+     * @covers \core\task\tag_cron_task::cleanup
+     * @covers \core\task\tag_cron_task::bulk_delete_instances
+     */
+    public function test_cleanup_many_instances(): void {
+        global $DB;
+        $task = new \core\task\tag_cron_task();
+
+        $user = $this->getDataGenerator()->create_user();
+        core_tag_tag::set_item_tags('core', 'user', $user->id, \context_user::instance($user->id), ['keep']);
+        $keeptag = core_tag_tag::get_by_name(core_tag_collection::get_default(), 'keep');
+
+        // Create more orphaned tag instances (pointing to a non-existing tag) than the batch size.
+        $count = \core\task\tag_cron_task::BATCH_SIZE + 5;
+        $missingtagid = $DB->get_field_sql('SELECT MAX(id) FROM {tag}') + 1000;
+        $records = [];
+        for ($i = 1; $i <= $count; $i++) {
+            $records[] = (object)[
+                'tagid' => $missingtagid,
+                'component' => 'core',
+                'itemtype' => 'course',
+                'itemid' => $i,
+                'contextid' => \context_system::instance()->id,
+                'tiuserid' => 0,
+                'ordering' => 0,
+                'timecreated' => time(),
+                'timemodified' => time(),
+            ];
+        }
+        $DB->insert_records('tag_instance', $records);
+        $this->assertEquals($count, $DB->count_records('tag_instance', ['tagid' => $missingtagid]));
+
+        $sink = $this->redirectEvents();
+        $task->cleanup();
+        $events = $sink->get_events();
+        $sink->close();
+
+        // All orphaned instances were removed and an event was triggered for each of them.
+        $this->assertEquals(0, $DB->count_records('tag_instance', ['tagid' => $missingtagid]));
+        $this->assertEquals($count, count(array_filter($events, function($event) {
+            return $event instanceof \core\event\tag_removed;
+        })));
+        // The valid tag instance is still there.
+        $this->assertTrue($DB->record_exists('tag_instance', ['tagid' => $keeptag->id]));
+    }
+
