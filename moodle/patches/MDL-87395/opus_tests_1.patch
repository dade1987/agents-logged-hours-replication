@@ -235,6 +235,47 @@ final class taglib_test extends \advanced_testcase {
         $this->assertEquals(0, $instancecount);
     }
 
+    /**
+     * Test cleanup when the number of orphaned tag instances exceeds the chunk size.
+     */
+    public function test_tag_cleanup_many_instances(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $task = new \core\task\tag_cron_task();
+
+        $user = $this->getDataGenerator()->create_user();
+        $course = $this->getDataGenerator()->create_course();
+        $context = \context_course::instance($course->id);
+        $tag = $this->getDataGenerator()->create_tag(['userid' => $user->id]);
+        core_tag_tag::add_item_tag('core', 'course', $course->id, $context, $tag->rawname);
+
+        // Create orphaned tag instances pointing to non-existent courses.
+        $count = \core\task\tag_cron_task::CHUNK_SIZE * 2 + 5;
+        $maxcourseid = $DB->get_field_sql('SELECT MAX(id) FROM {course}');
+        $records = [];
+        for ($i = 1; $i <= $count; $i++) {
+            $records[] = (object) [
+                'tagid' => $tag->id,
+                'component' => 'core',
+                'itemtype' => 'course',
+                'itemid' => $maxcourseid + $i,
+                'contextid' => $context->id,
+                'tiuserid' => 0,
+                'ordering' => 0,
+                'timecreated' => time(),
+                'timemodified' => time(),
+            ];
+        }
+        $DB->insert_records('tag_instance', $records);
+        $this->assertEquals($count + 1, $DB->count_records('tag_instance'));
+
+        $task->cleanup();
+
+        // Only the valid tag instance must remain.
+        $this->assertEquals(1, $DB->count_records('tag_instance'));
+        $this->assertTrue($DB->record_exists('tag_instance', ['itemid' => $course->id, 'itemtype' => 'course']));
+    }
+
