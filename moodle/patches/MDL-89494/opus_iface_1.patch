+    /**
+     * Calculates the checkout progress percentage based on the number of processed strings.
+     *
+     * The value is estimated from {@see self::ROUGH_NUMBER_OF_STRINGS} and is capped at 99 so that
+     * 100% is only reported once the checkout has really completed.
+     *
+     * @param int $done number of strings processed so far
+     * @return int percentage in the range 0 - 99
+     */
+    public static function calculate_checkout_percent(int $done): int {
+        $done = max(0, $done);
+        $percent = (int) floor(min($done, self::ROUGH_NUMBER_OF_STRINGS) / self::ROUGH_NUMBER_OF_STRINGS * 100);
+        return min($percent, 99);
+    }
