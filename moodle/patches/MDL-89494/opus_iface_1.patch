+namespace tool_customlang;
+
+use tool_customlang_utils;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once($CFG->dirroot . '/' . $CFG->admin . '/tool/customlang/locallib.php');
+
+/**
+ * Tests for the checkout progress calculation.
+ *
+ * @package    tool_customlang
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \tool_customlang_utils::calculate_checkout_percent
+ */
+final class checkout_percent_test extends \advanced_testcase {
+
+    /**
+     * The progress never reaches 100% while strings are still being processed.
+     */
+    public function test_calculate_checkout_percent(): void {
+        $rough = tool_customlang_utils::ROUGH_NUMBER_OF_STRINGS;
+        $this->assertSame(0, tool_customlang_utils::calculate_checkout_percent(0));
+        $this->assertSame(50, tool_customlang_utils::calculate_checkout_percent((int) ($rough / 2)));
+        $this->assertSame(99, tool_customlang_utils::calculate_checkout_percent($rough - 1));
+        $this->assertSame(99, tool_customlang_utils::calculate_checkout_percent($rough));
+        $this->assertSame(99, tool_customlang_utils::calculate_checkout_percent($rough * 3));
+    }
+}
