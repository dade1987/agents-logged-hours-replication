+
+namespace tool_customlang;
+
+use tool_customlang_utils;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once($CFG->dirroot . '/admin/tool/customlang/locallib.php');
+
+/**
+ * Unit tests for the tool_customlang_utils class.
+ *
+ * @package    tool_customlang
+ * @category   test
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \tool_customlang_utils
+ */
+final class locallib_test extends \advanced_testcase {
+
+    /**
+     * Data provider for test_calculate_checkout_percent().
+     *
+     * @return array
+     */
+    public static function calculate_checkout_percent_provider(): array {
+        $rough = tool_customlang_utils::ROUGH_NUMBER_OF_STRINGS;
+        return [
+            'nothing done' => [0, 0],
+            'negative is treated as zero' => [-5, 0],
+            'one string' => [1, 0],
+            'quarter' => [(int) ($rough / 4), 25],
+            'half' => [(int) ($rough / 2), 50],
+            'just below the estimate' => [$rough - 1, 99],
+            'exactly the estimate' => [$rough, 99],
+            'above the estimate' => [$rough + 1, 99],
+            'far above the estimate' => [$rough * 10, 99],
+        ];
+    }
+
+    /**
+     * Test that the checkout progress never reaches 100% before completion.
+     *
+     * @dataProvider calculate_checkout_percent_provider
+     * @param int $done
+     * @param int $expected
+     */
+    public function test_calculate_checkout_percent(int $done, int $expected): void {
+        $this->assertSame($expected, tool_customlang_utils::calculate_checkout_percent($done));
+    }
+
+    /**
+     * Test that the progress is monotonic and always below 100 during processing.
+     */
+    public function test_calculate_checkout_percent_never_reaches_100(): void {
+        $previous = 0;
+        $max = tool_customlang_utils::ROUGH_NUMBER_OF_STRINGS * 2;
+        for ($done = 0; $done <= $max; $done += 97) {
+            $percent = tool_customlang_utils::calculate_checkout_percent($done);
+            $this->assertGreaterThanOrEqual($previous, $percent);
+            $this->assertLessThan(100, $percent);
+            $previous = $percent;
+        }
+    }
+}
