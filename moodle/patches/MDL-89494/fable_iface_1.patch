diff --git a/public/admin/tool/customlang/locallib.php b/public/admin/tool/customlang/locallib.php
index c76ff7829fb..b534e13648c 100644
--- a/public/admin/tool/customlang/locallib.php
+++ b/public/admin/tool/customlang/locallib.php
@@ -41,12 +41,38 @@ class tool_customlang_utils {
     /** @var array cache of {@link self::list_components()} results */
     private static $components = null;
 
+    /**
+     * The maximum progress percentage that can be reported while the checkout is still running.
+     *
+     * The progress is based on a rough estimate of the number of strings, so on sites with many
+     * plugins the real workload may exceed the estimate. The progress bar must never show 100%
+     * until the checkout has actually finished.
+     */
+    const MAX_CHECKOUT_PROGRESS_PERCENT = 99;
+
     /**
      * This class can not be instantiated
      */
     private function __construct() {
     }
 
+    /**
+     * Calculates the checkout progress percentage for the given number of processed strings.
+     *
+     * The returned value is based on {@see self::ROUGH_NUMBER_OF_STRINGS} and is capped at
+     * {@see self::MAX_CHECKOUT_PROGRESS_PERCENT} so that 100% is only ever displayed once the
+     * checkout is really complete.
+     *
+     * @param int $done number of strings processed so far
+     * @return int progress percentage in the range 0 to 99
+     */
+    public static function calculate_checkout_percent(int $done): int {
+        $done = max(0, $done);
+        $percent = (int) floor($done / self::ROUGH_NUMBER_OF_STRINGS * 100);
+
+        return min($percent, self::MAX_CHECKOUT_PROGRESS_PERCENT);
+    }
+
     /**
      * Returns a list of all components installed on the server
      *
@@ -154,7 +180,7 @@ class tool_customlang_utils {
 
                 if (!is_null($progressbar)) {
                     $done++;
-                    $donepercent = floor(min($done, self::ROUGH_NUMBER_OF_STRINGS) / self::ROUGH_NUMBER_OF_STRINGS * 100);
+                    $donepercent = self::calculate_checkout_percent($done);
                     $progressbar->update_full($donepercent, $strinprogress);
                 }
 
