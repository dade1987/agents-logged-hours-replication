+    /**
+     * Calculates the checkout progress percentage for the given number of processed strings.
+     *
+     * The estimate of the total workload is rough, so the result is capped at 99 while the
+     * checkout is still running. The value 100 is reserved for the final "checkout done" update,
+     * which is sent only once the whole checkout has really finished.
+     *
+     * @param int $done number of strings processed so far
+     * @return int percentage between 0 and 99
+     */
+    public static function calculate_checkout_percent(int $done): int {
+        $done = max(0, $done);
+        $percent = (int) floor(min($done, self::ROUGH_NUMBER_OF_STRINGS) / self::ROUGH_NUMBER_OF_STRINGS * 100);
+        return min($percent, 99);
+    }
+
