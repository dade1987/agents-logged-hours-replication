+    /**
+     * Calculates the percentage of the checkout progress.
+     *
+     * The result is based on the number of already processed components and, optionally, on the
+     * processed strings of the component currently being processed. It never reaches 100 so that
+     * the full completion is only reported once the checkout has really finished.
+     *
+     * @param int $donecomponents number of components completely processed
+     * @param int $totalcomponents total number of components to process
+     * @param int $donestrings number of processed strings in the component currently being processed
+     * @param int $totalstrings total number of strings in the component currently being processed
+     * @return float percentage between 0 and 99
+     */
+    public static function get_checkout_progress(int $donecomponents, int $totalcomponents,
+            int $donestrings = 0, int $totalstrings = 0): float {
+
+        if ($totalcomponents <= 0) {
+            return 0;
+        }
+
+        $done = $donecomponents;
+        if ($totalstrings > 0) {
+            $done += min($donestrings, $totalstrings) / $totalstrings;
+        }
+
+        $percent = floor(min($done, $totalcomponents) / $totalcomponents * 100);
+
+        return min($percent, 99);
+    }
