+namespace tool_customlang;
+
+use tool_customlang_utils;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once($CFG->dirroot . '/' . $CFG->admin . '/tool/customlang/locallib.php');
+
+/**
+ * Tests for the tool_customlang_utils class.
+ *
+ * @package    tool_customlang
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(tool_customlang_utils::class)]
+final class locallib_test extends \advanced_testcase {
+
+    /**
+     * Test the calculation of the checkout progress.
+     */
+    public function test_get_checkout_progress(): void {
+        $this->assertEquals(0, tool_customlang_utils::get_checkout_progress(0, 0));
+        $this->assertEquals(0, tool_customlang_utils::get_checkout_progress(0, 10));
+        $this->assertEquals(5, tool_customlang_utils::get_checkout_progress(0, 10, 1, 2));
+        $this->assertEquals(50, tool_customlang_utils::get_checkout_progress(5, 10));
+        $this->assertEquals(90, tool_customlang_utils::get_checkout_progress(9, 10, 0, 100));
+        // The progress never reaches 100 before the checkout has completely finished.
+        $this->assertEquals(99, tool_customlang_utils::get_checkout_progress(9, 10, 100, 100));
+        $this->assertEquals(99, tool_customlang_utils::get_checkout_progress(10, 10));
+        $this->assertEquals(99, tool_customlang_utils::get_checkout_progress(999, 1000, 999, 1000));
+    }
+
+    /**
+     * Test that the checkout only reports 100% once all the strings have been processed.
+     */
+    public function test_checkout_progress_reaches_100_only_at_the_end(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $progressbar = $this->getMockBuilder(\progress_bar::class)
+            ->disableOriginalConstructor()
+            ->onlyMethods(['update_full'])
+            ->getMock();
+
+        $updates = [];
+        $progressbar->method('update_full')->willReturnCallback(
+            function($percent, $msg) use (&$updates, $DB) {
+                $updates[] = [$percent, $DB->count_records('tool_customlang', ['lang' => 'en'])];
+                return true;
+            }
+        );
+
+        tool_customlang_utils::checkout('en', $progressbar);
+
+        $total = $DB->count_records('tool_customlang', ['lang' => 'en']);
+        $this->assertNotEmpty($updates);
+
+        $last = array_pop($updates);
+        $this->assertEquals(100, $last[0]);
+        $this->assertEquals($total, $last[1]);
+
+        $previous = 0;
+        foreach ($updates as [$percent, $count]) {
+            $this->assertLessThan(100, $percent);
+            $this->assertGreaterThanOrEqual($previous, $percent);
+            $previous = $percent;
+        }
+    }
+}
