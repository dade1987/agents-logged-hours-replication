+namespace tool_customlang;
+
+use core\output\progress_bar;
+use tool_customlang_utils;
+
+/**
+ * Unit tests for the tool_customlang_utils class.
+ *
+ * @package    tool_customlang
+ * @category   test
+ * @copyright  2025 onwards Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(\tool_customlang_utils::class)]
+final class locallib_test extends \advanced_testcase {
+    /**
+     * Load the required libraries.
+     */
+    public static function setUpBeforeClass(): void {
+        global $CFG;
+        parent::setUpBeforeClass();
+        require_once($CFG->dirroot . '/' . $CFG->admin . '/tool/customlang/locallib.php');
+    }
+
+    /**
+     * The progress bar must only reach 100% once the checkout has completely finished.
+     */
+    public function test_checkout_progress_reaches_100_only_at_the_end(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        // A progress bar that records every reported percentage instead of outputting anything.
+        $progressbar = new class extends progress_bar {
+            /** @var array list of all reported percentages, in order */
+            public $reported = [];
+
+            public function __construct() {
+                parent::__construct('tool_customlang_test', 500, false);
+                $this->timestart = microtime(true);
+            }
+
+            public function update_full($percent, $msg) {
+                $this->reported[] = $percent;
+            }
+        };
+
+        tool_customlang_utils::checkout('en', $progressbar);
+
+        // Something has actually been checked out.
+        $this->assertGreaterThan(0, $DB->count_records('tool_customlang', ['lang' => 'en']));
+        $this->assertGreaterThan(0, $DB->count_records('tool_customlang_components'));
+
+        $reported = $progressbar->reported;
+        $this->assertNotEmpty($reported);
+
+        // The very last update is the completion one.
+        $this->assertSame(100, array_pop($reported));
+
+        // No earlier update reports completion and the progress never goes backwards.
+        $previous = 0;
+        foreach ($reported as $percent) {
+            $this->assertLessThan(100, $percent);
+            $this->assertGreaterThanOrEqual(0, $percent);
+            $this->assertGreaterThanOrEqual($previous, $percent);
+            $previous = $percent;
+        }
+
+        // The reported progress has actually been moving on, i.e. it is not stuck at 0% until the end.
+        $this->assertGreaterThan(0, $previous);
+    }
+}
