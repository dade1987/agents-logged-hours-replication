+    /**
+     * Test that deleting a subsection does not store the subsection itself in the recycle bin,
+     * but only the activities it contains.
+     */
+    public function test_delete_subsection(): void {
+        global $DB;
+
+        // Create a subsection with a couple of activities inside it.
+        $subsection = $this->getDataGenerator()->create_module('subsection', [
+            'course' => $this->course->id,
+            'section' => 1,
+        ]);
+        $modinfo = get_fast_modinfo($this->course->id);
+        $delegatedsection = $modinfo->get_cm($subsection->cmid)->get_delegated_section_info();
+        $this->assertNotNull($delegatedsection);
+
+        $page = $this->getDataGenerator()->create_module('page', [
+            'course' => $this->course->id,
+            'section' => $delegatedsection->sectionnum,
+        ]);
+        $book = $this->getDataGenerator()->create_module('book', [
+            'course' => $this->course->id,
+            'section' => $delegatedsection->sectionnum,
+        ]);
+
+        // Should have nothing in the recycle bin.
+        $this->assertEquals(0, $DB->count_records('tool_recyclebin_course'));
+
+        // Delete the subsection.
+        \core_courseformat\formatactions::cm($this->course->id)->delete($subsection->cmid);
+
+        // Only the activities inside the subsection should be in the recycle bin, not the subsection itself.
+        $recyclebin = new \tool_recyclebin\course_bin($this->course->id);
+        $items = $recyclebin->get_items();
+        $this->assertCount(2, $items);
+
+        $subsectionmoduleid = $DB->get_field('modules', 'id', ['name' => 'subsection'], MUST_EXIST);
+        $names = [];
+        foreach ($items as $item) {
+            $this->assertNotEquals($subsectionmoduleid, $item->module);
+            $names[] = $item->name;
+        }
+        $this->assertEqualsCanonicalizing([$page->name, $book->name], $names);
+    }
+
     /**
