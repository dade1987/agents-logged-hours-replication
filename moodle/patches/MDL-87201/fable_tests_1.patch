+    /**
+     * Check that subsections (modules delegating a section) are not stored in the recycle bin,
+     * but the activities they contain are.
+     */
+    public function test_pre_course_module_delete_hook_subsection(): void {
+        global $DB;
+
+        $generator = $this->getDataGenerator();
+        $subsection = $generator->create_module('subsection', ['course' => $this->course->id, 'section' => 1]);
+        $delegatedsection = get_fast_modinfo($this->course->id)->get_cm($subsection->cmid)->get_delegated_section_info();
+        $this->assertNotNull($delegatedsection);
+
+        // Add an activity inside the subsection.
+        $book = $generator->create_module('book', [
+            'course' => $this->course->id,
+            'section' => $delegatedsection->sectionnum,
+        ]);
+        $this->assertEquals($delegatedsection->id, $DB->get_field('course_modules', 'section', ['id' => $book->cmid]));
+
+        // Should have nothing in the recycle bin.
+        $this->assertEquals(0, $DB->count_records('tool_recyclebin_course'));
+
+        // Delete the subsection.
+        \core_courseformat\formatactions::cm($this->course->id)->delete($subsection->cmid);
+
+        // Only the activity inside the subsection must be in the recycle bin.
+        $recyclebin = new \tool_recyclebin\course_bin($this->course->id);
+        $items = $recyclebin->get_items();
+        $this->assertCount(1, $items);
+        $item = reset($items);
+        $this->assertEquals($book->name, $item->name);
+        $this->assertEquals($DB->get_field('modules', 'id', ['name' => 'book']), $item->module);
+        $this->assertEquals(0, $DB->count_records('tool_recyclebin_course', [
+            'module' => $DB->get_field('modules', 'id', ['name' => 'subsection']),
+        ]));
+    }
+
