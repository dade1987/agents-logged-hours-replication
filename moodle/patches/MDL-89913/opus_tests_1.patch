+    /**
+     * Test that a successful client authentication records the last accessed time of both the
+     * client and the secret which was used, and that a failed one records neither.
+     *
+     * @param bool $valid Whether a valid secret is passed to validateClient.
+     * @return void
+     */
+    #[DataProvider('validate_client_records_last_accessed_provider')]
+    public function test_validate_client_records_last_accessed(bool $valid): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $clock = $this->mock_clock_with_frozen();
+        $repository = new client_repository();
+
+        $DB->insert_record('oauth2_server_clients', (object) [
+            'name' => 'Confidential Client',
+            'clientidentifier' => 'client-conf',
+            'ownercontext' => \context_system::instance()->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'isconfidential' => 1,
+            'granttypes' => client_entity::GRANT_TYPE_CLIENT_CREDENTIALS,
+            'timecreated' => $clock->time(),
+            'scopes' => '',
+        ]);
+
+        // Two live secrets, so that only the one actually used is recorded as accessed.
+        $usedsecretid = $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => 'client-conf',
+            'secret' => password_hash('supersecret', PASSWORD_DEFAULT),
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'expirytime' => $clock->time() + 3600,
+            'timecreated' => $clock->time(),
+        ]);
+        $othersecretid = $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => 'client-conf',
+            'secret' => password_hash('othersecret', PASSWORD_DEFAULT),
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'expirytime' => $clock->time() + 3600,
+            'timecreated' => $clock->time(),
+        ]);
+
+        // Nothing has been accessed yet.
+        $this->assertNull($DB->get_field('oauth2_server_clients', 'lastaccessed', ['clientidentifier' => 'client-conf']));
+        $this->assertNull($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $usedsecretid]));
+
+        $this->assertSame($valid, $repository->validateClient(
+            'client-conf',
+            $valid ? 'supersecret' : 'wrongsecret',
+            client_entity::GRANT_TYPE_CLIENT_CREDENTIALS,
+        ));
+
+        $clientlastaccessed = $DB->get_field(
+            'oauth2_server_clients',
+            'lastaccessed',
+            ['clientidentifier' => 'client-conf'],
+        );
+        $secretlastaccessed = $DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $usedsecretid]);
+
+        if ($valid) {
+            $this->assertEquals($clock->time(), $clientlastaccessed);
+            $this->assertEquals($clock->time(), $secretlastaccessed);
+        } else {
+            $this->assertNull($clientlastaccessed);
+            $this->assertNull($secretlastaccessed);
+        }
+
+        // The secret which was not used is never recorded as accessed.
+        $this->assertNull($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $othersecretid]));
+    }
+
+    /**
+     * Data provider for {@see test_validate_client_records_last_accessed}.
+     *
+     * @return array The datasets.
+     */
+    public static function validate_client_records_last_accessed_provider(): array {
+        return [
+            'valid secret' => [true],
+            'invalid secret' => [false],
+        ];
+    }
