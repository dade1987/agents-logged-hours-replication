+
+    /**
+     * Record the time at which a client was last accessed.
+     *
+     * Called whenever the client takes part in a flow of the authorisation server, i.e. when it
+     * authenticates itself, when an authorisation code is issued to it, or when it exchanges a
+     * code or a refresh token for an access token.
+     *
+     * @param string $clientidentifier The public client identifier.
+     * @return void
+     */
+    public function record_client_access(string $clientidentifier): void {
+        global $DB;
+
+        $DB->set_field(
+            'oauth2_server_clients',
+            'lastaccessed',
+            \core\di::get(\core\clock::class)->time(),
+            ['clientidentifier' => $clientidentifier],
+        );
+    }
+
+    /**
+     * Record the time at which a client secret was last successfully used to authenticate a client.
+     *
+     * @param int $secretid The ID of the client secret.
+     * @return void
+     */
+    public function record_secret_access(int $secretid): void {
+        global $DB;
+
+        $DB->set_field(
+            'oauth2_server_client_secrets',
+            'lastaccessed',
+            \core\di::get(\core\clock::class)->time(),
+            ['id' => $secretid],
+        );
+    }
 }
