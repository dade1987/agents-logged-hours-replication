+    /**
+     * Test that persisting a new access token records the client's last accessed time.
+     *
+     * @return void
+     */
+    public function test_persist_new_access_token_records_client_last_accessed(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $clock = $this->mock_clock_with_frozen();
+        $repository = new access_token_repository();
+
+        $DB->insert_record('oauth2_server_clients', [
+            'name' => 'Test client',
+            'clientidentifier' => 'client-id',
+            'ownercontext' => \context_system::instance()->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'isconfidential' => 1,
+            'timecreated' => $clock->time(),
+            'scopes' => '',
+        ]);
+
+        $this->assertNull($DB->get_field('oauth2_server_clients', 'lastaccessed', ['clientidentifier' => 'client-id']));
+
+        $client = new client_entity();
+        $client->setIdentifier('client-id');
+
+        $token = new access_token_entity();
+        $token->setIdentifier('token-id');
+        $token->setClient($client);
+        $token->setExpiryDateTime(new \DateTimeImmutable('+1 hour'));
+
+        $repository->persistNewAccessToken($token);
+
+        $this->assertEquals(
+            $clock->time(),
+            $DB->get_field('oauth2_server_clients', 'lastaccessed', ['clientidentifier' => 'client-id']),
+        );
+    }
+
