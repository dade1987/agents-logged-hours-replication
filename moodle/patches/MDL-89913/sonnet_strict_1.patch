@@ -91,10 +91,30 @@ class client_repository implements ClientRepositoryInterface {
 
         foreach ($secrets as $secret) {
             if (password_verify($clientsecret, $secret->secret)) {
+                $now = time();
+                $DB->set_field('oauth2_server_client_secrets', 'lastaccessed', $now, ['id' => $secret->id]);
+                $this->update_last_accessed($clientidentifier, $now);
                 return true;
             }
         }
 
         return false;
     }
+
+    /**
+     * Record the last accessed time of a client.
+     *
+     * @param string $clientidentifier
+     * @param int|null $time Defaults to the current time.
+     */
+    public function update_last_accessed(string $clientidentifier, ?int $time = null): void {
+        global $DB;
+
+        $DB->set_field(
+            'oauth2_server_clients',
+            'lastaccessed',
+            $time ?? time(),
+            ['clientidentifier' => $clientidentifier],
+        );
+    }
 }
