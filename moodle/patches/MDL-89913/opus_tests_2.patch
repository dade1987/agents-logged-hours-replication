@@ -91,10 +91,30 @@ class client_repository implements ClientRepositoryInterface {
 
         foreach ($secrets as $secret) {
             if (password_verify($clientsecret, $secret->secret)) {
+                $now = time();
+                $DB->set_field('oauth2_server_client_secrets', 'lastaccessed', $now, ['id' => $secret->id]);
+                self::record_client_access($clientidentifier, $now);
                 return true;
             }
