+    /**
+     * Test that only the secret actually used to authenticate has its last accessed time recorded.
+     */
+    public function test_validate_client_records_used_secret_only(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $DB->insert_record('oauth2_server_clients', (object) [
+            'name' => 'Confidential Client',
+            'clientidentifier' => 'client-conf',
+            'ownercontext' => \context_system::instance()->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'isconfidential' => 1,
+            'granttypes' => client_entity::GRANT_TYPE_CLIENT_CREDENTIALS,
+            'timecreated' => time(),
+            'scopes' => '',
+        ]);
+        $ids = [];
+        foreach (['first', 'second'] as $secret) {
+            $ids[$secret] = $DB->insert_record('oauth2_server_client_secrets', (object) [
+                'clientidentifier' => 'client-conf',
+                'secret' => password_hash($secret, PASSWORD_DEFAULT),
+                'revoked' => client_entity::SECRET_REVOKED_NO,
+                'expirytime' => time() + 3600,
+                'timecreated' => time(),
+            ]);
+        }
+
+        $this->assertTrue((new client_repository())->validateClient('client-conf', 'second', null));
+
+        $this->assertEmpty($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $ids['first']]));
+        $this->assertNotEmpty($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $ids['second']]));
+        $this->assertNotEmpty($DB->get_field('oauth2_server_clients', 'lastaccessed', ['clientidentifier' => 'client-conf']));
+    }
+
+    /**
