+
+    /**
+     * Record that a client has been used in an OAuth2 flow, by updating its last accessed time.
+     *
+     * @param string $clientidentifier The public client identifier.
+     * @param int|null $time The time of access. Defaults to now.
+     */
+    public static function record_client_access(string $clientidentifier, ?int $time = null): void {
+        global $DB;
+
+        $DB->set_field(
+            'oauth2_server_clients',
+            'lastaccessed',
+            $time ?? time(),
+            ['clientidentifier' => $clientidentifier],
+        );
+    }
 }
