+    /**
+     * Test that successful client validation records the last accessed time of the client and secret.
+     *
+     * @return void
+     */
+    public function test_validate_client_logs_last_accessed(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $clock = $this->mock_clock_with_frozen();
+
+        $repository = new client_repository();
+        $DB->insert_record('oauth2_server_clients', (object) [
+            'name' => 'Confidential Client',
+            'clientidentifier' => 'client-conf',
+            'ownercontext' => \context_system::instance()->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'isconfidential' => 1,
+            'granttypes' => client_entity::GRANT_TYPE_AUTHORIZATION_CODE,
+            'timecreated' => time(),
+            'scopes' => '',
+        ]);
+        $usedid = $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => 'client-conf',
+            'secret' => password_hash('supersecret', PASSWORD_DEFAULT),
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'expirytime' => $clock->time() + 3600,
+            'timecreated' => $clock->time(),
+        ]);
+        $otherid = $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => 'client-conf',
+            'secret' => password_hash('othersecret', PASSWORD_DEFAULT),
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'expirytime' => $clock->time() + 3600,
+            'timecreated' => $clock->time(),
+        ]);
+
+        // A failed validation does not record anything.
+        $this->assertFalse($repository->validateClient('client-conf', 'wrongsecret', null));
+        $this->assertNull($DB->get_field('oauth2_server_clients', 'lastaccessed', ['clientidentifier' => 'client-conf']));
+        $this->assertNull($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $usedid]));
+
+        $clock->bump(10);
+        $this->assertTrue($repository->validateClient('client-conf', 'supersecret', null));
+        $this->assertEquals(
+            $clock->time(),
+            $DB->get_field('oauth2_server_clients', 'lastaccessed', ['clientidentifier' => 'client-conf']),
+        );
+        $this->assertEquals($clock->time(), $DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $usedid]));
+        $this->assertNull($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $otherid]));
+    }
+
