@@ -84,17 +84,54 @@ class client_repository implements ClientRepositoryInterface {
         $params = [
             'clientidentifier' => $clientidentifier,
             'revoked' => client_entity::SECRET_REVOKED_NO,
-            'now' => time(),
+            'now' => \core\di::get(\core\clock::class)->time(),
         ];
 
         $secrets = $DB->get_records_select('oauth2_server_client_secrets', $select, $params);
 
         foreach ($secrets as $secret) {
             if (password_verify($clientsecret, $secret->secret)) {
+                // The secret successfully authenticated the client, so record that it (and the client) was used.
+                $this->log_secret_access((int) $secret->id);
+                $this->log_client_access($clientidentifier);
                 return true;
             }
         }
 
         return false;
     }
+
+    /**
+     * Record that a client was just accessed (e.g. during an authorization or token exchange flow).
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return void
+     */
+    public function log_client_access(string $clientidentifier): void {
+        global $DB;
+
+        $DB->set_field(
+            'oauth2_server_clients',
+            'lastaccessed',
+            \core\di::get(\core\clock::class)->time(),
+            ['clientidentifier' => $clientidentifier],
+        );
+    }
+
+    /**
+     * Record that a client secret was just used to successfully authenticate a client.
+     *
+     * @param int $secretid The client secret record ID.
+     * @return void
+     */
+    public function log_secret_access(int $secretid): void {
+        global $DB;
+
+        $DB->set_field(
+            'oauth2_server_client_secrets',
+            'lastaccessed',
+            \core\di::get(\core\clock::class)->time(),
+            ['id' => $secretid],
+        );
+    }
 }
