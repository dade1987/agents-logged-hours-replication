+    /**
+     * A successful token exchange records the last access time against the calling client,
+     * whether it identifies itself via HTTP Basic credentials or the client_id parameter.
+     *
+     * @param string $method
+     * @param bool $usebasicauth
+     */
+    #[\PHPUnit\Framework\Attributes\DataProvider('token_route_logs_client_access_provider')]
+    public function test_token_routes_log_client_access(string $method, bool $usebasicauth): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $clock = $this->mock_clock_with_frozen(1700000000);
+
+        $client = $this->make_client_entity();
+        $this->assertNull($DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $client->get_id()]));
+
+        $server = $this->createMock(AuthorizationServer::class);
+        $server->method('respondToAccessTokenRequest')
+            ->willReturn(new Response(200, [], 'the-token-response'));
+
+        $route = $this->get_route($server, new \core\oauth2\server\repository\client_repository());
+
+        $clock->bump(60);
+        $request = new ServerRequest('POST', '/' . $method);
+        if ($usebasicauth) {
+            $request = $request->withHeader(
+                'Authorization',
+                'Basic ' . base64_encode($client->getIdentifier() . ':secret'),
+            );
+        } else {
+            $request = $request->withParsedBody(['client_id' => $client->getIdentifier()]);
+        }
+
+        $response = $route->{$method}($request, new Response());
+
+        $this->assertEquals(200, $response->getStatusCode());
+        $this->assertEquals(
+            1700000060,
+            $DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $client->get_id()]),
+        );
+    }
+
+    /**
+     * Data provider for test_token_routes_log_client_access().
+     *
+     * @return \Generator
+     */
+    public static function token_route_logs_client_access_provider(): \Generator {
+        foreach (['token', 'access_token', 'refresh'] as $method) {
+            yield "{$method} with basic auth" => [$method, true];
+            yield "{$method} with client_id parameter" => [$method, false];
+        }
+    }
+
