+    /**
+     * Respond to an access token request, recording the client's use on success.
+     *
+     * The OAuth2 server throws on any failure, so reaching the logging step means the client
+     * was identified (and, where confidential, authenticated) and a token was issued to it.
+     *
+     * @param ServerRequestInterface $request
+     * @param ResponseInterface $response
+     * @return ResponseInterface
+     */
+    private function respond_to_access_token_request(
+        ServerRequestInterface $request,
+        ResponseInterface $response,
+    ): ResponseInterface {
+        $response = $this->server->respondToAccessTokenRequest($request, $response);
+
+        $clientidentifier = $this->get_token_request_client_identifier($request);
+        if ($clientidentifier !== null && $clientidentifier !== '') {
+            $this->log_client_access($clientidentifier);
+        }
+
+        return $response;
+    }
+
+    /**
+     * Record that a client was successfully used in an OAuth2 flow.
+     *
+     * @param string $clientidentifier
+     * @return void
+     */
+    private function log_client_access(string $clientidentifier): void {
+        if ($this->clientrepository instanceof client_repository) {
+            $this->clientrepository->log_client_access($clientidentifier);
+        }
+    }
+
+    /**
+     * Read the client identifier from a token request, the same way the OAuth2 server does:
+     * HTTP Basic credentials first, then the client_id request parameter.
+     *
+     * @param ServerRequestInterface $request
+     * @return string|null The client identifier, or null if none was supplied.
+     */
+    private function get_token_request_client_identifier(ServerRequestInterface $request): ?string {
+        $body = $request->getParsedBody();
+        if (!is_array($body)) {
+            $body = $this->get_form_parameters($request);
+        }
+
+        [$clientidentifier] = $this->get_client_credentials($request, $body);
+
+        return $clientidentifier;
+    }
