+    /**
+     * A successful validateClient() records the last access time on both the client and the
+     * secret that authenticated it, while a failed one leaves both untouched.
+     */
+    public function test_validate_client_logs_last_access(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $clock = $this->mock_clock_with_frozen(1700000000);
+
+        $repository = new client_repository();
+
+        $clientid = $DB->insert_record('oauth2_server_clients', (object) [
+            'name' => 'Confidential Client',
+            'clientidentifier' => 'client-conf',
+            'ownercontext' => \context_system::instance()->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'isconfidential' => 1,
+            'granttypes' => client_entity::GRANT_TYPE_AUTHORIZATION_CODE,
+            'timecreated' => $clock->time(),
+            'scopes' => '',
+        ]);
+        $usedsecretid = $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => 'client-conf',
+            'secret' => password_hash('supersecret', PASSWORD_DEFAULT),
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'expirytime' => $clock->time() + 3600,
+            'timecreated' => $clock->time(),
+        ]);
+        $othersecretid = $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => 'client-conf',
+            'secret' => password_hash('othersecret', PASSWORD_DEFAULT),
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'expirytime' => $clock->time() + 3600,
+            'timecreated' => $clock->time(),
+        ]);
+
+        // A failed authentication does not count as an access.
+        $this->assertFalse($repository->validateClient('client-conf', 'wrong', client_entity::GRANT_TYPE_AUTHORIZATION_CODE));
+        $this->assertNull($DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $clientid]));
+        $this->assertNull($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $usedsecretid]));
+        $this->assertNull($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $othersecretid]));
+
+        $clock->bump(60);
+        $this->assertTrue($repository->validateClient('client-conf', 'supersecret', client_entity::GRANT_TYPE_AUTHORIZATION_CODE));
+
+        $this->assertEquals(1700000060, $DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $clientid]));
+        $this->assertEquals(1700000060, $DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $usedsecretid]));
+        // Only the secret that was actually used to authenticate is updated.
+        $this->assertNull($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $othersecretid]));
+    }
+
+    /**
+     * log_client_access() records the current time against the named client only.
+     */
+    public function test_log_client_access(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $clock = $this->mock_clock_with_frozen(1700000000);
+
+        $repository = new client_repository();
+
+        $ids = [];
+        foreach (['client-a', 'client-b'] as $identifier) {
+            $ids[$identifier] = $DB->insert_record('oauth2_server_clients', (object) [
+                'name' => $identifier,
+                'clientidentifier' => $identifier,
+                'ownercontext' => \context_system::instance()->id,
+                'status' => client_entity::STATUS_ACTIVE,
+                'isconfidential' => 0,
+                'granttypes' => client_entity::GRANT_TYPE_AUTHORIZATION_CODE,
+                'timecreated' => $clock->time(),
+                'scopes' => '',
+            ]);
+        }
+
+        $repository->log_client_access('client-a');
+
+        $this->assertEquals(1700000000, $DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $ids['client-a']]));
+        $this->assertNull($DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $ids['client-b']]));
+
+        $clock->bump(30);
+        $repository->log_client_access('client-a');
+        $this->assertEquals(1700000030, $DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $ids['client-a']]));
+
+        // An unknown client is ignored.
+        $repository->log_client_access('client-missing');
+        $this->assertNull($DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $ids['client-b']]));
+    }
+
