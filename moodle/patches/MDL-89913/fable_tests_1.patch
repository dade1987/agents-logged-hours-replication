@@ -336,4 +336,106 @@ final class client_repository_test extends \advanced_testcase {
             ],
         ];
     }
+
+    /**
+     * Test that a successful client validation records the last accessed time of both the client
+     * and the secret that was used, while a failed validation leaves them untouched.
+     */
+    public function test_validate_client_logs_last_accessed(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $clock = $this->mock_clock_with_frozen(1700000000);
+
+        $repository = new client_repository();
+
+        $clientid = $DB->insert_record('oauth2_server_clients', (object) [
+            'name' => 'Confidential Client',
+            'clientidentifier' => 'client-conf',
+            'ownercontext' => \context_system::instance()->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'isconfidential' => 1,
+            'granttypes' => client_entity::GRANT_TYPE_AUTHORIZATION_CODE,
+            'timecreated' => $clock->time(),
+            'scopes' => '',
+        ]);
+        $usedsecretid = $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => 'client-conf',
+            'secret' => password_hash('supersecret', PASSWORD_DEFAULT),
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'expirytime' => time() + 3600,
+            'timecreated' => $clock->time(),
+        ]);
+        $othersecretid = $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => 'client-conf',
+            'secret' => password_hash('othersecret', PASSWORD_DEFAULT),
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'expirytime' => time() + 3600,
+            'timecreated' => $clock->time(),
+        ]);
+
+        // A failed validation must not be recorded as an access.
+        $this->assertFalse($repository->validateClient('client-conf', 'wrongsecret', null));
+        $this->assertNull($DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $clientid]));
+        $this->assertNull($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $usedsecretid]));
+        $this->assertNull($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $othersecretid]));
+
+        $clock->set_to(1700000500);
+        $this->assertTrue($repository->validateClient('client-conf', 'supersecret', null));
+
+        $this->assertEquals(1700000500, $DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $clientid]));
+        $this->assertEquals(
+            1700000500,
+            $DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $usedsecretid]),
+        );
+        // Only the secret that was actually used is touched.
+        $this->assertNull($DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $othersecretid]));
+
+        // A later successful validation with the other secret moves the client time forward and
+        // records that secret, without altering the previously used secret.
+        $clock->set_to(1700001000);
+        $this->assertTrue($repository->validateClient('client-conf', 'othersecret', null));
+
+        $this->assertEquals(1700001000, $DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $clientid]));
+        $this->assertEquals(
+            1700001000,
+            $DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $othersecretid]),
+        );
+        $this->assertEquals(
+            1700000500,
+            $DB->get_field('oauth2_server_client_secrets', 'lastaccessed', ['id' => $usedsecretid]),
+        );
+    }
+
+    /**
+     * Test that logging client access directly updates the client's last accessed time.
+     */
+    public function test_log_client_access(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $clock = $this->mock_clock_with_frozen(1700000000);
+
+        $repository = new client_repository();
+
+        $clientid = $DB->insert_record('oauth2_server_clients', (object) [
+            'name' => 'Public Client',
+            'clientidentifier' => 'client-public',
+            'ownercontext' => \context_system::instance()->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'isconfidential' => 0,
+            'granttypes' => client_entity::GRANT_TYPE_AUTHORIZATION_CODE,
+            'timecreated' => $clock->time(),
+            'scopes' => '',
+        ]);
+
+        $this->assertNull($DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $clientid]));
+
+        $repository->log_client_access('client-public');
+        $this->assertEquals(1700000000, $DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $clientid]));
+
+        // Logging access for an unknown client is a no-op.
+        $repository->log_client_access('client-unknown');
+        $this->assertEquals(1700000000, $DB->get_field('oauth2_server_clients', 'lastaccessed', ['id' => $clientid]));
+    }
 }
