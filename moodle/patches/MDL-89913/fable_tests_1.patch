diff --git a/public/lib/tests/oauth2/server/repository/client_repository_test.php b/public/lib/tests/oauth2/server/repository/client_repository_test.php
index b60e5764a89..7d7efa04492 100644
--- a/public/lib/tests/oauth2/server/repository/client_repository_test.php
