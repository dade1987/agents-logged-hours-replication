diff --git a/public/lib/classes/oauth2/server/repository/access_token_repository.php b/public/lib/classes/oauth2/server/repository/access_token_repository.php
index 123d2cd8202..bd8c64105df 100644
--- a/public/lib/classes/oauth2/server/repository/access_token_repository.php
+++ b/public/lib/classes/oauth2/server/repository/access_token_repository.php
@@ -70,6 +70,14 @@ class access_token_repository implements AccessTokenRepositoryInterface {
         $record->timecreated = time();
 
         $DB->insert_record('oauth2_server_client_access_tokens', $record);
+
+        // Issuing a token is the client being used, so record it against the client.
+        $DB->set_field(
+            'oauth2_server_clients',
+            'lastaccessed',
+            \core\di::get(\core\clock::class)->time(),
+            ['clientidentifier' => $record->clientidentifier],
+        );
     }
 
