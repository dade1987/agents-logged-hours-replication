+    /**
+     * Return the file areas of the given plugin to be used when retrieving the plugin information.
+     *
+     * Plugins supporting multiple markers store the marker files in file areas suffixed with "_marker" (using the
+     * assign_mark record id as item id), while the overall files are stored in the regular file areas (using the
+     * grade id as item id).
+     *
+     * @param  assign_plugin $assignplugin the assignment plugin
+     * @param  int|null $markid the assign_mark record id or null to get the overall file areas
+     * @return array an array of fileareas (keys) and descriptions (values)
+     */
+    private static function get_plugin_file_areas($assignplugin, ?int $markid = null): array {
+        $fileareas = $assignplugin->get_file_areas();
+        $overallareas = [];
+        $markerareas = [];
+        foreach ($fileareas as $filearea => $name) {
+            if (str_ends_with($filearea, '_marker')) {
+                $markerareas[$filearea] = $name;
+            } else {
+                $overallareas[$filearea] = $name;
+            }
+        }
+
+        if ($markid === null) {
+            return $overallareas;
+        }
+
+        if (empty($markerareas)) {
+            // The plugin does not declare the marker file areas explicitly, derive them from the overall ones.
+            foreach ($overallareas as $filearea => $name) {
+                $markerareas[$filearea . '_marker'] = $name;
+            }
+        }
+        return $markerareas;
+    }
+
