+    /**
+     * Test get_submission_status returns the feedback given by each marker (multiple markers).
+     *
+     * @covers ::get_submission_status
+     */
+    public function test_get_submission_status_multiple_markers_feedback(): void {
+        global $DB;
+
+        $this->resetAfterTest(true);
+
+        list($assign, $instance, $student1, $student2, $teacher, $g1, $g2) = $this->create_submission_for_testing_status(true);
+
+        // Create a second marker.
+        $teacher2 = self::getDataGenerator()->create_user();
+        $teacherrole = $DB->get_record('role', ['shortname' => 'teacher']);
+        $this->getDataGenerator()->enrol_user($teacher2->id, $assign->get_course()->id, $teacherrole->id);
+
+        // Grade the assign for the student1 with an overall comment.
+        $this->setUser($teacher);
+
+        $data = new \stdClass();
+        $data->grade = '50.0';
+        $data->assignfeedbackcomments_editor = ['text' => 'Overall comment', 'format' => FORMAT_HTML];
+        $assign->testable_apply_grade_to_user($data, $student1->id, 0);
+        $grade = $assign->get_user_grade($student1->id, false);
+
+        // Simulate the feedback given by each marker.
+        $context = $assign->get_context();
+        $fs = get_file_storage();
+        $markids = [];
+        foreach ([$teacher, $teacher2] as $i => $marker) {
+            $markid = $DB->insert_record('assign_mark', [
+                'assignment' => $instance->id,
+                'gradeid' => $grade->id,
+                'timecreated' => time(),
+                'timemodified' => time(),
+                'marker' => $marker->id,
+                'mark' => 50 + $i,
+            ]);
+            $markids[$marker->id] = $markid;
+
+            $DB->insert_record('assignfeedback_comments', [
+                'assignment' => $instance->id,
+                'grade' => $grade->id,
+                'mark' => $markid,
+                'commenttext' => 'Comment from marker ' . ($i + 1),
+                'commentformat' => FORMAT_HTML,
+            ]);
+
+            $fs->create_file_from_string([
+                'contextid' => $context->id,
+                'component' => 'assignfeedback_file',
+                'filearea' => ASSIGNFEEDBACK_FILE_FILEAREA_MARKER,
+                'itemid' => $markid,
+                'filepath' => '/',
+                'filename' => 'marker' . ($i + 1) . '.txt',
+            ], 'marker feedback file');
+        }
+
+        $this->setUser($student1);
+
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id);
+        // We expect debugging because of the $PAGE object, this won't happen in a normal WS request.
+        $this->assertDebuggingCalled();
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+
+        $this->assertTrue(isset($result['feedback']));
+        $this->assertTrue(isset($result['feedback']['grade']));
+        $this->assertEquals($teacher->id, $result['feedback']['grade']['grader']);
+
+        // The overall feedback must not include the markers feedback.
+        $plugins = array_column($result['feedback']['plugins'], null, 'type');
+        $this->assertEquals('Overall comment', $plugins['comments']['editorfields'][0]['text']);
+        foreach ($plugins['file']['fileareas'] as $filearea) {
+            $this->assertStringEndsNotWith('_marker', $filearea['area']);
+            $this->assertEmpty($filearea['files']);
+        }
+
+        // Check the feedback given by each marker.
+        $this->assertCount(2, $result['feedback']['markers']);
+        foreach ([$teacher, $teacher2] as $i => $marker) {
+            $markerfeedback = $result['feedback']['markers'][$i];
+            $this->assertEquals($markids[$marker->id], $markerfeedback['markid']);
+            $this->assertEquals($marker->id, $markerfeedback['marker']);
+
+            $plugins = array_column($markerfeedback['plugins'], null, 'type');
+            $this->assertEquals('Comment from marker ' . ($i + 1), $plugins['comments']['editorfields'][0]['text']);
+            $this->assertEquals(ASSIGNFEEDBACK_COMMENTS_FILEAREA_MARKER, $plugins['comments']['fileareas'][0]['area']);
+
+            $this->assertCount(1, $plugins['file']['fileareas']);
+            $this->assertEquals(ASSIGNFEEDBACK_FILE_FILEAREA_MARKER, $plugins['file']['fileareas'][0]['area']);
+            $this->assertCount(1, $plugins['file']['fileareas'][0]['files']);
+            $this->assertEquals('marker' . ($i + 1) . '.txt', $plugins['file']['fileareas'][0]['files'][0]['filename']);
+        }
+
+        // Now hide the grader, the markers identities must be hidden too.
+        $this->setAdminUser();
+        $instance = $assign->get_instance();
+        $instance->instance = $instance->id;
+        $instance->hidegrader = true;
+        $assign->update_instance($instance);
+
+        $this->setUser($student1);
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id);
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+
+        $this->assertEquals(-1, $result['feedback']['grade']['grader']);
+        $this->assertCount(2, $result['feedback']['markers']);
+        foreach ($result['feedback']['markers'] as $i => $markerfeedback) {
+            $this->assertEquals(-1, $markerfeedback['marker']);
+            $plugins = array_column($markerfeedback['plugins'], null, 'type');
+            $this->assertEquals('Comment from marker ' . ($i + 1), $plugins['comments']['editorfields'][0]['text']);
+        }
+
+        // The teacher can see the markers identities.
+        $this->setUser($teacher);
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id, $student1->id);
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+        $this->assertEquals($teacher->id, $result['feedback']['markers'][0]['marker']);
+        $this->assertEquals($teacher2->id, $result['feedback']['markers'][1]['marker']);
+    }
+
     /**
      * Test get_submission_status with override for student.
      */
