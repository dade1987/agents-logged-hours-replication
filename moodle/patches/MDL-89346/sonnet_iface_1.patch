+     * @param  bool $showmarkers whether the identity of the markers can be shown
+     * @return array a list of markers with their feedback plugins data
+     */
+    private static function get_markers_feedback_data($assign, $feedbackplugins, $grade, int $userid, bool $showmarkers): array {
+        $instance = $assign->get_instance();
+        $multiplemarkers = $instance->markercount > 1 || !empty($instance->optionalmarkercount);
+        if (!$showmarkers || !$multiplemarkers || empty($grade->id)) {
+            return [];
+        }
+
+        $result = [];
+        foreach ($assign->get_mark_records($grade->id, $userid) as $markerid => $mark) {
+            $plugins = self::get_plugins_data($assign, $feedbackplugins, $grade, (int) $mark->id);
+            $result[] = [
+                'markid' => (int) $mark->id,
+                'markerid' => (int) $markerid,
+                'plugins' => $plugins,
+            ];
+        }
+        return $result;
+    }
