+    /**
+     * Return the feedback information (files and text fields) of each individual marker for the given grade.
+     *
+     * This is only relevant for assignments using multiple markers, where each marker can provide their own feedback
+     * via the feedback plugins.
+     *
+     * @param  assign $assign the assignment object
+     * @param  array $feedbackplugins array of feedback plugins
+     * @param  stdClass $grade the grade object
+     * @param  bool $showmarker whether the identity of the markers can be disclosed
+     * @return array an array containing, for each mark record, the mark id, the marker id and the plugins information
+     */
+    private static function get_markers_feedback_data($assign, $feedbackplugins, $grade, bool $showmarker): array {
+        global $DB;
+
+        $markersfeedback = [];
+        $markrecords = $DB->get_records('assign_mark', ['gradeid' => $grade->id], 'id ASC', 'id, marker');
+        foreach ($markrecords as $markrecord) {
+            $markersfeedback[] = [
+                'markid' => (int) $markrecord->id,
+                'marker' => $showmarker ? (int) $markrecord->marker : -1,
+                'plugins' => self::get_plugins_data($assign, $feedbackplugins, $grade, (int) $markrecord->id),
+            ];
+        }
+        return $markersfeedback;
+    }
