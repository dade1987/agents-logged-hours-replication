diff --git a/public/mod/assign/feedbackplugin.php b/public/mod/assign/feedbackplugin.php
index 1bc114f628a..9098570a948 100644
--- a/public/mod/assign/feedbackplugin.php
+++ b/public/mod/assign/feedbackplugin.php
@@ -268,4 +268,27 @@ abstract class assign_feedback_plugin extends assign_plugin {
     public function has_downloadable_marker_columns(): bool {
         return false;
     }
+
+    /**
+     * Get the list of file areas this plugin uses to store files belonging to an individual marker's feedback.
+     *
+     * The item id used for these file areas is the id of the related assign_mark record (instead of the grade id).
+     * Plugins that support feedback per marker (multiple markers assignments) should override this method.
+     *
+     * @return array An array of fileareas (keys) and descriptions (values).
+     */
+    public function get_marker_file_areas(): array {
+        return [];
+    }
+
+    /**
+     * Get the list of file areas this plugin uses to store files belonging to the overall feedback (not marker ones).
+     *
+     * The item id used for these file areas is the grade id.
+     *
+     * @return array An array of fileareas (keys) and descriptions (values).
+     */
+    public function get_overall_file_areas(): array {
+        return array_diff_key($this->get_file_areas(), $this->get_marker_file_areas());
+    }
 }
diff --git a/public/mod/assign/tests/externallib_test.php b/public/mod/assign/tests/externallib_test.php
index 0e81fb88513..243c471141e 100644
--- a/public/mod/assign/tests/externallib_test.php
+++ b/public/mod/assign/tests/externallib_test.php
@@ -2408,6 +2408,124 @@ final class externallib_test extends \mod_assign\externallib_advanced_testcase {
         $this->assertEquals(['attachments' => ['intro' => []]], $result['assignmentdata']);
     }
 
+    /**
+     * Test get_submission_status returns the feedback of each individual marker (multiple markers).
+     */
+    public function test_get_submission_status_markers_feedback(): void {
+        global $DB;
+
+        $this->resetAfterTest(true);
+
+        list($assign, $instance, $student1, $student2, $teacher, $g1, $g2) = $this->create_submission_for_testing_status(true);
+
+        $teacher2 = self::getDataGenerator()->create_user();
+        $teacherrole = $DB->get_record('role', ['shortname' => 'teacher']);
+        $this->getDataGenerator()->enrol_user($teacher2->id, $assign->get_course()->id, $teacherrole->id);
+
+        // Grade the assign for the student1 with an overall feedback comment.
+        $this->setUser($teacher);
+
+        $data = new \stdClass();
+        $data->grade = '50.0';
+        $data->assignfeedbackcomments_editor = ['text' => 'Overall comment', 'format' => FORMAT_HTML];
+        $assign->testable_apply_grade_to_user($data, $student1->id, 0);
+
+        // Now add the feedback comments of two individual markers.
+        $grade = $assign->get_user_grade($student1->id, false);
+        $mark1 = $assign->get_mark($grade->id, $teacher->id, true);
+        $mark2 = $assign->get_mark($grade->id, $teacher2->id, true);
+        $commentsplugin = $assign->get_feedback_plugin_by_type('comments');
+        $commentsplugin->set_editor_text('comments', 'Marker 1 comment', $grade->id, $mark1->id);
+        $commentsplugin->set_editor_text('comments', 'Marker 2 comment', $grade->id, $mark2->id);
+
+        // Add a feedback file for the second marker.
+        $fs = get_file_storage();
+        $filerecord = [
+            'contextid' => $assign->get_context()->id,
+            'component' => 'assignfeedback_file',
+            'filearea'  => ASSIGNFEEDBACK_FILE_FILEAREA_MARKER,
+            'itemid'    => $mark2->id,
+            'filepath'  => '/',
+            'filename'  => 'marker2.txt',
+        ];
+        $fs->create_file_from_string($filerecord, 'Marker 2 file contents');
+
+        $this->setUser($student1);
+
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id);
+        // We expect debugging because of the $PAGE object, this won't happen in a normal WS request.
+        $this->assertDebuggingCalled();
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+
+        $this->assertTrue(isset($result['feedback']));
+        $this->assertTrue(isset($result['feedback']['grade']));
+        $this->assertEquals($teacher->id, $result['feedback']['grade']['grader']);
+
+        // Overall feedback.
+        $feedbackplugins = [];
+        foreach ($result['feedback']['plugins'] as $plugin) {
+            $feedbackplugins[$plugin['type']] = $plugin;
+        }
+        $this->assertEquals('Overall comment', $feedbackplugins['comments']['editorfields'][0]['text']);
+        // The marker file areas must not be returned as part of the overall feedback.
+        foreach ($feedbackplugins['file']['fileareas'] as $filearea) {
+            $this->assertNotEquals(ASSIGNFEEDBACK_FILE_FILEAREA_MARKER, $filearea['area']);
+        }
+
+        // Markers feedback.
+        $this->assertCount(2, $result['feedback']['markers']);
+
+        $this->assertEquals($mark1->id, $result['feedback']['markers'][0]['markid']);
+        $this->assertEquals($teacher->id, $result['feedback']['markers'][0]['marker']);
+        $markerplugins = [];
+        foreach ($result['feedback']['markers'][0]['plugins'] as $plugin) {
+            $markerplugins[$plugin['type']] = $plugin;
+        }
+        $this->assertEquals('Marker 1 comment', $markerplugins['comments']['editorfields'][0]['text']);
+        $this->assertEquals(ASSIGNFEEDBACK_FILE_FILEAREA_MARKER, $markerplugins['file']['fileareas'][0]['area']);
+        $this->assertEmpty($markerplugins['file']['fileareas'][0]['files']);
+
+        $this->assertEquals($mark2->id, $result['feedback']['markers'][1]['markid']);
+        $this->assertEquals($teacher2->id, $result['feedback']['markers'][1]['marker']);
+        $markerplugins = [];
+        foreach ($result['feedback']['markers'][1]['plugins'] as $plugin) {
+            $markerplugins[$plugin['type']] = $plugin;
+        }
+        $this->assertEquals('Marker 2 comment', $markerplugins['comments']['editorfields'][0]['text']);
+        $this->assertEquals(ASSIGNFEEDBACK_FILE_FILEAREA_MARKER, $markerplugins['file']['fileareas'][0]['area']);
+        $this->assertCount(1, $markerplugins['file']['fileareas'][0]['files']);
+        $this->assertEquals('marker2.txt', $markerplugins['file']['fileareas'][0]['files'][0]['filename']);
+
+        // Now change the setting so the grader is hidden.
+        $this->setAdminUser();
+
+        $instance = $assign->get_instance();
+        $instance->instance = $instance->id;
+        $instance->hidegrader = true;
+        $assign->update_instance($instance);
+
+        $this->setUser($student1);
+
+        // Check that the student cannot see the markers anymore.
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id);
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+
+        $this->assertEquals(-1, $result['feedback']['grade']['grader']);
+        $this->assertCount(2, $result['feedback']['markers']);
+        $this->assertEquals(-1, $result['feedback']['markers'][0]['marker']);
+        $this->assertEquals(-1, $result['feedback']['markers'][1]['marker']);
+
+        // Check that the teacher can see the markers.
+        $this->setUser($teacher);
+
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id, $student1->id);
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+
+        $this->assertCount(2, $result['feedback']['markers']);
+        $this->assertEquals($teacher->id, $result['feedback']['markers'][0]['marker']);
+        $this->assertEquals($teacher2->id, $result['feedback']['markers'][1]['marker']);
+    }
+
     /**
      * Test get_submission_status with override for student.
      */
