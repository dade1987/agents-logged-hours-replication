+    /**
+     * Test get_submission_status returns the feedback of each individual marker.
+     *
+     * @covers \mod_assign_external::get_submission_status
+     */
+    public function test_get_submission_status_markers_feedback(): void {
+        global $CFG;
+        require_once($CFG->dirroot . '/mod/assign/feedback/file/constants.php');
+        $this->resetAfterTest(true);
+
+        list($assign, $instance, $student1, $student2, $teacher, $g1, $g2) = $this->create_submission_for_testing_status(true);
+        $teacher2 = self::getDataGenerator()->create_and_enrol($assign->get_course(), 'teacher');
+        $teacher3 = self::getDataGenerator()->create_and_enrol($assign->get_course(), 'teacher');
+
+        // Grade the assign for the student1, with an overall feedback comment.
+        $this->setUser($teacher);
+        $data = new \stdClass();
+        $data->grade = '50.0';
+        $data->assignfeedbackcomments_editor = ['text' => 'Overall feedback', 'format' => FORMAT_HTML];
+        $assign->testable_apply_grade_to_user($data, $student1->id, 0);
+        $grade = $assign->get_user_grade($student1->id, false);
+
+        // Add feedback from individual markers.
+        $commentsplugin = $assign->get_feedback_plugin_by_type('comments');
+        $mark1 = $assign->get_mark($grade->id, $teacher->id, true);
+        $commentsplugin->set_editor_text('comments', 'Marker 1 feedback', $grade->id, (int) $mark1->id);
+        $mark2 = $assign->get_mark($grade->id, $teacher2->id, true);
+        $commentsplugin->set_editor_text('comments', 'Marker 2 feedback', $grade->id, (int) $mark2->id);
+        $fs = get_file_storage();
+        $fs->create_file_from_string([
+            'contextid' => $assign->get_context()->id,
+            'component' => 'assignfeedback_file',
+            'filearea' => ASSIGNFEEDBACK_FILE_FILEAREA_MARKER,
+            'itemid' => $mark2->id,
+            'filepath' => '/',
+            'filename' => 'marker2.txt',
+        ], 'Marker 2 file');
+        // A marker without feedback.
+        $assign->get_mark($grade->id, $teacher3->id, true);
+
+        $this->setUser($student1);
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id);
+        // We expect debugging because of the $PAGE object, this won't happen in a normal WS request.
+        $this->assertDebuggingCalled();
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+
+        // Overall feedback.
+        $feedbackplugins = [];
+        foreach ($result['feedback']['plugins'] as $plugin) {
+            $feedbackplugins[$plugin['type']] = $plugin;
+        }
+        $this->assertEquals('Overall feedback', $feedbackplugins['comments']['editorfields'][0]['text']);
+
+        // Markers feedback (marker without feedback is not returned).
+        $this->assertCount(2, $result['feedback']['markersfeedback']);
+        $markersfeedback = [];
+        foreach ($result['feedback']['markersfeedback'] as $markerfeedback) {
+            $plugins = [];
+            foreach ($markerfeedback['plugins'] as $plugin) {
+                $plugins[$plugin['type']] = $plugin;
+            }
+            $markersfeedback[$markerfeedback['markerid']] = $plugins;
+        }
+        $this->assertEquals('Marker 1 feedback', $markersfeedback[$teacher->id]['comments']['editorfields'][0]['text']);
+        $this->assertEmpty($markersfeedback[$teacher->id]['file']['fileareas'][0]['files']);
+        $this->assertEquals('Marker 2 feedback', $markersfeedback[$teacher2->id]['comments']['editorfields'][0]['text']);
+        $this->assertEquals(ASSIGNFEEDBACK_FILE_FILEAREA_MARKER, $markersfeedback[$teacher2->id]['file']['fileareas'][0]['area']);
+        $this->assertCount(1, $markersfeedback[$teacher2->id]['file']['fileareas'][0]['files']);
+        $this->assertEquals('marker2.txt',
+            $markersfeedback[$teacher2->id]['file']['fileareas'][0]['files'][0]['filename']);
+
+        // Hide the grader, the markers identity should be hidden too.
+        $this->setAdminUser();
+        $instance = $assign->get_instance();
+        $instance->instance = $instance->id;
+        $instance->hidegrader = true;
+        $assign->update_instance($instance);
+
+        $this->setUser($student1);
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id);
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+        $this->assertCount(2, $result['feedback']['markersfeedback']);
+        foreach ($result['feedback']['markersfeedback'] as $markerfeedback) {
+            $this->assertEquals(-1, $markerfeedback['markerid']);
+        }
+    }
+
     /**
      * Test get_submission_status with override for student.
      */
