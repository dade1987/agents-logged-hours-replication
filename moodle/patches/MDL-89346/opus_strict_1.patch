+    /**
+     * Return the feedback given by each individual marker (multiple marking) for the given grade.
+     *
+     * @param assign $assign the assignment object
+     * @param stdClass $grade the grade object
+     * @param array $feedbackplugins the feedback plugins
+     * @param bool $showmarkername whether the identity of the markers can be returned
+     * @return array list of markers feedback, each with the marker id and the plugins data
+     */
+    private static function get_markers_feedback_data(assign $assign, stdClass $grade, array $feedbackplugins,
+            bool $showmarkername): array {
+        global $DB;
+
+        if (empty($grade->id)) {
+            return [];
+        }
+
+        $markersfeedback = [];
+        $markrecords = $DB->get_records('assign_mark', ['gradeid' => $grade->id], 'id ASC', 'id, marker');
+        foreach ($markrecords as $markrecord) {
+            if (empty($markrecord->marker) || $markrecord->marker == $grade->userid) {
+                continue;
+            }
+
+            $plugins = self::get_plugins_data($assign, $feedbackplugins, $grade, (int) $markrecord->id);
+
+            // Only return the markers who have provided some feedback.
+            $hasfeedback = false;
+            foreach ($plugins as $plugin) {
+                foreach ($plugin['editorfields'] ?? [] as $editorfield) {
+                    if (trim((string) $editorfield['text']) !== '') {
+                        $hasfeedback = true;
+                        break 2;
+                    }
+                }
+                foreach ($plugin['fileareas'] ?? [] as $filearea) {
+                    if (!empty($filearea['files'])) {
+                        $hasfeedback = true;
+                        break 2;
+                    }
+                }
+            }
+            if (!$hasfeedback) {
+                continue;
+            }
+
+            $markersfeedback[] = [
+                'markerid' => $showmarkername ? (int) $markrecord->marker : -1,
+                'plugins' => $plugins,
+            ];
+        }
+
+        return $markersfeedback;
+    }
+
+    /**
+     * Creates the structure for the feedback of each individual marker.
+     *
+     * @param string $desc the structure description
+     * @return external_multiple_structure
+     */
+    private static function get_markers_feedback_structure(string $desc): external_multiple_structure {
+        return new external_multiple_structure(
+            new external_single_structure([
+                'markerid' => new external_value(PARAM_INT, 'The marker user id, -1 if the marker is hidden.'),
+                'plugins' => new external_multiple_structure(self::get_plugin_structure(), 'Marker feedback plugins info.',
+                    VALUE_OPTIONAL),
+            ]),
+            $desc,
+            VALUE_OPTIONAL
+        );
+    }
+
