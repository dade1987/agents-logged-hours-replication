+    /**
+     * Return the feedback given by each allocated marker for a grade (multiple markers).
+     *
+     * @param  assign $assign the assignment object
+     * @param  stdClass $grade the grade record
+     * @param  array $feedbackplugins the feedback plugins of the assignment
+     * @param  bool $showgradername whether the marker identities can be shown
+     * @return array the feedback of each marker that has a mark record, keyed by marker position
+     */
+    private static function get_markers_feedback($assign, $grade, $feedbackplugins, bool $showgradername): array {
+        $markers = [];
+        foreach ($assign->get_marker_allocations($grade->userid, false) as $position => $allocation) {
+            $mark = $assign->get_mark($grade->id, $allocation->marker);
+            if (!$mark) {
+                continue;
+            }
+            $markers[] = [
+                'markernumber' => $position,
+                'markerid' => $showgradername ? $allocation->marker : -1,
+                'plugins' => self::get_plugins_data($assign, $feedbackplugins, $grade, $mark->id),
+            ];
+        }
+        return $markers;
+    }
