+    /**
+     * Return the feedback of each marker for the given grade (multiple markers).
+     *
+     * @param assign $assign the assignment object
+     * @param array $feedbackplugins array of feedback plugins
+     * @param stdClass $grade the grade object
+     * @param bool $showgradername whether the identity of the markers can be returned
+     * @return array list of markers feedback
+     */
+    private static function get_markers_feedback_data($assign, array $feedbackplugins, stdClass $grade, bool $showgradername): array {
+        global $DB;
+
+        $markersfeedback = [];
+        $marks = $DB->get_records('assign_mark', ['gradeid' => $grade->id], 'id ASC', 'id, marker, timemodified');
+        foreach ($marks as $mark) {
+            if ($mark->marker <= 0 || $mark->marker == $grade->userid) {
+                continue;
+            }
+            $markersfeedback[] = [
+                'markid' => $mark->id,
+                'marker' => $showgradername ? $mark->marker : -1,
+                'timemodified' => $mark->timemodified,
+                'plugins' => self::get_plugins_data($assign, $feedbackplugins, $grade, (int) $mark->id),
+            ];
+        }
+        return $markersfeedback;
+    }
