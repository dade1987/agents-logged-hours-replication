+    /**
+     * Test get_submission_status returns the feedback of each marker when using multiple markers.
+     */
+    public function test_get_submission_status_markers_feedback(): void {
+        global $DB;
+        $this->resetAfterTest(true);
+
+        list($assign, $instance, $student1, $student2, $teacher, $g1, $g2) = $this->create_submission_for_testing_status(true);
+        $teacher2 = $this->getDataGenerator()->create_and_enrol($assign->get_course(), 'editingteacher');
+
+        // Grade the assign for the student1.
+        $this->setUser($teacher);
+        $data = new \stdClass();
+        $data->grade = '50.0';
+        $data->assignfeedbackcomments_editor = ['text' => 'Overall feedback', 'format' => FORMAT_HTML];
+        $assign->testable_apply_grade_to_user($data, $student1->id, 0);
+        $grade = $assign->get_user_grade($student1->id, false);
+
+        // Add the marks and the feedback of each marker.
+        $markids = [];
+        foreach ([$teacher, $teacher2] as $i => $marker) {
+            $markids[$i] = $DB->insert_record('assign_mark', [
+                'assignment' => $instance->id,
+                'gradeid' => $grade->id,
+                'marker' => $marker->id,
+                'mark' => 40 + $i,
+                'timecreated' => time(),
+                'timemodified' => time(),
+            ]);
+            $DB->insert_record('assignfeedback_comments', [
+                'assignment' => $instance->id,
+                'grade' => $grade->id,
+                'mark' => $markids[$i],
+                'commenttext' => 'Marker feedback ' . $i,
+                'commentformat' => FORMAT_HTML,
+            ]);
+        }
+
+        $this->setUser($student1);
+        $result = mod_assign_external::get_submission_status($instance->id);
+        $this->assertDebuggingCalled();
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+
+        // Overall feedback.
+        $plugins = array_column($result['feedback']['plugins'], null, 'type');
+        $this->assertEquals('Overall feedback', $plugins['comments']['editorfields'][0]['text']);
+
+        // Markers feedback.
+        $this->assertCount(2, $result['feedback']['markersfeedback']);
+        foreach ([$teacher, $teacher2] as $i => $marker) {
+            $markerfeedback = $result['feedback']['markersfeedback'][$i];
+            $this->assertEquals($markids[$i], $markerfeedback['markid']);
+            $this->assertEquals($marker->id, $markerfeedback['marker']);
+            $plugins = array_column($markerfeedback['plugins'], null, 'type');
+            $this->assertEquals('Marker feedback ' . $i, $plugins['comments']['editorfields'][0]['text']);
+        }
+
+        // Hide the grader, markers identity should not be returned.
+        $this->setAdminUser();
+        $instance = $assign->get_instance();
+        $instance->instance = $instance->id;
+        $instance->hidegrader = true;
+        $assign->update_instance($instance);
+
+        $this->setUser($student1);
+        $result = mod_assign_external::get_submission_status($instance->id);
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+        $this->assertCount(2, $result['feedback']['markersfeedback']);
+        foreach ($result['feedback']['markersfeedback'] as $markerfeedback) {
+            $this->assertEquals(-1, $markerfeedback['marker']);
+        }
+    }
+
