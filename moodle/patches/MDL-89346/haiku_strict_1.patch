+    /**
+     * Return the feedback given by each marker of the assignment for the grade of a user.
+     *
+     * @param assign $assign the assignment object
+     * @param array $assignplugins array of assignment feedback plugins
+     * @param stdClass $grade the grade object
+     * @param int $userid the id of the student the grade belongs to
+     * @param bool $showgradername whether the identity of the markers can be shown
+     * @return array an array with the feedback of each marker
+     */
+    private static function get_marker_feedback_data($assign, $assignplugins, $grade, $userid, $showgradername) {
+        $markerfeedback = array();
+
+        foreach ($assign->get_mark_records($grade->id, $userid) as $mark) {
+            $markerfeedback[] = array(
+                'marker' => $showgradername ? $mark->marker : -1,
+                'plugins' => self::get_plugins_data($assign, $assignplugins, $grade, $mark->id),
+            );
+        }
+
+        return $markerfeedback;
+    }
