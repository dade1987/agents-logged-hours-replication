+    /**
+     * Return the feedback given by each individual marker (when using multiple marking) for the given grade.
+     *
+     * @param assign $assign the assignment object
+     * @param stdClass $grade the grade object
+     * @param int $userid the id of the student the grade belongs to
+     * @param bool $showgradername whether the identity of the markers can be shown
+     * @return array an array containing the information for each marker
+     */
+    private static function get_markers_feedback_data(assign $assign, stdClass $grade, int $userid, bool $showgradername): array {
+        if (empty($grade->id) || !$assign->is_using_multiple_marking()) {
+            return [];
+        }
+
+        $context = $assign->get_context();
+        $feedbackplugins = $assign->get_feedback_plugins();
+        $markers = [];
+        foreach ($assign->get_mark_records($grade->id, $userid) as $mark) {
+            if (empty($mark->marker) || $mark->marker == $userid ||
+                    !has_capability('mod/assign:grade', $context, $mark->marker)) {
+                continue;
+            }
+
+            $markers[] = [
+                'markid' => $mark->id,
+                'markerid' => $showgradername ? $mark->marker : -1,
+                'plugins' => self::get_plugins_data($assign, $feedbackplugins, $grade, (int) $mark->id),
+            ];
+        }
+
+        return $markers;
+    }
+
