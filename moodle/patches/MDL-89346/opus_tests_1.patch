diff --git a/public/mod/assign/feedbackplugin.php b/public/mod/assign/feedbackplugin.php
index 1bc114f628a..81fcf7cd84d 100644
--- a/public/mod/assign/feedbackplugin.php
+++ b/public/mod/assign/feedbackplugin.php
@@ -268,4 +268,26 @@ abstract class assign_feedback_plugin extends assign_plugin {
     public function has_downloadable_marker_columns(): bool {
         return false;
     }
+
+    /**
+     * Get the file areas used to store the feedback of individual markers (when using multiple marking).
+     *
+     * The item id for these file areas is the id of the assign_mark record.
+     *
+     * @return array An array of fileareas (keys) and descriptions (values). Default: no marker file areas.
+     */
+    public function get_marker_file_areas(): array {
+        return [];
+    }
+
+    /**
+     * Get the file areas used to store the overall feedback (not the individual markers feedback).
+     *
+     * The item id for these file areas is the id of the grade record.
+     *
+     * @return array An array of fileareas (keys) and descriptions (values).
+     */
+    public function get_overall_file_areas(): array {
+        return array_diff_key($this->get_file_areas(), $this->get_marker_file_areas());
+    }
 }
diff --git a/public/mod/assign/tests/externallib_test.php b/public/mod/assign/tests/externallib_test.php
index 0e81fb88513..df509fda9ea 100644
--- a/public/mod/assign/tests/externallib_test.php
+++ b/public/mod/assign/tests/externallib_test.php
@@ -3007,4 +3007,88 @@ final class externallib_test extends \mod_assign\externallib_advanced_testcase {
         $completiondata = $completion->get_data($cm);
         $this->assertEquals(1, $completiondata->completionstate);
     }
+    /**
+     * Test get_submission_status returns the feedback of each marker when using multiple marking.
+     *
+     * @covers \mod_assign_external::get_submission_status
+     */
+    public function test_get_submission_status_multiple_markers_feedback(): void {
+        global $DB;
+        $this->resetAfterTest(true);
+
+        $course = $this->getDataGenerator()->create_course();
+        $student = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $teacher1 = $this->getDataGenerator()->create_and_enrol($course, 'editingteacher');
+        $teacher2 = $this->getDataGenerator()->create_and_enrol($course, 'editingteacher');
+
+        $generator = $this->getDataGenerator()->get_plugin_generator('mod_assign');
+        $instance = $generator->create_instance([
+            'course' => $course->id,
+            'assignsubmission_onlinetext_enabled' => 1,
+            'assignfeedback_comments_enabled' => 1,
+            'markingworkflow' => 1,
+            'markingallocation' => 1,
+            'markercount' => 2,
+        ]);
+        $cm = get_coursemodule_from_instance('assign', $instance->id);
+        $context = \context_module::instance($cm->id);
+        $assign = new mod_assign_testable_assign($context, $cm, $course);
+
+        $this->setAdminUser();
+        $assign->update_marker_allocations($student->id, [1 => [$teacher1->id], 2 => [$teacher2->id]]);
+
+        // Each marker adds a mark and its own feedback comment.
+        $this->setUser($teacher1);
+        $plugin = $assign->get_feedback_plugin_by_type('comments');
+        $marks = [];
+        foreach ([$teacher1, $teacher2] as $i => $teacher) {
+            $grade = $assign->get_user_grade($student->id, true);
+            $grade->grader = $teacher->id;
+            $assign->update_mark($grade, 50 + $i, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW);
+            $mark = $assign->get_mark($grade->id, $teacher->id);
+            $plugin->set_editor_text('comments', 'Marker comment ' . $teacher->id, $grade->id, $mark->id);
+            $marks[$teacher->id] = $mark->id;
+        }
+
+        // Overall grade and feedback, released.
+        $this->setAdminUser();
+        $data = new \stdClass();
+        $data->grade = '50.0';
+        $data->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_RELEASED;
+        $data->assignfeedbackcomments_editor = ['text' => 'Overall comment', 'format' => FORMAT_HTML];
+        $assign->testable_apply_grade_to_user($data, $student->id, 0);
+
+        $this->setUser($student);
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id);
+        $this->assertDebuggingCalled();
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+
+        $this->assertTrue(isset($result['feedback']['plugins']));
+        $overall = array_values(array_filter($result['feedback']['plugins'], fn($p) => $p['type'] == 'comments'));
+        $this->assertEquals('Overall comment', $overall[0]['editorfields'][0]['text']);
+        $this->assertCount(2, $result['feedback']['markers']);
+        foreach ($result['feedback']['markers'] as $markerfeedback) {
+            $markerid = $markerfeedback['markerid'];
+            $this->assertEquals($marks[$markerid], $markerfeedback['markid']);
+            $comments = array_values(array_filter($markerfeedback['plugins'], fn($p) => $p['type'] == 'comments'));
+            $this->assertCount(1, $comments);
+            $this->assertEquals('Marker comment ' . $markerid, $comments[0]['editorfields'][0]['text']);
+            // Only plugins supporting marker feedback are returned.
+            foreach ($markerfeedback['plugins'] as $markerplugin) {
+                $this->assertTrue($assign->get_feedback_plugin_by_type($markerplugin['type'])->has_marker_columns());
+            }
+        }
+
+        // Hide the grader, markers identity must be hidden too.
+        $this->setAdminUser();
+        $DB->set_field('assign', 'hidegrader', 1, ['id' => $instance->id]);
+        $this->setUser($student);
+        $assign = new mod_assign_testable_assign($context, $cm, $course);
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id);
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+        $this->assertCount(2, $result['feedback']['markers']);
+        foreach ($result['feedback']['markers'] as $markerfeedback) {
+            $this->assertEquals(-1, $markerfeedback['markerid']);
+        }
+    }
 }
