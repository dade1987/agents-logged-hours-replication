diff --git a/public/mod/assign/tests/externallib_test.php b/public/mod/assign/tests/externallib_test.php
index 0e81fb88513..26ed7062e22 100644
--- a/public/mod/assign/tests/externallib_test.php
+++ b/public/mod/assign/tests/externallib_test.php
@@ -2408,6 +2408,150 @@ final class externallib_test extends \mod_assign\externallib_advanced_testcase {
         $this->assertEquals(['attachments' => ['intro' => []]], $result['assignmentdata']);
     }
 
+    /**
+     * Test get_submission_status returns the feedback of each individual marker in an assignment with multiple markers.
+     *
+     * @covers ::get_submission_status
+     */
+    public function test_get_submission_status_multiple_markers(): void {
+        global $DB;
+        $this->resetAfterTest(true);
+
+        [$assign, $instance, $student1, $student2, $teacher, $g1, $g2] = $this->create_submission_for_testing_status(true, [
+            'markingworkflow' => 1,
+            'markingallocation' => 1,
+            'markercount' => 2,
+            'multimarkmethod' => ASSIGN_MULTIMARKING_METHOD_MANUAL,
+        ]);
+        $course = $assign->get_course();
+
+        // Create a second marker.
+        $teacher2 = self::getDataGenerator()->create_user();
+        $teacherrole = $DB->get_record('role', ['shortname' => 'teacher']);
+        $this->getDataGenerator()->enrol_user($teacher2->id, $course->id, $teacherrole->id);
+        $this->getDataGenerator()->create_group_member(['groupid' => $g1->id, 'userid' => $teacher2->id]);
+
+        // Allocate both markers to student1.
+        $this->setAdminUser();
+        $assign->update_marker_allocations($student1->id, [1 => [$teacher->id], 2 => [$teacher2->id]]);
+
+        // Each marker adds its own mark and feedback comment.
+        $this->setUser($teacher);
+        $assign->set_is_marking(true);
+        $data = new \stdClass();
+        $data->mark = '60.0';
+        $data->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW;
+        $data->assignfeedbackcomments_editor = ['text' => 'Feedback from marker 1', 'format' => FORMAT_HTML];
+        $assign->testable_apply_grade_to_user($data, $student1->id, 0);
+
+        $this->setUser($teacher2);
+        $assign->set_is_marking(true);
+        $data = new \stdClass();
+        $data->mark = '70.0';
+        $data->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW;
+        $data->assignfeedbackcomments_editor = ['text' => 'Feedback from marker 2', 'format' => FORMAT_HTML];
+        $assign->testable_apply_grade_to_user($data, $student1->id, 0);
+
+        // The feedback is not released yet, so the student should not see any feedback.
+        $this->setUser($student1);
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id);
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+        $this->assertFalse(isset($result['feedback']));
+
+        // Now, set the overall grade and feedback and release the grades.
+        $this->setUser($teacher);
+        $assign->set_is_marking(false);
+        $data = new \stdClass();
+        $data->grade = '65.0';
+        $data->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_RELEASED;
+        $data->assignfeedbackcomments_editor = ['text' => 'Overall feedback', 'format' => FORMAT_HTML];
+        $assign->testable_apply_grade_to_user($data, $student1->id, 0);
+
+        $grade = $assign->get_user_grade($student1->id, false);
+        $mark1 = $assign->get_mark($grade->id, $teacher->id);
+        $mark2 = $assign->get_mark($grade->id, $teacher2->id);
+        $this->assertNotEmpty($mark1);
+        $this->assertNotEmpty($mark2);
+
+        // Check the student can see the overall feedback and the feedback of each marker.
+        $this->setUser($student1);
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id);
+        // We expect debugging because of the $PAGE object, this won't happen in a normal WS request.
+        $this->assertDebuggingCalled();
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+
+        $this->assertTrue(isset($result['feedback']));
+        $this->assertEquals($teacher->id, $result['feedback']['grade']['grader']);
+
+        // Overall feedback.
+        $overallcomments = null;
+        foreach ($result['feedback']['plugins'] as $plugin) {
+            if ($plugin['type'] == 'comments') {
+                $overallcomments = $plugin;
+            }
+            // The marker file areas must not be part of the overall feedback.
+            foreach ($plugin['fileareas'] ?? [] as $filearea) {
+                $this->assertNotEquals(ASSIGNFEEDBACK_FILE_FILEAREA_MARKER, $filearea['area']);
+                $this->assertNotEquals(ASSIGNFEEDBACK_COMMENTS_FILEAREA_MARKER, $filearea['area']);
+            }
+        }
+        $this->assertNotNull($overallcomments);
+        $this->assertEquals('Overall feedback', $overallcomments['editorfields'][0]['text']);
+
+        // Feedback from each marker.
+        $this->assertCount(2, $result['feedback']['markerfeedback']);
+        $expected = [
+            $teacher->id => 'Feedback from marker 1',
+            $teacher2->id => 'Feedback from marker 2',
+        ];
+        foreach ($result['feedback']['markerfeedback'] as $markerfeedback) {
+            $this->assertArrayHasKey($markerfeedback['marker'], $expected);
+            $markercomments = null;
+            foreach ($markerfeedback['plugins'] as $plugin) {
+                if ($plugin['type'] == 'comments') {
+                    $markercomments = $plugin;
+                    $this->assertEquals(ASSIGNFEEDBACK_COMMENTS_FILEAREA_MARKER, $plugin['fileareas'][0]['area']);
+                } else if ($plugin['type'] == 'file') {
+                    $this->assertEquals(ASSIGNFEEDBACK_FILE_FILEAREA_MARKER, $plugin['fileareas'][0]['area']);
+                }
+            }
+            $this->assertNotNull($markercomments);
+            $this->assertEquals($expected[$markerfeedback['marker']], $markercomments['editorfields'][0]['text']);
+            unset($expected[$markerfeedback['marker']]);
+        }
+        $this->assertEmpty($expected);
+
+        // Now hide the grader, the markers identity must be hidden too.
+        $this->setAdminUser();
+        $instance = $assign->get_instance();
+        $instance->instance = $instance->id;
+        $instance->hidegrader = true;
+        $assign->update_instance($instance);
+
+        $this->setUser($student1);
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id);
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+
+        $this->assertEquals(-1, $result['feedback']['grade']['grader']);
+        $this->assertCount(2, $result['feedback']['markerfeedback']);
+        foreach ($result['feedback']['markerfeedback'] as $markerfeedback) {
+            $this->assertEquals(-1, $markerfeedback['marker']);
+            foreach ($markerfeedback['plugins'] as $plugin) {
+                if ($plugin['type'] == 'comments') {
+                    $this->assertStringStartsWith('Feedback from marker', $plugin['editorfields'][0]['text']);
+                }
+            }
+        }
+
+        // The teacher can see the markers.
+        $this->setUser($teacher);
+        $result = mod_assign_external::get_submission_status($assign->get_instance()->id, $student1->id);
+        $result = external_api::clean_returnvalue(mod_assign_external::get_submission_status_returns(), $result);
+        $this->assertCount(2, $result['feedback']['markerfeedback']);
+        $markers = array_column($result['feedback']['markerfeedback'], 'marker');
+        $this->assertEqualsCanonicalizing([$teacher->id, $teacher2->id], $markers);
+    }
+
     /**
      * Test get_submission_status with override for student.
      */
