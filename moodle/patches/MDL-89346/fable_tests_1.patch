+    /**
+     * Return the feedback information (files and text fields) given by each individual marker for the given grade.
+     *
+     * This only applies to assignments using multiple markers. Only the markers currently allocated to the
+     * student which have a mark record for the given grade are returned.
+     *
+     * @param  assign $assign the assignment object
+     * @param  array $feedbackplugins array of feedback plugins
+     * @param  stdClass $grade the grade object
+     * @param  int $userid the student user id
+     * @param  bool $showmarkername whether the identity of the markers can be shown (hidden grader setting)
+     * @return array an array containing, for each marker, the marker id and the plugins returned information
+     */
+    private static function get_marker_feedback_data($assign, $feedbackplugins, $grade, int $userid,
+            bool $showmarkername): array {
+
+        $markerfeedback = [];
+        if (empty($grade->id)) {
+            return $markerfeedback;
+        }
+
+        $marks = $assign->get_mark_records($grade->id, $userid);
+        foreach ($marks as $mark) {
+            $markerfeedback[] = [
+                'marker' => $showmarkername ? (int) $mark->marker : -1,
+                'plugins' => self::get_plugins_data($assign, $feedbackplugins, $grade, (int) $mark->id),
+            ];
+        }
+        return $markerfeedback;
+    }
+
+    /**
+     * Creates the structure describing the feedback given by each individual marker (multiple markers).
+     *
+     * @return external_multiple_structure the marker feedback structure
+     */
+    private static function get_marker_feedback_structure() {
+        return new external_multiple_structure(
+            new external_single_structure(
+                [
+                    'marker' => new external_value(PARAM_INT, 'The marker user id, -1 if the marker is hidden.'),
+                    'plugins' => new external_multiple_structure(self::get_plugin_structure(), 'Plugins info.', VALUE_OPTIONAL),
+                ]
+            ),
+            'Feedback given by each individual marker (for assignments with multiple markers).',
+            VALUE_OPTIONAL
+        );
+    }
+
