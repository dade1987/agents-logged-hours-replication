+    /** @var string File area used by the feedback plugins to store the feedback of each marker. */
+    const MARKER_FEEDBACK_FILEAREA = 'feedback_marker';
+
+    /**
+     * Return the feedback of each marker (multiple markers assignments) that the current user is allowed to see.
+     *
+     * @param  assign $assign the assignment object
+     * @param  array $feedbackplugins array of feedback plugins
+     * @param  stdClass $grade the grade object
+     * @param  stdClass $user the user the feedback belongs to
+     * @param  bool $showgradername whether the current user can see the identity of the graders
+     * @return array array with the feedback of each marker
+     */
+    private static function get_marker_feedback($assign, $feedbackplugins, $grade, $user, bool $showgradername): array {
+        global $DB;
+
+        $result = [];
+        if (empty($grade->id) || $assign->total_marker_count() <= 1) {
+            return $result;
+        }
+
+        $context = $assign->get_context();
+        $cangrade = has_capability('mod/assign:grade', $context);
+        if (!$cangrade && $assign->get_instance()->markingworkflow &&
+                $assign->get_grading_status($user->id) != ASSIGN_MARKING_WORKFLOW_STATE_RELEASED) {
+            // Don't show the feedback until it is released.
+            return $result;
+        }
+
+        $marks = $DB->get_records('assign_mark', ['gradeid' => $grade->id], 'id');
+        foreach ($marks as $mark) {
+            $plugins = self::get_plugins_data($assign, $feedbackplugins, $grade, (int) $mark->id);
+
+            // Skip the markers without any feedback.
+            $hasdata = false;
+            foreach ($plugins as $plugin) {
+                foreach ($plugin['editorfields'] ?? [] as $field) {
+                    if (trim((string) $field['text']) !== '') {
+                        $hasdata = true;
+                    }
+                }
+                foreach ($plugin['fileareas'] ?? [] as $area) {
+                    if (!empty($area['files'])) {
+                        $hasdata = true;
+                    }
+                }
+            }
+            if (!$hasdata) {
+                continue;
+            }
+
+            $result[] = [
+                'markid' => (int) $mark->id,
+                'markerid' => $showgradername ? (int) $mark->marker : -1,
+                'plugins' => $plugins,
+            ];
+        }
+
+        return $result;
+    }
