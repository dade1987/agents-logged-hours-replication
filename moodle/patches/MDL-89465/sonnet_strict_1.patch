+namespace core\check\security;
+
+use core\check\check;
+use core\check\result;
+
+/**
+ * Verifies that new login notifications are forced on.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2026 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class newloginnotification extends check {
+
+    #[\Override]
+    public function get_name(): string {
+        return get_string('check_newloginnotification_name', 'report_security');
+    }
+
+    #[\Override]
+    public function get_action_link(): ?\action_link {
+        return new \action_link(
+            new \moodle_url('/admin/message.php'),
+            get_string('defaultmessageoutputs', 'message'),
+        );
+    }
+
+    #[\Override]
+    public function get_result(): result {
+        $details = get_string('check_newloginnotification_details', 'report_security');
+
+        if ($this->is_forced_on()) {
+            return new result(result::OK, get_string('check_newloginnotification_ok', 'report_security'), $details);
+        }
+        return new result(result::WARNING, get_string('check_newloginnotification_error', 'report_security'), $details);
+    }
+
+    /**
+     * Is the new login notification forced on for at least one processor?
+     *
+     * @return bool
+     */
+    protected function is_forced_on(): bool {
+        $prefs = get_config('message');
+        if (!empty($prefs->moodle_newlogin_disable)) {
+            return false;
+        }
+        $enabled = explode(',', $prefs->message_provider_moodle_newlogin_enabled ?? '');
+        foreach (get_message_processors(true) as $name => $processor) {
+            $lockedname = $name . '_provider_moodle_newlogin_locked';
+            if (!empty($prefs->$lockedname) && in_array($name, $enabled)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
