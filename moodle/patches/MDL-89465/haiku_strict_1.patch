+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+/**
+ * Verifies that new login notifications are forced on.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+
+namespace core\check\security;
+
+defined('MOODLE_INTERNAL') || die();
+
+use core\check\check;
+use core\check\result;
+
+/**
+ * Verifies that new login notifications are forced on (locked for users) by the admin.
+ *
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class newloginnotifications extends check {
+
+    /**
+     * Get the short check name
+     *
+     * @return string
+     */
+    public function get_name(): string {
+        return get_string('check_newloginnotifications_name', 'report_security');
+    }
+
+    /**
+     * A link to a place to action this
+     *
+     * @return \action_link|null
+     */
+    public function get_action_link(): ?\action_link {
+        return new \action_link(
+            new \moodle_url('/admin/message.php'),
+            get_string('managemessageoutputs', 'message'));
+    }
+
+    /**
+     * Return result
+     * @return result
+     */
+    public function get_result(): result {
+        $details = get_string('check_newloginnotifications_details', 'report_security');
+        // New login notifications are sent by email, so the email processor setting is the one that matters.
+        $forced = !empty(get_config('message', 'email_provider_moodle_newlogin_locked'));
+        if ($forced) {
+            $status = result::OK;
+            $summary = get_string('check_newloginnotifications_ok', 'report_security');
+        } else {
+            $status = result::WARNING;
+            $summary = get_string('check_newloginnotifications_warning', 'report_security');
+        }
+        return new result($status, $summary, $details);
+    }
+}
