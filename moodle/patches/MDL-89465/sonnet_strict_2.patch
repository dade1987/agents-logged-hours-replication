+
+namespace core\check\security;
+
+use core\check\check;
+use core\check\result;
+
+/**
+ * Verifies that new login notifications are forced on.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2026 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class newlogin extends check {
+
+    /**
+     * Get the short check name
+     *
+     * @return string
+     */
+    #[\Override]
+    public function get_name(): string {
+        return get_string('check_newlogin_name', 'report_security');
+    }
+
+    /**
+     * A link to a place to action this
+     *
+     * @return \action_link|null
+     */
+    #[\Override]
+    public function get_action_link(): ?\action_link {
+        return new \action_link(
+            new \moodle_url('/admin/message.php'),
+            get_string('messageoutputs', 'message'),
+        );
+    }
+
+    /**
+     * Return result
+     * @return result
+     */
+    #[\Override]
+    public function get_result(): result {
+        $details = get_string('check_newlogin_details', 'report_security');
+        $config = get_config('message');
+
+        if (!empty($config->moodle_newlogin_disable)) {
+            return new result(result::WARNING, get_string('check_newlogin_disabled', 'report_security'), $details);
+        }
+
+        // Forced on means locked and enabled for at least one working processor.
+        $forced = false;
+        foreach (get_message_processors(true) as $processor) {
+            $base = $processor->name . '_provider_moodle_newlogin';
+            $locked = !empty($config->{$base . '_locked'});
+            $enabledlist = explode(',', (string) ($config->{'message_provider_moodle_newlogin_enabled'} ?? ''));
+            if ($locked && in_array($processor->name, $enabledlist)) {
+                $forced = true;
+                break;
+            }
+        }
+
+        if ($forced) {
+            return new result(result::OK, get_string('check_newlogin_ok', 'report_security'), $details);
+        }
+        return new result(result::WARNING, get_string('check_newlogin_error', 'report_security'), $details);
+    }
+}
