+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\check\security;
+
+use core\check\result;
+
+/**
+ * Tests for the new login notifications security check.
+ *
+ * @package    core
+ * @category   test
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \core\check\security\newloginnotifications
+ */
+final class newloginnotifications_test extends \advanced_testcase {
+    /**
+     * The check is registered as a security check.
+     */
+    public function test_check_is_registered(): void {
+        $checks = \core\check\manager::get_checks('security');
+        $found = array_filter($checks, fn($check) => $check instanceof newloginnotifications);
+        $this->assertCount(1, $found);
+    }
+
+    /**
+     * New login notifications are forced on by default on a new install.
+     */
+    public function test_default_is_forced(): void {
+        global $CFG;
+        $this->resetAfterTest();
+
+        // Simulate a new install: remove the current site defaults and re-apply those defined in lib/db/messages.php.
+        $messageproviders = [];
+        require($CFG->libdir . '/db/messages.php');
+        foreach (get_message_processors() as $processor) {
+            unset_config($processor->name . '_provider_moodle_newlogin_locked', 'message');
+        }
+        unset_config('message_provider_moodle_newlogin_enabled', 'message');
+        message_set_default_message_preference('moodle', 'newlogin', $messageproviders['newlogin']);
+
+        $check = new newloginnotifications();
+        $this->assertEquals(result::OK, $check->get_result()->get_status());
+        $this->assertNotNull($check->get_action_link());
+    }
+
+    /**
+     * Data provider for test_get_result.
+     *
+     * @return array
+     */
+    public static function get_result_provider(): array {
+        return [
+            'Forced for email' => [
+                ['email_provider_moodle_newlogin_locked' => 1, 'message_provider_moodle_newlogin_enabled' => 'email'],
+                result::OK,
+            ],
+            'Forced for popup, permitted for email' => [
+                [
+                    'email_provider_moodle_newlogin_locked' => 0,
+                    'popup_provider_moodle_newlogin_locked' => 1,
+                    'message_provider_moodle_newlogin_enabled' => 'email,popup',
+                ],
+                result::OK,
+            ],
+            'Permitted and enabled by default, but not forced' => [
+                [
+                    'email_provider_moodle_newlogin_locked' => 0,
+                    'popup_provider_moodle_newlogin_locked' => 0,
+                    'airnotifier_provider_moodle_newlogin_locked' => 0,
+                    'message_provider_moodle_newlogin_enabled' => 'email,popup,airnotifier',
+                ],
+                result::WARNING,
+            ],
+            'Locked but disabled (disallowed)' => [
+                [
+                    'email_provider_moodle_newlogin_locked' => 1,
+                    'popup_provider_moodle_newlogin_locked' => 1,
+                    'airnotifier_provider_moodle_newlogin_locked' => 1,
+                    'message_provider_moodle_newlogin_enabled' => 'none',
+                ],
+                result::WARNING,
+            ],
+            'Provider disabled' => [
+                ['moodle_newlogin_disable' => 1],
+                result::WARNING,
+            ],
+        ];
+    }
+
+    /**
+     * Test the check result for various site default preferences.
+     *
+     * @param array $preferences site default message preferences to set
+     * @param string $expected expected result status
+     */
+    #[\PHPUnit\Framework\Attributes\DataProvider('get_result_provider')]
+    public function test_get_result(array $preferences, string $expected): void {
+        $this->resetAfterTest();
+
+        foreach ($preferences as $name => $value) {
+            set_config($name, $value, 'message');
+        }
+
+        $check = new newloginnotifications();
+        $this->assertEquals($expected, $check->get_result()->get_status());
+    }
+
+    /**
+     * The check warns when no notification outputs are enabled.
+     */
+    public function test_get_result_no_processors(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $DB->set_field('message_processors', 'enabled', 0);
+        \core_plugin_manager::reset_caches();
+
+        $check = new newloginnotifications();
+        $result = $check->get_result();
+        $this->assertEquals(result::WARNING, $result->get_status());
+        $this->assertEquals(
+            get_string('check_newloginnotifications_noprocessors', 'report_security'),
+            $result->get_summary()
+        );
+    }
+}
diff --git a/public/lib/tests/task/send_login_notifications_test.php b/public/lib/tests/task/send_login_notifications_test.php
index b646c168dbe..26f03d05d68 100644
--- a/public/lib/tests/task/send_login_notifications_test.php
+++ b/public/lib/tests/task/send_login_notifications_test.php
@@ -60,6 +60,68 @@ final class send_login_notifications_test extends \advanced_testcase {
         $this->assertEquals('newlogin', $messages[0]->eventtype);
     }
 
+    /**
+     * Test new login notification is sent when forced on, even if the user has disabled it in their preferences.
+     */
+    public function test_login_notification_forced(): void {
+        global $SESSION;
+
+        $this->resetAfterTest();
+
+        \core\session\manager::set_cookies_supported(true);
+        $loginuser = self::getDataGenerator()->create_user();
+        // The user has opted out of the notification, but it is forced on for email at site level.
+        set_user_preference('message_provider_moodle_newlogin_enabled', 'none', $loginuser);
+        set_config('email_provider_moodle_newlogin_locked', 1, 'message');
+        set_config('popup_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('airnotifier_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('message_provider_moodle_newlogin_enabled', 'email', 'message');
+        $this->setUser(0);
+
+        // Mock data for test.
+        $loginuser->lastip = '1.2.3.4.6'; // Different ip that current.
+        $SESSION->isnewsessioncookie = true; // New session cookie.
+        @complete_user_login($loginuser);
+
+        // Redirect messages to sink and stop buffer output from CLI task.
+        $sink = $this->redirectMessages();
+        ob_start();
+        $this->runAdhocTasks(\core\task\send_login_notifications::class);
+        ob_get_contents();
+        ob_end_clean();
+        $messages = $sink->get_messages();
+        $sink->close();
+
+        $this->assertCount(1, $messages);
+        $this->assertEquals($loginuser->id, $messages[0]->useridto);
+        $this->assertEquals('newlogin', $messages[0]->eventtype);
+    }
+
+    /**
+     * Test new login notification is skipped when the user has disabled it and it is not forced on.
+     */
+    public function test_login_notification_skip_user_disabled(): void {
+        global $SESSION;
+
+        $this->resetAfterTest();
+
+        \core\session\manager::set_cookies_supported(true);
+        $loginuser = self::getDataGenerator()->create_user();
+        set_user_preference('message_provider_moodle_newlogin_enabled', 'none', $loginuser);
+        set_config('email_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('popup_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('airnotifier_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('message_provider_moodle_newlogin_enabled', 'email,popup,airnotifier', 'message');
+        $this->setUser(0);
+
+        // Mock data for test.
+        $loginuser->lastip = '1.2.3.4.6'; // Different ip that current.
+        $SESSION->isnewsessioncookie = true; // New session cookie.
+        @complete_user_login($loginuser);
+
+        $this->assertEmpty(\core\task\manager::get_adhoc_tasks(\core\task\send_login_notifications::class));
+    }
+
     /**
      * Test new login notification is skipped because of same IP from last login.
      */
