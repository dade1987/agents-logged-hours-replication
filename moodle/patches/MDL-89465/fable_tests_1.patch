+namespace core\check\security;
+
+use core\check\check;
+use core\check\result;
+
+/**
+ * Verifies that new login notifications are forced on.
+ *
+ * Users should be made aware of logins to their account from a new device,
+ * which reduces the risk of users being unaware of unauthorised logins.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class newloginnotifications extends check {
+    /**
+     * Get the short check name
+     *
+     * @return string
+     */
+    public function get_name(): string {
+        return get_string('check_newloginnotifications_name', 'report_security');
+    }
+
+    /**
+     * A link to a place to action this
+     *
+     * @return \action_link|null
+     */
+    public function get_action_link(): ?\action_link {
+        return new \action_link(
+            new \moodle_url('/admin/message.php'),
+            get_string('defaultmessageoutputs', 'message')
+        );
+    }
+
+    /**
+     * Return result
+     *
+     * @return result
+     */
+    public function get_result(): result {
+        global $CFG;
+        require_once($CFG->libdir . '/messagelib.php');
+
+        $details = get_string('check_newloginnotifications_details', 'report_security');
+        $defaultpreferences = get_message_output_default_preferences();
+        $preferencebase = 'moodle_newlogin';
+
+        // The provider has been disabled entirely at site level.
+        if (!empty($defaultpreferences->{$preferencebase . '_disable'})) {
+            return new result(
+                result::WARNING,
+                get_string('check_newloginnotifications_disabled', 'report_security'),
+                $details
+            );
+        }
+
+        // Only enabled notification outputs (processors) are able to send the notification.
+        $processors = get_message_processors(true);
+        if (empty($processors)) {
+            return new result(
+                result::WARNING,
+                get_string('check_newloginnotifications_noprocessors', 'report_security'),
+                $details
+            );
+        }
+
+        $enabledpreference = 'message_provider_' . $preferencebase . '_enabled';
+        $enabledprocessors = [];
+        if (!empty($defaultpreferences->{$enabledpreference})) {
+            $enabledprocessors = explode(',', $defaultpreferences->{$enabledpreference});
+        }
+
+        // The notification is forced on when at least one enabled processor is both locked and enabled.
+        foreach ($processors as $processor) {
+            $lockedpreference = $processor->name . '_provider_' . $preferencebase . '_locked';
+            if (!empty($defaultpreferences->{$lockedpreference}) && in_array($processor->name, $enabledprocessors)) {
+                return new result(
+                    result::OK,
+                    get_string('check_newloginnotifications_ok', 'report_security'),
+                    $details
+                );
+            }
+        }
+
+        return new result(
+            result::WARNING,
+            get_string('check_newloginnotifications_notforced', 'report_security'),
+            $details
+        );
+    }
+}
