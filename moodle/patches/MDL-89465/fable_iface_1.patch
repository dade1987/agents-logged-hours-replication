+
+namespace core\check\security;
+
+use core\check\check;
+use core\check\result;
+
+/**
+ * Verifies that security related notifications (new login notifications) are forced on.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class securitymessages extends check {
+    /** @var string The component of the new login message provider. */
+    private const PROVIDER_COMPONENT = 'moodle';
+
+    /** @var string The name of the new login message provider. */
+    private const PROVIDER_NAME = 'newlogin';
+
+    /**
+     * Get the short check name
+     *
+     * @return string
+     */
+    public function get_name(): string {
+        return get_string('check_securitymessages_name', 'report_security');
+    }
+
+    /**
+     * A link to a place to action this
+     *
+     * @return \action_link|null
+     */
+    public function get_action_link(): ?\action_link {
+        return new \action_link(
+            new \moodle_url('/admin/message.php'),
+            get_string('defaultmessageoutputs', 'message')
+        );
+    }
+
+    /**
+     * Return result
+     *
+     * @return result
+     */
+    public function get_result(): result {
+        global $CFG;
+        require_once($CFG->dirroot . '/message/lib.php');
+
+        $details = get_string('check_securitymessages_details', 'report_security');
+        $preferencebase = self::PROVIDER_COMPONENT . '_' . self::PROVIDER_NAME;
+        $defaultpreferences = get_message_output_default_preferences();
+
+        // The notification has been disabled completely at site level.
+        if (!empty($defaultpreferences->{$preferencebase . '_disable'})) {
+            return new result(
+                result::WARNING,
+                get_string('check_securitymessages_disabled', 'report_security'),
+                $details
+            );
+        }
+
+        // Find out which enabled message processors are forced on for this provider.
+        $enabledpreference = 'message_provider_' . $preferencebase . '_enabled';
+        $enabledprocessors = [];
+        if (!empty($defaultpreferences->{$enabledpreference})) {
+            $enabledprocessors = explode(',', $defaultpreferences->{$enabledpreference});
+        }
+
+        $forced = [];
+        foreach (get_message_processors(true) as $processor) {
+            $lockedpreference = $processor->name . '_provider_' . $preferencebase . '_locked';
+            if (!empty($defaultpreferences->{$lockedpreference}) && in_array($processor->name, $enabledprocessors)) {
+                $forced[] = $processor->name;
+            }
+        }
+
+        if (!empty($forced)) {
+            return new result(
+                result::OK,
+                get_string('check_securitymessages_ok', 'report_security'),
+                $details
+            );
+        }
+
+        return new result(
+            result::WARNING,
+            get_string('check_securitymessages_error', 'report_security'),
+            $details
+        );
+    }
+}
