diff --git a/public/lib/tests/check_test.php b/public/lib/tests/check_test.php
index 4d2c12a26c7..d850595d4e2 100644
--- a/public/lib/tests/check_test.php
+++ b/public/lib/tests/check_test.php
@@ -54,6 +54,43 @@ final class check_test extends \advanced_testcase {
         $CFG->passwordpolicy = $prior;
     }
 
+    /**
+     * Tests the security messages (new login notifications) check.
+     */
+    public function test_securitymessages(): void {
+        $this->resetAfterTest();
+
+        $check = new \core\check\security\securitymessages();
+
+        // Forced on by default on new installs.
+        $result = $check->get_result();
+        $this->assertEquals(result::OK, $result->get_status());
+
+        // Unlock all outputs so nothing is forced on.
+        set_config('popup_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('email_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('airnotifier_provider_moodle_newlogin_locked', 0, 'message');
+        $result = $check->get_result();
+        $this->assertEquals(result::WARNING, $result->get_status());
+
+        // Force email on again.
+        set_config('email_provider_moodle_newlogin_locked', 1, 'message');
+        set_config('message_provider_moodle_newlogin_enabled', 'email', 'message');
+        $result = $check->get_result();
+        $this->assertEquals(result::OK, $result->get_status());
+
+        // Locked but not enabled is not forced on.
+        set_config('message_provider_moodle_newlogin_enabled', 'popup', 'message');
+        $result = $check->get_result();
+        $this->assertEquals(result::WARNING, $result->get_status());
+
+        // Disabled completely at site level.
+        set_config('message_provider_moodle_newlogin_enabled', 'email', 'message');
+        set_config('moodle_newlogin_disable', 1, 'message');
+        $result = $check->get_result();
+        $this->assertEquals(result::WARNING, $result->get_status());
+    }
+
     /**
      * Tests that the component is correctly set.
      */
