+
+namespace core\check\security;
+
+use core\check\check;
+use core\check\result;
+
+/**
+ * Verifies that new login notifications are forced on.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2026 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class newlogin extends check {
+    #[\Override]
+    public function get_name(): string {
+        return get_string('check_newlogin_name', 'report_security');
+    }
+
+    #[\Override]
+    public function get_action_link(): ?\action_link {
+        return new \action_link(
+            new \moodle_url('/admin/message.php'),
+            get_string('defaultmessageoutputs', 'message'),
+        );
+    }
+
+    #[\Override]
+    public function get_result(): result {
+        global $CFG;
+        require_once($CFG->dirroot . '/lib/messagelib.php');
+
+        $details = get_string('check_newlogin_details', 'report_security');
+        $prefs = get_message_output_default_preferences();
+        $forced = empty($prefs->moodle_newlogin_disable);
+        if ($forced) {
+            $processors = get_message_processors(true);
+            $forced = !empty($processors);
+            $enabledlist = explode(',', $prefs->message_provider_moodle_newlogin_enabled ?? '');
+            foreach ($processors as $name => $processor) {
+                $lockedkey = $name . '_provider_moodle_newlogin_locked';
+                if (empty($prefs->$lockedkey) || !in_array($name, $enabledlist)) {
+                    $forced = false;
+                    break;
+                }
+            }
+        }
+
+        if ($forced) {
+            return new result(result::OK, get_string('check_newlogin_ok', 'report_security'), $details);
+        }
+        return new result(result::WARNING, get_string('check_newlogin_warning', 'report_security'), $details);
+    }
+}
