diff --git a/public/lib/tests/check_test.php b/public/lib/tests/check_test.php
index 4d2c12a26c7..19f99313d3a 100644
--- a/public/lib/tests/check_test.php
+++ b/public/lib/tests/check_test.php
@@ -17,6 +17,7 @@
 namespace core;
 
 use core\check\result;
+use core\check\security\newloginnotifications;
 use core\check\security\passwordpolicy;
 
 /**
@@ -54,6 +55,50 @@ final class check_test extends \advanced_testcase {
         $CFG->passwordpolicy = $prior;
     }
 
+    /**
+     * Test the new login notifications check.
+     *
+     * @covers \core\check\security\newloginnotifications
+     */
+    public function test_newloginnotifications(): void {
+        $this->resetAfterTest();
+
+        $check = new newloginnotifications();
+
+        // Forced on for email.
+        set_config('moodle_newlogin_disable', 0, 'message');
+        set_config('email_provider_moodle_newlogin_locked', 1, 'message');
+        set_config('message_provider_moodle_newlogin_enabled', 'popup,email', 'message');
+        $this->assertTrue(newloginnotifications::is_forced());
+        $this->assertEquals(result::OK, $check->get_result()->get_status());
+
+        // Enabled but not forced.
+        set_config('email_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('popup_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('airnotifier_provider_moodle_newlogin_locked', 0, 'message');
+        $this->assertFalse(newloginnotifications::is_forced());
+        $this->assertEquals(result::WARNING, $check->get_result()->get_status());
+
+        // Locked but not enabled (i.e. disallowed).
+        set_config('email_provider_moodle_newlogin_locked', 1, 'message');
+        set_config('message_provider_moodle_newlogin_enabled', 'popup', 'message');
+        $this->assertFalse(newloginnotifications::is_forced());
+        $this->assertEquals(result::WARNING, $check->get_result()->get_status());
+
+        // Forced, but the notification type is disabled entirely.
+        set_config('message_provider_moodle_newlogin_enabled', 'popup,email', 'message');
+        set_config('moodle_newlogin_disable', 1, 'message');
+        $this->assertFalse(newloginnotifications::is_forced());
+        $this->assertEquals(result::WARNING, $check->get_result()->get_status());
+
+        // Forced, but the email processor is disabled.
+        set_config('moodle_newlogin_disable', 0, 'message');
+        \core\plugininfo\message::enable_plugin('email', 0);
+        get_message_processors(false, true, true);
+        $this->assertFalse(newloginnotifications::is_forced());
+        $this->assertEquals(result::WARNING, $check->get_result()->get_status());
+    }
+
     /**
      * Tests that the component is correctly set.
      */
