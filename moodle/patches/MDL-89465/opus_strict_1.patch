+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\check\security;
+
+use core\check\result;
+
+/**
+ * Unit tests for the new login notifications security check.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \core\check\security\newloginnotifications
+ */
+final class newloginnotifications_test extends \advanced_testcase {
+
+    /**
+     * New installs force email new login notifications on, so the check passes.
+     */
+    public function test_default_is_forced(): void {
+        $this->resetAfterTest();
+
+        $this->assertEquals(1, get_config('message', 'email_provider_moodle_newlogin_locked'));
+        $this->assertContains('email',
+            explode(',', get_config('message', 'message_provider_moodle_newlogin_enabled')));
+
+        $check = new newloginnotifications();
+        $this->assertEquals(result::OK, $check->get_result()->get_status());
+    }
+
+    /**
+     * The check warns when the notification is not locked.
+     */
+    public function test_not_locked(): void {
+        $this->resetAfterTest();
+
+        set_config('email_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('popup_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('airnotifier_provider_moodle_newlogin_locked', 0, 'message');
+
+        $check = new newloginnotifications();
+        $this->assertEquals(result::WARNING, $check->get_result()->get_status());
+    }
+
+    /**
+     * The check warns when the notification is locked but not enabled.
+     */
+    public function test_locked_disabled(): void {
+        $this->resetAfterTest();
+
+        set_config('message_provider_moodle_newlogin_enabled', 'popup', 'message');
+        set_config('popup_provider_moodle_newlogin_locked', 0, 'message');
+
+        $check = new newloginnotifications();
+        $this->assertEquals(result::WARNING, $check->get_result()->get_status());
+    }
+
+    /**
+     * The check warns when the notification is disabled at site level.
+     */
+    public function test_disabled(): void {
+        $this->resetAfterTest();
+
+        set_config('moodle_newlogin_disable', 1, 'message');
+
+        $check = new newloginnotifications();
+        $this->assertEquals(result::WARNING, $check->get_result()->get_status());
+    }
+}
