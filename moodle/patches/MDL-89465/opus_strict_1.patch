+
+namespace core\check\security;
+
+use core\check\check;
+use core\check\result;
+
+/**
+ * Verifies that new login notifications are forced on for all users.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class newloginnotifications extends check {
+
+    #[\Override]
+    public function get_name(): string {
+        return get_string('check_newloginnotifications_name', 'report_security');
+    }
+
+    #[\Override]
+    public function get_action_link(): ?\action_link {
+        return new \action_link(
+            new \moodle_url('/admin/message.php'),
+            get_string('managemessageoutputs', 'message'),
+        );
+    }
+
+    /**
+     * Whether new login notifications are forced on for at least one enabled message processor.
+     *
+     * @return bool
+     */
+    public static function is_forced(): bool {
+        global $CFG;
+        require_once($CFG->dirroot . '/message/lib.php');
+
+        $preferences = get_message_output_default_preferences();
+
+        // Notification disabled at site level.
+        if (!empty($preferences->moodle_newlogin_disable)) {
+            return false;
+        }
+
+        $enabledprocessors = [];
+        if (!empty($preferences->message_provider_moodle_newlogin_enabled)) {
+            $enabledprocessors = explode(',', $preferences->message_provider_moodle_newlogin_enabled);
+        }
+
+        foreach (get_message_processors(true) as $processor) {
+            $lockedpref = $processor->name . '_provider_moodle_newlogin_locked';
+            if (!empty($preferences->{$lockedpref}) && in_array($processor->name, $enabledprocessors)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    #[\Override]
+    public function get_result(): result {
+        $details = get_string('check_newloginnotifications_details', 'report_security');
+        if (self::is_forced()) {
+            $status = result::OK;
+            $summary = get_string('check_newloginnotifications_ok', 'report_security');
+        } else {
+            $status = result::WARNING;
+            $summary = get_string('check_newloginnotifications_warning', 'report_security');
+        }
+        return new result($status, $summary, $details);
+    }
+}
