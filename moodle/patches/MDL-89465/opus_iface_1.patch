+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\check\security;
+
+use core\check\check;
+use core\check\result;
+
+/**
+ * Verifies that security related notifications (new login notifications) are forced on for users.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class securitymessages extends check {
+
+    /**
+     * Get the short check name
+     *
+     * @return string
+     */
+    public function get_name(): string {
+        return get_string('check_securitymessages_name', 'report_security');
+    }
+
+    /**
+     * A link to a place to action this
+     *
+     * @return \action_link|null
+     */
+    public function get_action_link(): ?\action_link {
+        return new \action_link(
+            new \moodle_url('/admin/message.php'),
+            get_string('managemessageoutputs', 'message'));
+    }
+
+    /**
+     * Return result
+     *
+     * @return result
+     */
+    public function get_result(): result {
+        global $CFG;
+        require_once($CFG->dirroot . '/message/lib.php');
+
+        $details = get_string('check_securitymessages_details', 'report_security');
+        $preferences = get_message_output_default_preferences();
+        $base = 'moodle_newlogin';
+
+        if (!empty($preferences->{$base . '_disable'})) {
+            return new result(result::WARNING, get_string('check_securitymessages_disabled', 'report_security'), $details);
+        }
+
+        $enabledpref = $preferences->{'message_provider_' . $base . '_enabled'} ?? '';
+        $enabled = array_filter(explode(',', $enabledpref));
+
+        $forced = false;
+        foreach (get_message_processors(true) as $processor) {
+            $locked = !empty($preferences->{$processor->name . '_provider_' . $base . '_locked'});
+            if ($locked && in_array($processor->name, $enabled)) {
+                $forced = true;
+                break;
+            }
+        }
+
+        if ($forced) {
+            return new result(result::OK, get_string('check_securitymessages_ok', 'report_security'), $details);
+        }
+        return new result(result::WARNING, get_string('check_securitymessages_warning', 'report_security'), $details);
+    }
+}
