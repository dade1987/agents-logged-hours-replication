+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\check\security;
+
+use core\check\result;
+
+/**
+ * Unit tests for the securitymessages check.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \core\check\security\securitymessages
+ */
+final class securitymessages_test extends \advanced_testcase {
+
+    /**
+     * Default install forces new login notifications on.
+     */
+    public function test_default(): void {
+        $this->resetAfterTest();
+        $check = new securitymessages();
+        $this->assertEquals(result::OK, $check->get_result()->get_status());
+    }
+
+    /**
+     * Not locked for any processor results in a warning.
+     */
+    public function test_not_forced(): void {
+        $this->resetAfterTest();
+        foreach (get_message_processors() as $processor) {
+            set_config($processor->name . '_provider_moodle_newlogin_locked', 0, 'message');
+        }
+        $check = new securitymessages();
+        $this->assertEquals(result::WARNING, $check->get_result()->get_status());
+    }
+
+    /**
+     * Locked but not enabled results in a warning.
+     */
+    public function test_locked_not_enabled(): void {
+        $this->resetAfterTest();
+        set_config('message_provider_moodle_newlogin_enabled', '', 'message');
+        $check = new securitymessages();
+        $this->assertEquals(result::WARNING, $check->get_result()->get_status());
+    }
+
+    /**
+     * Disabled provider results in a warning.
+     */
+    public function test_disabled(): void {
+        $this->resetAfterTest();
+        set_config('moodle_newlogin_disable', 1, 'message');
+        $check = new securitymessages();
+        $this->assertEquals(result::WARNING, $check->get_result()->get_status());
+    }
+}
