+
+namespace core\check\security;
+
+use core\check\check;
+use core\check\result;
+
+/**
+ * Verifies that security related messages (new login notifications) are enabled and forced on.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2026 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class securitymessages extends check {
+
+    /**
+     * Get the short check name
+     *
+     * @return string
+     */
+    public function get_name(): string {
+        return get_string('check_securitymessages_name', 'report_security');
+    }
+
+    /**
+     * A link to a place to action this
+     *
+     * @return \action_link|null
+     */
+    public function get_action_link(): ?\action_link {
+        return new \action_link(
+            new \moodle_url('/admin/message.php'),
+            get_string('messageoutputs', 'message'),
+        );
+    }
+
+    /**
+     * Return result
+     *
+     * @return result
+     */
+    public function get_result(): result {
+        $details = get_string('check_securitymessages_details', 'report_security');
+
+        if (self::newlogin_forced()) {
+            return new result(result::OK, get_string('check_securitymessages_ok', 'report_security'), $details);
+        }
+        return new result(result::WARNING, get_string('check_securitymessages_warning', 'report_security'), $details);
+    }
+
+    /**
+     * Whether new login notifications are enabled and forced on for at least one enabled processor.
+     *
+     * @return bool
+     */
+    protected static function newlogin_forced(): bool {
+        $config = get_config('message');
+        if (!empty($config->moodle_newlogin_disable)) {
+            return false;
+        }
+        $enabled = [];
+        if (!empty($config->message_provider_moodle_newlogin_enabled)) {
+            $enabled = explode(',', $config->message_provider_moodle_newlogin_enabled);
+        }
+        if (empty($enabled)) {
+            return false;
+        }
+        foreach (get_message_processors(true) as $processor) {
+            $name = $processor->name;
+            $locked = $name . '_provider_moodle_newlogin_locked';
+            if (in_array($name, $enabled) && !empty($config->{$locked})) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
