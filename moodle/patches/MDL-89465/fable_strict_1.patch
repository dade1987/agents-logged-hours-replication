+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\check\security;
+
+use core\check\result;
+
+/**
+ * Unit tests for the new login notifications security check.
+ *
+ * @package    core
+ * @category   test
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \core\check\security\newloginnotifications
+ */
+final class newloginnotifications_test extends \advanced_testcase {
+    /**
+     * New login notifications are forced on by default on a fresh install.
+     */
+    public function test_default_is_forced_on(): void {
+        $this->resetAfterTest();
+
+        $check = new newloginnotifications();
+        $result = $check->get_result();
+        $this->assertEquals(result::OK, $result->get_status());
+        $this->assertNotNull($check->get_action_link());
+    }
+
+    /**
+     * Test the check when the notification is disabled at the system level.
+     */
+    public function test_disabled(): void {
+        $this->resetAfterTest();
+
+        set_config('moodle_newlogin_disable', 1, 'message');
+
+        $check = new newloginnotifications();
+        $result = $check->get_result();
+        $this->assertEquals(result::WARNING, $result->get_status());
+        $this->assertEquals(
+            get_string('check_newloginnotifications_disabled', 'report_security'),
+            $result->get_summary()
+        );
+    }
+
+    /**
+     * Test the check when the notification is enabled but no output is locked (forced on).
+     */
+    public function test_not_forced(): void {
+        $this->resetAfterTest();
+
+        set_config('popup_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('email_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('airnotifier_provider_moodle_newlogin_locked', 0, 'message');
+
+        $check = new newloginnotifications();
+        $result = $check->get_result();
+        $this->assertEquals(result::WARNING, $result->get_status());
+        $this->assertEquals(
+            get_string('check_newloginnotifications_notforced', 'report_security'),
+            $result->get_summary()
+        );
+
+        // Forcing it on again for a single output is enough.
+        set_config('email_provider_moodle_newlogin_locked', 1, 'message');
+        $result = $check->get_result();
+        $this->assertEquals(result::OK, $result->get_status());
+    }
+
+    /**
+     * Test the check when the outputs are locked but not enabled by default.
+     */
+    public function test_locked_but_not_enabled(): void {
+        $this->resetAfterTest();
+
+        set_config('message_provider_moodle_newlogin_enabled', '', 'message');
+
+        $check = new newloginnotifications();
+        $result = $check->get_result();
+        $this->assertEquals(result::WARNING, $result->get_status());
+        $this->assertEquals(
+            get_string('check_newloginnotifications_notforced', 'report_security'),
+            $result->get_summary()
+        );
+    }
+
+    /**
+     * Test the check when the only forced output is a disabled notification processor.
+     */
+    public function test_forced_output_processor_disabled(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        set_config('popup_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('airnotifier_provider_moodle_newlogin_locked', 0, 'message');
+        set_config('email_provider_moodle_newlogin_locked', 1, 'message');
+        set_config('message_provider_moodle_newlogin_enabled', 'email', 'message');
+
+        $DB->set_field('message_processors', 'enabled', 0, ['name' => 'email']);
+        get_message_processors(false, true);
+
+        $check = new newloginnotifications();
+        $result = $check->get_result();
+        $this->assertEquals(result::WARNING, $result->get_status());
+        $this->assertEquals(
+            get_string('check_newloginnotifications_noprocessors', 'report_security'),
+            $result->get_summary()
+        );
+    }
+}
