+                    $msgproviderforced = true;
+                    break;
+                }
+            }
+        }
+        // Get message providers enabled for a user. A user preference cannot override a forced provider.
+        $userpreferences = $msgproviderforced ? null : get_user_preferences('message_provider_moodle_newlogin_enabled');
         // Check if notification processor plugins (web, email, mobile) are enabled at system level.
