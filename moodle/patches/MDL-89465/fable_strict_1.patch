+
+namespace core\check\security;
+
+use core\check\check;
+use core\check\result;
+
+/**
+ * Verifies that new login notifications are enabled and forced on for all users.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class newloginnotifications extends check {
+    /** @var string The component of the new login notification provider. */
+    private const COMPONENT = 'moodle';
+
+    /** @var string The name of the new login notification provider. */
+    private const PROVIDER = 'newlogin';
+
+    /**
+     * Get the short check name
+     *
+     * @return string
+     */
+    public function get_name(): string {
+        return get_string('check_newloginnotifications_name', 'report_security');
+    }
+
+    /**
+     * A link to a place to action this
+     *
+     * @return \action_link|null
+     */
+    public function get_action_link(): ?\action_link {
+        return new \action_link(
+            new \moodle_url('/admin/message.php'),
+            get_string('defaultmessageoutputs', 'message')
+        );
+    }
+
+    /**
+     * Return result
+     *
+     * @return result
+     */
+    public function get_result(): result {
+        global $CFG;
+        require_once($CFG->dirroot . '/lib/messagelib.php');
+
+        $details = get_string('check_newloginnotifications_details', 'report_security');
+        $preferencebase = self::COMPONENT . '_' . self::PROVIDER;
+        $defaultpreferences = get_message_output_default_preferences();
+
+        // Check whether the notification is disabled at the system level.
+        if (!empty($defaultpreferences->{$preferencebase . '_disable'})) {
+            return new result(
+                result::WARNING,
+                get_string('check_newloginnotifications_disabled', 'report_security'),
+                $details
+            );
+        }
+
+        // Find which outputs are enabled by default, and which of those are locked (i.e. forced on).
+        $enabledpreference = $preferencebase . '_enabled';
+        $enabledoutputs = [];
+        if (!empty($defaultpreferences->{'message_provider_' . $enabledpreference})) {
+            $enabledoutputs = explode(',', $defaultpreferences->{'message_provider_' . $enabledpreference});
+        }
+
+        $forcedoutputs = [];
+        foreach ($enabledoutputs as $output) {
+            $output = trim($output);
+            if ($output === '') {
+                continue;
+            }
+            $lockedpreference = $output . '_provider_' . $preferencebase . '_locked';
+            if (!empty($defaultpreferences->{$lockedpreference})) {
+                $forcedoutputs[] = $output;
+            }
+        }
+
+        if (empty($forcedoutputs)) {
+            return new result(
+                result::WARNING,
+                get_string('check_newloginnotifications_notforced', 'report_security'),
+                $details
+            );
+        }
+
+        // At least one output is forced on, make sure that it is actually an enabled processor.
+        $processors = array_keys(get_message_processors(true));
+        if (empty(array_intersect($forcedoutputs, $processors))) {
+            return new result(
+                result::WARNING,
+                get_string('check_newloginnotifications_noprocessors', 'report_security'),
+                $details
+            );
+        }
+
+        return new result(
+            result::OK,
+            get_string('check_newloginnotifications_ok', 'report_security'),
+            $details
+        );
+    }
+}
