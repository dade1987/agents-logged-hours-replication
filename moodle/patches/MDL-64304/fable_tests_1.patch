+    /**
+     * Test that get_grade_items returns a descriptive itemname for category and course total items.
+     */
+    public function test_get_grade_items_category_itemname(): void {
+        global $DB;
+
+        $this->resetAfterTest(true);
+
+        $course = $this->getDataGenerator()->create_course();
+        $studentrole = $DB->get_record('role', ['shortname' => 'student']);
+        $student = $this->getDataGenerator()->create_user();
+        $this->getDataGenerator()->enrol_user($student->id, $course->id, $studentrole->id);
+
+        // Create a grade category containing an assignment.
+        $category = $this->getDataGenerator()->create_grade_category(['courseid' => $course->id, 'fullname' => 'My category']);
+        $assignment = $this->getDataGenerator()->create_module('assign', ['name' => 'Test assign', 'course' => $course->id]);
+        $assignment->cmidnumber = get_coursemodule_from_instance('assign', $assignment->id, $course->id)->id;
+        $gradeitem = \grade_item::fetch(['courseid' => $course->id, 'itemtype' => 'mod', 'itemmodule' => 'assign',
+            'iteminstance' => $assignment->id]);
+        $gradeitem->set_parent($category->id);
+        assign_grade_item_update($assignment, [$student->id => ['userid' => $student->id, 'rawgrade' => 70]]);
+
+        $this->setUser($student);
+        $studentgrades = user_external::get_grade_items($course->id, $student->id);
+        $studentgrades = external_api::clean_returnvalue(user_external::get_grade_items_returns(), $studentgrades);
+        $this->assertCount(0, $studentgrades['warnings']);
+        $this->assertCount(1, $studentgrades['usergrades']);
+
+        $itemnames = [];
+        foreach ($studentgrades['usergrades'][0]['gradeitems'] as $item) {
+            $itemnames[$item['itemtype']] = $item['itemname'];
+        }
+
+        $this->assertEquals('Test assign', $itemnames['mod']);
+        $a = new \stdClass();
+        $a->category = 'My category';
+        $this->assertEquals(get_string('categorytotalfull', 'grades', $a), $itemnames['category']);
+        $this->assertEquals(get_string('coursetotal', 'grades'), $itemnames['course']);
+    }
 
