         $this->assertEquals('course', $studentgrades['usergrades'][0]['gradeitems'][0]['itemtype']);
     }
 
+    /**
+     * Test get_grade_items returns the category name as the item name for category grade items.
+     */
+    public function test_get_grade_items_category_itemname(): void {
+        $this->resetAfterTest(true);
+
+        $course = $this->getDataGenerator()->create_course();
+        $student = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $category = $this->getDataGenerator()->create_grade_category([
+            'courseid' => $course->id,
+            'fullname' => 'My grade category',
+        ]);
+        $this->getDataGenerator()->create_grade_item([
+            'courseid' => $course->id,
+            'categoryid' => $category->id,
+            'itemname' => 'Manual item',
+        ]);
+
+        $this->setUser($student);
+        $result = user_external::get_grade_items($course->id, $student->id);
+        $result = external_api::clean_returnvalue(user_external::get_grade_items_returns(), $result);
+
+        $names = [];
+        foreach ($result['usergrades'][0]['gradeitems'] as $gradeitem) {
+            $names[$gradeitem['itemtype']][] = $gradeitem['itemname'];
+        }
+        $this->assertEquals(['Manual item'], $names['manual']);
+        $this->assertEquals(['My grade category'], $names['category']);
+    }
 }
