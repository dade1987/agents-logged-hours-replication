+    /**
+     * Returns the full path to the file where the logger is writing.
+     *
+     * @return string
+     */
+    public function get_fullpath() {
+        return $this->fullpath;
+    }
+
+    /**
+     * Converts the given path into a path relative to $CFG->backuptempdir, when the file
+     * is located there. Otherwise (extra loggers pointing to arbitrary locations) the
+     * path is returned unmodified.
+     *
+     * @param string $path Full path to the log file.
+     * @return string The relative path (to $CFG->backuptempdir) or the original path.
+     */
+    public static function get_relative_path($path) {
+        global $CFG;
+
+        if (empty($path) || empty($CFG->backuptempdir)) {
+            return $path;
+        }
+
+        $normalisedpath = str_replace('\\', '/', $path);
+        $backuptempdir = rtrim(str_replace('\\', '/', $CFG->backuptempdir), '/') . '/';
+
+        if ($backuptempdir !== '/' && strpos($normalisedpath, $backuptempdir) === 0) {
+            return substr($normalisedpath, strlen($backuptempdir));
+        }
+        return $path;
+    }
+
+    /**
+     * Checks if the given path is absolute (both unix and windows paths are supported).
+     *
+     * @param string $path The path to check.
+     * @return bool
+     */
+    public static function is_absolute_path($path) {
+        if ($path === '' || $path === null) {
+            return false;
+        }
+        if ($path[0] === '/' || $path[0] === '\\') {
+            return true;
+        }
+        // Windows drive letter (c:/ or c:\).
+        if (preg_match('/^[a-zA-Z]:[\/\\\\]/', $path)) {
+            return true;
+        }
+        return false;
+    }
+
     /**
      * Close the logger resources (file handle) if still open.
