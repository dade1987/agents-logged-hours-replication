diff --git a/public/backup/util/loggers/tests/logger_test.php b/public/backup/util/loggers/tests/logger_test.php
index 6cb5b54a4bc..a54ae8843ec 100644
--- a/public/backup/util/loggers/tests/logger_test.php
+++ b/public/backup/util/loggers/tests/logger_test.php
@@ -360,6 +360,81 @@ final class logger_test extends \basic_testcase {
         // Remove the test dir and any content
         @remove_dir(dirname($file));
     }
+
+    /**
+     * Test that file_logger serializes paths relative to $CFG->backuptempdir and
+     * rebuilds them using the current backup temp dir on wakeup.
+     *
+     * @covers \file_logger::__sleep
+     * @covers \file_logger::__wakeup
+     */
+    public function test_file_logger_serialization(): void {
+        global $CFG;
+
+        $this->resetAfterTest();
+
+        $backuptempdir = make_backup_temp_directory('');
+        $file = $backuptempdir . '/test_file_logger_serialization.log';
+        @unlink($file);
+
+        // Logger living in $CFG->backuptempdir is serialized with a relative path (just the file name).
+        $lo = new file_logger(backup::LOG_ERROR, true, true, $file);
+        $this->assertSame($file, $lo->get_fullpath());
+        $serialized = serialize($lo);
+        $this->assertStringNotContainsString($backuptempdir, $serialized);
+        $this->assertStringContainsString('test_file_logger_serialization.log', $serialized);
+
+        // Unserializing rebuilds the full path using the current backup temp dir.
+        $lo2 = unserialize($serialized);
+        $this->assertInstanceOf(file_logger::class, $lo2);
+        $this->assertSame($file, $lo2->get_fullpath());
+        $this->assertTrue($lo2->process('testing serialized file_logger', backup::LOG_ERROR));
+        $lo2->close();
+        $this->assertStringContainsString('testing serialized file_logger', file_get_contents($file));
+        @unlink($file);
+
+        // If the backup temp dir changes, the path is rebuilt pointing to the new one.
+        $newbackuptempdir = $CFG->tempdir . '/newbackuptempdir';
+        $CFG->backuptempdir = $newbackuptempdir;
+        $lo3 = unserialize($serialized);
+        $this->assertSame($newbackuptempdir . '/test_file_logger_serialization.log', $lo3->get_fullpath());
+        $this->assertTrue($lo3->process('testing moved file_logger', backup::LOG_ERROR));
+        $lo3->close();
+        $this->assertFileExists($newbackuptempdir . '/test_file_logger_serialization.log');
+
+        // Legacy serialized loggers (absolute path to a no longer existing dir) are still handled.
+        $legacy = str_replace(
+            's:' . strlen('test_file_logger_serialization.log') . ':"test_file_logger_serialization.log"',
+            's:' . strlen('/non/existing/dir/legacy.log') . ':"/non/existing/dir/legacy.log"',
+            $serialized
+        );
+        $lo4 = unserialize($legacy);
+        $this->assertSame($newbackuptempdir . '/legacy.log', $lo4->get_fullpath());
+        $lo4->close();
+
+        // Relative paths are never allowed to escape from the backup temp dir.
+        $escaping = str_replace(
+            's:' . strlen('test_file_logger_serialization.log') . ':"test_file_logger_serialization.log"',
+            's:' . strlen('../../escaping.log') . ':"../../escaping.log"',
+            $serialized
+        );
+        $lo5 = unserialize($escaping);
+        $this->assertSame($newbackuptempdir . '/escaping.log', $lo5->get_fullpath());
+        $lo5->close();
+        @remove_dir($newbackuptempdir);
+
+        // Loggers outside $CFG->backuptempdir (extra file loggers) keep their absolute path.
+        $CFG->backuptempdir = $backuptempdir;
+        check_dir_exists($CFG->tempdir . '/test');
+        $file = $CFG->tempdir . '/test/test_file_logger_extra.log';
+        $lo6 = new file_logger(backup::LOG_ERROR, true, true, $file);
+        $serialized = serialize($lo6);
+        $this->assertStringContainsString($file, $serialized);
+        $lo7 = unserialize($serialized);
+        $this->assertSame($file, $lo7->get_fullpath());
+        $lo7->close();
+        @remove_dir($CFG->tempdir . '/test');
+    }
 }
 
 
