diff --git a/public/backup/util/loggers/tests/logger_test.php b/public/backup/util/loggers/tests/logger_test.php
index 6cb5b54a4bc..6d2f13c8007 100644
--- a/public/backup/util/loggers/tests/logger_test.php
+++ b/public/backup/util/loggers/tests/logger_test.php
@@ -360,6 +360,97 @@ final class logger_test extends \basic_testcase {
         // Remove the test dir and any content
         @remove_dir(dirname($file));
     }
+
+    /**
+     * Test file_logger serialization stores relative paths for files within $CFG->backuptempdir
+     * and rebuilds the full path on wakeup using the current backup temp dir.
+     *
+     * @covers \file_logger::__sleep
+     * @covers \file_logger::__wakeup
+     */
+    public function test_file_logger_serialization(): void {
+        global $CFG;
+
+        make_backup_temp_directory(''); // Ensure $CFG->backuptempdir exists.
+        $backuptempdir = $CFG->backuptempdir;
+        $filename = 'test_file_logger_serialization.log';
+        $file = $backuptempdir . '/' . $filename;
+
+        // A logger pointing to a file within the backup temp dir.
+        $lo = new file_logger(backup::LOG_ERROR, true, true, $file);
+        $this->assertSame($file, $lo->get_fullpath());
+        $this->assertSame($filename, $lo->get_relativepath());
+        $this->assertTrue($lo->process('before serialization', backup::LOG_ERROR));
+
+        $serialized = serialize($lo);
+        $lo->close();
+
+        // The absolute (host specific) path must not be part of the serialized data, only the file name.
+        $this->assertStringNotContainsString($backuptempdir, $serialized);
+        $this->assertStringContainsString($filename, $serialized);
+
+        // Unserializing with the same backup temp dir rebuilds the same full path and keeps working.
+        $lo2 = unserialize($serialized);
+        $this->assertInstanceOf(file_logger::class, $lo2);
+        $this->assertSame($file, $lo2->get_fullpath());
+        $this->assertTrue($lo2->process('after serialization', backup::LOG_ERROR));
+        $lo2->close();
+        $contents = file_get_contents($file);
+        $this->assertStringContainsString('before serialization', $contents);
+        $this->assertStringContainsString('after serialization', $contents);
+        unlink($file);
+
+        // Unserializing after $CFG->backuptempdir has changed uses the new directory.
+        $newbackuptempdir = $CFG->tempdir . '/test_backuptempdir';
+        $CFG->backuptempdir = $newbackuptempdir;
+        $lo3 = unserialize($serialized);
+        $this->assertSame($newbackuptempdir . '/' . $filename, $lo3->get_fullpath());
+        $this->assertSame($filename, $lo3->get_relativepath());
+        $this->assertTrue($lo3->process('new backuptempdir', backup::LOG_ERROR));
+        $lo3->close();
+        $this->assertStringContainsString('new backuptempdir', file_get_contents($newbackuptempdir . '/' . $filename));
+        $this->assertFalse(file_exists($file));
+
+        // Serializing again from the new location is still relative.
+        $this->assertStringNotContainsString($newbackuptempdir, serialize($lo3));
+        @remove_dir($newbackuptempdir);
+        $CFG->backuptempdir = $backuptempdir;
+
+        // Legacy serialized data holding an absolute path whose directory no longer exists
+        // is also rebuilt using the current backup temp dir.
+        $legacy = function(string $fullpath): string {
+            $prop = function(string $name): string {
+                $name = "\0*\0" . $name; // Protected property.
+                return 's:' . strlen($name) . ':"' . $name . '";';
+            };
+            return 'O:11:"file_logger":5:{' .
+                $prop('level') . 'i:' . backup::LOG_NONE . ';' .
+                $prop('showdate') . 'b:1;' .
+                $prop('showlevel') . 'b:1;' .
+                $prop('next') . 'N;' .
+                $prop('fullpath') . 's:' . strlen($fullpath) . ':"' . $fullpath . '";}';
+        };
+        $lo4 = unserialize($legacy('/non/existing/dir/' . $filename));
+        $this->assertInstanceOf(file_logger::class, $lo4);
+        $this->assertSame($file, $lo4->get_fullpath());
+
+        // Legacy serialized data already holding a relative path (file name) is rebuilt too.
+        $lo5 = unserialize($legacy($filename));
+        $this->assertInstanceOf(file_logger::class, $lo5);
+        $this->assertSame($file, $lo5->get_fullpath());
+
+        // A logger pointing to a file outside the backup temp dir (e.g. $CFG->backup_file_logger_extra)
+        // keeps storing the full path.
+        check_dir_exists($CFG->tempdir . '/test');
+        $extrafile = $CFG->tempdir . '/test/test_file_logger_extra.log';
+        $lo6 = new file_logger(backup::LOG_NONE, true, true, $extrafile);
+        $this->assertNull($lo6->get_relativepath());
+        $serialized = serialize($lo6);
+        $this->assertStringContainsString($extrafile, $serialized);
+        $lo7 = unserialize($serialized);
+        $this->assertSame($extrafile, $lo7->get_fullpath());
+        @remove_dir($CFG->tempdir . '/test');
+    }
 }
 
 
