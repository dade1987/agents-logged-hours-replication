+
+    /**
+     * Builds the full path of a file name under the current $CFG->backuptempdir.
+     *
+     * @param string $filename the file name (relative path).
+     * @return string
+     */
+    protected static function build_full_path($filename) {
+        $backuptempdir = make_backup_temp_directory(''); // Ensures $CFG->backuptempdir exists.
+        return rtrim($backuptempdir, '/\\') . '/' . basename($filename);
+    }
+
+    /**
+     * Whether the given path points to a file directly within $CFG->backuptempdir.
+     *
+     * @param string|null $path
+     * @return bool
+     */
+    protected static function is_within_backup_temp_dir($path) {
+        global $CFG;
+
+        if (empty($path) || empty($CFG->backuptempdir)) {
+            return false;
+        }
+        $normalise = function($dir) {
+            $dir = str_replace('\\', '/', $dir);
+            $real = realpath($dir);
+            if ($real !== false) {
+                $dir = str_replace('\\', '/', $real);
+            }
+            return rtrim($dir, '/');
+        };
+        return $normalise(dirname($path)) === $normalise($CFG->backuptempdir);
+    }
+
+    /**
+     * Whether the given path is an absolute one (unix or windows).
+     *
+     * @param string $path
+     * @return bool
+     */
+    protected static function is_absolute_path($path) {
+        return (bool)preg_match('#^([a-zA-Z]:)?[\\/]#', $path);
+    }
