+        $oldlevel = $CFG->backup_file_logger_level ?? null;
+        $oldextra = $CFG->backup_file_logger_extra ?? null;
+        $CFG->backup_file_logger_level = backup::LOG_ERROR;
+        unset($CFG->backup_file_logger_extra);
+        $chain = \backup_factory::get_logger_chain(backup::INTERACTIVE_NO, backup::EXECUTION_INMEDIATE, 'abc123');
+        $serialised = serialize($chain);
+        $this->assertStringNotContainsString($CFG->backuptempdir, $serialised);
+        $this->assertStringContainsString('abc123.log', $serialised);
+        $chain->destroy();
+        @unlink($CFG->backuptempdir . '/abc123.log');
+
+        // Restore config.
+        if ($oldlevel === null) {
+            unset($CFG->backup_file_logger_level);
+        } else {
+            $CFG->backup_file_logger_level = $oldlevel;
+        }
+        if ($oldextra !== null) {
+            $CFG->backup_file_logger_extra = $oldextra;
+        }
+    }
