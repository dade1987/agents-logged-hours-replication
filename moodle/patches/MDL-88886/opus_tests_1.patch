+    /**
+     * Test file_logger with relative paths, serialised and restored with a different backuptempdir.
+     */
+    public function test_file_logger_relative_path(): void {
+        global $CFG;
+        $oldbackuptempdir = $CFG->backuptempdir;
+
+        $filename = 'test_file_logger_relative.log';
+        $lo = new file_logger(backup::LOG_ERROR, true, true, $filename);
+        $expected = $CFG->backuptempdir . '/' . $filename;
+        $this->assertEquals($expected, $lo->get_fullpath());
+        $lo->process('message one', backup::LOG_ERROR);
+        $this->assertTrue(file_exists($expected));
+
+        // The serialised logger must not contain any absolute (host specific) path.
+        $serialised = serialize($lo);
+        $lo->close();
+        $this->assertStringNotContainsString($CFG->backuptempdir, $serialised);
+        $this->assertStringContainsString($filename, $serialised);
+
+        // Change the backuptempdir and unserialise: the path must be rebuilt against the new dir.
+        $CFG->backuptempdir = $CFG->tempdir . '/newbackuptempdir';
+        $restored = unserialize($serialised);
+        $newexpected = $CFG->backuptempdir . '/' . $filename;
+        $this->assertEquals($newexpected, $restored->get_fullpath());
+        $restored->process('message two', backup::LOG_ERROR);
+        $restored->close();
+        $this->assertStringContainsString('message two', file_get_contents($newexpected));
+        $this->assertStringNotContainsString('message two', file_get_contents($expected));
+
+        // Cleanup.
+        @unlink($expected);
+        remove_dir($CFG->backuptempdir);
+        $CFG->backuptempdir = $oldbackuptempdir;
+    }
+
+    /**
+     * Test legacy file_logger serialised with an absolute path whose dir no longer exists.
+     */
+    public function test_file_logger_legacy_absolute_path(): void {
+        global $CFG;
+        $olddir = $CFG->tempdir . '/oldbackuptempdir';
+        make_writable_directory($olddir);
+        $lo = new file_logger(backup::LOG_ERROR, true, true, $olddir . '/legacy.log');
+        $this->assertEquals($olddir . '/legacy.log', $lo->get_fullpath());
+        $serialised = serialize($lo);
+        $lo->close();
+        remove_dir($olddir);
+
+        $restored = unserialize($serialised);
+        $this->assertEquals($CFG->backuptempdir . '/legacy.log', $restored->get_fullpath());
+        $restored->close();
+        @unlink($restored->get_fullpath());
+    }
+
+    /**
+     * Test that the logger chain created by the factory uses a relative path.
+     */
+    public function test_factory_file_logger_relative_path(): void {
