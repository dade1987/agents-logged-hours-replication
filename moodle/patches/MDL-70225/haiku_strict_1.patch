+    /**
+     * Test that queries match the start of words, with all terms required.
+     *
+     * @return void
+     */
+    public function test_search_word_start(): void {
+        $this->add_mock_search_area();
+
+        $record = new \stdClass();
+        $record->title = 'Cats 101';
+        $this->generator->create_record($record);
+
+        $record = new \stdClass();
+        $record->title = 'Dogs 101';
+        $this->generator->create_record($record);
+
+        $this->search->index();
+        $this->update_index();
+
+        $querydata = new \stdClass();
+
+        // Partial words at the start of a word match.
+        $querydata->q = '101';
+        $this->assertCount(2, $this->search->search($querydata));
+
+        $querydata->q = 'Dog';
+        $results = $this->search->search($querydata);
+        $this->assertCount(1, $results);
+        $this->assertEquals('Dogs 101', reset($results)->get('title'));
+
+        $querydata->q = 'cat 10';
+        $results = $this->search->search($querydata);
+        $this->assertCount(1, $results);
+        $this->assertEquals('Cats 101', reset($results)->get('title'));
+
+        // All the terms must match.
+        $querydata->q = 'Cats Dogs';
+        $this->assertCount(0, $this->search->search($querydata));
+
+        // Not the start of a word.
+        $querydata->q = 'ogs';
+        $this->assertCount(0, $this->search->search($querydata));
+    }
