+    /**
+     * Splits a search query into individual search terms.
+     *
+     * Quotes, punctuation and any other character which is neither a letter nor a number are
+     * used as separators and discarded, so each returned term is safe to be used within the
+     * database specific full-text query syntax.
+     *
+     * @param string $q The query string
+     * @return string[] List of terms (may be empty)
+     */
+    protected function get_query_terms(string $q): array {
+        $terms = preg_split('/[^\p{L}\p{N}]+/u', $q, -1, PREG_SPLIT_NO_EMPTY);
+        if ($terms === false) {
+            // Invalid UTF-8 or similar, fall back to a plain ASCII split.
+            $terms = preg_split('/[^a-zA-Z0-9]+/', $q, -1, PREG_SPLIT_NO_EMPTY);
+        }
+        return array_values(array_unique($terms));
+    }
