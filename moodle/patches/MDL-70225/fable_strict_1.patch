+    /**
+     * Test that search terms match the start of words and are combined with AND.
+     *
+     * @covers ::execute_query
+     * @return void
+     */
+    public function test_search_partial_words(): void {
+        $this->add_mock_search_area();
+
+        $record = new \stdClass();
+        $record->title = 'Cats 101';
+        $record->content = 'Course CU99999';
+        $this->generator->create_record($record);
+
+        $record = new \stdClass();
+        $record->title = 'Dogs 101';
+        $record->content = 'Course CU99999V20';
+        $this->generator->create_record($record);
+
+        $this->search->index();
+        $this->update_index();
+
+        $querydata = new \stdClass();
+
+        // Exact word matches both.
+        $querydata->q = '101';
+        $this->assertEquals(['Cats 101', 'Dogs 101'], $this->get_result_titles($querydata));
+
+        // Prefix of a word matches both (CU99999 and CU99999V20).
+        $querydata->q = 'CU99999';
+        $this->assertEquals(['Cats 101', 'Dogs 101'], $this->get_result_titles($querydata));
+
+        // Terms are combined with AND, so this matches nothing.
+        $querydata->q = 'Cats Dogs';
+        $this->assertEquals([], $this->get_result_titles($querydata));
+
+        // Every term matches the start of a word.
+        $querydata->q = 'Cat 10';
+        $this->assertEquals(['Cats 101'], $this->get_result_titles($querydata));
+
+        // Case insensitive prefix match.
+        $querydata->q = 'dog';
+        $this->assertEquals(['Dogs 101'], $this->get_result_titles($querydata));
+
+        // Quotes and punctuation are ignored.
+        $querydata->q = '"Dogs", 101!';
+        $this->assertEquals(['Dogs 101'], $this->get_result_titles($querydata));
+
+        // A query with nothing searchable in it returns nothing.
+        $querydata->q = '*';
+        $this->assertEquals([], $this->get_result_titles($querydata));
+        $querydata->q = '"';
+        $this->assertEquals([], $this->get_result_titles($querydata));
+    }
+
+    /**
+     * Returns the sorted titles of the search results for the given query.
+     *
+     * @param \stdClass $querydata
+     * @return string[]
+     */
+    private function get_result_titles(\stdClass $querydata): array {
+        $titles = array_map(function($result) {
+            return $result->get('title');
+        }, $this->search->search($querydata));
+        sort($titles);
+        return array_values($titles);
+    }
