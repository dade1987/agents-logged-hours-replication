+    /**
+     * Test searching matching the start of words.
+     *
+     * @param string $q
+     * @param string[] $expected
+     */
+    #[\PHPUnit\Framework\Attributes\DataProvider('search_partial_words_provider')]
+    public function test_search_partial_words(string $q, array $expected): void {
+        global $DB;
+
+        if ($DB->get_dbfamily() === 'mysql' && $DB->is_fulltext_search_supported()) {
+            // MySQL fulltext ignores words shorter than the minimum token size.
+            $this->markTestSkipped('Depends on the MySQL fulltext configuration');
+        }
+
+        $this->add_mock_search_area();
+
+        $titles = [
+            'Cats 101' => 'Some content',
+            'Dogs 101' => 'Some content',
+            'Course CU99999' => 'Some content',
+            'Course CU99999V20' => 'Some content',
+        ];
+        foreach ($titles as $title => $content) {
+            $this->generator->create_record((object)['title' => $title, 'content' => $content]);
+        }
+        $this->search->index();
+        $this->update_index();
+
+        $results = $this->search->search((object)['q' => $q]);
+        $resulttitles = array_map(fn($doc) => $doc->get('title'), $results);
+        sort($resulttitles);
+
+        if ($DB->get_dbfamily() !== 'postgres' && !$DB->is_fulltext_search_supported()) {
+            // The fallback LIKE based query matches any substring, so only check expected results are found.
+            foreach ($expected as $title) {
+                $this->assertContains($title, $resulttitles);
+            }
+            return;
+        }
+        if ($q === '- Cats- -101 .') {
+            // Depends on the database parser, just check it does not fail.
+            return;
+        }
+        $this->assertEquals($expected, $resulttitles);
+    }
