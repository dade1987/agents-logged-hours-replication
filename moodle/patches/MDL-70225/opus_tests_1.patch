+     */
+    public static function search_partial_words_provider(): array {
+        return [
+            'Exact word' => ['101', ['Cats 101', 'Dogs 101']],
+            'Words in different documents' => ['Cats Dogs', []],
+            'Start of several words' => ['Cat 10', ['Cats 101']],
+            'Start of word' => ['Dog', ['Dogs 101']],
+            'Case insensitive' => ['dOG', ['Dogs 101']],
+            'Middle of word' => ['ogs', []],
+            'Course code' => ['CU99999', ['Course CU99999', 'Course CU99999V20']],
+            'Longer course code' => ['CU99999V', ['Course CU99999V20']],
+            'Special characters' => ['Cats & | ! ( ) : * < > \' " \\ 101', ['Cats 101']],
+            'Only special characters' => ['&|!():*', []],
+            'Hyphens and dots' => ['- Cats- -101 .', []],
+        ];
+    }
