+    /**
+     * Splits the query string into words, removing the given special characters.
+     *
+     * Words that contain no letters or digits are discarded.
+     *
+     * @param string $q The query string
+     * @param string $specialchars Characters to be replaced by spaces before splitting
+     * @return string[] List of words
+     */
+    protected function get_query_words(string $q, string $specialchars = ''): array {
+        if ($specialchars !== '') {
+            $q = str_replace(mb_str_split($specialchars), ' ', $q);
+        }
+        $words = preg_split('/\s+/u', $q, -1, PREG_SPLIT_NO_EMPTY);
+        if ($words === false) {
+            return [];
+        }
+        return array_values(array_filter($words, function($word) {
+            return preg_match('/[\p{L}\p{N}]/u', $word);
+        }));
+    }
+
+    /**
+     * Returns a PostgreSQL tsquery string matching the start of every word in the query.
+     *
+     * For example "Cat 10" becomes "cat:* & 10:*".
+     *
+     * @param string $q The query string
+     * @return string The tsquery string, empty if there is nothing to search for
+     */
+    protected function get_postgres_tsquery(string $q): string {
+        // Remove tsquery operators and characters with a special meaning.
+        $words = $this->get_query_words($q, "&|!():*<>'\"\\");
+        $terms = array_map(function($word) {
+            return $word . ':*';
+        }, $words);
+        return implode(' & ', $terms);
+    }
+
