+     */
+    protected function get_postgres_query(string $q): array {
+        $fields = ['title', 'content', 'description1', 'description2'];
+
+        $termsql = [];
+        $params = [];
+        foreach ($this->get_query_terms($q) as $term) {
+            if (!$this->term_has_word_characters($term)) {
+                continue;
+            }
+            // Quote the term as a tsquery lexeme (so operators are not interpreted) and use prefix matching.
+            $lexeme = "'" . str_replace(['\\', "'"], ['\\\\', "''"], $term) . "':*";
+
+            $fieldsql = [];
+            foreach ($fields as $field) {
+                $fieldsql[] = "to_tsvector('simple', {$field}) @@ to_tsquery('simple', ?)";
+                $params[] = $lexeme;
+            }
+            $termsql[] = '(' . implode(' OR ', $fieldsql) . ')';
+        }
+
+        if (empty($termsql)) {
+            return [null, []];
+        }
+        return ['(' . implode(' AND ', $termsql) . ')', $params];
+    }
