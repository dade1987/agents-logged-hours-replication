+    /**
+     * Splits the search query into the list of terms to search for.
+     *
+     * Double quotes are removed (phrases are not supported) and the query is split by white spaces.
+     *
+     * @param string $q The query string
+     * @return string[] List of unique, non-empty terms
+     */
+    protected function get_query_terms(string $q): array {
+        $q = str_replace('"', ' ', $q);
+        $terms = preg_split('/\s+/u', trim($q), -1, PREG_SPLIT_NO_EMPTY);
+        if ($terms === false) {
+            // Invalid UTF-8, fallback to a non unicode-aware split.
+            $terms = preg_split('/\s+/', trim($q), -1, PREG_SPLIT_NO_EMPTY);
+        }
+        $unique = [];
+        foreach ($terms as $term) {
+            $unique[\core_text::strtolower($term)] = $term;
+        }
+        return array_values($unique);
+    }
+
+    /**
+     * Whether the term contains at least one letter or number.
+     *
+     * @param string $term
+     * @return bool
+     */
+    protected function term_has_word_characters(string $term): bool {
+        return (bool)preg_match('/[\p{L}\p{N}]/u', $term);
+    }
+
+    /**
+     * Returns the query for PostgreSQL, using full text search with prefix matching.
+     *
