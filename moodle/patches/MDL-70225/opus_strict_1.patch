+        foreach ($this->get_query_terms($q) as $term) {
+            // Boolean mode operators and other non-word characters act as word separators.
+            $termwords = preg_split('/[^\p{L}\p{N}_]+/u', $term, -1, PREG_SPLIT_NO_EMPTY);
+            if (!$termwords) {
