+    /**
+     * Test that the search matches the start of words and requires all the terms.
+     *
+     * @return void
+     */
+    public function test_search_partial_words(): void {
+        $this->add_mock_search_area();
+
+        $this->generator->create_record((object)['title' => 'Cats 101', 'content' => 'Content about cats']);
+        $this->generator->create_record((object)['title' => 'Dogs 101', 'content' => 'Content about dogs']);
+        $this->generator->create_record((object)['title' => 'Course CU99999', 'content' => 'First course']);
+        $this->generator->create_record((object)['title' => 'Course CU99999V20', 'content' => 'Second course']);
+
+        $this->search->index();
+        $this->update_index();
+
+        // Whole word.
+        $this->assert_search_titles('101', ['Cats 101', 'Dogs 101']);
+
+        // All the terms are required (AND).
+        $this->assert_search_titles('Cats Dogs', []);
+        $this->assert_search_titles('Cats 101', ['Cats 101']);
+
+        // Start of the words.
+        $this->assert_search_titles('Cat 10', ['Cats 101']);
+        $this->assert_search_titles('Dog', ['Dogs 101']);
+        $this->assert_search_titles('CU99999', ['Course CU99999', 'Course CU99999V20']);
+        $this->assert_search_titles('CU99999V', ['Course CU99999V20']);
+        $this->assert_search_titles('cu99999v20', ['Course CU99999V20']);
+
+        // Middle of the words does not match.
+        $this->assert_search_titles('ogs', []);
+        $this->assert_search_titles('99999', []);
+
+        // Quotes and special characters are ignored.
+        $this->assert_search_titles('"Cats 101"', ['Cats 101']);
+        $this->assert_search_titles('Cat* & Dog*', []);
+        $this->assert_search_titles('+Dog*', ['Dogs 101']);
+
+        // Nothing meaningful to search for.
+        $this->assert_search_titles('*', []);
+        $this->assert_search_titles('"', []);
+    }
+
+    /**
+     * Test the LIKE based fallback query used by databases without full-text search support.
+     *
+     * @return void
+     */
+    public function test_simple_query_fallback(): void {
+        global $DB;
+
+        $this->add_mock_search_area();
+
+        $this->generator->create_record((object)['title' => 'Cats 101', 'content' => 'Content about cats']);
+        $this->generator->create_record((object)['title' => 'Dogs 101', 'content' => 'Content about dogs']);
+        $this->generator->create_record((object)['title' => 'Course CU99999', 'content' => 'First course']);
+        $this->generator->create_record((object)['title' => 'Course CU99999V20', 'content' => 'Second course']);
+
+        $this->search->index();
+        $this->update_index();
+
+        $method = new \ReflectionMethod($this->engine, 'get_simple_query');
+
+        $cases = [
+            '101' => ['Cats 101', 'Dogs 101'],
+            'Cats Dogs' => [],
+            'Cat 10' => ['Cats 101'],
+            'Dog' => ['Dogs 101'],
+            'CU99999' => ['Course CU99999', 'Course CU99999V20'],
+            'cu99999v' => ['Course CU99999V20'],
+            'ogs' => [],
+            '"Cats 101"' => ['Cats 101'],
+            '100%' => [],
+            'about_cats' => [],
+        ];
+        foreach ($cases as $q => $expected) {
+            list($sql, $params) = $method->invoke($this->engine, (string)$q);
+            $titles = array_map(function($record) {
+                return $record->title;
+            }, $DB->get_records_select('search_simpledb_index', $sql, $params));
+            sort($titles);
+            $this->assertEquals($expected, array_values($titles), 'Unexpected results for query "' . $q . '"');
+        }
+    }
+
+    /**
+     * Asserts that the given search query returns the given titles.
+     *
+     * @param string $q Search query
+     * @param string[] $expected Expected titles (in alphabetical order)
+     */
+    protected function assert_search_titles(string $q, array $expected): void {
+        $querydata = new \stdClass();
+        $querydata->q = $q;
+        $titles = array_map(function($result) {
+            return $result->get('title');
+        }, $this->search->search($querydata));
+        sort($titles);
+        $this->assertEquals($expected, $titles, 'Unexpected results for query "' . $q . '"');
+    }
