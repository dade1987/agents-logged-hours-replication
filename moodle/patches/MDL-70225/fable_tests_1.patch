     /**
-     * Returns the default query for db engines.
+     * Splits the search query into the list of terms to search for.
+     *
+     * Terms are separated by white space. Quotes and characters that have a special meaning
+     * for the database full-text search engines are removed, as they are not part of the
+     * indexed words anyway. Empty terms are discarded.
      *
      * @param string $q The query string
+     * @return string[] List of terms
+     */
+    protected function get_search_terms(string $q): array {
+        // Remove quotes and the operators used by the full-text search engines.
+        $specialchars = '["\'`\\\\:*+\-<>~()@&|!]';
+        $cleaned = preg_replace('/' . $specialchars . '/u', ' ', $q);
+        if ($cleaned === null) {
+            // Invalid UTF-8, fall back to a non unicode replacement.
+            $cleaned = preg_replace('/' . $specialchars . '/', ' ', $q);
+        }
+
+        $terms = preg_split('/\s+/u', trim((string)$cleaned), -1, PREG_SPLIT_NO_EMPTY);
+        if ($terms === false) {
+            $terms = preg_split('/\s+/', trim((string)$cleaned), -1, PREG_SPLIT_NO_EMPTY);
+        }
+
+        return array_values(array_unique($terms));
+    }
+
+    /**
+     * Returns the PostgreSQL tsquery string, all terms are required and matched as prefixes.
+     *
+     * @param string[] $terms Search terms
+     * @return string
+     */
+    protected function get_postgres_tsquery(array $terms): string {
+        $parts = [];
+        foreach ($terms as $term) {
+            // Quote the term so it is normalised using the 'simple' configuration parser.
+            $parts[] = "'" . str_replace("'", "''", $term) . "':*";
+        }
+        return implode(' & ', $parts);
+    }
+
+    /**
+     * Returns the MySQL boolean mode query, all terms are required and matched as prefixes.
+     *
+     * @param string[] $terms Search terms
+     * @return string
+     */
+    protected function get_mysql_boolean_query(array $terms): string {
+        $parts = [];
+        foreach ($terms as $term) {
+            $parts[] = '+' . $term . '*';
+        }
+        return implode(' ', $parts);
+    }
+
+    /**
+     * Returns the SQL Server CONTAINS query, all terms are required and matched as prefixes.
+     *
+     * @param string[] $terms Search terms
+     * @return string
+     */
+    protected function get_mssql_contains_query(array $terms): string {
+        $parts = [];
+        foreach ($terms as $term) {
+            $parts[] = '"' . $term . '*"';
+        }
+        return implode(' AND ', $parts);
+    }
+
