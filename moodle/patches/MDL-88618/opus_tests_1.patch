+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+declare(strict_types=1);
+
+namespace editor_tiny;
+
+use advanced_testcase;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
+
+/**
+ * Unit tests for the editor_tiny\manager class.
+ *
+ * @package     editor_tiny
+ * @copyright   2026 Moodle Pty Ltd
+ * @license     http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[CoversClass(manager::class)]
+final class manager_test extends advanced_testcase {
+    /**
+     * Data provider for bundled TinyMCE plugins which should be enabled.
+     *
+     * @return array
+     */
+    public static function enabled_tinymce_plugins_provider(): array {
+        return [
+            'accordion' => ['accordion'],
+            'advlist' => ['advlist'],
+            'lists' => ['lists'],
+        ];
+    }
+
+    /**
+     * Ensure that the expected bundled TinyMCE plugins are in the initialised plugin list.
+     *
+     * @param string $pluginname
+     */
+    #[DataProvider('enabled_tinymce_plugins_provider')]
+    public function test_get_plugin_configuration_includes_plugin(string $pluginname): void {
+        $this->resetAfterTest();
+
+        $manager = new manager();
+        $plugins = $manager->get_plugin_configuration(\context_system::instance());
+
+        $this->assertArrayHasKey($pluginname, $plugins);
+    }
+
+    /**
+     * The advlist plugin depends upon the lists plugin, and must only be present alongside it.
+     */
+    public function test_advlist_requires_lists(): void {
+        $this->resetAfterTest();
+
+        $manager = new manager();
+        $plugins = $manager->get_plugin_configuration(\context_system::instance());
+
+        $this->assertArrayHasKey('advlist', $plugins);
+        $this->assertArrayHasKey('lists', $plugins);
+    }
+
+    /**
+     * The accordion plugin should be accessible from the Insert menu by default.
+     */
+    public function test_accordion_configuration(): void {
+        $this->resetAfterTest();
+
+        $manager = new manager();
+        $plugins = $manager->get_plugin_configuration(\context_system::instance());
+
+        $this->assertContains('accordion', $plugins['accordion']['buttons']);
+        $this->assertEquals('insert', $plugins['accordion']['menuitems']['accordion']);
+    }
+}
