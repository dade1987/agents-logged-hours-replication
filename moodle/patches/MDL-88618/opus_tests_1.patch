diff --git a/public/lib/editor/tiny/tests/behat/accordion_advlist.feature b/public/lib/editor/tiny/tests/behat/accordion_advlist.feature
new file mode 100644
index 00000000000..73f476d842b
--- /dev/null
+++ b/public/lib/editor/tiny/tests/behat/accordion_advlist.feature
@@ -0,0 +1,38 @@
+@editor @editor_tiny @javascript
+Feature: Use the TinyMCE Accordion and List Styles plugins
+  In order to structure content in TinyMCE
+  As a user
+  I need to be able to insert accordions and apply extended list styles
+
+  Scenario: Insert an accordion using the Insert menu
+    Given I am on the "Profile advanced editing" page logged in as "admin"
+    And I set the field "Description" to "<p>Some text</p>"
+    And I select the "p" element in position "0" of the "Description" TinyMCE editor
+    When I click on the "Insert > Accordion" menu item for the "Description" TinyMCE editor
+    Then the field "Description" matches expression "@<details class=\"mce-accordion\"[^>]*>\s*<summary[^>]*>.*</summary>.*</details>@s"
+
+  Scenario: Accordion content is preserved when displayed
+    Given I am on the "Profile advanced editing" page logged in as "admin"
+    And I set the field "Description" to "<details class=\"mce-accordion\" open=\"open\"><summary class=\"mce-accordion-summary\">Accordion heading</summary><div class=\"mce-accordion-body\"><p>Accordion content</p></div></details>"
+    When I press "Update profile"
+    Then "details.mce-accordion summary" "css_element" should exist
+    And I should see "Accordion heading"
+    And I should see "Accordion content"
+
+  Scenario: Apply an extended ordered list style
+    Given I am on the "Profile advanced editing" page logged in as "admin"
+    And I set the field "Description" to "<p>List item</p>"
+    And I select the "p" element in position "0" of the "Description" TinyMCE editor
+    And I expand all toolbars for the "Description" TinyMCE editor
+    When I click on the "Numbered list menu" button for the "Description" TinyMCE editor
+    And I click on "[role^='menuitem'][aria-label='Lower Alpha']" "css_element"
+    Then the field "Description" matches expression "@<ol style=\"list-style-type: lower-alpha;\">\s*<li>List item</li>\s*</ol>@s"
+
+  Scenario: Apply an extended unordered list style
+    Given I am on the "Profile advanced editing" page logged in as "admin"
+    And I set the field "Description" to "<p>List item</p>"
+    And I select the "p" element in position "0" of the "Description" TinyMCE editor
+    And I expand all toolbars for the "Description" TinyMCE editor
+    When I click on the "Bullet list menu" button for the "Description" TinyMCE editor
+    And I click on "[role^='menuitem'][aria-label='Square']" "css_element"
+    Then the field "Description" matches expression "@<ul style=\"list-style-type: square;\">\s*<li>List item</li>\s*</ul>@s"
