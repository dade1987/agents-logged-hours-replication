@@ -338,6 +338,22 @@ final class htmlpurifier_test extends \basic_testcase {
         $this->assertSame($expected, purify_html($text));
     }
 
+    /**
+     * Test that disclosure (details/summary) elements, as used by the TinyMCE Accordion plugin, are preserved.
+     */
+    public function test_details_summary(): void {
+        $text = '<details class="mce-accordion" open="open"><summary class="mce-accordion-summary">Summary</summary>' .
+            '<div class="mce-accordion-body"><p>Body</p></div></details>';
+        $this->assertSame($text, purify_html($text));
+
+        $text = '<details><summary><h3>Heading</h3></summary><p>Body</p></details>';
+        $this->assertSame($text, purify_html($text));
+
+        // Disallowed attributes are still removed.
+        $text = '<details onclick="alert(1)"><summary onclick="alert(1)">Summary</summary><p>Body</p></details>';
+        $this->assertSame('<details><summary>Summary</summary><p>Body</p></details>', purify_html($text));
+    }
+
