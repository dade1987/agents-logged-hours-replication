+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+declare(strict_types=1);
+
+namespace editor_tiny;
+
+use advanced_testcase;
+use ReflectionMethod;
+
+/**
+ * Unit tests for the editor_tiny manager.
+ *
+ * @package     editor_tiny
+ * @covers      \editor_tiny\manager
+ * @copyright   2025 Moodle Pty Ltd
+ * @license     http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+final class manager_test extends advanced_testcase {
+    /**
+     * Test that the accordion, advlist, and lists plugins are in the shipped plugin list.
+     */
+    public function test_shipped_plugins_include_accordion_and_advlist(): void {
+        $manager = new manager();
+        $method = new ReflectionMethod($manager, 'get_shipped_plugins');
+        $plugins = $method->invoke($manager);
+
+        $this->assertArrayHasKey('accordion', $plugins);
+        $this->assertArrayHasKey('advlist', $plugins);
+        // The advlist plugin depends on the lists plugin.
+        $this->assertArrayHasKey('lists', $plugins);
+    }
+}
