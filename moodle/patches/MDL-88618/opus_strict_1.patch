+
+namespace editor_tiny;
+
+/**
+ * Unit tests for the editor_tiny\manager class.
+ *
+ * @package    editor_tiny
+ * @covers     \editor_tiny\manager
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+final class manager_test extends \advanced_testcase {
+    /**
+     * Get the plugin configuration for the system context.
+     *
+     * @return array
+     */
+    protected function get_plugin_configuration(): array {
+        $manager = new manager();
+        return $manager->get_plugin_configuration(\core\context\system::instance(), [], []);
+    }
+
+    /**
+     * Ensure that the Accordion plugin is enabled.
+     */
+    public function test_accordion_plugin_enabled(): void {
+        $this->resetAfterTest();
+
+        $plugins = $this->get_plugin_configuration();
+
+        $this->assertArrayHasKey('accordion', $plugins);
+        $this->assertContains('accordion', $plugins['accordion']['buttons']);
+        $this->assertArrayHasKey('accordion', $plugins['accordion']['menuitems']);
+        $this->assertEquals('insert', $plugins['accordion']['menuitems']['accordion']);
+    }
+
+    /**
+     * Ensure that the List Styles (advlist) plugin is enabled, along with the lists plugin that it depends upon.
+     */
+    public function test_advlist_plugin_enabled(): void {
+        $this->resetAfterTest();
+
+        $plugins = $this->get_plugin_configuration();
+
+        $this->assertArrayHasKey('advlist', $plugins);
+        // The advlist plugin requires the lists plugin.
+        $this->assertArrayHasKey('lists', $plugins);
+
+        $this->assertContains('bullist', $plugins['advlist']['buttons']);
+        $this->assertContains('numlist', $plugins['advlist']['buttons']);
+    }
+
+    /**
+     * Ensure that the plugins which are disabled in Moodle are not included.
+     */
+    public function test_disabled_plugins_not_included(): void {
+        $this->resetAfterTest();
+
+        $plugins = $this->get_plugin_configuration();
+
+        foreach (['image', 'media', 'autosave', 'preview', 'link'] as $disabledplugin) {
+            $this->assertArrayNotHasKey($disabledplugin, $plugins);
+        }
+    }
+}
diff --git a/public/lib/tests/weblib_test.php b/public/lib/tests/weblib_test.php
index bf3e969d1cd..67131f3b886 100644
--- a/public/lib/tests/weblib_test.php
+++ b/public/lib/tests/weblib_test.php
@@ -641,6 +641,34 @@ EXPECTED;
 
     }
 
+    /**
+     * Test that the details and summary elements (used by the TinyMCE Accordion plugin) are preserved.
+     *
+     * @covers \purify_html
+     */
+    public function test_purify_html_details(): void {
+        $this->resetAfterTest();
+
+        $accordion = '<details class="mce-accordion" open="open">' .
+            '<summary class="mce-accordion-summary">Accordion summary</summary>' .
+            '<div class="mce-accordion-body"><p>Accordion <strong>body</strong></p></div>' .
+            '</details>' .
+            '<details><summary>Closed accordion</summary><p>Hidden content</p></details>';
+
+        $this->assertEquals($accordion, purify_html($accordion));
+
+        // Unsafe attributes and content are still removed.
+        $illegal = '<details onclick="alert(1)"><summary onmouseover="alert(2)">Summary</summary>' .
+            '<script>alert(3);</script><p>Body</p></details>';
+        $this->assertEquals(
+            '<details><summary>Summary</summary><p>Body</p></details>',
+            purify_html($illegal)
+        );
+
+        // The summary element is only valid within a details element.
+        $this->assertEquals('<p>Text</p>', purify_html('<p><summary>Text</summary></p>'));
+    }
+
     /**
      * Tests for content_to_text.
      *
