diff --git a/public/lib/editor/tiny/tests/behat/accordion_advlist.feature b/public/lib/editor/tiny/tests/behat/accordion_advlist.feature
new file mode 100644
index 00000000000..3321a951205
--- /dev/null
+++ b/public/lib/editor/tiny/tests/behat/accordion_advlist.feature
@@ -0,0 +1,33 @@
+@editor @editor_tiny @javascript
+Feature: Use the TinyMCE Accordion and List Styles plugins
+  In order to structure my content
+  As a user
+  I need to be able to insert accordions and apply list styles in TinyMCE
+
+  Scenario: Insert an accordion using the Insert menu
+    Given I am on the "Profile advanced editing" page logged in as "admin"
+    And I set the field "Description" to "<p>My accordion title</p>"
+    And I select the "p" element in position "0" of the "Description" TinyMCE editor
+    When I click on the "Insert > Accordion" menu item for the "Description" TinyMCE editor
+    Then the field "Description" matches expression "#<details class=\"mce-accordion\" open=\"open\"><summary class=\"mce-accordion-summary\">My accordion title</summary><div class=\"mce-accordion-body\"><p>.+</p></div></details>#s"
+    And I click on "Update profile" "button"
+    And I am on the "admin" "user > profile" page
+    And "//details[contains(@class, 'mce-accordion')]/summary[contains(., 'My accordion title')]" "xpath_element" should exist
+
+  Scenario: Apply an extended ordered list style
+    Given I am on the "Profile advanced editing" page logged in as "admin"
+    And I set the field "Description" to "<p>First item</p>"
+    And I select the "p" element in position "0" of the "Description" TinyMCE editor
+    And I expand all toolbars for the "Description" TinyMCE editor
+    When I click on the "Numbered list menu" button for the "Description" TinyMCE editor
+    And I click on "[role^='menuitem'][aria-label='Lower Alpha']" "css_element"
+    Then the field "Description" matches expression "#<ol style=\"list-style-type: lower-alpha;\">\s*<li>First item</li>\s*</ol>#s"
+
+  Scenario: Apply an extended unordered list style
+    Given I am on the "Profile advanced editing" page logged in as "admin"
+    And I set the field "Description" to "<p>First item</p>"
+    And I select the "p" element in position "0" of the "Description" TinyMCE editor
+    And I expand all toolbars for the "Description" TinyMCE editor
+    When I click on the "Bullet list menu" button for the "Description" TinyMCE editor
+    And I click on "[role^='menuitem'][aria-label='Square']" "css_element"
+    Then the field "Description" matches expression "#<ul style=\"list-style-type: square;\">\s*<li>First item</li>\s*</ul>#s"
