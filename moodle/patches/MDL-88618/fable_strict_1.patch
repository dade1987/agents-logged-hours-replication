+                    '<div class="mce-accordion-body"><p>Body</p></div></details>',
+                '<details class="mce-accordion"><summary class="mce-accordion-summary">Summary</summary>' .
+                    '<div class="mce-accordion-body"><p>Body</p></div></details>',
+            ],
+            'Open accordion' => [
+                '<details class="mce-accordion" open="open"><summary class="mce-accordion-summary">Summary</summary>' .
+                    '<div class="mce-accordion-body"><p>Body</p></div></details>',
+                '<details class="mce-accordion" open="open"><summary class="mce-accordion-summary">Summary</summary>' .
+                    '<div class="mce-accordion-body"><p>Body</p></div></details>',
+            ],
+            'Open accordion with boolean attribute' => [
+                '<details open><summary>Summary</summary><p>Body</p></details>',
+                '<details open="open"><summary>Summary</summary><p>Body</p></details>',
+            ],
+            'Summary with inline formatting' => [
+                '<details><summary>A <strong>bold</strong> summary</summary><p>Body</p></details>',
+                '<details><summary>A <strong>bold</strong> summary</summary><p>Body</p></details>',
+            ],
+        ];
+    }
+
