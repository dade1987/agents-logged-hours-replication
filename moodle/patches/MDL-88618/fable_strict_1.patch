diff --git a/public/lib/editor/tiny/tests/behat/accordion_advlist.feature b/public/lib/editor/tiny/tests/behat/accordion_advlist.feature
new file mode 100644
index 00000000000..5171e8d07af
--- /dev/null
+++ b/public/lib/editor/tiny/tests/behat/accordion_advlist.feature
@@ -0,0 +1,44 @@
+@editor @editor_tiny @javascript
+Feature: The bundled TinyMCE Accordion and List Styles plugins are available
+  In order to author structured content
+  As a user
+  I can insert accordions and apply additional list styles in TinyMCE
+
+  Scenario: Insert an accordion using the Insert menu
+    Given I am on the "Profile advanced editing" page logged in as "admin"
+    When I click on the "Insert > Accordion" menu item for the "Description" TinyMCE editor
+    And I switch to the "Description" TinyMCE editor iframe
+    Then "details.mce-accordion" "css_element" should exist
+    And "details.mce-accordion summary" "css_element" should exist
+    And I switch to the main frame
+    And the field "Description" matches expression "@<details[^>]*>\s*<summary[^>]*>.*</summary>.*</details>@s"
+
+  Scenario: Accordion content is preserved when displayed
+    Given I am on the "Profile advanced editing" page logged in as "admin"
+    And I set the field "Description" to multiline:
+    """
+    <details class="mce-accordion" open="open"><summary class="mce-accordion-summary">My accordion summary</summary><div class="mce-accordion-body"><p>My accordion body</p></div></details>
+    """
+    When I click on "Update profile" "button"
+    Then "details.mce-accordion" "css_element" should exist
+    And "details.mce-accordion summary" "css_element" should exist
+    And I should see "My accordion summary"
+    And I should see "My accordion body"
+
+  Scenario: Apply an extended list style to a numbered list
+    Given I am on the "Profile advanced editing" page logged in as "admin"
+    And I set the field "Description" to "<ol><li>One</li><li>Two</li></ol>"
+    And I select the "li" element in position "1" of the "Description" TinyMCE editor
+    And "Numbered list menu" button should exist in the "Description" TinyMCE editor
+    And "Bullet list menu" button should exist in the "Description" TinyMCE editor
+    When I click on the "Numbered list menu" button for the "Description" TinyMCE editor
+    And I click on ".tox-collection__item[aria-label='Lower Alpha']" "css_element"
+    Then the field "Description" matches expression "@<ol style=\"list-style-type: lower-alpha;\">@"
+
+  Scenario: Apply an extended list style to a bulleted list
+    Given I am on the "Profile advanced editing" page logged in as "admin"
+    And I set the field "Description" to "<ul><li>One</li><li>Two</li></ul>"
+    And I select the "li" element in position "1" of the "Description" TinyMCE editor
+    When I click on the "Bullet list menu" button for the "Description" TinyMCE editor
+    And I click on ".tox-collection__item[aria-label='Square']" "css_element"
+    Then the field "Description" matches expression "@<ul style=\"list-style-type: square;\">@"
