+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+declare(strict_types=1);
+
+namespace editor_tiny;
+
+use advanced_testcase;
+
+/**
+ * Unit tests for the editor_tiny\manager class.
+ *
+ * @package     editor_tiny
+ * @category    test
+ * @covers      \editor_tiny\manager
+ * @copyright   2025 Moodle Pty Ltd
+ * @license     http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+final class manager_test extends advanced_testcase {
+    /**
+     * Test that the bundled TinyMCE plugins which Moodle enables are included in the plugin configuration.
+     *
+     * @dataProvider enabled_shipped_plugins_provider
+     * @param string $plugin The name of the TinyMCE plugin
+     */
+    public function test_get_plugin_configuration_includes_shipped_plugin(string $plugin): void {
+        $this->resetAfterTest();
+
+        $manager = new manager();
+        $plugins = $manager->get_plugin_configuration(\core\context\system::instance());
+
+        $this->assertArrayHasKey($plugin, $plugins);
+    }
+
+    /**
+     * Data provider for test_get_plugin_configuration_includes_shipped_plugin.
+     *
+     * @return array
+     */
+    public static function enabled_shipped_plugins_provider(): array {
+        return [
+            'accordion' => ['accordion'],
+            'advlist' => ['advlist'],
+            // The advlist plugin depends upon the lists plugin.
+            'lists' => ['lists'],
+        ];
+    }
+
+    /**
+     * Test the configuration of the accordion, and advlist, plugins.
+     */
+    public function test_get_plugin_configuration_accordion_advlist(): void {
+        $this->resetAfterTest();
+
+        $manager = new manager();
+        $plugins = $manager->get_plugin_configuration(\core\context\system::instance());
+
+        // The accordion plugin is accessible from the Insert menu.
+        $this->assertArrayHasKey('menuitems', $plugins['accordion']);
+        $this->assertSame('insert', $plugins['accordion']['menuitems']['accordion']);
+        $this->assertContains('accordion', $plugins['accordion']['buttons']);
+
+        // The advlist plugin extends the existing list buttons provided by the lists plugin.
+        $this->assertArrayNotHasKey('menuitems', $plugins['advlist']);
+        $this->assertSame($plugins['lists']['buttons'], $plugins['advlist']['buttons']);
+    }
+
+    /**
+     * Test that the bundled TinyMCE plugins which Moodle disables are not included in the plugin configuration.
+     *
+     * @dataProvider disabled_shipped_plugins_provider
+     * @param string $plugin The name of the TinyMCE plugin
+     */
+    public function test_get_plugin_configuration_excludes_disabled_plugin(string $plugin): void {
+        $this->resetAfterTest();
+
+        $manager = new manager();
+        $plugins = $manager->get_plugin_configuration(\core\context\system::instance());
+
+        $this->assertArrayNotHasKey($plugin, $plugins);
+    }
+
+    /**
+     * Data provider for test_get_plugin_configuration_excludes_disabled_plugin.
+     *
+     * @return array
+     */
+    public static function disabled_shipped_plugins_provider(): array {
+        return [
+            'image' => ['image'],
+            'media' => ['media'],
+            'autosave' => ['autosave'],
+            'preview' => ['preview'],
+            'link' => ['link'],
+        ];
+    }
+}
