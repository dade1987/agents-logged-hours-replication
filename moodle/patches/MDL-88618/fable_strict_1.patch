+    /**
+     * Test that the details and summary disclosure elements (used by the TinyMCE accordion plugin) are preserved.
+     *
+     * @dataProvider details_summary_provider
+     * @param string $text The HTML to purify
+     * @param string $expected The expected purified HTML
+     */
+    public function test_details_summary(string $text, string $expected): void {
+        $this->assertSame($expected, purify_html($text));
