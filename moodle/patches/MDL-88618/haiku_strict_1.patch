+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace editor_tiny;
+
+/**
+ * Unit tests for the editor_tiny manager class.
+ *
+ * @package    editor_tiny
+ * @category   test
+ * @copyright  2026 Moodle Developers
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \editor_tiny\manager
+ */
+final class manager_test extends \advanced_testcase {
+
+    /**
+     * Get the shipped plugins from the manager, exposing the protected method.
+     *
+     * @return array
+     */
+    private function get_shipped_plugins(): array {
+        $manager = new class extends manager {
+            /**
+             * Expose the protected method for testing.
+             *
+             * @return array
+             */
+            public function get_shipped_plugins_for_test(): array {
+                return $this->get_shipped_plugins();
+            }
+        };
+
+        return $manager->get_shipped_plugins_for_test();
+    }
+
+    /**
+     * Test that the accordion and advlist plugins are included in the enabled shipped plugins.
+     */
+    public function test_accordion_and_advlist_are_enabled(): void {
+        $this->resetAfterTest();
+
+        $plugins = $this->get_shipped_plugins();
+
+        $this->assertArrayHasKey('accordion', $plugins);
+        $this->assertArrayHasKey('advlist', $plugins);
+    }
+
+    /**
+     * Test that the accordion plugin is accessible from the Insert menu.
+     */
+    public function test_accordion_is_in_insert_menu(): void {
+        $this->resetAfterTest();
+
+        $plugins = $this->get_shipped_plugins();
+
+        $this->assertSame(['accordion' => 'insert'], $plugins['accordion']['menuitems']);
+        $this->assertContains('accordion', $plugins['accordion']['buttons']);
+    }
+
+    /**
+     * Test that the lists plugin required by advlist is enabled.
+     */
+    public function test_lists_plugin_is_enabled_for_advlist(): void {
+        $this->resetAfterTest();
+
+        $plugins = $this->get_shipped_plugins();
+
+        $this->assertArrayHasKey('lists', $plugins);
+    }
+}
