+declare(strict_types=1);
+
+namespace editor_tiny;
+
+use advanced_testcase;
+
+/**
+ * Unit tests for the editor_tiny\manager class.
+ *
+ * @package     editor_tiny
+ * @covers      \editor_tiny\manager
+ * @copyright   2026 Moodle Pty Ltd
+ * @license     http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+final class manager_test extends advanced_testcase {
+    /**
+     * Test that the expected shipped TinyMCE plugins are included in the plugin configuration.
+     *
+     * @dataProvider shipped_plugins_provider
+     * @param string $plugin The TinyMCE plugin name
+     */
+    public function test_get_plugin_configuration_includes_shipped_plugins(string $plugin): void {
+        $this->resetAfterTest();
+
+        $manager = new manager();
+        $plugins = $manager->get_plugin_configuration(\core\context\system::instance());
+
+        $this->assertArrayHasKey($plugin, $plugins);
+    }
+
+    /**
+     * Data provider for test_get_plugin_configuration_includes_shipped_plugins.
+     *
+     * @return array
+     */
+    public static function shipped_plugins_provider(): array {
+        return [
+            'accordion' => ['accordion'],
+            'advlist' => ['advlist'],
+            'lists' => ['lists'],
+            'table' => ['table'],
+        ];
+    }
+
+    /**
+     * Test that the advlist plugin is loaded after its dependency, the lists plugin.
+     */
+    public function test_advlist_is_loaded_after_lists(): void {
+        $this->resetAfterTest();
+
+        $manager = new manager();
+        $plugins = array_keys($manager->get_plugin_configuration(\core\context\system::instance()));
+
+        $listsposition = array_search('lists', $plugins, true);
+        $advlistposition = array_search('advlist', $plugins, true);
+
+        $this->assertNotFalse($listsposition);
+        $this->assertNotFalse($advlistposition);
+        $this->assertGreaterThan($listsposition, $advlistposition);
+    }
+
+    /**
+     * Test that the disabled TinyMCE plugins are not included in the plugin configuration.
+     *
+     * @dataProvider disabled_plugins_provider
+     * @param string $plugin The TinyMCE plugin name
+     */
+    public function test_get_plugin_configuration_excludes_disabled_plugins(string $plugin): void {
+        $this->resetAfterTest();
+
+        $manager = new manager();
+        $plugins = $manager->get_plugin_configuration(\core\context\system::instance());
+
+        $this->assertArrayNotHasKey($plugin, $plugins);
+    }
+
+    /**
+     * Data provider for test_get_plugin_configuration_excludes_disabled_plugins.
+     *
+     * @return array
+     */
+    public static function disabled_plugins_provider(): array {
+        return [
+            'image' => ['image'],
+            'media' => ['media'],
+            'autosave' => ['autosave'],
+            'preview' => ['preview'],
+            'link' => ['link'],
+        ];
+    }
+}
diff --git a/public/lib/tests/htmlpurifier_test.php b/public/lib/tests/htmlpurifier_test.php
index 60cde533518..a9c45c546e6 100644
--- a/public/lib/tests/htmlpurifier_test.php
+++ b/public/lib/tests/htmlpurifier_test.php
@@ -184,6 +184,29 @@ final class htmlpurifier_test extends \basic_testcase {
         $this->assertSame($text, purify_html($text));
     }
 
+    /**
+     * Test that the details and summary elements (used by the TinyMCE accordion plugin) are preserved.
+     */
+    public function test_details_and_summary(): void {
+        // Markup as generated by the TinyMCE accordion plugin.
+        $text = '<details class="mce-accordion" open="open">' .
+            '<summary class="mce-accordion-summary">Accordion summary</summary>' .
+            '<p>Accordion body</p>' .
+            '</details>';
+        $this->assertSame($text, purify_html($text));
+        $this->assertSame($text, format_text($text, FORMAT_HTML, ['filter' => false]));
+
+        // A closed accordion.
+        $text = '<details class="mce-accordion"><summary>Summary</summary><p>Body</p></details>';
+        $this->assertSame($text, purify_html($text));
+
+        // Unsafe attributes are still removed.
+        $text = '<details open="open" ontoggle="alert(1)"><summary onclick="alert(1)">Summary</summary>' .
+            '<p>Body</p></details>';
+        $expected = '<details open="open"><summary>Summary</summary><p>Body</p></details>';
+        $this->assertSame($expected, purify_html($text));
+    }
+
     /**
      * Test that XSS protection works, complete smoke tests are in htmlpurifier itself.
      */
