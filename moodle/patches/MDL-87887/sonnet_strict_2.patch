diff --git a/public/mod/forum/externallib.php b/public/mod/forum/externallib.php
index 3040f7f2844..79cf7d9cb7c 100644
--- a/public/mod/forum/externallib.php
+++ b/public/mod/forum/externallib.php
@@ -1625,6 +1625,95 @@ class mod_forum_external extends external_api {
         return discussion_exporter::get_read_structure();
     }
 
+    /**
+     * Set the read state of a post for the current user (requires manual mark as read to be enabled).
+     *
+     * @param int $postid The post id.
+     * @param bool $targetstate True to mark as read, false to mark as unread.
+     * @return array
+     * @since Moodle 5.2
+     */
+    public static function set_read_state($postid, $targetstate) {
+        global $USER;
+
+        $params = self::validate_parameters(self::set_read_state_parameters(), [
+            'postid' => $postid,
+            'targetstate' => $targetstate,
+        ]);
+
+        $vaultfactory = mod_forum\local\container::get_vault_factory();
+        $managerfactory = mod_forum\local\container::get_manager_factory();
+        $postvault = $vaultfactory->get_post_vault();
+        $discussionvault = $vaultfactory->get_discussion_vault();
+        $forumvault = $vaultfactory->get_forum_vault();
+
+        $post = $postvault->get_from_id($params['postid']);
+        if (empty($post)) {
+            throw new \moodle_exception('invalidpostid', 'forum', '', $params['postid']);
+        }
+        $discussion = $discussionvault->get_from_id($post->get_discussion_id());
+        if (empty($discussion)) {
+            throw new \moodle_exception('cannotfinddiscussion', 'forum');
+        }
+        $forum = $forumvault->get_from_id($discussion->get_forum_id());
+        if (empty($forum)) {
+            throw new \moodle_exception('invalidforumid', 'forum');
+        }
+
+        self::validate_context($forum->get_context());
+
+        $capabilitymanager = $managerfactory->get_capability_manager($forum);
+        if (!$capabilitymanager->can_view_post($USER, $discussion, $post)) {
+            throw new \moodle_exception('noviewdiscussionspermission', 'forum');
+        }
+        if (!$capabilitymanager->can_manually_control_post_read_status($USER)) {
+            throw new \moodle_exception('nopermissions', 'error', '', get_string('markread', 'forum'));
+        }
+
+        $forumrecord = mod_forum\local\container::get_legacy_data_mapper_factory()
+            ->get_forum_data_mapper()->to_legacy_object($forum);
+        if (!forum_tp_can_track_forums($forumrecord)) {
+            throw new \moodle_exception('nopermissions', 'error', '', get_string('markread', 'forum'));
+        }
+
+        if ($params['targetstate']) {
+            $status = forum_tp_add_read_record($USER->id, $post->get_id());
+        } else {
+            $status = forum_tp_delete_read_records($USER->id, $post->get_id());
+        }
+
+        return [
+            'status' => (bool) $status,
+            'warnings' => [],
+        ];
+    }
+
+    /**
+     * Returns description of method parameters.
+     *
+     * @return external_function_parameters
+     * @since Moodle 5.2
+     */
+    public static function set_read_state_parameters() {
+        return new external_function_parameters([
+            'postid' => new external_value(PARAM_INT, 'The post id'),
+            'targetstate' => new external_value(PARAM_BOOL, 'True to set the post as read, false to set it as unread'),
+        ]);
+    }
+
+    /**
+     * Returns description of method result value.
+     *
+     * @return external_single_structure
+     * @since Moodle 5.2
+     */
+    public static function set_read_state_returns() {
+        return new external_single_structure([
+            'status' => new external_value(PARAM_BOOL, 'True if the read state was updated'),
+            'warnings' => new external_warnings(),
+        ]);
+    }
