+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace mod_forum\external;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once($CFG->dirroot . '/mod/forum/lib.php');
+
+use core_external\external_api;
+
+/**
+ * Tests for the set_read_state external function.
+ *
+ * @package    mod_forum
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \mod_forum\external\set_read_state
+ */
+final class set_read_state_test extends \core_external\tests\externallib_testcase {
+    /**
+     * Create a forum with a discussion and a reply, and an enrolled user.
+     *
+     * @param int $trackingtype
+     * @return array [user, forum, discussion, reply post]
+     */
+    private function create_fixture(int $trackingtype = FORUM_TRACKING_OPTIONAL): array {
+        $generator = self::getDataGenerator();
+        $user = $generator->create_user(['trackforums' => 1]);
+        $author = $generator->create_user();
+        $course = $generator->create_course();
+        $forum = $generator->create_module('forum', ['course' => $course->id, 'trackingtype' => $trackingtype]);
+        $generator->enrol_user($user->id, $course->id);
+        $generator->enrol_user($author->id, $course->id);
+        $forumgen = $generator->get_plugin_generator('mod_forum');
+        $discussion = $forumgen->create_discussion(['course' => $course->id, 'forum' => $forum->id, 'userid' => $author->id]);
+        $post = $forumgen->create_post(['discussion' => $discussion->id, 'parent' => $discussion->firstpost,
+            'userid' => $author->id]);
+        return [$user, $forum, $discussion, $post];
+    }
+
+    /**
+     * Test marking a post as read and unread.
+     */
+    public function test_execute(): void {
+        global $CFG, $DB;
+        $this->resetAfterTest();
+        $CFG->forum_usermarksread = 1;
+
+        [$user, $forum, , $post] = $this->create_fixture();
+        $this->setUser($user);
+
+        $result = set_read_state::execute($post->id, true);
+        $result = external_api::clean_returnvalue(set_read_state::execute_returns(), $result);
+        $this->assertTrue($DB->record_exists('forum_read', ['userid' => $user->id, 'postid' => $post->id]));
+        $this->assertEquals($post->id, $result['post']['id']);
+        $this->assertFalse($result['post']['unread']);
+        $this->assertTrue($result['post']['capabilities']['controlreadstatus']);
+
+        // Marking as read again must not fail.
+        set_read_state::execute($post->id, true);
+        $this->assertEquals(1, $DB->count_records('forum_read', ['userid' => $user->id, 'postid' => $post->id]));
+
+        $result = set_read_state::execute($post->id, false);
+        $result = external_api::clean_returnvalue(set_read_state::execute_returns(), $result);
+        $this->assertFalse($DB->record_exists('forum_read', ['userid' => $user->id, 'postid' => $post->id]));
+        $this->assertTrue($result['post']['unread']);
+    }
+
+    /**
+     * Test that the web service fails when manual mark as read is disabled.
+     */
+    public function test_execute_usermarksread_disabled(): void {
+        global $CFG;
+        $this->resetAfterTest();
+        $CFG->forum_usermarksread = 0;
+
+        [$user, , , $post] = $this->create_fixture();
+        $this->setUser($user);
+
+        $this->expectException(\moodle_exception::class);
+        $this->expectExceptionMessage(get_string('cannotcontrolreadstatus', 'forum'));
+        set_read_state::execute($post->id, true);
+    }
+
+    /**
+     * Test that the web service fails when the forum is not tracked.
+     */
+    public function test_execute_not_tracked(): void {
+        global $CFG;
+        $this->resetAfterTest();
+        $CFG->forum_usermarksread = 1;
+
+        [$user, , , $post] = $this->create_fixture(FORUM_TRACKING_OFF);
+        $this->setUser($user);
+
+        $this->expectException(\moodle_exception::class);
+        $this->expectExceptionMessage(get_string('cannotcontrolreadstatus', 'forum'));
+        set_read_state::execute($post->id, true);
+    }
+
+    /**
+     * Test that a user who cannot view the post cannot change its read state.
+     */
+    public function test_execute_not_enrolled(): void {
+        global $CFG;
+        $this->resetAfterTest();
+        $CFG->forum_usermarksread = 1;
+
+        [, , , $post] = $this->create_fixture();
+        $this->setUser(self::getDataGenerator()->create_user());
+
+        $this->expectException(\require_login_exception::class);
+        set_read_state::execute($post->id, true);
+    }
+}
