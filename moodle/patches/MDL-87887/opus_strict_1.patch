+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace mod_forum\external;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once($CFG->dirroot . '/mod/forum/lib.php');
+
+use core_external\external_api;
+
+/**
+ * Tests for the set_read_state external function.
+ *
+ * @package    mod_forum
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \mod_forum\external\set_read_state
+ */
+final class set_read_state_test extends \core_external\tests\externallib_testcase {
+    /**
+     * Create a forum with a post by another user.
+     *
+     * @param int $trackingtype
+     * @return array [user, forum, post]
+     */
+    private function setup_forum(int $trackingtype = FORUM_TRACKING_OPTIONAL): array {
+        $generator = self::getDataGenerator();
+        $user = $generator->create_user(['trackforums' => 1]);
+        $author = $generator->create_user();
+        $course = $generator->create_course();
+        $generator->enrol_user($user->id, $course->id);
+        $generator->enrol_user($author->id, $course->id);
+        $forum = $generator->create_module('forum', ['course' => $course->id, 'trackingtype' => $trackingtype]);
+        $forumgenerator = $generator->get_plugin_generator('mod_forum');
+        $discussion = $forumgenerator->create_discussion(
+            ['course' => $course->id, 'forum' => $forum->id, 'userid' => $author->id]
+        );
+        $post = $forumgenerator->create_post(
+            ['discussion' => $discussion->id, 'parent' => $discussion->firstpost, 'userid' => $author->id]
+        );
+        return [$user, $forum, $post];
+    }
+
+    /**
+     * Test marking a post as read and unread.
+     */
+    public function test_execute(): void {
+        global $CFG;
+        $this->resetAfterTest();
+        $CFG->forum_usermarksread = 1;
+
+        [$user, $forum, $post] = $this->setup_forum();
+        $this->setUser($user);
+        $this->assertTrue(forum_tp_is_tracked($forum));
+        $this->assertFalse(forum_tp_is_post_read($user->id, $post));
+
+        $result = external_api::clean_returnvalue(
+            set_read_state::execute_returns(),
+            set_read_state::execute($post->id, true),
+        );
+        $this->assertEquals($post->id, $result['id']);
+        $this->assertFalse($result['unread']);
+        $this->assertTrue(forum_tp_is_post_read($user->id, $post));
+
+        $result = external_api::clean_returnvalue(
+            set_read_state::execute_returns(),
+            set_read_state::execute($post->id, false),
+        );
+        $this->assertTrue($result['unread']);
+        $this->assertFalse(forum_tp_is_post_read($user->id, $post));
+    }
+
+    /**
+     * Test that the function fails when manual marking is disabled.
+     */
+    public function test_execute_usermarksread_disabled(): void {
+        global $CFG;
+        $this->resetAfterTest();
+        $CFG->forum_usermarksread = 0;
+
+        [$user, , $post] = $this->setup_forum();
+        $this->setUser($user);
+
+        $this->expectException(\moodle_exception::class);
+        set_read_state::execute($post->id, true);
+    }
+
+    /**
+     * Test that the function fails when the forum is not tracked.
+     */
+    public function test_execute_not_tracked(): void {
+        global $CFG;
+        $this->resetAfterTest();
+        $CFG->forum_usermarksread = 1;
+
+        [$user, , $post] = $this->setup_forum(FORUM_TRACKING_OFF);
+        $this->setUser($user);
+
+        $this->expectException(\moodle_exception::class);
+        set_read_state::execute($post->id, true);
+    }
+}
