+namespace mod_forum\external;
+
+use core_external\external_api;
+use core_external\external_function_parameters;
+use core_external\external_single_structure;
+use core_external\external_value;
+use mod_forum\local\exporters\post as post_exporter;
+
+/**
+ * Web Service to manually set the read state of a forum post.
+ *
+ * Only available when the users are allowed to manually mark posts as read (forum_usermarksread)
+ * and the forum is being tracked by the user.
+ *
+ * @package   mod_forum
+ * @category  external
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class set_read_state extends external_api {
+    /**
+     * Returns description of method parameters
+     *
+     * @return external_function_parameters
+     */
+    public static function execute_parameters(): external_function_parameters {
+        return new external_function_parameters(
+            [
+                'postid' => new external_value(PARAM_INT, 'The post id'),
+                'targetstate' => new external_value(PARAM_BOOL, 'The target state: true to mark as read, false to mark as unread'),
+            ]
+        );
+    }
+
+    /**
+     * Set the read state of a post.
+     *
+     * @param int $postid The post identifier.
+     * @param bool $targetstate True to mark the post as read, false to mark it as unread.
+     * @return \stdClass|array The exported post.
+     */
+    public static function execute(
+        int $postid,
+        bool $targetstate,
+    ): \stdClass|array {
+        global $CFG, $USER;
+        require_once($CFG->dirroot . '/mod/forum/lib.php');
+
+        $params = self::validate_parameters(self::execute_parameters(), [
+            'postid' => $postid,
+            'targetstate' => $targetstate,
+        ]);
+
+        $vaultfactory = \mod_forum\local\container::get_vault_factory();
+        $forumvault = $vaultfactory->get_forum_vault();
+        $discussionvault = $vaultfactory->get_discussion_vault();
+        $postvault = $vaultfactory->get_post_vault();
+
+        $postentity = $postvault->get_from_id($params['postid']);
+        if (empty($postentity)) {
+            throw new \moodle_exception('invalidpostid', 'forum');
+        }
+        $discussionentity = $discussionvault->get_from_id($postentity->get_discussion_id());
+        if (empty($discussionentity)) {
+            throw new \moodle_exception('notpartofdiscussion', 'forum');
+        }
+        $forumentity = $forumvault->get_from_id($discussionentity->get_forum_id());
+        if (empty($forumentity)) {
+            throw new \moodle_exception('invalidforumid', 'forum');
+        }
+
+        self::validate_context($forumentity->get_context());
+
+        $managerfactory = \mod_forum\local\container::get_manager_factory();
+        $capabilitymanager = $managerfactory->get_capability_manager($forumentity);
+
+        if (!$capabilitymanager->can_view_post($USER, $discussionentity, $postentity)) {
+            throw new \moodle_exception('noviewdiscussionspermission', 'forum');
+        }
+
+        $legacydatamapperfactory = \mod_forum\local\container::get_legacy_data_mapper_factory();
+        $forumrecord = $legacydatamapperfactory->get_forum_data_mapper()->to_legacy_object($forumentity);
+
+        if (
+            !forum_tp_can_track_forums($forumrecord) ||
+            !$capabilitymanager->can_manually_control_post_read_status($USER)
+        ) {
+            throw new \moodle_exception('cannotmarkpostreadstate', 'mod_forum');
+        }
+
+        if ($params['targetstate']) {
+            forum_tp_add_read_record($USER->id, $postentity->get_id());
+        } else {
+            forum_tp_delete_read_records($USER->id, $postentity->get_id());
+        }
+
+        $builderfactory = \mod_forum\local\container::get_builder_factory();
+        $postbuilder = $builderfactory->get_exported_posts_builder();
+        $posts = $postbuilder->build($USER, [$forumentity], [$discussionentity], [$postentity]);
+        if (empty($posts)) {
+            throw new \moodle_exception('noviewdiscussionspermission', 'forum');
+        }
+        return reset($posts);
+    }
+
+    /**
+     * Describe the return structure of the external service.
+     *
+     * @return external_single_structure
+     */
+    public static function execute_returns(): external_single_structure {
+        return post_exporter::get_read_structure();
+    }
+}
