diff --git a/public/mod/forum/tests/external/set_read_state_test.php b/public/mod/forum/tests/external/set_read_state_test.php
new file mode 100644
index 00000000000..a6c5a5bc285
--- /dev/null
+++ b/public/mod/forum/tests/external/set_read_state_test.php
@@ -0,0 +1,176 @@
+<?php
+// This file is part of Moodle - http://moodle.org/
+//
+// Moodle is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// Moodle is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace mod_forum\external;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once($CFG->dirroot . '/mod/forum/lib.php');
+
+use core_external\external_api;
+
+/**
+ * Tests for the set_read_state external function.
+ *
+ * @package    mod_forum
+ * @category   test
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \mod_forum\external\set_read_state
+ */
+final class set_read_state_test extends \core_external\tests\externallib_testcase {
+    /**
+     * Create a course, a tracked forum, a user enrolled in it and a post.
+     *
+     * @return array [$user, $forum, $post]
+     */
+    private function create_forum_with_post(): array {
+        global $CFG;
+
+        $CFG->forum_usermarksread = 1;
+
+        $user = self::getDataGenerator()->create_user(['trackforums' => 1]);
+        $course = self::getDataGenerator()->create_course();
+        self::getDataGenerator()->enrol_user($user->id, $course->id);
+        $forum = self::getDataGenerator()->create_module('forum', [
+            'course' => $course->id,
+            'trackingtype' => FORUM_TRACKING_OPTIONAL,
+        ]);
+
+        $generator = self::getDataGenerator()->get_plugin_generator('mod_forum');
+        $discussion = $generator->create_discussion([
+            'course' => $course->id,
+            'forum' => $forum->id,
+            'userid' => $user->id,
+        ]);
+        $post = $generator->create_post([
+            'discussion' => $discussion->id,
+            'userid' => $user->id,
+        ]);
+
+        return [$user, $forum, $post];
+    }
+
+    /**
+     * Test execute method.
+     *
+     * @dataProvider execute_provider
+     * @covers ::execute
+     *
+     * @param bool $initialstate Whether the post is initially read.
+     * @param bool $targetstate Target state of the post.
+     */
+    public function test_execute(bool $initialstate, bool $targetstate): void {
+        $this->resetAfterTest();
+
+        [$user, $forum, $post] = $this->create_forum_with_post();
+        $this->setUser($user);
+
+        if ($initialstate) {
+            forum_tp_add_read_record($user->id, $post->id);
+        }
+        $this->assertEquals($initialstate, forum_tp_is_post_read($user->id, $post));
+
+        $return = external_api::clean_returnvalue(
+            set_read_state::execute_returns(),
+            set_read_state::execute($post->id, $targetstate),
+        );
+
+        $this->assertEquals($post->id, $return['post']['id']);
+        $this->assertEquals(!$targetstate, $return['post']['unread']);
+        $this->assertTrue($return['post']['capabilities']['controlreadstatus']);
+        $this->assertEquals($targetstate, forum_tp_is_post_read($user->id, $post));
+    }
+
+    /**
+     * Data provider for test_execute.
+     *
+     * @return array
+     */
+    public static function execute_provider(): array {
+        return [
+            'Initially unread, set to read' => [
+                'initialstate' => false,
+                'targetstate' => true,
+            ],
+            'Initially read, set to unread' => [
+                'initialstate' => true,
+                'targetstate' => false,
+            ],
+            'Initially read, set to read' => [
+                'initialstate' => true,
+                'targetstate' => true,
+            ],
+            'Initially unread, set to unread' => [
+                'initialstate' => false,
+                'targetstate' => false,
+            ],
+        ];
+    }
+
+    /**
+     * Test execute throws an exception when manual read marking is disabled.
+     *
+     * @covers ::execute
+     */
+    public function test_execute_manual_marking_disabled(): void {
+        global $CFG;
+
+        $this->resetAfterTest();
+
+        [$user, $forum, $post] = $this->create_forum_with_post();
+        $this->setUser($user);
+        $CFG->forum_usermarksread = 0;
+
+        $this->expectException(\moodle_exception::class);
+        $this->expectExceptionMessage(get_string('cannotcontrolreadstatus', 'forum'));
+        set_read_state::execute($post->id, true);
+    }
+
+    /**
+     * Test execute throws an exception when the forum is not tracked by the user.
+     *
+     * @covers ::execute
+     */
+    public function test_execute_forum_not_tracked(): void {
+        $this->resetAfterTest();
+
+        [$user, $forum, $post] = $this->create_forum_with_post();
+        $this->setUser($user);
+        forum_tp_stop_tracking($forum->id, $user->id);
+        \cache::make('mod_forum', 'forum_is_tracked')->purge();
+
+        $this->expectException(\moodle_exception::class);
+        $this->expectExceptionMessage(get_string('cannotcontrolreadstatus', 'forum'));
+        set_read_state::execute($post->id, true);
+    }
+
+    /**
+     * Test execute throws an exception for an invalid post.
+     *
+     * @covers ::execute
+     */
+    public function test_execute_invalid_post(): void {
+        $this->resetAfterTest();
+
+        [$user] = $this->create_forum_with_post();
+        $this->setUser($user);
+
+        $this->expectException(\moodle_exception::class);
+        set_read_state::execute(-1, true);
+    }
+}
