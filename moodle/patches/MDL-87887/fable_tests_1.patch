diff --git a/public/mod/forum/tests/external/set_read_state_test.php b/public/mod/forum/tests/external/set_read_state_test.php
new file mode 100644
index 00000000000..3f4fd8319cc
--- /dev/null
+++ b/public/mod/forum/tests/external/set_read_state_test.php
@@ -0,0 +1,209 @@
+<?php
+// This file is part of Moodle - http://moodle.org/
+//
+// Moodle is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// Moodle is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace mod_forum\external;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once($CFG->dirroot . '/mod/forum/lib.php');
+
+use core_external\external_api;
+
+/**
+ * Tests for the set_read_state external function.
+ *
+ * @package    mod_forum
+ * @category   test
+ * @copyright  2025 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \mod_forum\external\set_read_state
+ */
+final class set_read_state_test extends \core_external\tests\externallib_testcase {
+    /**
+     * Create a course, a tracked forum, a discussion and a post, and return the relevant records.
+     *
+     * @param bool $usermarksread Value for the forum_usermarksread site setting.
+     * @param int $trackforums Whether the user tracks forums.
+     * @param int $trackingtype Tracking type for the forum.
+     * @return array The user, forum, discussion and post records.
+     */
+    private function setup_scenario(
+        bool $usermarksread = true,
+        int $trackforums = 1,
+        int $trackingtype = FORUM_TRACKING_FORCED,
+    ): array {
+        global $CFG, $DB;
+
+        $CFG->forum_usermarksread = $usermarksread;
+        $CFG->forum_allowforcedreadtracking = 1;
+
+        $course = self::getDataGenerator()->create_course();
+        $forum = self::getDataGenerator()->create_module('forum', [
+            'course' => $course->id,
+            'trackingtype' => $trackingtype,
+        ]);
+        $user = self::getDataGenerator()->create_user(['trackforums' => $trackforums]);
+        self::getDataGenerator()->enrol_user($user->id, $course->id, 'student');
+
+        $generator = self::getDataGenerator()->get_plugin_generator('mod_forum');
+        $record = new \stdClass();
+        $record->course = $course->id;
+        $record->userid = $user->id;
+        $record->forum = $forum->id;
+        $discussion = $generator->create_discussion($record);
+        $parentpost = $DB->get_record('forum_posts', ['discussion' => $discussion->id]);
+
+        $record = new \stdClass();
+        $record->course = $course->id;
+        $record->userid = $user->id;
+        $record->forum = $forum->id;
+        $record->discussion = $discussion->id;
+        $record->parent = $parentpost->id;
+        $post = $generator->create_post($record);
+
+        $this->setUser($user);
+
+        return [$user, $forum, $discussion, $post];
+    }
+
+    /**
+     * Test execute method.
+     *
+     * @dataProvider execute_provider
+     * @covers ::execute
+     *
+     * @param bool|null $initialstate Initial read state, null means no initial state (unread).
+     * @param bool $targetstate Expected target read state.
+     */
+    public function test_execute(?bool $initialstate, bool $targetstate): void {
+        $this->resetAfterTest();
+
+        [$user, $forum, $discussion, $post] = $this->setup_scenario();
+
+        if ($initialstate !== null) {
+            if ($initialstate) {
+                forum_tp_add_read_record($user->id, $post->id);
+            } else {
+                forum_tp_delete_read_records($user->id, $post->id);
+            }
+            $this->assertEquals($initialstate, forum_tp_is_post_read($user->id, $post));
+        }
+
+        $return = external_api::clean_returnvalue(
+            set_read_state::execute_returns(),
+            set_read_state::execute($post->id, $targetstate),
+        );
+
+        $this->assertEquals($post->id, $return['id']);
+        $this->assertEquals(!$targetstate, $return['unread']);
+        $this->assertTrue($return['capabilities']['controlreadstatus']);
+        $this->assertEquals($targetstate, forum_tp_is_post_read($user->id, $post));
+    }
+
+    /**
+     * Data provider for test_execute.
+     *
+     * @return array The data provider array.
+     */
+    public static function execute_provider(): array {
+        return [
+            'No initial state, set to read' => [
+                'initialstate' => null,
+                'targetstate' => true,
+            ],
+            'No initial state, set to unread' => [
+                'initialstate' => null,
+                'targetstate' => false,
+            ],
+            'Initially unread, set to read' => [
+                'initialstate' => false,
+                'targetstate' => true,
+            ],
+            'Initially read, set to unread' => [
+                'initialstate' => true,
+                'targetstate' => false,
+            ],
+            'Initially read, set to read' => [
+                'initialstate' => true,
+                'targetstate' => true,
+            ],
+        ];
+    }
+
+    /**
+     * Test execute method when the user is not allowed to manually mark posts as read.
+     *
+     * @covers ::execute
+     */
+    public function test_execute_usermarksread_disabled(): void {
+        $this->resetAfterTest();
+
+        [, , , $post] = $this->setup_scenario(usermarksread: false);
+
+        $this->expectException(\moodle_exception::class);
+        $this->expectExceptionMessage(get_string('cannotmanuallymarkread', 'mod_forum'));
+        set_read_state::execute($post->id, true);
+    }
+
+    /**
+     * Test execute method when the forum is not tracked by the user.
+     *
+     * @covers ::execute
+     */
+    public function test_execute_not_tracked(): void {
+        $this->resetAfterTest();
+
+        [$user, $forum, , $post] = $this->setup_scenario(trackforums: 0, trackingtype: FORUM_TRACKING_OPTIONAL);
+        $this->assertFalse(forum_tp_is_tracked($forum, $user));
+
+        $this->expectException(\moodle_exception::class);
+        $this->expectExceptionMessage(get_string('cannotmanuallymarkread', 'mod_forum'));
+        set_read_state::execute($post->id, true);
+    }
+
+    /**
+     * Test execute method with an invalid post id.
+     *
+     * @covers ::execute
+     */
+    public function test_execute_invalid_post(): void {
+        $this->resetAfterTest();
+
+        $this->setup_scenario();
+
+        $this->expectException(\moodle_exception::class);
+        set_read_state::execute(-1, true);
+    }
+
+    /**
+     * Test execute method when the user cannot view the post.
+     *
+     * @covers ::execute
+     */
+    public function test_execute_cannot_view_post(): void {
+        $this->resetAfterTest();
+
+        [, , , $post] = $this->setup_scenario();
+
+        // A user not enrolled in the course cannot view the post.
+        $otheruser = self::getDataGenerator()->create_user(['trackforums' => 1]);
+        $this->setUser($otheruser);
+
+        $this->expectException(\moodle_exception::class);
+        set_read_state::execute($post->id, true);
+    }
+}
