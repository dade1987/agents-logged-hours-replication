+namespace mod_forum\external;
+
+use core_external\external_api;
+use core_external\external_function_parameters;
+use core_external\external_single_structure;
+use core_external\external_value;
+use mod_forum\local\exporters\post as post_exporter;
+
+/**
+ * Web Service to manually set the read state of a forum post.
+ *
+ * This is only possible when the site setting "forum_usermarksread" is enabled and
+ * the forum is being tracked by the user.
+ *
+ * @package   mod_forum
+ * @category  external
+ * @copyright 2025 Moodle
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class set_read_state extends external_api {
+    /**
+     * Returns description of method parameters
+     *
+     * @return external_function_parameters
+     */
+    public static function execute_parameters(): external_function_parameters {
+        return new external_function_parameters(
+            [
+                'postid' => new external_value(PARAM_INT, 'The post id'),
+                'targetstate' => new external_value(PARAM_BOOL, 'The target state: true to mark as read, false as unread'),
+            ]
+        );
+    }
+
+    /**
+     * Set the read state of a post for the current user.
+     *
+     * @param int $postid The post identifier.
+     * @param bool $targetstate Whether to mark the post as read (true) or unread (false).
+     * @return \stdClass The exported post.
+     */
+    public static function execute(
+        int $postid,
+        bool $targetstate,
+    ): \stdClass {
+        global $CFG, $USER;
+
+        require_once($CFG->dirroot . '/mod/forum/lib.php');
+
+        $params = self::validate_parameters(self::execute_parameters(), [
+            'postid' => $postid,
+            'targetstate' => $targetstate,
+        ]);
+
+        $vaultfactory = \mod_forum\local\container::get_vault_factory();
+        $forumvault = $vaultfactory->get_forum_vault();
+        $discussionvault = $vaultfactory->get_discussion_vault();
+        $postvault = $vaultfactory->get_post_vault();
+
+        $post = $postvault->get_from_id($params['postid']);
+        if (empty($post)) {
+            throw new \moodle_exception('invalidpostid', 'mod_forum', '', $params['postid']);
+        }
+        $discussion = $discussionvault->get_from_id($post->get_discussion_id());
+        if (empty($discussion)) {
+            throw new \moodle_exception('notpartofdiscussion', 'mod_forum');
+        }
+        $forum = $forumvault->get_from_id($discussion->get_forum_id());
+        if (empty($forum)) {
+            throw new \moodle_exception('invalidforumid', 'mod_forum');
+        }
+
+        self::validate_context($forum->get_context());
+
+        $managerfactory = \mod_forum\local\container::get_manager_factory();
+        $capabilitymanager = $managerfactory->get_capability_manager($forum);
+
+        if (!$capabilitymanager->can_view_post($USER, $discussion, $post)) {
+            throw new \moodle_exception('noviewdiscussionspermission', 'mod_forum');
+        }
+
+        $legacydatamapperfactory = \mod_forum\local\container::get_legacy_data_mapper_factory();
+        $forumrecord = $legacydatamapperfactory->get_forum_data_mapper()->to_legacy_object($forum);
+
+        if (
+            !$capabilitymanager->can_manually_control_post_read_status($USER)
+            || !forum_tp_can_track_forums($forumrecord, $USER)
+        ) {
+            // The user is not allowed to manually control the read status of the posts in this forum.
+            throw new \moodle_exception('cannotmanuallymarkread', 'mod_forum');
+        }
+
+        if ($params['targetstate']) {
+            forum_tp_add_read_record($USER->id, $post->get_id());
+        } else {
+            forum_tp_delete_read_records($USER->id, $post->get_id());
+        }
+
+        $builderfactory = \mod_forum\local\container::get_builder_factory();
+        $postbuilder = $builderfactory->get_exported_posts_builder();
+        $exportedposts = $postbuilder->build($USER, [$forum], [$discussion], [$post]);
+
+        return reset($exportedposts);
+    }
+
+    /**
+     * Describe the return structure of the external service.
+     *
+     * @return external_single_structure
+     */
+    public static function execute_returns(): external_single_structure {
+        return post_exporter::get_read_structure();
+    }
+}
