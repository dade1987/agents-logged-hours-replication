+        $this->assertEquals(
+            (new \moodle_url('/blog/index.php', ['userid' => $USER->id]))->out(false),
+            $nodes['blogs']->url->out(false)
+        );
+
+        // The site blog link points to the site-wide blog listing.
+        $this->assertEquals(get_string('myprofilesiteblogs', 'core_blog'), $nodes['siteblogs']->title);
+        $this->assertEquals((new \moodle_url('/blog/index.php'))->out(false), $nodes['siteblogs']->url->out(false));
+        $this->assertEquals('miscellaneous', $nodes['siteblogs']->parentcat);
+    }
+
+    /**
+     * Tests the core_blog_myprofile_navigation() function when viewing another user's profile.
+     */
+    public function test_core_blog_myprofile_navigation_other_user(): void {
+        $this->setAdminUser();
+        set_config('enableblogs', true);
+        $user = $this->getDataGenerator()->create_user();
+        $course = $this->getDataGenerator()->create_course();
+
+        $tree = new \core_user\output\myprofile\tree();
+        core_blog_myprofile_navigation($tree, $user, false, $course);
+        $reflector = new \ReflectionObject($tree);
+        $nodes = $reflector->getProperty('nodes')->getValue($tree);
+
+        $this->assertArrayHasKey('blogs', $nodes);
+        $this->assertArrayHasKey('siteblogs', $nodes);
+        $this->assertEquals(get_string('myprofileuserblogs', 'core_blog'), $nodes['blogs']->title);
+        $this->assertEquals(
+            (new \moodle_url('/blog/index.php', ['userid' => $user->id, 'courseid' => $course->id]))->out(false),
+            $nodes['blogs']->url->out(false)
+        );
+        $this->assertEquals((new \moodle_url('/blog/index.php'))->out(false), $nodes['siteblogs']->url->out(false));
     }
 
