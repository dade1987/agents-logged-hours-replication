+
+        // The personal blog link points to the user's own blog entries.
+        $this->assertEquals(get_string('viewmyblogentries', 'core_blog'), $nodes['blogs']->title);
+        $this->assertEquals(
+            (new \moodle_url('/blog/index.php', ['userid' => $USER->id]))->out(false),
+            $nodes['blogs']->url->out(false)
+        );
+
+        // The site blog link points to the site-wide blog entries.
+        $this->assertEquals(get_string('viewsiteblogentries', 'core_blog'), $nodes['siteblogs']->title);
+        $this->assertEquals(
+            (new \moodle_url('/blog/index.php'))->out(false),
+            $nodes['siteblogs']->url->out(false)
+        );
     }
 
