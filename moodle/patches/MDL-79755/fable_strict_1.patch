diff --git a/public/blocks/myoverview/tests/behat/block_myoverview_dashboard.feature b/public/blocks/myoverview/tests/behat/block_myoverview_dashboard.feature
index ac27b707d9c..29a317666af 100644
--- a/public/blocks/myoverview/tests/behat/block_myoverview_dashboard.feature
+++ b/public/blocks/myoverview/tests/behat/block_myoverview_dashboard.feature
@@ -389,3 +389,20 @@ Feature: The my overview block allows users to easily access their courses
   Scenario: The My courses page must meet accessibility standards
     When I am on the "My courses" page logged in as "student1"
     Then the page should meet accessibility standards with "best-practice" extra tests
+
+  Scenario: Course names containing special characters are displayed without double encoding
+    Given the following "courses" exist:
+      | fullname           | shortname | category |
+      | Course & 'Friends' | C6        | 0        |
+    And the following "course enrolments" exist:
+      | user     | course | role    |
+      | student1 | C6     | student |
+    And I am on the "My courses" page logged in as "student1"
+    And I click on "All" "button" in the "Course overview" "block"
+    When I click on "All" "link" in the "Course overview" "block"
+    Then I should see "Course & 'Friends'" in the "Course overview" "block"
+    And I should not see "&amp;" in the "Course overview" "block"
+    And I should not see "&#039;" in the "Course overview" "block"
+    And I click on ".coursemenubtn" "css_element" in the "//div[contains(@class, 'course-card') and contains(.,\"Course & 'Friends'\")]" "xpath_element"
+    And "Remove Course & 'Friends' from view" "text" should exist in the "Course overview" "block"
+    And "Remove Course &amp; &#039;Friends&#039; from view" "text" should not exist in the "Course overview" "block"
