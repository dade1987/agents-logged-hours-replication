--- a/public/course/tests/externallib_test.php
+++ b/public/course/tests/externallib_test.php
@@ -3881,6 +3881,47 @@ final class externallib_test extends \core_external\tests\externallib_testcase {
         $this->assertEquals($expectednextoffset, $result['nextoffset']);
     }
 
+    /**
+     * Test that the course name fields returned by get_enrolled_courses_by_timeline_classification
+     * are formatted (and therefore HTML encoded) exactly once.
+     *
+     * @covers ::get_enrolled_courses_by_timeline_classification
+     */
+    public function test_get_enrolled_courses_by_timeline_classification_name_encoding(): void {
+        $this->resetAfterTest();
+        $generator = $this->getDataGenerator();
+
+        $fullname = 'Statistical & "Computational" <Tools>';
+        $shortname = 'S&CT';
+        $course = $generator->create_course(['fullname' => $fullname, 'shortname' => $shortname]);
+
+        $student = $generator->create_user();
+        $generator->enrol_user($student->id, $course->id, 'student');
+        $this->setUser($student);
+
+        $result = core_course_external::get_enrolled_courses_by_timeline_classification('all');
+        $result = external_api::clean_returnvalue(
+            core_course_external::get_enrolled_courses_by_timeline_classification_returns(),
+            $result
+        );
+
+        $this->assertCount(1, $result['courses']);
+        $exported = reset($result['courses']);
+        $context = context_course::instance($course->id);
+
+        // The names must be encoded exactly once (as format_string does), never double encoded.
+        $this->assertEquals(\core_external\util::format_string($fullname, $context), $exported['fullname']);
+        $this->assertEquals(
+            \core_external\util::format_string(get_course_display_name_for_list($course), $context),
+            $exported['fullnamedisplay']
+        );
+        $this->assertEquals(\core_external\util::format_string($shortname, $context), $exported['shortname']);
+        $this->assertStringContainsString('&amp;', $exported['fullname']);
+        $this->assertStringNotContainsString('&amp;amp;', $exported['fullname']);
+        $this->assertStringNotContainsString('&amp;amp;', $exported['fullnamedisplay']);
+        $this->assertStringNotContainsString('&amp;amp;', $exported['shortname']);
+    }
+
     /**
      * Test the get_recent_courses function.
      */
