+namespace core\check;
+
+/**
+ * Unit tests for the check results table.
+ *
+ * @package    core
+ * @category   check
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \core\check\table
+ */
+final class table_test extends \advanced_testcase {
+    /**
+     * Build a check returning a single result of the given status with details.
+     *
+     * @param string $status
+     * @param string $details
+     * @return check
+     */
+    private function make_check(string $status, string $details): check {
+        return new class($status, $details) extends check {
+            /** @var string */
+            private string $status;
+            /** @var string */
+            private string $details;
+
+            /**
+             * Constructor.
+             *
+             * @param string $status
+             * @param string $details
+             */
+            public function __construct(string $status, string $details) {
+                $this->status = $status;
+                $this->details = $details;
+            }
+
+            /**
+             * Get the name.
+             *
+             * @return string
+             */
+            public function get_name(): string {
+                return 'Test check';
+            }
+
+            /**
+             * Get the result.
+             *
+             * @return result
+             */
+            public function get_result(): result {
+                return new result($this->status, 'Summary text', $this->details);
+            }
+        };
+    }
+
+    /**
+     * Run the detail page for a check and capture the streamed output.
+     *
+     * @param check $check
+     * @return string
+     */
+    private function run_detail_page(check $check): string {
+        global $OUTPUT;
+
+        $table = new table('security', new \moodle_url('/report/security/index.php'));
+        $table->checks = [$check];
+        $table->detail = $check;
+
+        ob_start();
+        $table->run_checks($OUTPUT);
+        return ob_get_clean();
+    }
+
+    /**
+     * Data provider for test_details_shown_for_all_statuses.
+     *
+     * @return array
+     */
+    public static function status_provider(): array {
+        return [
+            'ok' => [result::OK],
+            'info' => [result::INFO],
+            'warning' => [result::WARNING],
+            'error' => [result::ERROR],
+            'critical' => [result::CRITICAL],
+            'na' => [result::NA],
+        ];
+    }
+
+    /**
+     * Details should always be shown on the detail page, regardless of status.
+     *
+     * @dataProvider status_provider
+     * @param string $status
+     */
+    public function test_details_shown_for_all_statuses(string $status): void {
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $details = 'Unique details text ' . $status;
+        $output = $this->run_detail_page($this->make_check($status, $details));
+
+        $this->assertStringContainsString($details, $output);
+        $this->assertStringContainsString("#checkdetails'", $output);
+        $this->assertStringNotContainsString('#checkdetailscontainer', $output);
+    }
+
+    /**
+     * When a result has no details the details container should be removed.
+     */
+    public function test_details_removed_when_empty(): void {
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $output = $this->run_detail_page($this->make_check(result::OK, ''));
+
+        $this->assertStringContainsString('#checkdetailscontainer', $output);
+    }
+}
