diff --git a/public/lib/tests/csvclass_test.php b/public/lib/tests/csvclass_test.php
index fa45977d193..c6542ca068a 100644
--- a/public/lib/tests/csvclass_test.php
+++ b/public/lib/tests/csvclass_test.php
@@ -150,4 +150,30 @@ final class csvclass_test extends \advanced_testcase {
         // Five lines including the headings should be imported.
         $this->assertEquals($contentcount, 5);
     }
+
+    /**
+     * Test that importing CSV content does not escape values that look like spreadsheet formulas.
+     */
+    public function test_load_csv_content_does_not_escape_formulas(): void {
+        $content = "lastname;firstname;username;email;password\n" .
+            "Testy;Testx;test25@example.com;test25@example.com;@ChangeMe!\n" .
+            "-Minus;+Plus;=equals;user@example.com;-\n";
+
+        $iid = csv_import_reader::get_new_iid('lib');
+        $csvimport = new csv_import_reader($iid, 'lib');
+        $this->assertSame(3, $csvimport->load_csv_content($content, 'utf-8', 'semicolon'));
+        $csvimport->init();
+        $dataset = [$csvimport->get_columns()];
+        while ($record = $csvimport->next()) {
+            $dataset[] = $record;
+        }
+        $csvimport->cleanup();
+        $csvimport->close();
+
+        $this->assertSame([
+            ['lastname', 'firstname', 'username', 'email', 'password'],
+            ['Testy', 'Testx', 'test25@example.com', 'test25@example.com', '@ChangeMe!'],
+            ['-Minus', '+Plus', '=equals', 'user@example.com', '-'],
+        ], $dataset);
+    }
 }
