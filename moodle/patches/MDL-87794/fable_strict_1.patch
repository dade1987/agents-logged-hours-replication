diff --git a/public/lib/tests/csvclass_test.php b/public/lib/tests/csvclass_test.php
index fa45977d193..7b59f4f2e12 100644
--- a/public/lib/tests/csvclass_test.php
+++ b/public/lib/tests/csvclass_test.php
@@ -150,4 +150,68 @@ final class csvclass_test extends \advanced_testcase {
         // Five lines including the headings should be imported.
         $this->assertEquals($contentcount, 5);
     }
+
+    /**
+     * Test that values which look like spreadsheet formulas are escaped on export, but not altered on import.
+     *
+     * @covers \csv_export_writer::add_data
+     * @covers \csv_export_writer::set_escape_formulas
+     * @covers \csv_export_writer::print_array
+     * @covers \csv_import_reader::load_csv_content
+     */
+    public function test_csv_formula_escaping(): void {
+        $data = [
+            ['username', 'password', 'note'],
+            ['test25@example.com', '@ChangeMe!', '=SUM(A1:A2)'],
+            ['other', '+1234', '-'],
+        ];
+
+        // Export (download) escapes formula-like values by default.
+        $exported = csv_export_writer::print_array($data, 'comma', '"', true);
+        $expected = "username,password,note\n" .
+            "test25@example.com,'@ChangeMe!,'=SUM(A1:A2)\n" .
+            "other,'+1234,-\n";
+        $this->assertSame($expected, $exported);
+
+        // Escaping can be explicitly disabled.
+        $unescaped = csv_export_writer::print_array($data, 'comma', '"', true, false);
+        $expectedunescaped = "username,password,note\n" .
+            "test25@example.com,@ChangeMe!,=SUM(A1:A2)\n" .
+            "other,+1234,-\n";
+        $this->assertSame($expectedunescaped, $unescaped);
+
+        $writer = new csv_export_writer();
+        $writer->set_escape_formulas(false);
+        foreach ($data as $row) {
+            $writer->add_data($row);
+        }
+        $this->assertSame($expectedunescaped, $writer->print_csv_data(true));
+
+        // Import must return the data exactly as it was in the uploaded file.
+        $iid = csv_import_reader::get_new_iid('lib');
+        $csvimport = new csv_import_reader($iid, 'lib');
+        $csvimport->load_csv_content($unescaped, 'utf-8', 'comma');
+        $this->assertNull($csvimport->get_error());
+        $csvimport->init();
+        $dataset = [];
+        $dataset[] = $csvimport->get_columns();
+        while ($record = $csvimport->next()) {
+            $dataset[] = $record;
+        }
+        $csvimport->cleanup();
+        $csvimport->close();
+        $this->assertSame($data, $dataset);
+
+        // Also when using the semicolon delimiter as in the reported scenario.
+        $content = "lastname;firstname;username;email;password\n" .
+            "Testy;Testx;test25@example.com;test25@example.com;@ChangeMe!\n";
+        $iid = csv_import_reader::get_new_iid('lib');
+        $csvimport = new csv_import_reader($iid, 'lib');
+        $csvimport->load_csv_content($content, 'utf-8', 'semicolon');
+        $csvimport->init();
+        $record = $csvimport->next();
+        $csvimport->cleanup();
+        $csvimport->close();
+        $this->assertSame(['Testy', 'Testx', 'test25@example.com', 'test25@example.com', '@ChangeMe!'], $record);
+    }
 }
