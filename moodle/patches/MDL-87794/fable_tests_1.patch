diff --git a/public/lib/tests/csvclass_test.php b/public/lib/tests/csvclass_test.php
index fa45977d193..5c93cdba5c6 100644
--- a/public/lib/tests/csvclass_test.php
+++ b/public/lib/tests/csvclass_test.php
@@ -150,4 +150,41 @@ final class csvclass_test extends \advanced_testcase {
         // Five lines including the headings should be imported.
         $this->assertEquals($contentcount, 5);
     }
+
+    /**
+     * Test that values starting with spreadsheet formula characters are escaped on export only.
+     *
+     * Imported values must be returned unmodified, while exported values must be escaped.
+     */
+    public function test_formula_escaping(): void {
+        $content = "lastname;firstname;username;email;password\n" .
+            "Testy;Testx;test25@example.com;test25@example.com;@ChangeMe!\n" .
+            "=SUM(A1);+1;-2;@at; =leading";
+
+        // Importing must not modify the values.
+        $iid = csv_import_reader::get_new_iid('lib');
+        $csvimport = new csv_import_reader($iid, 'lib');
+        $this->assertEquals(3, $csvimport->load_csv_content($content, 'utf-8', 'semicolon'));
+        $csvimport->init();
+        $this->assertSame(['lastname', 'firstname', 'username', 'email', 'password'], $csvimport->get_columns());
+        $this->assertSame(['Testy', 'Testx', 'test25@example.com', 'test25@example.com', '@ChangeMe!'], $csvimport->next());
+        $this->assertSame(['=SUM(A1)', '+1', '-2', '@at', ' =leading'], $csvimport->next());
+        $this->assertFalse($csvimport->next());
+        $csvimport->cleanup();
+        $csvimport->close();
+
+        // Exporting must escape the values by default.
+        $data = [['=SUM(A1)', '+1', '-2', '@at', ' =leading', '-', 'plain']];
+        $expected = "'=SUM(A1),'+1,'-2,'@at,\"' =leading\",-,plain\n";
+        $this->assertSame($expected, csv_export_writer::print_array($data, 'comma', '"', true));
+
+        // Exporting with escaping disabled must leave the values unmodified.
+        $expected = "=SUM(A1),+1,-2,@at,\" =leading\",-,plain\n";
+        $this->assertSame($expected, csv_export_writer::print_array($data, 'comma', '"', true, false));
+
+        $csvexport = new csv_export_writer();
+        $csvexport->set_escape_formulas(false);
+        $csvexport->add_data($data[0]);
+        $this->assertSame($expected, $csvexport->print_csv_data(true));
+    }
 }
