diff --git a/public/lib/tests/csvclass_test.php b/public/lib/tests/csvclass_test.php
index fa45977d193..bf30cfbae01 100644
--- a/public/lib/tests/csvclass_test.php
+++ b/public/lib/tests/csvclass_test.php
@@ -150,4 +150,37 @@ final class csvclass_test extends \advanced_testcase {
         // Five lines including the headings should be imported.
         $this->assertEquals($contentcount, 5);
     }
+    /**
+     * Test that importing CSV content does not escape values that look like spreadsheet formulas.
+     */
+    public function test_csv_import_does_not_escape_formulas(): void {
+        $content = "lastname;firstname;username;email;password\n" .
+            "Testy;Testx;test25@example.com;test25@example.com;@ChangeMe!\n" .
+            "=1+2;+foo;-bar;\tbaz;=HYPERLINK(\"x\")\n";
+
+        $iid = csv_import_reader::get_new_iid('formula');
+        $csvimport = new csv_import_reader($iid, 'formula');
+        $this->assertEquals(3, $csvimport->load_csv_content($content, 'utf-8', 'semicolon'));
+        $csvimport->init();
+        $records = [];
+        while ($record = $csvimport->next()) {
+            $records[] = $record;
+        }
+        $csvimport->cleanup();
+        $csvimport->close();
+
+        $this->assertSame([
+            ['Testy', 'Testx', 'test25@example.com', 'test25@example.com', '@ChangeMe!'],
+            ['=1+2', '+foo', '-bar', "\tbaz", '=HYPERLINK("x")'],
+        ], $records);
+    }
+
+    /**
+     * Test that the CSV export writer escapes formulas by default, and that it can be disabled.
+     */
+    public function test_csv_export_formula_escaping(): void {
+        $records = [['@ChangeMe!', '=1+2']];
+        $this->assertSame("'@ChangeMe!,'=1+2\n", csv_export_writer::print_array($records, 'comma', '"', true));
+        $this->assertSame("@ChangeMe!,=1+2\n", csv_export_writer::print_array($records, 'comma', '"', true, false));
+    }
 }
