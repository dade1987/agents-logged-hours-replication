+    /**
+     * Test that quizzes can be created and updated by third-party code that does not supply a duedate.
+     *
+     * @covers ::quiz_add_instance
+     * @covers ::quiz_update_instance
+     * @covers ::quiz_process_options
+     */
+    public function test_quiz_add_and_update_instance_without_duedate(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $dg = $this->getDataGenerator();
+        $quizgen = $dg->get_plugin_generator('mod_quiz');
+        $course = $dg->create_course();
+
+        // Create a quiz the normal way, to get a complete record to base the data on.
+        $quiz = $quizgen->create_instance(['course' => $course->id, 'duedate' => time() + DAYSECS]);
+
+        // Update the quiz with data that does not include the duedate.
+        $data = $DB->get_record('quiz', ['id' => $quiz->id]);
+        $data->instance = $quiz->id;
+        $data->coursemodule = $quiz->cmid;
+        $data->quizpassword = $data->password;
+        $data->name = 'Updated without duedate';
+        unset($data->duedate);
+
+        $this->assertTrue(quiz_update_instance($data, null));
+        $this->assertDebuggingNotCalled();
+
+        $updated = $DB->get_record('quiz', ['id' => $quiz->id]);
+        $this->assertEquals('Updated without duedate', $updated->name);
+        $this->assertEquals(0, $updated->duedate);
+        $this->assertEquals(0, $DB->count_records('event',
+                ['modulename' => 'quiz', 'instance' => $quiz->id, 'eventtype' => QUIZ_EVENT_TYPE_DUE]));
+
+        // Add a new quiz with data that does not include the duedate.
+        $module = $DB->get_record('modules', ['name' => 'quiz'], '*', MUST_EXIST);
+        $newcm = (object) [
+            'course' => $course->id,
+            'module' => $module->id,
+            'modulename' => 'quiz',
+            'section' => 0,
+            'visible' => 1,
+            'visibleoncoursepage' => 1,
+        ];
+        $newcm->id = add_course_module($newcm);
+        course_add_cm_to_section($course->id, $newcm->id, 0);
+
+        $data = $DB->get_record('quiz', ['id' => $quiz->id]);
+        unset($data->id, $data->duedate);
+        $data->coursemodule = $newcm->id;
+        $data->quizpassword = $data->password;
+        $data->name = 'Added without duedate';
+
+        $newquizid = quiz_add_instance($data);
+        $this->assertDebuggingNotCalled();
+        $this->assertIsInt($newquizid);
+
+        $added = $DB->get_record('quiz', ['id' => $newquizid]);
+        $this->assertEquals('Added without duedate', $added->name);
+        $this->assertEquals(0, $added->duedate);
+    }
+
