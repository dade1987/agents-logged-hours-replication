+    /**
+     * Test that grades are read only in workflow states that are not available to the grader.
+     *
+     * @covers ::grading_disabled
+     * @covers ::update_grade
+     */
+    public function test_grading_disabled_in_unavailable_workflow_state(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $course = $this->getDataGenerator()->create_course();
+        $teacher = $this->getDataGenerator()->create_and_enrol($course, 'editingteacher');
+        $student = $this->getDataGenerator()->create_and_enrol($course, 'student');
+
+        // Create a grader role which can grade, but cannot review, release or manage grades.
+        $graderroleid = $this->getDataGenerator()->create_role(['shortname' => 'grader']);
+        $context = \context_course::instance($course->id);
+        assign_capability('mod/assign:view', CAP_ALLOW, $graderroleid, $context->id);
+        assign_capability('mod/assign:viewgrades', CAP_ALLOW, $graderroleid, $context->id);
+        assign_capability('mod/assign:grade', CAP_ALLOW, $graderroleid, $context->id);
+        $grader = $this->getDataGenerator()->create_and_enrol($course, 'grader');
+
+        $assign = $this->create_instance($course, [
+            'markingworkflow' => 1,
+        ]);
+
+        // The list of workflow states available to the current user is cached in the assign instance,
+        // so use a separate instance for each user.
+        $newinstance = function () use ($assign, $course): \mod_assign_testable_assign {
+            return new \mod_assign_testable_assign($assign->get_context(), $assign->get_course_module(), $course);
+        };
+        $teacherassign = $newinstance();
+        $graderassign = $newinstance();
+
+        $this->add_submission($student, $assign);
+        $this->submit_for_grading($student, $assign);
+
+        // The grader can grade while there is no workflow state.
+        $this->setUser($grader);
+        $this->assertFalse($graderassign->grading_disabled($student->id));
+
+        // The teacher grades the submission and releases the grade.
+        $this->grade_submission($teacher, $teacherassign, $student, 50.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_RELEASED,
+        ]);
+        $flags = $assign->get_user_flags($student->id, false);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_RELEASED, $flags->workflowstate);
+        $grade = $assign->get_user_grade($student->id, false);
+        $this->assertEquals(50, (int) $grade->grade);
+
+        // The grade is read only for the grader, because "Released" is not a state available to them.
+        $this->setUser($grader);
+        $this->assertTrue($graderassign->grading_disabled($student->id));
+        $this->assertFalse($graderassign->grading_disabled($student->id, false));
+
+        // The grader cannot update the grade directly.
+        $grade = $graderassign->get_user_grade($student->id, true);
+        $grade->grade = 75.0;
+        $grade->grader = $grader->id;
+        $this->assertFalse($graderassign->update_grade($grade));
+        $this->assertEquals(50, (int) $DB->get_field('assign_grades', 'grade', ['id' => $grade->id]));
+
+        // The grader cannot change the grade from the grading form either.
+        $this->grade_submission($grader, $graderassign, $student, 75.0);
+        $this->assertEquals(50, (int) $DB->get_field('assign_grades', 'grade', ['id' => $grade->id]));
+        $flags = $assign->get_user_flags($student->id, false);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_RELEASED, $flags->workflowstate);
+
+        // The teacher can still change the grade, as "Released" is available to them.
+        $this->setUser($teacher);
+        $this->assertFalse($teacherassign->grading_disabled($student->id));
+        $this->grade_submission($teacher, $teacherassign, $student, 75.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_RELEASED,
+        ]);
+        $this->assertEquals(75, (int) $DB->get_field('assign_grades', 'grade', ['id' => $grade->id]));
+
+        // Once the teacher moves the grade back to a state available to the grader, the grader can grade again.
+        $this->grade_submission($teacher, $teacherassign, $student, 75.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_INMARKING,
+        ]);
+        $this->setUser($grader);
+        $this->assertFalse($graderassign->grading_disabled($student->id));
+        $this->grade_submission($grader, $graderassign, $student, 60.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW,
+        ]);
+        $this->assertEquals(60, (int) $DB->get_field('assign_grades', 'grade', ['id' => $grade->id]));
+        $flags = $assign->get_user_flags($student->id, false);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW, $flags->workflowstate);
+    }
 }
