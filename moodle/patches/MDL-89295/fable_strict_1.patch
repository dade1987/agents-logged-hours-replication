+    /**
+     * Test that marks cannot be modified once the overall workflow state is ready for release or released,
+     * even by users who are able to manage or release the overall workflow state.
+     *
+     * @covers ::update_mark
+     * @covers ::grading_disabled
+     */
+    public function test_marks_locked_when_ready_for_release_or_released(): void {
+        global $DB;
+
+        $this->setup_data();
+        $assignment = $this->create_assignment();
+
+        // Allocate both teachers to the student assignment.
+        $assignment->update_marker_allocations($this->users[2]->id, [
+            1 => [$this->users[0]->id],
+            2 => [$this->users[1]->id],
+        ]);
+
+        // Both markers mark as marking complete.
+        $gradeobject = $assignment->get_user_grade($this->users[2]->id, true);
+        $gradeobject->grader = $this->users[0]->id;
+        $this->assertTrue($assignment->update_mark($gradeobject, 90, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+        $gradeobject->grader = $this->users[1]->id;
+        $this->assertTrue($assignment->update_mark($gradeobject, 70, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+
+        $flags = $assignment->get_user_flags($this->users[2]->id, true);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW, $flags->workflowstate);
+
+        // Marks can still be modified while in review.
+        $flags->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_INREVIEW;
+        $assignment->update_user_flags($flags);
+        $this->assertFalse($assignment->grading_disabled($this->users[2]->id, true, null, true));
+        $gradeobject->grader = $this->users[0]->id;
+        $this->assertTrue($assignment->update_mark($gradeobject, 80, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+        $mark = $assignment->get_mark($gradeobject->id, $this->users[0]->id);
+        $this->assertEquals(80, $mark->mark);
+
+        foreach ([ASSIGN_MARKING_WORKFLOW_STATE_READYFORRELEASE, ASSIGN_MARKING_WORKFLOW_STATE_RELEASED] as $state) {
+            $flags = $assignment->get_user_flags($this->users[2]->id, true);
+            $flags->workflowstate = $state;
+            $assignment->update_user_flags($flags);
+
+            // The admin can manage the overall workflow state, so the grade is not disabled.
+            $this->assertFalse($assignment->grading_disabled($this->users[2]->id));
+            // But the individual marks are read only.
+            $this->assertTrue($assignment->grading_disabled($this->users[2]->id, true, null, true));
+
+            // Marks cannot be modified, even by the admin.
+            $gradeobject->grader = $this->users[0]->id;
+            $this->assertFalse($assignment->update_mark($gradeobject, 50, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+            $mark = $assignment->get_mark($gradeobject->id, $this->users[0]->id);
+            $this->assertEquals(80, $mark->mark);
+            $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW, $mark->workflowstate);
+
+            // Nor by the marker themselves.
+            $this->setUser($this->users[1]);
+            $gradeobject->grader = $this->users[1]->id;
+            $this->assertFalse($assignment->update_mark($gradeobject, 50, ASSIGN_MARKING_WORKFLOW_STATE_INMARKING));
+            $mark = $assignment->get_mark($gradeobject->id, $this->users[1]->id);
+            $this->assertEquals(70, $mark->mark);
+            $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW, $mark->workflowstate);
+            $this->setAdminUser();
+
+            // The overall workflow state is unchanged.
+            $flags = $assignment->get_user_flags($this->users[2]->id, true);
+            $this->assertEquals($state, $flags->workflowstate);
+        }
+    }
+
     /**
      * Test that when we remove a marker their marks are not counted towards anything.
      *
