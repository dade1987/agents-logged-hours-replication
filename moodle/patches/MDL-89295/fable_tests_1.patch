+    /**
+     * Test that grading is disabled when the grade is in a marking workflow state not available to the grader.
+     *
+     * @covers ::grading_disabled
+     * @covers ::update_grade
+     * @covers ::is_workflow_state_available_to_current_user
+     */
+    public function test_grading_disabled_workflow_state(): void {
+        global $DB, $PAGE;
+
+        $this->resetAfterTest();
+        $course = $this->getDataGenerator()->create_course();
+        $student = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $teacher = $this->getDataGenerator()->create_and_enrol($course, 'editingteacher');
+
+        // Create a grader role that can grade but can not review, release or manage grades.
+        $graderroleid = $this->getDataGenerator()->create_role(['shortname' => 'grader']);
+        $context = \context_course::instance($course->id);
+        assign_capability('mod/assign:grade', CAP_ALLOW, $graderroleid, $context->id);
+        assign_capability('mod/assign:view', CAP_ALLOW, $graderroleid, $context->id);
+        assign_capability('mod/assign:viewgrades', CAP_ALLOW, $graderroleid, $context->id);
+        $grader = $this->getDataGenerator()->create_and_enrol($course, 'grader');
+
+        $assign = $this->create_instance($course, [
+            'markingworkflow' => 1,
+        ]);
+        $PAGE->set_url(new \moodle_url('/mod/assign/view.php', ['id' => $assign->get_course_module()->id]));
+
+        $this->add_submission($student, $assign);
+        $this->submit_for_grading($student, $assign);
+
+        // Before any workflow state is set, the grader can grade.
+        $this->setUser($grader);
+        $graderassign = new mod_assign_testable_assign($assign->get_context(), $assign->get_course_module(), $course);
+        $this->assertFalse($graderassign->grading_disabled($student->id));
+
+        // The teacher grades the submission and sets the workflow state to "In marking".
+        $this->grade_submission($teacher, $assign, $student, 50.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_INMARKING,
+        ]);
+
+        // The grader can still edit the grade.
+        $this->setUser($grader);
+        $this->assertFalse($graderassign->grading_disabled($student->id));
+        $this->grade_submission($grader, $graderassign, $student, 60.0);
+        $grade = $assign->get_user_grade($student->id, false);
+        $this->assertEquals(60.0, $grade->grade);
+
+        // The teacher sets the workflow state to "Released".
+        $this->grade_submission($teacher, $assign, $student, 50.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_RELEASED,
+        ]);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_RELEASED, $assign->get_grading_status($student->id));
+
+        // The grader can no longer edit the grade because "Released" is not available to them.
+        $this->setUser($grader);
+        $this->assertTrue($graderassign->grading_disabled($student->id));
+        $this->assertFalse($graderassign->grading_disabled($student->id, false));
+
+        // Attempting to grade through the grading form must not change the released grade.
+        $this->grade_submission($grader, $graderassign, $student, 70.0);
+        $grade = $assign->get_user_grade($student->id, false);
+        $this->assertEquals(50.0, $grade->grade);
+
+        // Nor can the grade be updated directly.
+        $this->setUser($grader);
+        $grade->grade = 70.0;
+        $this->assertFalse($graderassign->update_grade($grade));
+        $this->assertEquals(50.0, $DB->get_field('assign_grades', 'grade', ['id' => $grade->id]));
+
+        // Quick grading must also be ignored for this user.
+        $data = [
+            'grademodified_' . $student->id => $grade->timemodified,
+            'gradeattempt_' . $student->id => $grade->attemptnumber,
+            'quickgrade_' . $student->id => '80',
+            'sesskey' => sesskey(),
+        ];
+        $graderassign->testable_process_save_quick_grades($data);
+        $this->assertEquals(50.0, $DB->get_field('assign_grades', 'grade', ['id' => $grade->id]));
+
+        // The teacher can still edit the released grade.
+        $this->setUser($teacher);
+        $this->assertFalse($assign->grading_disabled($student->id));
+        $this->grade_submission($teacher, $assign, $student, 90.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_RELEASED,
+        ]);
+        $grade = $assign->get_user_grade($student->id, false);
+        $this->assertEquals(90.0, $grade->grade);
+    }
