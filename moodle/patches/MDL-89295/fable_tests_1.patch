+     *
+     * @param int $userid - The student userid
+     * @return bool true if marks can not be edited.
+     */
+    public function marking_disabled(int $userid): bool {
+        if ($this->grading_disabled($userid)) {
+            return true;
+        }
+        if (!$this->get_instance()->markingworkflow) {
+            return false;
+        }
+        $lockedstates = [
+            ASSIGN_MARKING_WORKFLOW_STATE_READYFORRELEASE,
+            ASSIGN_MARKING_WORKFLOW_STATE_RELEASED,
+        ];
+        return in_array($this->get_grading_status($userid), $lockedstates, true);
+    }
