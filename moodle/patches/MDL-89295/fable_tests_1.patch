+    /**
+     * Determine if the current user is allowed to work with a grade that is in the given marking workflow state.
+     *
+     * A grade that has not entered the workflow yet (empty state or "Not marked") is available to everyone,
+     * otherwise the state must be one the current user has permission to transition a grade to.
+     *
+     * @param string|null $workflowstate The overall marking workflow state of the grade.
+     * @return bool true if the current user can work with a grade in this state.
+     */
+    public function is_workflow_state_available_to_current_user(?string $workflowstate): bool {
+        if (empty($workflowstate) || $workflowstate === ASSIGN_MARKING_WORKFLOW_STATE_NOTMARKED) {
+            return true;
+        }
+        return array_key_exists($workflowstate, $this->get_marking_workflow_states_for_current_user());
+    }
+
+    /**
