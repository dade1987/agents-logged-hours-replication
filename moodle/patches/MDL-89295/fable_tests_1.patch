+    /**
+     * Test that individual marks can not be modified once the overall workflow state is ready for release or released,
+     * even by users who are able to manage or release the overall workflow state.
+     *
+     * @covers ::update_mark
+     * @covers ::marking_disabled
+     */
+    public function test_marks_locked_once_ready_for_release(): void {
+        $this->setup_data();
+        $assignment = $this->create_assignment();
+        $studentid = $this->users[2]->id;
+
+        // Allocate both teachers to the student assignment.
+        $assignment->update_marker_allocations($studentid, [
+            1 => [$this->users[0]->id],
+            2 => [$this->users[1]->id],
+        ]);
+
+        // Both markers mark the submission as marking complete.
+        $gradeobject = $assignment->get_user_grade($studentid, true);
+        $gradeobject->grader = $this->users[0]->id;
+        $this->assertTrue($assignment->update_mark($gradeobject, 90, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+        $gradeobject->grader = $this->users[1]->id;
+        $this->assertTrue($assignment->update_mark($gradeobject, 70, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+
+        $flags = $assignment->get_user_flags($studentid, true);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW, $flags->workflowstate);
+        $this->assertFalse($assignment->marking_disabled($studentid));
+
+        // Marks can still be changed while the overall state is in review.
+        $flags->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_INREVIEW;
+        $assignment->update_user_flags($flags);
+        $this->assertFalse($assignment->marking_disabled($studentid));
+        $gradeobject->grader = $this->users[0]->id;
+        $this->assertTrue($assignment->update_mark($gradeobject, 80, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+        $this->assertEquals(80, $assignment->get_mark($gradeobject->id, $this->users[0]->id)->mark);
+
+        // Once the overall state is ready for release, the marks are locked.
+        $flags->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_READYFORRELEASE;
+        $assignment->update_user_flags($flags);
+        $this->assertTrue($assignment->marking_disabled($studentid));
+        $this->assertFalse($assignment->update_mark($gradeobject, 60, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+        $this->assertEquals(80, $assignment->get_mark($gradeobject->id, $this->users[0]->id)->mark);
+        $this->assertFalse($assignment->update_mark($gradeobject, 80, ASSIGN_MARKING_WORKFLOW_STATE_INMARKING));
+        $mark = $assignment->get_mark($gradeobject->id, $this->users[0]->id);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW, $mark->workflowstate);
+
+        // The same applies once released, even as a user who can release grades.
+        $flags->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_RELEASED;
+        $assignment->update_user_flags($flags);
+        $this->setUser($this->users[0]);
+        $this->assertTrue($assignment->marking_disabled($studentid));
+        $this->assertFalse($assignment->grading_disabled($studentid));
+        $this->assertFalse($assignment->update_mark($gradeobject, 60, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+        $this->assertEquals(80, $assignment->get_mark($gradeobject->id, $this->users[0]->id)->mark);
+        $gradeobject->grader = $this->users[1]->id;
+        $this->assertFalse($assignment->update_mark($gradeobject, 10));
+        $this->assertEquals(70, $assignment->get_mark($gradeobject->id, $this->users[1]->id)->mark);
+
+        // The overall state is untouched.
+        $flags = $assignment->get_user_flags($studentid, true);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_RELEASED, $flags->workflowstate);
+
+        // Moving the overall state back to in review unlocks the marks again.
+        $flags->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_INREVIEW;
+        $assignment->update_user_flags($flags);
+        $this->assertFalse($assignment->marking_disabled($studentid));
+        $this->assertTrue($assignment->update_mark($gradeobject, 10));
+        $this->assertEquals(10, $assignment->get_mark($gradeobject->id, $this->users[1]->id)->mark);
+    }
