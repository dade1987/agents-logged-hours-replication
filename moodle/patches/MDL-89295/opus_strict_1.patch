             ],
         ];
     }
+
+    /**
+     * Marks cannot be modified once the overall workflow state is ready for release or released.
+     *
+     * @covers ::marking_disabled
+     * @covers ::update_mark
+     */
+    public function test_marks_locked_when_ready_for_release_or_released(): void {
+        $this->setup_data();
+        $assignment = $this->create_assignment();
+        $studentid = $this->users[2]->id;
+
+        $assignment->update_marker_allocations($studentid, [
+            1 => [$this->users[0]->id],
+            2 => [$this->users[1]->id],
+        ]);
+
+        $gradeobject = $assignment->get_user_grade($studentid, true);
+        $gradeobject->grader = $this->users[0]->id;
+        $this->assertTrue($assignment->update_mark($gradeobject, 60, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+
+        // Marks can still be changed while in review.
+        $flags = $assignment->get_user_flags($studentid, true);
+        $flags->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_INREVIEW;
+        $assignment->update_user_flags($flags);
+        $this->assertFalse($assignment->marking_disabled($studentid));
+
+        foreach ([ASSIGN_MARKING_WORKFLOW_STATE_READYFORRELEASE, ASSIGN_MARKING_WORKFLOW_STATE_RELEASED] as $state) {
+            $flags = $assignment->get_user_flags($studentid, true);
+            $flags->workflowstate = $state;
+            $assignment->update_user_flags($flags);
+
+            // Even users who can manage the workflow state cannot change marks.
+            foreach ([get_admin()->id, $this->users[0]->id, $this->users[3]->id] as $userid) {
+                $this->setUser($userid);
+                $this->assertFalse($assignment->grading_disabled($studentid));
+                $this->assertTrue($assignment->marking_disabled($studentid));
+
+                $gradeobject = $assignment->get_user_grade($studentid, false);
+                $gradeobject->grader = $this->users[0]->id;
+                $this->assertFalse($assignment->update_mark($gradeobject, 80, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+                $this->assertEquals(60, (float) $assignment->get_mark($gradeobject->id, $this->users[0]->id)->mark);
+            }
+            $this->setAdminUser();
+        }
+    }
 }
