+
+    /**
+     * Test that graders cannot edit grades in a marking workflow state that is not available to them.
+     *
+     * @covers \assign::grading_disabled
+     * @covers \assign::update_grade
+     */
+    public function test_grading_disabled_for_unavailable_workflow_state(): void {
+        $this->resetAfterTest();
+        $course = $this->getDataGenerator()->create_course();
+        $student = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $editingteacher = $this->getDataGenerator()->create_and_enrol($course, 'editingteacher');
+        // The non-editing teacher has mod/assign:grade, but not the review/release/manage grades capabilities.
+        $grader = $this->getDataGenerator()->create_and_enrol($course, 'teacher');
+
+        $assign = $this->create_instance($course, ['markingworkflow' => 1]);
+        // Use separate instances per user, as the available workflow states are cached per instance.
+        $newinstance = fn() => new mod_assign_testable_assign($assign->get_context(), $assign->get_course_module(), $course);
+        $graderassign = $newinstance();
+        $teacherassign = $newinstance();
+
+        // The grader can grade while the workflow state is one available to them.
+        $this->grade_submission($grader, $graderassign, $student, 40.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_INMARKING,
+        ]);
+        $this->assertEquals(40, (int) $assign->get_user_grade($student->id, false)->grade);
+        $this->assertFalse($graderassign->grading_disabled($student->id));
+
+        // The grader cannot set a workflow state that is not available to them.
+        $this->grade_submission($grader, $graderassign, $student, 40.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_RELEASED,
+        ]);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_INMARKING,
+            $assign->get_user_flags($student->id, false)->workflowstate);
+
+        // Release the grade as an editing teacher.
+        $this->grade_submission($editingteacher, $teacherassign, $student, 50.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_RELEASED,
+        ]);
+        $this->assertEquals(50, (int) $assign->get_user_grade($student->id, false)->grade);
+        $this->assertFalse($teacherassign->grading_disabled($student->id));
+
+        // The grader can no longer change the grade.
+        $this->setUser($grader);
+        $this->assertTrue($graderassign->grading_disabled($student->id));
+        $this->assertFalse($graderassign->grading_disabled($student->id, false));
+
+        $this->grade_submission($grader, $graderassign, $student, 80.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_INMARKING,
+        ]);
+        $this->assertEquals(50, (int) $assign->get_user_grade($student->id, false)->grade);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_RELEASED,
+            $assign->get_user_flags($student->id, false)->workflowstate);
+
+        // Updating the grade directly is also rejected.
+        $this->setUser($grader);
+        $grade = $assign->get_user_grade($student->id, false);
+        $grade->grade = 90;
+        $this->assertFalse($graderassign->update_grade($grade));
+        $this->assertEquals(50, (int) $assign->get_user_grade($student->id, false)->grade);
+
+        // The editing teacher can still change the grade.
+        $this->grade_submission($editingteacher, $teacherassign, $student, 60.0);
+        $this->assertEquals(60, (int) $assign->get_user_grade($student->id, false)->grade);
+    }
 }
diff --git a/public/mod/assign/tests/markerallocation_test.php b/public/mod/assign/tests/markerallocation_test.php
index 6a3833c3ba9..793e94aa4fb 100644
--- a/public/mod/assign/tests/markerallocation_test.php
+++ b/public/mod/assign/tests/markerallocation_test.php
@@ -1769,4 +1769,56 @@ final class markerallocation_test extends \advanced_testcase {
             ],
         ];
     }
+
+    /**
+     * Test that marks cannot be modified once the overall workflow state is ready for release or released.
+     *
+     * @covers ::update_mark
+     * @covers ::marks_locked
+     */
+    public function test_marks_locked_after_ready_for_release(): void {
+        $this->setup_data();
+        $assignment = $this->create_assignment(['markercount' => 2]);
+        $studentid = $this->users[2]->id;
+
+        $assignment->update_marker_allocations($studentid, [
+            1 => [$this->users[0]->id],
+            2 => [$this->users[1]->id],
+        ]);
+
+        $this->setUser($this->users[0]);
+        $grade = $assignment->get_user_grade($studentid, true);
+        $grade->grader = $this->users[0]->id;
+        $this->assertTrue($assignment->update_mark($grade, 40, ASSIGN_MARKING_WORKFLOW_STATE_INMARKING));
+        $this->assertFalse($assignment->marks_locked($studentid));
+
+        foreach ([ASSIGN_MARKING_WORKFLOW_STATE_READYFORRELEASE, ASSIGN_MARKING_WORKFLOW_STATE_RELEASED] as $state) {
+            $flags = $assignment->get_user_flags($studentid, true);
+            $flags->workflowstate = $state;
+            $assignment->update_user_flags($flags);
+            $this->assertTrue($assignment->marks_locked($studentid));
+
+            // Neither the marker nor a user who can manage the workflow can change the mark.
+            foreach ([$this->users[0], $this->users[3]] as $user) {
+                $this->setUser($user);
+                $grade = $assignment->get_user_grade($studentid, false);
+                $grade->grader = $this->users[0]->id;
+                $this->assertFalse($assignment->update_mark($grade, 70, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+                $mark = $assignment->get_mark($grade->id, $this->users[0]->id);
+                $this->assertEquals(40, (int) $mark->mark);
+                $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_INMARKING, $mark->workflowstate);
+            }
+        }
+
+        // Moving back to in review unlocks the marks for users who can manage that state.
+        $flags = $assignment->get_user_flags($studentid, true);
+        $flags->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_INREVIEW;
+        $assignment->update_user_flags($flags);
+        $this->assertFalse($assignment->marks_locked($studentid));
+        $this->setUser($this->users[0]);
+        $grade = $assignment->get_user_grade($studentid, false);
+        $grade->grader = $this->users[0]->id;
+        $this->assertTrue($assignment->update_mark($grade, 70));
+        $this->assertEquals(70, (int) $assignment->get_mark($grade->id, $this->users[0]->id)->mark);
+    }
 }
