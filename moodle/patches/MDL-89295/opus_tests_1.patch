+    /**
+     * Get the current overall marking workflow state for a user.
+     *
+     * The workflow state is stored in the assign_user_flags table.
+     *
+     * @param int $userid The student userid
+     * @return string The workflow state, or an empty string if not set.
+     */
+    protected function get_user_workflow_state(int $userid): string {
+        $flags = $this->get_user_flags($userid, false);
+        return ($flags && !empty($flags->workflowstate)) ? $flags->workflowstate : '';
+    }
+
+    /**
+     * Whether the current overall marking workflow state of the user is one the current user can manage.
+     *
+     * Always true when marking workflow is not in use, or when no workflow state has been set yet.
+     *
+     * @param int $userid The student userid
+     * @return bool
+     */
+    public function is_workflow_state_available_to_current_user(int $userid): bool {
+        if (!$this->get_instance()->markingworkflow) {
+            return true;
+        }
+        $workflowstate = $this->get_user_workflow_state($userid);
+        if ($workflowstate === '') {
+            return true;
+        }
+        return array_key_exists($workflowstate, $this->get_marking_workflow_states_for_current_user());
+    }
+
+    /**
+     * Whether individual marker marks for a user are locked.
+     *
+     * When using multiple marking, marks can no longer be changed (by anyone) once the overall
+     * workflow state is "Ready for release" or "Released".
+     *
+     * @param int $userid The student userid
+     * @return bool
+     */
+    public function marks_locked(int $userid): bool {
+        if (!$this->is_using_multiple_marking()) {
+            return false;
+        }
+        return in_array($this->get_user_workflow_state($userid), [
+            ASSIGN_MARKING_WORKFLOW_STATE_READYFORRELEASE,
+            ASSIGN_MARKING_WORKFLOW_STATE_RELEASED,
+        ]);
+    }
