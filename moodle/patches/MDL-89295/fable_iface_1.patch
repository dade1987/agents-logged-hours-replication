+    /**
+     * Test that individual marks are locked once the overall workflow state is ready for release or released.
+     *
+     * @covers ::marking_locked
+     * @covers ::update_mark
+     */
+    public function test_marking_locked(): void {
+        $this->setup_data();
+        $assignment = $this->create_assignment();
+
+        // Allocate both teachers to the student assignment.
+        $assignment->update_marker_allocations($this->users[2]->id, [
+            1 => [$this->users[0]->id],
+            2 => [$this->users[1]->id],
+        ]);
+
+        // Both teachers mark the student.
+        $gradeobject = $assignment->get_user_grade($this->users[2]->id, true);
+        $this->setUser($this->users[0]->id);
+        $gradeobject->grader = $this->users[0]->id;
+        $this->assertFalse($assignment->marking_locked($this->users[2]->id));
+        $this->assertTrue($assignment->update_mark($gradeobject, 80, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+
+        $this->setUser($this->users[1]->id);
+        $gradeobject->grader = $this->users[1]->id;
+        $this->assertFalse($assignment->marking_locked($this->users[2]->id));
+        $this->assertTrue($assignment->update_mark($gradeobject, 60, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+
+        // Marks are not locked while in review.
+        $flags = $assignment->get_user_flags($this->users[2]->id, true);
+        $flags->workflowstate = ASSIGN_MARKING_WORKFLOW_STATE_INREVIEW;
+        $assignment->update_user_flags($flags);
+        $this->setUser($this->users[0]->id);
+        $this->assertFalse($assignment->marking_locked($this->users[2]->id));
+        $gradeobject->grader = $this->users[0]->id;
+        $this->assertTrue($assignment->update_mark($gradeobject, 85, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+        $mark = $assignment->get_mark($gradeobject->id, $this->users[0]->id);
+        $this->assertEquals(85, $mark->mark);
+
+        // Marks are locked once the overall state is ready for release, even for users who can manage grades.
+        foreach ([ASSIGN_MARKING_WORKFLOW_STATE_READYFORRELEASE, ASSIGN_MARKING_WORKFLOW_STATE_RELEASED] as $state) {
+            $flags = $assignment->get_user_flags($this->users[2]->id, true);
+            $flags->workflowstate = $state;
+            $assignment->update_user_flags($flags);
+
+            foreach ([$this->users[0], $this->users[1], $this->users[3]] as $user) {
+                $this->setUser($user->id);
+                $this->assertFalse($assignment->grading_locked($this->users[2]->id));
+                $this->assertTrue($assignment->marking_locked($this->users[2]->id));
+            }
+
+            $this->setUser($this->users[0]->id);
+            $gradeobject->grader = $this->users[0]->id;
+            $this->assertFalse($assignment->update_mark($gradeobject, 90, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+            $mark = $assignment->get_mark($gradeobject->id, $this->users[0]->id);
+            $this->assertEquals(85, $mark->mark);
+
+            $this->setUser($this->users[3]->id);
+            $this->assertFalse($assignment->update_mark($gradeobject, 90, ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+            $mark = $assignment->get_mark($gradeobject->id, $this->users[0]->id);
+            $this->assertEquals(85, $mark->mark);
+        }
+    }
 }
