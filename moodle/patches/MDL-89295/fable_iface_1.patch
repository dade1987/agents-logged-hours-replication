+    /**
+     * Determine if the grade of a student is locked by the marking workflow state.
+     *
+     * The grade is locked when marking workflow is enabled and the current workflow state of the
+     * student (stored in the user flags) is not one the current user is permitted to manage.
+     *
+     * @param int $userid The student userid.
+     * @return bool true if the grade is locked.
+     */
+    public function grading_locked(int $userid): bool {
+        if (!$this->get_instance()->markingworkflow) {
+            return false;
+        }
+
+        $flags = $this->get_user_flags($userid, false);
+        if (empty($flags) || empty($flags->workflowstate)) {
+            return false;
+        }
+
+        return $this->workflow_state_locked($flags->workflowstate);
+    }
+
+    /**
+     * Determine if a marking workflow state is locked for the current user.
+     *
+     * A workflow state is locked when the current user does not have permission to transition grades
+     * from that state, i.e. the state is not one of the states available to the current user.
+     *
+     * @param string|null $workflowstate The marking workflow state to check.
+     * @return bool true if the workflow state is locked for the current user.
+     */
+    public function workflow_state_locked(?string $workflowstate): bool {
+        if (!$this->get_instance()->markingworkflow) {
+            return false;
+        }
+
+        if (empty($workflowstate) || $workflowstate === ASSIGN_MARKING_WORKFLOW_STATE_NOTMARKED) {
+            return false;
+        }
+
+        $validstates = $this->get_marking_workflow_states_for_current_user();
+        return !array_key_exists($workflowstate, $validstates);
+    }
+
+    /**
+     * Determine if the individual marker marks of a student are locked by the overall marking workflow state.
+     *
+     * Marks are locked when the overall workflow state of the student is locked for the current user,
+     * or once the overall workflow state is "Ready for release" or "Released". In the latter case the marks
+     * are locked for everyone, including users who are able to manage or release the overall workflow state.
+     *
+     * @param int $userid The student userid.
+     * @return bool true if the marks are locked.
+     */
+    public function marking_locked(int $userid): bool {
+        if (!$this->get_instance()->markingworkflow) {
+            return false;
+        }
+
+        if ($this->grading_locked($userid)) {
+            return true;
+        }
+
+        $flags = $this->get_user_flags($userid, false);
+        if (empty($flags) || empty($flags->workflowstate)) {
+            return false;
+        }
+
+        $lockedstates = [
+            ASSIGN_MARKING_WORKFLOW_STATE_READYFORRELEASE,
+            ASSIGN_MARKING_WORKFLOW_STATE_RELEASED,
+        ];
+        return in_array($flags->workflowstate, $lockedstates, true);
+    }
