+    /**
+     * Test that grades are locked when the workflow state is not available to the current user.
+     *
+     * @covers ::grading_locked
+     * @covers ::workflow_state_locked
+     * @covers ::grading_disabled
+     * @covers ::update_grade
+     */
+    public function test_grading_locked(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $course = $this->getDataGenerator()->create_course();
+        $student = $this->getDataGenerator()->create_and_enrol($course, 'student');
+        $editingteacher = $this->getDataGenerator()->create_and_enrol($course, 'editingteacher');
+        // A non-editing teacher can grade but cannot review, release or manage grades.
+        $grader = $this->getDataGenerator()->create_and_enrol($course, 'teacher');
+
+        $assign = $this->create_instance($course, [
+            'markingworkflow' => 1,
+        ]);
+
+        $this->add_submission($student, $assign);
+        $this->submit_for_grading($student, $assign);
+
+        // Nothing is locked when there is no workflow state yet.
+        $this->setUser($grader);
+        $this->assertFalse($assign->workflow_state_locked(null));
+        $this->assertFalse($assign->workflow_state_locked(''));
+        $this->assertFalse($assign->workflow_state_locked(ASSIGN_MARKING_WORKFLOW_STATE_NOTMARKED));
+        $this->assertFalse($assign->workflow_state_locked(ASSIGN_MARKING_WORKFLOW_STATE_INMARKING));
+        $this->assertFalse($assign->workflow_state_locked(ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW));
+        $this->assertTrue($assign->workflow_state_locked(ASSIGN_MARKING_WORKFLOW_STATE_INREVIEW));
+        $this->assertTrue($assign->workflow_state_locked(ASSIGN_MARKING_WORKFLOW_STATE_READYFORRELEASE));
+        $this->assertTrue($assign->workflow_state_locked(ASSIGN_MARKING_WORKFLOW_STATE_RELEASED));
+        $this->assertFalse($assign->grading_locked($student->id));
+        $this->assertFalse($assign->grading_disabled($student->id));
+
+        // The editing teacher can transition to every state.
+        $this->setUser($editingteacher);
+        foreach (array_keys($assign->get_all_marking_workflow_states()) as $state) {
+            $this->assertFalse($assign->workflow_state_locked($state));
+        }
+
+        // Grade the submission as the grader while in a state they can manage.
+        $this->grade_submission($grader, $assign, $student, 50.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW,
+        ]);
+        $grade = $assign->get_user_grade($student->id, false);
+        $this->assertEquals(50.0, $grade->grade);
+        $this->setUser($grader);
+        $this->assertFalse($assign->grading_locked($student->id));
+        $this->assertFalse($assign->grading_disabled($student->id));
+
+        // Release the grade as the editing teacher.
+        $this->grade_submission($editingteacher, $assign, $student, 60.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_RELEASED,
+        ]);
+        $flags = $assign->get_user_flags($student->id, false);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_RELEASED, $flags->workflowstate);
+        $grade = $assign->get_user_grade($student->id, false);
+        $this->assertEquals(60.0, $grade->grade);
+
+        // The editing teacher can still edit the grade.
+        $this->setUser($editingteacher);
+        $this->assertFalse($assign->grading_locked($student->id));
+        $this->assertFalse($assign->grading_disabled($student->id));
+
+        // The grader cannot edit the grade any more.
+        $this->setUser($grader);
+        $this->assertTrue($assign->grading_locked($student->id));
+        $this->assertTrue($assign->grading_disabled($student->id));
+
+        // Attempting to update the grade directly is refused.
+        $grade = $assign->get_user_grade($student->id, false);
+        $grade->grade = 70.0;
+        $this->assertFalse($assign->update_grade($grade));
+        $grade = $DB->get_record('assign_grades', ['id' => $grade->id]);
+        $this->assertEquals(60.0, $grade->grade);
+
+        // Attempting to grade through the grading form is ignored.
+        $this->grade_submission($grader, $assign, $student, 80.0, [
+            'workflowstate' => ASSIGN_MARKING_WORKFLOW_STATE_READYFORREVIEW,
+        ]);
+        $grade = $assign->get_user_grade($student->id, false);
+        $this->assertEquals(60.0, $grade->grade);
+        $flags = $assign->get_user_flags($student->id, false);
+        $this->assertEquals(ASSIGN_MARKING_WORKFLOW_STATE_RELEASED, $flags->workflowstate);
+
+        // Nothing is locked when marking workflow is disabled.
+        $assignnoworkflow = $this->create_instance($course, [
+            'markingworkflow' => 0,
+        ]);
+        $this->setUser($grader);
+        $this->assertFalse($assignnoworkflow->workflow_state_locked(ASSIGN_MARKING_WORKFLOW_STATE_RELEASED));
+        $this->assertFalse($assignnoworkflow->grading_locked($student->id));
+    }
 }
