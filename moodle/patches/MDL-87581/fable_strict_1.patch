+    /**
+     * Test that the summary and overview files of the template course are copied when creating a course.
+     */
+    public function test_restore_course_summary_and_overviewfiles(): void {
+        global $DB;
+        $this->initialise_test();
+        $this->setAdminUser();
+
+        $c1 = $this->getDataGenerator()->create_course([
+            'summary' => 'Template summary',
+            'summaryformat' => FORMAT_MARKDOWN,
+            'startdate' => mktime(0, 0, 0, 1, 1, 2020),
+        ]);
+        $c1context = \context_course::instance($c1->id);
+        $fs = get_file_storage();
+        $fs->create_file_from_string([
+            'contextid' => $c1context->id,
+            'component' => 'course',
+            'filearea' => 'overviewfiles',
+            'itemid' => 0,
+            'filepath' => '/',
+            'filename' => 'image.png',
+        ], 'Course image content');
+        $fs->create_file_from_string([
+            'contextid' => $c1context->id,
+            'component' => 'course',
+            'filearea' => 'summary',
+            'itemid' => 0,
+            'filepath' => '/',
+            'filename' => 'summaryfile.txt',
+        ], 'Summary file content');
+
+        $mode = tool_uploadcourse_processor::MODE_CREATE_NEW;
+        $updatemode = tool_uploadcourse_processor::UPDATE_ALL_WITH_DATA_ONLY;
+
+        // Creating a course without a summary: the summary and the files come from the template course.
+        $data = [
+            'shortname' => 'A1',
+            'templatecourse' => $c1->shortname,
+            'category' => 1,
+            'fullname' => 'Fullname A1',
+            'startdate' => '8 June 2021',
+            'visible' => '0',
+        ];
+        $co = new tool_uploadcourse_course($mode, $updatemode, $data);
+        $this->assertTrue($co->prepare());
+        $co->proceed();
+        $course = $DB->get_record('course', ['shortname' => 'A1'], '*', MUST_EXIST);
+        $this->assertEquals('Fullname A1', $course->fullname);
+        $this->assertEquals('A1', $course->shortname);
+        $this->assertEquals(0, $course->visible);
+        $this->assertEquals(mktime(0, 0, 0, 6, 8, 2021), $course->startdate);
+        $this->assertEquals('Template summary', $course->summary);
+        $this->assertEquals(FORMAT_MARKDOWN, $course->summaryformat);
+        $context = \context_course::instance($course->id);
+        $files = $fs->get_area_files($context->id, 'course', 'overviewfiles', 0, 'filename', false);
+        $this->assertCount(1, $files);
+        $file = reset($files);
+        $this->assertEquals('image.png', $file->get_filename());
+        $this->assertEquals('Course image content', $file->get_content());
+        $files = $fs->get_area_files($context->id, 'course', 'summary', 0, 'filename', false);
+        $this->assertCount(1, $files);
+        $file = reset($files);
+        $this->assertEquals('summaryfile.txt', $file->get_filename());
+
+        // Creating a course with a summary: the summary from the upload takes priority over the template course.
+        $data = [
+            'shortname' => 'B1',
+            'templatecourse' => $c1->shortname,
+            'summary' => 'B',
+            'category' => 1,
+            'fullname' => 'Fullname B1',
+        ];
+        $co = new tool_uploadcourse_course($mode, $updatemode, $data);
+        $this->assertTrue($co->prepare());
+        $co->proceed();
+        $course = $DB->get_record('course', ['shortname' => 'B1'], '*', MUST_EXIST);
+        $this->assertEquals('Fullname B1', $course->fullname);
+        $this->assertEquals('B', $course->summary);
+        $context = \context_course::instance($course->id);
+        $files = $fs->get_area_files($context->id, 'course', 'overviewfiles', 0, 'filename', false);
+        $this->assertCount(1, $files);
+
+        // Updating an existing course from a template does not overwrite its configuration.
+        $c2 = $this->getDataGenerator()->create_course(['shortname' => 'C2', 'summary' => 'C2 summary']);
+        $mode = tool_uploadcourse_processor::MODE_UPDATE_ONLY;
+        $data = [
+            'shortname' => 'C2',
+            'templatecourse' => $c1->shortname,
+        ];
+        $co = new tool_uploadcourse_course($mode, $updatemode, $data);
+        $this->assertTrue($co->prepare());
+        $co->proceed();
+        $course = $DB->get_record('course', ['id' => $c2->id], '*', MUST_EXIST);
+        $this->assertEquals('C2 summary', $course->summary);
+        $context = \context_course::instance($course->id);
+        $files = $fs->get_area_files($context->id, 'course', 'overviewfiles', 0, 'filename', false);
+        $this->assertCount(0, $files);
+    }
