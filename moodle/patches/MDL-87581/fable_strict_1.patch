+    /**
+     * Set the value of a setting of the restore plan, if the setting exists and is not locked.
+     *
+     * @param restore_controller $rc the restore controller.
+     * @param string $name the name of the setting.
+     * @param mixed $value the value to set.
+     * @return bool whether the value could be set.
+     */
+    protected function set_restore_setting_value(restore_controller $rc, string $name, $value): bool {
+        $plan = $rc->get_plan();
+        if (!$plan->setting_exists($name)) {
+            return false;
+        }
+        try {
+            $plan->get_setting($name)->set_value($value);
+        } catch (base_setting_exception $e) {
+            // The setting is locked, we can not change it.
+            return false;
+        }
+        return true;
+    }
