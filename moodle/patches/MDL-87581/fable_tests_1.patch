+    /**
+     * Test that the course summary and overview files are copied from the template course.
+     */
+    public function test_restore_course_summary_and_overviewfiles(): void {
+        global $DB;
+        $this->initialise_test();
+        $this->setAdminUser();
+
+        $c1 = $this->getDataGenerator()->create_course([
+            'summary' => '<p>Template summary</p>',
+            'summaryformat' => FORMAT_HTML,
+        ]);
+        $c1context = \context_course::instance($c1->id);
+        $fs = get_file_storage();
+        $fs->create_file_from_string([
+            'contextid' => $c1context->id,
+            'component' => 'course',
+            'filearea' => 'overviewfiles',
+            'itemid' => 0,
+            'filepath' => '/',
+            'filename' => 'courseimage.png',
+        ], 'course image content');
+        $fs->create_file_from_string([
+            'contextid' => $c1context->id,
+            'component' => 'course',
+            'filearea' => 'summary',
+            'itemid' => 0,
+            'filepath' => '/',
+            'filename' => 'summaryfile.txt',
+        ], 'summary file content');
+
+        $mode = tool_uploadcourse_processor::MODE_CREATE_NEW;
+        $updatemode = tool_uploadcourse_processor::UPDATE_ALL_WITH_DATA_ONLY;
+
+        // No summary provided in the uploaded data: the template summary and files must be copied.
+        $data = ['shortname' => 'A1', 'templatecourse' => $c1->shortname, 'category' => 1, 'fullname' => 'A1'];
+        $co = new tool_uploadcourse_course($mode, $updatemode, $data);
+        $this->assertTrue($co->prepare());
+        $co->proceed();
+        $course = $DB->get_record('course', ['shortname' => 'A1']);
+        $this->assertEquals('<p>Template summary</p>', $course->summary);
+        $this->assertEquals(FORMAT_HTML, $course->summaryformat);
+        $this->assertEquals('A1', $course->fullname);
+        $context = \context_course::instance($course->id);
+        $overviewfiles = $fs->get_area_files($context->id, 'course', 'overviewfiles', 0, 'itemid, filepath, filename', false);
+        $this->assertCount(1, $overviewfiles);
+        $overviewfile = reset($overviewfiles);
+        $this->assertEquals('courseimage.png', $overviewfile->get_filename());
+        $this->assertEquals('course image content', $overviewfile->get_content());
+        $summaryfiles = $fs->get_area_files($context->id, 'course', 'summary', 0, 'itemid, filepath, filename', false);
+        $this->assertCount(1, $summaryfiles);
+        $summaryfile = reset($summaryfiles);
+        $this->assertEquals('summaryfile.txt', $summaryfile->get_filename());
+
+        // The summary provided in the uploaded data takes priority, overview files are still copied.
+        $data = ['shortname' => 'B1', 'templatecourse' => $c1->shortname, 'category' => 1, 'fullname' => 'B1',
+            'summary' => 'B'];
+        $co = new tool_uploadcourse_course($mode, $updatemode, $data);
+        $this->assertTrue($co->prepare());
+        $co->proceed();
+        $course = $DB->get_record('course', ['shortname' => 'B1']);
+        $this->assertEquals('B', $course->summary);
+        $context = \context_course::instance($course->id);
+        $overviewfiles = $fs->get_area_files($context->id, 'course', 'overviewfiles', 0, 'itemid, filepath, filename', false);
+        $this->assertCount(1, $overviewfiles);
+        $this->assertEquals('courseimage.png', reset($overviewfiles)->get_filename());
+        $this->assertEmpty($fs->get_area_files($context->id, 'course', 'summary', 0, 'itemid, filepath, filename', false));
+
+        // Updating an existing course from a template does not touch its summary.
+        $mode = tool_uploadcourse_processor::MODE_UPDATE_ONLY;
+        $data = ['shortname' => 'B1', 'templatecourse' => $c1->shortname, 'fullname' => 'B1 updated'];
+        $co = new tool_uploadcourse_course($mode, $updatemode, $data);
+        $this->assertTrue($co->prepare());
+        $co->proceed();
+        $course = $DB->get_record('course', ['shortname' => 'B1']);
+        $this->assertEquals('B1 updated', $course->fullname);
+        $this->assertEquals('B', $course->summary);
+    }
