+namespace tool_uploadcourse\restore;
+
+use checksumable;
+use context;
+use restore_path_element;
+use restore_structure_step;
+use restore_task;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once($CFG->dirroot . '/backup/util/includes/restore_includes.php');
+
+/**
+ * Restore step copying the course summary and overview files from the backup into the uploaded course.
+ *
+ * When tool_uploadcourse restores a template course (or a backup file) into a freshly created course,
+ * it does so using {@see \backup::TARGET_CURRENT_ADDING}. In that mode the standard
+ * {@see \restore_course_structure_step} is not executed (unless the "overwrite_conf" setting is enabled),
+ * so the course summary and the course overview files (course image) are never brought across.
+ * This step restores only those pieces of information, leaving the rest of the course configuration,
+ * which has been defined from the uploaded data, untouched.
+ *
+ * @package    tool_uploadcourse
+ * @copyright  2025 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class course_summary_step extends restore_structure_step implements checksumable {
+
+    /** @var bool whether the course summary (text and embedded files) should be restored. */
+    protected bool $restoresummary;
+
+    /**
+     * Constructor.
+     *
+     * @param string $name name of the step
+     * @param string $filename name of the file to parse (relative to the course task base path)
+     * @param bool $restoresummary whether the summary text (and its embedded files) must be restored
+     *             in addition to the overview files
+     * @param restore_task|null $task the task this step belongs to
+     */
+    public function __construct(string $name, string $filename, bool $restoresummary = true, ?restore_task $task = null) {
+        $this->restoresummary = $restoresummary;
+        parent::__construct($name, $filename, $task);
+    }
+
+    /**
+     * Calculate the checksum of this step.
+     *
+     * This step is added to the restore course task before the task is built, so, unlike the core steps,
+     * it is part of the task when the restore controller checksum is calculated. Implementing the checksum
+     * ourselves prevents the generic (recursive) calculation from following the step -> task -> step cycle.
+     *
+     * @return string
+     */
+    public function calculate_checksum() {
+        return md5(get_class($this) . '-' . $this->name . '-' . $this->filename . '-' . (int) $this->restoresummary);
+    }
+
+    /**
+     * Given one checksum, returns if matches the step's checksum (true) or no (false).
+     *
+     * @param string $checksum
+     * @return bool
+     */
+    public function is_checksum_correct($checksum) {
+        return $this->calculate_checksum() === $checksum;
+    }
+
+    /**
+     * Define the structure to be processed by this step: only the course element is needed.
+     *
+     * @return restore_path_element[]
+     */
+    protected function define_structure() {
+        return [
+            new restore_path_element('course', '/course'),
+        ];
+    }
+
+    /**
+     * Process the course element, updating the summary of the destination course.
+     *
+     * @param array $data
+     */
+    public function process_course($data) {
+        global $DB;
+
+        if (!$this->restoresummary) {
+            return;
+        }
+
+        $data = (object) $data;
+        if (!property_exists($data, 'summary')) {
+            return;
+        }
+
+        // Only users allowed to change the summary can copy it across (same rule as the core course restore step).
+        $context = context::instance_by_id($this->task->get_contextid());
+        if (!has_capability('moodle/course:changesummary', $context, $this->task->get_userid())) {
+            return;
+        }
+
+        $course = new \stdClass();
+        $course->id = $this->get_courseid();
+        $course->summary = $data->summary;
+        if (isset($data->summaryformat)) {
+            $course->summaryformat = $data->summaryformat;
+        }
+        $course->timemodified = time();
+
+        $DB->update_record('course', $course);
+    }
+
+    /**
+     * Once the file has been processed, send the course summary and overview files to the file pool.
+     */
+    protected function after_execute() {
+        if ($this->restoresummary) {
+            $this->add_related_files('course', 'summary', null);
+        }
+        $this->add_related_files('course', 'overviewfiles', null);
+    }
+}
