+    /**
+     * Add a step to the restore plan so that the course summary and overview files are restored too.
+     *
+     * The restore performed by this tool imports the content into the (already created) course, so the
+     * course configuration, including the summary and the overview files, is not restored by default.
+     *
+     * The summary is only restored when no (non-empty) summary has been provided in the uploaded data, the overview
+     * files are always restored.
+     *
+     * @param restore_controller $rc the restore controller
+     * @return void
+     */
+    protected function add_restore_course_summary_step(restore_controller $rc): void {
+        $plan = $rc->get_plan();
+
+        // Nothing to do if the whole course configuration is going to be restored anyway.
+        if ($plan->setting_exists('overwrite_conf') && $plan->get_setting('overwrite_conf')->get_value()) {
+            return;
+        }
+
+        // Do not override the summary provided in the uploaded data.
+        $restoresummary = !isset($this->data['summary']) || trim((string) $this->data['summary']) === '';
+
+        foreach ($plan->get_tasks() as $task) {
+            if ($task instanceof restore_course_task) {
+                $task->add_step(new \tool_uploadcourse\restore\course_summary_step('uploadcourse_course_summary',
+                    'course.xml', $restoresummary));
+                break;
+            }
+        }
+    }
+
