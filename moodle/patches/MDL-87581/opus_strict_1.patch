+namespace tool_uploadcourse\local;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once($CFG->dirroot . '/backup/util/includes/restore_includes.php');
+
+/**
+ * Restore step restoring the course summary and the course overview files into a newly uploaded course.
+ *
+ * When courses are created by the upload tool from a template course or a backup file, the content is
+ * imported into the already created course ({@see \backup::TARGET_CURRENT_ADDING}), so the core
+ * {@see \restore_course_structure_step} (which restores the course configuration) is not executed.
+ * This step only restores the course summary (if the uploaded data did not provide one) and the
+ * course overview files (if the course has none), leaving the rest of the course settings untouched.
+ *
+ * @package    tool_uploadcourse
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class restore_course_summary_step extends \restore_structure_step {
+
+    /** @var bool whether the summary has been restored from the backup. */
+    protected $summaryrestored = false;
+
+    /**
+     * Define the structure to be processed by this step.
+     *
+     * @return \restore_path_element[]
+     */
+    protected function define_structure() {
+        return [new \restore_path_element('course', '/course')];
+    }
+
+    /**
+     * Process the course element, restoring the summary when the target course does not have one.
+     *
+     * @param array $data
+     */
+    public function process_course($data) {
+        global $DB;
+
+        $data = (object) $data;
+        $courseid = $this->get_courseid();
+        $context = \context_course::instance($courseid);
+
+        if (!has_capability('moodle/course:changesummary', $context, $this->task->get_userid())) {
+            return;
+        }
+
+        if (!isset($data->summary) || trim((string) $data->summary) === '') {
+            return;
+        }
+
+        $currentsummary = $DB->get_field('course', 'summary', ['id' => $courseid]);
+        if ($currentsummary !== false && trim((string) $currentsummary) !== '') {
+            // The uploaded data defined its own summary, keep it.
+            return;
+        }
+
+        $record = (object) [
+            'id' => $courseid,
+            'summary' => $data->summary,
+        ];
+        if (isset($data->summaryformat)) {
+            $record->summaryformat = $data->summaryformat;
+        }
+        $DB->update_record('course', $record);
+        $this->summaryrestored = true;
+    }
+
+    /**
+     * Restore the files related to the course summary and the course overview files.
+     */
+    protected function after_execute() {
+        $context = \context_course::instance($this->get_courseid());
+        $fs = get_file_storage();
+
+        if ($this->summaryrestored && $fs->is_area_empty($context->id, 'course', 'summary')) {
+            $this->add_related_files('course', 'summary', null);
+        }
+
+        if ($fs->is_area_empty($context->id, 'course', 'overviewfiles')) {
+            $this->add_related_files('course', 'overviewfiles', null);
+        }
+    }
+}
