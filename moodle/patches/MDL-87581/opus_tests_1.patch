+    /**
+     * Test that the summary and overview files of the template course are restored.
+     */
+    public function test_restore_course_summary_and_overviewfiles(): void {
+        global $DB;
+        $this->initialise_test();
+        $this->setAdminUser();
+
+        $c1 = $this->getDataGenerator()->create_course(['summary' => 'Template summary', 'summaryformat' => FORMAT_HTML]);
+        $c1context = \context_course::instance($c1->id);
+        $fs = get_file_storage();
+        $filerecord = ['contextid' => $c1context->id, 'component' => 'course', 'itemid' => 0, 'filepath' => '/'];
+        $fs->create_file_from_string($filerecord + ['filearea' => 'overviewfiles', 'filename' => 'image.png'], 'img');
+        $fs->create_file_from_string($filerecord + ['filearea' => 'summary', 'filename' => 'summary.txt'], 'txt');
+
+        $mode = tool_uploadcourse_processor::MODE_CREATE_NEW;
+        $updatemode = tool_uploadcourse_processor::UPDATE_ALL_WITH_DATA_ONLY;
+
+        // Without a summary in the upload, the template one is used.
+        $data = ['shortname' => 'A1', 'templatecourse' => $c1->shortname, 'category' => 1, 'fullname' => 'A1'];
+        $co = new tool_uploadcourse_course($mode, $updatemode, $data);
+        $this->assertTrue($co->prepare());
+        $co->proceed();
+        $course = $DB->get_record('course', ['shortname' => 'A1']);
+        $this->assertEquals('Template summary', $course->summary);
+        $this->assertEquals('A1', $course->fullname);
+        $context = \context_course::instance($course->id);
+        $files = $fs->get_area_files($context->id, 'course', 'overviewfiles', false, 'filename', false);
+        $this->assertCount(1, $files);
+        $this->assertEquals('image.png', reset($files)->get_filename());
+        $files = $fs->get_area_files($context->id, 'course', 'summary', false, 'filename', false);
+        $this->assertCount(1, $files);
+
+        // With a summary in the upload, it takes precedence over the template one.
+        $data = ['shortname' => 'B1', 'templatecourse' => $c1->shortname, 'summary' => 'B', 'category' => 1,
+            'fullname' => 'B1'];
+        $co = new tool_uploadcourse_course($mode, $updatemode, $data);
+        $this->assertTrue($co->prepare());
+        $co->proceed();
+        $course = $DB->get_record('course', ['shortname' => 'B1']);
+        $this->assertEquals('B', $course->summary);
+        $context = \context_course::instance($course->id);
+        $this->assertCount(1, $fs->get_area_files($context->id, 'course', 'overviewfiles', false, 'filename', false));
+    }
