+namespace tool_uploadcourse\local;
+
+defined('MOODLE_INTERNAL') || die();
+
+global $CFG;
+require_once($CFG->dirroot . '/backup/util/includes/restore_includes.php');
+
+/**
+ * Restore step restoring the course summary and the course overview files when importing into an existing course.
+ *
+ * When importing a template into a course (backup::TARGET_CURRENT_ADDING) the core restore_course_structure_step is
+ * not executed (unless overwrite_conf is enabled), so the course summary and overview files of the template are lost.
+ * This step only fills in the summary (and its files) when the target course does not have any, and the overview
+ * files when the target course does not have any, so the values provided in the upload always take precedence.
+ *
+ * The step is added to the course task of the restore plan before the plan is built and executed, so it implements
+ * checksumable to avoid being recursively processed (with its task) when the controller checksum is calculated.
+ *
+ * @package    tool_uploadcourse
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class restore_course_summary_step extends \restore_structure_step implements \checksumable {
+
+    /** @var bool whether the summary was restored from the backup. */
+    protected $summaryrestored = false;
+
+    /**
+     * Calculate a stable checksum for the step.
+     *
+     * @return string
+     */
+    public function calculate_checksum() {
+        return md5(static::class . '-' . $this->get_name() . '-' . $this->filename);
+    }
+
+    /**
+     * Check whether the given checksum matches the step one.
+     *
+     * @param string $checksum
+     * @return bool
+     */
+    public function is_checksum_correct($checksum) {
+        return $this->calculate_checksum() === $checksum;
+    }
+
+    /**
+     * Define the structure to be processed.
+     *
+     * @return \restore_path_element[]
+     */
+    protected function define_structure() {
+        return [new \restore_path_element('course', '/course')];
+    }
+
+    /**
+     * Process the course element, restoring the summary if the target course has none.
+     *
+     * @param array $data
+     */
+    public function process_course($data) {
+        global $DB;
+
+        $data = (object) $data;
+        $courseid = $this->get_courseid();
+        $context = \context_course::instance($courseid);
+
+        if (!isset($data->summary) || trim((string) $data->summary) === '') {
+            return;
+        }
+        if (!has_capability('moodle/course:changesummary', $context, $this->task->get_userid())) {
+            return;
+        }
+
+        $current = $DB->get_record('course', ['id' => $courseid], 'id, summary, summaryformat', MUST_EXIST);
+        if (trim((string) $current->summary) !== '') {
+            // The summary was explicitly set, do not overwrite it.
+            return;
+        }
+
+        $record = (object) [
+            'id' => $courseid,
+            'summary' => $data->summary,
+        ];
+        if (isset($data->summaryformat)) {
+            $record->summaryformat = $data->summaryformat;
+        }
+        $DB->update_record('course', $record);
+        $this->summaryrestored = true;
+    }
+
+    /**
+     * Restore the related files.
+     */
+    protected function after_execute() {
+        if ($this->summaryrestored) {
+            $this->add_related_files('course', 'summary', null);
+        }
+
+        $fs = get_file_storage();
+        $context = \context_course::instance($this->get_courseid());
+        if ($fs->is_area_empty($context->id, 'course', 'overviewfiles')) {
+            $this->add_related_files('course', 'overviewfiles', null);
+        }
+    }
+}
