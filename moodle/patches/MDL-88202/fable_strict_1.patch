diff --git a/public/lib/tests/questionlib_test.php b/public/lib/tests/questionlib_test.php
index 72631d613ef..cd63889af2f 100644
--- a/public/lib/tests/questionlib_test.php
+++ b/public/lib/tests/questionlib_test.php
@@ -403,6 +403,60 @@ final class questionlib_test extends \advanced_testcase {
         $this->assertEquals($targetcourseid, $newcourse->id);
     }
 
+    /**
+     * Test question_category_delete_safe on a category whose context no longer exists (an orphaned category),
+     * as handled by admin/cli/fix_orphaned_question_categories.php. Questions still in use must be rescued
+     * to the site course system question bank.
+     *
+     * @covers ::question_category_delete_safe
+     */
+    public function test_question_category_delete_safe_orphaned_context(): void {
+        global $DB;
+        $this->resetAfterTest(true);
+        $this->setAdminUser();
+
+        [, , , $qcat, $questions] = $this->setup_quiz_and_questions();
+
+        // Delete the context, to simulate what happens in old sites where referential integrity has failed.
+        $DB->delete_records('context', ['id' => $qcat->contextid]);
+        \context_helper::reset_caches();
+
+        // Reload the category the same way the CLI script does.
+        $orphanedcat = $DB->get_record('question_categories', ['id' => $qcat->id], 'id, contextid, name', MUST_EXIST);
+
+        question_category_delete_safe($orphanedcat);
+
+        // Unused question was deleted without a valid context, so debugging was triggered.
+        $this->assertDebuggingCalled();
+
+        // Verify category deleted.
+        $this->assertEquals(0, $DB->count_records('question_categories', ['id' => $qcat->id]));
+
+        // Verify the unused question was deleted.
+        $this->assertFalse($DB->record_exists('question', ['id' => $questions[1]->id]));
+
+        // Verify the used question was not deleted.
+        $savedquestion = $DB->get_record_sql(
+            "SELECT q.*, qbe.questioncategoryid
+               FROM {question} q
+                    JOIN {question_versions} qv ON qv.questionid = q.id
+                    JOIN {question_bank_entries} qbe ON qv.questionbankentryid = qbe.id
+              WHERE q.id = :id",
+            ['id' => $questions[0]->id]
+        );
+        $this->assertNotEmpty($savedquestion);
+
+        // Verify question now sits in the system qbank of the site course.
+        $this->assertNotEquals($qcat->id, $savedquestion->questioncategoryid);
+        $newcategory = $DB->get_record('question_categories', ['id' => $savedquestion->questioncategoryid], strictness: MUST_EXIST);
+        $newcategorycontext = context::instance_by_id($newcategory->contextid);
+        $this->assertEquals(\context_module::LEVEL, $newcategorycontext->contextlevel);
+        [$newcourse, $newcm] = get_course_and_cm_from_cmid($newcategorycontext->instanceid);
+        $this->assertEquals('qbank', $newcm->modname);
+        $this->assertEquals(question_bank_helper::TYPE_SYSTEM, $DB->get_field('qbank', 'type', ['id' => $newcm->instance]));
+        $this->assertEquals(SITEID, $newcourse->id);
+    }
+
     /**
