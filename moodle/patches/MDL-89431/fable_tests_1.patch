+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+namespace aiprovider_gemini\aimodel;
+
+/**
+ * Gemini image model interface.
+ *
+ * Image generation models reachable through the Gemini API speak one of two
+ * different protocols: the legacy Imagen ":predict" protocol, or the native
+ * Gemini ":generateContent" protocol. Each protocol uses a different request
+ * and response schema, so the processor needs to know which one to use.
+ *
+ * @package    aiprovider_gemini
+ * @copyright  2026 Anupama Sarjoshi <anupama.sarjoshi@moodle.com>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface gemini_image_base {
+    /** @var string PROTOCOL_IMAGEN The Imagen "predict" protocol (instances/parameters request, predictions response). */
+    public const PROTOCOL_IMAGEN = 'imagen';
+    /** @var string PROTOCOL_GENERATE_CONTENT The native Gemini "generateContent" protocol (contents/candidates). */
+    public const PROTOCOL_GENERATE_CONTENT = 'generatecontent';
+
+    /**
+     * Get the image generation protocol spoken by this model.
+     *
+     * @return string One of the PROTOCOL_* constants.
+     */
+    public function get_image_protocol(): string;
+
+    /**
+     * Get the maximum number of images this model can return in a single API call.
+     *
+     * @return int The maximum number of images per call.
+     */
+    public function get_max_images_per_request(): int;
+}
