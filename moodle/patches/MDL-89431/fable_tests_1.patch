+    public function test_get_image_protocol(): void {
+        $method = new \ReflectionMethod(process_generate_image::class, 'get_image_protocol');
+
+        // Imagen model class.
+        $processor = new process_generate_image($this->provider, $this->action);
+        $this->assertEquals(gemini_image_base::PROTOCOL_IMAGEN, $method->invoke($processor));
+
+        // Gemini image model class.
+        $provider = $this->create_provider(
+            actionclass: \core_ai\aiactions\generate_image::class,
+            actionconfig: [
+                'model' => 'gemini-3.1-flash-image',
+                'endpoint' => 'https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent',
+            ],
+        );
+        $processor = new process_generate_image($provider, $this->action);
+        $this->assertEquals(gemini_image_base::PROTOCOL_GENERATE_CONTENT, $method->invoke($processor));
+
+        // Custom model with a generateContent endpoint.
+        $provider = $this->create_provider(
+            actionclass: \core_ai\aiactions\generate_image::class,
+            actionconfig: [
+                'model' => 'some-future-image-model',
+                'endpoint' => 'https://generativelanguage.googleapis.com/v1beta/models/some-future-image-model:generateContent',
+            ],
+        );
+        $processor = new process_generate_image($provider, $this->action);
+        $this->assertEquals(gemini_image_base::PROTOCOL_GENERATE_CONTENT, $method->invoke($processor));
+
+        // Custom model with a predict endpoint.
+        $provider = $this->create_provider(
+            actionclass: \core_ai\aiactions\generate_image::class,
+            actionconfig: [
+                'model' => 'imagen-4.0-ultra-generate-001',
+                'endpoint' => 'https://generativelanguage.googleapis.com/v1beta/models/imagen-4.0-ultra-generate-001:predict',
+            ],
+        );
+        $processor = new process_generate_image($provider, $this->action);
+        $this->assertEquals(gemini_image_base::PROTOCOL_IMAGEN, $method->invoke($processor));
+    }
