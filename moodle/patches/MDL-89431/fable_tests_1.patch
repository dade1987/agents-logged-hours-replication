+    /**
+     * Test the image model classes declare the expected protocol and endpoint.
+     */
+    public function test_image_model_classes(): void {
+        $expected = [
+            'gemini-3.1-flash-image' => gemini_image_base::PROTOCOL_GENERATE_CONTENT,
+            'gemini-3.1-flash-lite-image' => gemini_image_base::PROTOCOL_GENERATE_CONTENT,
+            'gemini-3-pro-image' => gemini_image_base::PROTOCOL_GENERATE_CONTENT,
+            'imagen-4.0-generate-001' => gemini_image_base::PROTOCOL_IMAGEN,
+        ];
+        foreach ($expected as $modelname => $protocol) {
+            $model = helper::get_model_class($modelname);
+            $this->assertInstanceOf(gemini_image_base::class, $model, $modelname);
+            $this->assertContains(\aiprovider_gemini\aimodel\gemini_base::MODEL_TYPE_IMAGE, $model->model_type());
+            $this->assertEquals($protocol, $model->get_image_protocol());
+            if ($protocol === gemini_image_base::PROTOCOL_GENERATE_CONTENT) {
+                $this->assertStringEndsWith(":generateContent", $model->get_model_endpoint());
+                $this->assertEquals(1, $model->get_max_images_per_request());
+            } else {
+                $this->assertStringEndsWith(":predict", $model->get_model_endpoint());
+            }
+            $this->assertStringContainsString("/models/{$modelname}:", $model->get_model_endpoint());
+        }
+    }
