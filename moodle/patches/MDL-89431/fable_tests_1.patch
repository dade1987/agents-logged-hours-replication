+    /**
+     * Test the API success response handler surfaces Gemini safety filtering as errors.
+     */
+    public function test_handle_api_success_generate_content_blocked(): void {
+        $provider = $this->create_provider(
+            actionclass: \core_ai\aiactions\generate_image::class,
+            actionconfig: [
+                'model' => 'gemini-3.1-flash-image',
+                'endpoint' => 'https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent',
+            ],
+        );
+        $this->setAdminUser();
+        $processor = new process_generate_image($provider, $this->action);
+        $method = new \ReflectionMethod($processor, 'handle_api_success');
+
+        // Prompt blocked.
+        $response = new Response(200, ['Content-Type' => 'application/json'], json_encode([
+            'promptFeedback' => ['blockReason' => 'PROHIBITED_CONTENT'],
+        ]));
+        $result = $method->invoke($processor, $response);
+        $this->assertFalse($result['success']);
+        $this->assertEquals(422, $result['errorcode']);
+        $this->assertStringContainsString('PROHIBITED_CONTENT', $result['errormessage']);
+
+        // Candidate without image part and a non-STOP finish reason.
+        $response = new Response(200, ['Content-Type' => 'application/json'], json_encode([
+            'candidates' => [
+                [
+                    'content' => ['parts' => [['text' => 'Sorry, I cannot do that.']], 'role' => 'model'],
+                    'finishReason' => 'IMAGE_SAFETY',
+                ],
+            ],
+        ]));
+        $result = $method->invoke($processor, $response);
+        $this->assertFalse($result['success']);
+        $this->assertEquals(422, $result['errorcode']);
+        $this->assertStringContainsString('IMAGE_SAFETY', $result['errormessage']);
+
+        // No candidates at all.
+        $response = new Response(200, ['Content-Type' => 'application/json'], json_encode(['candidates' => []]));
+        $result = $method->invoke($processor, $response);
+        $this->assertFalse($result['success']);
+        $this->assertEquals(422, $result['errorcode']);
+        $this->assertEquals(get_string('error:noimagereturned', 'aiprovider_gemini'), $result['errormessage']);
+    }
