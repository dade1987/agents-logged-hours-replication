+<?php
+// This file is part of Moodle - http://moodle.org/
+//
+// Moodle is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// Moodle is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace aiprovider_gemini\aimodel;
+
+/**
+ * Gemini base AI image generation model interface.
+ *
+ * Google exposes two different image generation protocols through the Gemini API:
+ *
+ * - The Imagen "predict" protocol (instances[].prompt / predictions[].bytesBase64Encoded).
+ * - The Gemini native "generateContent" protocol (contents[].parts[].text /
+ *   candidates[].content.parts[].inlineData).
+ *
+ * Image models implement this interface to declare which protocol they speak, so the
+ * image processor can build the correct request body and parse the correct response.
+ *
+ * @package    aiprovider_gemini
+ * @copyright  2026 Anupama Sarjoshi <anupama.sarjoshi@moodle.com>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+interface gemini_image_base extends gemini_base {
+    /** @var string Imagen ":predict" protocol. */
+    public const PROTOCOL_IMAGEN = 'imagen';
+    /** @var string Gemini native ":generateContent" protocol. */
+    public const PROTOCOL_GENERATE_CONTENT = 'generatecontent';
+
+    /**
+     * Get the image generation protocol used by this model.
+     *
+     * @return string One of the PROTOCOL_* constants.
+     */
+    public function get_image_protocol(): string;
+
+    /**
+     * Convert the given orientation to an aspect ratio supported by the model.
+     *
+     * @param string $orientation The orientation of the image (square, landscape, portrait).
+     * @return string The aspect ratio string for the API request (e.g. '1:1').
+     */
+    public function calculate_aspect_ratio(string $orientation): string;
+
+    /**
+     * Convert the given quality to an image size supported by the model.
+     *
+     * Return null if the model does not support an image size parameter.
+     *
+     * @param string $quality The quality of the image (standard, hd).
+     * @return string|null The image size string for the API request, or null to omit the parameter.
+     */
+    public function calculate_image_size(string $quality): ?string;
+}
diff --git a/public/ai/provider/gemini/classes/aimodel/gemini_image_trait.php b/public/ai/provider/gemini/classes/aimodel/gemini_image_trait.php
new file mode 100644
