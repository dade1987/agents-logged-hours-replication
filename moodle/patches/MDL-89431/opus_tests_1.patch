+    /**
+     * Test create_request_object for a Gemini native image model (generateContent protocol).
+     */
+    public function test_create_request_object_gemini(): void {
+        $provider = $this->create_provider(
+            actionclass: \core_ai\aiactions\generate_image::class,
+            actionconfig: [
+                'model' => 'gemini-3.1-flash-image',
+                'endpoint' => 'https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent',
+            ],
+        );
+        $processor = new process_generate_image($provider, $this->action);
+
+        $method = new \ReflectionMethod($processor, 'create_request_object');
+        $request = $method->invoke($processor, 1);
+
+        $requestdata = json_decode($request->getBody()->getContents());
+
+        $this->assertObjectNotHasProperty('instances', $requestdata);
+        $this->assertObjectNotHasProperty('parameters', $requestdata);
+        $this->assertEquals('This is a test prompt', $requestdata->contents[0]->parts[0]->text);
+        $this->assertEquals(['IMAGE'], $requestdata->generationConfig->responseModalities);
+        $this->assertEquals('1:1', $requestdata->generationConfig->imageConfig->aspectRatio);
+        $this->assertEquals('2K', $requestdata->generationConfig->imageConfig->imageSize);
+    }
+
+    /**
+     * Data provider for test_get_image_api.
+     *
+     * @return array
+     */
+    public static function get_image_api_provider(): array {
+        $base = 'https://generativelanguage.googleapis.com/v1beta/models/';
+        return [
+            'Imagen model class' => ['imagen-4.0-generate-001', $base . 'imagen-4.0-generate-001:predict', 'predict'],
+            'Gemini 3.1 Flash Image' => ['gemini-3.1-flash-image', $base . 'gemini-3.1-flash-image:generateContent',
+                'generateContent'],
+            'Gemini 3.1 Flash Lite Image' => ['gemini-3.1-flash-lite-image',
+                $base . 'gemini-3.1-flash-lite-image:generateContent', 'generateContent'],
+            'Gemini 3 Pro Image' => ['gemini-3-pro-image', $base . 'gemini-3-pro-image:generateContent', 'generateContent'],
+            'Custom imagen model' => ['imagen-4.0-ultra-generate-001', $base . 'imagen-4.0-ultra-generate-001:predict',
+                'predict'],
+            'Custom model, predict endpoint' => ['mymodel', 'https://proxy.example.com/v1/models/mymodel:predict', 'predict'],
+            'Custom model, generateContent endpoint' => ['gemini-2.5-flash-image',
+                $base . 'gemini-2.5-flash-image:generateContent', 'generateContent'],
+        ];
+    }
+
+    /**
+     * Test the image protocol detection.
+     *
+     * @param string $model The configured model.
+     * @param string $endpoint The configured endpoint.
+     * @param string $expected The expected protocol.
+     */
+    #[\PHPUnit\Framework\Attributes\DataProvider('get_image_api_provider')]
