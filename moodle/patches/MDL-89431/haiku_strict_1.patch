     }
+
+    /**
+     * Create a provider configured for the Gemini native image model.
+     *
+     * @return provider
+     */
+    private function create_native_image_provider(): provider {
+        return $this->create_provider(
+            actionclass: \core_ai\aiactions\generate_image::class,
+            actionconfig: [
+                'model' => 'gemini-3.1-flash-image',
+                'endpoint' => 'https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent',
+            ],
+        );
+    }
+
+    /**
+     * Test create_request_object uses the Gemini generateContent body for native image models.
+     */
+    public function test_create_request_object_native(): void {
+        $processor = new process_generate_image($this->create_native_image_provider(), $this->action);
+
+        $method = new \ReflectionMethod($processor, 'create_request_object');
+        $request = $method->invoke($processor, 1);
+
+        $requestdata = json_decode($request->getBody()->getContents());
+
+        $this->assertEquals('This is a test prompt', $requestdata->contents[0]->parts[0]->text);
+        $this->assertEquals(['IMAGE'], $requestdata->generationConfig->responseModalities);
+        $this->assertEquals('1:1', $requestdata->generationConfig->imageConfig->aspectRatio);
+        $this->assertEquals('2K', $requestdata->generationConfig->imageConfig->imageSize);
+        $this->assertObjectNotHasProperty('instances', $requestdata);
+        $this->assertObjectNotHasProperty('parameters', $requestdata);
+    }
+
+    /**
+     * Test handle_api_success parses the inline image data of a Gemini native image response.
+     */
+    public function test_handle_api_success_native(): void {
+        $body = file_get_contents(self::get_fixture_path('aiprovider_gemini', 'image_native_request_success.json'));
+        $response = new Response(200, ['Content-Type' => 'application/json'], Utils::streamFor($body));
+
+        $this->setAdminUser();
+
+        $processor = new process_generate_image($this->create_native_image_provider(), $this->action);
+        $method = new \ReflectionMethod($processor, 'handle_api_success');
+
+        $result = $method->invoke($processor, $response);
+
+        $this->assertTrue($result['success']);
+        $this->assertEquals('7cc6025f8a6ce71a.png', $result['draftfile']->get_filename());
+    }
+
+    /**
+     * Test handle_api_success reports the block reason when a native image response contains no image.
+     */
+    public function test_handle_api_success_native_blocked(): void {
+        $body = json_encode([
+            'promptFeedback' => ['blockReason' => 'SAFETY'],
+        ]);
+        $response = new Response(200, ['Content-Type' => 'application/json'], Utils::streamFor($body));
+
+        $this->setAdminUser();
+
+        $processor = new process_generate_image($this->create_native_image_provider(), $this->action);
+        $method = new \ReflectionMethod($processor, 'handle_api_success');
+
+        $result = $method->invoke($processor, $response);
+
+        $this->assertFalse($result['success']);
+        $this->assertEquals(422, $result['errorcode']);
+        $this->assertStringContainsString('SAFETY', $result['errormessage']);
+    }
 }
