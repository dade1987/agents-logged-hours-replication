+        return [self::MODEL_TYPE_IMAGE];
+    }
+
+    #[\Override]
+    public function get_model_endpoint(): string {
+        return 'https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent';
+    }
+}
