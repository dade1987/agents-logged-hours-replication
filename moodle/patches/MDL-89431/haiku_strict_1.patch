+    #[\Override]
+    public function get_model_name(): string {
+        return 'gemini-3.1-flash-image';
+    }
+
+    #[\Override]
+    public function get_model_display_name(): string {
+        return 'Gemini 3.1 Flash Image';
+    }
+
+    #[\Override]
