+        if (!empty($bodyobj->predictions[0]->raiFilteredReason)) {
+            $reasons[] = $bodyobj->predictions[0]->raiFilteredReason;
+        }
+
+        $message = 'No image was returned by the AI model.';
+        if (!empty($reasons)) {
+            $message .= ' ' . implode(' ', $reasons);
