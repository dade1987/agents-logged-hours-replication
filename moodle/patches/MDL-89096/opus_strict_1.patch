diff --git a/public/lib/tests/plugin_manager_test.php b/public/lib/tests/plugin_manager_test.php
index cdd59b5f1a4..b9b5fcfceec 100644
--- a/public/lib/tests/plugin_manager_test.php
+++ b/public/lib/tests/plugin_manager_test.php
@@ -1090,4 +1090,39 @@ final class plugin_manager_test extends \advanced_testcase {
         );
         $this->assertDebuggingCalled();
     }
+
+    /**
+     * Test that orphaned subplugins (whose parent plugin was removed from disk) are recognised and can be uninstalled.
+     *
+     * @covers \core\plugininfo\orphaned::get_plugins
+     */
+    public function test_orphaned_subplugins(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        // Simulate an installed subplugin of a plugin type that no longer exists on disk.
+        set_config('version', 2025010100, 'xxxorphanedtype_alpha');
+        set_config('version', 2025010100, 'xxxorphanedtype_beta');
+        core_plugin_manager::reset_caches();
+
+        $pluginman = core_plugin_manager::instance();
+        $plugins = $pluginman->get_plugins_of_type('xxxorphanedtype');
+        $this->assertCount(2, $plugins);
+        $this->assertArrayHasKey('alpha', $plugins);
+        $this->assertArrayHasKey('beta', $plugins);
+
+        $plugin = $plugins['alpha'];
+        $this->assertInstanceOf(\core\plugininfo\orphaned::class, $plugin);
+        $this->assertSame('xxxorphanedtype_alpha', $plugin->component);
+        $this->assertSame(core_plugin_manager::PLUGIN_STATUS_MISSING, $plugin->get_status());
+
+        $plugininfo = $pluginman->get_plugin_info('xxxorphanedtype_alpha');
+        $this->assertInstanceOf(\core\plugininfo\orphaned::class, $plugininfo);
+        $this->assertTrue($pluginman->can_uninstall_plugin('xxxorphanedtype_alpha'));
+
+        $progress = new \null_progress_trace();
+        $this->assertTrue($pluginman->uninstall_plugin('xxxorphanedtype_alpha', $progress));
+        $this->assertFalse($DB->record_exists('config_plugins', ['plugin' => 'xxxorphanedtype_alpha']));
+        $this->assertTrue($DB->record_exists('config_plugins', ['plugin' => 'xxxorphanedtype_beta']));
+    }
 }
