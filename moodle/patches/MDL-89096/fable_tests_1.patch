+    /**
+     * Test that orphaned subplugins (whose parent plugin and subplugin type are missing from disk)
+     * are correctly identified and can be uninstalled.
+     *
+     * @covers \core\plugininfo\orphaned::get_plugins
+     * @covers ::can_uninstall_plugin
+     */
+    public function test_can_uninstall_orphaned_subplugin(): void {
+        $this->resetAfterTest();
+
+        // Simulate a subplugin whose parent plugin (and thus its subplugin type) has been removed from disk.
+        set_config('version', 2025010100, 'xxxxxxxsub_alpha');
+        core_plugin_manager::reset_caches();
+
+        $pluginman = core_plugin_manager::instance();
+
+        $plugininfo = $pluginman->get_plugin_info('xxxxxxxsub_alpha');
+        $this->assertInstanceOf(\core\plugininfo\orphaned::class, $plugininfo);
+        $this->assertSame('xxxxxxxsub', $plugininfo->type);
+        $this->assertSame('alpha', $plugininfo->name);
+        $this->assertSame('xxxxxxxsub_alpha', $plugininfo->component);
+        $this->assertSame(core_plugin_manager::PLUGIN_STATUS_MISSING, $plugininfo->get_status());
+
+        // The orphaned subplugin is also listed by get_plugins() with a proper component name.
+        $plugins = $pluginman->get_plugins();
+        $this->assertArrayHasKey('xxxxxxxsub', $plugins);
+        $this->assertArrayHasKey('alpha', $plugins['xxxxxxxsub']);
+        $this->assertSame('xxxxxxxsub_alpha', $plugins['xxxxxxxsub']['alpha']->component);
+
+        // The orphaned subplugin can be uninstalled.
+        $this->assertTrue($pluginman->can_uninstall_plugin('xxxxxxxsub_alpha'));
+        $this->assertTrue($pluginman->can_uninstall_plugin($plugins['xxxxxxxsub']['alpha']->component));
+        $this->assertInstanceOf(\moodle_url::class, $pluginman->get_uninstall_url('xxxxxxxsub_alpha'));
+    }
+
