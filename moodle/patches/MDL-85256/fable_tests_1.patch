+    /**
+     * Test that body parts with incomplete MIME structures and no charset are parsed without errors.
+     *
+     * @param array $partstructure The body part structure as returned by the IMAP server.
+     * @param string $body The raw body content of the part.
+     * @param string $expectedplain The expected plain text content.
+     * @param string $expectedhtml The expected HTML content.
+     * @param array $expectedattachments The expected list of attachment filenames keyed by disposition.
+     */
+    #[DataProvider('process_message_data_body_part_provider')]
+    public function test_process_message_data_body_part(
+        array $partstructure,
+        string $body,
+        string $expectedplain,
+        string $expectedhtml,
+        array $expectedattachments,
+    ): void {
+        $manager = new \tool_messageinbound\manager();
+
+        $messagedata = new \rcube_message_header();
+        $messagedata->bodypart = ['1' => $body];
+
+        $client = $this->createMock(\rcube_imap_generic::class);
+        $client->selected = 'INBOX';
+        $client->method('fetch')->willReturn([$messagedata]);
+
+        $rc = new \ReflectionClass($manager);
+        $rc->getProperty('client')->setValue($manager, $client);
+
+        $contentplain = '';
+        $contenthtml = '';
+        $attachments = ['inline' => [], 'attachment' => []];
+        $parameters = [];
+
+        $rc->getMethod('process_message_data_body_part')->invokeArgs($manager, [
+            1,
+            $partstructure,
+            '1',
+            &$contentplain,
+            &$contenthtml,
+            &$attachments,
+            &$parameters,
+        ]);
+
+        $this->assertSame($expectedplain, $contentplain);
+        $this->assertSame($expectedhtml, $contenthtml);
+        $this->assertSame(
+            $expectedattachments,
+            array_map(fn($list) => array_map(fn($a) => $a->filename, $list), $attachments),
+        );
+    }
+
+    /**
+     * Data provider for test_process_message_data_body_part.
+     *
+     * @return array
+     */
+    public static function process_message_data_body_part_provider(): array {
+        $noattachments = ['inline' => [], 'attachment' => []];
+        return [
+            'Complete structure with charset' => [
+                ['TEXT', 'PLAIN', ['CHARSET', 'UTF-8'], null, null, '7BIT', '11', null, null, null],
+                'Hello world',
+                'Hello world',
+                '',
+                $noattachments,
+            ],
+            'Missing charset' => [
+                ['TEXT', 'PLAIN', [], null, null, '7BIT', '11', null, null, null],
+                'Hello world',
+                'Hello world',
+                '',
+                $noattachments,
+            ],
+            'Missing attributes key' => [
+                [0 => 'TEXT', 1 => 'HTML', 5 => 'QUOTED-PRINTABLE'],
+                "<p>Caf=C3=A9</p>",
+                '',
+                '<p>Café</p>',
+                $noattachments,
+            ],
+            'Missing encoding key' => [
+                [0 => 'TEXT', 1 => 'PLAIN', 2 => ['CHARSET', 'ISO-8859-1']],
+                "Caf\xE9",
+                'Café',
+                '',
+                $noattachments,
+            ],
+            'Only type present' => [
+                ['TEXT'],
+                'Hello world',
+                '',
+                '',
+                $noattachments,
+            ],
+            'Attachment without disposition or size' => [
+                ['APPLICATION', 'OCTET-STREAM', ['NAME', 'file.txt'], null, null, 'BASE64'],
+                base64_encode('Hello world'),
+                '',
+                '',
+                ['inline' => [], 'attachment' => ['file.txt']],
+            ],
+        ];
+    }
