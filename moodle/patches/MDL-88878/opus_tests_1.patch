+    /**
+     * Test create_request_object does not escape slashes in the model name.
+     */
+    public function test_create_request_object_model_with_slash(): void {
+        $this->provider = $this->create_provider(
+            actionclass: \core_ai\aiactions\generate_text::class,
+            actionconfig: [
+                'model' => 'cortecs/Llama-3.3-70B-Instruct-FP8-Dynamic',
+                'systeminstruction' => get_string('action_generate_text_instruction', 'core_ai'),
+            ],
+        );
+        $processor = new process_generate_text($this->provider, $this->action);
+
+        $method = new \ReflectionMethod($processor, 'create_request_object');
+        $request = $method->invoke($processor, 1);
+
+        $rawbody = $request->getBody()->getContents();
+        $this->assertStringContainsString('"model":"cortecs/Llama-3.3-70B-Instruct-FP8-Dynamic"', $rawbody);
+        $this->assertStringNotContainsString('\/', $rawbody);
+        $this->assertEquals('cortecs/Llama-3.3-70B-Instruct-FP8-Dynamic', json_decode($rawbody)->model);
+    }
+
+    /**
+     * Test the API error response handler with an empty response body.
+     */
+    public function test_handle_api_error_empty_body(): void {
+        $processor = new process_generate_text($this->provider, $this->action);
+        $method = new \ReflectionMethod($processor, 'handle_api_error');
+
+        $result = $method->invoke($processor, new Response(404, ['Content-Type' => 'application/json'], ''));
+        $this->assertEquals(404, $result['errorcode']);
+        $this->assertEquals('Not Found', $result['errormessage']);
+    }
+
