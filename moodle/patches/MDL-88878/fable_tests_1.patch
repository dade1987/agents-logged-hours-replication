diff --git a/public/ai/provider/openai/tests/process_generate_image_test.php b/public/ai/provider/openai/tests/process_generate_image_test.php
index 8a8cf96c3e6..034e6c3d5e1 100644
--- a/public/ai/provider/openai/tests/process_generate_image_test.php
+++ b/public/ai/provider/openai/tests/process_generate_image_test.php
@@ -167,6 +167,27 @@ final class process_generate_image_test extends \advanced_testcase {
         $this->assertEquals('100', $body->max_completion_tokens);
     }
 
+    /**
+     * Test create_request_object does not escape forward slashes in the model name.
+     */
+    public function test_create_request_object_model_with_slash(): void {
+        $this->provider = $this->create_provider(
+            actionclass: \core_ai\aiactions\generate_image::class,
+            actionconfig: [
+                'model' => 'custom-vendor/my-image-model',
+            ],
+        );
+        $processor = new process_generate_image($this->provider, $this->action);
+
+        // We're working with a private method here, so we need to use reflection.
+        $method = new \ReflectionMethod($processor, 'create_request_object');
+        $request = $method->invoke($processor, 1);
+
+        $rawbody = $request->getBody()->getContents();
+        $this->assertStringContainsString('"model":"custom-vendor/my-image-model"', $rawbody);
+        $this->assertStringNotContainsString('\/', $rawbody);
+    }
+
     /**
      * Test the API error response handler method.
      */
