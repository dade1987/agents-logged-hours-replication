+/**
+ * Adhoc task to delete all the block instances of a given block type.
+ *
+ * @package    core
+ * @category   task
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+
+namespace core\task;
+
+/**
+ * Adhoc task that deletes all the block instances (and their contexts, positions and preferences)
+ * of a block type. Used when a block plugin is removed, so that the potentially lengthy deletion
+ * does not have to run synchronously during an upgrade.
+ *
+ * @package    core
+ * @category   task
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class delete_block_instances_task extends adhoc_task {
+
+    /**
+     * Returns the name of the task, shown to admins.
+     *
+     * @return string
+     */
+    public function get_name() {
+        return get_string('taskdeleteblockinstances', 'admin');
+    }
+
+    /**
+     * Creates a new task to delete all the instances of the given block.
+     *
+     * @param string $blockname The block name without the 'block_' prefix, e.g. 'mnet_hosts'.
+     * @return static
+     */
+    public static function instance(string $blockname): static {
+        $task = new static();
+        $task->set_component('core');
+        $task->set_custom_data(['blockname' => $blockname]);
+        return $task;
+    }
+
+    /**
+     * Deletes all the block instances of the block type set in the custom data.
+     *
+     * @return void
+     */
+    public function execute(): void {
+        global $DB;
+
+        $data = $this->get_custom_data();
+        $blockname = $data->blockname;
+
+        $instanceids = $DB->get_fieldset_select('block_instances', 'id', 'blockname = ?', [$blockname]);
+        if (empty($instanceids)) {
+            mtrace("No block instances found for block '{$blockname}'.");
+            return;
+        }
+
+        mtrace("Deleting " . count($instanceids) . " instance(s) of block '{$blockname}'.");
+        blocks_delete_instances($instanceids);
+    }
+}
