+namespace core\task;
+
+/**
+ * Ad-hoc task to delete all instances of a block that has been removed.
+ *
+ * @package    core
+ * @copyright  2026 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class delete_block_instances_task extends adhoc_task {
+    /**
+     * Create a task instance for the given block.
+     *
+     * @param string $blockname Block name (without the block_ prefix).
+     * @return static
+     */
+    public static function instance(string $blockname): static {
+        $task = new static();
+        $task->set_custom_data((object) ['blockname' => $blockname]);
+        return $task;
+    }
+
+    #[\Override]
+    public function execute(): void {
+        global $CFG, $DB;
+        require_once($CFG->libdir . '/blocklib.php');
+
+        $data = $this->get_custom_data();
+        $blockname = $data->blockname;
+
+        $instances = $DB->get_records('block_instances', ['blockname' => $blockname], '', 'id');
+        if ($instances) {
+            blocks_delete_instances(array_keys($instances));
+        }
+    }
+}
