+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\task;
+
+/**
+ * Adhoc task to uninstall a plugin which has been removed from disk.
+ *
+ * This is queued by upgrade steps so that the (potentially lengthy) plugin data cleanup does not
+ * need to be performed synchronously during the upgrade.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class uninstall_plugin_task extends adhoc_task {
+    /**
+     * Create a task for the given plugin.
+     *
+     * @param string $plugintype The plugin type, e.g. 'mod'.
+     * @param string $pluginname The plugin name, e.g. 'chat'.
+     * @return self
+     */
+    public static function instance(string $plugintype, string $pluginname): self {
+        $task = new self();
+        $task->set_custom_data([
+            'plugintype' => $plugintype,
+            'pluginname' => $pluginname,
+        ]);
+        return $task;
+    }
+
+    /**
+     * Run the task.
+     */
+    public function execute(): void {
+        global $CFG;
+        require_once($CFG->libdir . '/adminlib.php');
+
+        $data = $this->get_custom_data();
+        if (empty($data->plugintype) || empty($data->pluginname)) {
+            mtrace('Missing plugin type or name, nothing to uninstall.');
+            return;
+        }
+
+        $type = $data->plugintype;
+        $name = $data->pluginname;
+
+        // If the plugin has been put back on disk in the meantime, do not remove its data.
+        $dir = \core_component::get_plugin_directory($type, $name);
+        if ($dir !== null && file_exists($dir . '/version.php')) {
+            mtrace("Plugin {$type}_{$name} is present on disk, skipping uninstall.");
+            return;
+        }
+
+        uninstall_plugin($type, $name);
+    }
+}
