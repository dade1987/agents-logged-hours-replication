+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\task;
+
+/**
+ * Ad-hoc task to uninstall plugins which have been removed from core.
+ *
+ * Uninstalling a plugin may be a lengthy process (deleting course modules, block instances, files, contexts, etc.).
+ * Rather than performing this synchronously during the core upgrade, the upgrade queues an instance of this
+ * task so that the removal happens in the background once the upgrade has completed.
+ *
+ * The custom data is an object with a 'plugins' property holding a list of objects, each with a 'type' and a
+ * 'name' property. The plugins are uninstalled in the order given. A plugin which is (again) present on disk
+ * is skipped.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class uninstall_removed_plugins_task extends adhoc_task {
+    /**
+     * Create (but do not queue) a new task for the given plugins.
+     *
+     * @param array $plugins list of [type, name] pairs, or frankenstyle component names (e.g. 'mod_chat')
+     * @return self
+     */
+    public static function create(array $plugins): self {
+        $data = [];
+        foreach ($plugins as $plugin) {
+            if (is_string($plugin)) {
+                $pos = strpos($plugin, '_');
+                if ($pos === false) {
+                    throw new \coding_exception("Invalid plugin component '{$plugin}'");
+                }
+                $plugin = [substr($plugin, 0, $pos), substr($plugin, $pos + 1)];
+            }
+            [$type, $name] = array_values((array) $plugin);
+            $data[] = ['type' => (string) $type, 'name' => (string) $name];
+        }
+
+        $task = new self();
+        $task->set_component('core');
+        $task->set_custom_data(['plugins' => $data]);
+        return $task;
+    }
+
+    /**
+     * Queue a task to uninstall the given plugins.
+     *
+     * @param array $plugins list of [type, name] pairs, or frankenstyle component names (e.g. 'mod_chat')
+     */
+    public static function queue(array $plugins): void {
+        if (empty($plugins)) {
+            return;
+        }
+        manager::queue_adhoc_task(self::create($plugins));
+    }
+
+    #[\Override]
+    public function get_name() {
+        return get_string('taskuninstallremovedplugins', 'admin');
+    }
+
+    /**
+     * Whether the given plugin is present on disk.
+     *
+     * @param string $type
+     * @param string $name
+     * @return bool
+     */
+    protected static function plugin_exists_on_disk(string $type, string $name): bool {
+        $dir = \core_component::get_plugin_directory($type, $name);
+        return !empty($dir) && file_exists($dir . '/version.php');
+    }
+
+    #[\Override]
+    public function execute() {
+        global $CFG;
+        require_once($CFG->libdir . '/adminlib.php');
+
+        $data = $this->get_custom_data();
+        $plugins = $data->plugins ?? [];
+
+        foreach ($plugins as $plugin) {
+            $type = $plugin->type ?? '';
+            $name = $plugin->name ?? '';
+            if ($type === '' || $name === '') {
+                continue;
+            }
+            $component = "{$type}_{$name}";
+
+            if (self::plugin_exists_on_disk($type, $name)) {
+                mtrace("Plugin {$component} is present on disk, skipping uninstall.");
+                continue;
+            }
+
+            mtrace("Uninstalling removed plugin {$component}...");
+            $this->uninstall($type, $name);
+            mtrace("Uninstalled {$component}.");
+        }
+    }
+
+    /**
+     * Uninstall a single plugin.
+     *
+     * @param string $type
+     * @param string $name
+     */
+    protected function uninstall(string $type, string $name): void {
+        // The uninstall_plugin() function prints HTML output; we only want the task log to contain plain text.
+        ob_start();
+        try {
+            uninstall_plugin($type, $name);
+        } finally {
+            ob_end_clean();
+        }
+    }
+}
