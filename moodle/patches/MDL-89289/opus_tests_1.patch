+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\task;
+
+/**
+ * Tests for the post-upgrade plugin removal ad-hoc tasks.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(uninstall_removed_plugins_task::class)]
+#[\PHPUnit\Framework\Attributes\CoversClass(remove_qtype_random_task::class)]
+final class uninstall_removed_plugins_task_test extends \advanced_testcase {
+    /**
+     * Test that queueing the task stores the plugins to uninstall.
+     */
+    public function test_queue(): void {
+        $this->resetAfterTest();
+
+        uninstall_removed_plugins_task::queue([['atto', 'bold'], 'editor_atto']);
+        $tasks = manager::get_adhoc_tasks(uninstall_removed_plugins_task::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $this->assertEquals('core', $task->get_component());
+        $plugins = $task->get_custom_data()->plugins;
+        $this->assertCount(2, $plugins);
+        $this->assertEquals('atto', $plugins[0]->type);
+        $this->assertEquals('bold', $plugins[0]->name);
+        $this->assertEquals('editor', $plugins[1]->type);
+        $this->assertEquals('atto', $plugins[1]->name);
+
+        // Queueing nothing does nothing.
+        uninstall_removed_plugins_task::queue([]);
+        $this->assertCount(1, manager::get_adhoc_tasks(uninstall_removed_plugins_task::class));
+    }
+
+    /**
+     * Test that a plugin missing from disk is uninstalled, and a plugin present on disk is not.
+     */
+    public function test_execute(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        // Fake an installed plugin which is no longer on disk.
+        set_config('version', 2024010100, 'block_removedfake');
+        set_config('somesetting', 'value', 'block_removedfake');
+        $DB->insert_record('block', (object) ['name' => 'removedfake', 'visible' => 1, 'cron' => 0, 'lastcron' => 0]);
+        $onlineusersversion = get_config('block_online_users', 'version');
+        $this->assertNotEmpty($onlineusersversion);
+
