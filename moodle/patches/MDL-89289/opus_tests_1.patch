index 00000000000..0689a77d4dd
--- /dev/null
+++ b/public/lib/classes/task/remove_qtype_random_task.php
@@ -0,0 +1,109 @@
+<?php
+// This file is part of Moodle - http://moodle.org/
+//
+// Moodle is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// Moodle is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\task;
+
+use core\local\cli\shutdown;
+
+/**
+ * Ad-hoc task to delete any remaining qtype_random questions and uninstall the qtype_random plugin.
+ *
+ * Any remaining random questions were created during a restore, but never used by anything (otherwise they would have
+ * been converted to question set references and deleted already), so they are all safe to delete.
+ *
+ * This used to happen synchronously during the core upgrade, which could take a long time on large sites.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class remove_qtype_random_task extends adhoc_task {
+    /** @var int Number of questions to process per batch. */
+    const BATCH_SIZE = 50000;
+
+    #[\Override]
+    public function get_name() {
+        return get_string('taskuninstallremovedplugins', 'admin');
+    }
+
+    #[\Override]
+    public function execute() {
+        global $CFG, $DB;
+        require_once($CFG->libdir . '/adminlib.php');
+
+        $lastid = 0;
+        $done = 0;
+        do {
+            // We only need the ID, but can't pass limits to get_fieldset_sql, so we use get_records_sql.
+            $questions = $DB->get_records_sql(
+                "SELECT id FROM {question} WHERE qtype = 'random' AND id > :lastid ORDER BY id",
+                ['lastid' => $lastid],
+                0,
+                static::BATCH_SIZE,
+            );
+            $recordcount = count($questions);
+            $questionids = array_keys($questions);
+            if ($recordcount > 0) {
+                [$insql, $params] = $DB->get_in_or_equal($questionids);
+                $questionversionsandentries = $DB->get_records_select_menu(
+                    'question_versions',
+                    'questionid ' . $insql,
+                    $params,
+                    fields: 'id, questionbankentryid'
+                );
+                $versionids = array_keys($questionversionsandentries);
+                $entryids = array_unique(array_values($questionversionsandentries));
+                // No need to call question_delete_question, it is safe to delete the records directly. See MDL-88393.
+                // These are all random questions, so have no files or other qtype-specific records to clean up.
+                $transaction = $DB->start_delegated_transaction();
+                if ($versionids) {
+                    $DB->delete_records_list('question_versions', 'id', $versionids);
+                }
+                if ($entryids) {
+                    $DB->delete_records_list('question_bank_entries', 'id', $entryids);
+                }
+                $DB->delete_records_list('question', 'id', $questionids);
+                $transaction->allow_commit();
+                $done += $recordcount;
+
+                // Set the start point for the next batch. IDs were fetched in order, so we use the last one we got.
+                $lastid = end($questionids);
+
+                // The task might be running for a long time. If a graceful exit is requested, queue this task again.
+                if ($recordcount === static::BATCH_SIZE && shutdown::should_gracefully_exit()) {
+                    manager::queue_adhoc_task(new static());
+                    mtrace("Deleted {$done} random questions. Graceful exit requested, rescheduled " . static::class);
+                    return;
+                }
+            }
+        } while ($recordcount === static::BATCH_SIZE);
+        mtrace("Deleted {$done} random questions.");
+
+        // Finally, uninstall qtype_random as it's been removed.
+        $dir = \core_component::get_plugin_directory('qtype', 'random');
+        if (!empty($dir) && file_exists($dir . '/version.php')) {
+            mtrace('Plugin qtype_random is present on disk, skipping uninstall.');
+            return;
+        }
+        ob_start();
+        try {
+            uninstall_plugin('qtype', 'random');
+        } finally {
+            ob_end_clean();
+        }
+        mtrace('Uninstalled qtype_random.');
+    }
+}
