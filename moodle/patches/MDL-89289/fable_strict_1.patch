+/**
+ * Queue an ad-hoc task to uninstall a plugin which has been removed from the codebase.
+ *
+ * Uninstalling a plugin (and all of its data) can take a very long time on large sites. Rather than performing
+ * the uninstallation synchronously during the upgrade, the removal is deferred to an ad-hoc task which runs
+ * once the upgrade has completed.
+ *
+ * The task itself checks that the plugin is still missing from disk before uninstalling it.
+ *
+ * @param string $type The plugin type (e.g. 'mod')
+ * @param string $name The plugin name (e.g. 'chat')
+ */
+function upgrade_queue_plugin_uninstall_task(string $type, string $name): void {
+    \core\task\uninstall_plugin_task::queue($type, $name);
+    upgrade_log(UPGRADE_LOG_NORMAL, null, "Queued ad-hoc task to uninstall the {$type}_{$name} plugin.");
+}
