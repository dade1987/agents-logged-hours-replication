+namespace core\task;
+
+use core_component;
+
+/**
+ * Ad-hoc task to uninstall a plugin which has been removed from the Moodle codebase.
+ *
+ * When a plugin is removed from core, the upgrade process previously had to uninstall it synchronously
+ * (deleting all of its instances, data, files, tables, etc.). For sites with a lot of data this can take a very
+ * long time. Instead, the upgrade now queues an instance of this task which performs the uninstallation
+ * once the upgrade has completed.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class uninstall_plugin_task extends adhoc_task {
+    /**
+     * Create a new instance of the task for the given plugin.
+     *
+     * @param string $type The plugin type (e.g. 'mod')
+     * @param string $name The plugin name (e.g. 'chat')
+     * @return self
+     */
+    public static function instance(string $type, string $name): self {
+        $task = new self();
+        $task->set_custom_data([
+            'type' => $type,
+            'name' => $name,
+        ]);
+
+        return $task;
+    }
+
+    /**
+     * Queue an instance of this task for the given plugin, unless an identical task is already queued.
+     *
+     * @param string $type The plugin type (e.g. 'mod')
+     * @param string $name The plugin name (e.g. 'chat')
+     * @return bool Whether a new task was queued
+     */
+    public static function queue(string $type, string $name): bool {
+        return (bool) manager::queue_adhoc_task(self::instance($type, $name), true);
+    }
+
+    #[\Override]
+    public function get_name(): string {
+        return get_string('taskuninstallplugin', 'admin');
+    }
+
+    #[\Override]
+    public function execute() {
+        global $CFG;
+
+        require_once("{$CFG->libdir}/adminlib.php");
+
+        $data = $this->get_custom_data();
+        $type = (string) ($data->type ?? '');
+        $name = (string) ($data->name ?? '');
+
+        if ($type === '' || $name === '') {
+            mtrace('Invalid plugin type or name supplied, nothing to uninstall.');
+            return;
+        }
+
+        $component = "{$type}_{$name}";
+
+        if (core_component::get_plugin_directory($type, $name) !== null) {
+            // The plugin is present on disk (again). Do not remove it.
+            mtrace("The plugin {$component} is present on disk, it will not be uninstalled.");
+            return;
+        }
+
+        if (get_config($component, 'version') === false) {
+            mtrace("The plugin {$component} is not installed, nothing to uninstall.");
+            return;
+        }
+
+        // The uninstall_plugin() function invalidates the hash used to detect whether an upgrade is required.
+        // Remember whether an upgrade was pending before the uninstallation so that we can restore the hash
+        // afterwards. The plugin being uninstalled is not present on disk, so the hash does not change.
+        $versionshash = core_component::get_all_versions_hash();
+        $upgradepending = empty($CFG->allversionshash) || ($CFG->allversionshash !== $versionshash);
+
+        mtrace("Uninstalling plugin {$component}...");
+        uninstall_plugin($type, $name);
+
+        if (!$upgradepending) {
+            set_config('allversionshash', $versionshash);
+        }
+
+        mtrace("The plugin {$component} was uninstalled.");
+    }
+}
