+
+namespace core\task;
+
+/**
+ * Tests for the uninstall_plugin_task ad-hoc task.
+ *
+ * @package   core
+ * @category  test
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \core\task\uninstall_plugin_task
+ */
+final class uninstall_plugin_task_test extends \advanced_testcase {
+    /**
+     * Test that the task can be queued and that it is not queued twice for the same plugin.
+     */
+    public function test_queue(): void {
+        $this->resetAfterTest();
+
+        $this->assertTrue(uninstall_plugin_task::queue('block', 'removed_plugin'));
+        $this->assertFalse(uninstall_plugin_task::queue('block', 'removed_plugin'));
+        $this->assertTrue(uninstall_plugin_task::queue('mod', 'removed_plugin'));
+
+        $tasks = manager::get_adhoc_tasks(uninstall_plugin_task::class);
+        $this->assertCount(2, $tasks);
+
+        $data = array_map(fn (uninstall_plugin_task $task): string => $task->get_custom_data()->type . '_' .
+            $task->get_custom_data()->name, $tasks);
+        sort($data);
+        $this->assertEquals(['block_removed_plugin', 'mod_removed_plugin'], array_values($data));
+    }
+
+    /**
+     * Test that the task does not uninstall a plugin which is present on disk.
+     */
+    public function test_execute_plugin_on_disk(): void {
+        $this->resetAfterTest();
+
+        $version = get_config('mod_forum', 'version');
+        $this->assertNotFalse($version);
+
+        $task = uninstall_plugin_task::instance('mod', 'forum');
+        $this->expectOutputRegex('/present on disk/');
+        $task->execute();
+
+        $this->assertEquals($version, get_config('mod_forum', 'version'));
+    }
+
+    /**
+     * Test that the task does nothing for a plugin which is not installed.
+     */
+    public function test_execute_plugin_not_installed(): void {
+        $this->resetAfterTest();
+
+        $task = uninstall_plugin_task::instance('block', 'removed_plugin');
+        $this->expectOutputRegex('/not installed/');
+        $task->execute();
+    }
+
+    /**
+     * Test that the task uninstalls a plugin which is installed but no longer present on disk.
+     */
+    public function test_execute(): void {
+        global $CFG;
+
+        $this->resetAfterTest();
+
+        // Fake an installed plugin which is missing from disk.
+        set_config('version', 2026010100, 'block_removed_plugin');
+        set_config('someconfig', 'somevalue', 'block_removed_plugin');
+        $this->assertNull(\core_component::get_plugin_directory('block', 'removed_plugin'));
+
+        // Ensure the site is marked as fully upgraded.
+        $hash = \core_component::get_all_versions_hash();
+        set_config('allversionshash', $hash);
+        $this->assertFalse(moodle_needs_upgrading(false));
+
+        $task = uninstall_plugin_task::instance('block', 'removed_plugin');
+        $this->expectOutputRegex('/was uninstalled/');
+        $task->execute();
+
+        $this->assertFalse(get_config('block_removed_plugin', 'version'));
+        $this->assertFalse(get_config('block_removed_plugin', 'someconfig'));
+
+        // The upgrade detection hash must have been preserved, so that an upgrade is not required.
+        $this->assertEquals($hash, $CFG->allversionshash);
+        $this->assertFalse(moodle_needs_upgrading(false));
+    }
+}
