+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\task;
+
+/**
+ * Tests for the post-upgrade plugin uninstall ad-hoc tasks.
+ *
+ * @package    core
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \core\task\uninstall_plugins_task
+ * @covers     \core\task\remove_qtype_random_task
+ */
+final class uninstall_plugins_task_test extends \advanced_testcase {
+    /**
+     * Test that queueing the task stores the plugins, and does not queue duplicates.
+     */
+    public function test_queue(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        uninstall_plugins_task::queue(['tool_removedplugin']);
+        uninstall_plugins_task::queue(['tool_removedplugin']);
+        uninstall_plugins_task::queue([]);
+
+        $tasks = manager::get_adhoc_tasks(uninstall_plugins_task::class);
+        $this->assertCount(1, $tasks);
+        $task = reset($tasks);
+        $this->assertEquals(['tool_removedplugin'], $task->get_custom_data()->plugins);
+        $this->assertEquals('core', $task->get_component());
+        $this->assertEquals(1, $DB->count_records('task_adhoc', ['classname' => '\\' . uninstall_plugins_task::class]));
+    }
+
+    /**
+     * Test that a plugin missing from disk is uninstalled, and plugins still present on disk are left untouched.
+     */
+    public function test_execute(): void {
+        global $CFG;
+        $this->resetAfterTest();
+
+        set_config('version', 2020010100, 'tool_removedplugin');
+        set_config('somesetting', 'value', 'tool_removedplugin');
+        $forumversion = get_config('mod_forum', 'version');
+        $this->assertNotFalse($forumversion);
+        $hash = \core_component::get_all_versions_hash();
+        set_config('allversionshash', $hash);
+
+        uninstall_plugins_task::queue(['tool_removedplugin', 'mod_forum', 'tool_notinstalled']);
+        $this->expectOutputRegex("/Plugin 'tool_removedplugin' uninstalled./");
+        $this->runAdhocTasks(uninstall_plugins_task::class);
+
+        // The removed plugin has been uninstalled.
+        $this->assertFalse(get_config('tool_removedplugin', 'version'));
+        $this->assertFalse(get_config('tool_removedplugin', 'somesetting'));
+
+        // The plugin present on disk is untouched.
+        $this->assertEquals($forumversion, get_config('mod_forum', 'version'));
+
+        // The site is not flagged as requiring an upgrade.
+        $this->assertEquals($hash, $CFG->allversionshash);
+        $this->assertEmpty(manager::get_adhoc_tasks(uninstall_plugins_task::class));
+    }
+
+    /**
+     * Test the removal of qtype_random questions and plugin.
+     */
+    public function test_remove_qtype_random(): void {
+        global $CFG, $DB;
+        require_once($CFG->libdir . '/questionlib.php');
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $course = $this->getDataGenerator()->create_course();
+        $qbank = $this->getDataGenerator()->create_module('qbank', ['course' => $course->id]);
+        $context = \context_module::instance($qbank->cmid);
+        $questiongenerator = $this->getDataGenerator()->get_plugin_generator('core_question');
+        $category = question_get_default_category($context->id, true);
+        $question = $questiongenerator->create_question('truefalse', overrides: ['category' => $category->id]);
+        $random = $questiongenerator->create_question('truefalse', overrides: ['category' => $category->id]);
+        $DB->set_field('question', 'qtype', 'random', ['id' => $random->id]);
+        set_config('version', 2024100700, 'qtype_random');
+
+        remove_qtype_random_task::queue();
+        $this->expectOutputRegex("/Deleted 1 random questions.*Plugin 'qtype_random' uninstalled./s");
+        $this->runAdhocTasks(remove_qtype_random_task::class);
+
+        $this->assertFalse($DB->record_exists('question', ['id' => $random->id]));
+        $this->assertFalse($DB->record_exists('question_versions', ['questionid' => $random->id]));
+        $this->assertFalse($DB->record_exists('question_bank_entries', ['id' => $random->questionbankentryid]));
+        $this->assertTrue($DB->record_exists('question', ['id' => $question->id]));
+        $this->assertFalse(get_config('qtype_random', 'version'));
+    }
