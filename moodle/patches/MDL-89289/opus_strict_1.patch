+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\task;
+
+use core\local\cli\shutdown;
+
+/**
+ * Ad-hoc task to delete any remaining qtype_random questions, and then uninstall qtype_random.
+ *
+ * Any remaining random questions were created during a restore, but never used by anything (otherwise they would have
+ * been converted to question set references and deleted already), so they are all safe to delete.
+ *
+ * This used to be done synchronously during the upgrade, which could take a long time on large sites.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class remove_qtype_random_task extends uninstall_plugins_task {
+    /** @var int The number of questions to delete in each batch. */
+    protected const BATCH_SIZE = 50000;
+
+    /**
+     * Create and queue a new instance of this task.
+     *
+     * @param string[] $plugins Ignored, this task always uninstalls qtype_random.
+     * @return void
+     */
+    public static function queue(array $plugins = []): void {
+        parent::queue(['qtype_random']);
+    }
+
+    #[\Override]
+    public function get_name() {
+        return get_string('taskremoveqtyperandom', 'admin');
+    }
+
+    #[\Override]
+    public function execute() {
+        if (!$this->delete_random_questions()) {
+            // A graceful exit was requested before all the questions were deleted, the task has been queued again.
+            return;
+        }
+
+        $this->uninstall('qtype_random');
+    }
+
+    /**
+     * Delete all the remaining random questions, in batches.
+     *
+     * @return bool True if all the questions were deleted, false if the task was rescheduled before finishing.
+     */
+    protected function delete_random_questions(): bool {
+        global $DB;
+
+        $lastid = 0;
+        $total = 0;
+        do {
+            // We only need the ID, but can't pass limits to get_fieldset_sql, so we use get_records_sql.
+            $questions = $DB->get_records_sql(
+                "SELECT id FROM {question} WHERE qtype = 'random' AND id > :lastid ORDER BY id",
+                ['lastid' => $lastid],
+                0,
+                static::BATCH_SIZE,
+            );
+            $recordcount = count($questions);
+            $questionids = array_keys($questions);
+            if ($recordcount > 0) {
+                [$insql, $params] = $DB->get_in_or_equal($questionids);
+                $questionversionsandentries = $DB->get_records_select_menu(
+                    'question_versions',
+                    'questionid ' . $insql,
+                    $params,
+                    fields: 'id, questionbankentryid'
+                );
+                $versionids = array_keys($questionversionsandentries);
+                $entryids = array_unique(array_values($questionversionsandentries));
+
+                // No need to call question_delete_question, it is safe to delete the records directly. See MDL-88393.
+                // These are all random questions, so have no files or other qtype-specific records to clean up.
+                $transaction = $DB->start_delegated_transaction();
+                if (!empty($versionids)) {
+                    $DB->delete_records_list('question_versions', 'id', $versionids);
+                }
+                if (!empty($entryids)) {
+                    $DB->delete_records_list('question_bank_entries', 'id', $entryids);
+                }
+                $DB->delete_records_list('question', 'id', $questionids);
+                $transaction->allow_commit();
+
+                $total += $recordcount;
+                // Set the start point for the next batch. IDs were fetched in order, so we use the last one we got.
+                $lastid = end($questionids);
+
+                // The task might be running for a long time. If a graceful exit is requested, queue this task again.
+                if ($recordcount === static::BATCH_SIZE && shutdown::should_gracefully_exit()) {
+                    // Queue without checking for an existing task, as this one is still present until it completes.
+                    $task = new static();
+                    $task->set_custom_data($this->get_custom_data());
+                    manager::queue_adhoc_task($task);
+                    mtrace("Deleted {$total} random questions. Graceful exit requested, rescheduled " . static::class);
+                    return false;
+                }
+            }
+        } while ($recordcount === static::BATCH_SIZE);
+
+        mtrace("Deleted {$total} random questions.");
+        return true;
+    }
+}
