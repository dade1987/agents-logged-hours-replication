+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\task;
+
+use core_component;
+
+/**
+ * Ad-hoc task to uninstall plugins which have been removed from disk.
+ *
+ * Uninstalling a plugin can take a long time (for example, an activity module with many instances), so rather than
+ * doing it synchronously during the upgrade process, the upgrade queues this task to perform the removal afterwards.
+ *
+ * The custom data is an object with a 'plugins' property, containing an ordered list of frankenstyle component names
+ * to uninstall. Each plugin is only uninstalled if it is still installed, and is no longer present on disk.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class uninstall_plugins_task extends adhoc_task {
+    /**
+     * Create and queue a new instance of this task to uninstall the given plugins.
+     *
+     * @param string[] $plugins Ordered list of frankenstyle component names, e.g. ['mod_survey']
+     * @return void
+     */
+    public static function queue(array $plugins): void {
+        $plugins = array_values(array_filter($plugins));
+        if (empty($plugins)) {
+            return;
+        }
+        $task = new static();
+        $task->set_custom_data((object) ['plugins' => $plugins]);
+        manager::queue_adhoc_task($task, true);
+    }
+
+    #[\Override]
+    public function get_name() {
+        return get_string('taskuninstallplugins', 'admin');
+    }
+
+    #[\Override]
+    public function execute() {
+        $data = $this->get_custom_data();
+        $plugins = (array) ($data->plugins ?? []);
+
+        foreach ($plugins as $component) {
+            $this->uninstall($component);
+        }
+    }
+
+    /**
+     * Uninstall a single plugin, if it is installed and no longer present on disk.
+     *
+     * @param string $component Frankenstyle component name
+     * @return bool Whether the plugin was uninstalled
+     */
+    protected function uninstall(string $component): bool {
+        global $CFG;
+
+        [$type, $name] = core_component::normalize_component($component);
+        if ($type === 'core' || empty($name)) {
+            mtrace("Invalid plugin '{$component}', skipping.");
+            return false;
+        }
+
+        if (get_config($component, 'version') === false) {
+            mtrace("Plugin '{$component}' is not installed, skipping.");
+            return false;
+        }
+
+        $plugindirectory = core_component::get_plugin_directory($type, $name);
+        if ($plugindirectory !== null && file_exists("{$plugindirectory}/version.php")) {
+            mtrace("Plugin '{$component}' is present on disk, skipping.");
+            return false;
+        }
+
+        require_once($CFG->libdir . '/adminlib.php');
+        require_once($CFG->dirroot . '/course/lib.php');
+
+        mtrace("Uninstalling plugin '{$component}'...");
+
+        // The plugin is not present on disk, so removing it does not change the hash of all versions. Restore it after
+        // the uninstall, so that the site isn't flagged as requiring an upgrade (but only if it wasn't already).
+        $currenthash = core_component::get_all_versions_hash();
+        $previoushash = $CFG->allversionshash ?? '';
+
+        // The uninstall process outputs HTML intended for the upgrade/plugin management pages, discard it.
+        ob_start();
+        try {
+            uninstall_plugin($type, $name);
+        } finally {
+            ob_end_clean();
+        }
+
+        if ($previoushash === $currenthash) {
+            set_config('allversionshash', $currenthash);
+        }
+
+        mtrace("Plugin '{$component}' uninstalled.");
+        return true;
+    }
+}
