--- a/public/lib/tests/db/upgradelib_test.php
+++ b/public/lib/tests/db/upgradelib_test.php
@@ -573,4 +573,34 @@ final class upgradelib_test extends \advanced_testcase {
         $this->assertEquals(expected: 'type/subtype', actual: $customdata->mimetype);
         $this->assertEquals(expected: ['extension1', 'extension2'], actual: $customdata->extensions);
     }
+
+    /**
+     * Ensure that the upgrade_queue_uninstall_plugin_task function performs as expected.
+     *
+     * @covers ::upgrade_queue_uninstall_plugin_task
+     */
+    public function test_upgrade_queue_uninstall_plugin_task(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $clock = $this->mock_clock_with_frozen();
+
+        $conditions = ['component' => 'core', 'classname' => '\\core\\task\\uninstall_plugin_task'];
+
+        // A plugin which is present on disk must not be queued for uninstallation.
+        $this->assertFalse(upgrade_queue_uninstall_plugin_task('block', 'html'));
+        $this->assertEquals(0, $DB->count_records('task_adhoc', $conditions));
+
+        // A plugin which is not present on disk is queued for uninstallation.
+        $this->assertTrue(upgrade_queue_uninstall_plugin_task('editor', 'removededitor', ['removededitorsub']));
+        $record = $DB->get_record('task_adhoc', $conditions, '*', MUST_EXIST);
+
+        // Ensure that the task was created with correct next runtime.
+        $this->assertEquals(expected: $clock->time() - 1, actual: $record->nextruntime);
+
+        // Ensure that the task has the correct custom data.
+        $customdata = json_decode($record->customdata);
+        $this->assertEquals(expected: 'editor', actual: $customdata->plugintype);
+        $this->assertEquals(expected: 'removededitor', actual: $customdata->pluginname);
+        $this->assertEquals(expected: ['removededitorsub'], actual: $customdata->subplugintypes);
+    }
 }
