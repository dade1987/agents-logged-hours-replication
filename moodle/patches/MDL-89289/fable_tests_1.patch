+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\task;
+
+use core_component;
+use core_plugin_manager;
+
+/**
+ * Ad-hoc task that uninstalls a plugin which is no longer present on disk.
+ *
+ * Plugins which have been removed from core are uninstalled as part of the core upgrade. Uninstalling a plugin can be
+ * a lengthy process (for example, removing every activity instance of a removed module from every course), so instead
+ * of running synchronously during the upgrade, the uninstallation is queued as an instance of this ad-hoc task and
+ * performed after the upgrade has completed.
+ *
+ * The task expects the following custom data:
+ *  - plugintype: the type of the plugin to uninstall, e.g. 'mod'.
+ *  - pluginname: the name of the plugin to uninstall, e.g. 'survey'.
+ *  - subplugintypes: (optional) a list of subplugin types declared by the plugin being removed. Because the plugin is
+ *    no longer on disk its subplugin types are unknown to core, so all installed subplugins of these types are
+ *    uninstalled first.
+ *
+ * If the plugin is found to be present on disk when the task runs, nothing is uninstalled.
+ *
+ * @package    core
+ * @copyright  2026 onwards Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class uninstall_plugin_task extends adhoc_task {
+    /**
+     * Create a new instance of the task for the given plugin.
+     *
+     * @param string $plugintype the plugin type, e.g. 'mod'
+     * @param string $pluginname the plugin name, e.g. 'survey'
+     * @param string[] $subplugintypes subplugin types belonging to the plugin which must be uninstalled first
+     * @return self
+     */
+    public static function instance(string $plugintype, string $pluginname, array $subplugintypes = []): self {
+        $task = new self();
+        $task->set_component('core');
+        $task->set_custom_data([
+            'plugintype' => $plugintype,
+            'pluginname' => $pluginname,
+            'subplugintypes' => array_values($subplugintypes),
+        ]);
+        return $task;
+    }
+
+    #[\Override]
+    public function get_name() {
+        return get_string('uninstallplugintask', 'admin');
+    }
+
+    #[\Override]
+    public function execute(): void {
+        global $CFG;
+        require_once($CFG->libdir . '/adminlib.php');
+        require_once($CFG->libdir . '/upgradelib.php');
+        require_once($CFG->dirroot . '/course/lib.php');
+
+        $customdata = $this->get_custom_data();
+        $plugintype = (string) ($customdata->plugintype ?? '');
+        $pluginname = (string) ($customdata->pluginname ?? '');
+        $subplugintypes = (array) ($customdata->subplugintypes ?? []);
+
+        if ($plugintype === '' || $pluginname === '') {
+            mtrace('Invalid plugin type or name provided, nothing to uninstall.');
+            return;
+        }
+
+        $component = "{$plugintype}_{$pluginname}";
+
+        if (self::plugin_exists_on_disk($plugintype, $pluginname)) {
+            mtrace("Plugin {$component} is present on disk, it will not be uninstalled.");
+            return;
+        }
+
+        // Uninstall any orphaned subplugins first. These are no longer known to core because their parent plugin has
+        // been removed from disk, so the standard uninstall process of the parent would not remove them.
+        foreach ($subplugintypes as $subplugintype) {
+            $subplugintype = (string) $subplugintype;
+            if ($subplugintype === '') {
+                continue;
+            }
+            core_plugin_manager::reset_caches();
+            $subplugins = core_plugin_manager::instance()->get_plugins_of_type($subplugintype, true);
+            foreach (array_keys($subplugins) as $subpluginname) {
+                if (self::plugin_exists_on_disk($subplugintype, $subpluginname)) {
+                    mtrace("Subplugin {$subplugintype}_{$subpluginname} is present on disk, it will not be uninstalled.");
+                    continue;
+                }
+                mtrace("Uninstalling subplugin {$subplugintype}_{$subpluginname}.");
+                uninstall_plugin($subplugintype, $subpluginname);
+            }
+        }
+
+        core_plugin_manager::reset_caches();
+        if (!self::plugin_is_installed($plugintype, $pluginname)) {
+            mtrace("Plugin {$component} is not installed, nothing to uninstall.");
+            return;
+        }
+
+        mtrace("Uninstalling plugin {$component}.");
+        uninstall_plugin($plugintype, $pluginname);
+        mtrace("Plugin {$component} has been uninstalled.");
+    }
+
+    /**
+     * Check whether the given plugin is present on disk.
+     *
+     * @param string $plugintype
+     * @param string $pluginname
+     * @return bool
+     */
+    protected static function plugin_exists_on_disk(string $plugintype, string $pluginname): bool {
+        $directory = core_component::get_plugin_directory($plugintype, $pluginname);
+        return $directory !== null && file_exists("{$directory}/version.php");
+    }
+
+    /**
+     * Check whether the given plugin is recorded as installed in the database.
+     *
+     * @param string $plugintype
+     * @param string $pluginname
+     * @return bool
+     */
+    protected static function plugin_is_installed(string $plugintype, string $pluginname): bool {
+        $installed = core_plugin_manager::instance()->get_installed_plugins($plugintype);
+        return array_key_exists($pluginname, $installed);
+    }
+}
