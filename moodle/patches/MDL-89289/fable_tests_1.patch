+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\task;
+
+/**
+ * Tests for the uninstall_plugin_task ad-hoc task.
+ *
+ * @package   core
+ * @category  test
+ * @copyright 2026 onwards Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \core\task\uninstall_plugin_task
+ */
+final class uninstall_plugin_task_test extends \advanced_testcase {
+    /**
+     * Test that the task instance is created with the expected custom data.
+     */
+    public function test_instance(): void {
+        $task = uninstall_plugin_task::instance('editor', 'atto', ['atto']);
+
+        $this->assertInstanceOf(uninstall_plugin_task::class, $task);
+        $this->assertEquals('core', $task->get_component());
+
+        $customdata = $task->get_custom_data();
+        $this->assertEquals('editor', $customdata->plugintype);
+        $this->assertEquals('atto', $customdata->pluginname);
+        $this->assertEquals(['atto'], $customdata->subplugintypes);
+
+        $task = uninstall_plugin_task::instance('mod', 'survey');
+        $this->assertEquals([], $task->get_custom_data()->subplugintypes);
+    }
+
+    /**
+     * Test that a plugin which is no longer present on disk is uninstalled by the task.
+     */
+    public function test_execute_uninstalls_missing_plugin(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        // Pretend that a block plugin which does not exist on disk is installed.
+        set_config('version', 2026010100, 'block_removedplugin');
+        set_config('somesetting', 'somevalue', 'block_removedplugin');
+        $DB->insert_record('block', (object) ['name' => 'removedplugin', 'cron' => 0, 'lastcron' => 0, 'visible' => 1]);
+
+        \core_plugin_manager::reset_caches();
+        $this->assertArrayHasKey('removedplugin', \core_plugin_manager::instance()->get_installed_plugins('block'));
+
+        $task = uninstall_plugin_task::instance('block', 'removedplugin');
+        manager::queue_adhoc_task($task);
+
+        $this->expectOutputRegex('/Plugin block_removedplugin has been uninstalled/');
+        $this->runAdhocTasks(uninstall_plugin_task::class);
+
+        \core_plugin_manager::reset_caches();
+        $this->assertArrayNotHasKey('removedplugin', \core_plugin_manager::instance()->get_installed_plugins('block'));
+        $this->assertFalse(get_config('block_removedplugin', 'version'));
+        $this->assertFalse(get_config('block_removedplugin', 'somesetting'));
+        $this->assertFalse($DB->record_exists('block', ['name' => 'removedplugin']));
+    }
+
+    /**
+     * Test that an activity module which is no longer present on disk is uninstalled, including its course modules.
+     */
+    public function test_execute_uninstalls_missing_module(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        // Pretend that an activity module which does not exist on disk is installed, with an instance in a course.
+        set_config('version', 2026010100, 'mod_removedmod');
+        $moduleid = $DB->insert_record('modules', (object) ['name' => 'removedmod', 'cron' => 0, 'lastcron' => 0, 'visible' => 1]);
+        $course = $this->getDataGenerator()->create_course();
+        $section = $DB->get_record('course_sections', ['course' => $course->id, 'section' => 0], '*', MUST_EXIST);
+        $cmid = $DB->insert_record('course_modules', (object) [
+            'course' => $course->id,
+            'module' => $moduleid,
+            'instance' => 1,
+            'section' => $section->id,
+            'added' => time(),
+        ]);
+        $DB->set_field('course_sections', 'sequence', (string) $cmid, ['id' => $section->id]);
+        \context_module::instance($cmid);
+
+        $task = uninstall_plugin_task::instance('mod', 'removedmod');
+        manager::queue_adhoc_task($task);
+
+        $this->expectOutputRegex('/Plugin mod_removedmod has been uninstalled/');
