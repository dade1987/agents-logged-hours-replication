diff --git a/public/lib/db/upgradelib.php b/public/lib/db/upgradelib.php
index f1f6d832bb2..03def6131d3 100644
--- a/public/lib/db/upgradelib.php
+++ b/public/lib/db/upgradelib.php
@@ -2114,6 +2114,38 @@ function upgrade_create_async_mimetype_upgrade_task(string $mimetype, array $ext
     $DB->insert_record('task_adhoc', $record);
 }
 
+/**
+ * Queues an ad-hoc task to uninstall a plugin which has been removed from core and is no longer present on disk.
+ *
+ * Uninstalling a plugin may take a very long time (for example, deleting every instance of a removed activity module
+ * from every course), so rather than running synchronously during the upgrade, the uninstallation is queued as an
+ * ad-hoc task to be performed once the upgrade has completed. This considerably reduces the time an upgrade takes.
+ *
+ * If the plugin is still present on disk when this is called, no task is queued and nothing is uninstalled.
+ *
+ * @param string $plugintype the plugin type, e.g. 'mod'
+ * @param string $pluginname the plugin name, e.g. 'survey'
+ * @param string[] $subplugintypes subplugin types declared by the removed plugin. As the plugin is no longer on disk
+ *      these are unknown to core, so any installed subplugins of these types are uninstalled by the task first.
+ * @return bool true if the task was queued, false if the plugin is still present on disk
+ */
+function upgrade_queue_uninstall_plugin_task(string $plugintype, string $pluginname, array $subplugintypes = []): bool {
+    global $CFG;
+    require_once($CFG->libdir . '/upgradelib.php');
+
+    $directory = core_component::get_plugin_directory($plugintype, $pluginname);
+    if ($directory !== null && file_exists("{$directory}/version.php")) {
+        // The plugin is still present on disk, so it must not be uninstalled.
+        return false;
+    }
+
+    $task = \core\task\uninstall_plugin_task::instance($plugintype, $pluginname, $subplugintypes);
+    \core\task\manager::queue_adhoc_task($task);
+    upgrade_log(UPGRADE_LOG_NORMAL, null, "Queued ad-hoc task to uninstall {$plugintype}_{$pluginname} after the upgrade.");
+
+    return true;
+}
+
