+
+namespace core\task;
+
+/**
+ * Unit tests for the delete_block_instances_task ad-hoc task.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \core\task\delete_block_instances_task
+ */
+final class delete_block_instances_task_test extends \advanced_testcase {
+    /**
+     * Test that executing the task deletes only the instances of the given block.
+     */
+    public function test_execute(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course();
+        $coursecontext = \context_course::instance($course->id);
+
+        $online1 = $generator->create_block('online_users', ['parentcontextid' => $coursecontext->id]);
+        $online2 = $generator->create_block('online_users', ['parentcontextid' => $coursecontext->id]);
+        $html = $generator->create_block('html', ['parentcontextid' => $coursecontext->id]);
+
+        $this->assertEquals(2, $DB->count_records('block_instances', ['blockname' => 'online_users']));
+
+        $task = delete_block_instances_task::instance('online_users');
+        manager::queue_adhoc_task($task);
+
+        $this->expectOutputRegex('/Deleted 2 instance/');
+        $this->run_all_adhoc_tasks();
+
+        $this->assertEquals(0, $DB->count_records('block_instances', ['blockname' => 'online_users']));
+        $this->assertFalse($DB->record_exists('context', ['contextlevel' => CONTEXT_BLOCK, 'instanceid' => $online1->id]));
+        $this->assertFalse($DB->record_exists('context', ['contextlevel' => CONTEXT_BLOCK, 'instanceid' => $online2->id]));
+
+        // Other blocks are untouched.
+        $this->assertTrue($DB->record_exists('block_instances', ['id' => $html->id]));
+        $this->assertTrue($DB->record_exists('context', ['contextlevel' => CONTEXT_BLOCK, 'instanceid' => $html->id]));
+    }
+
+    /**
+     * Test that uninstalling a block during an upgrade queues the ad-hoc task instead of deleting synchronously.
+     */
+    public function test_uninstall_cleanup_during_upgrade_queues_task(): void {
+        global $CFG, $DB;
+        $this->resetAfterTest();
+
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course();
+        $coursecontext = \context_course::instance($course->id);
+        $generator->create_block('online_users', ['parentcontextid' => $coursecontext->id]);
+
+        $CFG->upgraderunning = time() + 300;
+        $plugininfo = \core_plugin_manager::instance()->get_plugin_info('block_online_users');
+        $plugininfo->uninstall_cleanup();
+        unset($CFG->upgraderunning);
+
+        $this->assertFalse($DB->record_exists('block', ['name' => 'online_users']));
+        $this->assertEquals(1, $DB->count_records('block_instances', ['blockname' => 'online_users']));
+
+        $tasks = manager::get_adhoc_tasks(delete_block_instances_task::class);
+        $this->assertCount(1, $tasks);
+        $this->assertEquals('online_users', reset($tasks)->get_custom_data()->blockname);
+
+        $this->expectOutputRegex('/Deleted 1 instance/');
+        $this->run_all_adhoc_tasks();
+        $this->assertEquals(0, $DB->count_records('block_instances', ['blockname' => 'online_users']));
+    }
+}
