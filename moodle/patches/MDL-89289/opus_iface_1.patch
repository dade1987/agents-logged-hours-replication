+
+namespace core\task;
+
+/**
+ * Ad-hoc task to delete all the instances of a given block type.
+ *
+ * This is used when a block plugin is removed during an upgrade, so that the (potentially lengthy)
+ * deletion of all its instances and their related contexts can happen after the upgrade has completed
+ * rather than synchronously during it.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class delete_block_instances_task extends adhoc_task {
+    /** @var int The number of block instances to process per batch. */
+    protected const BATCH_SIZE = 1000;
+
+    /**
+     * Create a new instance of the task for the given block name.
+     *
+     * @param string $blockname The name of the block (without the block_ prefix), e.g. 'section_links'.
+     * @return static
+     */
+    public static function instance(string $blockname): static {
+        $task = new static();
+        $task->set_custom_data((object) ['blockname' => $blockname]);
+        return $task;
+    }
+
+    #[\Override]
+    public function get_name(): string {
+        return get_string('taskdeleteblockinstances', 'admin');
+    }
+
+    /**
+     * Delete all the instances of the block stored in the custom data.
+     */
+    public function execute(): void {
+        global $CFG, $DB;
+
+        require_once($CFG->libdir . '/blocklib.php');
+
+        $data = $this->get_custom_data();
+        $blockname = $data->blockname ?? '';
+        if ($blockname === '') {
+            mtrace('No block name specified, nothing to delete.');
+            return;
+        }
+
+        $total = 0;
+        do {
+            $instanceids = array_keys($DB->get_records(
+                'block_instances',
+                ['blockname' => $blockname],
+                'id ASC',
+                'id',
+                0,
+                self::BATCH_SIZE,
+            ));
+            if (!empty($instanceids)) {
+                blocks_delete_instances($instanceids);
+                $total += count($instanceids);
+            }
+        } while (count($instanceids) === self::BATCH_SIZE);
+
+        mtrace("Deleted {$total} instance(s) of block '{$blockname}'.");
+    }
+}
