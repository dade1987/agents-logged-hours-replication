+/**
+ * Queue an adhoc task to uninstall a plugin that has been removed from the codebase.
+ *
+ * Uninstalling a plugin can take a long time, so upgrade steps should use this instead of calling uninstall_plugin()
+ * directly. The removal then runs after the upgrade has completed. The task only uninstalls the plugin if it is still
+ * absent from the codebase when it runs.
+ *
+ * @param string $type The plugin type, eg. 'mod', 'qtype', 'block' etc.
+ * @param string $name The plugin name, eg. 'chat', 'random', 'activity_modules' etc.
+ */
+function upgrade_queue_plugin_uninstall(string $type, string $name): void {
+    global $DB;
+
+    // Insert the record directly, as the upgrade should not depend on core functions (see the mimetype task above).
+    $record = new \stdClass();
+    $record->classname = '\core\task\uninstall_plugin_task';
+    $record->component = 'core';
+    $record->customdata = json_encode([
+        'type' => $type,
+        'name' => $name,
+    ]);
+
+    // Next run time based from nextruntime computation in \core\task\manager::queue_adhoc_task().
+    $clock = \core\di::get(\core\clock::class);
+    $record->nextruntime = $clock->time() - 1;
+
+    $DB->insert_record('task_adhoc', $record);
+}
