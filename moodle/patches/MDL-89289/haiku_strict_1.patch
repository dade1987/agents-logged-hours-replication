+namespace core\task;
+
+/**
+ * Adhoc task to uninstall a plugin that has been removed from the codebase.
+ *
+ * Uninstalling a plugin can delete large amounts of data and take a long time. Upgrade steps queue this task
+ * (via {@see upgrade_queue_plugin_uninstall()}) so that the removal runs after the upgrade has completed, instead
+ * of blocking the upgrade itself.
+ *
+ * The plugin is only uninstalled if it is still absent from the codebase when the task runs. If it has been
+ * reinstalled in the meantime, the task does nothing.
+ *
+ * @package    core
+ * @copyright  2026 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class uninstall_plugin_task extends adhoc_task {
+
+    #[\Override]
+    public function execute(): void {
+        global $CFG;
+        require_once($CFG->libdir . '/adminlib.php');
+
+        $data = $this->get_custom_data();
+        $type = $data->type ?? '';
+        $name = $data->name ?? '';
+        if ($type === '' || $name === '') {
+            mtrace('Invalid plugin details provided, nothing to uninstall.');
+            return;
+        }
+
+        // Never remove a plugin that is present in the codebase, for example if it was reinstalled after the upgrade.
+        if (\core_component::get_plugin_directory($type, $name) !== null) {
+            mtrace("Plugin {$type}_{$name} is present in the codebase, skipping uninstall.");
+            return;
+        }
+
+        mtrace("Uninstalling plugin {$type}_{$name}.");
+        uninstall_plugin($type, $name);
+    }
+}
