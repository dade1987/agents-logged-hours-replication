+
+/**
+ * Queue an ad-hoc task to uninstall a plugin that has been removed from disk.
+ *
+ * Use this from upgrade steps instead of calling uninstall_plugin() directly, so that the potentially lengthy clean-up
+ * runs after the upgrade has completed.
+ *
+ * @param string $type The plugin type.
+ * @param string $name The plugin name.
+ */
+function upgrade_queue_plugin_uninstall(string $type, string $name): void {
+    \core\task\manager::queue_adhoc_task(\core\task\uninstall_plugin_task::create($type, $name), true);
+    upgrade_log(UPGRADE_LOG_NORMAL, null, "Queued ad-hoc task to uninstall plugin {$type}_{$name}.");
+}
