+namespace core\task;
+
+/**
+ * Ad-hoc task to remove the data of a plugin which has been deleted from disk.
+ *
+ * This is queued by upgrade steps so that the (potentially lengthy) clean-up is not run synchronously during the upgrade.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class uninstall_plugin_task extends adhoc_task {
+    /**
+     * Create a task for the given plugin.
+     *
+     * @param string $type The plugin type.
+     * @param string $name The plugin name.
+     * @return self
+     */
+    public static function create(string $type, string $name): self {
+        $task = new self();
+        $task->set_custom_data(['type' => $type, 'name' => $name]);
+        return $task;
+    }
+
+    #[\Override]
+    public function execute() {
+        global $CFG;
+        require_once($CFG->libdir . '/adminlib.php');
+
+        $data = $this->get_custom_data();
+        $type = $data->type;
+        $name = $data->name;
+
+        // Do not remove the data if the plugin has been put back on disk since the upgrade.
+        $dir = \core_component::get_plugin_directory($type, $name);
+        if ($dir !== null && file_exists($dir . '/version.php')) {
+            mtrace("Plugin {$type}_{$name} is present on disk, skipping uninstall.");
+            return;
+        }
+
+        mtrace("Uninstalling plugin {$type}_{$name}");
+        uninstall_plugin($type, $name);
+    }
+}
