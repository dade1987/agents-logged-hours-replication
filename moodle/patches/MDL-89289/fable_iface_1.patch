+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\task;
+
+use core\local\cli\shutdown;
+
+/**
+ * Ad-hoc task to delete all block instances (and related data) belonging to a block plugin.
+ *
+ * This is used by the upgrade process when a block plugin has been removed from core, so that the
+ * potentially lengthy removal of its instances can happen in the background after the upgrade has
+ * completed rather than synchronously during the upgrade itself.
+ *
+ * @package   core
+ * @copyright 2026 onwards Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class delete_block_instances_task extends adhoc_task {
+    use stored_progress_task_trait;
+
+    /** @var int The number of block instances processed per batch. */
+    const BATCH_SIZE = 1000;
+
+    /**
+     * Create a new instance of the task for the given block.
+     *
+     * @param string $blockname The name of the block plugin (without the 'block_' prefix), e.g. 'section_links'.
+     * @return static
+     */
+    public static function instance(string $blockname): static {
+        $task = new static();
+        $task->set_custom_data((object) [
+            'blockname' => $blockname,
+        ]);
+
+        return $task;
+    }
+
+    /**
+     * Get the name of the block whose instances are to be deleted.
+     *
+     * @return string
+     */
+    public function get_blockname(): string {
+        $data = $this->get_custom_data();
+        if (empty($data) || empty($data->blockname)) {
+            return '';
+        }
+
+        return (string) $data->blockname;
+    }
+
+    #[\Override]
+    public function execute(): void {
+        global $CFG, $DB;
+        require_once($CFG->libdir . '/blocklib.php');
+
+        $blockname = $this->get_blockname();
+        if ($blockname === '') {
+            mtrace('No block name specified, nothing to do.');
+            return;
+        }
+
+        $this->start_stored_progress();
+        $progress = $this->get_progress();
+
+        $total = $DB->count_records('block_instances', ['blockname' => $blockname]);
+        mtrace("Deleting {$total} instances of block '{$blockname}'.");
+
+        $progress->start_progress('', $total);
+        $done = 0;
+        $rescheduled = false;
+
+        // Process the instances in batches so that very large sites do not have to hold all records in memory
+        // and so that the deletion can be interrupted gracefully.
+        while (true) {
+            $instanceids = array_keys($DB->get_records(
+                'block_instances',
+                ['blockname' => $blockname],
+                'id ASC',
+                'id',
+                0,
+                self::BATCH_SIZE,
+            ));
+
+            if (empty($instanceids)) {
+                break;
+            }
+
+            $transaction = $DB->start_delegated_transaction();
+            blocks_delete_instances($instanceids);
+            $transaction->allow_commit();
+
+            $count = count($instanceids);
+            $done += $count;
+            $progress->increment_progress($count);
+
+            // The task might be running for a long time. If a graceful exit is requested, queue this task again.
+            if (shutdown::should_gracefully_exit()) {
+                manager::queue_adhoc_task(static::instance($blockname), true);
+                mtrace("Graceful exit requested, rescheduled deletion of the remaining instances of block '{$blockname}'.");
+                $rescheduled = true;
+                break;
+            }
+        }
+
+        $progress->end_progress();
+
+        if (!$rescheduled) {
+            mtrace("Deleted {$done} instances of block '{$blockname}'.");
+        }
+    }
+}
