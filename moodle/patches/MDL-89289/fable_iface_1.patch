+
+namespace core\task;
+
+/**
+ * Tests for the delete_block_instances_task ad-hoc task.
+ *
+ * @package   core
+ * @copyright 2026 onwards Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \core\task\delete_block_instances_task
+ */
+final class delete_block_instances_task_test extends \advanced_testcase {
+    /**
+     * Test that the task is created with the correct custom data.
+     */
+    public function test_instance(): void {
+        $task = delete_block_instances_task::instance('online_users');
+
+        $this->assertInstanceOf(delete_block_instances_task::class, $task);
+        $this->assertInstanceOf(adhoc_task::class, $task);
+        $this->assertEquals('online_users', $task->get_blockname());
+        $this->assertEquals('core', $task->get_component());
+    }
+
+    /**
+     * Test that the task deletes all instances of the given block, and only those.
+     */
+    public function test_execute(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course();
+        $coursecontext = \context_course::instance($course->id);
+        $generator = $this->getDataGenerator();
+
+        $todelete = [];
+        for ($i = 0; $i < 3; $i++) {
+            $todelete[] = $generator->create_block('online_users', [
+                'parentcontextid' => $coursecontext->id,
+                'pagetypepattern' => 'course-view-*',
+            ]);
+        }
+        $tokeep = $generator->create_block('html', [
+            'parentcontextid' => $coursecontext->id,
+            'pagetypepattern' => 'course-view-*',
+        ]);
+
+        // Add a block position and some user preferences for one of the instances to be deleted.
+        $user = $generator->create_user();
+        $DB->insert_record('block_positions', (object) [
+            'blockinstanceid' => $todelete[0]->id,
+            'contextid' => $coursecontext->id,
+            'pagetype' => 'course-view-topics',
+            'subpage' => '',
+            'visible' => 1,
+            'region' => 'side-pre',
+            'weight' => 0,
+        ]);
+        set_user_preference('block' . $todelete[0]->id . 'hidden', 1, $user);
+        set_user_preference('docked_block_instance_' . $todelete[0]->id, 1, $user);
+
+        $this->assertEquals(3, $DB->count_records('block_instances', ['blockname' => 'online_users']));
+        $this->assertEquals(1, $DB->count_records('block_instances', ['blockname' => 'html']));
+
+        $task = delete_block_instances_task::instance('online_users');
+        manager::queue_adhoc_task($task);
+
+        $this->expectOutputRegex("/Deleted 3 instances of block 'online_users'/");
+        $this->runAdhocTasks(delete_block_instances_task::class);
+
+        $this->assertEquals(0, $DB->count_records('block_instances', ['blockname' => 'online_users']));
+        $this->assertEquals(0, $DB->count_records('block_positions', ['blockinstanceid' => $todelete[0]->id]));
+        $this->assertEmpty(get_user_preferences('block' . $todelete[0]->id . 'hidden', null, $user));
+        $this->assertEmpty(get_user_preferences('docked_block_instance_' . $todelete[0]->id, null, $user));
+        foreach ($todelete as $instance) {
+            $this->assertFalse($DB->record_exists('context', [
+                'contextlevel' => CONTEXT_BLOCK,
+                'instanceid' => $instance->id,
+            ]));
+        }
+
+        // The other block instance must not have been touched.
+        $this->assertTrue($DB->record_exists('block_instances', ['id' => $tokeep->id]));
+        $this->assertTrue($DB->record_exists('context', [
+            'contextlevel' => CONTEXT_BLOCK,
+            'instanceid' => $tokeep->id,
+        ]));
+    }
+
+    /**
+     * Test that the task does nothing when there are no instances of the block.
+     */
+    public function test_execute_no_instances(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $count = $DB->count_records('block_instances');
+
+        $task = delete_block_instances_task::instance('online_users');
+        manager::queue_adhoc_task($task);
+
+        $this->expectOutputRegex("/Deleted 0 instances of block 'online_users'/");
+        $this->runAdhocTasks(delete_block_instances_task::class);
+
+        $this->assertEquals($count, $DB->count_records('block_instances'));
+    }
+}
