+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\task;
+
+/**
+ * Ad-hoc task to uninstall plugins which have been removed from core.
+ *
+ * Uninstalling a plugin can take a long time (for example, removing all of the activities of a removed module),
+ * so upgrade steps queue this task instead of doing the work synchronously during the upgrade.
+ *
+ * Custom data: an object with a "plugins" list, each entry being an object with "type" and "name".
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class uninstall_plugins_task extends adhoc_task {
+    /**
+     * Create a task for the given plugins, to be uninstalled in the given order.
+     *
+     * @param array $plugins List of [type, name] pairs, or "type_name" keyed entries of ['type' => ..., 'name' => ...].
+     * @return self
+     */
+    public static function create(array $plugins): self {
+        $task = new self();
+        $list = [];
+        foreach ($plugins as $plugin) {
+            $plugin = array_values($plugin);
+            $list[] = ['type' => $plugin[0], 'name' => $plugin[1]];
+        }
+        $task->set_custom_data(['plugins' => $list]);
+        return $task;
+    }
+
+    /**
+     * Queue a task to uninstall a single plugin.
+     *
+     * @param string $type Plugin type.
+     * @param string $name Plugin name.
+     */
+    public static function queue(string $type, string $name): void {
+        manager::queue_adhoc_task(self::create([[$type, $name]]), true);
+    }
+
+    #[\Override]
+    public function execute() {
+        global $CFG;
+        require_once($CFG->libdir . '/adminlib.php');
+        require_once($CFG->libdir . '/upgradelib.php');
+
+        $data = (array) $this->get_custom_data();
+        foreach ($data['plugins'] ?? [] as $plugin) {
+            $plugin = (array) $plugin;
+            $type = $plugin['type'];
+            $name = $plugin['name'];
+            $component = "{$type}_{$name}";
+
+            // Never uninstall a plugin which has been put back on disk in the meantime.
+            if (\core_component::get_plugin_directory($type, $name)) {
+                mtrace("Skipping uninstall of {$component} as it is present on disk.");
+                continue;
+            }
+
+            mtrace("Uninstalling {$component}");
+            ob_start();
+            try {
+                uninstall_plugin($type, $name);
+            } finally {
+                ob_end_clean();
+            }
+            upgrade_log(UPGRADE_LOG_NORMAL, $component, 'Plugin uninstalled');
+            mtrace("Uninstalled {$component}");
+        }
+    }
+}
