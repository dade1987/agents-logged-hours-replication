--- a/public/admin/tool/log/store/standard/tests/store_test.php
+++ b/public/admin/tool/log/store/standard/tests/store_test.php
@@ -235,6 +235,38 @@ final class store_test extends \advanced_testcase {
         ];
     }
 
+    /**
+     * Test that the user_loggedout event stores the real user id when logged in as another user.
+     *
+     * @covers ::require_logout
+     */
+    public function test_log_writing_loggedout_realuserid(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $this->preventResetByRollback(); // Logging waits till the transaction gets committed.
+
+        $this->setAdminUser();
+        $user = $this->getDataGenerator()->create_user();
+
+        // Enable logging plugin.
+        set_config('enabled_stores', 'logstore_standard', 'tool_log');
+        set_config('buffersize', 0, 'logstore_standard');
+        get_log_manager(true);
+
+        // Log in as another user (the admin is the real user).
+        \core\session\manager::loginas($user->id, \context_system::instance());
+        $this->assertTrue(\core\session\manager::is_loggedinas());
+
+        require_logout();
+        $this->assertFalse(isloggedin());
+        $this->assertFalse(\core\session\manager::is_loggedinas());
+
+        $log = $DB->get_record('logstore_standard_log', ['eventname' => '\core\event\user_loggedout'], '*', MUST_EXIST);
+        $this->assertEquals($user->id, $log->userid);
+        $this->assertEquals($user->id, $log->objectid);
+        $this->assertEquals(2, $log->realuserid);
+    }
+
