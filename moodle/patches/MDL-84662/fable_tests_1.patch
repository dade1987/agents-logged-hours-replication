diff --git a/public/lib/tests/moodlelib_test.php b/public/lib/tests/moodlelib_test.php
index 13f57ffd9e8..a894fa5b313 100644
--- a/public/lib/tests/moodlelib_test.php
+++ b/public/lib/tests/moodlelib_test.php
@@ -2943,6 +2943,40 @@ EOF;
         $this->assertEventContextNotUsed($event);
     }
 
+    /**
+     * Test that require_logout logs the correct realuserid when logged in as another user.
+     *
+     * @covers ::require_logout
+     */
+    public function test_require_logout_loggedinas(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->preventResetByRollback(); // Logging waits till the transaction gets committed.
+        $this->setAdminUser();
+        $user = $this->getDataGenerator()->create_user();
+
+        // Enable the standard log store without buffering.
+        set_config('enabled_stores', 'logstore_standard', 'tool_log');
+        set_config('buffersize', 0, 'logstore_standard');
+        set_config('logguests', 1, 'logstore_standard');
+        get_log_manager(true);
+
+        \core\session\manager::loginas($user->id, \context_system::instance());
+        $this->assertTrue(\core\session\manager::is_loggedinas());
+
+        require_logout();
+        $this->assertFalse(isloggedin());
+
+        $logs = $DB->get_records('logstore_standard_log', ['eventname' => '\core\event\user_loggedout']);
+        $this->assertCount(1, $logs);
+        $log = reset($logs);
+        $this->assertEquals($user->id, $log->userid);
+        $this->assertEquals(get_admin()->id, $log->realuserid);
+
+        get_log_manager(true);
+    }
+
