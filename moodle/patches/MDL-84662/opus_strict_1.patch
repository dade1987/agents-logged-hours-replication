--- a/public/lib/tests/moodlelib_test.php
+++ b/public/lib/tests/moodlelib_test.php
@@ -2943,6 +2943,36 @@ EOF;
         $this->assertEventContextNotUsed($event);
     }
 
+    /**
+     * Test require_logout logs the correct real user when logged in as another user.
+     *
+     * @covers ::require_logout
+     */
+    public function test_require_logout_loginas_realuserid(): void {
+        global $DB, $USER;
+        $this->resetAfterTest();
+
+        // Enable the standard log store with no buffering.
+        set_config('enabled_stores', 'logstore_standard', 'tool_log');
+        set_config('buffersize', 0, 'logstore_standard');
+        get_log_manager(true);
+
+        $user = $this->getDataGenerator()->create_user();
+        $this->setAdminUser();
+        $adminid = $USER->id;
+        \core\session\manager::loginas($user->id, \context_system::instance());
+        $this->assertTrue(\core\session\manager::is_loggedinas());
+
+        require_logout();
+        $this->assertFalse(isloggedin());
+
+        $log = $DB->get_record('logstore_standard_log', ['eventname' => '\core\event\user_loggedout'], '*', MUST_EXIST);
+        $this->assertEquals($user->id, $log->userid);
+        $this->assertEquals($adminid, $log->realuserid);
+
+        get_log_manager(true);
+    }
+
