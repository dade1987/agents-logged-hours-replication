+    /**
+     * Test require_logout logs the correct real user when logged in as another user.
+     */
+    public function test_require_logout_loginas(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->preventResetByRollback();
+
+        // Enable the standard log store, writing straight away.
+        set_config('enabled_stores', 'logstore_standard', 'tool_log');
+        set_config('buffersize', 0, 'logstore_standard');
+        get_log_manager(true);
+
+        $admin = get_admin();
+        $user = $this->getDataGenerator()->create_user();
+        $this->setAdminUser();
+        \core\session\manager::loginas($user->id, \context_system::instance(), false);
+        $this->assertTrue(\core\session\manager::is_loggedinas());
+
+        require_logout();
+        $this->assertFalse(isloggedin());
+
+        $record = $DB->get_record('logstore_standard_log', ['eventname' => '\\core\\event\\user_loggedout'], '*', MUST_EXIST);
+        $this->assertEquals($user->id, $record->userid);
+        $this->assertEquals($admin->id, $record->realuserid);
+
+        get_log_manager(true);
+    }
