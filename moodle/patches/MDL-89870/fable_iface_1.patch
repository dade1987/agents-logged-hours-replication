+    /**
+     * Tests detection of an alternative add-ons repository configured in config.php.
+     */
+    public function test_has_alternative_addons_repository(): void {
+        global $CFG;
+        $this->resetAfterTest();
+
+        $installer = testable_tool_installaddon_installer::instance();
+
+        unset($CFG->config_php_settings['alternativeaddonsrepositoryurl']);
+        $this->assertFalse($installer->has_alternative_addons_repository());
+
+        $CFG->config_php_settings['alternativeaddonsrepositoryurl'] = '';
+        $this->assertFalse($installer->has_alternative_addons_repository());
+
+        $CFG->config_php_settings['alternativeaddonsrepositoryurl'] = 'https://example.com/plugins/get.php';
+        $this->assertTrue($installer->has_alternative_addons_repository());
+        $this->assertSame('example.com', parse_url($installer->get_addons_repository_url(), PHP_URL_HOST));
+    }
+
