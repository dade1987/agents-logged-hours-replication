+    /**
+     * Is an alternative add-ons repository configured for this site?
+     *
+     * Direct installation from the Moodle plugins directory is no longer available
+     * (the Sites functionality was not migrated to Moodle Marketplace). The button
+     * leading to the repository therefore only makes sense when the site has an
+     * alternative repository configured via $CFG->alternativeaddonsrepositoryurl
+     * in config.php.
+     *
+     * @return bool
+     */
+    public function has_alternative_addons_repository(): bool {
+        global $CFG;
+
+        return !empty($CFG->config_php_settings['alternativeaddonsrepositoryurl']);
+    }
