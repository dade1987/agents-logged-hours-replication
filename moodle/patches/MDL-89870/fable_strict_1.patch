+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace tool_installaddon;
+
+/**
+ * Unit tests for the tool_installaddon renderer.
+ *
+ * @package     tool_installaddon
+ * @category    test
+ * @copyright   2026 Moodle Pty Ltd
+ * @license     http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers      \tool_installaddon_renderer
+ */
+final class renderer_test extends \advanced_testcase {
+
+    /**
+     * The index page must not advertise direct installation from the plugins directory,
+     * as that route can no longer complete. A notice should be shown instead.
+     */
+    public function test_index_page_does_not_offer_install_from_repository(): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $PAGE->set_url(new \moodle_url('/admin/tool/installaddon/index.php'));
+        $PAGE->set_context(\context_system::instance());
+
+        $installer = \tool_installaddon_installer::instance();
+        $output = $PAGE->get_renderer('tool_installaddon');
+        $output->set_installer_instance($installer);
+
+        $html = $output->index_page();
+
+        // The dead button is gone.
+        $this->assertStringNotContainsString(get_string('installfromrepo', 'tool_installaddon'), $html);
+        $this->assertStringNotContainsString('moodle.org/plugins/get.php" method="get"', $html);
+
+        // A notice explaining that the route is unavailable is shown instead, linking to the plugins directory.
+        $this->assertStringContainsString('installfromrepobox', $html);
+        $this->assertStringContainsString('currently unavailable', $html);
+        $this->assertStringContainsString('moodle.org/plugins/get.php', $html);
+
+        // The ZIP upload route is still offered.
+        $this->assertStringContainsString('installfromzipbox', $html);
+        $this->assertStringContainsString(get_string('installfromzipsubmit', 'tool_installaddon'), $html);
+    }
+}
