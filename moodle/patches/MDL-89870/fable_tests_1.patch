+
+namespace tool_installaddon;
+
+/**
+ * Unit tests for the tool_installaddon renderer.
+ *
+ * @package    tool_installaddon
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers     \tool_installaddon_renderer
+ */
+final class renderer_test extends \advanced_testcase {
+    /**
+     * The index page must not advertise direct installation from the plugins directory any more,
+     * as this route is no longer functional (MDL-89870). It should show a notice instead.
+     */
+    public function test_index_page_does_not_offer_install_from_repository(): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $PAGE->set_url(new \moodle_url('/admin/tool/installaddon/index.php'));
+        $PAGE->set_context(\context_system::instance());
+
+        $installer = \tool_installaddon_installer::instance();
+        $renderer = $PAGE->get_renderer('tool_installaddon');
+        $renderer->set_installer_instance($installer);
+
+        $html = $renderer->index_page();
+
+        // The dead-end button must not be rendered.
+        $this->assertStringNotContainsString('moodle.org/plugins/get.php', $html);
+        $this->assertStringNotContainsString(get_string('installfromrepo', 'tool_installaddon'), $html);
+
+        // The notice explaining the situation is displayed, pointing to the Marketplace.
+        $this->assertStringContainsString('installfromrepobox', $html);
+        $this->assertStringContainsString('currently unavailable', $html);
+        $this->assertStringContainsString($installer->get_marketplace_url()->out(false), $html);
+
+        // The ZIP upload route is still available.
+        $this->assertStringContainsString('installfromzipbox', $html);
+        $this->assertStringContainsString(get_string('installfromzipsubmit', 'tool_installaddon'), $html);
+    }
+}
