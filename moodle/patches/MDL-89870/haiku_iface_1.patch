+    public function test_has_alternative_addons_repository(): void {
+        global $CFG;
+
+        $this->resetAfterTest();
+        $installer = testable_tool_installaddon_installer::instance();
+
+        $CFG->config_php_settings = array();
+        $this->assertFalse($installer->has_alternative_addons_repository());
+
+        $CFG->config_php_settings = array('alternativeaddonsrepositoryurl' => 'https://example.com/plugins/get.php');
+        $this->assertTrue($installer->has_alternative_addons_repository());
+        $this->assertStringStartsWith('https://example.com/plugins/get.php', $installer->get_addons_repository_url()->out(false));
+    }
