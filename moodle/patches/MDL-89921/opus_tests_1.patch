+    /**
+     * Test that error pages raised within an activity do not show the linear navigation footer.
+     */
+    public function test_fatal_error_hides_linear_navigation_footer(): void {
+        $this->resetAfterTest();
+
+        // Only use the core hooks, which include the one adding the linear navigation footer.
+        \core\di::set(
+            \core\hook\manager::class,
+            \core\hook\manager::phpunit_get_instance([
+                'core' => $GLOBALS['CFG']->libdir . '/db/hooks.php',
+            ]),
+        );
+
+        set_config(\core_courseformat\local\linearnavigationsettings::SETTING_ENABLE_LINEAR_NAV, 1, 'format_topics');
+        $course = $this->getDataGenerator()->create_course(['format' => 'topics']);
+        $this->getDataGenerator()->create_module('page', ['course' => $course->id]);
+        $page2 = $this->getDataGenerator()->create_module('page', ['course' => $course->id]);
+        $this->getDataGenerator()->create_module('page', ['course' => $course->id]);
+        $this->setAdminUser();
+        $cm = get_fast_modinfo($course)->get_cm($page2->cmid);
+
+        // Sanity check: a regular activity page shows the linear navigation footer.
+        $page = new moodle_page();
+        $page->set_cm($cm, $course);
+        $page->set_url('/mod/page/view.php', ['id' => $cm->id]);
+        $page->set_state(moodle_page::STATE_PRINTING_HEADER);
+        $page->set_state(moodle_page::STATE_IN_BODY);
+        $renderer = new core_renderer($page, RENDERER_TARGET_GENERAL);
+        $page->opencontainers->push('header/footer', '</body></html>');
+        $html = $renderer->footer();
+        $this->assertStringContainsString('course-linear-navigation', $html);
+
+        // An error page raised within the same activity must not show it.
+        $page = new moodle_page();
+        $page->set_cm($cm, $course);
+        $page->set_url('/mod/page/view.php', ['id' => $cm->id]);
+        $page->set_state(moodle_page::STATE_PRINTING_HEADER);
+        $page->set_state(moodle_page::STATE_IN_BODY);
+        $renderer = new core_renderer($page, RENDERER_TARGET_GENERAL);
+        $page->opencontainers->push('header/footer', '</body></html>');
+        $html = $renderer->fatal_error('Some error', 'https://example.com', null, []);
+        $this->assertFalse($page->should_show_navigation_footer());
+        $this->assertStringContainsString('Some error', $html);
+        $this->assertStringNotContainsString('course-linear-navigation', $html);
+    }
+
     /**
      * @covers \core\hook\output\before_footer_html_generation
      */
