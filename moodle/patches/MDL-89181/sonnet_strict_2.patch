+    /**
+     * Test creating, fetching and removing redirect URIs.
+     */
+    public function test_redirect_uri_crud(): void {
+        $this->resetAfterTest();
+        $client = $this->create_client();
+        $manager = $this->get_manager();
+
+        $id1 = $manager->create_redirect_uri($client->id, 'https://example.com/cb');
+        $id2 = $manager->create_redirect_uri($client->id, 'http://localhost:8080/cb');
+        $this->assertSame($id1, $manager->create_redirect_uri($client->id, 'https://example.com/cb'));
+        for ($i = 0; $i < 15; $i++) {
+            $manager->create_redirect_uri($client->id, "https://example.com/cb{$i}");
+        }
+
+        $this->assertCount(17, $manager->get_redirect_uris($client->id));
+
+        $this->assertTrue($manager->is_registered_redirect_uri($client->id, 'https://example.com/cb'));
+        $this->assertFalse($manager->is_registered_redirect_uri($client->id, 'https://example.com/cb/'));
+        $this->assertFalse($manager->is_registered_redirect_uri($client->id, 'https://example.com/cb/extra'));
+        $this->assertFalse($manager->is_registered_redirect_uri($client->id, 'https://example.com'));
+        $this->assertFalse($manager->is_registered_redirect_uri($client->id, 'https://EXAMPLE.com/cb'));
+
+        $manager->remove_redirect_uri($id2);
+        $this->assertCount(16, $manager->get_redirect_uris($client->id));
+
+        $this->expectException(not_found_exception::class);
+        $manager->remove_redirect_uri($id2);
+    }
