@@ -0,0 +1,445 @@
+<?php
+// This file is part of Moodle - http://moodle.org/
+//
+// Moodle is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// Moodle is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\oauth2\server;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
+use core\exception\invalid_parameter_exception;
+use core\exception\invalid_state_exception;
+use core\exception\not_found_exception;
+use core\oauth2\server\entity\client_entity;
+
+/**
+ * Tests for {@see client_manager}.
+ *
+ * @package    core
+ * @copyright  2026 Mihail Geshoski <mihailgesoski@gmail.com>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[CoversClass(client_manager::class)]
+final class client_manager_test extends \advanced_testcase {
+    /**
+     * Get the manager through dependency injection.
+     *
+     * @return client_manager
+     */
+    private function get_manager(): client_manager {
+        return \core\di::get(client_manager::class);
+    }
+
+    /**
+     * Create a client record.
+     *
+     * @param string $identifier
+     * @param int $status
+     * @return \stdClass
+     */
+    private function create_client(string $identifier = 'client1', int $status = client_entity::STATUS_ACTIVE): \stdClass {
+        global $DB;
+
+        $record = (object) [
+            'name' => 'Client ' . $identifier,
+            'description' => 'Description',
+            'clientidentifier' => $identifier,
+            'ownercontext' => \context_system::instance()->id,
+            'status' => $status,
+            'isconfidential' => 1,
+            'timecreated' => time(),
+        ];
+        $record->id = $DB->insert_record('oauth2_server_clients', $record);
+
+        return $record;
+    }
+
+    /**
+     * Test that the manager only exposes instance methods and is resolvable via DI.
+     */
+    public function test_instance_methods_only(): void {
+        $this->assertInstanceOf(client_manager::class, $this->get_manager());
+
+        $class = new \ReflectionClass(client_manager::class);
+        foreach ($class->getMethods() as $method) {
+            $this->assertFalse($method->isStatic(), $method->getName() . ' must not be static');
+        }
+    }
+
+    /**
+     * Test fetching clients.
+     */
+    public function test_get_client(): void {
+        $this->resetAfterTest();
+        $client = $this->create_client();
+        $manager = $this->get_manager();
+
+        $this->assertEquals($client->id, $manager->get_client_by_id($client->id)->id);
+        $this->assertEquals($client->id, $manager->get_client_by_identifier('client1')->id);
+        $this->assertNull($manager->get_client_by_id($client->id + 100));
+        $this->assertNull($manager->get_client_by_identifier('missing'));
+    }
+
+    /**
+     * Test updating only name and description.
+     */
+    public function test_update_client(): void {
+        $this->resetAfterTest();
+        $client = $this->create_client();
+        $manager = $this->get_manager();
+
+        $updated = $manager->update_client($client->id, [
+            'name' => 'New name',
+            'description' => 'New description',
+            'clientidentifier' => 'hacked',
+            'status' => client_entity::STATUS_REVOKED,
+        ]);
+
+        $this->assertEquals('New name', $updated->name);
+        $this->assertEquals('New description', $updated->description);
+        $this->assertEquals('client1', $updated->clientidentifier);
+        $this->assertEquals(client_entity::STATUS_ACTIVE, $updated->status);
+        $this->assertNotEmpty($updated->timemodified);
+    }
+
+    /**
+     * Test updating with invalid data or a missing client.
+     */
+    public function test_update_client_invalid(): void {
+        $this->resetAfterTest();
+        $client = $this->create_client();
+        $manager = $this->get_manager();
+
+        $this->expectException(invalid_parameter_exception::class);
+        $manager->update_client($client->id, ['name' => '  ']);
+    }
+
+    /**
+     * Test updating a missing client.
+     */
+    public function test_update_client_not_found(): void {
+        $this->resetAfterTest();
+        $this->expectException(not_found_exception::class);
+        $this->get_manager()->update_client(12345, ['name' => 'x']);
+    }
+
+    /**
+     * Test that revoking a client cascades to secrets and tokens.
+     */
+    public function test_revoke_client_cascades(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $client = $this->create_client();
+        $other = $this->create_client('client2');
+        $manager = $this->get_manager();
+        $user = $this->getDataGenerator()->create_user();
+
+        $manager->generate_secret($client->id);
+        $manager->generate_secret($other->id);
+
+        foreach (['client1' => 'a1', 'client2' => 'a2'] as $identifier => $tokenid) {
+            $DB->insert_record('oauth2_server_client_access_tokens', (object) [
+                'identifier' => $tokenid,
+                'userid' => $user->id,
+                'clientidentifier' => $identifier,
+                'scopes' => 'openid',
+                'expirytime' => time() + HOURSECS,
+                'revoked' => 0,
+                'timecreated' => time(),
+            ]);
+            $DB->insert_record('oauth2_server_client_refresh_tokens', (object) [
+                'identifier' => 'r' . $tokenid,
+                'accesstokenidentifier' => $tokenid,
+                'expirytime' => time() + HOURSECS,
+                'revoked' => 0,
+                'timecreated' => time(),
+            ]);
+            $DB->insert_record('oauth2_server_client_auth_codes', (object) [
+                'identifier' => 'c' . $tokenid,
+                'userid' => $user->id,
+                'clientidentifier' => $identifier,
+                'redirecturi' => 'https://example.com/cb',
+                'scopes' => 'openid',
+                'expirytime' => time() + HOURSECS,
+                'revoked' => 0,
+                'timecreated' => time(),
+            ]);
+        }
+
+        $manager->revoke_client($client->id);
+
+        $this->assertEquals(client_entity::STATUS_REVOKED, $manager->get_client_by_id($client->id)->status);
+        $this->assertEquals(client_entity::STATUS_ACTIVE, $manager->get_client_by_id($other->id)->status);
+
