+    /**
+     * Test the active secret limit is per client.
+     */
+    public function test_generate_secret_limit(): void {
+        $this->resetAfterTest();
+        $client = $this->create_client();
+        $other = $this->create_client('client2');
+        $manager = $this->get_manager();
+
+        $first = $manager->generate_secret($client->id);
+        $manager->generate_secret($client->id);
+        $this->assertNotEquals($first, $manager->generate_secret($other->id));
+
+        $secrets = $manager->get_secrets($client->id);
+        $this->assertCount(2, $secrets);
+        foreach ($secrets as $secret) {
+            $this->assertNotEquals($first, $secret->secret, 'Secret must be stored hashed');
+        }
+        $this->assertTrue(password_verify($first, reset($secrets)->secret));
+
+        try {
+            $manager->generate_secret($client->id);
+            $this->fail('Expected exception');
+        } catch (invalid_state_exception $e) {
+            $this->assertCount(2, $manager->get_secrets($client->id));
+        }
+
+        // Other client is independent.
+        $manager->generate_secret($other->id);
+
+        // Revoking a secret frees a slot.
+        $manager->revoke_secret(reset($secrets)->id);
+        $this->assertCount(1, $manager->get_secrets($client->id, true));
+        $manager->generate_secret($client->id);
+        $this->assertCount(2, $manager->get_secrets($client->id, true));
+        $this->assertCount(3, $manager->get_secrets($client->id));
+    }
