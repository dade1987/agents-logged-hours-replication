+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\oauth2\server;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+use core\oauth2\server\entity\client_entity;
+
+/**
+ * Tests for {@see client_manager}.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[CoversClass(client_manager::class)]
+final class client_manager_test extends \advanced_testcase {
+    /**
+     * Get the manager from the DI container.
+     *
+     * @return client_manager
+     */
+    private function manager(): client_manager {
+        return \core\di::get(client_manager::class);
+    }
+
+    public function test_create_and_get_client(): void {
+        $this->resetAfterTest();
+        $manager = $this->manager();
+        $client = $manager->create_client('Test', \core\context\system::instance(), ['https://example.com/cb'], 'Desc');
+        $this->assertSame('Test', $client->getName());
+        $this->assertSame('Desc', $client->get_description());
+        $this->assertSame(client_entity::STATUS_ACTIVE, $client->get_status());
+        $this->assertNotNull($manager->get_client($client->getIdentifier()));
+        $this->assertNull($manager->get_client('missing'));
+        $this->assertNull($manager->get_client_by_id(-1));
+    }
+
+    public function test_update_client(): void {
+        $this->resetAfterTest();
+        $manager = $this->manager();
+        $client = $manager->create_client('Test', \core\context\system::instance());
+        $id = $this->get_id($client);
+        $manager->update_client($id, ['name' => 'New', 'description' => 'D']);
+        $this->assertSame('New', $manager->get_client_by_id($id)->getName());
+        $this->expectException(\moodle_exception::class);
+        $manager->update_client($id, ['status' => 2]);
+    }
+
+    public function test_secret_limit(): void {
+        $this->resetAfterTest();
+        $manager = $this->manager();
+        $id = $this->get_id($manager->create_client('Test', \core\context\system::instance()));
+        $manager->create_secret($id);
+        $manager->create_secret($id);
+        $this->assertCount(2, $manager->get_secrets($id));
+        try {
+            $manager->create_secret($id);
+            $this->fail('Expected exception');
+        } catch (\moodle_exception $e) {
+            $this->assertCount(2, $manager->get_secrets($id));
+        }
+        $secrets = $manager->get_secrets($id);
+        $secret = reset($secrets);
+        $manager->revoke_secret($secret->id);
+        $this->assertCount(1, $manager->get_secrets($id));
+        $this->assertCount(2, $manager->get_secrets($id, true));
+        $manager->create_secret($id);
+    }
+
+    public function test_revoke_reactivate_delete(): void {
+        $this->resetAfterTest();
+        $manager = $this->manager();
+        $client = $manager->create_client('Test', \core\context\system::instance());
+        $id = $this->get_id($client);
+        $manager->create_secret($id);
+
+        try {
+            $manager->delete_client($id);
+            $this->fail('Expected exception');
+        } catch (\moodle_exception $e) {
+            $this->assertNotNull($manager->get_client_by_id($id));
+        }
+
+        $manager->revoke_client($id);
+        $this->assertSame(client_entity::STATUS_REVOKED, $manager->get_client_by_id($id)->get_status());
+        $this->assertCount(0, $manager->get_secrets($id));
+
+        $manager->reactivate_client($id);
+        $this->assertSame(client_entity::STATUS_ACTIVE, $manager->get_client_by_id($id)->get_status());
+        $this->assertCount(0, $manager->get_secrets($id));
+
+        $manager->revoke_client($id);
+        $manager->delete_client($id);
+        $this->assertNull($manager->get_client_by_id($id));
+    }
+
+    public function test_redirect_uris(): void {
+        $this->resetAfterTest();
+        $manager = $this->manager();
+        $client = $manager->create_client('Test', \core\context\system::instance());
+        $id = $this->get_id($client);
+        $identifier = $client->getIdentifier();
+
+        $manager->add_redirect_uri($id, 'https://example.com/cb');
+        $manager->add_redirect_uri($id, 'http://localhost:8080/cb');
+        $this->assertCount(2, $manager->get_redirect_uris($id));
+        $this->assertTrue($manager->validate_redirect_uri($identifier, 'https://example.com/cb'));
+        $this->assertTrue($manager->validate_redirect_uri($identifier, 'http://localhost:8080/cb'));
+        $this->assertFalse($manager->validate_redirect_uri($identifier, 'https://example.com/cb/extra'));
+        $this->assertFalse($manager->validate_redirect_uri($identifier, 'https://example.com'));
+
+        $manager->remove_redirect_uri($id, 'https://example.com/cb');
+        $this->assertSame(['http://localhost:8080/cb'], $manager->get_redirect_uris($id));
+
+        foreach (['http://example.com/cb', 'ftp://example.com', 'example.com', 'myapp://cb'] as $bad) {
+            try {
+                $manager->add_redirect_uri($id, $bad);
+                $this->fail("Expected exception for $bad");
+            } catch (\moodle_exception $e) {
+                $this->assertCount(1, $manager->get_redirect_uris($id));
+            }
+        }
+    }
+
+    /**
+     * Get the record id for a client entity.
+     *
+     * @param client_entity $client
+     * @return int
+     */
+    private function get_id(client_entity $client): int {
+        global $DB;
+        return (int) $DB->get_field('oauth2_server_clients', 'id', ['clientidentifier' => $client->getIdentifier()]);
+    }
+}
