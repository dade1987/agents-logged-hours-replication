+    /**
+     * Test that revoking a secret frees a slot and that revoked or expired secrets do not count towards the limit.
+     *
+     * @return void
+     */
+    public function test_revoked_and_expired_secrets_do_not_count(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $manager = $this->get_manager();
+        $id = $this->get_record_id($manager->create_client('Client', \context_system::instance()));
+
+        $manager->create_secret($id);
+        $manager->create_secret($id, time() + HOURSECS);
+        $secrets = $manager->get_secrets($id);
+        $this->assertCount(2, $secrets);
+
+        $manager->revoke_secret((int) $secrets[0]->id);
+        $manager->create_secret($id);
+        $this->assertCount(2, $manager->get_secrets($id));
+
+        // Expired secrets do not count either.
+        $DB->set_field('oauth2_server_client_secrets', 'expirytime', time() - 1, ['clientidentifier' => $this->get_identifier($id)]);
+        $this->assertEmpty($manager->get_secrets($id));
+        $manager->create_secret($id);
+        $manager->create_secret($id);
+        $this->assertCount(2, $manager->get_secrets($id));
+    }
