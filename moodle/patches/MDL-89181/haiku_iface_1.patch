+    /**
+     * Test that redirect URI matching is exact, with no prefix or wildcard matching.
+     *
+     * @return void
+     */
+    public function test_redirect_uri_exact_match(): void {
+        $this->resetAfterTest();
+
+        $manager = $this->get_manager();
+        $client = $manager->create_client('Client', \context_system::instance(), ['https://example.test/callback']);
+        $identifier = $client->getIdentifier();
+
+        $this->assertTrue($manager->validate_redirect_uri($identifier, 'https://example.test/callback'));
+        $this->assertFalse($manager->validate_redirect_uri($identifier, 'https://example.test/callback/extra'));
+        $this->assertFalse($manager->validate_redirect_uri($identifier, 'https://example.test/callback/'));
+        $this->assertFalse($manager->validate_redirect_uri($identifier, 'https://example.test/'));
+        $this->assertFalse($manager->validate_redirect_uri($identifier, 'https://EXAMPLE.test/callback'));
+        $this->assertFalse($manager->validate_redirect_uri('unknown-client', 'https://example.test/callback'));
+    }
