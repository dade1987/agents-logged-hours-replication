+namespace core\oauth2\server;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
+use core\exception\invalid_parameter_exception;
+use core\oauth2\server\entity\client_entity;
+
+/**
+ * Tests for {@see client_manager}.
+ *
+ * @package    core
+ * @copyright  2026 Mihail Geshoski <mihailgesoski@gmail.com>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[CoversClass(client_manager::class)]
+final class client_manager_test extends \advanced_testcase {
+    /**
+     * Get the client manager from the DI container.
+     *
+     * @return client_manager
+     */
+    private function get_manager(): client_manager {
+        return \core\di::get(client_manager::class);
+    }
+
+    /**
+     * Insert an access token, refresh token and authorisation code for a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return void
+     */
+    private function insert_tokens(string $clientidentifier): void {
+        global $DB;
+
+        $accesstokenid = 'access-' . $clientidentifier;
+        $DB->insert_record('oauth2_server_client_access_tokens', (object) [
+            'identifier' => $accesstokenid,
+            'clientidentifier' => $clientidentifier,
+            'scopes' => '',
+            'expirytime' => time() + HOURSECS,
+            'revoked' => 0,
+            'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_refresh_tokens', (object) [
+            'identifier' => 'refresh-' . $clientidentifier,
+            'accesstokenidentifier' => $accesstokenid,
+            'expirytime' => time() + HOURSECS,
+            'revoked' => 0,
+            'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_auth_codes', (object) [
+            'identifier' => 'code-' . $clientidentifier,
+            'userid' => 2,
+            'clientidentifier' => $clientidentifier,
