+    /**
+     * Test the redirect URI scheme and host rules when registering and validating URIs.
+     *
+     * @param string $uri The URI.
+     * @param bool $valid Whether the URI is valid.
+     * @return void
+     */
+    #[DataProvider('redirect_uri_provider')]
+    public function test_redirect_uri_scheme_validation(string $uri, bool $valid): void {
+        $this->resetAfterTest();
+
+        $manager = $this->get_manager();
+        $client = $manager->create_client('Client', \context_system::instance());
+        $id = $this->get_record_id($client);
+
+        if ($valid) {
+            $manager->add_redirect_uri($id, $uri);
+            $this->assertTrue($manager->validate_redirect_uri($client->getIdentifier(), $uri));
+        } else {
+            try {
+                $manager->add_redirect_uri($id, $uri);
+                $this->fail('Expected an invalid redirect URI to be rejected.');
+            } catch (invalid_parameter_exception $e) {
+                $this->assertFalse($manager->validate_redirect_uri($client->getIdentifier(), $uri));
+            }
+        }
+    }
