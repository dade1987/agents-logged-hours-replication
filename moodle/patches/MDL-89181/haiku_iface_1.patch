+    /**
+     * Test that the per-client active secret limit is enforced.
+     *
+     * @return void
+     */
+    public function test_secret_limit_enforced_per_client(): void {
+        $this->resetAfterTest();
+
+        $manager = $this->get_manager();
+        $first = $this->get_record_id($manager->create_client('First', \context_system::instance()));
+        $second = $this->get_record_id($manager->create_client('Second', \context_system::instance()));
+
+        $manager->create_secret($first);
+        $manager->create_secret($first);
+
+        // The limit is per client, so the second client still has its own allowance.
+        $manager->create_secret($second);
+        $manager->create_secret($second);
+
+        try {
+            $manager->create_secret($first);
+            $this->fail('Expected the active secret limit to be enforced.');
+        } catch (invalid_parameter_exception $e) {
+            $this->assertCount(2, $manager->get_secrets($first));
+        }
+    }
