+
+        $manager->revoke_client($id);
+
+        $this->assertSame(
+            client_entity::STATUS_REVOKED,
+            (int) $DB->get_field('oauth2_server_clients', 'status', ['id' => $id], MUST_EXIST),
+        );
+        $this->assertSame(1, (int) $DB->get_field(
+            'oauth2_server_client_access_tokens',
+            'revoked',
+            ['clientidentifier' => $client->getIdentifier()],
