+        ));
+        $this->assertSame(1, (int) $DB->get_field(
+            'oauth2_server_client_refresh_tokens',
+            'revoked',
+            ['identifier' => 'refresh-' . $client->getIdentifier()],
+            MUST_EXIST,
+        ));
+        $this->assertSame(1, (int) $DB->get_field(
+            'oauth2_server_client_auth_codes',
+            'revoked',
+            ['clientidentifier' => $client->getIdentifier()],
+            MUST_EXIST,
+        ));
+        $this->assertEmpty($manager->get_secrets($id));
+    }
