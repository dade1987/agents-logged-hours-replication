+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\oauth2\server;
+
+use core\exception\invalid_parameter_exception;
+use core\oauth2\server\entity\client_entity;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
+
+/**
+ * Tests for {@see client_manager}.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[CoversClass(client_manager::class)]
+final class client_manager_test extends \advanced_testcase {
+    /**
+     * Create a client record.
+     *
+     * @param int $status
+     * @return \stdClass
+     */
+    protected function create_client(int $status = client_entity::STATUS_ACTIVE): \stdClass {
+        global $DB;
+        $record = (object) [
+            'name' => 'Client',
+            'description' => 'Desc',
+            'clientidentifier' => bin2hex(random_bytes(8)),
+            'ownercontext' => \context_system::instance()->id,
+            'status' => $status,
+            'isconfidential' => 1,
+            'timecreated' => time(),
+        ];
+        $record->id = $DB->insert_record('oauth2_server_clients', $record);
+        return $record;
+    }
+
+    /**
+     * Get the manager through DI.
+     *
+     * @return client_manager
+     */
+    protected function get_manager(): client_manager {
+        return \core\di::get(client_manager::class);
+    }
+
+    public function test_get_client(): void {
+        $this->resetAfterTest();
+        $client = $this->create_client();
+        $manager = $this->get_manager();
+        $this->assertEquals($client->id, $manager->get_client_by_id($client->id)->id);
+        $this->assertEquals($client->id, $manager->get_client_by_identifier($client->clientidentifier)->id);
+        $this->assertNull($manager->get_client_by_id(999999));
+        $this->assertNull($manager->get_client_by_identifier('nope'));
+    }
+
+    public function test_update_client(): void {
+        $this->resetAfterTest();
+        $client = $this->create_client();
+        $updated = $this->get_manager()->update_client($client->id, 'New', 'New desc');
+        $this->assertEquals('New', $updated->name);
+        $this->assertEquals('New desc', $updated->description);
+        $this->assertEquals($client->clientidentifier, $updated->clientidentifier);
+        $this->assertNotEmpty($updated->timemodified);
+
+        $this->expectException(invalid_parameter_exception::class);
+        $this->get_manager()->update_client(999999, 'x');
+    }
+
+    public function test_revoke_client_cascades(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+        $manager->generate_client_secret($client->id);
+        $DB->insert_record('oauth2_server_client_access_tokens', (object) [
+            'identifier' => 'at1',
+            'clientidentifier' => $client->clientidentifier,
+            'scopes' => 'a',
+            'expirytime' => time() + 100,
+            'revoked' => 0,
+            'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_refresh_tokens', (object) [
+            'identifier' => 'rt1',
+            'accesstokenidentifier' => 'at1',
+            'expirytime' => time() + 100,
+            'revoked' => 0,
+            'timecreated' => time(),
+        ]);
+
+        $manager->revoke_client($client->id);
+
+        $this->assertEquals(client_entity::STATUS_REVOKED, $manager->get_client_by_id($client->id)->status);
+        $this->assertEquals(1, $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['identifier' => 'at1']));
+        $this->assertEquals(1, $DB->get_field('oauth2_server_client_refresh_tokens', 'revoked', ['identifier' => 'rt1']));
+        $this->assertCount(0, $manager->get_client_secrets($client->id, true));
+        $this->assertCount(1, $manager->get_client_secrets($client->id));
+    }
+
+    public function test_reactivate_does_not_restore_secrets(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+        $manager->generate_client_secret($client->id);
+        $manager->revoke_client($client->id);
+        $manager->reactivate_client($client->id);
+
+        $this->assertEquals(client_entity::STATUS_ACTIVE, $manager->get_client_by_id($client->id)->status);
+        $this->assertCount(0, $manager->get_client_secrets($client->id, true));
+        $this->assertEquals(1, $DB->count_records('oauth2_server_client_secrets', ['revoked' => 1]));
+    }
+
+    public function test_reactivate_active_client_rejected(): void {
+        $this->resetAfterTest();
+        $client = $this->create_client();
+        $this->expectException(invalid_parameter_exception::class);
+        $this->get_manager()->reactivate_client($client->id);
+    }
+
+    public function test_delete_requires_revoked(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+        $manager->generate_client_secret($client->id);
+        $manager->create_redirect_uri($client->id, 'https://example.com/cb');
+
+        try {
+            $manager->delete_client($client->id);
+            $this->fail('Expected exception');
+        } catch (invalid_parameter_exception $e) {
+            $this->assertNotNull($manager->get_client_by_id($client->id));
+        }
+
+        $manager->revoke_client($client->id);
+        $manager->delete_client($client->id);
+        $this->assertNull($manager->get_client_by_id($client->id));
+        $this->assertEquals(0, $DB->count_records('oauth2_server_client_secrets'));
+        $this->assertEquals(0, $DB->count_records('oauth2_server_client_redirect_uris'));
+    }
+
+    public function test_secret_limit_per_client(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+        $other = $this->create_client();
+
+        $s1 = $manager->generate_client_secret($client->id);
+        $manager->generate_client_secret($client->id);
+        $this->assertTrue(password_verify($s1, current($manager->get_client_secrets($client->id))->secret));
+
+        try {
+            $manager->generate_client_secret($client->id);
+            $this->fail('Expected exception');
+        } catch (invalid_parameter_exception $e) {
+            $this->assertCount(2, $manager->get_client_secrets($client->id, true));
+        }
+
+        // Another client is unaffected.
+        $manager->generate_client_secret($other->id);
+
+        // Revoking frees a slot.
+        $secret = current($manager->get_client_secrets($client->id));
+        $manager->revoke_client_secret($secret->id);
+        $manager->generate_client_secret($client->id);
+        $this->assertCount(2, $manager->get_client_secrets($client->id, true));
+    }
+
+    public function test_generate_secret_revoked_client(): void {
+        $this->resetAfterTest();
+        $client = $this->create_client(client_entity::STATUS_REVOKED);
+        $this->expectException(invalid_parameter_exception::class);
+        $this->get_manager()->generate_client_secret($client->id);
+    }
+
+    public function test_redirect_uris(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+
+        $id = $manager->create_redirect_uri($client->id, 'https://example.com/cb');
+        $manager->create_redirect_uri($client->id, 'http://localhost:8080/cb');
+        $this->assertCount(2, $manager->get_redirect_uris($client->id));
+
+        $this->assertTrue($manager->validate_redirect_uri($client->id, 'https://example.com/cb'));
+        $this->assertFalse($manager->validate_redirect_uri($client->id, 'https://example.com/cb/'));
+        $this->assertFalse($manager->validate_redirect_uri($client->id, 'https://example.com/cb?x=1'));
+        $this->assertFalse($manager->validate_redirect_uri($client->id, 'https://example.com'));
+
+        $manager->remove_redirect_uri($id);
+        $this->assertCount(1, $manager->get_redirect_uris($client->id));
+        $this->assertFalse($manager->validate_redirect_uri($client->id, 'https://example.com/cb'));
+    }
+
+    /**
+     * @param string $uri
+     * @param bool $valid
+     */
+    #[DataProvider('redirect_uri_provider')]
+    public function test_redirect_uri_format(string $uri, bool $valid): void {
+        $this->assertSame($valid, $this->get_manager()->is_valid_redirect_uri_format($uri));
+        if (!$valid) {
+            $this->resetAfterTest();
