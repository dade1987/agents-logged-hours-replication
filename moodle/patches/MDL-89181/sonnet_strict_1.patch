+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\oauth2\server;
+
+use core\exception\invalid_parameter_exception;
+use core\oauth2\server\entity\access_token_entity;
+use core\oauth2\server\entity\client_entity;
+use core\oauth2\server\entity\refresh_token_entity;
+
+/**
+ * OAuth2 server client manager.
+ *
+ * Handles the lifecycle of OAuth2 clients, their secrets and redirect URIs.
+ * This class must be loaded via dependency injection: \core\di::get(client_manager::class).
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class client_manager {
+    /** @var int Maximum number of active secrets per client */
+    public const int MAX_ACTIVE_SECRETS = 2;
+
+    /** @var int Default secret lifetime in seconds (one year) */
+    public const int DEFAULT_SECRET_LIFETIME = YEARSECS;
+
+    /**
+     * Get a client record by id.
+     *
+     * @param int $id
+     * @return \stdClass|null Null if not found.
+     */
+    public function get_client_by_id(int $id): ?\stdClass {
+        global $DB;
+        $record = $DB->get_record('oauth2_server_clients', ['id' => $id]);
+        return $record ?: null;
+    }
+
+    /**
+     * Get a client record by client identifier.
+     *
+     * @param string $clientidentifier
+     * @return \stdClass|null Null if not found.
+     */
+    public function get_client_by_identifier(string $clientidentifier): ?\stdClass {
+        global $DB;
+        $record = $DB->get_record('oauth2_server_clients', ['clientidentifier' => $clientidentifier]);
+        return $record ?: null;
+    }
+
+    /**
+     * Update the administrative metadata (name, description) of a client.
+     *
+     * Any other property is ignored.
+     *
+     * @param int $id Client id.
+     * @param string|null $name New name (null to leave unchanged).
+     * @param string|null $description New description (null to leave unchanged).
+     * @return \stdClass The updated client record.
+     */
+    public function update_client(int $id, ?string $name = null, ?string $description = null): \stdClass {
+        global $DB;
+
+        $client = $this->get_existing_client($id);
+
+        if ($name !== null) {
+            if (trim($name) === '') {
+                throw new invalid_parameter_exception('Client name cannot be empty');
+            }
+            $client->name = $name;
+        }
+        if ($description !== null) {
+            $client->description = $description;
+        }
+        $client->timemodified = time();
+
+        $DB->update_record('oauth2_server_clients', $client);
+
+        return $this->get_existing_client($id);
+    }
+
+    /**
+     * Revoke a client, cascading to all its active tokens and secrets.
+     *
+     * @param int $id Client id.
+     */
+    public function revoke_client(int $id): void {
+        global $DB;
+
+        $client = $this->get_existing_client($id);
+        $identifier = $client->clientidentifier;
+
+        $transaction = $DB->start_delegated_transaction();
+
+        $DB->set_field('oauth2_server_clients', 'status', client_entity::STATUS_REVOKED, ['id' => $id]);
+        $DB->set_field('oauth2_server_clients', 'timemodified', time(), ['id' => $id]);
+
+        // Revoke refresh tokens belonging to the client's access tokens.
+        $DB->execute(
+            'UPDATE {oauth2_server_client_refresh_tokens}
+                SET revoked = :revoked
+              WHERE accesstokenidentifier IN (
+                    SELECT identifier FROM {oauth2_server_client_access_tokens} WHERE clientidentifier = :clientidentifier
+              )',
+            ['revoked' => refresh_token_entity::REVOKED_YES, 'clientidentifier' => $identifier],
+        );
+
+        $DB->set_field(
+            'oauth2_server_client_access_tokens',
+            'revoked',
+            access_token_entity::REVOKED_YES,
+            ['clientidentifier' => $identifier],
+        );
+
+        $DB->set_field(
+            'oauth2_server_client_auth_codes',
+            'revoked',
+            1,
+            ['clientidentifier' => $identifier],
+        );
+
+        $DB->set_field(
+            'oauth2_server_client_secrets',
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['clientidentifier' => $identifier],
+        );
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Reactivate a revoked client.
+     *
+     * Only the client record is restored. Revoked secrets and tokens stay revoked.
+     *
+     * @param int $id Client id.
+     */
+    public function reactivate_client(int $id): void {
+        global $DB;
+
+        $client = $this->get_existing_client($id);
+        if ((int) $client->status !== client_entity::STATUS_REVOKED) {
+            throw new invalid_parameter_exception('Only revoked clients can be reactivated');
+        }
+
+        $DB->set_field('oauth2_server_clients', 'status', client_entity::STATUS_ACTIVE, ['id' => $id]);
+        $DB->set_field('oauth2_server_clients', 'timemodified', time(), ['id' => $id]);
+    }
+
+    /**
+     * Permanently delete a client and all its related data. The client must already be revoked.
+     *
+     * @param int $id Client id.
+     */
+    public function delete_client(int $id): void {
+        global $DB;
+
+        $client = $this->get_existing_client($id);
+        if ((int) $client->status !== client_entity::STATUS_REVOKED) {
+            throw new invalid_parameter_exception('A client must be revoked before it can be deleted');
+        }
+        $identifier = $client->clientidentifier;
+
+        $transaction = $DB->start_delegated_transaction();
+
+        $DB->execute(
+            'DELETE FROM {oauth2_server_client_refresh_tokens}
+              WHERE accesstokenidentifier IN (
+                    SELECT identifier FROM {oauth2_server_client_access_tokens} WHERE clientidentifier = :clientidentifier
+              )',
+            ['clientidentifier' => $identifier],
+        );
+        foreach (
+            [
+                'oauth2_server_client_access_tokens',
+                'oauth2_server_client_auth_codes',
+                'oauth2_server_client_granted_scopes',
+                'oauth2_server_client_secrets',
+                'oauth2_server_client_redirect_uris',
+            ] as $table
+        ) {
+            $DB->delete_records($table, ['clientidentifier' => $identifier]);
+        }
+        $DB->delete_records('oauth2_server_clients', ['id' => $id]);
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Generate a new secret for a client.
+     *
+     * @param int $clientid Client id.
+     * @param int|null $expirytime Expiry timestamp, defaults to one year from now.
+     * @return string The plain text secret. It is stored hashed and cannot be retrieved later.
+     * @throws invalid_parameter_exception If the client is revoked, or the active secret limit is reached.
+     */
+    public function generate_client_secret(int $clientid, ?int $expirytime = null): string {
+        global $DB;
+
+        $client = $this->get_existing_client($clientid);
+        if ((int) $client->status !== client_entity::STATUS_ACTIVE) {
+            throw new invalid_parameter_exception('Cannot generate a secret for a revoked client');
+        }
+
+        $now = time();
+        $expirytime ??= $now + self::DEFAULT_SECRET_LIFETIME;
+        if ($expirytime <= $now) {
+            throw new invalid_parameter_exception('Secret expiry time must be in the future');
+        }
+
+        if (count($this->get_client_secrets($clientid, true)) >= self::MAX_ACTIVE_SECRETS) {
+            throw new invalid_parameter_exception(
+                'A client cannot have more than ' . self::MAX_ACTIVE_SECRETS . ' active secrets'
+            );
+        }
+
+        $secret = bin2hex(random_bytes(32));
+
+        $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => $client->clientidentifier,
+            'secret' => password_hash($secret, PASSWORD_BCRYPT),
+            'expirytime' => $expirytime,
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'timecreated' => $now,
+        ]);
+
+        return $secret;
+    }
+
+    /**
+     * Get the secrets of a client.
+     *
+     * @param int $clientid Client id.
+     * @param bool $activeonly Only return non-revoked, non-expired secrets.
+     * @return \stdClass[] Secret records indexed by id.
+     */
+    public function get_client_secrets(int $clientid, bool $activeonly = false): array {
+        global $DB;
+
+        $client = $this->get_existing_client($clientid);
+        $select = 'clientidentifier = :clientidentifier';
+        $params = ['clientidentifier' => $client->clientidentifier];
+        if ($activeonly) {
+            $select .= ' AND revoked = :revoked AND expirytime > :now';
+            $params['revoked'] = client_entity::SECRET_REVOKED_NO;
+            $params['now'] = time();
+        }
+
+        return $DB->get_records_select('oauth2_server_client_secrets', $select, $params, 'id ASC');
+    }
+
+    /**
+     * Revoke a client secret.
+     *
+     * @param int $secretid Secret id.
+     */
+    public function revoke_client_secret(int $secretid): void {
+        global $DB;
+
+        if (!$DB->record_exists('oauth2_server_client_secrets', ['id' => $secretid])) {
+            throw new invalid_parameter_exception('Client secret not found');
+        }
+        $DB->set_field('oauth2_server_client_secrets', 'revoked', client_entity::SECRET_REVOKED_YES, ['id' => $secretid]);
+    }
+
+    /**
+     * Get the redirect URIs of a client.
+     *
+     * @param int $clientid Client id.
+     * @return \stdClass[] Redirect URI records indexed by id.
+     */
+    public function get_redirect_uris(int $clientid): array {
+        global $DB;
+
+        $client = $this->get_existing_client($clientid);
+        return $DB->get_records(
+            'oauth2_server_client_redirect_uris',
+            ['clientidentifier' => $client->clientidentifier],
+            'id ASC',
+        );
+    }
+
+    /**
+     * Add a redirect URI to a client.
+     *
+     * @param int $clientid Client id.
+     * @param string $uri The redirect URI.
+     * @return int The id of the new redirect URI record.
+     * @throws invalid_parameter_exception If the URI is invalid.
+     */
+    public function create_redirect_uri(int $clientid, string $uri): int {
+        global $DB;
+
+        $client = $this->get_existing_client($clientid);
+
+        if (!$this->is_valid_redirect_uri_format($uri)) {
+            throw new invalid_parameter_exception('Invalid redirect URI: HTTPS is required except for localhost');
+        }
+
+        foreach ($this->get_redirect_uris($clientid) as $existing) {
+            if ($existing->uri === $uri) {
+                return (int) $existing->id;
+            }
+        }
+
+        return $DB->insert_record('oauth2_server_client_redirect_uris', (object) [
+            'clientidentifier' => $client->clientidentifier,
+            'uri' => $uri,
+        ]);
+    }
+
+    /**
+     * Remove a redirect URI.
+     *
+     * @param int $redirecturiid Redirect URI record id.
+     */
+    public function remove_redirect_uri(int $redirecturiid): void {
+        global $DB;
+
+        if (!$DB->record_exists('oauth2_server_client_redirect_uris', ['id' => $redirecturiid])) {
+            throw new invalid_parameter_exception('Redirect URI not found');
+        }
+        $DB->delete_records('oauth2_server_client_redirect_uris', ['id' => $redirecturiid]);
+    }
+
+    /**
+     * Validate a redirect URI against those registered for a client (exact match only).
+     *
+     * @param int $clientid Client id.
+     * @param string $uri The URI to validate.
+     * @return bool
+     */
+    public function validate_redirect_uri(int $clientid, string $uri): bool {
+        if (!$this->is_valid_redirect_uri_format($uri)) {
+            return false;
+        }
+        foreach ($this->get_redirect_uris($clientid) as $registered) {
+            if ($registered->uri === $uri) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Whether a URI is an acceptable redirect URI: absolute, no fragment, HTTPS (HTTP allowed for localhost/loopback).
+     *
+     * @param string $uri
+     * @return bool
+     */
+    public function is_valid_redirect_uri_format(string $uri): bool {
+        if ($uri === '' || preg_match('/\s/', $uri)) {
+            return false;
+        }
+        $parts = parse_url($uri);
+        if ($parts === false || empty($parts['scheme']) || empty($parts['host']) || isset($parts['fragment'])) {
+            return false;
+        }
+        if (str_contains($uri, '#')) {
+            return false;
+        }
+
+        $scheme = strtolower($parts['scheme']);
+        if ($scheme === 'https') {
+            return true;
+        }
+        if ($scheme !== 'http') {
+            return false;
+        }
+
+        $host = strtolower(trim($parts['host'], '[]'));
+        return $host === 'localhost'
+            || $host === '::1'
+            || $host === '127.0.0.1'
+            || (bool) preg_match('/^127(\.\d{1,3}){3}$/', $host);
+    }
+
+    /**
+     * Get a client record by id or throw.
+     *
+     * @param int $id
+     * @return \stdClass
+     */
+    protected function get_existing_client(int $id): \stdClass {
+        $client = $this->get_client_by_id($id);
+        if ($client === null) {
+            throw new invalid_parameter_exception('OAuth2 client not found');
+        }
+        return $client;
+    }
+}
