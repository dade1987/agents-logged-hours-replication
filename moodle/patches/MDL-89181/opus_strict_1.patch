+namespace core\oauth2\server;
+
+use core\oauth2\server\entity\access_token_entity;
+use core\oauth2\server\entity\auth_code_entity;
+use core\oauth2\server\entity\client_entity;
+use core\oauth2\server\entity\refresh_token_entity;
+use moodle_database;
+use moodle_exception;
+
+/**
+ * OAuth2 server client manager.
+ *
+ * Centralised management of OAuth2 server clients, their secrets and their redirect URIs.
+ *
+ * This class is expected to be obtained through dependency injection, e.g.
+ * <code>\core\di::get(\core\oauth2\server\client_manager::class)</code>.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class client_manager {
+    /** @var int The maximum number of active (non-revoked, non-expired) secrets a single client may have. */
+    public const int MAX_ACTIVE_SECRETS = 2;
+
+    /** @var int The default lifetime of a client secret, in seconds. */
+    public const int DEFAULT_SECRET_LIFETIME = YEARSECS;
+
+    /** @var string Clients table. */
+    protected const string TABLE_CLIENTS = 'oauth2_server_clients';
+
+    /** @var string Client secrets table. */
+    protected const string TABLE_SECRETS = 'oauth2_server_client_secrets';
+
+    /** @var string Client redirect URIs table. */
+    protected const string TABLE_REDIRECT_URIS = 'oauth2_server_client_redirect_uris';
+
+    /** @var string Access tokens table. */
+    protected const string TABLE_ACCESS_TOKENS = 'oauth2_server_client_access_tokens';
+
+    /** @var string Refresh tokens table. */
+    protected const string TABLE_REFRESH_TOKENS = 'oauth2_server_client_refresh_tokens';
+
+    /** @var string Authorisation codes table. */
+    protected const string TABLE_AUTH_CODES = 'oauth2_server_client_auth_codes';
+
+    /** @var string Granted scopes table. */
+    protected const string TABLE_GRANTED_SCOPES = 'oauth2_server_client_granted_scopes';
+
+    /**
+     * Constructor.
+     *
+     * @param moodle_database $db The database instance.
+     * @param \core\clock $clock The clock.
+     */
+    public function __construct(
+        /** @var moodle_database The database instance */
+        protected readonly moodle_database $db,
+        /** @var \core\clock The clock */
+        protected readonly \core\clock $clock,
+    ) {
+    }
+
+    // Clients.
+
+    /**
+     * Fetch a client by its database ID.
+     *
+     * @param int $id The client record ID.
+     * @return client_entity|null The client, or null if it does not exist.
+     */
+    public function get_client_by_id(int $id): ?client_entity {
+        $record = $this->db->get_record(self::TABLE_CLIENTS, ['id' => $id]);
+        if (!$record) {
+            return null;
+        }
+        return $this->create_entity($record);
+    }
+
+    /**
+     * Fetch a client by its public client identifier.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return client_entity|null The client, or null if it does not exist.
+     */
+    public function get_client_by_identifier(string $clientidentifier): ?client_entity {
+        $record = $this->db->get_record(self::TABLE_CLIENTS, ['clientidentifier' => $clientidentifier]);
+        if (!$record) {
+            return null;
+        }
+        return $this->create_entity($record);
+    }
+
+    /**
+     * Update the administrative metadata (name and description) of a client.
+     *
+     * No other client properties can be modified through this method.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $name The new name of the client.
+     * @param string|null $description The new description of the client.
+     * @return client_entity The updated client.
+     * @throws moodle_exception If the client does not exist or the name is invalid.
+     */
+    public function update_client(string $clientidentifier, string $name, ?string $description = null): client_entity {
+        $record = $this->get_client_record($clientidentifier);
+
+        $name = trim($name);
+        if ($name === '' || \core_text::strlen($name) > 255) {
+            throw new moodle_exception('oauth2serverinvalidclientname', 'error');
+        }
+
+        $update = (object) [
+            'id' => $record->id,
+            'name' => $name,
+            'description' => $description,
+            'timemodified' => $this->clock->time(),
+        ];
+        $this->db->update_record(self::TABLE_CLIENTS, $update);
+
+        return $this->get_client_by_identifier($clientidentifier);
+    }
+
+    /**
+     * Revoke a client.
+     *
+     * Revoking a client immediately revokes all of its active secrets, access tokens, refresh tokens
+     * and authorisation codes, fully cutting off its access.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @throws moodle_exception If the client does not exist.
+     */
+    public function revoke_client(string $clientidentifier): void {
+        $record = $this->get_client_record($clientidentifier);
+
+        $transaction = $this->db->start_delegated_transaction();
+
+        if ((int) $record->status !== client_entity::STATUS_REVOKED) {
+            $this->db->update_record(self::TABLE_CLIENTS, (object) [
+                'id' => $record->id,
+                'status' => client_entity::STATUS_REVOKED,
+                'timemodified' => $this->clock->time(),
+            ]);
+        }
+
+        // Revoke all secrets.
+        $this->db->set_field(
+            self::TABLE_SECRETS,
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['clientidentifier' => $clientidentifier, 'revoked' => client_entity::SECRET_REVOKED_NO],
+        );
+
+        // Revoke all refresh tokens associated with access tokens issued to this client.
+        $this->db->set_field_select(
+            self::TABLE_REFRESH_TOKENS,
+            'revoked',
+            refresh_token_entity::REVOKED_YES,
+            'revoked = :revoked AND accesstokenidentifier IN (
+                SELECT identifier FROM {' . self::TABLE_ACCESS_TOKENS . '} WHERE clientidentifier = :clientidentifier
+            )',
+            ['revoked' => refresh_token_entity::REVOKED_NO, 'clientidentifier' => $clientidentifier],
+        );
+
+        // Revoke all access tokens.
+        $this->db->set_field(
+            self::TABLE_ACCESS_TOKENS,
+            'revoked',
+            access_token_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier, 'revoked' => access_token_entity::REVOKED_NO],
+        );
+
+        // Revoke all authorisation codes.
+        $this->db->set_field(
+            self::TABLE_AUTH_CODES,
+            'revoked',
+            auth_code_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier, 'revoked' => auth_code_entity::REVOKED_NO],
+        );
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Reactivate a revoked client.
+     *
+     * Only the client record itself is restored. Previously revoked secrets and tokens remain revoked;
+     * new secrets must be generated and the client must go through authorisation again.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @throws moodle_exception If the client does not exist.
+     */
+    public function reactivate_client(string $clientidentifier): void {
+        $record = $this->get_client_record($clientidentifier);
+
+        if ((int) $record->status === client_entity::STATUS_ACTIVE) {
+            return;
+        }
+
+        $this->db->update_record(self::TABLE_CLIENTS, (object) [
+            'id' => $record->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'timemodified' => $this->clock->time(),
+        ]);
+    }
+
+    /**
+     * Permanently delete a client and all of its associated data.
+     *
+     * Deletion is only allowed once the client has been revoked.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @throws moodle_exception If the client does not exist or is not revoked.
+     */
+    public function delete_client(string $clientidentifier): void {
+        $record = $this->get_client_record($clientidentifier);
+
+        if ((int) $record->status !== client_entity::STATUS_REVOKED) {
+            throw new moodle_exception('oauth2serverclientnotrevoked', 'error');
+        }
+
+        $transaction = $this->db->start_delegated_transaction();
+
+        $this->db->delete_records_select(
+            self::TABLE_REFRESH_TOKENS,
+            'accesstokenidentifier IN (
+                SELECT identifier FROM {' . self::TABLE_ACCESS_TOKENS . '} WHERE clientidentifier = :clientidentifier
+            )',
+            ['clientidentifier' => $clientidentifier],
+        );
+        $this->db->delete_records(self::TABLE_ACCESS_TOKENS, ['clientidentifier' => $clientidentifier]);
+        $this->db->delete_records(self::TABLE_AUTH_CODES, ['clientidentifier' => $clientidentifier]);
+        $this->db->delete_records(self::TABLE_GRANTED_SCOPES, ['clientidentifier' => $clientidentifier]);
+        $this->db->delete_records(self::TABLE_SECRETS, ['clientidentifier' => $clientidentifier]);
+        $this->db->delete_records(self::TABLE_REDIRECT_URIS, ['clientidentifier' => $clientidentifier]);
+        $this->db->delete_records(self::TABLE_CLIENTS, ['id' => $record->id]);
+
+        $transaction->allow_commit();
+    }
+
+    // Client secrets.
+
+    /**
+     * Generate a new secret for a client.
+     *
+     * A client may have at most {@see self::MAX_ACTIVE_SECRETS} active (non-revoked, non-expired) secrets at a time.
+     * Only the hash of the secret is stored, so the returned plain text secret must be shown to the user immediately.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param int|null $expirytime The expiry timestamp of the secret, defaults to {@see self::DEFAULT_SECRET_LIFETIME} from now.
+     * @return \stdClass Object containing the secret record 'id', the plain text 'secret' and its 'expirytime'.
+     * @throws moodle_exception If the client does not exist, is revoked, is public, or the limit is reached.
+     */
+    public function generate_client_secret(string $clientidentifier, ?int $expirytime = null): \stdClass {
+        $record = $this->get_client_record($clientidentifier);
+
+        if ((int) $record->status !== client_entity::STATUS_ACTIVE) {
+            throw new moodle_exception('oauth2serverclientrevoked', 'error');
+        }
+        if (empty($record->isconfidential)) {
+            throw new moodle_exception('oauth2serverclientpublicnosecret', 'error');
+        }
+
+        $now = $this->clock->time();
+        if ($expirytime === null) {
+            $expirytime = $now + self::DEFAULT_SECRET_LIFETIME;
+        }
+        if ($expirytime <= $now) {
+            throw new \coding_exception('The secret expiry time must be in the future.');
+        }
+
+        if ($this->count_active_client_secrets($clientidentifier) >= self::MAX_ACTIVE_SECRETS) {
+            throw new moodle_exception('oauth2serversecretlimitreached', 'error', '', self::MAX_ACTIVE_SECRETS);
+        }
+
+        $plainsecret = bin2hex(random_bytes(32));
+
+        $secretid = $this->db->insert_record(self::TABLE_SECRETS, (object) [
+            'clientidentifier' => $clientidentifier,
+            'secret' => password_hash($plainsecret, PASSWORD_BCRYPT),
+            'expirytime' => $expirytime,
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'timecreated' => $now,
+        ]);
+
+        return (object) [
+            'id' => (int) $secretid,
+            'secret' => $plainsecret,
+            'expirytime' => $expirytime,
+        ];
+    }
+
+    /**
+     * Fetch the secrets of a client.
+     *
+     * The returned records never contain the secret hash.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param bool $activeonly Whether to return only active (non-revoked, non-expired) secrets.
+     * @return \stdClass[] Secret records indexed by ID.
+     */
+    public function get_client_secrets(string $clientidentifier, bool $activeonly = false): array {
+        $select = 'clientidentifier = :clientidentifier';
+        $params = ['clientidentifier' => $clientidentifier];
+        if ($activeonly) {
+            $select .= ' AND revoked = :revoked AND expirytime > :now';
+            $params['revoked'] = client_entity::SECRET_REVOKED_NO;
+            $params['now'] = $this->clock->time();
+        }
+
+        return $this->db->get_records_select(
+            self::TABLE_SECRETS,
+            $select,
+            $params,
+            'timecreated ASC, id ASC',
+            'id, clientidentifier, expirytime, revoked, timecreated, lastaccessed',
+        );
+    }
+
+    /**
+     * Revoke a client secret.
+     *
+     * @param string $clientidentifier The client identifier the secret belongs to.
+     * @param int $secretid The secret record ID.
+     * @throws moodle_exception If the secret does not exist for the given client.
+     */
+    public function revoke_client_secret(string $clientidentifier, int $secretid): void {
+        $exists = $this->db->record_exists(self::TABLE_SECRETS, [
+            'id' => $secretid,
+            'clientidentifier' => $clientidentifier,
+        ]);
+        if (!$exists) {
+            throw new moodle_exception('oauth2serversecretnotfound', 'error');
+        }
+
+        $this->db->set_field(self::TABLE_SECRETS, 'revoked', client_entity::SECRET_REVOKED_YES, ['id' => $secretid]);
+    }
+
+    // Redirect URIs.
+
+    /**
+     * Fetch the redirect URIs of a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return \stdClass[] Redirect URI records indexed by ID.
+     */
+    public function get_redirect_uris(string $clientidentifier): array {
+        return $this->db->get_records(self::TABLE_REDIRECT_URIS, ['clientidentifier' => $clientidentifier], 'id ASC');
+    }
+
+    /**
+     * Register a new redirect URI for a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The redirect URI.
+     * @return int The ID of the new redirect URI record.
+     * @throws moodle_exception If the client does not exist, the URI is invalid or already registered.
+     */
+    public function create_redirect_uri(string $clientidentifier, string $uri): int {
+        $this->get_client_record($clientidentifier);
+
+        if (!$this->is_valid_redirect_uri($uri)) {
+            throw new moodle_exception('oauth2serverinvalidredirecturi', 'error');
+        }
+
+        if ($this->find_redirect_uri($clientidentifier, $uri) !== null) {
+            throw new moodle_exception('oauth2serverredirecturiexists', 'error');
+        }
+
+        return (int) $this->db->insert_record(self::TABLE_REDIRECT_URIS, (object) [
+            'clientidentifier' => $clientidentifier,
+            'uri' => $uri,
+        ]);
+    }
+
+    /**
+     * Remove a redirect URI from a client.
+     *
+     * @param string $clientidentifier The client identifier the redirect URI belongs to.
+     * @param int $redirecturiid The redirect URI record ID.
+     * @throws moodle_exception If the redirect URI does not exist for the given client.
+     */
+    public function delete_redirect_uri(string $clientidentifier, int $redirecturiid): void {
+        $conditions = ['id' => $redirecturiid, 'clientidentifier' => $clientidentifier];
+        if (!$this->db->record_exists(self::TABLE_REDIRECT_URIS, $conditions)) {
+            throw new moodle_exception('oauth2serverredirecturinotfound', 'error');
+        }
+        $this->db->delete_records(self::TABLE_REDIRECT_URIS, $conditions);
+    }
+
+    /**
+     * Validate a redirect URI supplied in a request against those registered for a client.
+     *
+     * The URI must exactly match one of the registered redirect URIs (no prefix or wildcard matching)
+     * and must itself be a valid redirect URI (HTTPS, or HTTP for localhost/loopback addresses).
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The redirect URI to validate.
+     * @return bool True if the redirect URI is valid for the client.
+     */
+    public function validate_redirect_uri(string $clientidentifier, string $uri): bool {
+        if (!$this->is_valid_redirect_uri($uri)) {
+            return false;
+        }
+        return $this->find_redirect_uri($clientidentifier, $uri) !== null;
+    }
+
+    /**
+     * Check whether a URI is acceptable as a redirect URI.
+     *
+     * The URI must be absolute, must not contain a fragment and must use HTTPS. HTTP is only
+     * allowed for localhost and loopback addresses, to support native application development.
+     *
+     * @param string $uri The URI to check.
+     * @return bool True if the URI is acceptable.
+     */
+    public function is_valid_redirect_uri(string $uri): bool {
+        if ($uri === '' || $uri !== trim($uri) || preg_match('/[\x00-\x20\x7f]/', $uri)) {
+            return false;
+        }
+
+        $parts = parse_url($uri);
+        if ($parts === false || empty($parts['scheme']) || !isset($parts['host']) || $parts['host'] === '') {
+            return false;
+        }
+
+        // Fragments are not allowed in redirect URIs (RFC 6749 section 3.1.2).
+        if (str_contains($uri, '#')) {
+            return false;
+        }
+
+        // Credentials are not allowed in redirect URIs.
+        if (isset($parts['user']) || isset($parts['pass'])) {
+            return false;
+        }
+
+        // The host must be a plain host name, an IPv4 address or a bracketed IPv6 address (no wildcards).
+        $host = $parts['host'];
+        if (str_starts_with($host, '[')) {
+            if (!str_ends_with($host, ']') || filter_var(substr($host, 1, -1), FILTER_VALIDATE_IP, FILTER_FLAG_IPV6) === false) {
+                return false;
+            }
+        } else if (!preg_match('/^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$/i', $host)) {
+            return false;
+        }
+
+        $scheme = strtolower($parts['scheme']);
+        if ($scheme === 'https') {
+            return true;
+        }
+        if ($scheme === 'http') {
+            return $this->is_loopback_host($parts['host']);
+        }
+
+        return false;
+    }
+
+    /**
+     * Whether the given host is localhost or a loopback address.
+     *
+     * @param string $host The host as returned by parse_url().
+     * @return bool
+     */
+    protected function is_loopback_host(string $host): bool {
+        $host = strtolower(trim($host, '[]'));
+
+        if ($host === 'localhost') {
+            return true;
+        }
+
+        if (filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) !== false) {
+            return str_starts_with($host, '127.');
+        }
+
+        if (filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6) !== false) {
+            return inet_pton($host) === inet_pton('::1');
+        }
+
+        return false;
+    }
+
+    // Helpers.
+
+    /**
+     * Find an exactly matching redirect URI record for a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The URI.
+     * @return \stdClass|null
+     */
+    protected function find_redirect_uri(string $clientidentifier, string $uri): ?\stdClass {
+        // The uri column is a text field, so compare in PHP to guarantee an exact, case-sensitive match.
+        foreach ($this->get_redirect_uris($clientidentifier) as $record) {
+            if ($record->uri === $uri) {
+                return $record;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * Count the active (non-revoked, non-expired) secrets of a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return int
+     */
+    protected function count_active_client_secrets(string $clientidentifier): int {
+        return $this->db->count_records_select(
+            self::TABLE_SECRETS,
+            'clientidentifier = :clientidentifier AND revoked = :revoked AND expirytime > :now',
+            [
+                'clientidentifier' => $clientidentifier,
+                'revoked' => client_entity::SECRET_REVOKED_NO,
+                'now' => $this->clock->time(),
+            ],
+        );
+    }
+
+    /**
+     * Fetch a client record, throwing an exception if it does not exist.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return \stdClass
+     * @throws moodle_exception
+     */
+    protected function get_client_record(string $clientidentifier): \stdClass {
+        $record = $this->db->get_record(self::TABLE_CLIENTS, ['clientidentifier' => $clientidentifier]);
+        if (!$record) {
+            throw new moodle_exception('oauth2serverclientnotfound', 'error');
+        }
+        return $record;
+    }
+
+    /**
+     * Create a client entity from a client record.
+     *
+     * @param \stdClass $record The client record.
+     * @return client_entity
+     */
+    protected function create_entity(\stdClass $record): client_entity {
+        $urirecords = $this->get_redirect_uris($record->clientidentifier);
+        return client_entity::create_from_record($record, $urirecords);
+    }
+}
