+#[CoversClass(client_manager::class)]
+final class client_manager_test extends \advanced_testcase {
+    /**
+     * Create a client record directly in the database.
+     *
+     * @param string $identifier The client identifier.
+     * @param array $data Additional data.
+     * @return \stdClass The client record.
+     */
+    protected function create_client(string $identifier = 'client-1', array $data = []): \stdClass {
+        global $DB;
+
+        $record = (object) array_merge([
+            'name' => 'Client ' . $identifier,
+            'description' => 'Description',
+            'clientidentifier' => $identifier,
+            'ownercontext' => \context_system::instance()->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'isconfidential' => 1,
+            'timecreated' => time(),
+        ], $data);
+        $record->id = $DB->insert_record('oauth2_server_clients', $record);
+
+        return $record;
+    }
+
+    /**
+     * Create an access token, refresh token and auth code for a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $suffix Unique suffix for token identifiers.
+     */
+    protected function create_tokens(string $clientidentifier, string $suffix = '1'): void {
+        global $DB;
+
+        $user = $this->getDataGenerator()->create_user();
+        $DB->insert_record('oauth2_server_client_access_tokens', (object) [
+            'identifier' => "access-{$suffix}",
+            'userid' => $user->id,
+            'clientidentifier' => $clientidentifier,
+            'scopes' => 'scope1',
+            'expirytime' => time() + HOURSECS,
+            'revoked' => access_token_entity::REVOKED_NO,
+            'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_refresh_tokens', (object) [
+            'identifier' => "refresh-{$suffix}",
+            'accesstokenidentifier' => "access-{$suffix}",
+            'expirytime' => time() + DAYSECS,
+            'revoked' => refresh_token_entity::REVOKED_NO,
+            'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_auth_codes', (object) [
+            'identifier' => "code-{$suffix}",
+            'userid' => $user->id,
+            'clientidentifier' => $clientidentifier,
+            'redirecturi' => 'https://example.test/callback',
+            'scopes' => 'scope1',
+            'expirytime' => time() + 600,
+            'revoked' => auth_code_entity::REVOKED_NO,
+            'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_granted_scopes', (object) [
+            'clientidentifier' => $clientidentifier,
+            'userid' => $user->id,
+            'scope' => 'scope1',
+            'timecreated' => time(),
+        ]);
+    }
