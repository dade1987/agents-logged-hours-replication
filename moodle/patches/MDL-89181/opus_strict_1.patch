+    public function test_revoke_client_cascades(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $this->create_client('client-1');
+        $this->create_client('client-2');
+        $manager = $this->get_manager();
+        $manager->generate_client_secret('client-1');
+        $manager->generate_client_secret('client-2');
+        $this->create_tokens('client-1', '1');
+        $this->create_tokens('client-2', '2');
+
+        $manager->revoke_client('client-1');
+
+        $this->assertSame(client_entity::STATUS_REVOKED, $manager->get_client_by_identifier('client-1')->get_status());
+        $this->assertEmpty($manager->get_client_secrets('client-1', true));
+        $this->assertEquals(access_token_entity::REVOKED_YES,
+            $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['identifier' => 'access-1']));
+        $this->assertEquals(refresh_token_entity::REVOKED_YES,
+            $DB->get_field('oauth2_server_client_refresh_tokens', 'revoked', ['identifier' => 'refresh-1']));
+        $this->assertEquals(auth_code_entity::REVOKED_YES,
+            $DB->get_field('oauth2_server_client_auth_codes', 'revoked', ['identifier' => 'code-1']));
+
+        // Other clients are unaffected.
+        $this->assertSame(client_entity::STATUS_ACTIVE, $manager->get_client_by_identifier('client-2')->get_status());
+        $this->assertCount(1, $manager->get_client_secrets('client-2', true));
+        $this->assertEquals(access_token_entity::REVOKED_NO,
+            $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['identifier' => 'access-2']));
+        $this->assertEquals(refresh_token_entity::REVOKED_NO,
+            $DB->get_field('oauth2_server_client_refresh_tokens', 'revoked', ['identifier' => 'refresh-2']));
+        $this->assertEquals(auth_code_entity::REVOKED_NO,
+            $DB->get_field('oauth2_server_client_auth_codes', 'revoked', ['identifier' => 'code-2']));
+    }
