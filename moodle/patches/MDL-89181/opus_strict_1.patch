+    public function test_generate_client_secret(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $clock = $this->mock_clock_with_frozen();
+
+        $this->create_client('client-1');
+        $manager = $this->get_manager();
+
+        $secret = $manager->generate_client_secret('client-1');
+        $this->assertNotEmpty($secret->secret);
+        $this->assertSame($clock->time() + client_manager::DEFAULT_SECRET_LIFETIME, $secret->expirytime);
+
+        // Only the hash is stored.
+        $stored = $DB->get_field('oauth2_server_client_secrets', 'secret', ['id' => $secret->id]);
+        $this->assertNotSame($secret->secret, $stored);
+        $this->assertTrue(password_verify($secret->secret, $stored));
+
+        // The hash is never returned.
+        $secrets = $manager->get_client_secrets('client-1');
+        $this->assertCount(1, $secrets);
+        $this->assertObjectNotHasProperty('secret', reset($secrets));
+
+        $custom = $manager->generate_client_secret('client-1', $clock->time() + 100);
+        $this->assertSame($clock->time() + 100, $custom->expirytime);
+    }
