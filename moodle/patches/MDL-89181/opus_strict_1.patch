+    public function test_validate_redirect_uri_exact_match(): void {
+        $this->resetAfterTest();
+
+        $this->create_client('client-1');
+        $this->create_client('client-2');
+        $manager = $this->get_manager();
+        $manager->create_redirect_uri('client-1', 'https://example.test/callback');
+        $manager->create_redirect_uri('client-1', 'http://127.0.0.1:8080/cb');
+
+        $this->assertTrue($manager->validate_redirect_uri('client-1', 'https://example.test/callback'));
+        $this->assertTrue($manager->validate_redirect_uri('client-1', 'http://127.0.0.1:8080/cb'));
+
+        // No prefix, suffix, case or query variations.
+        $this->assertFalse($manager->validate_redirect_uri('client-1', 'https://example.test/callback/extra'));
+        $this->assertFalse($manager->validate_redirect_uri('client-1', 'https://example.test/call'));
+        $this->assertFalse($manager->validate_redirect_uri('client-1', 'https://example.test/callback?x=1'));
+        $this->assertFalse($manager->validate_redirect_uri('client-1', 'https://example.test/Callback'));
+        $this->assertFalse($manager->validate_redirect_uri('client-1', 'https://example.test/callback/'));
+        $this->assertFalse($manager->validate_redirect_uri('client-1', 'http://example.test/callback'));
+        $this->assertFalse($manager->validate_redirect_uri('client-1', 'http://127.0.0.1:8081/cb'));
+
+        // URIs are per client.
+        $this->assertFalse($manager->validate_redirect_uri('client-2', 'https://example.test/callback'));
+        $this->assertFalse($manager->validate_redirect_uri('missing', 'https://example.test/callback'));
+    }
