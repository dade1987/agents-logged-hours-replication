+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\oauth2\server;
+
+use core\exception\moodle_exception;
+use core\oauth2\server\entity\access_token_entity;
+use core\oauth2\server\entity\auth_code_entity;
+use core\oauth2\server\entity\client_entity;
+use core\oauth2\server\entity\refresh_token_entity;
+
+/**
+ * Manager for OAuth2 server clients, their secrets and redirect URIs.
+ *
+ * This class must be loaded via the dependency injection container: \core\di::get(client_manager::class).
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class client_manager {
+    /** @var int Maximum number of active secrets per client. */
+    public const int MAX_ACTIVE_SECRETS = 2;
+
+    /** @var int Default lifetime of a generated secret, in seconds (one year). */
+    public const int SECRET_LIFETIME = YEARSECS;
+
+    /**
+     * Get a client by its ID.
+     *
+     * @param int $id The client ID.
+     * @return \stdClass|null The client record, or null if not found.
+     */
+    public function get_client_by_id(int $id): ?\stdClass {
+        global $DB;
+        $record = $DB->get_record('oauth2_server_clients', ['id' => $id]);
+        return $record ?: null;
+    }
+
+    /**
+     * Get a client by its public client identifier.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return \stdClass|null The client record, or null if not found.
+     */
+    public function get_client_by_identifier(string $clientidentifier): ?\stdClass {
+        global $DB;
+        $record = $DB->get_record('oauth2_server_clients', ['clientidentifier' => $clientidentifier]);
+        return $record ?: null;
+    }
+
+    /**
+     * Update the administrative metadata (name, description) of a client.
+     *
+     * Any other property of the data object is ignored.
+     *
+     * @param int $id The client ID.
+     * @param \stdClass|array $data Object or array with 'name' and/or 'description'.
+     * @return \stdClass The updated client record.
+     */
+    public function update_client(int $id, \stdClass|array $data): \stdClass {
+        global $DB;
+
+        $client = $this->get_existing_client($id);
+        $data = (array) $data;
+
+        $update = (object) ['id' => $client->id];
+        if (array_key_exists('name', $data)) {
+            $name = trim((string) $data['name']);
+            if ($name === '') {
+                throw new moodle_exception('invalidparameter', 'debug', '', null, 'Client name cannot be empty');
+            }
+            $update->name = $name;
+        }
+        if (array_key_exists('description', $data)) {
+            $update->description = $data['description'];
+        }
+        $update->timemodified = time();
+
+        $DB->update_record('oauth2_server_clients', $update);
+
+        return $this->get_existing_client($id);
+    }
+
+    /**
+     * Revoke a client, immediately revoking all its active tokens, authorisation codes and secrets.
+     *
+     * @param int $id The client ID.
+     */
+    public function revoke_client(int $id): void {
+        global $DB;
+
+        $client = $this->get_existing_client($id);
+        $identifier = $client->clientidentifier;
+
+        $transaction = $DB->start_delegated_transaction();
+
+        $DB->set_field('oauth2_server_clients', 'status', client_entity::STATUS_REVOKED, ['id' => $client->id]);
+        $DB->set_field('oauth2_server_clients', 'timemodified', time(), ['id' => $client->id]);
+
+        // Refresh tokens are linked to the client through their access token.
+        $DB->execute(
+            "UPDATE {oauth2_server_client_refresh_tokens}
+                SET revoked = :revoked
+              WHERE accesstokenidentifier IN (
+                    SELECT identifier
+                      FROM {oauth2_server_client_access_tokens}
+                     WHERE clientidentifier = :clientidentifier)",
+            ['revoked' => refresh_token_entity::REVOKED_YES, 'clientidentifier' => $identifier]
+        );
+        $DB->set_field(
+            'oauth2_server_client_access_tokens',
+            'revoked',
+            access_token_entity::REVOKED_YES,
+            ['clientidentifier' => $identifier]
+        );
+        $DB->set_field(
+            'oauth2_server_client_auth_codes',
+            'revoked',
+            auth_code_entity::REVOKED_YES,
+            ['clientidentifier' => $identifier]
+        );
+        $DB->set_field(
+            'oauth2_server_client_secrets',
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['clientidentifier' => $identifier]
+        );
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Reactivate a revoked client.
+     *
+     * Only the client record is restored; revoked secrets and tokens stay revoked.
+     *
+     * @param int $id The client ID.
+     */
+    public function reactivate_client(int $id): void {
+        global $DB;
+
+        $client = $this->get_existing_client($id);
+        if ((int) $client->status !== client_entity::STATUS_REVOKED) {
+            throw new moodle_exception('invalidparameter', 'debug', '', null, 'Client is not revoked');
+        }
+
+        $DB->update_record('oauth2_server_clients', (object) [
+            'id' => $client->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'timemodified' => time(),
+        ]);
+    }
+
+    /**
+     * Permanently delete a client and all its related data. The client must be revoked first.
+     *
+     * @param int $id The client ID.
+     */
+    public function delete_client(int $id): void {
+        global $DB;
+
+        $client = $this->get_existing_client($id);
+        if ((int) $client->status !== client_entity::STATUS_REVOKED) {
+            throw new moodle_exception('invalidparameter', 'debug', '', null, 'Client must be revoked before it can be deleted');
+        }
+        $identifier = $client->clientidentifier;
+
+        $transaction = $DB->start_delegated_transaction();
+
+        $DB->execute(
+            "DELETE FROM {oauth2_server_client_refresh_tokens}
+              WHERE accesstokenidentifier IN (
+                    SELECT identifier
+                      FROM {oauth2_server_client_access_tokens}
+                     WHERE clientidentifier = :clientidentifier)",
+            ['clientidentifier' => $identifier]
+        );
+        foreach (
+            [
+                'oauth2_server_client_access_tokens',
+                'oauth2_server_client_auth_codes',
+                'oauth2_server_client_granted_scopes',
+                'oauth2_server_client_secrets',
+                'oauth2_server_client_redirect_uris',
+            ] as $table
+        ) {
+            $DB->delete_records($table, ['clientidentifier' => $identifier]);
+        }
+        $DB->delete_records('oauth2_server_clients', ['id' => $client->id]);
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Generate a new secret for a client.
+     *
+     * A client may have at most self::MAX_ACTIVE_SECRETS active (non-revoked, non-expired) secrets.
+     *
+     * @param int $clientid The client ID.
+     * @param int|null $expirytime Optional expiry timestamp. Defaults to one year from now.
+     * @return string The plaintext secret. It is only available at generation time; only a hash is stored.
+     */
+    public function generate_client_secret(int $clientid, ?int $expirytime = null): string {
+        global $DB;
+
+        $client = $this->get_existing_client($clientid);
+        if ((int) $client->status !== client_entity::STATUS_ACTIVE) {
+            throw new moodle_exception('invalidparameter', 'debug', '', null, 'Cannot generate a secret for a revoked client');
+        }
+
+        $now = time();
+        $expirytime ??= $now + self::SECRET_LIFETIME;
+        if ($expirytime <= $now) {
+            throw new moodle_exception('invalidparameter', 'debug', '', null, 'Secret expiry time must be in the future');
+        }
+
+        if (count($this->get_client_secrets($client->clientidentifier, true)) >= self::MAX_ACTIVE_SECRETS) {
+            throw new moodle_exception(
+                'invalidparameter',
+                'debug',
+                '',
+                null,
+                'Maximum number of active secrets (' . self::MAX_ACTIVE_SECRETS . ') reached for this client'
+            );
+        }
+
+        $plaintext = bin2hex(random_bytes(32));
+        $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => $client->clientidentifier,
+            'secret' => password_hash($plaintext, PASSWORD_DEFAULT),
+            'expirytime' => $expirytime,
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'timecreated' => $now,
+        ]);
+
+        return $plaintext;
+    }
+
+    /**
+     * Get the secrets of a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param bool $activeonly Only return non-revoked, non-expired secrets.
+     * @return \stdClass[] Secret records indexed by ID.
+     */
+    public function get_client_secrets(string $clientidentifier, bool $activeonly = false): array {
+        global $DB;
+
+        if (!$activeonly) {
+            return $DB->get_records('oauth2_server_client_secrets', ['clientidentifier' => $clientidentifier], 'id ASC');
+        }
+        return $DB->get_records_select(
+            'oauth2_server_client_secrets',
+            'clientidentifier = :clientidentifier AND revoked = :revoked AND expirytime > :now',
+            [
+                'clientidentifier' => $clientidentifier,
+                'revoked' => client_entity::SECRET_REVOKED_NO,
+                'now' => time(),
+            ],
+            'id ASC'
+        );
+    }
+
+    /**
+     * Revoke a client secret.
+     *
+     * @param int $secretid The secret ID.
+     */
+    public function revoke_client_secret(int $secretid): void {
+        global $DB;
+
+        $DB->get_record('oauth2_server_client_secrets', ['id' => $secretid], 'id', MUST_EXIST);
+        $DB->set_field('oauth2_server_client_secrets', 'revoked', client_entity::SECRET_REVOKED_YES, ['id' => $secretid]);
+    }
+
+    /**
+     * Get the redirect URIs of a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return \stdClass[] Redirect URI records indexed by ID.
+     */
+    public function get_redirect_uris(string $clientidentifier): array {
+        global $DB;
+        return $DB->get_records('oauth2_server_client_redirect_uris', ['clientidentifier' => $clientidentifier], 'id ASC');
+    }
+
+    /**
+     * Add a redirect URI to a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The redirect URI.
+     * @return int The ID of the new redirect URI record.
+     */
+    public function create_redirect_uri(string $clientidentifier, string $uri): int {
+        global $DB;
+
+        if ($this->get_client_by_identifier($clientidentifier) === null) {
+            throw new moodle_exception('invalidparameter', 'debug', '', null, 'Client does not exist');
+        }
+        if (!$this->is_valid_redirect_uri_format($uri)) {
+            throw new moodle_exception(
+                'invalidparameter',
+                'debug',
+                '',
+                null,
+                'Redirect URI must be an absolute HTTPS URI (HTTP is only allowed for localhost) without a fragment'
+            );
+        }
+        foreach ($this->get_redirect_uris($clientidentifier) as $existing) {
+            if ($existing->uri === $uri) {
+                throw new moodle_exception('invalidparameter', 'debug', '', null, 'Redirect URI already registered');
+            }
+        }
+
+        return $DB->insert_record('oauth2_server_client_redirect_uris', (object) [
+            'clientidentifier' => $clientidentifier,
+            'uri' => $uri,
+        ]);
+    }
+
+    /**
+     * Remove a redirect URI.
+     *
+     * @param int $uriid The redirect URI record ID.
+     */
+    public function remove_redirect_uri(int $uriid): void {
+        global $DB;
+        $DB->get_record('oauth2_server_client_redirect_uris', ['id' => $uriid], 'id', MUST_EXIST);
+        $DB->delete_records('oauth2_server_client_redirect_uris', ['id' => $uriid]);
+    }
+
+    /**
+     * Validate a redirect URI requested for a client: it must have a valid format and exactly match a registered URI.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The requested redirect URI.
+     * @return bool True if the URI is valid for the client.
+     */
+    public function validate_redirect_uri(string $clientidentifier, string $uri): bool {
+        if (!$this->is_valid_redirect_uri_format($uri)) {
+            return false;
+        }
+        foreach ($this->get_redirect_uris($clientidentifier) as $registered) {
+            if ($registered->uri === $uri) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Check the format of a redirect URI: absolute, no fragment, HTTPS (HTTP allowed for localhost/loopback only).
+     *
+     * @param string $uri The URI.
+     * @return bool
+     */
+    public function is_valid_redirect_uri_format(string $uri): bool {
+        if ($uri === '' || preg_match('/[\s\x00-\x1f]/', $uri) || str_contains($uri, '#')) {
+            return false;
+        }
+        $parts = parse_url($uri);
+        if ($parts === false || empty($parts['scheme']) || empty($parts['host'])) {
+            return false;
+        }
+        if (isset($parts['user']) || isset($parts['pass'])) {
+            return false;
+        }
+        $scheme = strtolower($parts['scheme']);
+        if ($scheme === 'https') {
+            return true;
+        }
+        return $scheme === 'http' && $this->is_loopback_host($parts['host']);
+    }
+
+    /**
+     * Whether a host is localhost or a loopback address.
+     *
+     * @param string $host The host part of a URI.
+     * @return bool
+     */
+    protected function is_loopback_host(string $host): bool {
+        $host = strtolower(trim($host, '[]'));
+        if ($host === 'localhost' || $host === '::1') {
+            return true;
+        }
+        return (bool) preg_match('/^127(\.(25[0-5]|2[0-4]\d|1?\d?\d)){3}$/', $host);
+    }
+
+    /**
+     * Get an existing client or throw.
+     *
+     * @param int $id The client ID.
+     * @return \stdClass
+     */
+    protected function get_existing_client(int $id): \stdClass {
+        $client = $this->get_client_by_id($id);
+        if ($client === null) {
+            throw new moodle_exception('invalidparameter', 'debug', '', null, 'Client does not exist');
+        }
+        return $client;
+    }
+}
