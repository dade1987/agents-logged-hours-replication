@@ -0,0 +1,358 @@
+<?php
+// This file is part of Moodle - http://moodle.org/
+//
+// Moodle is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// Moodle is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\oauth2\server;
+
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
+use core\oauth2\server\entity\client_entity;
+
+/**
+ * Tests for {@see client_manager}.
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[CoversClass(client_manager::class)]
+final class client_manager_test extends \advanced_testcase {
+    /**
+     * Get the manager through the DI container.
+     *
+     * @return client_manager
+     */
+    private function get_manager(): client_manager {
+        return \core\di::get(client_manager::class);
+    }
+
+    /**
+     * Create a client record.
+     *
+     * @param int $status
+     * @param string $identifier
+     * @return \stdClass
+     */
+    private function create_client(int $status = client_entity::STATUS_ACTIVE, string $identifier = 'client1'): \stdClass {
+        global $DB;
+        $record = (object) [
+            'name' => 'Client ' . $identifier,
+            'description' => 'Description',
+            'clientidentifier' => $identifier,
+            'ownercontext' => \context_system::instance()->id,
+            'status' => $status,
+            'isconfidential' => 1,
+            'timecreated' => time(),
+        ];
+        $record->id = $DB->insert_record('oauth2_server_clients', $record);
+        return $record;
+    }
+
+    /**
+     * Test fetching clients.
+     */
+    public function test_get_client(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+
+        $this->assertEquals($client->id, $manager->get_client_by_id($client->id)->id);
+        $this->assertEquals($client->id, $manager->get_client_by_identifier('client1')->id);
+        $this->assertNull($manager->get_client_by_id(999999));
+        $this->assertNull($manager->get_client_by_identifier('missing'));
+    }
+
+    /**
+     * Test only name and description can be updated.
+     */
+    public function test_update_client(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+
+        $updated = $manager->update_client($client->id, [
+            'name' => 'New name',
+            'description' => 'New description',
+            'clientidentifier' => 'hacked',
+            'status' => client_entity::STATUS_REVOKED,
+        ]);
+        $this->assertEquals('New name', $updated->name);
+        $this->assertEquals('New description', $updated->description);
+        $this->assertEquals('client1', $updated->clientidentifier);
+        $this->assertEquals(client_entity::STATUS_ACTIVE, $updated->status);
+
+        $this->expectException(\moodle_exception::class);
+        $manager->update_client($client->id, ['name' => ' ']);
+    }
+
+    /**
+     * Test revoking a client cascades to secrets and tokens, and reactivation does not restore them.
+     */
+    public function test_revoke_and_reactivate_client(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+        $other = $this->create_client(client_entity::STATUS_ACTIVE, 'client2');
+
+        $manager->generate_client_secret($client->id);
+        $manager->generate_client_secret($other->id);
+        foreach (['client1', 'client2'] as $identifier) {
+            $DB->insert_record('oauth2_server_client_access_tokens', (object) [
+                'identifier' => 'at-' . $identifier,
+                'clientidentifier' => $identifier,
+                'scopes' => 'a',
+                'expirytime' => time() + 100,
+                'revoked' => 0,
+                'timecreated' => time(),
+            ]);
+            $DB->insert_record('oauth2_server_client_refresh_tokens', (object) [
+                'identifier' => 'rt-' . $identifier,
+                'accesstokenidentifier' => 'at-' . $identifier,
+                'expirytime' => time() + 100,
+                'revoked' => 0,
+                'timecreated' => time(),
+            ]);
+        }
+
+        $manager->revoke_client($client->id);
+
+        $this->assertEquals(client_entity::STATUS_REVOKED, $manager->get_client_by_id($client->id)->status);
+        $this->assertCount(0, $manager->get_client_secrets('client1', true));
+        $this->assertEquals(1, $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['identifier' => 'at-client1']));
+        $this->assertEquals(1, $DB->get_field('oauth2_server_client_refresh_tokens', 'revoked', ['identifier' => 'rt-client1']));
+        // Other clients are untouched.
+        $this->assertCount(1, $manager->get_client_secrets('client2', true));
+        $this->assertEquals(0, $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['identifier' => 'at-client2']));
+        $this->assertEquals(0, $DB->get_field('oauth2_server_client_refresh_tokens', 'revoked', ['identifier' => 'rt-client2']));
+
+        $manager->reactivate_client($client->id);
+        $this->assertEquals(client_entity::STATUS_ACTIVE, $manager->get_client_by_id($client->id)->status);
+        $this->assertCount(0, $manager->get_client_secrets('client1', true));
+        $this->assertCount(1, $manager->get_client_secrets('client1'));
+        $this->assertEquals(1, $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['identifier' => 'at-client1']));
+        $this->assertEquals(1, $DB->get_field('oauth2_server_client_refresh_tokens', 'revoked', ['identifier' => 'rt-client1']));
+    }
+
+    /**
+     * Test reactivating a client that is not revoked fails.
+     */
+    public function test_reactivate_active_client(): void {
+        $this->resetAfterTest();
+        $client = $this->create_client();
+        $this->expectException(\moodle_exception::class);
+        $this->get_manager()->reactivate_client($client->id);
+    }
+
+    /**
+     * Test deleting a client that is not revoked is rejected.
+     */
+    public function test_delete_client_before_revoke(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+        try {
+            $manager->delete_client($client->id);
+            $this->fail('Exception expected');
+        } catch (\moodle_exception $e) {
+            $this->assertNotNull($manager->get_client_by_id($client->id));
+        }
+    }
+
+    /**
+     * Test deleting a revoked client removes related data.
+     */
+    public function test_delete_client(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+        $manager->generate_client_secret($client->id);
+        $manager->create_redirect_uri('client1', 'https://example.com/cb');
+        $manager->revoke_client($client->id);
+
+        $manager->delete_client($client->id);
+
+        $this->assertNull($manager->get_client_by_id($client->id));
+        $this->assertEmpty($manager->get_client_secrets('client1'));
+        $this->assertEmpty($manager->get_redirect_uris('client1'));
+        $this->assertFalse($DB->record_exists('oauth2_server_clients', ['id' => $client->id]));
+    }
+
+    /**
+     * Test secret generation, limit, and revocation.
+     */
+    public function test_client_secrets(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+        $other = $this->create_client(client_entity::STATUS_ACTIVE, 'client2');
+
+        $secret1 = $manager->generate_client_secret($client->id);
+        $secret2 = $manager->generate_client_secret($client->id);
+        $this->assertNotEquals($secret1, $secret2);
+
+        $secrets = $manager->get_client_secrets('client1', true);
+        $this->assertCount(2, $secrets);
+        $first = reset($secrets);
+        $this->assertNotEquals($secret1, $first->secret);
+        $this->assertTrue(password_verify($secret1, $first->secret));
+
+        // Limit exceeded.
+        try {
+            $manager->generate_client_secret($client->id);
+            $this->fail('Exception expected');
+        } catch (\moodle_exception $e) {
+            $this->assertCount(2, $manager->get_client_secrets('client1'));
+        }
+
+        // The limit is per client.
+        $manager->generate_client_secret($other->id);
+        $this->assertCount(1, $manager->get_client_secrets('client2', true));
+
+        // Revoking frees a slot.
+        $manager->revoke_client_secret($first->id);
+        $this->assertCount(1, $manager->get_client_secrets('client1', true));
+        $this->assertCount(2, $manager->get_client_secrets('client1'));
+        $manager->generate_client_secret($client->id);
+        $this->assertCount(2, $manager->get_client_secrets('client1', true));
+    }
