+    /**
+     * Test redirect URI validation requires an exact match.
+     */
+    public function test_validate_redirect_uri(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        $this->create_client();
+        $this->create_client(client_entity::STATUS_ACTIVE, 'client2');
+        $manager->create_redirect_uri('client1', 'https://example.com/cb');
+
+        $this->assertTrue($manager->validate_redirect_uri('client1', 'https://example.com/cb'));
+        $this->assertFalse($manager->validate_redirect_uri('client1', 'https://example.com/cb/'));
+        $this->assertFalse($manager->validate_redirect_uri('client1', 'https://example.com/cb/sub'));
+        $this->assertFalse($manager->validate_redirect_uri('client1', 'https://example.com'));
+        $this->assertFalse($manager->validate_redirect_uri('client1', 'https://example.com/cb?x=1'));
+        $this->assertFalse($manager->validate_redirect_uri('client1', 'http://example.com/cb'));
+        $this->assertFalse($manager->validate_redirect_uri('client2', 'https://example.com/cb'));
+    }
