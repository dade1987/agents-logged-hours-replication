+    /**
+     * Test creating, fetching and removing redirect URIs.
+     */
+    public function test_redirect_uris(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+        $other = $this->create_client();
+
+        $this->assertSame([], $manager->get_redirect_uris($client->id));
+
+        $uri1 = $manager->create_redirect_uri($client->id, 'https://example.test/callback');
+        $uri2 = $manager->create_redirect_uri($client->id, 'http://localhost:8080/callback');
+        $uri3 = $manager->create_redirect_uri($client->id, 'https://example.test/callback/other');
+        $this->assertSame($client->clientidentifier, $uri1->clientidentifier);
+        $this->assertSame('https://example.test/callback', $uri1->uri);
+        $this->assertTrue($DB->record_exists('oauth2_server_client_redirect_uris', ['id' => $uri1->id]));
+
+        // The same URI may be registered for a different client.
+        $otheruri = $manager->create_redirect_uri($other->id, 'https://example.test/callback');
+
+        $uris = $manager->get_redirect_uris($client->id);
+        $this->assertSame([$uri1->id, $uri2->id, $uri3->id], array_keys($uris));
+        $this->assertSame(
+            ['https://example.test/callback', 'http://localhost:8080/callback', 'https://example.test/callback/other'],
+            array_values(array_map(fn($uri) => $uri->uri, $uris)),
+        );
+        $this->assertSame([$otheruri->id], array_keys($manager->get_redirect_uris($other->id)));
+
+        // The entity reflects the registered URIs.
+        $this->assertEqualsCanonicalizing(
+            ['https://example.test/callback', 'http://localhost:8080/callback', 'https://example.test/callback/other'],
+            array_values($manager->get_client_by_id($client->id)->getRedirectUri()),
+        );
+
+        $manager->delete_redirect_uri($uri2->id);
+        $this->assertSame([$uri1->id, $uri3->id], array_keys($manager->get_redirect_uris($client->id)));
+        $this->assertSame([$otheruri->id], array_keys($manager->get_redirect_uris($other->id)));
+        $this->assertFalse($DB->record_exists('oauth2_server_client_redirect_uris', ['id' => $uri2->id]));
+    }
