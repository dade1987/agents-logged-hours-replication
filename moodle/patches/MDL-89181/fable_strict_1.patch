+    /**
+     * Test generating client secrets.
+     */
+    public function test_generate_client_secret(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        // The client repository relies on the real time when validating secrets, so freeze the clock at the current time.
+        $now = time();
+        $clock = $this->mock_clock_with_frozen($now);
+
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+
+        $secret = $manager->generate_client_secret($client->id);
+
+        $this->assertNotEmpty($secret->plainsecret);
+        $this->assertSame(64, strlen($secret->plainsecret));
+        $this->assertSame($client->clientidentifier, $secret->clientidentifier);
+        $this->assertSame($now + client_manager::DEFAULT_SECRET_LIFETIME, $secret->expirytime);
+        $this->assertSame(client_entity::SECRET_REVOKED_NO, $secret->revoked);
+        $this->assertSame($now, $secret->timecreated);
+
+        $record = $DB->get_record('oauth2_server_client_secrets', ['id' => $secret->id], '*', MUST_EXIST);
+        // Only a hash of the secret is stored.
+        $this->assertNotSame($secret->plainsecret, $record->secret);
+        $this->assertTrue(password_verify($secret->plainsecret, $record->secret));
+        $this->assertEquals($secret->expirytime, $record->expirytime);
+        $this->assertNull($record->lastaccessed);
+
+        // The generated secret can be used to validate the client through the client repository.
+        $repository = new \core\oauth2\server\repository\client_repository();
+        $this->assertTrue($repository->validateClient($client->clientidentifier, $secret->plainsecret, null));
+        $this->assertFalse($repository->validateClient($client->clientidentifier, 'wrong', null));
+
+        // A custom expiry time can be provided, and each secret is unique.
+        $clock->bump(5);
+        $secret2 = $manager->generate_client_secret($client->id, $now + (2 * YEARSECS));
+        $this->assertSame($now + (2 * YEARSECS), $secret2->expirytime);
+        $this->assertNotSame($secret->plainsecret, $secret2->plainsecret);
+        $this->assertNotSame($secret->id, $secret2->id);
+    }
