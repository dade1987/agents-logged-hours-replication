+    /**
+     * Test that the per-client limit of active secrets is enforced.
+     */
+    public function test_generate_client_secret_limit(): void {
+        $this->resetAfterTest();
+        $clock = $this->mock_clock_with_frozen(1700000000);
+
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+        $other = $this->create_client();
+
+        $secret1 = $manager->generate_client_secret($client->id);
+        $secret2 = $manager->generate_client_secret($client->id, 1700000000 + HOURSECS);
+        $this->assertCount(client_manager::MAX_ACTIVE_SECRETS, $manager->get_client_secrets($client->id, true));
+
+        try {
+            $manager->generate_client_secret($client->id);
+            $this->fail('Generating more than the maximum number of active secrets must throw.');
+        } catch (moodle_exception $e) {
+            $this->assertSame('oauth2serversecretlimitexceeded', $e->errorcode);
+        }
+        $this->assertCount(2, $manager->get_client_secrets($client->id));
+
+        // The limit is per client: another client can still generate secrets.
+        $manager->generate_client_secret($other->id);
+        $this->assertCount(1, $manager->get_client_secrets($other->id, true));
+
+        // Revoking a secret frees up a slot.
+        $manager->revoke_client_secret($secret1->id);
+        $secret3 = $manager->generate_client_secret($client->id);
+        $this->assertCount(2, $manager->get_client_secrets($client->id, true));
+        $this->assertCount(3, $manager->get_client_secrets($client->id));
+
+        try {
+            $manager->generate_client_secret($client->id);
+            $this->fail('Generating more than the maximum number of active secrets must throw.');
+        } catch (moodle_exception $e) {
+            $this->assertSame('oauth2serversecretlimitexceeded', $e->errorcode);
+        }
+
+        // An expired secret also frees up a slot.
+        $clock->bump(HOURSECS + 1);
+        $this->assertCount(1, $manager->get_client_secrets($client->id, true));
+        $secret4 = $manager->generate_client_secret($client->id);
+        $active = $manager->get_client_secrets($client->id, true);
+        $this->assertCount(2, $active);
+        $this->assertArrayHasKey($secret3->id, $active);
+        $this->assertArrayHasKey($secret4->id, $active);
+        $this->assertArrayNotHasKey($secret1->id, $active);
+        $this->assertArrayNotHasKey($secret2->id, $active);
+        $this->assertCount(4, $manager->get_client_secrets($client->id));
+    }
