+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\oauth2\server;
+
+use core\clock;
+use core\exception\coding_exception;
+use core\exception\moodle_exception;
+use core\oauth2\server\entity\access_token_entity;
+use core\oauth2\server\entity\auth_code_entity;
+use core\oauth2\server\entity\client_entity;
+use core\oauth2\server\entity\refresh_token_entity;
+
+/**
+ * OAuth2 server client manager.
+ *
+ * Centralised management of OAuth2 server clients, their secrets and their redirect URIs.
+ *
+ * This class is expected to be obtained through the dependency injection container, e.g.
+ * `\core\di::get(client_manager::class)`, rather than instantiated directly.
+ *
+ * @package    core
+ * @copyright  2026 Mihail Geshoski <mihailgesoski@gmail.com>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class client_manager {
+    /** @var int The maximum number of active (non-revoked, non-expired) secrets allowed per client */
+    public const int MAX_ACTIVE_SECRETS = 2;
+
+    /** @var int The default lifetime of a generated client secret, in seconds (one year) */
+    public const int DEFAULT_SECRET_LIFETIME = YEARSECS;
+
+    /** @var int The number of random bytes used when generating a client secret */
+    private const int SECRET_BYTES = 32;
+
+    /** @var string[] The client fields that may be modified through {@see update_client()} */
+    private const array UPDATABLE_CLIENT_FIELDS = ['name', 'description'];
+
+    /**
+     * Constructor.
+     *
+     * @param clock $clock The clock.
+     */
+    public function __construct(
+        private readonly clock $clock,
+    ) {
+    }
+
+    /**
+     * Get a client by its database ID.
+     *
+     * @param int $id The client ID.
+     * @return client_entity|null The client entity, or null if it does not exist.
+     */
+    public function get_client_by_id(int $id): ?client_entity {
+        global $DB;
+
+        $record = $DB->get_record('oauth2_server_clients', ['id' => $id]);
+
+        return $record ? $this->build_client_entity($record) : null;
+    }
+
+    /**
+     * Get a client by its public client identifier.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return client_entity|null The client entity, or null if it does not exist.
+     */
+    public function get_client_by_identifier(string $clientidentifier): ?client_entity {
+        global $DB;
+
+        $record = $DB->get_record('oauth2_server_clients', ['clientidentifier' => $clientidentifier]);
+
+        return $record ? $this->build_client_entity($record) : null;
+    }
+
+    /**
+     * Update the administrative metadata of a client.
+     *
+     * Only the name and description can be modified. Any other field in the updates array is ignored.
+     *
+     * @param int $clientid The client ID.
+     * @param array $updates The updates, keyed by field name (name, description).
+     * @return client_entity The updated client entity.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function update_client(int $clientid, array $updates): client_entity {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+
+        $filteredupdates = array_intersect_key($updates, array_flip(self::UPDATABLE_CLIENT_FIELDS));
+
+        if (!empty($filteredupdates)) {
+            if (array_key_exists('name', $filteredupdates) && trim((string) $filteredupdates['name']) === '') {
+                throw new coding_exception('The OAuth2 client name cannot be empty.');
+            }
+
+            foreach ($filteredupdates as $field => $value) {
+                $record->{$field} = $value;
+            }
+            $record->timemodified = $this->clock->time();
+
+            $DB->update_record('oauth2_server_clients', $record);
+        }
+
+        return $this->build_client_entity($record);
+    }
+
+    /**
+     * Revoke a client.
+     *
+     * Revoking a client immediately revokes all of the client's active secrets, authorisation codes,
+     * access tokens and refresh tokens, fully cutting off access.
+     *
+     * @param int $clientid The client ID.
+     * @return void
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function revoke_client(int $clientid): void {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+
+        $transaction = $DB->start_delegated_transaction();
+
+        if ((int) $record->status !== client_entity::STATUS_REVOKED) {
+            $record->status = client_entity::STATUS_REVOKED;
+            $record->timemodified = $this->clock->time();
+            $DB->update_record('oauth2_server_clients', $record);
+        }
+
+        $this->revoke_client_credentials($record->clientidentifier);
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Reactivate a revoked client.
+     *
+     * Only the client record itself is restored. Previously-revoked secrets and tokens remain revoked, so the
+     * client must generate new secrets and go through authorisation again in order to obtain new tokens.
+     *
+     * @param int $clientid The client ID.
+     * @return void
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function reactivate_client(int $clientid): void {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+
+        if ((int) $record->status === client_entity::STATUS_ACTIVE) {
+            return;
+        }
+
+        $record->status = client_entity::STATUS_ACTIVE;
+        $record->timemodified = $this->clock->time();
+        $DB->update_record('oauth2_server_clients', $record);
+    }
+
+    /**
+     * Permanently delete a client, together with its secrets, redirect URIs, tokens, codes and granted scopes.
+     *
+     * As a safety guard against accidentally destroying a live integration, a client can only be deleted
+     * once it has been revoked.
+     *
+     * @param int $clientid The client ID.
+     * @return void
+     * @throws \dml_missing_record_exception If the client does not exist.
+     * @throws moodle_exception If the client has not been revoked.
+     */
+    public function delete_client(int $clientid): void {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+
+        if ((int) $record->status !== client_entity::STATUS_REVOKED) {
+            throw new moodle_exception('oauth2serverclientnotrevoked', 'error', '', $record->name);
+        }
+
+        $clientidentifier = $record->clientidentifier;
+        $transaction = $DB->start_delegated_transaction();
+
+        // Refresh tokens are linked to access tokens rather than to the client directly.
+        $accesstokenids = $DB->get_fieldset(
+            'oauth2_server_client_access_tokens',
+            'identifier',
+            ['clientidentifier' => $clientidentifier],
+        );
+        if (!empty($accesstokenids)) {
+            [$insql, $inparams] = $DB->get_in_or_equal($accesstokenids, SQL_PARAMS_NAMED);
+            $DB->delete_records_select(
+                'oauth2_server_client_refresh_tokens',
+                "accesstokenidentifier {$insql}",
+                $inparams,
+            );
+        }
+
+        $DB->delete_records('oauth2_server_client_access_tokens', ['clientidentifier' => $clientidentifier]);
+        $DB->delete_records('oauth2_server_client_auth_codes', ['clientidentifier' => $clientidentifier]);
+        $DB->delete_records('oauth2_server_client_granted_scopes', ['clientidentifier' => $clientidentifier]);
+        $DB->delete_records('oauth2_server_client_secrets', ['clientidentifier' => $clientidentifier]);
+        $DB->delete_records('oauth2_server_client_redirect_uris', ['clientidentifier' => $clientidentifier]);
+        $DB->delete_records('oauth2_server_clients', ['id' => $clientid]);
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Generate a new secret for a client.
+     *
+     * The raw (plain-text) secret is only available in the returned value. Only a hash of it is stored, so it
+     * cannot be retrieved afterwards.
+     *
+     * A client may have at most {@see MAX_ACTIVE_SECRETS} active (non-revoked, non-expired) secrets at a time.
+     *
+     * @param int $clientid The client ID.
+     * @param int|null $expirytime The expiry timestamp, or null to use the default lifetime.
+     * @return \stdClass The stored secret record, with the additional `plainsecret` property holding the raw secret.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     * @throws coding_exception If the expiry time is not in the future.
+     * @throws moodle_exception If the client already has the maximum number of active secrets.
+     */
+    public function generate_client_secret(int $clientid, ?int $expirytime = null): \stdClass {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+        $now = $this->clock->time();
+
+        if ($expirytime === null) {
+            $expirytime = $now + self::DEFAULT_SECRET_LIFETIME;
+        } else if ($expirytime <= $now) {
+            throw new coding_exception('The OAuth2 client secret expiry time must be in the future.');
+        }
+
+        $activecount = count($this->get_client_secrets($clientid, true));
+        if ($activecount >= self::MAX_ACTIVE_SECRETS) {
+            throw new moodle_exception('oauth2serversecretlimitexceeded', 'error', '', self::MAX_ACTIVE_SECRETS);
+        }
+
+        $plainsecret = bin2hex(random_bytes(self::SECRET_BYTES));
+
+        $secret = new \stdClass();
+        $secret->clientidentifier = $record->clientidentifier;
+        $secret->secret = password_hash($plainsecret, PASSWORD_DEFAULT);
+        $secret->expirytime = $expirytime;
+        $secret->revoked = client_entity::SECRET_REVOKED_NO;
+        $secret->timecreated = $now;
+        $secret->lastaccessed = null;
+        $secret->id = $DB->insert_record('oauth2_server_client_secrets', $secret);
+
+        // Expose the raw secret to the caller. This is the only time it is available.
+        $secret->plainsecret = $plainsecret;
+
+        return $secret;
+    }
+
+    /**
+     * Get the secrets of a client.
+     *
+     * @param int $clientid The client ID.
+     * @param bool $activeonly If true, only non-revoked and non-expired secrets are returned.
+     * @return \stdClass[] The secret records, ordered by creation time, keyed by ID.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function get_client_secrets(int $clientid, bool $activeonly = false): array {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+
+        $select = 'clientidentifier = :clientidentifier';
+        $params = ['clientidentifier' => $record->clientidentifier];
+
+        if ($activeonly) {
+            $select .= ' AND revoked = :revoked AND expirytime > :now';
+            $params += [
+                'revoked' => client_entity::SECRET_REVOKED_NO,
+                'now' => $this->clock->time(),
+            ];
+        }
+
+        return $DB->get_records_select('oauth2_server_client_secrets', $select, $params, 'timecreated ASC, id ASC');
+    }
+
+    /**
+     * Revoke a client secret.
+     *
+     * @param int $secretid The secret ID.
+     * @return void
+     * @throws \dml_missing_record_exception If the secret does not exist.
+     */
+    public function revoke_client_secret(int $secretid): void {
+        global $DB;
+
+        $DB->get_record('oauth2_server_client_secrets', ['id' => $secretid], 'id', MUST_EXIST);
+
+        $DB->set_field(
+            'oauth2_server_client_secrets',
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['id' => $secretid],
+        );
+    }
+
+    /**
+     * Get the redirect URIs registered for a client.
+     *
+     * @param int $clientid The client ID.
+     * @return \stdClass[] The redirect URI records, keyed by ID.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function get_redirect_uris(int $clientid): array {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+
+        return $DB->get_records(
+            'oauth2_server_client_redirect_uris',
+            ['clientidentifier' => $record->clientidentifier],
+            'id ASC',
+        );
+    }
+
+    /**
+     * Register a new redirect URI for a client.
+     *
+     * The URI must use HTTPS, unless it points to localhost or a loopback address. There is no limit on the number
+     * of redirect URIs a client may have, but the same URI cannot be registered twice for the same client.
+     *
+     * @param int $clientid The client ID.
+     * @param string $uri The redirect URI.
+     * @return \stdClass The created redirect URI record.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     * @throws moodle_exception If the URI is not valid or is already registered for the client.
+     */
+    public function create_redirect_uri(int $clientid, string $uri): \stdClass {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+
+        if (!$this->is_valid_redirect_uri($uri)) {
+            throw new moodle_exception('oauth2serverinvalidredirecturi', 'error', '', $uri);
+        }
+
+        if ($this->find_redirect_uri($record->clientidentifier, $uri) !== null) {
+            throw new moodle_exception('oauth2serverredirecturiexists', 'error', '', $uri);
+        }
+
+        $redirecturi = new \stdClass();
+        $redirecturi->clientidentifier = $record->clientidentifier;
+        $redirecturi->uri = $uri;
+        $redirecturi->id = $DB->insert_record('oauth2_server_client_redirect_uris', $redirecturi);
+
+        return $redirecturi;
+    }
+
+    /**
+     * Remove a redirect URI.
+     *
+     * @param int $redirecturiid The redirect URI ID.
+     * @return void
+     * @throws \dml_missing_record_exception If the redirect URI does not exist.
+     */
+    public function delete_redirect_uri(int $redirecturiid): void {
+        global $DB;
+
+        $DB->get_record('oauth2_server_client_redirect_uris', ['id' => $redirecturiid], 'id', MUST_EXIST);
+
+        $DB->delete_records('oauth2_server_client_redirect_uris', ['id' => $redirecturiid]);
+    }
+
+    /**
+     * Validate a redirect URI against the redirect URIs registered for a client.
+     *
+     * The URI must be well-formed (see {@see is_valid_redirect_uri()}) and must exactly match one of the
+     * redirect URIs registered for the client. No prefix or wildcard matching is performed.
+     *
+     * @param int $clientid The client ID.
+     * @param string $uri The redirect URI to validate.
+     * @return bool True if the URI is valid and registered for the client, false otherwise.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function validate_redirect_uri(int $clientid, string $uri): bool {
+        $record = $this->get_client_record($clientid);
+
+        if (!$this->is_valid_redirect_uri($uri)) {
+            return false;
+        }
+
+        return $this->find_redirect_uri($record->clientidentifier, $uri) !== null;
+    }
+
+    /**
+     * Check whether a redirect URI is well-formed and uses an acceptable scheme.
+     *
+     * The URI must be absolute, must not contain a fragment, and must use the HTTPS scheme. The HTTP scheme is
+     * only accepted for localhost and loopback addresses, in order to support native app development.
+     *
+     * @param string $uri The redirect URI.
+     * @return bool True if the URI is acceptable, false otherwise.
+     */
+    public function is_valid_redirect_uri(string $uri): bool {
+        if (trim($uri) !== $uri || $uri === '') {
+            return false;
+        }
+
+        $parts = parse_url($uri);
+        if ($parts === false || empty($parts['scheme']) || empty($parts['host'])) {
+            return false;
+        }
+
+        // Redirect URIs must not include a fragment component (RFC 6749, section 3.1.2).
+        if (isset($parts['fragment']) || str_contains($uri, '#')) {
+            return false;
+        }
+
+        $scheme = strtolower($parts['scheme']);
+
+        if ($scheme === 'https') {
+            return true;
+        }
+
+        if ($scheme === 'http') {
+            return $this->is_loopback_host($parts['host']);
+        }
+
+        return false;
+    }
+
+    /**
+     * Check whether a host is localhost or a loopback address.
+     *
+     * @param string $host The host component of a URI.
+     * @return bool
+     */
+    private function is_loopback_host(string $host): bool {
+        $host = strtolower(trim($host, '[]'));
+
+        if ($host === 'localhost' || $host === '::1') {
+            return true;
+        }
+
+        // Any address within the 127.0.0.0/8 block is a loopback address.
+        if (filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) !== false) {
+            return str_starts_with($host, '127.');
+        }
+
+        return false;
+    }
+
+    /**
+     * Find a registered redirect URI record by exact match.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The redirect URI.
+     * @return \stdClass|null The redirect URI record, or null if the URI is not registered for the client.
+     */
+    private function find_redirect_uri(string $clientidentifier, string $uri): ?\stdClass {
+        global $DB;
+
+        $records = $DB->get_records('oauth2_server_client_redirect_uris', ['clientidentifier' => $clientidentifier]);
+
+        foreach ($records as $record) {
+            // Exact, case-sensitive comparison. No prefix or wildcard matching.
+            if ($record->uri === $uri) {
+                return $record;
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * Revoke all active secrets, authorisation codes, access tokens and refresh tokens of a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return void
+     */
+    private function revoke_client_credentials(string $clientidentifier): void {
+        global $DB;
+
+        $DB->set_field(
+            'oauth2_server_client_secrets',
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['clientidentifier' => $clientidentifier, 'revoked' => client_entity::SECRET_REVOKED_NO],
+        );
+
+        $DB->set_field(
+            'oauth2_server_client_auth_codes',
+            'revoked',
+            auth_code_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier, 'revoked' => auth_code_entity::REVOKED_NO],
+        );
+
+        // Refresh tokens are linked to access tokens rather than to the client directly, so they must be revoked
+        // before the related access tokens are marked as revoked.
+        $accesstokenids = $DB->get_fieldset(
+            'oauth2_server_client_access_tokens',
+            'identifier',
+            ['clientidentifier' => $clientidentifier],
+        );
+        if (!empty($accesstokenids)) {
+            [$insql, $inparams] = $DB->get_in_or_equal($accesstokenids, SQL_PARAMS_NAMED);
+            $DB->set_field_select(
+                'oauth2_server_client_refresh_tokens',
+                'revoked',
+                refresh_token_entity::REVOKED_YES,
+                "accesstokenidentifier {$insql} AND revoked = :revoked",
+                $inparams + ['revoked' => refresh_token_entity::REVOKED_NO],
+            );
+        }
+
+        $DB->set_field(
+            'oauth2_server_client_access_tokens',
+            'revoked',
+            access_token_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier, 'revoked' => access_token_entity::REVOKED_NO],
+        );
+    }
+
+    /**
+     * Get the raw database record of a client.
+     *
+     * @param int $clientid The client ID.
+     * @return \stdClass The client record.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    private function get_client_record(int $clientid): \stdClass {
+        global $DB;
+
+        return $DB->get_record('oauth2_server_clients', ['id' => $clientid], '*', MUST_EXIST);
+    }
+
+    /**
+     * Build a client entity from a client record, including its redirect URIs.
+     *
+     * @param \stdClass $record The client record.
+     * @return client_entity
+     */
+    private function build_client_entity(\stdClass $record): client_entity {
+        global $DB;
+
+        $urirecords = $DB->get_records(
+            'oauth2_server_client_redirect_uris',
+            ['clientidentifier' => $record->clientidentifier],
+            'id ASC',
+        );
+
+        return client_entity::create_from_record($record, $urirecords);
+    }
+}
diff --git a/public/lib/classes/oauth2/server/entity/client_entity.php b/public/lib/classes/oauth2/server/entity/client_entity.php
index c29a4e98bba..46e1fb4c72c 100644
--- a/public/lib/classes/oauth2/server/entity/client_entity.php
+++ b/public/lib/classes/oauth2/server/entity/client_entity.php
@@ -45,6 +45,9 @@ class client_entity implements ClientEntityInterface {
