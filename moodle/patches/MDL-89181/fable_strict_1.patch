+        $othersecret = $this->create_secret($other->clientidentifier);
+        [$accesstoken, $refreshtoken, $authcode] = $this->create_tokens($client->clientidentifier, $user->id);
+        [$otheraccess, $otherrefresh, $othercode] = $this->create_tokens($other->clientidentifier, $user->id);
+
+        $clock->bump(10);
+        $manager->revoke_client($client->id);
+
+        $record = $DB->get_record('oauth2_server_clients', ['id' => $client->id], '*', MUST_EXIST);
+        $this->assertEquals(client_entity::STATUS_REVOKED, $record->status);
+        $this->assertEquals(1700000010, $record->timemodified);
+        $this->assertSame(client_entity::STATUS_REVOKED, $manager->get_client_by_id($client->id)->get_status());
+
+        foreach ([$secret1, $secret2] as $secretid) {
+            $this->assertEquals(
+                client_entity::SECRET_REVOKED_YES,
+                $DB->get_field('oauth2_server_client_secrets', 'revoked', ['id' => $secretid]),
+            );
+        }
+        $this->assertEmpty($manager->get_client_secrets($client->id, true));
+        $this->assertEquals(
+            access_token_entity::REVOKED_YES,
+            $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['identifier' => $accesstoken]),
+        );
+        $this->assertEquals(
+            refresh_token_entity::REVOKED_YES,
+            $DB->get_field('oauth2_server_client_refresh_tokens', 'revoked', ['identifier' => $refreshtoken]),
+        );
+        $this->assertEquals(
+            auth_code_entity::REVOKED_YES,
+            $DB->get_field('oauth2_server_client_auth_codes', 'revoked', ['identifier' => $authcode]),
+        );
+
+        // The other client is untouched.
+        $this->assertEquals(
+            client_entity::STATUS_ACTIVE,
+            $DB->get_field('oauth2_server_clients', 'status', ['id' => $other->id]),
+        );
+        $this->assertEquals(
+            client_entity::SECRET_REVOKED_NO,
+            $DB->get_field('oauth2_server_client_secrets', 'revoked', ['id' => $othersecret]),
+        );
+        $this->assertEquals(
+            access_token_entity::REVOKED_NO,
+            $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['identifier' => $otheraccess]),
+        );
+        $this->assertEquals(
+            refresh_token_entity::REVOKED_NO,
+            $DB->get_field('oauth2_server_client_refresh_tokens', 'revoked', ['identifier' => $otherrefresh]),
+        );
+        $this->assertEquals(
+            auth_code_entity::REVOKED_NO,
+            $DB->get_field('oauth2_server_client_auth_codes', 'revoked', ['identifier' => $othercode]),
+        );
+
+        // Revoking an already revoked client is a no-op that still cascades to any new credentials.
+        $secret3 = $this->create_secret($client->clientidentifier);
+        $manager->revoke_client($client->id);
+        $this->assertEquals(
+            client_entity::SECRET_REVOKED_YES,
+            $DB->get_field('oauth2_server_client_secrets', 'revoked', ['id' => $secret3]),
+        );
+    }
