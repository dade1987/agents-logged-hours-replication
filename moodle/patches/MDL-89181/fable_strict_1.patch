+    private function create_secret(string $clientidentifier, array $overrides = []): int {
+        global $DB;
+
+        $record = (object) array_merge([
+            'clientidentifier' => $clientidentifier,
+            'secret' => password_hash('secret', PASSWORD_DEFAULT),
+            'expirytime' => time() + DAYSECS,
