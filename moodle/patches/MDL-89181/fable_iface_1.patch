+namespace core\oauth2\server;
+
+use core\clock;
+use core\context;
+use core\exception\invalid_parameter_exception;
+use core\exception\invalid_state_exception;
+use core\exception\not_found_exception;
+use core\oauth2\server\entity\access_token_entity;
+use core\oauth2\server\entity\auth_code_entity;
+use core\oauth2\server\entity\client_entity;
+use core\oauth2\server\entity\refresh_token_entity;
+
+/**
+ * OAuth2 server client manager.
+ *
+ * Centralised management of OAuth2 server clients, their secrets and their redirect URIs.
+ *
+ * This class is intended to be resolved via dependency injection, e.g.:
+ *
+ *     $manager = \core\di::get(\core\oauth2\server\client_manager::class);
+ *
+ * @package    core
+ * @copyright  2026 Mihail Geshoski <mihailgesoski@gmail.com>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class client_manager {
+    /** @var int The maximum number of active (non-revoked, non-expired) secrets a client may hold at any time. */
+    public const int MAX_ACTIVE_SECRETS = 2;
+
+    /** @var int The default lifetime of a client secret, in seconds (one year). */
+    public const int DEFAULT_SECRET_LIFETIME = YEARSECS;
+
+    /** @var string The table storing the clients. */
+    private const string TABLE_CLIENTS = 'oauth2_server_clients';
+
+    /** @var string The table storing the client secrets. */
+    private const string TABLE_SECRETS = 'oauth2_server_client_secrets';
+
+    /** @var string The table storing the client redirect URIs. */
+    private const string TABLE_REDIRECT_URIS = 'oauth2_server_client_redirect_uris';
+
+    /** @var string The table storing the access tokens. */
+    private const string TABLE_ACCESS_TOKENS = 'oauth2_server_client_access_tokens';
+
+    /** @var string The table storing the refresh tokens. */
+    private const string TABLE_REFRESH_TOKENS = 'oauth2_server_client_refresh_tokens';
+
+    /** @var string The table storing the authorisation codes. */
+    private const string TABLE_AUTH_CODES = 'oauth2_server_client_auth_codes';
+
+    /** @var string The table storing the granted scopes. */
+    private const string TABLE_GRANTED_SCOPES = 'oauth2_server_client_granted_scopes';
+
+    /** @var string[] The client fields that may be modified via {@see update_client()}. */
+    private const array UPDATABLE_FIELDS = ['name', 'description'];
+
+    /** @var string[] Hosts that are treated as loopback addresses and therefore do not require HTTPS. */
+    private const array LOOPBACK_HOSTS = ['localhost', '127.0.0.1', '[::1]', '::1'];
+
+    /**
+     * Constructor.
+     *
+     * @param clock $clock The clock to use for all time calculations.
+     */
+    public function __construct(
+        /** @var clock The clock. */
+        private readonly clock $clock,
+    ) {
+    }
+
+    /**
+     * Create a new OAuth2 client.
+     *
+     * @param string $name The human-readable name of the client.
+     * @param context $ownercontext The context owning the client.
+     * @param string[] $redirecturis The redirect URIs registered for the client.
+     * @param string|null $description An optional human-readable description.
+     * @param bool $isconfidential Whether the client can securely maintain a secret.
+     * @return client_entity The newly created client.
+     * @throws invalid_parameter_exception If the name is empty or any of the redirect URIs is invalid.
+     */
+    public function create_client(
+        string $name,
+        context $ownercontext,
+        array $redirecturis = [],
+        ?string $description = null,
+        bool $isconfidential = true,
+    ): client_entity {
+        global $DB;
+
+        $name = trim($name);
+        if ($name === '') {
+            throw new invalid_parameter_exception('The client name cannot be empty.');
+        }
+
+        // Validate and normalise the redirect URIs before writing anything.
+        $uris = [];
+        foreach ($redirecturis as $uri) {
+            $uri = trim((string) $uri);
+            if (!$this->is_valid_redirect_uri_format($uri)) {
+                throw new invalid_parameter_exception("Invalid redirect URI: {$uri}");
+            }
+            $uris[$uri] = $uri;
+        }
+
+        $now = $this->clock->time();
+        $clientidentifier = $this->generate_client_identifier();
+
+        $transaction = $DB->start_delegated_transaction();
+
+        $record = (object) [
+            'name' => $name,
+            'description' => $description,
+            'clientidentifier' => $clientidentifier,
+            'ownercontext' => $ownercontext->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'isconfidential' => $isconfidential ? 1 : 0,
+            'timecreated' => $now,
+            'timemodified' => $now,
+            'lastaccessed' => null,
+        ];
+        $DB->insert_record(self::TABLE_CLIENTS, $record);
+
+        foreach ($uris as $uri) {
+            $DB->insert_record(self::TABLE_REDIRECT_URIS, (object) [
+                'clientidentifier' => $clientidentifier,
+                'uri' => $uri,
+            ]);
+        }
+
+        $transaction->allow_commit();
+
+        return $this->get_client($clientidentifier);
+    }
+
+    /**
+     * Get a client by its public client identifier.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return client_entity|null The client, or null if it does not exist.
+     */
+    public function get_client(string $clientidentifier): ?client_entity {
+        global $DB;
+
+        $record = $DB->get_record(self::TABLE_CLIENTS, ['clientidentifier' => $clientidentifier]);
+        if (!$record) {
+            return null;
+        }
+
+        return $this->build_entity($record);
+    }
+
+    /**
+     * Get a client by its database ID.
+     *
+     * @param int $clientid The client ID.
+     * @return client_entity|null The client, or null if it does not exist.
+     */
+    public function get_client_by_id(int $clientid): ?client_entity {
+        global $DB;
+
+        $record = $DB->get_record(self::TABLE_CLIENTS, ['id' => $clientid]);
+        if (!$record) {
+            return null;
+        }
+
+        return $this->build_entity($record);
+    }
+
+    /**
+     * Update the administrative metadata of a client.
+     *
+     * Only the 'name' and 'description' fields may be modified.
+     *
+     * @param int $clientid The client ID.
+     * @param array $updates An associative array of field => value pairs.
+     * @throws not_found_exception If the client does not exist.
+     * @throws invalid_parameter_exception If an unsupported field is supplied or the name is empty.
+     */
+    public function update_client(int $clientid, array $updates): void {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+
+        $unsupported = array_diff(array_keys($updates), self::UPDATABLE_FIELDS);
+        if (!empty($unsupported)) {
+            throw new invalid_parameter_exception(
+                'Only the following client fields can be updated: ' . implode(', ', self::UPDATABLE_FIELDS) .
+                '. Unsupported field(s): ' . implode(', ', $unsupported)
+            );
+        }
+
+        if (empty($updates)) {
+            return;
+        }
+
+        $update = (object) ['id' => $record->id];
+
+        if (array_key_exists('name', $updates)) {
+            $name = trim((string) $updates['name']);
+            if ($name === '') {
+                throw new invalid_parameter_exception('The client name cannot be empty.');
+            }
+            $update->name = $name;
+        }
+
+        if (array_key_exists('description', $updates)) {
+            $update->description = $updates['description'] === null ? null : (string) $updates['description'];
+        }
+
+        $update->timemodified = $this->clock->time();
+
+        $DB->update_record(self::TABLE_CLIENTS, $update);
+    }
+
+    /**
+     * Revoke a client.
+     *
+     * Revoking a client cascades to all of its active secrets, authorisation codes, access tokens and refresh tokens,
+     * fully cutting off access for the client.
+     *
+     * @param int $clientid The client ID.
+     * @throws not_found_exception If the client does not exist.
+     */
+    public function revoke_client(int $clientid): void {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+        $clientidentifier = $record->clientidentifier;
+        $now = $this->clock->time();
+
+        $transaction = $DB->start_delegated_transaction();
+
+        // Revoke the client itself.
+        $DB->update_record(self::TABLE_CLIENTS, (object) [
+            'id' => $record->id,
+            'status' => client_entity::STATUS_REVOKED,
+            'timemodified' => $now,
+        ]);
+
+        // Revoke all of the client secrets.
+        $DB->set_field(
+            self::TABLE_SECRETS,
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['clientidentifier' => $clientidentifier],
+        );
+
+        // Revoke all of the authorisation codes.
+        $DB->set_field(
+            self::TABLE_AUTH_CODES,
+            'revoked',
+            auth_code_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier],
+        );
+
+        // Revoke all of the refresh tokens associated with the client access tokens.
+        $accesstokensql = "SELECT tok.identifier
+                             FROM {" . self::TABLE_ACCESS_TOKENS . "} tok
+                            WHERE tok.clientidentifier = :clientidentifier";
+        $DB->execute(
+            "UPDATE {" . self::TABLE_REFRESH_TOKENS . "}
+                SET revoked = :revoked
+              WHERE accesstokenidentifier IN ({$accesstokensql})",
+            [
+                'revoked' => refresh_token_entity::REVOKED_YES,
+                'clientidentifier' => $clientidentifier,
+            ],
+        );
+
+        // Revoke all of the access tokens.
+        $DB->set_field(
+            self::TABLE_ACCESS_TOKENS,
+            'revoked',
+            access_token_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier],
+        );
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Reactivate a previously revoked client.
+     *
+     * Only the client record itself is restored. Previously revoked secrets and tokens remain revoked: the client
+     * must generate new secrets and go through the authorisation flow again to obtain new tokens.
+     *
+     * @param int $clientid The client ID.
+     * @throws not_found_exception If the client does not exist.
+     */
+    public function reactivate_client(int $clientid): void {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+
+        if ((int) $record->status === client_entity::STATUS_ACTIVE) {
+            return;
+        }
+
+        $DB->update_record(self::TABLE_CLIENTS, (object) [
+            'id' => $record->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'timemodified' => $this->clock->time(),
+        ]);
+    }
+
+    /**
+     * Permanently delete a client and all of its associated data.
+     *
+     * The client must already be revoked before it can be deleted.
+     *
+     * @param int $clientid The client ID.
+     * @throws not_found_exception If the client does not exist.
+     * @throws invalid_state_exception If the client has not been revoked.
+     */
+    public function delete_client(int $clientid): void {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+
+        if ((int) $record->status !== client_entity::STATUS_REVOKED) {
+            throw new invalid_state_exception(
+                'The client must be revoked before it can be deleted.',
+                "Client ID: {$clientid}",
+            );
+        }
+
+        $clientidentifier = $record->clientidentifier;
+
+        $transaction = $DB->start_delegated_transaction();
+
+        // Refresh tokens reference access tokens, so they must be removed first.
+        $accesstokensql = "SELECT tok.identifier
+                             FROM {" . self::TABLE_ACCESS_TOKENS . "} tok
+                            WHERE tok.clientidentifier = :clientidentifier";
+        $DB->delete_records_select(
+            self::TABLE_REFRESH_TOKENS,
+            "accesstokenidentifier IN ({$accesstokensql})",
+            ['clientidentifier' => $clientidentifier],
+        );
+
+        $DB->delete_records(self::TABLE_ACCESS_TOKENS, ['clientidentifier' => $clientidentifier]);
+        $DB->delete_records(self::TABLE_AUTH_CODES, ['clientidentifier' => $clientidentifier]);
+        $DB->delete_records(self::TABLE_GRANTED_SCOPES, ['clientidentifier' => $clientidentifier]);
+        $DB->delete_records(self::TABLE_SECRETS, ['clientidentifier' => $clientidentifier]);
+        $DB->delete_records(self::TABLE_REDIRECT_URIS, ['clientidentifier' => $clientidentifier]);
+        $DB->delete_records(self::TABLE_CLIENTS, ['id' => $record->id]);
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Generate a new secret for a client.
+     *
+     * The plain text secret is returned exactly once; only a hash of it is stored.
+     *
+     * @param int $clientid The client ID.
+     * @param int|null $expirytime The timestamp at which the secret expires. Defaults to one year from now.
+     * @return string The plain text secret.
+     * @throws not_found_exception If the client does not exist.
+     * @throws invalid_parameter_exception If the expiry time is in the past.
+     * @throws invalid_state_exception If the client already has the maximum number of active secrets.
+     */
+    public function create_secret(int $clientid, ?int $expirytime = null): string {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+        $now = $this->clock->time();
+
+        if ($expirytime === null) {
+            $expirytime = $now + self::DEFAULT_SECRET_LIFETIME;
+        } else if ($expirytime <= $now) {
+            throw new invalid_parameter_exception('The secret expiry time must be in the future.');
+        }
+
+        $activesecrets = $this->get_secrets($clientid);
+        if (count($activesecrets) >= self::MAX_ACTIVE_SECRETS) {
+            throw new invalid_state_exception(
+                'The client already has the maximum number of active secrets (' . self::MAX_ACTIVE_SECRETS . ').',
+                "Client ID: {$clientid}",
+            );
+        }
+
+        $secret = $this->generate_secret();
+
+        $DB->insert_record(self::TABLE_SECRETS, (object) [
+            'clientidentifier' => $record->clientidentifier,
+            'secret' => password_hash($secret, PASSWORD_DEFAULT),
+            'expirytime' => $expirytime,
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'timecreated' => $now,
+            'lastaccessed' => null,
+        ]);
+
+        return $secret;
+    }
+
+    /**
+     * Get the secrets of a client.
+     *
+     * Note that the returned records contain only the hashed secrets, never the plain text values.
+     *
+     * @param int $clientid The client ID.
+     * @param bool $includeinactive Whether to include revoked and expired secrets.
+     * @return \stdClass[] The secret records, indexed by ID.
+     * @throws not_found_exception If the client does not exist.
+     */
+    public function get_secrets(int $clientid, bool $includeinactive = false): array {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+
+        $select = 'clientidentifier = :clientidentifier';
+        $params = ['clientidentifier' => $record->clientidentifier];
+
+        if (!$includeinactive) {
+            $select .= ' AND revoked = :revoked AND expirytime > :now';
+            $params['revoked'] = client_entity::SECRET_REVOKED_NO;
+            $params['now'] = $this->clock->time();
+        }
+
+        return $DB->get_records_select(self::TABLE_SECRETS, $select, $params, 'timecreated ASC, id ASC');
+    }
+
+    /**
+     * Revoke a client secret.
+     *
+     * @param int $secretid The secret ID.
+     * @throws not_found_exception If the secret does not exist.
+     */
+    public function revoke_secret(int $secretid): void {
+        global $DB;
+
+        $secret = $DB->get_record(self::TABLE_SECRETS, ['id' => $secretid]);
+        if (!$secret) {
+            throw new not_found_exception('secret', (string) $secretid);
+        }
+
+        if ((int) $secret->revoked === client_entity::SECRET_REVOKED_YES) {
+            return;
+        }
+
+        $DB->set_field(self::TABLE_SECRETS, 'revoked', client_entity::SECRET_REVOKED_YES, ['id' => $secretid]);
+    }
+
+    /**
+     * Get the redirect URIs registered for a client.
+     *
+     * @param int $clientid The client ID.
+     * @return string[] The redirect URIs.
+     * @throws not_found_exception If the client does not exist.
+     */
+    public function get_redirect_uris(int $clientid): array {
+        $record = $this->get_client_record($clientid);
+
+        return $this->get_redirect_uris_for_identifier($record->clientidentifier);
+    }
+
+    /**
+     * Register a new redirect URI for a client.
+     *
+     * @param int $clientid The client ID.
+     * @param string $uri The redirect URI.
+     * @throws not_found_exception If the client does not exist.
+     * @throws invalid_parameter_exception If the URI is invalid or already registered.
+     */
+    public function add_redirect_uri(int $clientid, string $uri): void {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+        $uri = trim($uri);
+
+        if (!$this->is_valid_redirect_uri_format($uri)) {
+            throw new invalid_parameter_exception("Invalid redirect URI: {$uri}");
+        }
+
+        if (in_array($uri, $this->get_redirect_uris_for_identifier($record->clientidentifier), true)) {
+            throw new invalid_parameter_exception("The redirect URI is already registered for this client: {$uri}");
+        }
+
+        $DB->insert_record(self::TABLE_REDIRECT_URIS, (object) [
+            'clientidentifier' => $record->clientidentifier,
+            'uri' => $uri,
+        ]);
+    }
+
+    /**
+     * Remove a redirect URI from a client.
+     *
+     * @param int $clientid The client ID.
+     * @param string $uri The redirect URI to remove.
+     * @throws not_found_exception If the client does not exist, or the URI is not registered for the client.
+     */
+    public function remove_redirect_uri(int $clientid, string $uri): void {
+        global $DB;
+
+        $record = $this->get_client_record($clientid);
+        $uri = trim($uri);
+
+        $uris = $DB->get_records(self::TABLE_REDIRECT_URIS, ['clientidentifier' => $record->clientidentifier]);
+        $ids = [];
+        foreach ($uris as $urirecord) {
+            if ($urirecord->uri === $uri) {
+                $ids[] = $urirecord->id;
+            }
+        }
+
+        if (empty($ids)) {
+            throw new not_found_exception('redirect URI', $uri);
+        }
+
+        $DB->delete_records_list(self::TABLE_REDIRECT_URIS, 'id', $ids);
+    }
+
+    /**
+     * Validate a redirect URI against the URIs registered for a client.
+     *
+     * The URI must exactly match one of the registered URIs (no prefix or wildcard matching), and must use HTTPS
+     * unless it points to localhost or a loopback address.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The redirect URI to validate.
+     * @return bool True if the URI is valid for the client, false otherwise.
+     */
+    public function validate_redirect_uri(string $clientidentifier, string $uri): bool {
+        global $DB;
+
+        if (!$this->is_valid_redirect_uri_format($uri)) {
+            return false;
+        }
+
+        if (!$DB->record_exists(self::TABLE_CLIENTS, ['clientidentifier' => $clientidentifier])) {
+            return false;
+        }
+
+        return in_array($uri, $this->get_redirect_uris_for_identifier($clientidentifier), true);
+    }
+
+    /**
+     * Check whether a redirect URI is well formed and uses an acceptable scheme.
+     *
+     * The URI must be an absolute URI with a host, must not contain a fragment, and must use the HTTPS scheme unless
+     * the host is localhost or a loopback address, in which case HTTP is also permitted.
+     *
+     * @param string $uri The URI to check.
+     * @return bool True if the URI is acceptable, false otherwise.
+     */
+    private function is_valid_redirect_uri_format(string $uri): bool {
+        if ($uri === '' || $uri !== trim($uri)) {
+            return false;
+        }
+
+        // Reject any control characters or whitespace.
+        if (preg_match('/[\s\x00-\x1F\x7F]/', $uri)) {
+            return false;
+        }
+
+        $parts = parse_url($uri);
+        if ($parts === false || empty($parts['scheme']) || empty($parts['host'])) {
+            return false;
+        }
+
+        // Redirect URIs must not contain a fragment component (RFC 6749, Section 3.1.2).
+        if (isset($parts['fragment'])) {
+            return false;
+        }
+
+        $scheme = strtolower($parts['scheme']);
+        $host = strtolower($parts['host']);
+
+        if ($scheme === 'https') {
+            return true;
+        }
+
+        if ($scheme === 'http' && in_array($host, self::LOOPBACK_HOSTS, true)) {
+            return true;
+        }
+
+        return false;
+    }
+
+    /**
+     * Get the redirect URIs registered for a client identifier.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return string[] The redirect URIs.
+     */
+    private function get_redirect_uris_for_identifier(string $clientidentifier): array {
+        global $DB;
+
+        $records = $DB->get_records(
+            self::TABLE_REDIRECT_URIS,
+            ['clientidentifier' => $clientidentifier],
+            'id ASC',
+            'id, uri',
+        );
+
+        return array_values(array_map(static fn(\stdClass $record): string => $record->uri, $records));
+    }
+
+    /**
+     * Get the database record of a client, throwing if it does not exist.
+     *
+     * @param int $clientid The client ID.
+     * @return \stdClass The client record.
+     * @throws not_found_exception If the client does not exist.
+     */
+    private function get_client_record(int $clientid): \stdClass {
+        global $DB;
+
+        $record = $DB->get_record(self::TABLE_CLIENTS, ['id' => $clientid]);
+        if (!$record) {
+            throw new not_found_exception('OAuth2 client', (string) $clientid);
+        }
+
+        return $record;
+    }
+
+    /**
+     * Build a client entity from a client database record.
+     *
+     * @param \stdClass $record The client record.
+     * @return client_entity The client entity.
+     */
+    private function build_entity(\stdClass $record): client_entity {
+        global $DB;
+
+        $uris = $DB->get_records(
+            self::TABLE_REDIRECT_URIS,
+            ['clientidentifier' => $record->clientidentifier],
+            'id ASC',
+        );
+
+        return client_entity::create_from_record($record, $uris);
+    }
+
+    /**
+     * Generate a new unique client identifier.
+     *
+     * @return string The client identifier.
+     */
+    private function generate_client_identifier(): string {
+        global $DB;
+
+        do {
+            $identifier = bin2hex(random_bytes(16));
+        } while ($DB->record_exists(self::TABLE_CLIENTS, ['clientidentifier' => $identifier]));
+
+        return $identifier;
+    }
+
+    /**
+     * Generate a new cryptographically secure client secret.
+     *
+     * @return string The plain text secret.
+     */
+    private function generate_secret(): string {
+        return bin2hex(random_bytes(32));
+    }
+}
