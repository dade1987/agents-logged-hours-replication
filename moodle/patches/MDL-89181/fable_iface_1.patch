+    /**
+     * Test fetching, adding and removing redirect URIs.
+     */
+    public function test_redirect_uris(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+
+        $client = $manager->create_client('Client', \context_system::instance(), ['https://example.test/cb']);
+        $clientid = $this->get_client_id($client);
+
+        $this->assertSame(['https://example.test/cb'], $manager->get_redirect_uris($clientid));
+
+        $manager->add_redirect_uri($clientid, 'https://example.test/cb2');
+        $manager->add_redirect_uri($clientid, 'http://localhost/cb');
+        $manager->add_redirect_uri($clientid, 'http://127.0.0.1:9000/cb');
+        $manager->add_redirect_uri($clientid, 'http://[::1]/cb');
+        $this->assertEqualsCanonicalizing(
+            [
+                'https://example.test/cb',
+                'https://example.test/cb2',
+                'http://localhost/cb',
+                'http://127.0.0.1:9000/cb',
+                'http://[::1]/cb',
+            ],
+            $manager->get_redirect_uris($clientid),
+        );
+
+        // The entity reflects the redirect URIs.
+        $this->assertCount(5, $manager->get_client_by_id($clientid)->getRedirectUri());
+
+        $manager->remove_redirect_uri($clientid, 'https://example.test/cb');
+        $this->assertEqualsCanonicalizing(
+            ['https://example.test/cb2', 'http://localhost/cb', 'http://127.0.0.1:9000/cb', 'http://[::1]/cb'],
+            $manager->get_redirect_uris($clientid),
+        );
+
+        // Duplicates are rejected.
+        $this->expectException(invalid_parameter_exception::class);
+        $manager->add_redirect_uri($clientid, 'https://example.test/cb2');
+    }
