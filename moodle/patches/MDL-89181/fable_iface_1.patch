+    /**
+     * Test secret generation, fetching and the active secret limit.
+     */
+    public function test_create_and_get_secrets(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+
+        $client = $manager->create_client('Client', \context_system::instance());
+        $clientid = $this->get_client_id($client);
+
+        $secret1 = $manager->create_secret($clientid);
+        $this->assertNotEmpty($secret1);
+
+        $secrets = $manager->get_secrets($clientid);
+        $this->assertCount(1, $secrets);
+        $record = reset($secrets);
+        $this->assertSame($client->getIdentifier(), $record->clientidentifier);
+        $this->assertEquals(client_entity::SECRET_REVOKED_NO, $record->revoked);
+        $this->assertGreaterThan(time(), (int) $record->expirytime);
+        // The plain text secret is never stored, only verifiable via the hash.
+        $this->assertNotSame($secret1, $record->secret);
+        $this->assertTrue(password_verify($secret1, $record->secret));
+
+        // The secret can be used to authenticate the client.
+        $repository = new client_repository();
+        $this->assertTrue($repository->validateClient($client->getIdentifier(), $secret1, 'authorization_code'));
+
+        // A second secret with a custom expiry.
+        $expiry = time() + DAYSECS;
+        $secret2 = $manager->create_secret($clientid, $expiry);
+        $this->assertNotSame($secret1, $secret2);
+        $this->assertCount(2, $manager->get_secrets($clientid));
+        $record2 = $DB->get_record('oauth2_server_client_secrets', ['expirytime' => $expiry]);
+        $this->assertTrue(password_verify($secret2, $record2->secret));
+
+        // The limit is per client: another client can still generate secrets.
+        $other = $manager->create_client('Other', \context_system::instance());
+        $otherid = $this->get_client_id($other);
+        $manager->create_secret($otherid);
+        $this->assertCount(1, $manager->get_secrets($otherid));
+        $this->assertCount(2, $manager->get_secrets($clientid));
+
+        // Exceeding the limit is rejected.
+        try {
+            $manager->create_secret($clientid);
+            $this->fail('An exception was expected.');
+        } catch (invalid_state_exception $e) {
+            $this->assertCount(2, $manager->get_secrets($clientid, true));
+        }
+
+        // Revoking one secret frees a slot.
+        $manager->revoke_secret((int) $record->id);
+        $this->assertCount(1, $manager->get_secrets($clientid));
+        $this->assertCount(2, $manager->get_secrets($clientid, true));
+        $this->assertFalse($repository->validateClient($client->getIdentifier(), $secret1, 'authorization_code'));
+
+        $secret3 = $manager->create_secret($clientid);
+        $this->assertNotEmpty($secret3);
+        $this->assertCount(2, $manager->get_secrets($clientid));
+        $this->assertCount(3, $manager->get_secrets($clientid, true));
+
+        // Expired secrets are not counted as active.
+        $DB->set_field('oauth2_server_client_secrets', 'expirytime', time() - 10, ['id' => $record2->id]);
+        $this->assertCount(1, $manager->get_secrets($clientid));
+        $this->assertCount(3, $manager->get_secrets($clientid, true));
+        $manager->create_secret($clientid);
+        $this->assertCount(2, $manager->get_secrets($clientid));
+        $this->assertCount(4, $manager->get_secrets($clientid, true));
+    }
