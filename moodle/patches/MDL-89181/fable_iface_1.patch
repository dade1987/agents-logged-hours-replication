+    /**
+     * Validation returns false for an unknown client, and for registered URIs that no longer pass format checks.
+     */
+    public function test_validate_redirect_uri_unknown_client_and_invalid_stored(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+
+        $this->assertFalse($manager->validate_redirect_uri('does-not-exist', 'https://example.test/cb'));
+
+        // A non-HTTPS URI which somehow ended up in the database is still rejected.
+        $client = $manager->create_client('Client', \context_system::instance());
+        $DB->insert_record('oauth2_server_client_redirect_uris', (object) [
+            'clientidentifier' => $client->getIdentifier(),
+            'uri' => 'http://example.test/cb',
+        ]);
+        $this->assertFalse($manager->validate_redirect_uri($client->getIdentifier(), 'http://example.test/cb'));
+    }
