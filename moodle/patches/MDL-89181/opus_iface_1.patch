+namespace core\oauth2\server;
+
+use core\clock;
+use core\exception\coding_exception;
+use core\oauth2\server\entity\access_token_entity;
+use core\oauth2\server\entity\auth_code_entity;
+use core\oauth2\server\entity\client_entity;
+use core\oauth2\server\entity\refresh_token_entity;
+
+/**
+ * OAuth2 server client manager.
+ *
+ * Centralised management of OAuth2 server clients, their secrets and redirect URIs.
+ *
+ * This class is expected to be loaded via dependency injection:
+ *
+ *     $manager = \core\di::get(\core\oauth2\server\client_manager::class);
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class client_manager {
+    /** @var int Maximum number of active (non-revoked, non-expired) secrets per client */
+    public const int MAX_ACTIVE_SECRETS = 2;
+
+    /** @var int Default lifetime of a client secret, in seconds, when no expiry time is given */
+    public const int DEFAULT_SECRET_LIFETIME = YEARSECS;
+
+    /** @var string Clients table */
+    private const string TABLE_CLIENTS = 'oauth2_server_clients';
+
+    /** @var string Client secrets table */
+    private const string TABLE_SECRETS = 'oauth2_server_client_secrets';
+
+    /** @var string Redirect URIs table */
+    private const string TABLE_REDIRECT_URIS = 'oauth2_server_client_redirect_uris';
+
+    /** @var string Access tokens table */
+    private const string TABLE_ACCESS_TOKENS = 'oauth2_server_client_access_tokens';
+
+    /** @var string Refresh tokens table */
+    private const string TABLE_REFRESH_TOKENS = 'oauth2_server_client_refresh_tokens';
+
+    /** @var string Auth codes table */
+    private const string TABLE_AUTH_CODES = 'oauth2_server_client_auth_codes';
+
+    /** @var string Granted scopes table */
+    private const string TABLE_GRANTED_SCOPES = 'oauth2_server_client_granted_scopes';
+
+    /** @var string[] Fields that may be modified through update_client() */
+    private const array UPDATABLE_FIELDS = ['name', 'description'];
+
+    /**
+     * Constructor.
+     *
+     * @param \moodle_database $db The database handler.
+     * @param clock $clock The clock.
+     */
+    public function __construct(
+        /** @var \moodle_database The database handler */
+        protected readonly \moodle_database $db,
+        /** @var clock The clock */
+        protected readonly clock $clock,
+    ) {
+    }
+
+    /**
+     * Create a new OAuth2 client.
+     *
+     * @param string $name The human-readable client name.
+     * @param \core\context $ownercontext The context of the client owner.
+     * @param string[] $redirecturis Redirect URIs for the client.
+     * @param string|null $description Optional description.
+     * @param bool $isconfidential Whether the client is confidential.
+     * @return client_entity The created client.
+     */
+    public function create_client(
+        string $name,
+        \core\context $ownercontext,
+        array $redirecturis = [],
+        ?string $description = null,
+        bool $isconfidential = true,
+    ): client_entity {
+        $name = trim($name);
+        if ($name === '') {
+            throw new coding_exception('The OAuth2 client name must not be empty');
+        }
+
+        $redirecturis = array_values(array_unique(array_map('strval', $redirecturis)));
+        foreach ($redirecturis as $uri) {
+            $this->validate_redirect_uri_format($uri);
+        }
+
+        $transaction = $this->db->start_delegated_transaction();
+
+        $clientidentifier = $this->generate_client_identifier();
+        $now = $this->clock->time();
+
+        $this->db->insert_record(self::TABLE_CLIENTS, (object) [
+            'name' => $name,
+            'description' => $description,
+            'clientidentifier' => $clientidentifier,
+            'ownercontext' => $ownercontext->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'isconfidential' => $isconfidential ? 1 : 0,
+            'timecreated' => $now,
+            'timemodified' => $now,
+        ]);
+
+        foreach ($redirecturis as $uri) {
+            $this->db->insert_record(self::TABLE_REDIRECT_URIS, (object) [
+                'clientidentifier' => $clientidentifier,
+                'uri' => $uri,
+            ]);
+        }
+
+        $transaction->allow_commit();
+
+        return $this->get_client($clientidentifier);
+    }
+
+    /**
+     * Fetch a client by its public client identifier.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return client_entity|null The client, or null if it does not exist.
+     */
+    public function get_client(string $clientidentifier): ?client_entity {
+        $record = $this->db->get_record(self::TABLE_CLIENTS, ['clientidentifier' => $clientidentifier]);
+        if (!$record) {
+            return null;
+        }
+        return $this->create_entity($record);
+    }
+
+    /**
+     * Fetch a client by its database ID.
+     *
+     * @param int $clientid The client ID.
+     * @return client_entity|null The client, or null if it does not exist.
+     */
+    public function get_client_by_id(int $clientid): ?client_entity {
+        $record = $this->db->get_record(self::TABLE_CLIENTS, ['id' => $clientid]);
+        if (!$record) {
+            return null;
+        }
+        return $this->create_entity($record);
+    }
+
+    /**
+     * Update the administrative metadata of a client.
+     *
+     * Only the name and description may be updated.
+     *
+     * @param int $clientid The client ID.
+     * @param array $updates Associative array of field => value (name, description).
+     */
+    public function update_client(int $clientid, array $updates): void {
+        $record = $this->get_client_record($clientid);
+
+        $disallowed = array_diff(array_keys($updates), self::UPDATABLE_FIELDS);
+        if (!empty($disallowed)) {
+            throw new coding_exception(
+                'Only the following OAuth2 client fields can be updated: ' . implode(', ', self::UPDATABLE_FIELDS) .
+                '. Invalid fields: ' . implode(', ', $disallowed)
+            );
+        }
+
+        if (empty($updates)) {
+            return;
+        }
+
+        $update = (object) ['id' => $record->id];
+
+        if (array_key_exists('name', $updates)) {
+            $name = trim((string) $updates['name']);
+            if ($name === '') {
+                throw new coding_exception('The OAuth2 client name must not be empty');
+            }
+            $update->name = $name;
+        }
+
+        if (array_key_exists('description', $updates)) {
+            $update->description = $updates['description'] === null ? null : (string) $updates['description'];
+        }
+
+        $update->timemodified = $this->clock->time();
+        $this->db->update_record(self::TABLE_CLIENTS, $update);
+    }
+
+    /**
+     * Revoke a client.
+     *
+     * This also immediately revokes all of the client's active secrets, access tokens, refresh tokens
+     * and authorisation codes.
+     *
+     * @param int $clientid The client ID.
+     */
+    public function revoke_client(int $clientid): void {
+        $record = $this->get_client_record($clientid);
+        $clientidentifier = $record->clientidentifier;
+
+        $transaction = $this->db->start_delegated_transaction();
+
+        $this->db->update_record(self::TABLE_CLIENTS, (object) [
+            'id' => $record->id,
+            'status' => client_entity::STATUS_REVOKED,
+            'timemodified' => $this->clock->time(),
+        ]);
+
+        // Revoke all secrets.
+        $this->db->set_field(
+            self::TABLE_SECRETS,
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['clientidentifier' => $clientidentifier, 'revoked' => client_entity::SECRET_REVOKED_NO],
+        );
+
+        // Revoke refresh tokens linked to the client's access tokens.
+        $this->db->set_field_select(
+            self::TABLE_REFRESH_TOKENS,
+            'revoked',
+            refresh_token_entity::REVOKED_YES,
+            'revoked = :revoked AND accesstokenidentifier IN (
+                SELECT identifier FROM {' . self::TABLE_ACCESS_TOKENS . '} WHERE clientidentifier = :clientidentifier
+            )',
+            ['revoked' => refresh_token_entity::REVOKED_NO, 'clientidentifier' => $clientidentifier],
+        );
+
+        // Revoke access tokens.
+        $this->db->set_field(
+            self::TABLE_ACCESS_TOKENS,
+            'revoked',
+            access_token_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier, 'revoked' => access_token_entity::REVOKED_NO],
+        );
+
+        // Revoke authorisation codes.
+        $this->db->set_field(
+            self::TABLE_AUTH_CODES,
+            'revoked',
+            auth_code_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier, 'revoked' => auth_code_entity::REVOKED_NO],
+        );
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Reactivate a revoked client.
+     *
+     * Only the client record itself is restored. Previously revoked secrets and tokens remain revoked.
+     *
+     * @param int $clientid The client ID.
+     */
+    public function reactivate_client(int $clientid): void {
+        $record = $this->get_client_record($clientid);
+
+        if ((int) $record->status === client_entity::STATUS_ACTIVE) {
+            return;
+        }
+
+        $this->db->update_record(self::TABLE_CLIENTS, (object) [
+            'id' => $record->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'timemodified' => $this->clock->time(),
+        ]);
+    }
+
+    /**
+     * Permanently delete a client and all of its associated data.
+     *
+     * The client must already be revoked.
+     *
+     * @param int $clientid The client ID.
+     */
+    public function delete_client(int $clientid): void {
+        $record = $this->get_client_record($clientid);
+
+        if ((int) $record->status !== client_entity::STATUS_REVOKED) {
+            throw new coding_exception('An OAuth2 client must be revoked before it can be deleted');
+        }
+
+        $clientidentifier = $record->clientidentifier;
+        $params = ['clientidentifier' => $clientidentifier];
+
+        $transaction = $this->db->start_delegated_transaction();
+
+        $this->db->delete_records_select(
+            self::TABLE_REFRESH_TOKENS,
+            'accesstokenidentifier IN (
+                SELECT identifier FROM {' . self::TABLE_ACCESS_TOKENS . '} WHERE clientidentifier = :clientidentifier
+            )',
+            $params,
+        );
+        $this->db->delete_records(self::TABLE_ACCESS_TOKENS, $params);
+        $this->db->delete_records(self::TABLE_AUTH_CODES, $params);
+        $this->db->delete_records(self::TABLE_GRANTED_SCOPES, $params);
+        $this->db->delete_records(self::TABLE_SECRETS, $params);
+        $this->db->delete_records(self::TABLE_REDIRECT_URIS, $params);
+        $this->db->delete_records(self::TABLE_CLIENTS, ['id' => $record->id]);
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Generate a new secret for a client.
+     *
+     * A client may have at most {@see self::MAX_ACTIVE_SECRETS} active secrets at any time.
+     *
+     * @param int $clientid The client ID.
+     * @param int|null $expirytime The expiry timestamp, or null to use the default lifetime.
+     * @return string The plain text secret. This is the only time it is available; only a hash is stored.
+     */
+    public function create_secret(int $clientid, ?int $expirytime = null): string {
+        $record = $this->get_client_record($clientid);
+
+        if ((int) $record->status !== client_entity::STATUS_ACTIVE) {
+            throw new coding_exception('Secrets cannot be generated for a revoked OAuth2 client');
+        }
+
+        if (empty($record->isconfidential)) {
+            throw new coding_exception('Secrets cannot be generated for a public OAuth2 client');
+        }
+
+        $now = $this->clock->time();
+
+        if ($expirytime === null) {
+            $expirytime = $now + self::DEFAULT_SECRET_LIFETIME;
+        } else if ($expirytime <= $now) {
+            throw new coding_exception('The OAuth2 client secret expiry time must be in the future');
+        }
+
+        $activecount = $this->db->count_records_select(
+            self::TABLE_SECRETS,
+            'clientidentifier = :clientidentifier AND revoked = :revoked AND expirytime > :now',
+            [
+                'clientidentifier' => $record->clientidentifier,
+                'revoked' => client_entity::SECRET_REVOKED_NO,
+                'now' => $now,
+            ],
+        );
+
+        if ($activecount >= self::MAX_ACTIVE_SECRETS) {
+            throw new coding_exception(
+                'The maximum number of active secrets (' . self::MAX_ACTIVE_SECRETS . ') for this OAuth2 client has been reached'
+            );
+        }
+
+        $secret = bin2hex(random_bytes(32));
+
+        $this->db->insert_record(self::TABLE_SECRETS, (object) [
+            'clientidentifier' => $record->clientidentifier,
+            'secret' => password_hash($secret, PASSWORD_DEFAULT),
+            'expirytime' => $expirytime,
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'timecreated' => $now,
+        ]);
+
+        return $secret;
+    }
+
+    /**
+     * Fetch the secrets of a client.
+     *
+     * @param int $clientid The client ID.
+     * @param bool $includeinactive Whether to include revoked and expired secrets.
+     * @return \stdClass[] Secret records (containing only the hashed secret), indexed by ID.
+     */
+    public function get_secrets(int $clientid, bool $includeinactive = false): array {
+        $record = $this->get_client_record($clientid);
+
+        if ($includeinactive) {
+            return $this->db->get_records(
+                self::TABLE_SECRETS,
+                ['clientidentifier' => $record->clientidentifier],
+                'timecreated ASC, id ASC',
+            );
+        }
+
+        return $this->db->get_records_select(
+            self::TABLE_SECRETS,
+            'clientidentifier = :clientidentifier AND revoked = :revoked AND expirytime > :now',
+            [
+                'clientidentifier' => $record->clientidentifier,
+                'revoked' => client_entity::SECRET_REVOKED_NO,
+                'now' => $this->clock->time(),
+            ],
+            'timecreated ASC, id ASC',
+        );
+    }
+
+    /**
+     * Revoke a client secret.
+     *
+     * @param int $secretid The secret ID.
+     */
+    public function revoke_secret(int $secretid): void {
+        if (!$this->db->record_exists(self::TABLE_SECRETS, ['id' => $secretid])) {
+            throw new coding_exception("OAuth2 client secret with ID {$secretid} does not exist");
+        }
+
+        $this->db->set_field(self::TABLE_SECRETS, 'revoked', client_entity::SECRET_REVOKED_YES, ['id' => $secretid]);
+    }
+
+    /**
+     * Fetch the redirect URIs of a client.
+     *
+     * @param int $clientid The client ID.
+     * @return string[] The redirect URIs.
+     */
+    public function get_redirect_uris(int $clientid): array {
+        $record = $this->get_client_record($clientid);
+        return $this->get_redirect_uris_for_identifier($record->clientidentifier);
+    }
+
+    /**
+     * Add a redirect URI to a client.
+     *
+     * Adding a URI that is already registered for the client has no effect.
+     *
+     * @param int $clientid The client ID.
+     * @param string $uri The redirect URI.
+     */
+    public function add_redirect_uri(int $clientid, string $uri): void {
+        $record = $this->get_client_record($clientid);
+        $this->validate_redirect_uri_format($uri);
+
+        if (in_array($uri, $this->get_redirect_uris_for_identifier($record->clientidentifier), true)) {
+            return;
+        }
+
+        $this->db->insert_record(self::TABLE_REDIRECT_URIS, (object) [
+            'clientidentifier' => $record->clientidentifier,
+            'uri' => $uri,
+        ]);
+    }
+
+    /**
+     * Remove a redirect URI from a client.
+     *
+     * @param int $clientid The client ID.
+     * @param string $uri The redirect URI (exact match).
+     */
+    public function remove_redirect_uri(int $clientid, string $uri): void {
+        $record = $this->get_client_record($clientid);
+
+        $records = $this->db->get_records(self::TABLE_REDIRECT_URIS, ['clientidentifier' => $record->clientidentifier]);
+        foreach ($records as $urirecord) {
+            // Compare in PHP to guarantee an exact (case-sensitive) match regardless of DB collation.
+            if ($urirecord->uri === $uri) {
+                $this->db->delete_records(self::TABLE_REDIRECT_URIS, ['id' => $urirecord->id]);
+            }
+        }
+    }
+
+    /**
+     * Validate a redirect URI for a client.
+     *
+     * The URI must exactly match one of the client's registered redirect URIs, and must use HTTPS
+     * unless it targets a localhost/loopback address. Revoked or unknown clients never validate.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The redirect URI to validate.
+     * @return bool
+     */
+    public function validate_redirect_uri(string $clientidentifier, string $uri): bool {
+        $record = $this->db->get_record(self::TABLE_CLIENTS, ['clientidentifier' => $clientidentifier]);
+        if (!$record || (int) $record->status !== client_entity::STATUS_ACTIVE) {
+            return false;
+        }
+
+        if (!$this->is_valid_redirect_uri_format($uri)) {
+            return false;
+        }
+
+        return in_array($uri, $this->get_redirect_uris_for_identifier($clientidentifier), true);
+    }
+
+    /**
+     * Fetch the client record by ID, throwing if it does not exist.
+     *
+     * @param int $clientid The client ID.
+     * @return \stdClass
+     */
+    protected function get_client_record(int $clientid): \stdClass {
+        $record = $this->db->get_record(self::TABLE_CLIENTS, ['id' => $clientid]);
+        if (!$record) {
+            throw new coding_exception("OAuth2 client with ID {$clientid} does not exist");
+        }
+        return $record;
+    }
+
+    /**
+     * Build a client entity from a client record.
+     *
+     * @param \stdClass $record The client record.
+     * @return client_entity
+     */
+    protected function create_entity(\stdClass $record): client_entity {
+        $urirecords = $this->db->get_records(
+            self::TABLE_REDIRECT_URIS,
+            ['clientidentifier' => $record->clientidentifier],
+            'id ASC',
+        );
+        return client_entity::create_from_record($record, $urirecords);
+    }
+
+    /**
+     * Fetch the redirect URIs for a client identifier.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return string[]
+     */
+    protected function get_redirect_uris_for_identifier(string $clientidentifier): array {
+        $records = $this->db->get_records(
+            self::TABLE_REDIRECT_URIS,
+            ['clientidentifier' => $clientidentifier],
+            'id ASC',
+        );
+        return array_values(array_map(fn($r) => $r->uri, $records));
+    }
+
+    /**
+     * Generate a unique client identifier.
+     *
+     * @return string
+     */
+    protected function generate_client_identifier(): string {
+        do {
+            $identifier = bin2hex(random_bytes(16));
+        } while ($this->db->record_exists(self::TABLE_CLIENTS, ['clientidentifier' => $identifier]));
+        return $identifier;
+    }
+
+    /**
+     * Validate the format of a redirect URI, throwing if invalid.
+     *
+     * @param string $uri The redirect URI.
+     */
+    protected function validate_redirect_uri_format(string $uri): void {
+        if (!$this->is_valid_redirect_uri_format($uri)) {
+            throw new coding_exception(
+                "Invalid OAuth2 redirect URI '{$uri}'. Redirect URIs must be absolute, must not contain a fragment, " .
+                "and must use HTTPS unless they target a localhost/loopback address."
+            );
+        }
+    }
+
+    /**
+     * Check whether a redirect URI is well-formed and uses an allowed scheme.
+     *
+     * @param string $uri The redirect URI.
+     * @return bool
+     */
+    protected function is_valid_redirect_uri_format(string $uri): bool {
+        if ($uri === '' || trim($uri) !== $uri || preg_match('/\s/', $uri)) {
+            return false;
+        }
+
+        $parts = parse_url($uri);
+        if ($parts === false || empty($parts['scheme']) || !isset($parts['host']) || $parts['host'] === '') {
+            return false;
+        }
+
+        // Fragments are not permitted in redirect URIs (RFC 6749, section 3.1.2).
+        if (array_key_exists('fragment', $parts) || str_contains($uri, '#')) {
+            return false;
+        }
+
+        // Credentials are not permitted.
+        if (isset($parts['user']) || isset($parts['pass'])) {
+            return false;
+        }
+
+        $scheme = strtolower($parts['scheme']);
+        if ($scheme === 'https') {
+            return true;
+        }
+
+        if ($scheme === 'http') {
+            return $this->is_loopback_host($parts['host']);
+        }
+
+        return false;
+    }
+
+    /**
+     * Whether the given host is localhost or a loopback address.
+     *
+     * @param string $host The host component of a URI.
+     * @return bool
+     */
+    protected function is_loopback_host(string $host): bool {
+        $host = strtolower(trim($host, '[]'));
+
+        if ($host === 'localhost') {
+            return true;
+        }
+
+        if ($host === '::1') {
+            return true;
+        }
+
+        // IPv4 loopback range 127.0.0.0/8.
+        if (filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) !== false) {
+            return str_starts_with($host, '127.');
+        }
+
+        return false;
+    }
+}
