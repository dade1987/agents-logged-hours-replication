+#[CoversClass(client_manager::class)]
+final class client_manager_test extends \advanced_testcase {
+    /**
+     * Get the manager via DI.
+     *
+     * @return client_manager
+     */
+    private function get_manager(): client_manager {
+        return \core\di::get(client_manager::class);
+    }
+
+    /**
+     * Create a client and return its ID.
+     *
+     * @param client_manager $manager
+     * @param array $uris
+     * @return array [id, client_entity]
+     */
+    private function create_test_client(client_manager $manager, array $uris = ['https://example.test/cb']): array {
+        global $DB;
+        $client = $manager->create_client('Test client', \context_system::instance(), $uris, 'Desc');
+        $id = (int) $DB->get_field('oauth2_server_clients', 'id', ['clientidentifier' => $client->getIdentifier()]);
+        return [$id, $client];
+    }
+
+    public function test_di_and_instance_methods(): void {
+        $manager = $this->get_manager();
+        $this->assertInstanceOf(client_manager::class, $manager);
+
+        $reflection = new \ReflectionClass(client_manager::class);
+        foreach ($reflection->getMethods(\ReflectionMethod::IS_PUBLIC) as $method) {
+            $this->assertFalse($method->isStatic(), $method->getName() . ' should not be static');
+        }
+    }
+
+    public function test_create_and_get_client(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+
+        [$id, $client] = $this->create_test_client($manager, ['https://example.test/cb', 'http://localhost:8080/cb']);
+
+        $this->assertSame('Test client', $client->getName());
+        $this->assertSame('Desc', $client->get_description());
+        $this->assertSame(client_entity::STATUS_ACTIVE, $client->get_status());
+        $this->assertTrue($client->isConfidential());
+
+        $byid = $manager->get_client_by_id($id);
+        $this->assertSame($client->getIdentifier(), $byid->getIdentifier());
+        $this->assertEqualsCanonicalizing(
+            ['https://example.test/cb', 'http://localhost:8080/cb'],
+            $byid->getRedirectUri()
+        );
+
+        $this->assertNull($manager->get_client('nonexistent'));
+        $this->assertNull($manager->get_client_by_id($id + 1000));
+    }
+
+    public function test_create_client_invalid_uri(): void {
+        $this->resetAfterTest();
+        $this->expectException(coding_exception::class);
+        $this->get_manager()->create_client('Name', \context_system::instance(), ['http://example.test/cb']);
+    }
+
+    public function test_update_client(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        [$id] = $this->create_test_client($manager);
+
+        $manager->update_client($id, ['name' => 'New name', 'description' => null]);
+        $client = $manager->get_client_by_id($id);
+        $this->assertSame('New name', $client->getName());
+        $this->assertNull($client->get_description());
+
+        $this->expectException(coding_exception::class);
+        $manager->update_client($id, ['status' => client_entity::STATUS_REVOKED]);
+    }
+
+    public function test_revoke_client_cascades(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        [$id, $client] = $this->create_test_client($manager);
+        $identifier = $client->getIdentifier();
+        $user = $this->getDataGenerator()->create_user();
+
+        $secret = $manager->create_secret($id);
+        $DB->insert_record('oauth2_server_client_access_tokens', (object) [
+            'identifier' => 'at1', 'userid' => $user->id, 'clientidentifier' => $identifier, 'scopes' => 'a',
+            'expirytime' => time() + 3600, 'revoked' => 0, 'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_refresh_tokens', (object) [
+            'identifier' => 'rt1', 'accesstokenidentifier' => 'at1', 'expirytime' => time() + 3600,
+            'revoked' => 0, 'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_auth_codes', (object) [
+            'identifier' => 'ac1', 'userid' => $user->id, 'clientidentifier' => $identifier,
+            'redirecturi' => 'https://example.test/cb', 'scopes' => 'a', 'expirytime' => time() + 600,
+            'revoked' => 0, 'timecreated' => time(),
+        ]);
+
+        $manager->revoke_client($id);
+
+        $this->assertSame(client_entity::STATUS_REVOKED, $manager->get_client_by_id($id)->get_status());
+        $this->assertEmpty($manager->get_secrets($id));
+        $this->assertFalse((new client_repository())->validateClient($identifier, $secret, null));
+        $this->assertEquals(access_token_entity::REVOKED_YES,
+            $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['identifier' => 'at1']));
+        $this->assertEquals(refresh_token_entity::REVOKED_YES,
+            $DB->get_field('oauth2_server_client_refresh_tokens', 'revoked', ['identifier' => 'rt1']));
+        $this->assertEquals(auth_code_entity::REVOKED_YES,
+            $DB->get_field('oauth2_server_client_auth_codes', 'revoked', ['identifier' => 'ac1']));
+        $this->assertFalse($manager->validate_redirect_uri($identifier, 'https://example.test/cb'));
+
+        // Reactivation does not restore secrets or tokens.
+        $manager->reactivate_client($id);
+        $this->assertSame(client_entity::STATUS_ACTIVE, $manager->get_client_by_id($id)->get_status());
+        $this->assertEmpty($manager->get_secrets($id));
+        $this->assertCount(1, $manager->get_secrets($id, true));
+        $this->assertEquals(access_token_entity::REVOKED_YES,
+            $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['identifier' => 'at1']));
+        $this->assertFalse((new client_repository())->validateClient($identifier, $secret, null));
+
+        // A new secret can be generated.
+        $newsecret = $manager->create_secret($id);
+        $this->assertTrue((new client_repository())->validateClient($identifier, $newsecret, null));
+    }
+
+    public function test_delete_client(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        [$id, $client] = $this->create_test_client($manager);
+        $manager->create_secret($id);
+
+        try {
+            $manager->delete_client($id);
+            $this->fail('Expected exception');
+        } catch (coding_exception $e) {
+            $this->assertNotNull($manager->get_client_by_id($id));
+        }
+
+        $manager->revoke_client($id);
+        $manager->delete_client($id);
+        $this->assertNull($manager->get_client_by_id($id));
+        $this->assertFalse($DB->record_exists('oauth2_server_client_secrets', ['clientidentifier' => $client->getIdentifier()]));
+        $this->assertFalse($DB->record_exists('oauth2_server_client_redirect_uris',
+            ['clientidentifier' => $client->getIdentifier()]));
+    }
+
+    public function test_secret_limit(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        [$id, $client] = $this->create_test_client($manager);
+        [$otherid] = $this->create_test_client($manager);
+
+        $s1 = $manager->create_secret($id);
+        $manager->create_secret($id, time() + 100);
+        $this->assertCount(2, $manager->get_secrets($id));
+
+        // Limit is per client.
+        $manager->create_secret($otherid);
+        $manager->create_secret($otherid);
+
+        try {
+            $manager->create_secret($id);
+            $this->fail('Expected exception');
+        } catch (coding_exception $e) {
+            $this->assertCount(2, $manager->get_secrets($id));
+        }
+
+        // Revoking one frees a slot.
+        $secrets = $manager->get_secrets($id);
+        $manager->revoke_secret(array_key_first($secrets));
+        $this->assertCount(1, $manager->get_secrets($id));
+        $this->assertCount(2, $manager->get_secrets($id, true));
+        $manager->create_secret($id);
+        $this->assertCount(2, $manager->get_secrets($id));
+        $this->assertFalse((new client_repository())->validateClient($client->getIdentifier(), $s1, null));
+    }
+
+    public function test_redirect_uris(): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        [$id, $client] = $this->create_test_client($manager, []);
+        $this->assertSame([], $manager->get_redirect_uris($id));
+
+        $manager->add_redirect_uri($id, 'https://example.test/cb');
+        $manager->add_redirect_uri($id, 'http://127.0.0.1:1234/cb');
+        $this->assertEqualsCanonicalizing(['https://example.test/cb', 'http://127.0.0.1:1234/cb'],
+            $manager->get_redirect_uris($id));
+
+        $this->assertTrue($manager->validate_redirect_uri($client->getIdentifier(), 'https://example.test/cb'));
+        $this->assertFalse($manager->validate_redirect_uri($client->getIdentifier(), 'https://example.test/cb/extra'));
+        $this->assertFalse($manager->validate_redirect_uri($client->getIdentifier(), 'https://example.test/c'));
+        $this->assertFalse($manager->validate_redirect_uri('unknown', 'https://example.test/cb'));
+
+        $manager->remove_redirect_uri($id, 'https://example.test/cb');
+        $this->assertSame(['http://127.0.0.1:1234/cb'], $manager->get_redirect_uris($id));
+        $this->assertFalse($manager->validate_redirect_uri($client->getIdentifier(), 'https://example.test/cb'));
+    }
+
+    /**
+     * Data provider for {@see test_add_redirect_uri_scheme}.
+     *
+     * @return array
+     */
+    public static function redirect_uri_scheme_provider(): array {
+        return [
+            'https' => ['https://example.test/cb', true],
+            'http localhost' => ['http://localhost/cb', true],
+            'http loopback v4' => ['http://127.0.0.1:8000/cb', true],
+            'http loopback v6' => ['http://[::1]:8000/cb', true],
+            'http remote' => ['http://example.test/cb', false],
+            'ftp' => ['ftp://example.test/cb', false],
+            'javascript' => ['javascript:alert(1)', false],
+            'relative' => ['/cb', false],
+            'fragment' => ['https://example.test/cb#frag', false],
+        ];
+    }
+
+    /**
+     * Test redirect URI scheme rules.
+     *
+     * @param string $uri
+     * @param bool $valid
+     */
+    #[DataProvider('redirect_uri_scheme_provider')]
+    public function test_add_redirect_uri_scheme(string $uri, bool $valid): void {
+        $this->resetAfterTest();
+        $manager = $this->get_manager();
+        [$id, $client] = $this->create_test_client($manager, []);
+
+        if (!$valid) {
+            $this->expectException(coding_exception::class);
+        }
+        $manager->add_redirect_uri($id, $uri);
+        $this->assertTrue($manager->validate_redirect_uri($client->getIdentifier(), $uri));
+    }
+}
