+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\oauth2\server;
+
+use core\oauth2\server\entity\client_entity;
+use core\oauth2\server\repository\client_repository;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
+
+/**
+ * Tests for {@see client_manager}.
+ *
+ * @package    core
+ * @copyright  2026 Moodle contributors
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[CoversClass(client_manager::class)]
+final class client_manager_test extends \advanced_testcase {
+    /**
+     * Create a client record directly in the database.
+     *
+     * @param string $identifier The client identifier.
+     * @param int $status The client status.
+     * @return \stdClass The inserted client record.
+     */
+    private function create_client_record(string $identifier, int $status = client_entity::STATUS_ACTIVE): \stdClass {
+        global $DB;
+
+        $record = (object) [
+            'name' => 'Test client',
+            'description' => 'Test description',
+            'clientidentifier' => $identifier,
+            'ownercontext' => \context_system::instance()->id,
+            'status' => $status,
+            'isconfidential' => 1,
+            'timecreated' => time(),
+        ];
+        $record->id = $DB->insert_record('oauth2_server_clients', $record);
+        return $record;
+    }
+
+    /**
+     * Create an access token, refresh token and auth code for a client, all active.
+     *
+     * @param string $identifier The client identifier.
+     * @return void
+     */
+    private function create_tokens_for_client(string $identifier): void {
+        global $DB;
+
+        $DB->insert_record('oauth2_server_client_access_tokens', (object) [
+            'identifier' => 'access-' . $identifier,
+            'clientidentifier' => $identifier,
+            'scopes' => 'openid',
+            'expirytime' => time() + HOURSECS,
+            'revoked' => 0,
+            'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_refresh_tokens', (object) [
+            'identifier' => 'refresh-' . $identifier,
+            'accesstokenidentifier' => 'access-' . $identifier,
+            'expirytime' => time() + WEEKSECS,
+            'revoked' => 0,
+            'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_auth_codes', (object) [
+            'identifier' => 'code-' . $identifier,
+            'userid' => 2,
+            'clientidentifier' => $identifier,
+            'redirecturi' => 'https://example.com/callback',
+            'scopes' => 'openid',
+            'expirytime' => time() + MINSECS,
+            'revoked' => 0,
+            'timecreated' => time(),
+        ]);
+    }
+
+    /**
+     * Test that the manager is available from the DI container and exposes only instance methods.
+     */
+    public function test_di_and_instance_methods(): void {
+        $this->resetAfterTest();
+
+        $manager = \core\di::get(client_manager::class);
+        $this->assertInstanceOf(client_manager::class, $manager);
+
+        $reflection = new \ReflectionClass(client_manager::class);
+        foreach ($reflection->getMethods(\ReflectionMethod::IS_PUBLIC) as $method) {
+            if ($method->getDeclaringClass()->getName() === client_manager::class) {
+                $this->assertFalse($method->isStatic(), $method->getName() . ' must not be static');
+            }
+        }
+    }
+
+    /**
+     * Test fetching clients by ID and by identifier.
+     */
+    public function test_get_client(): void {
+        $this->resetAfterTest();
+
+        $manager = new client_manager();
+        $client = $this->create_client_record('client-a');
+
+        $byid = $manager->get_client_by_id($client->id);
+        $this->assertEquals('client-a', $byid->clientidentifier);
+
+        $byidentifier = $manager->get_client_by_identifier('client-a');
+        $this->assertEquals($client->id, $byidentifier->id);
+
+        $this->assertNull($manager->get_client_by_id(999999));
+        $this->assertNull($manager->get_client_by_identifier('does-not-exist'));
+    }
+
+    /**
+     * Test updating the name and description of a client.
+     */
+    public function test_update_client(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $manager = new client_manager();
