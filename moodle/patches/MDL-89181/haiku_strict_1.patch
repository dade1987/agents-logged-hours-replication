+    /**
+     * Test that revoking a client cascades to its tokens, codes and secrets, and leaves other clients alone.
+     */
+    public function test_revoke_client_cascades(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $manager = new client_manager();
+        $client = $this->create_client_record('client-a');
+        $other = $this->create_client_record('client-b');
+        $this->create_tokens_for_client('client-a');
+        $this->create_tokens_for_client('client-b');
+        $manager->generate_client_secret('client-a');
+        $manager->generate_client_secret('client-b');
+
+        $manager->revoke_client($client->id);
+
+        $this->assertEquals(client_entity::STATUS_REVOKED, (int) $DB->get_field('oauth2_server_clients', 'status', ['id' => $client->id]));
+        $this->assertEquals(1, $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['clientidentifier' => 'client-a']));
+        $this->assertEquals(1, $DB->get_field('oauth2_server_client_refresh_tokens', 'revoked', ['identifier' => 'refresh-client-a']));
+        $this->assertEquals(1, $DB->get_field('oauth2_server_client_auth_codes', 'revoked', ['clientidentifier' => 'client-a']));
+        $this->assertEquals(0, $DB->count_records('oauth2_server_client_secrets', [
+            'clientidentifier' => 'client-a',
+            'revoked' => 0,
+        ]));
+
+        // The other client is untouched.
+        $this->assertEquals(client_entity::STATUS_ACTIVE, (int) $DB->get_field('oauth2_server_clients', 'status', ['id' => $other->id]));
+        $this->assertEquals(0, $DB->get_field('oauth2_server_client_access_tokens', 'revoked', ['clientidentifier' => 'client-b']));
+        $this->assertEquals(1, $DB->count_records('oauth2_server_client_secrets', [
+            'clientidentifier' => 'client-b',
+            'revoked' => 0,
+        ]));
+    }
