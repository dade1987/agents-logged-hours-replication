+    /**
+     * Test creating, fetching and removing redirect URIs, including rejection of invalid and duplicate URIs.
+     */
+    public function test_redirect_uri_lifecycle(): void {
+        $this->resetAfterTest();
+
+        $manager = new client_manager();
+        $this->create_client_record('client-a');
+
+        $id1 = $manager->create_redirect_uri('client-a', 'https://example.com/one');
+        $id2 = $manager->create_redirect_uri('client-a', 'https://example.com/two');
+        $this->assertSame(['https://example.com/one', 'https://example.com/two'], array_values($manager->get_redirect_uris('client-a')));
+
+        try {
+            $manager->create_redirect_uri('client-a', 'http://example.com/insecure');
+            $this->fail('A non-HTTPS URI must be rejected.');
+        } catch (\moodle_exception $e) {
+            $this->assertCount(2, $manager->get_redirect_uris('client-a'));
+        }
+
+        try {
+            $manager->create_redirect_uri('client-a', 'https://example.com/one');
+            $this->fail('A duplicate URI must be rejected.');
+        } catch (\moodle_exception $e) {
+            $this->assertCount(2, $manager->get_redirect_uris('client-a'));
+        }
+
+        $manager->remove_redirect_uri($id1);
+        $this->assertSame([$id2 => 'https://example.com/two'], $manager->get_redirect_uris('client-a'));
+    }
