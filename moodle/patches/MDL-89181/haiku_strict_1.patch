+    /**
+     * Test that a client cannot be deleted unless it is revoked, and that deletion removes its data once revoked.
+     */
+    public function test_delete_client_requires_revoked(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $manager = new client_manager();
+        $client = $this->create_client_record('client-a');
+        $this->create_tokens_for_client('client-a');
+        $manager->generate_client_secret('client-a');
+        $manager->create_redirect_uri('client-a', 'https://example.com/callback');
+
+        try {
+            $manager->delete_client($client->id);
+            $this->fail('Deleting an active client must be rejected.');
+        } catch (\moodle_exception $e) {
+            $this->assertNotNull($DB->get_record('oauth2_server_clients', ['id' => $client->id]));
+        }
+
+        $manager->revoke_client($client->id);
+        $manager->delete_client($client->id);
+
+        $this->assertFalse($DB->record_exists('oauth2_server_clients', ['id' => $client->id]));
+        $this->assertFalse($DB->record_exists('oauth2_server_client_secrets', ['clientidentifier' => 'client-a']));
+        $this->assertFalse($DB->record_exists('oauth2_server_client_redirect_uris', ['clientidentifier' => 'client-a']));
+        $this->assertFalse($DB->record_exists('oauth2_server_client_access_tokens', ['clientidentifier' => 'client-a']));
+        $this->assertFalse($DB->record_exists('oauth2_server_client_refresh_tokens', ['identifier' => 'refresh-client-a']));
+        $this->assertFalse($DB->record_exists('oauth2_server_client_auth_codes', ['clientidentifier' => 'client-a']));
+    }
