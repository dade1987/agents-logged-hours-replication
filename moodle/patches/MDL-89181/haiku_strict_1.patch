+    /**
+     * Test that a client can have at most two active secrets, and that revoked secrets free up capacity.
+     */
+    public function test_generate_secret_enforces_limit(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $manager = new client_manager();
+        $this->create_client_record('client-a');
+        $this->create_client_record('client-b');
+
+        $first = $manager->generate_client_secret('client-a');
+        $manager->generate_client_secret('client-a');
+
+        try {
+            $manager->generate_client_secret('client-a');
+            $this->fail('A third active secret must be rejected.');
+        } catch (\moodle_exception $e) {
+            $this->assertEquals(2, $DB->count_records('oauth2_server_client_secrets', ['clientidentifier' => 'client-a']));
+        }
+
+        // The limit is per client, so another client is unaffected.
+        $manager->generate_client_secret('client-b');
+        $manager->generate_client_secret('client-b');
+
+        // Revoking one secret frees a slot.
+        $secrets = $manager->get_client_secrets('client-a');
+        $manager->revoke_client_secret(reset($secrets)->id);
+        $manager->generate_client_secret('client-a');
+        $this->assertEquals(3, $DB->count_records('oauth2_server_client_secrets', ['clientidentifier' => 'client-a']));
+
+        // The generated secret is stored hashed and validates through the repository.
+        $repository = new client_repository();
+        $this->assertTrue($repository->validateClient('client-a', $first, null));
+        $this->assertFalse($repository->validateClient('client-a', 'wrong-secret', null));
+    }
