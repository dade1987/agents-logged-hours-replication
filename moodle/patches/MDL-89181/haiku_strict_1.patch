+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\oauth2\server;
+
+use core\oauth2\server\entity\access_token_entity;
+use core\oauth2\server\entity\auth_code_entity;
+use core\oauth2\server\entity\client_entity;
+use core\oauth2\server\entity\refresh_token_entity;
+
+/**
+ * Centralised management of OAuth2 server clients, their secrets and their redirect URIs.
+ *
+ * This class is intended to be obtained from the DI container (\core\di::get(client_manager::class)).
+ * All methods are instance methods.
+ *
+ * @package    core
+ * @copyright  2026 Moodle contributors
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class client_manager {
+    /** @var int The maximum number of active (non-revoked, non-expired) secrets per client. */
+    public const MAX_ACTIVE_SECRETS = 2;
+
+    /** @var int The lifetime of a newly generated client secret, in seconds. */
+    public const SECRET_LIFETIME = YEARSECS;
+
+    /** @var int The length of a newly generated plaintext client secret. */
+    public const SECRET_LENGTH = 40;
+
+    /** @var int The maximum length of a client name. */
+    public const NAME_MAXLENGTH = 255;
+
+    /**
+     * Fetch a client record by its ID.
+     *
+     * @param int $id The client ID.
+     * @return \stdClass|null The client record, or null if it does not exist.
+     */
+    public function get_client_by_id(int $id): ?\stdClass {
+        global $DB;
+
+        $record = $DB->get_record('oauth2_server_clients', ['id' => $id]);
+        return $record ?: null;
+    }
+
+    /**
+     * Fetch a client record by its public client identifier.
+     *
+     * @param string $clientidentifier The public client identifier.
+     * @return \stdClass|null The client record, or null if it does not exist.
+     */
+    public function get_client_by_identifier(string $clientidentifier): ?\stdClass {
+        global $DB;
+
+        $record = $DB->get_record('oauth2_server_clients', ['clientidentifier' => $clientidentifier]);
+        return $record ?: null;
+    }
+
+    /**
+     * Update the administrative metadata of a client (name and description only).
+     *
+     * @param int $id The client ID.
+     * @param string $name The new client name.
+     * @param string|null $description The new client description, or null to clear it.
+     * @throws \moodle_exception If the name is empty or too long.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function update_client(int $id, string $name, ?string $description = null): void {
+        global $DB;
+
+        $this->require_client_by_id($id);
+
+        $name = trim($name);
+        if ($name === '') {
+            throw new \moodle_exception('oauth2clientnamerequired', 'moodle');
+        }
+        if (\core_text::strlen($name) > self::NAME_MAXLENGTH) {
+            throw new \moodle_exception('oauth2clientnametoolong', 'moodle', '', self::NAME_MAXLENGTH);
+        }
+        if ($description !== null && trim($description) === '') {
+            $description = null;
+        }
+
+        $DB->update_record('oauth2_server_clients', (object) [
+            'id' => $id,
+            'name' => $name,
+            'description' => $description,
+            'timemodified' => time(),
+        ]);
+    }
+
+    /**
+     * Revoke a client.
+     *
+     * The client status is set to revoked and all of its active access tokens, refresh tokens, authorisation codes
+     * and secrets are revoked in the same transaction, fully cutting off access.
+     *
+     * @param int $id The client ID.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function revoke_client(int $id): void {
+        global $DB;
+
+        $client = $this->require_client_by_id($id);
+        $identifier = $client->clientidentifier;
+
+        $transaction = $DB->start_delegated_transaction();
+
+        $DB->set_field('oauth2_server_clients', 'status', client_entity::STATUS_REVOKED, ['id' => $id]);
+        $DB->set_field('oauth2_server_clients', 'timemodified', time(), ['id' => $id]);
+
+        $DB->set_field(
+            'oauth2_server_client_access_tokens',
+            'revoked',
+            access_token_entity::REVOKED_YES,
+            ['clientidentifier' => $identifier]
+        );
+
+        $accesstokenids = $DB->get_fieldset_select(
+            'oauth2_server_client_access_tokens',
+            'identifier',
+            'clientidentifier = :clientidentifier',
+            ['clientidentifier' => $identifier]
+        );
+        if (!empty($accesstokenids)) {
+            [$insql, $inparams] = $DB->get_in_or_equal($accesstokenids);
+            $DB->set_field_select(
+                'oauth2_server_client_refresh_tokens',
+                'revoked',
+                refresh_token_entity::REVOKED_YES,
+                "accesstokenidentifier $insql",
+                $inparams
+            );
+        }
+
+        $DB->set_field(
+            'oauth2_server_client_auth_codes',
+            'revoked',
+            auth_code_entity::REVOKED_YES,
+            ['clientidentifier' => $identifier]
+        );
+
+        $DB->set_field(
+            'oauth2_server_client_secrets',
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['clientidentifier' => $identifier]
+        );
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Reactivate a revoked client.
+     *
+     * Only the client record itself is restored. Previously revoked secrets, tokens and codes remain revoked, so the
+     * client must generate new secrets and go through authorisation again.
+     *
+     * @param int $id The client ID.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function reactivate_client(int $id): void {
+        global $DB;
+
+        $this->require_client_by_id($id);
+
+        $DB->set_field('oauth2_server_clients', 'status', client_entity::STATUS_ACTIVE, ['id' => $id]);
+        $DB->set_field('oauth2_server_clients', 'timemodified', time(), ['id' => $id]);
+    }
+
+    /**
+     * Permanently delete a client, together with its secrets, redirect URIs, tokens, codes and granted scopes.
+     *
+     * The client must already be revoked; this acts as a safety guard against destroying a live integration.
+     *
+     * @param int $id The client ID.
+     * @throws \moodle_exception If the client is not revoked.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function delete_client(int $id): void {
+        global $DB;
+
+        $client = $this->require_client_by_id($id);
+        if ((int) $client->status !== client_entity::STATUS_REVOKED) {
+            throw new \moodle_exception('oauth2clientdeletenotrevoked', 'moodle');
+        }
+        $identifier = $client->clientidentifier;
+
+        $transaction = $DB->start_delegated_transaction();
+
+        // Refresh tokens reference access tokens, so they must be removed first.
+        $accesstokenids = $DB->get_fieldset_select(
+            'oauth2_server_client_access_tokens',
+            'identifier',
+            'clientidentifier = :clientidentifier',
+            ['clientidentifier' => $identifier]
+        );
+        if (!empty($accesstokenids)) {
+            [$insql, $inparams] = $DB->get_in_or_equal($accesstokenids);
+            $DB->delete_records_select('oauth2_server_client_refresh_tokens', "accesstokenidentifier $insql", $inparams);
+        }
+
+        $DB->delete_records('oauth2_server_client_access_tokens', ['clientidentifier' => $identifier]);
+        $DB->delete_records('oauth2_server_client_auth_codes', ['clientidentifier' => $identifier]);
+        $DB->delete_records('oauth2_server_client_granted_scopes', ['clientidentifier' => $identifier]);
+        $DB->delete_records('oauth2_server_client_secrets', ['clientidentifier' => $identifier]);
+        $DB->delete_records('oauth2_server_client_redirect_uris', ['clientidentifier' => $identifier]);
+        $DB->delete_records('oauth2_server_clients', ['id' => $id]);
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Generate a new secret for a client.
+     *
+     * Only the password hash is stored; the plaintext secret is returned once and cannot be retrieved later.
+     * The limit of {@see self::MAX_ACTIVE_SECRETS} active secrets applies per client.
+     *
+     * @param string $clientidentifier The public client identifier.
+     * @return string The plaintext client secret.
+     * @throws \moodle_exception If the client already has the maximum number of active secrets.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function generate_client_secret(string $clientidentifier): string {
+        global $DB;
+
+        $this->require_client_by_identifier($clientidentifier);
+
+        if ($this->count_active_secrets($clientidentifier) >= self::MAX_ACTIVE_SECRETS) {
+            throw new \moodle_exception('oauth2clientsecretlimitreached', 'moodle', '', self::MAX_ACTIVE_SECRETS);
+        }
+
+        $plaintext = random_string(self::SECRET_LENGTH);
+
+        $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => $clientidentifier,
+            'secret' => password_hash($plaintext, PASSWORD_DEFAULT),
+            'expirytime' => time() + self::SECRET_LIFETIME,
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'timecreated' => time(),
+        ]);
+
+        return $plaintext;
+    }
+
+    /**
+     * Fetch all secrets (active, revoked and expired) belonging to a client.
+     *
+     * @param string $clientidentifier The public client identifier.
+     * @return \stdClass[] The secret records, keyed by ID.
+     */
+    public function get_client_secrets(string $clientidentifier): array {
+        global $DB;
+
+        return $DB->get_records('oauth2_server_client_secrets', ['clientidentifier' => $clientidentifier], 'id ASC');
+    }
+
+    /**
+     * Revoke a single client secret.
+     *
+     * @param int $secretid The secret ID.
+     * @throws \dml_missing_record_exception If the secret does not exist.
+     */
+    public function revoke_client_secret(int $secretid): void {
+        global $DB;
+
+        $DB->get_record('oauth2_server_client_secrets', ['id' => $secretid], '*', MUST_EXIST);
+
+        $DB->set_field(
+            'oauth2_server_client_secrets',
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['id' => $secretid]
+        );
+    }
+
+    /**
+     * Fetch the redirect URIs registered for a client.
+     *
+     * @param string $clientidentifier The public client identifier.
+     * @return string[] The redirect URIs, keyed by redirect URI record ID.
+     */
+    public function get_redirect_uris(string $clientidentifier): array {
+        global $DB;
+
+        $records = $DB->get_records(
+            'oauth2_server_client_redirect_uris',
+            ['clientidentifier' => $clientidentifier],
+            'id ASC',
+            'id, uri'
+        );
+
+        $uris = [];
+        foreach ($records as $record) {
+            $uris[$record->id] = $record->uri;
+        }
+        return $uris;
+    }
+
+    /**
+     * Register a redirect URI for a client.
+     *
+     * @param string $clientidentifier The public client identifier.
+     * @param string $uri The redirect URI.
+     * @return int The ID of the new redirect URI record.
+     * @throws \moodle_exception If the URI is invalid or already registered for the client.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function create_redirect_uri(string $clientidentifier, string $uri): int {
+        global $DB;
+
+        $this->require_client_by_identifier($clientidentifier);
+
+        if (!$this->validate_redirect_uri($uri)) {
+            throw new \moodle_exception('oauth2redirecturiinvalid', 'moodle', '', $uri);
+        }
+
+        if ($DB->record_exists('oauth2_server_client_redirect_uris', [
+            'clientidentifier' => $clientidentifier,
+            'uri' => $uri,
+        ])) {
+            throw new \moodle_exception('oauth2redirecturiexists', 'moodle');
+        }
+
+        return $DB->insert_record('oauth2_server_client_redirect_uris', (object) [
+            'clientidentifier' => $clientidentifier,
+            'uri' => $uri,
+        ]);
+    }
+
+    /**
+     * Remove a redirect URI record.
+     *
+     * @param int $redirecturiid The redirect URI record ID.
+     * @throws \dml_missing_record_exception If the redirect URI does not exist.
+     */
+    public function remove_redirect_uri(int $redirecturiid): void {
+        global $DB;
+
+        $DB->get_record('oauth2_server_client_redirect_uris', ['id' => $redirecturiid], '*', MUST_EXIST);
+        $DB->delete_records('oauth2_server_client_redirect_uris', ['id' => $redirecturiid]);
+    }
+
+    /**
+     * Validate a redirect URI.
+     *
+     * A valid URI is absolute, has a host, contains no wildcards, whitespace, user info or fragment, and uses HTTPS.
+     * HTTP is accepted only for localhost and loopback addresses (to support native app development).
+     *
+     * Matching against registered URIs must be exact; this method does not perform any prefix or wildcard matching.
+     *
+     * @param string $uri The redirect URI to validate.
+     * @return bool True if the URI is valid, false otherwise.
+     */
+    public function validate_redirect_uri(string $uri): bool {
+        if ($uri === '' || preg_match('/\s/', $uri) || str_contains($uri, '*')) {
+            return false;
+        }
+
+        $parts = parse_url($uri);
+        if ($parts === false || empty($parts['scheme']) || empty($parts['host'])) {
+            return false;
+        }
+        if (isset($parts['fragment']) || isset($parts['user']) || isset($parts['pass'])) {
+            return false;
+        }
+
+        $scheme = strtolower($parts['scheme']);
+        $host = strtolower(trim($parts['host'], '[]'));
+
+        if ($scheme === 'https') {
+            return true;
+        }
+
+        return $scheme === 'http' && $this->is_loopback_host($host);
+    }
+
+    /**
+     * Count the active (non-revoked, non-expired) secrets of a client.
+     *
+     * @param string $clientidentifier The public client identifier.
+     * @return int The number of active secrets.
+     */
+    protected function count_active_secrets(string $clientidentifier): int {
+        global $DB;
+
+        return $DB->count_records_select(
+            'oauth2_server_client_secrets',
+            'clientidentifier = :clientidentifier AND revoked = :revoked AND expirytime > :now',
+            [
+                'clientidentifier' => $clientidentifier,
+                'revoked' => client_entity::SECRET_REVOKED_NO,
+                'now' => time(),
+            ]
+        );
+    }
+
+    /**
+     * Whether a host name refers to localhost or a loopback address.
+     *
+     * @param string $host The lower-cased host, without IPv6 brackets.
+     * @return bool True if the host is a loopback host.
+     */
+    private function is_loopback_host(string $host): bool {
+        if ($host === 'localhost') {
+            return true;
+        }
+        if (filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6) !== false) {
+            return $host === '::1';
+        }
+        if (filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) !== false) {
+            return str_starts_with($host, '127.');
+        }
+        return false;
+    }
+
+    /**
+     * Fetch a client record by ID, throwing if it does not exist.
+     *
+     * @param int $id The client ID.
+     * @return \stdClass The client record.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    private function require_client_by_id(int $id): \stdClass {
+        global $DB;
+
+        return $DB->get_record('oauth2_server_clients', ['id' => $id], '*', MUST_EXIST);
+    }
+
+    /**
+     * Fetch a client record by identifier, throwing if it does not exist.
+     *
+     * @param string $clientidentifier The public client identifier.
+     * @return \stdClass The client record.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    private function require_client_by_identifier(string $clientidentifier): \stdClass {
+        global $DB;
+
+        return $DB->get_record('oauth2_server_clients', ['clientidentifier' => $clientidentifier], '*', MUST_EXIST);
+    }
+}
