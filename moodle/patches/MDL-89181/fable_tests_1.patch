+    /**
+     * Insert a secret record.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param int $revoked Whether the secret is revoked.
+     * @param int|null $expirytime The expiry time.
+     * @return int The secret ID.
+     */
+    private function create_secret(
+        string $clientidentifier = 'client-1',
+        int $revoked = client_entity::SECRET_REVOKED_NO,
+        ?int $expirytime = null
+    ): int {
+        global $DB;
+
+        return $DB->insert_record('oauth2_server_client_secrets', (object) [
+            'clientidentifier' => $clientidentifier,
+            'secret' => password_hash('secret', PASSWORD_DEFAULT),
+            'expirytime' => $expirytime ?? (time() + DAYSECS),
+            'revoked' => $revoked,
+            'timecreated' => time(),
+        ]);
+    }
