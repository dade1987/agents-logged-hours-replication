+    /**
+     * Test secret generation, the per-client active secret limit, and secret revocation.
+     */
+    public function test_generate_and_revoke_client_secret(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $this->create_client('client-1');
+        $this->create_client('client-2');
+        $manager = \core\di::get(client_manager::class);
+
+        $first = $manager->generate_client_secret('client-1');
+        $this->assertNotEmpty($first->plainsecret);
+        $this->assertNotSame($first->plainsecret, $first->secret);
+        $this->assertTrue(password_verify($first->plainsecret, $first->secret));
+        $this->assertEquals(client_entity::SECRET_REVOKED_NO, $first->revoked);
+        $this->assertGreaterThan(time(), $first->expirytime);
+
+        $stored = $DB->get_record('oauth2_server_client_secrets', ['id' => $first->id]);
+        $this->assertSame($first->secret, $stored->secret);
+        $this->assertTrue(password_verify($first->plainsecret, $stored->secret));
+        $this->assertObjectNotHasProperty('plainsecret', $stored);
+
+        // The generated secret is accepted by the client repository.
+        $repository = new \core\oauth2\server\repository\client_repository();
+        $this->assertTrue($repository->validateClient('client-1', $first->plainsecret, 'client_credentials'));
+
+        $expiry = time() + HOURSECS;
+        $second = $manager->generate_client_secret('client-1', $expiry);
+        $this->assertSame($expiry, (int) $second->expirytime);
+        $this->assertNotSame($first->plainsecret, $second->plainsecret);
+        $this->assertCount(2, $manager->get_client_secrets('client-1', true));
+
+        // The limit is per client: another client can still generate secrets.
+        $manager->generate_client_secret('client-2');
+        $this->assertCount(1, $manager->get_client_secrets('client-2', true));
+
+        // Exceeding the limit is rejected.
+        try {
+            $manager->generate_client_secret('client-1');
+            $this->fail('Exceeding the active secret limit must throw an exception');
+        } catch (moodle_exception $e) {
+            $this->assertSame('oauth2serversecretlimitreached', $e->errorcode);
+        }
+        $this->assertCount(2, $manager->get_client_secrets('client-1'));
+
+        // Revoking a secret frees up a slot.
+        $manager->revoke_client_secret($first->id);
+        $this->assertEquals(
+            client_entity::SECRET_REVOKED_YES,
+            $DB->get_field('oauth2_server_client_secrets', 'revoked', ['id' => $first->id])
+        );
+        $this->assertFalse($repository->validateClient('client-1', $first->plainsecret, 'client_credentials'));
+        $this->assertCount(1, $manager->get_client_secrets('client-1', true));
+        $this->assertCount(2, $manager->get_client_secrets('client-1'));
+
+        $third = $manager->generate_client_secret('client-1');
+        $active = $manager->get_client_secrets('client-1', true);
+        $this->assertCount(2, $active);
+        $this->assertEqualsCanonicalizing([$second->id, $third->id], array_keys($active));
+
+        // Expired secrets do not count towards the limit either.
+        $manager->revoke_client_secret($third->id);
+        $this->create_secret('client-1', client_entity::SECRET_REVOKED_NO, time() - 10);
+        $this->assertCount(1, $manager->get_client_secrets('client-1', true));
+        $manager->generate_client_secret('client-1');
+        $this->assertCount(2, $manager->get_client_secrets('client-1', true));
+
+        $this->expectException(moodle_exception::class);
+        $manager->generate_client_secret('does-not-exist');
+    }
