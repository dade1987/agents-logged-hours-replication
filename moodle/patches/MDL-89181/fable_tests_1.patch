+namespace core\oauth2\server;
+
+use core\exception\moodle_exception;
+use core\oauth2\server\entity\access_token_entity;
+use core\oauth2\server\entity\auth_code_entity;
+use core\oauth2\server\entity\client_entity;
+use core\oauth2\server\entity\refresh_token_entity;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
+
+/**
+ * Tests for {@see client_manager}.
+ *
+ * @package    core
+ * @copyright  2026 Mihail Geshoski <mihailgesoski@gmail.com>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[CoversClass(client_manager::class)]
+final class client_manager_test extends \advanced_testcase {
+    /**
+     * Insert a client record.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param int $status The client status.
+     * @param array $redirecturis Redirect URIs to register for the client.
+     * @return \stdClass The inserted record.
+     */
+    private function create_client(
+        string $clientidentifier = 'client-1',
+        int $status = client_entity::STATUS_ACTIVE,
+        array $redirecturis = []
+    ): \stdClass {
+        global $DB;
+
+        $record = (object) [
+            'name' => 'Client ' . $clientidentifier,
+            'description' => 'Description of ' . $clientidentifier,
+            'clientidentifier' => $clientidentifier,
+            'ownercontext' => \context_system::instance()->id,
+            'status' => $status,
+            'isconfidential' => 1,
+            'timecreated' => time(),
+        ];
+        $record->id = $DB->insert_record('oauth2_server_clients', $record);
+
+        foreach ($redirecturis as $uri) {
