+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\oauth2\server;
+
+use core\exception\moodle_exception;
+use core\oauth2\server\entity\access_token_entity;
+use core\oauth2\server\entity\auth_code_entity;
+use core\oauth2\server\entity\client_entity;
+use core\oauth2\server\entity\refresh_token_entity;
+use stdClass;
+
+/**
+ * OAuth2 server client manager.
+ *
+ * Centralised management of OAuth2 server clients, their secrets and their redirect URIs.
+ *
+ * This class is intended to be resolved through the dependency injection container
+ * (e.g. `\core\di::get(client_manager::class)`) rather than instantiated directly.
+ *
+ * @package    core
+ * @copyright  2026 Mihail Geshoski <mihailgesoski@gmail.com>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class client_manager {
+    /** @var int The maximum number of active (non-revoked, non-expired) secrets allowed per client */
+    public const int MAX_ACTIVE_SECRETS = 2;
+
+    /** @var int The default lifetime of a generated client secret (one year) */
+    public const int DEFAULT_SECRET_LIFETIME = YEARSECS;
+
+    /** @var int The length (in bytes) of the random data used to generate a client secret */
+    protected const int SECRET_BYTES = 32;
+
+    /**
+     * Fetch a client by its database ID.
+     *
+     * @param int $id The client record ID.
+     * @return client_entity|null The client entity, or null if not found.
+     */
+    public function get_client_by_id(int $id): ?client_entity {
+        global $DB;
+
+        $clientrecord = $DB->get_record('oauth2_server_clients', ['id' => $id]);
+        if (!$clientrecord) {
+            return null;
+        }
+
+        return $this->build_client_entity($clientrecord);
+    }
+
+    /**
+     * Fetch a client by its public client identifier.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return client_entity|null The client entity, or null if not found.
+     */
+    public function get_client_by_identifier(string $clientidentifier): ?client_entity {
+        global $DB;
+
+        $clientrecord = $DB->get_record('oauth2_server_clients', ['clientidentifier' => $clientidentifier]);
+        if (!$clientrecord) {
+            return null;
+        }
+
+        return $this->build_client_entity($clientrecord);
+    }
+
+    /**
+     * Update the administrative metadata (name, description) of a client.
+     *
+     * Only the name and description can be changed through this method; all other
+     * client properties are immutable after creation.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $name The new name of the client.
+     * @param string|null $description The new description of the client.
+     * @return client_entity The updated client entity.
+     * @throws moodle_exception If the client does not exist.
+     */
+    public function update_client(string $clientidentifier, string $name, ?string $description = null): client_entity {
+        global $DB;
+
+        $clientrecord = $this->require_client_record($clientidentifier);
+
+        $update = new stdClass();
+        $update->id = $clientrecord->id;
+        $update->name = $name;
+        $update->description = $description;
+        $update->timemodified = time();
+
+        $DB->update_record('oauth2_server_clients', $update);
+
+        return $this->get_client_by_identifier($clientidentifier);
+    }
+
+    /**
+     * Revoke a client.
+     *
+     * Revoking a client cascades to all of its active secrets, access tokens, refresh tokens and
+     * authorisation codes, fully cutting off access.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return void
+     * @throws moodle_exception If the client does not exist.
+     */
+    public function revoke_client(string $clientidentifier): void {
+        global $DB;
+
+        $clientrecord = $this->require_client_record($clientidentifier);
+
+        $transaction = $DB->start_delegated_transaction();
+
+        $update = new stdClass();
+        $update->id = $clientrecord->id;
+        $update->status = client_entity::STATUS_REVOKED;
+        $update->timemodified = time();
+        $DB->update_record('oauth2_server_clients', $update);
+
+        // Revoke all client secrets.
+        $DB->set_field(
+            'oauth2_server_client_secrets',
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['clientidentifier' => $clientidentifier],
+        );
+
+        // Revoke all refresh tokens associated with the client's access tokens.
+        $sql = "UPDATE {oauth2_server_client_refresh_tokens}
+                   SET revoked = :revoked
+                 WHERE accesstokenidentifier IN (
+                           SELECT identifier
+                             FROM {oauth2_server_client_access_tokens}
+                            WHERE clientidentifier = :clientidentifier
+                       )";
+        $DB->execute($sql, [
+            'revoked' => refresh_token_entity::REVOKED_YES,
+            'clientidentifier' => $clientidentifier,
+        ]);
+
+        // Revoke all access tokens.
+        $DB->set_field(
+            'oauth2_server_client_access_tokens',
+            'revoked',
+            access_token_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier],
+        );
+
+        // Revoke all authorisation codes.
+        $DB->set_field(
+            'oauth2_server_client_auth_codes',
+            'revoked',
+            auth_code_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier],
+        );
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Reactivate a previously revoked client.
+     *
+     * Only the client record itself is restored. Secrets and tokens revoked as part of the
+     * client revocation remain revoked: new secrets must be generated and clients must go
+     * through authorisation again to obtain new tokens.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return void
+     * @throws moodle_exception If the client does not exist.
+     */
+    public function reactivate_client(string $clientidentifier): void {
+        global $DB;
+
+        $clientrecord = $this->require_client_record($clientidentifier);
+
+        $update = new stdClass();
+        $update->id = $clientrecord->id;
+        $update->status = client_entity::STATUS_ACTIVE;
+        $update->timemodified = time();
+        $DB->update_record('oauth2_server_clients', $update);
+    }
+
+    /**
+     * Permanently delete a client and all of its associated data.
+     *
+     * A client can only be deleted once it has been revoked. This acts as a safety guard
+     * against accidentally destroying a live integration.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return void
+     * @throws moodle_exception If the client does not exist or is not in a revoked state.
+     */
+    public function delete_client(string $clientidentifier): void {
+        global $DB;
+
+        $clientrecord = $this->require_client_record($clientidentifier);
+
+        if ((int) $clientrecord->status !== client_entity::STATUS_REVOKED) {
+            throw new moodle_exception('oauth2serverclientnotrevoked', 'error', '', $clientidentifier);
+        }
+
+        $transaction = $DB->start_delegated_transaction();
+
+        $params = ['clientidentifier' => $clientidentifier];
+
+        // Refresh tokens reference access tokens, so they must be removed first.
+        $sql = "accesstokenidentifier IN (
+                    SELECT identifier
+                      FROM {oauth2_server_client_access_tokens}
+                     WHERE clientidentifier = :clientidentifier
+                )";
+        $DB->delete_records_select('oauth2_server_client_refresh_tokens', $sql, $params);
+
+        $DB->delete_records('oauth2_server_client_access_tokens', $params);
+        $DB->delete_records('oauth2_server_client_auth_codes', $params);
+        $DB->delete_records('oauth2_server_client_granted_scopes', $params);
+        $DB->delete_records('oauth2_server_client_secrets', $params);
+        $DB->delete_records('oauth2_server_client_redirect_uris', $params);
+        $DB->delete_records('oauth2_server_clients', ['id' => $clientrecord->id]);
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Generate a new secret for a client.
+     *
+     * The secret is stored hashed; the plain text value is only available in the returned
+     * object and must be communicated to the client owner immediately.
+     *
+     * A client may have at most {@see self::MAX_ACTIVE_SECRETS} active (non-revoked,
+     * non-expired) secrets at any time.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param int|null $expirytime The expiry timestamp of the secret (defaults to one year from now).
+     * @return stdClass The stored secret record, with an extra `plainsecret` property holding the plain text secret.
+     * @throws moodle_exception If the client does not exist, or the maximum number of active secrets has been reached.
+     */
+    public function generate_client_secret(string $clientidentifier, ?int $expirytime = null): stdClass {
+        global $DB;
+
+        $this->require_client_record($clientidentifier);
+
+        if (count($this->get_client_secrets($clientidentifier, true)) >= self::MAX_ACTIVE_SECRETS) {
+            throw new moodle_exception('oauth2serversecretlimitreached', 'error', '', self::MAX_ACTIVE_SECRETS);
+        }
+
+        $now = time();
+        $plainsecret = bin2hex(random_bytes(self::SECRET_BYTES));
+
+        $record = new stdClass();
+        $record->clientidentifier = $clientidentifier;
+        $record->secret = password_hash($plainsecret, PASSWORD_DEFAULT);
+        $record->expirytime = $expirytime ?? ($now + self::DEFAULT_SECRET_LIFETIME);
+        $record->revoked = client_entity::SECRET_REVOKED_NO;
+        $record->timecreated = $now;
+        $record->lastaccessed = null;
+
+        $record->id = $DB->insert_record('oauth2_server_client_secrets', $record);
+        $record->plainsecret = $plainsecret;
+
+        return $record;
+    }
+
+    /**
+     * Fetch the secrets of a client.
+     *
+     * Note: the returned records contain the hashed secret only.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param bool $activeonly Whether to return only active (non-revoked, non-expired) secrets.
+     * @return stdClass[] The secret records, indexed by ID.
+     */
+    public function get_client_secrets(string $clientidentifier, bool $activeonly = false): array {
+        global $DB;
+
+        $select = 'clientidentifier = :clientidentifier';
+        $params = ['clientidentifier' => $clientidentifier];
+
+        if ($activeonly) {
+            $select .= ' AND revoked = :revoked AND expirytime > :now';
+            $params['revoked'] = client_entity::SECRET_REVOKED_NO;
+            $params['now'] = time();
+        }
+
+        return $DB->get_records_select('oauth2_server_client_secrets', $select, $params, 'timecreated ASC, id ASC');
+    }
+
+    /**
+     * Revoke a client secret.
+     *
+     * @param int $secretid The ID of the secret record.
+     * @return void
+     * @throws \dml_missing_record_exception If the secret does not exist.
+     */
+    public function revoke_client_secret(int $secretid): void {
+        global $DB;
+
+        $DB->get_record('oauth2_server_client_secrets', ['id' => $secretid], 'id', MUST_EXIST);
+
+        $DB->set_field(
+            'oauth2_server_client_secrets',
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['id' => $secretid],
+        );
+    }
+
+    /**
+     * Fetch the redirect URIs of a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return stdClass[] The redirect URI records, indexed by ID.
+     */
+    public function get_redirect_uris(string $clientidentifier): array {
+        global $DB;
+
+        return $DB->get_records('oauth2_server_client_redirect_uris', ['clientidentifier' => $clientidentifier], 'id ASC');
+    }
+
+    /**
+     * Register a new redirect URI for a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The redirect URI.
+     * @return stdClass The created redirect URI record.
+     * @throws moodle_exception If the client does not exist or the URI is not valid.
+     */
+    public function create_redirect_uri(string $clientidentifier, string $uri): stdClass {
+        global $DB;
+
+        $this->require_client_record($clientidentifier);
+
+        if (!$this->is_valid_redirect_uri($uri)) {
+            throw new moodle_exception('oauth2serverinvalidredirecturi', 'error', '', $uri);
+        }
+
+        // Exact-match duplicates are a no-op: return the existing record.
+        foreach ($this->get_redirect_uris($clientidentifier) as $existing) {
+            if ($existing->uri === $uri) {
+                return $existing;
+            }
+        }
+
+        $record = new stdClass();
+        $record->clientidentifier = $clientidentifier;
+        $record->uri = $uri;
+        $record->id = $DB->insert_record('oauth2_server_client_redirect_uris', $record);
+
+        return $record;
+    }
+
+    /**
+     * Remove a redirect URI.
+     *
+     * @param int $redirecturiid The ID of the redirect URI record.
+     * @return void
+     * @throws \dml_missing_record_exception If the redirect URI does not exist.
+     */
+    public function delete_redirect_uri(int $redirecturiid): void {
+        global $DB;
+
+        $DB->get_record('oauth2_server_client_redirect_uris', ['id' => $redirecturiid], 'id', MUST_EXIST);
+        $DB->delete_records('oauth2_server_client_redirect_uris', ['id' => $redirecturiid]);
+    }
+
+    /**
+     * Validate a redirect URI against the URIs registered for a client.
+     *
+     * The URI must be well formed (see {@see self::is_valid_redirect_uri()}) and must exactly
+     * match one of the client's registered redirect URIs. No prefix or wildcard matching is done.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The redirect URI to validate.
+     * @return bool True if the URI is valid and registered for the client.
+     */
+    public function validate_redirect_uri(string $clientidentifier, string $uri): bool {
+        if (!$this->is_valid_redirect_uri($uri)) {
+            return false;
+        }
+
+        foreach ($this->get_redirect_uris($clientidentifier) as $registered) {
+            if ($registered->uri === $uri) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    /**
+     * Check whether a redirect URI is well formed.
+     *
+     * A valid redirect URI is an absolute URI without a fragment component, using the HTTPS scheme.
+     * The HTTP scheme is only allowed for localhost and loopback addresses (127.0.0.0/8 and ::1), to
+     * support native application development.
+     *
+     * @param string $uri The redirect URI.
+     * @return bool True if the URI is well formed.
+     */
+    public function is_valid_redirect_uri(string $uri): bool {
+        if ($uri === '' || $uri !== trim($uri)) {
+            return false;
+        }
+
+        $parts = parse_url($uri);
+        if ($parts === false || empty($parts['scheme']) || empty($parts['host'])) {
+            return false;
+        }
+
+        // Fragments are not allowed in redirect URIs (RFC 6749, section 3.1.2).
+        if (isset($parts['fragment'])) {
+            return false;
+        }
+
+        $scheme = strtolower($parts['scheme']);
+        if ($scheme === 'https') {
+            return true;
+        }
+
+        if ($scheme === 'http') {
+            return $this->is_loopback_host($parts['host']);
+        }
+
+        return false;
+    }
+
+    /**
+     * Check whether a host is localhost or a loopback address.
+     *
+     * @param string $host The host component of a URI.
+     * @return bool
+     */
+    protected function is_loopback_host(string $host): bool {
+        $host = strtolower(trim($host, '[]'));
+
+        if ($host === 'localhost' || $host === '::1') {
+            return true;
+        }
+
+        // IPv4 loopback range (127.0.0.0/8).
+        if (filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) !== false) {
+            return str_starts_with($host, '127.');
+        }
+
+        return false;
+    }
+
+    /**
+     * Fetch a client record, throwing if it does not exist.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return stdClass The client record.
+     * @throws moodle_exception If the client does not exist.
+     */
+    protected function require_client_record(string $clientidentifier): stdClass {
+        global $DB;
+
+        $clientrecord = $DB->get_record('oauth2_server_clients', ['clientidentifier' => $clientidentifier]);
+        if (!$clientrecord) {
+            throw new moodle_exception('oauth2serverclientnotfound', 'error', '', $clientidentifier);
+        }
+
+        return $clientrecord;
+    }
+
+    /**
+     * Build a client entity from a client record, loading its redirect URIs.
+     *
+     * @param stdClass $clientrecord The client record.
+     * @return client_entity
+     */
+    protected function build_client_entity(stdClass $clientrecord): client_entity {
+        return client_entity::create_from_record($clientrecord, $this->get_redirect_uris($clientrecord->clientidentifier));
+    }
+}
