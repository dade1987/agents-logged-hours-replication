+    /**
+     * Test fetching, creating and removing redirect URIs.
+     */
+    public function test_redirect_uris(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $this->create_client('client-1');
+        $this->create_client('client-2', client_entity::STATUS_ACTIVE, ['https://other.test/cb']);
+        $manager = \core\di::get(client_manager::class);
+
+        $this->assertSame([], $manager->get_redirect_uris('client-1'));
+
+        $created = $manager->create_redirect_uri('client-1', 'https://example.test/callback');
+        $this->assertSame('https://example.test/callback', $created->uri);
+        $this->assertSame('client-1', $created->clientidentifier);
+        $this->assertTrue($DB->record_exists('oauth2_server_client_redirect_uris', ['id' => $created->id]));
+
+        // There is no cap on the number of redirect URIs.
+        $manager->create_redirect_uri('client-1', 'http://localhost:8080/cb');
+        $manager->create_redirect_uri('client-1', 'http://127.0.0.1/cb');
+        $manager->create_redirect_uri('client-1', 'https://example.test/other');
+        $uris = $manager->get_redirect_uris('client-1');
+        $this->assertCount(4, $uris);
+        $this->assertEqualsCanonicalizing(
+            ['https://example.test/callback', 'http://localhost:8080/cb', 'http://127.0.0.1/cb', 'https://example.test/other'],
+            array_map(fn($uri) => $uri->uri, array_values($uris))
+        );
+
+        // Creating an exact duplicate does not create a new record.
+        $duplicate = $manager->create_redirect_uri('client-1', 'https://example.test/callback');
+        $this->assertEquals($created->id, $duplicate->id);
+        $this->assertCount(4, $manager->get_redirect_uris('client-1'));
+
+        // The URIs are reflected on the client entity.
+        $this->assertCount(4, $manager->get_client_by_identifier('client-1')->getRedirectUri());
+        $this->assertCount(1, $manager->get_redirect_uris('client-2'));
+
+        // Invalid URIs are rejected.
+        try {
+            $manager->create_redirect_uri('client-1', 'http://example.test/callback');
+            $this->fail('A non-HTTPS redirect URI must be rejected');
+        } catch (moodle_exception $e) {
+            $this->assertSame('oauth2serverinvalidredirecturi', $e->errorcode);
+        }
+        $this->assertCount(4, $manager->get_redirect_uris('client-1'));
+
+        // Removal.
+        $manager->delete_redirect_uri($created->id);
+        $this->assertFalse($DB->record_exists('oauth2_server_client_redirect_uris', ['id' => $created->id]));
+        $this->assertCount(3, $manager->get_redirect_uris('client-1'));
+        $this->assertCount(1, $manager->get_redirect_uris('client-2'));
+
+        try {
+            $manager->delete_redirect_uri($created->id);
+            $this->fail('Deleting a non-existent redirect URI must throw an exception');
+        } catch (\dml_missing_record_exception $e) {
+            $this->assertInstanceOf(\dml_missing_record_exception::class, $e);
+        }
+
+        $this->expectException(moodle_exception::class);
+        $manager->create_redirect_uri('does-not-exist', 'https://example.test/callback');
+    }
