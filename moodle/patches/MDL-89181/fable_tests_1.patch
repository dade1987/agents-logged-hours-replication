+    /**
+     * Insert an access token, a refresh token and an auth code for a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $suffix A suffix for the token identifiers.
+     * @return void
+     */
+    private function create_tokens(string $clientidentifier, string $suffix = ''): void {
+        global $DB;
+
+        $user = $this->getDataGenerator()->create_user();
+
+        $DB->insert_record('oauth2_server_client_access_tokens', (object) [
+            'identifier' => 'access-' . $clientidentifier . $suffix,
+            'userid' => $user->id,
+            'clientidentifier' => $clientidentifier,
+            'scopes' => 'openid',
+            'expirytime' => time() + DAYSECS,
+            'revoked' => access_token_entity::REVOKED_NO,
+            'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_refresh_tokens', (object) [
+            'identifier' => 'refresh-' . $clientidentifier . $suffix,
+            'accesstokenidentifier' => 'access-' . $clientidentifier . $suffix,
+            'expirytime' => time() + DAYSECS,
+            'revoked' => refresh_token_entity::REVOKED_NO,
+            'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_auth_codes', (object) [
+            'identifier' => 'code-' . $clientidentifier . $suffix,
+            'userid' => $user->id,
+            'clientidentifier' => $clientidentifier,
+            'redirecturi' => 'https://example.test/callback',
+            'scopes' => 'openid',
+            'expirytime' => time() + DAYSECS,
+            'revoked' => auth_code_entity::REVOKED_NO,
+            'timecreated' => time(),
+        ]);
+        $DB->insert_record('oauth2_server_client_granted_scopes', (object) [
+            'clientidentifier' => $clientidentifier,
+            'userid' => $user->id,
+            'scope' => 'openid',
+            'timecreated' => time(),
