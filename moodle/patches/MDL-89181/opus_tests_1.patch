+namespace core\oauth2\server;
+
+use core\clock;
+use core\exception\moodle_exception;
+use core\oauth2\server\entity\access_token_entity;
+use core\oauth2\server\entity\auth_code_entity;
+use core\oauth2\server\entity\client_entity;
+use core\oauth2\server\entity\refresh_token_entity;
+
+/**
+ * Manager for OAuth2 server clients, their secrets and redirect URIs.
+ *
+ * This class is intended to be loaded through dependency injection:
+ *
+ *     $manager = \core\di::get(\core\oauth2\server\client_manager::class);
+ *
+ * @package    core
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class client_manager {
+    /** @var int The maximum number of active (non-revoked, non-expired) secrets a single client may have. */
+    public const int MAX_ACTIVE_SECRETS = 2;
+
+    /** @var int The default lifetime of a generated client secret, in seconds. */
+    public const int DEFAULT_SECRET_LIFETIME = YEARSECS;
+
+    /** @var string Clients table. */
+    protected const string TABLE_CLIENTS = 'oauth2_server_clients';
+
+    /** @var string Client secrets table. */
+    protected const string TABLE_SECRETS = 'oauth2_server_client_secrets';
+
+    /** @var string Client redirect URIs table. */
+    protected const string TABLE_REDIRECT_URIS = 'oauth2_server_client_redirect_uris';
+
+    /** @var string Access tokens table. */
+    protected const string TABLE_ACCESS_TOKENS = 'oauth2_server_client_access_tokens';
+
+    /** @var string Refresh tokens table. */
+    protected const string TABLE_REFRESH_TOKENS = 'oauth2_server_client_refresh_tokens';
+
+    /** @var string Authorisation codes table. */
+    protected const string TABLE_AUTH_CODES = 'oauth2_server_client_auth_codes';
+
+    /** @var string Granted scopes table. */
+    protected const string TABLE_GRANTED_SCOPES = 'oauth2_server_client_granted_scopes';
+
+    /**
+     * Constructor.
+     *
+     * @param \moodle_database $db The database instance.
+     * @param clock $clock The clock instance.
+     */
+    public function __construct(
+        /** @var \moodle_database The database instance */
+        protected readonly \moodle_database $db,
+        /** @var clock The clock instance */
+        protected readonly clock $clock,
+    ) {
+    }
+
+    // Clients.
+
+    /**
+     * Create a new client.
+     *
+     * @param string $name The human-readable name of the client.
+     * @param \core\context $ownercontext The context which owns the client.
+     * @param bool $isconfidential Whether the client is confidential (can securely store a secret).
+     * @param string|null $description An optional description.
+     * @param string[] $redirecturis The redirect URIs to register for the client.
+     * @return client_entity
+     */
+    public function create_client(
+        string $name,
+        \core\context $ownercontext,
+        bool $isconfidential = true,
+        ?string $description = null,
+        array $redirecturis = [],
+    ): client_entity {
+        // Validate all redirect URIs before creating anything.
+        foreach ($redirecturis as $uri) {
+            $this->require_valid_redirect_uri($uri);
+        }
+
+        $transaction = $this->db->start_delegated_transaction();
+
+        $record = (object) [
+            'name' => $name,
+            'description' => $description,
+            'clientidentifier' => $this->generate_client_identifier(),
+            'ownercontext' => $ownercontext->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'isconfidential' => (int) $isconfidential,
+            'timecreated' => $this->clock->time(),
+            'timemodified' => $this->clock->time(),
+        ];
+        $record->id = $this->db->insert_record(self::TABLE_CLIENTS, $record);
+
+        foreach (array_unique($redirecturis) as $uri) {
+            $this->db->insert_record(self::TABLE_REDIRECT_URIS, (object) [
+                'clientidentifier' => $record->clientidentifier,
+                'uri' => $uri,
+            ]);
+        }
+
+        $transaction->allow_commit();
+
+        return $this->get_client_by_id($record->id);
+    }
+
+    /**
+     * Fetch a client by its database ID.
+     *
+     * @param int $id The client ID.
+     * @return client_entity|null The client, or null if it does not exist.
+     */
+    public function get_client_by_id(int $id): ?client_entity {
+        $record = $this->db->get_record(self::TABLE_CLIENTS, ['id' => $id]);
+
+        return $record ? $this->create_entity($record) : null;
+    }
+
+    /**
+     * Fetch a client by its public client identifier.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return client_entity|null The client, or null if it does not exist.
+     */
+    public function get_client_by_identifier(string $clientidentifier): ?client_entity {
+        $record = $this->db->get_record(self::TABLE_CLIENTS, ['clientidentifier' => $clientidentifier]);
+
+        return $record ? $this->create_entity($record) : null;
+    }
+
+    /**
+     * Update the administrative metadata of a client.
+     *
+     * Only the name and description may be changed. Any other keys are ignored.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param array $updates Associative array of field => value (only 'name' and 'description' are honoured).
+     * @return client_entity The updated client.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function update_client(string $clientidentifier, array $updates): client_entity {
+        $record = $this->get_client_record($clientidentifier);
+
+        $allowedfields = ['name', 'description'];
+        $filteredupdates = array_intersect_key($updates, array_flip($allowedfields));
+
+        if (!empty($filteredupdates)) {
+            if (array_key_exists('name', $filteredupdates) && trim((string) $filteredupdates['name']) === '') {
+                throw new \core\exception\coding_exception('The OAuth2 client name cannot be empty');
+            }
+            foreach ($filteredupdates as $field => $value) {
+                $record->{$field} = $value;
+            }
+            $record->timemodified = $this->clock->time();
+            $this->db->update_record(self::TABLE_CLIENTS, $record);
+        }
+
+        return $this->create_entity($record);
+    }
+
+    /**
+     * Revoke a client.
+     *
+     * Revoking a client also immediately revokes all of its active secrets, access tokens, refresh tokens and
+     * authorisation codes, fully cutting off access.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function revoke_client(string $clientidentifier): void {
+        $record = $this->get_client_record($clientidentifier);
+
+        $transaction = $this->db->start_delegated_transaction();
+
+        $this->db->update_record(self::TABLE_CLIENTS, (object) [
+            'id' => $record->id,
+            'status' => client_entity::STATUS_REVOKED,
+            'timemodified' => $this->clock->time(),
+        ]);
+
+        // Revoke all secrets.
+        $this->db->set_field(
+            self::TABLE_SECRETS,
+            'revoked',
+            client_entity::SECRET_REVOKED_YES,
+            ['clientidentifier' => $clientidentifier],
+        );
+
+        // Revoke refresh tokens linked to this client's access tokens.
+        $this->db->set_field_select(
+            self::TABLE_REFRESH_TOKENS,
+            'revoked',
+            refresh_token_entity::REVOKED_YES,
+            'accesstokenidentifier IN (SELECT identifier FROM {' . self::TABLE_ACCESS_TOKENS . '}
+                                        WHERE clientidentifier = :clientidentifier)',
+            ['clientidentifier' => $clientidentifier],
+        );
+
+        // Revoke access tokens.
+        $this->db->set_field(
+            self::TABLE_ACCESS_TOKENS,
+            'revoked',
+            access_token_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier],
+        );
+
+        // Revoke authorisation codes.
+        $this->db->set_field(
+            self::TABLE_AUTH_CODES,
+            'revoked',
+            auth_code_entity::REVOKED_YES,
+            ['clientidentifier' => $clientidentifier],
+        );
+
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Reactivate a previously revoked client.
+     *
+     * Only the client record itself is restored. Previously revoked secrets and tokens remain revoked.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     */
+    public function reactivate_client(string $clientidentifier): void {
+        $record = $this->get_client_record($clientidentifier);
+
+        if ((int) $record->status === client_entity::STATUS_ACTIVE) {
+            return;
+        }
+
+        $this->db->update_record(self::TABLE_CLIENTS, (object) [
+            'id' => $record->id,
+            'status' => client_entity::STATUS_ACTIVE,
+            'timemodified' => $this->clock->time(),
+        ]);
+    }
+
+    /**
+     * Permanently delete a client and all associated data.
+     *
+     * The client must already be revoked.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     * @throws moodle_exception If the client has not been revoked.
+     */
+    public function delete_client(string $clientidentifier): void {
+        $record = $this->get_client_record($clientidentifier);
+
+        if ((int) $record->status !== client_entity::STATUS_REVOKED) {
+            throw new moodle_exception('oauth2clientnotrevoked', 'error');
+        }
+
+        $transaction = $this->db->start_delegated_transaction();
+
+        $params = ['clientidentifier' => $clientidentifier];
+
+        $this->db->delete_records_select(
+            self::TABLE_REFRESH_TOKENS,
+            'accesstokenidentifier IN (SELECT identifier FROM {' . self::TABLE_ACCESS_TOKENS . '}
+                                        WHERE clientidentifier = :clientidentifier)',
+            $params,
+        );
+        $this->db->delete_records(self::TABLE_ACCESS_TOKENS, $params);
+        $this->db->delete_records(self::TABLE_AUTH_CODES, $params);
+        $this->db->delete_records(self::TABLE_GRANTED_SCOPES, $params);
+        $this->db->delete_records(self::TABLE_SECRETS, $params);
+        $this->db->delete_records(self::TABLE_REDIRECT_URIS, $params);
+        $this->db->delete_records(self::TABLE_CLIENTS, ['id' => $record->id]);
+
+        $transaction->allow_commit();
+    }
+
+    // Secrets.
+
+    /**
+     * Generate a new secret for a client.
+     *
+     * The plain-text secret is returned only once; only its hash is stored. A client may have at most
+     * {@see self::MAX_ACTIVE_SECRETS} active (non-revoked, non-expired) secrets at any one time.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param int|null $expirytime The expiry timestamp of the secret. Defaults to now + {@see self::DEFAULT_SECRET_LIFETIME}.
+     * @return string The plain-text secret.
+     * @throws \dml_missing_record_exception If the client does not exist.
+     * @throws moodle_exception If the client already has the maximum number of active secrets.
+     */
+    public function generate_client_secret(string $clientidentifier, ?int $expirytime = null): string {
+        $record = $this->get_client_record($clientidentifier);
+        $now = $this->clock->time();
+
+        if ((int) $record->status !== client_entity::STATUS_ACTIVE) {
+            throw new \core\exception\coding_exception('Cannot generate a secret for a revoked OAuth2 client');
+        }
+
+        if ($expirytime !== null && $expirytime <= $now) {
+            throw new \core\exception\coding_exception('The OAuth2 client secret expiry time must be in the future');
+        }
+
+        if ($this->count_active_client_secrets($clientidentifier) >= self::MAX_ACTIVE_SECRETS) {
+            throw new moodle_exception('oauth2clientsecretlimit', 'error', '', self::MAX_ACTIVE_SECRETS);
+        }
+
+        $secret = bin2hex(random_bytes(32));
+
+        $this->db->insert_record(self::TABLE_SECRETS, (object) [
+            'clientidentifier' => $clientidentifier,
+            'secret' => password_hash($secret, PASSWORD_DEFAULT),
+            'expirytime' => $expirytime ?? ($now + self::DEFAULT_SECRET_LIFETIME),
+            'revoked' => client_entity::SECRET_REVOKED_NO,
+            'timecreated' => $now,
+        ]);
+
+        return $secret;
+    }
+
+    /**
+     * Fetch the secrets of a client.
+     *
+     * The hashed secret value is never returned.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param bool $includeinactive Whether to include revoked and expired secrets.
+     * @return \stdClass[] Secret records (id, clientidentifier, expirytime, revoked, timecreated, lastaccessed), keyed by id.
+     */
+    public function get_client_secrets(string $clientidentifier, bool $includeinactive = false): array {
+        $select = 'clientidentifier = :clientidentifier';
+        $params = ['clientidentifier' => $clientidentifier];
+
+        if (!$includeinactive) {
+            $select .= ' AND revoked = :revoked AND expirytime > :now';
+            $params['revoked'] = client_entity::SECRET_REVOKED_NO;
+            $params['now'] = $this->clock->time();
+        }
+
+        return $this->db->get_records_select(
+            self::TABLE_SECRETS,
+            $select,
+            $params,
+            'timecreated DESC, id DESC',
+            'id, clientidentifier, expirytime, revoked, timecreated, lastaccessed',
+        );
+    }
+
+    /**
+     * Count the active (non-revoked, non-expired) secrets of a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return int
+     */
+    public function count_active_client_secrets(string $clientidentifier): int {
+        return $this->db->count_records_select(
+            self::TABLE_SECRETS,
+            'clientidentifier = :clientidentifier AND revoked = :revoked AND expirytime > :now',
+            [
+                'clientidentifier' => $clientidentifier,
+                'revoked' => client_entity::SECRET_REVOKED_NO,
+                'now' => $this->clock->time(),
+            ],
+        );
+    }
+
+    /**
+     * Revoke a client secret.
+     *
+     * @param string $clientidentifier The client identifier the secret belongs to.
+     * @param int $secretid The secret ID.
+     * @throws \dml_missing_record_exception If the secret does not exist for the given client.
+     */
+    public function revoke_client_secret(string $clientidentifier, int $secretid): void {
+        $secret = $this->db->get_record(
+            self::TABLE_SECRETS,
+            ['id' => $secretid, 'clientidentifier' => $clientidentifier],
+            'id, revoked',
+            MUST_EXIST,
+        );
+
+        if ((int) $secret->revoked === client_entity::SECRET_REVOKED_YES) {
+            return;
+        }
+
+        $this->db->set_field(self::TABLE_SECRETS, 'revoked', client_entity::SECRET_REVOKED_YES, ['id' => $secret->id]);
+    }
+
+    // Redirect URIs.
+
+    /**
+     * Fetch the redirect URIs of a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return string[] The redirect URIs, keyed by record id.
+     */
+    public function get_redirect_uris(string $clientidentifier): array {
+        return $this->db->get_records_menu(
+            self::TABLE_REDIRECT_URIS,
+            ['clientidentifier' => $clientidentifier],
+            'id ASC',
+            'id, uri',
+        );
+    }
+
+    /**
+     * Add a redirect URI to a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The redirect URI.
+     * @return int The ID of the redirect URI record (an existing one if the URI is already registered).
+     * @throws \dml_missing_record_exception If the client does not exist.
+     * @throws moodle_exception If the redirect URI is not valid.
+     */
+    public function add_redirect_uri(string $clientidentifier, string $uri): int {
+        $this->get_client_record($clientidentifier);
+        $this->require_valid_redirect_uri($uri);
+
+        $existing = array_search($uri, $this->get_redirect_uris($clientidentifier), true);
+        if ($existing !== false) {
+            return (int) $existing;
+        }
+
+        return $this->db->insert_record(self::TABLE_REDIRECT_URIS, (object) [
+            'clientidentifier' => $clientidentifier,
+            'uri' => $uri,
+        ]);
+    }
+
+    /**
+     * Remove a redirect URI from a client.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The redirect URI to remove (exact match).
+     * @return bool True if a redirect URI was removed.
+     */
+    public function remove_redirect_uri(string $clientidentifier, string $uri): bool {
+        $ids = array_keys($this->get_redirect_uris($clientidentifier), $uri, true);
+
+        if (empty($ids)) {
+            return false;
+        }
+
+        $this->db->delete_records_list(self::TABLE_REDIRECT_URIS, 'id', $ids);
+
+        return true;
+    }
+
+    /**
+     * Validate a redirect URI supplied in a request against those registered for a client.
+     *
+     * The URI must exactly match (no prefix or wildcard matching) one of the registered URIs and must itself be
+     * a valid redirect URI (HTTPS, or a loopback address).
+     *
+     * @param string $clientidentifier The client identifier.
+     * @param string $uri The redirect URI to validate.
+     * @return bool
+     */
+    public function validate_redirect_uri(string $clientidentifier, string $uri): bool {
+        if (!$this->is_valid_redirect_uri($uri)) {
+            return false;
+        }
+
+        return in_array($uri, $this->get_redirect_uris($clientidentifier), true);
+    }
+
+    /**
+     * Check whether a URI is acceptable as a redirect URI.
+     *
+     * The URI must be absolute, must not contain a fragment, and must use HTTPS unless its host is a
+     * loopback address (localhost, 127.0.0.0/8 or ::1), in which case HTTP is also permitted.
+     *
+     * @param string $uri The URI.
+     * @return bool
+     */
+    public function is_valid_redirect_uri(string $uri): bool {
+        if ($uri === '' || $uri !== trim($uri) || preg_match('/[\s\x00-\x1f\x7f]/', $uri)) {
+            return false;
+        }
+
+        $parts = parse_url($uri);
+        if ($parts === false || empty($parts['scheme']) || empty($parts['host'])) {
+            return false;
+        }
+
+        // Fragments are not permitted in redirect URIs (RFC 6749 section 3.1.2).
+        if (str_contains($uri, '#')) {
+            return false;
+        }
+
+        // Credentials in the URI are not permitted.
+        if (isset($parts['user']) || isset($parts['pass'])) {
+            return false;
+        }
+
+        $scheme = strtolower($parts['scheme']);
+        if ($scheme === 'https') {
+            return true;
+        }
+
+        return $scheme === 'http' && $this->is_loopback_host($parts['host']);
+    }
+
+    // Internal helpers.
+
+    /**
+     * Throw an exception if the redirect URI is not valid.
+     *
+     * @param string $uri The URI.
+     * @throws moodle_exception
+     */
+    protected function require_valid_redirect_uri(string $uri): void {
+        if (!$this->is_valid_redirect_uri($uri)) {
+            throw new moodle_exception('oauth2invalidredirecturi', 'error', '', s($uri));
+        }
+    }
+
+    /**
+     * Whether the given host is a loopback address.
+     *
+     * @param string $host The host as returned by parse_url().
+     * @return bool
+     */
+    protected function is_loopback_host(string $host): bool {
+        $host = strtolower(trim($host, '[]'));
+
+        if ($host === 'localhost') {
+            return true;
+        }
+
+        if (filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
+            return str_starts_with($host, '127.');
+        }
+
+        if (filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
+            return inet_pton($host) === inet_pton('::1');
+        }
+
+        return false;
+    }
+
+    /**
+     * Fetch a client record or throw.
+     *
+     * @param string $clientidentifier The client identifier.
+     * @return \stdClass
+     * @throws \dml_missing_record_exception
+     */
+    protected function get_client_record(string $clientidentifier): \stdClass {
+        return $this->db->get_record(self::TABLE_CLIENTS, ['clientidentifier' => $clientidentifier], '*', MUST_EXIST);
+    }
+
+    /**
+     * Build a client entity from a record.
+     *
+     * @param \stdClass $record The client record.
+     * @return client_entity
+     */
+    protected function create_entity(\stdClass $record): client_entity {
+        $urirecords = $this->db->get_records(
+            self::TABLE_REDIRECT_URIS,
+            ['clientidentifier' => $record->clientidentifier],
+            'id ASC',
+        );
+
+        return client_entity::create_from_record($record, $urirecords);
+    }
+
+    /**
+     * Generate a new, unique client identifier.
+     *
+     * @return string
+     */
+    protected function generate_client_identifier(): string {
+        do {
+            $identifier = bin2hex(random_bytes(16));
+        } while ($this->db->record_exists(self::TABLE_CLIENTS, ['clientidentifier' => $identifier]));
+
+        return $identifier;
+    }
+}
diff --git a/public/lib/classes/oauth2/server/entity/client_entity.php b/public/lib/classes/oauth2/server/entity/client_entity.php
index c29a4e98bba..e80ed3b6e59 100644
--- a/public/lib/classes/oauth2/server/entity/client_entity.php
+++ b/public/lib/classes/oauth2/server/entity/client_entity.php
@@ -45,6 +45,9 @@ class client_entity implements ClientEntityInterface {
     /** @var int Client secret is revoked */
     public const int SECRET_REVOKED_YES = 1;
 
+    /** @var int|null The database ID of the client */
+    protected ?int $id = null;
+
