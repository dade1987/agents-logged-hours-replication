+    protected function insert_tokens(string $clientidentifier, string $suffix = '1'): void {
+        global $DB;
+        $user = $this->getDataGenerator()->create_user();
+        $DB->insert_record('oauth2_server_client_access_tokens', (object) [
+            'identifier' => "access-{$suffix}",
