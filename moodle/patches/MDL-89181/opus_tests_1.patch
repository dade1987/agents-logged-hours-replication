+    public function test_generate_client_secret_limit(): void {
+        global $DB;
+        $this->resetAfterTest();
+        $clock = $this->mock_clock_with_frozen();
+
+        $manager = $this->get_manager();
+        $client = $this->create_client();
+        $other = $this->create_client();
+        $id = $client->getIdentifier();
+
+        $secret1 = $manager->generate_client_secret($id);
+        $secret2 = $manager->generate_client_secret($id);
+        $this->assertNotSame($secret1, $secret2);
+        $this->assertSame(2, $manager->count_active_client_secrets($id));
+
+        $records = $DB->get_records('oauth2_server_client_secrets', ['clientidentifier' => $id]);
+        foreach ($records as $record) {
+            $this->assertNotSame($secret1, $record->secret);
+            $this->assertEquals($clock->time() + client_manager::DEFAULT_SECRET_LIFETIME, $record->expirytime);
+        }
+
+        // Third active secret is rejected.
+        try {
+            $manager->generate_client_secret($id);
+            $this->fail('Exception expected');
+        } catch (\moodle_exception $e) {
+            $this->assertSame('oauth2clientsecretlimit', $e->errorcode);
+        }
+
+        // Limit is per client.
+        $manager->generate_client_secret($other->getIdentifier());
+        $manager->generate_client_secret($other->getIdentifier());
+
+        // Revoking one frees up a slot.
+        $secrets = $manager->get_client_secrets($id);
+        $this->assertCount(2, $secrets);
+        $this->assertObjectNotHasProperty('secret', reset($secrets));
+        $manager->revoke_client_secret($id, reset($secrets)->id);
+        $this->assertSame(1, $manager->count_active_client_secrets($id));
+        $this->assertCount(1, $manager->get_client_secrets($id));
+        $this->assertCount(2, $manager->get_client_secrets($id, true));
+        $manager->generate_client_secret($id);
+
+        // Expired secrets do not count.
+        $clock->bump(client_manager::DEFAULT_SECRET_LIFETIME + 1);
+        $this->assertSame(0, $manager->count_active_client_secrets($id));
+        $manager->generate_client_secret($id, $clock->time() + DAYSECS);
+        $manager->generate_client_secret($id);
+        $this->assertSame(2, $manager->count_active_client_secrets($id));
+    }
