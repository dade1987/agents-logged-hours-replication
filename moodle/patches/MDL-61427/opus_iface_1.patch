     /**
      * Move questions and then delete the category.
      *
+     * If $questionids is empty, all the questions in the old category are moved to the new category.
+     * Otherwise, only the given questions are moved to the new category, and all the other questions
+     * left in the old category are deleted. Any question that cannot be deleted (for example because it
+     * is still in use) is moved to the new category instead, so that no question is ever lost.
+     *
      * @param int $oldcat id of the old category.
      * @param int $newcat id of the new category.
+     * @param int[] $questionids ids of the questions to move. If empty, all questions are moved.
      */
-    public function move_questions_and_delete_category(int $oldcat, int $newcat): void {
+    public function move_questions_and_delete_category(int $oldcat, int $newcat, array $questionids = []): void {
         global $DB;
         $transaction = $DB->start_delegated_transaction();
         $this->require_can_delete_category($oldcat);
-        $this->move_questions($oldcat, $newcat);
+        if (empty($questionids)) {
+            $this->move_questions($oldcat, $newcat);
+        } else {
+            $this->move_questions($oldcat, $newcat, $questionids);
+            $this->delete_questions_in_category($oldcat);
+            // Anything which could not be deleted must still be kept, so move it.
+            if ($this->get_real_question_ids_in_category($oldcat)) {
+                $this->move_questions($oldcat, $newcat);
+            }
+        }
+        $this->delete_category($oldcat);
+        $transaction->allow_commit();
+    }
+
+    /**
+     * Delete all the questions in a category which are not in use, then delete the category.
+     *
+     * If some questions are in use, they are moved to $newcat (which must then be given),
+     * otherwise an exception is thrown.
+     *
+     * @param int $oldcat id of the category to delete.
+     * @param int|null $newcat id of the category to move in-use questions to, if there are any.
+     * @throws moodle_exception if questions are in use and no new category is given.
+     */
+    public function delete_questions_and_category(int $oldcat, ?int $newcat = null): void {
+        global $DB;
+        $this->require_can_delete_category($oldcat);
+        $inuse = $this->get_in_use_question_ids_in_category($oldcat);
+        if ($inuse) {
+            if (empty($newcat)) {
+                throw new moodle_exception('categoryquestionsinuse', 'question');
+            }
+            $this->move_questions_and_delete_category($oldcat, $newcat, $inuse);
+            return;
+        }
+
+        $transaction = $DB->start_delegated_transaction();
+        $this->delete_questions_in_category($oldcat);
+        if ($this->get_real_question_ids_in_category($oldcat)) {
+            if (empty($newcat)) {
+                throw new moodle_exception('categoryquestionsinuse', 'question');
+            }
+            $this->move_questions($oldcat, $newcat);
+        }
         $this->delete_category($oldcat);
         $transaction->allow_commit();
     }
 
+    /**
+     * Delete all the questions in a category which are not in use.
+     *
+     * Questions that are in use are not deleted (see {@see question_delete_question()}).
+     *
+     * @param int $categoryid id of the category.
+     */
+    protected function delete_questions_in_category(int $categoryid): void {
+        global $CFG;
+        require_once($CFG->libdir . '/questionlib.php');
+        $inuse = array_flip($this->get_in_use_question_ids_in_category($categoryid));
+        foreach ($this->get_real_question_ids_in_category($categoryid) as $questionid) {
+            if (isset($inuse[$questionid])) {
+                continue;
+            }
+            question_require_capability_on($questionid, 'edit');
+            question_delete_question($questionid);
+        }
+    }
+
+    /**
+     * Returns the ids of the questions in the given category which are in use.
+     *
+     * Only real questions are considered (not subquestions of question types like multianswer).
+     *
+     * @param int $categoryid id of the category.
+     * @return int[] array of question ids which are in use.
+     */
+    public function get_in_use_question_ids_in_category(int $categoryid): array {
+        global $CFG;
+        require_once($CFG->libdir . '/questionlib.php');
+        $inuse = [];
+        foreach ($this->get_real_question_ids_in_category($categoryid) as $questionid) {
+            if (questions_in_use([$questionid])) {
+                $inuse[] = (int) $questionid;
+            }
+        }
+        return $inuse;
+    }
+
     /**
