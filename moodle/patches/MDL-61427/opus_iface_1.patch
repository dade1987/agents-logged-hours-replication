+        $unused1 = $questiongenerator->create_question('shortanswer', null, ['category' => $oldcat->id]);
+        $unused2 = $questiongenerator->create_question('truefalse', null, ['category' => $oldcat->id]);
+        $used = $questiongenerator->create_question('shortanswer', null, ['category' => $oldcat->id]);
+        quiz_add_quiz_question($used->id, $quiz);
