diff --git a/public/question/classes/category_manager.php b/public/question/classes/category_manager.php
index 3dbb4696085..f91e5a39b5f 100644
--- a/public/question/classes/category_manager.php
+++ b/public/question/classes/category_manager.php
@@ -75,6 +75,83 @@ class category_manager {
         $transaction->allow_commit();
     }
 
+    /**
+     * Check whether any of the questions in the given category are currently in use.
+     *
+     * Questions that are in use (e.g. by a quiz) cannot be deleted, so a category containing
+     * such questions can only be deleted after its questions have been moved elsewhere.
+     *
+     * @param int $categoryid id of the category.
+     * @return bool true if at least one question in the category is in use.
+     */
+    public function questions_in_category_in_use(int $categoryid): bool {
+        global $CFG;
+        require_once($CFG->libdir . '/questionlib.php');
+        $questionids = $this->get_real_question_ids_in_category($categoryid);
+        if (empty($questionids)) {
+            return false;
+        }
+        return questions_in_use($questionids);
+    }
+
+    /**
+     * Check whether the current user may delete the given category together with all the questions it contains.
+     *
+     * This is only possible if the user is allowed to delete the category, none of the questions
+     * in the category are in use, and the user has permission to edit (delete) every question in it.
+     *
+     * @param int $categoryid id of the category.
+     * @return bool
+     */
+    public function can_delete_category_with_questions(int $categoryid): bool {
+        global $CFG;
+        require_once($CFG->libdir . '/questionlib.php');
+        try {
+            $this->require_can_delete_category($categoryid);
+        } catch (moodle_exception $e) {
+            return false;
+        }
+        if ($this->questions_in_category_in_use($categoryid)) {
+            return false;
+        }
+        foreach ($this->get_real_question_ids_in_category($categoryid) as $questionid) {
+            if (!question_has_capability_on($questionid, 'edit')) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /**
+     * Delete all the questions in a category, and then delete the category itself.
+     *
+     * This will refuse to do anything if any of the questions in the category are in use,
+     * or if the user does not have permission to delete the category or its questions.
+     *
+     * @param int $categoryid id of the category to delete.
+     * @throws moodle_exception if the category cannot be deleted along with its questions.
+     */
+    public function delete_questions_and_delete_category(int $categoryid): void {
+        global $DB, $CFG;
+        require_once($CFG->libdir . '/questionlib.php');
+
+        $this->require_can_delete_category($categoryid);
+        if ($this->questions_in_category_in_use($categoryid)) {
+            throw new moodle_exception('cannotdeletecategoryquestionsinuse', 'question');
+        }
+        $questionids = $this->get_real_question_ids_in_category($categoryid);
+        foreach ($questionids as $questionid) {
+            question_require_capability_on($questionid, 'edit');
+        }
+
+        $transaction = $DB->start_delegated_transaction();
+        foreach ($questionids as $questionid) {
+            question_delete_question($questionid);
+        }
+        $this->delete_category($categoryid);
+        $transaction->allow_commit();
+    }
+
     /**
      * Checks whether the category is a "Top" category (with no parent).
      *
diff --git a/public/question/tests/category_manager_test.php b/public/question/tests/category_manager_test.php
index 3fb830c9ae2..5c2613d082d 100644
--- a/public/question/tests/category_manager_test.php
+++ b/public/question/tests/category_manager_test.php
@@ -576,6 +576,117 @@ final class category_manager_test extends \advanced_testcase {
         $manager->require_can_delete_category($qcategory2->id);
     }
 
+    /**
+     * Test deleting a category along with the questions it contains.
+     */
+    public function test_delete_questions_and_delete_category(): void {
+        global $DB;
+        $this->setAdminUser();
+        $this->resetAfterTest();
+
+        $context = $this->create_course_and_get_qbank_context();
+        $questiongenerator = $this->getDataGenerator()->get_plugin_generator('core_question');
+        $qcategory1 = $questiongenerator->create_question_category(['contextid' => $context->id]);
+        $qcategory2 = $questiongenerator->create_question_category(['contextid' => $context->id, 'parent' => $qcategory1->id]);
+        $qcategory3 = $questiongenerator->create_question_category(['contextid' => $context->id, 'parent' => $qcategory2->id]);
+
+        $countq = $DB->count_records('question');
+        $countqbe = $DB->count_records('question_bank_entries');
+
+        // Two questions in the category to delete, one of them with two versions, plus a multianswer question.
+        $shortanswer = $questiongenerator->create_question('shortanswer', null, ['category' => $qcategory2->id]);
+        $questiongenerator->update_question($shortanswer, null, ['name' => 'New version']);
+        $questiongenerator->create_question('multianswer', null, ['category' => $qcategory2->id]);
+        // A question in another category, which must not be touched.
+        $other = $questiongenerator->create_question('shortanswer', null, ['category' => $qcategory1->id]);
+
+        $manager = new category_manager();
+        $this->assertFalse($manager->questions_in_category_in_use($qcategory2->id));
+        $this->assertTrue($manager->can_delete_category_with_questions($qcategory2->id));
+
+        $sink = $this->redirectEvents();
+        $manager->delete_questions_and_delete_category($qcategory2->id);
+        $events = $sink->get_events();
+
+        // The category is gone, its child category now belongs to the grandparent.
+        $this->assertFalse($DB->record_exists('question_categories', ['id' => $qcategory2->id]));
+        $this->assertEquals($qcategory1->id, $DB->get_field('question_categories', 'parent', ['id' => $qcategory3->id]));
+
+        // All the questions in the category (including versions and child questions) are deleted.
+        $this->assertEmpty($manager->get_real_question_ids_in_category($qcategory2->id));
+        $this->assertEquals(1, $DB->count_records('question') - $countq);
+        $this->assertEquals(1, $DB->count_records('question_bank_entries') - $countqbe);
+        $this->assertTrue($DB->record_exists('question', ['id' => $other->id]));
+
+        // Events were triggered for the questions and for the category.
+        $deletedevents = array_filter($events, fn($event) => $event instanceof \core\event\question_deleted);
+        $this->assertCount(5, $deletedevents);
+        $categoryevents = array_filter($events, fn($event) => $event instanceof \core\event\question_category_deleted);
+        $this->assertCount(1, $categoryevents);
+        $this->assertEquals($qcategory2->id, reset($categoryevents)->objectid);
+    }
+
+    /**
+     * Test that a category cannot be deleted along with its questions if any of them are in use.
+     */
+    public function test_delete_questions_and_delete_category_questions_in_use(): void {
+        global $DB;
+        $this->setAdminUser();
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course();
+        $quiz = $this->getDataGenerator()->create_module('quiz', ['course' => $course->id]);
+        $context = $this->create_course_and_get_qbank_context();
+        $questiongenerator = $this->getDataGenerator()->get_plugin_generator('core_question');
+        $qcategory1 = $questiongenerator->create_question_category(['contextid' => $context->id]);
+        $qcategory2 = $questiongenerator->create_question_category(['contextid' => $context->id, 'parent' => $qcategory1->id]);
+
+        $question1 = $questiongenerator->create_question('shortanswer', null, ['category' => $qcategory2->id]);
+        $question2 = $questiongenerator->create_question('shortanswer', null, ['category' => $qcategory2->id]);
+        quiz_add_quiz_question($question1->id, $quiz);
+
+        $manager = new category_manager();
+        $this->assertTrue($manager->questions_in_category_in_use($qcategory2->id));
+        $this->assertFalse($manager->can_delete_category_with_questions($qcategory2->id));
+
+        try {
+            $manager->delete_questions_and_delete_category($qcategory2->id);
+            $this->fail('Expected exception not thrown.');
+        } catch (\moodle_exception $e) {
+            $this->assertEquals(get_string('cannotdeletecategoryquestionsinuse', 'question'), $e->getMessage());
+        }
+
+        // Nothing was deleted.
+        $this->assertTrue($DB->record_exists('question_categories', ['id' => $qcategory2->id]));
+        $this->assertTrue($DB->record_exists('question', ['id' => $question1->id]));
+        $this->assertTrue($DB->record_exists('question', ['id' => $question2->id]));
+    }
+
+    /**
+     * Test that a user without permission cannot delete a category along with its questions.
+     */
+    public function test_delete_questions_and_delete_category_capability(): void {
+        global $DB;
+        $this->setAdminUser();
+        $this->resetAfterTest();
+
+        $context = $this->create_course_and_get_qbank_context();
+        $questiongenerator = $this->getDataGenerator()->get_plugin_generator('core_question');
+        $qcategory1 = $questiongenerator->create_question_category(['contextid' => $context->id]);
+        $qcategory2 = $questiongenerator->create_question_category(['contextid' => $context->id, 'parent' => $qcategory1->id]);
+        $question = $questiongenerator->create_question('shortanswer', null, ['category' => $qcategory2->id]);
+
+        $user = $this->getDataGenerator()->create_user();
+        $this->setUser($user);
+
+        $manager = new category_manager();
+        $this->assertFalse($manager->can_delete_category_with_questions($qcategory2->id));
+
+        $this->expectException(\required_capability_exception::class);
+        $manager->delete_questions_and_delete_category($qcategory2->id);
+        $this->assertTrue($DB->record_exists('question', ['id' => $question->id]));
+    }
+
