diff --git a/public/question/classes/category_manager.php b/public/question/classes/category_manager.php
index 3dbb4696085..6c4e33e0150 100644
--- a/public/question/classes/category_manager.php
+++ b/public/question/classes/category_manager.php
@@ -75,6 +75,30 @@ class category_manager {
         $transaction->allow_commit();
     }
 
+    /**
+     * Delete all the questions in a category and then delete the category.
+     *
+     * This is only allowed if none of the questions in the category are in use.
+     *
+     * @param int $categoryid id of the category to delete.
+     * @throws moodle_exception If any question in the category is in use.
+     */
+    public function delete_questions_and_delete_category(int $categoryid): void {
+        global $DB, $CFG;
+        require_once($CFG->libdir . '/questionlib.php');
+        $this->require_can_delete_category($categoryid);
+        $transaction = $DB->start_delegated_transaction();
+        $questionids = $this->get_real_question_ids_in_category($categoryid);
+        if ($questionids && questions_in_use($questionids)) {
+            throw new moodle_exception('cannotdeletecategoryquestionsinuse', 'question');
+        }
+        foreach ($questionids as $questionid) {
+            question_delete_question($questionid);
+        }
+        $this->delete_category($categoryid);
+        $transaction->allow_commit();
+    }
+
