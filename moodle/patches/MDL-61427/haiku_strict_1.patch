diff --git a/public/question/classes/category_manager.php b/public/question/classes/category_manager.php
index 3dbb4696085..a71478b2c80 100644
--- a/public/question/classes/category_manager.php
+++ b/public/question/classes/category_manager.php
@@ -60,6 +60,34 @@ class category_manager {
         $transaction->allow_commit();
     }
 
+    /**
+     * Delete a question category together with the questions it contains.
+     *
+     * Nothing is deleted if any question in the category is in use (for example, used in a quiz).
+     * Those questions must be moved to another category first, using move_questions_and_delete_category().
+     *
+     * @param int $categoryid id of category to delete.
+     * @throws moodle_exception if any question in the category is in use.
+     */
+    public function delete_category_and_questions(int $categoryid): void {
+        global $DB, $CFG;
+        require_once($CFG->libdir . '/questionlib.php');
+
+        $this->require_can_delete_category($categoryid);
+        $questionids = $this->get_real_question_ids_in_category($categoryid);
+        if ($questionids && questions_in_use($questionids)) {
+            throw new moodle_exception('cannotdeletecatwithusedquestions', 'question');
+        }
+
+        $transaction = $DB->start_delegated_transaction();
+        foreach ($questionids as $questionid) {
+            question_require_capability_on($questionid, 'edit');
+            question_delete_question($questionid);
+        }
+        $this->delete_category($categoryid);
+        $transaction->allow_commit();
+    }
+
     /**
      * Move questions and then delete the category.
      *
diff --git a/public/question/tests/category_manager_test.php b/public/question/tests/category_manager_test.php
index 3fb830c9ae2..09b0fd5ace7 100644
--- a/public/question/tests/category_manager_test.php
+++ b/public/question/tests/category_manager_test.php
@@ -666,4 +666,32 @@ final class category_manager_test extends \advanced_testcase {
         $this->assertEquals($quiz2top->id, $DB->get_field('question_categories', 'parent', ['id' => $quiz2nontop->id]));
         $this->assertEquals($qbank2top->id, $DB->get_field('question_categories', 'parent', ['id' => $qbank2nontop->id]));
     }
+
+    /**
+     * Test that delete_category_and_questions() deletes the category and the unused questions in it.
+     *
+     * @covers ::delete_category_and_questions
+     */
+    public function test_delete_category_and_questions(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course();
+        $quiz = $generator->create_module('quiz', ['course' => $course->id]);
+        $contexts = new question_edit_contexts(context_module::instance($quiz->cmid));
+        $questiongenerator = $generator->get_plugin_generator('core_question');
+
+        $topcat = question_get_top_category($contexts->lowest()->id, true);
+        $category = $questiongenerator->create_question_category(['contextid' => $contexts->lowest()->id,
+            'parent' => $topcat->id]);
+        $question = $questiongenerator->create_question('shortanswer', null, ['category' => $category->id]);
+
+        $manager = new category_manager();
+        $manager->delete_category_and_questions($category->id);
+
+        $this->assertFalse($DB->record_exists('question_categories', ['id' => $category->id]));
+        $this->assertFalse($DB->record_exists('question', ['id' => $question->id]));
+    }
 }
