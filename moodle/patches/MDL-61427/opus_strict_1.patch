diff --git a/public/question/classes/category_manager.php b/public/question/classes/category_manager.php
index 3dbb4696085..dbd4822a4da 100644
--- a/public/question/classes/category_manager.php
+++ b/public/question/classes/category_manager.php
@@ -75,6 +75,64 @@ class category_manager {
         $transaction->allow_commit();
     }
 
+    /**
+     * Can the questions in this category be deleted together with the category?
+     *
+     * This is only possible if none of the questions in the category is in use
+     * (for example in a quiz), and the current user is allowed to edit (and so delete)
+     * every question in the category.
+     *
+     * @param int $categoryid id of the category.
+     * @return bool
+     */
+    public function can_delete_questions_in_category(int $categoryid): bool {
+        global $CFG;
+        require_once($CFG->libdir . '/questionlib.php');
+
+        $questionids = $this->get_real_question_ids_in_category($categoryid);
+        if (empty($questionids)) {
+            return true;
+        }
+        if (questions_in_use($questionids)) {
+            return false;
+        }
+        foreach ($questionids as $questionid) {
+            if (!question_has_capability_on($questionid, 'edit')) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /**
+     * Delete all the questions in a category, and then delete the category.
+     *
+     * This is only allowed if none of the questions are in use, and the user can edit all of them.
+     *
+     * @param int $categoryid id of the category to delete.
+     * @throws moodle_exception if the questions cannot be deleted.
+     */
+    public function delete_questions_and_category(int $categoryid): void {
+        global $CFG, $DB;
+        require_once($CFG->libdir . '/questionlib.php');
+
+        $this->require_can_delete_category($categoryid);
+        if (!$this->can_delete_questions_in_category($categoryid)) {
+            throw new moodle_exception('cannotdeletecategoryquestions', 'question');
+        }
+
+        $transaction = $DB->start_delegated_transaction();
+        foreach ($this->get_real_question_ids_in_category($categoryid) as $questionid) {
+            question_delete_question($questionid);
+        }
+        if ($DB->record_exists('question_bank_entries', ['questioncategoryid' => $categoryid])) {
+            // Something prevented a question from being deleted. Do not lose it.
+            throw new moodle_exception('cannotdeletecategoryquestions', 'question');
+        }
+        $this->delete_category($categoryid);
+        $transaction->allow_commit();
+    }
+
