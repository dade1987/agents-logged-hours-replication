      * Checks whether the category is a "Top" category (with no parent).
      *
diff --git a/public/question/tests/category_manager_test.php b/public/question/tests/category_manager_test.php
index 3fb830c9ae2..6f0f268b2b1 100644
--- a/public/question/tests/category_manager_test.php
+++ b/public/question/tests/category_manager_test.php
@@ -576,6 +576,70 @@ final class category_manager_test extends \advanced_testcase {
         $manager->require_can_delete_category($qcategory2->id);
     }
 
+    /**
+     * Test deleting a category along with its questions when none are in use.
+     */
+    public function test_delete_questions_and_category(): void {
+        global $DB;
+        $this->setAdminUser();
+        $this->resetAfterTest();
+
+        $context = $this->create_course_and_get_qbank_context();
+        $topcat = question_get_top_category($context->id, true);
+        $questiongenerator = $this->getDataGenerator()->get_plugin_generator('core_question');
+        $defaultcat = $questiongenerator->create_question_category(['contextid' => $context->id, 'parent' => $topcat->id]);
+        $category = $questiongenerator->create_question_category(['contextid' => $context->id, 'parent' => $topcat->id]);
+        $q1 = $questiongenerator->create_question('shortanswer', null, ['category' => $category->id]);
+        $q2 = $questiongenerator->create_question('multianswer', null, ['category' => $category->id]);
+
+        $manager = new category_manager();
+        $this->assertTrue($manager->can_delete_questions_in_category($category->id));
+        $manager->delete_questions_and_category($category->id);
+
+        $this->assertFalse($DB->record_exists('question_categories', ['id' => $category->id]));
+        $this->assertFalse($DB->record_exists('question', ['id' => $q1->id]));
+        $this->assertFalse($DB->record_exists('question', ['id' => $q2->id]));
+        $this->assertFalse($DB->record_exists('question', ['parent' => $q2->id]));
+        $this->assertFalse($DB->record_exists('question_bank_entries', ['questioncategoryid' => $category->id]));
+        $this->assertTrue($DB->record_exists('question_categories', ['id' => $defaultcat->id]));
+    }
+
+    /**
+     * Questions that are in use can not be deleted along with the category.
+     */
+    public function test_delete_questions_and_category_in_use(): void {
+        global $CFG, $DB;
+        require_once($CFG->dirroot . '/mod/quiz/locallib.php');
+        $this->setAdminUser();
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course();
+        $qbank = $this->getDataGenerator()->create_module('qbank', ['course' => $course->id]);
+        $context = context_module::instance($qbank->cmid);
+        $topcat = question_get_top_category($context->id, true);
+        $questiongenerator = $this->getDataGenerator()->get_plugin_generator('core_question');
+        $questiongenerator->create_question_category(['contextid' => $context->id, 'parent' => $topcat->id]);
+        $category = $questiongenerator->create_question_category(['contextid' => $context->id, 'parent' => $topcat->id]);
+        $q1 = $questiongenerator->create_question('shortanswer', null, ['category' => $category->id]);
+        $q2 = $questiongenerator->create_question('shortanswer', null, ['category' => $category->id]);
+        $quiz = $this->getDataGenerator()->create_module('quiz', ['course' => $course->id]);
+        quiz_add_quiz_question($q1->id, $quiz);
+
+        $manager = new category_manager();
+        $this->assertFalse($manager->can_delete_questions_in_category($category->id));
+        try {
+            $manager->delete_questions_and_category($category->id);
+            $this->fail('Expected exception not thrown.');
+        } catch (\moodle_exception $e) {
+            $this->assertEquals('cannotdeletecategoryquestions', $e->errorcode);
+        }
+
+        // Nothing should have been deleted.
+        $this->assertTrue($DB->record_exists('question_categories', ['id' => $category->id]));
+        $this->assertTrue($DB->record_exists('question', ['id' => $q1->id]));
+        $this->assertTrue($DB->record_exists('question', ['id' => $q2->id]));
+    }
+
