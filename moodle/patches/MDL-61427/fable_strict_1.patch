+            $mform->addElement('hidden', 'action', self::ACTION_MOVE);
+        }
+        $mform->setType('action', PARAM_ALPHA);
 
         $mform->addElement('questioncategory', 'category', get_string('category', 'question'), compact('contexts', 'currentcat'));
+        if ($candeletequestions) {
