diff --git a/public/question/classes/category_manager.php b/public/question/classes/category_manager.php
index 3dbb4696085..6d90ef206df 100644
--- a/public/question/classes/category_manager.php
+++ b/public/question/classes/category_manager.php
@@ -75,6 +75,53 @@ class category_manager {
         $transaction->allow_commit();
     }
 
+    /**
+     * Check whether any of the questions in the given category are currently in use.
+     *
+     * Questions that are in use (e.g. by a quiz) cannot be deleted, so a category containing
+     * such questions can only be deleted if the questions are moved elsewhere first.
+     *
+     * @param int $categoryid id of the category.
+     * @return bool true if at least one question in the category is in use.
+     */
+    public function category_has_questions_in_use(int $categoryid): bool {
+        global $CFG;
+        require_once($CFG->libdir . '/questionlib.php');
+
+        $questionids = $this->get_real_question_ids_in_category($categoryid);
+        if (empty($questionids)) {
+            return false;
+        }
+        return questions_in_use($questionids);
+    }
+
+    /**
+     * Delete all the questions in a category, and then delete the category itself.
+     *
+     * This is only allowed if none of the questions in the category are in use. If any of them are,
+     * a moodle_exception is thrown and nothing is deleted, so the questions must be moved to another
+     * category instead (see {@see self::move_questions_and_delete_category()}).
+     *
+     * @param int $categoryid id of the category to delete.
+     * @throws moodle_exception if any of the questions in the category are in use.
+     */
+    public function delete_questions_and_category(int $categoryid): void {
+        global $DB, $CFG;
+        require_once($CFG->libdir . '/questionlib.php');
+
+        $this->require_can_delete_category($categoryid);
+        if ($this->category_has_questions_in_use($categoryid)) {
+            throw new moodle_exception('cannotdeletecategoryquestionsinuse', 'question');
+        }
+
+        $transaction = $DB->start_delegated_transaction();
+        foreach ($this->get_real_question_ids_in_category($categoryid) as $questionid) {
+            question_delete_question($questionid);
+        }
+        $this->delete_category($categoryid);
+        $transaction->allow_commit();
+    }
+
     /**
      * Checks whether the category is a "Top" category (with no parent).
      *
diff --git a/public/question/tests/category_manager_test.php b/public/question/tests/category_manager_test.php
index 3fb830c9ae2..994716c70de 100644
--- a/public/question/tests/category_manager_test.php
+++ b/public/question/tests/category_manager_test.php
@@ -340,6 +340,97 @@ final class category_manager_test extends \advanced_testcase {
         $this->assertDebuggingNotCalled();
     }
 
+    /**
+     * Test deleting a category along with the questions it contains.
+     */
+    public function test_delete_questions_and_category(): void {
+        global $DB;
+        $this->setAdminUser();
+        $this->resetAfterTest();
+        $generator = $this->getDataGenerator();
+        $context = $this->create_course_and_get_qbank_context();
+        $defaultcat = question_get_default_category($context->id, true);
+        $questiongenerator = $generator->get_plugin_generator('core_question');
+        $category = $questiongenerator->create_question_category([
+            'contextid' => $context->id,
+            'name' => 'Category to delete',
+            'parent' => $defaultcat->id,
+        ]);
+        $child = $questiongenerator->create_question_category([
+            'contextid' => $context->id,
+            'name' => 'Child category',
+            'parent' => $category->id,
+        ]);
+        $shortanswer = $questiongenerator->create_question('shortanswer', null, ['category' => $category->id]);
+        $multianswer = $questiongenerator->create_question('multianswer', null, ['category' => $category->id]);
+        $otherquestion = $questiongenerator->create_question('shortanswer', null, ['category' => $defaultcat->id]);
+
+        $manager = new category_manager();
+        $this->assertFalse($manager->category_has_questions_in_use($category->id));
+        $this->assertCount(2, $manager->get_real_question_ids_in_category($category->id));
+
+        $sink = $this->redirectEvents();
+        $manager->delete_questions_and_category($category->id);
+        $events = $sink->get_events();
+        $sink->close();
+
+        // The category and all its questions (including subquestions) are gone.
+        $this->assertFalse($DB->record_exists('question_categories', ['id' => $category->id]));
+        $this->assertFalse($DB->record_exists('question', ['id' => $shortanswer->id]));
+        $this->assertFalse($DB->record_exists('question', ['id' => $multianswer->id]));
+        $this->assertFalse($DB->record_exists('question', ['parent' => $multianswer->id]));
+        $this->assertEmpty($manager->get_real_question_ids_in_category($category->id));
+
+        // Questions in other categories are untouched, and child categories moved to the parent.
+        $this->assertTrue($DB->record_exists('question', ['id' => $otherquestion->id]));
+        $this->assertEquals($defaultcat->id, $DB->get_field('question_categories', 'parent', ['id' => $child->id]));
+
+        // Both question deleted and category deleted events have been triggered.
+        $eventclasses = array_map(fn($event) => get_class($event), $events);
+        $this->assertContains(\core\event\question_deleted::class, $eventclasses);
+        $this->assertContains(\core\event\question_category_deleted::class, $eventclasses);
+        $this->assertDebuggingNotCalled();
+    }
+
+    /**
+     * Test that a category cannot be deleted along with its questions if any of them are in use.
+     */
+    public function test_delete_questions_and_category_questions_in_use(): void {
+        global $DB, $CFG;
+        require_once($CFG->dirroot . '/mod/quiz/locallib.php');
+        $this->setAdminUser();
+        $this->resetAfterTest();
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course();
+        $quiz = $generator->create_module('quiz', ['course' => $course->id]);
+        $context = context_module::instance($quiz->cmid);
+        $defaultcat = question_get_default_category($context->id, true);
+        $questiongenerator = $generator->get_plugin_generator('core_question');
+        $category = $questiongenerator->create_question_category([
+            'contextid' => $context->id,
+            'name' => 'Category to delete',
+            'parent' => $defaultcat->id,
+        ]);
+        $usedquestion = $questiongenerator->create_question('shortanswer', null, ['category' => $category->id]);
+        $unusedquestion = $questiongenerator->create_question('shortanswer', null, ['category' => $category->id]);
+        quiz_add_quiz_question($usedquestion->id, $quiz);
+
+        $manager = new category_manager();
+        $this->assertTrue($manager->category_has_questions_in_use($category->id));
+
+        try {
+            $manager->delete_questions_and_category($category->id);
+            $this->fail('Expected exception not thrown.');
+        } catch (\moodle_exception $e) {
+            $this->assertEquals(get_string('cannotdeletecategoryquestionsinuse', 'question'), $e->getMessage());
+        }
+
+        // Nothing has been deleted.
+        $this->assertTrue($DB->record_exists('question_categories', ['id' => $category->id]));
+        $this->assertTrue($DB->record_exists('question', ['id' => $usedquestion->id]));
+        $this->assertTrue($DB->record_exists('question', ['id' => $unusedquestion->id]));
+    }
+
     /**
      * Test the question category updated event.
      */
