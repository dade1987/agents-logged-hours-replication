diff --git a/public/question/classes/category_manager.php b/public/question/classes/category_manager.php
index 3dbb4696085..edb3b22ed37 100644
--- a/public/question/classes/category_manager.php
+++ b/public/question/classes/category_manager.php
@@ -75,6 +75,59 @@ class category_manager {
         $transaction->allow_commit();
     }
 
+    /**
+     * Check whether the questions in the given category can be deleted along with the category.
+     *
+     * This is only possible if none of the questions in the category is in use (for example in a quiz).
+     *
+     * @param int $categoryid id of the category.
+     * @return bool true if all the questions in the category can be deleted.
+     */
+    public function can_delete_questions_in_category(int $categoryid): bool {
+        global $CFG;
+        require_once($CFG->libdir . '/questionlib.php');
+
+        $questionids = $this->get_real_question_ids_in_category($categoryid);
+        if (empty($questionids)) {
+            return true;
+        }
+        return !questions_in_use($questionids);
+    }
+
+    /**
+     * Delete all the questions in a category, and then delete the category.
+     *
+     * This is only allowed if none of the questions in the category are in use.
+     *
+     * @param int $categoryid id of the category to delete.
+     * @throws moodle_exception if any of the questions are in use.
+     */
+    public function delete_questions_and_category(int $categoryid): void {
+        global $CFG, $DB;
+        require_once($CFG->libdir . '/questionlib.php');
+
+        $this->require_can_delete_category($categoryid);
+
+        $questionids = $this->get_real_question_ids_in_category($categoryid);
+        if (!empty($questionids) && questions_in_use($questionids)) {
+            throw new moodle_exception('cannotdeletecategoryquestionsinuse', 'question');
+        }
+        foreach ($questionids as $questionid) {
+            question_require_capability_on($questionid, 'edit');
+        }
+
+        $transaction = $DB->start_delegated_transaction();
+        foreach ($questionids as $questionid) {
+            question_delete_question($questionid);
+        }
+        if ($this->get_real_question_ids_in_category($categoryid)) {
+            // Should not happen, since we checked the questions were not in use, but be safe.
+            throw new moodle_exception('cannotdeletecategoryquestionsinuse', 'question');
+        }
+        $this->delete_category($categoryid);
+        $transaction->allow_commit();
+    }
+
