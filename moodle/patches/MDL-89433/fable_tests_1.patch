diff --git a/public/enrol/cohort/tests/sync_test.php b/public/enrol/cohort/tests/sync_test.php
index 2809deda139..fc6dd8b168e 100644
--- a/public/enrol/cohort/tests/sync_test.php
+++ b/public/enrol/cohort/tests/sync_test.php
@@ -746,4 +746,68 @@ final class sync_test extends \advanced_testcase {
         $this->assertTrue(groups_is_member($group1->id, $user4->id));
         $this->assertTrue(groups_is_member($group2->id, $user4->id));
     }
+
+    /**
+     * Test that already suspended enrolments are not processed again on every sync run.
+     *
+     * @covers ::enrol_cohort_sync
+     */
+    public function test_sync_skips_already_suspended_enrolments(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $this->enable_plugin();
+        $cohortplugin = enrol_get_plugin('cohort');
+        $cohortplugin->set_config('unenrolaction', ENROL_EXT_REMOVED_SUSPENDNOROLES);
+
+        $studentrole = $DB->get_record('role', ['shortname' => 'student']);
+        $course = $this->getDataGenerator()->create_course();
+        $cohort = $this->getDataGenerator()->create_cohort();
+        $user1 = $this->getDataGenerator()->create_user();
+        $user2 = $this->getDataGenerator()->create_user();
+        cohort_add_member($cohort->id, $user1->id);
+        cohort_add_member($cohort->id, $user2->id);
+
+        $instanceid = $cohortplugin->add_instance($course, [
+            'customint1' => $cohort->id,
+            'roleid' => $studentrole->id,
+        ]);
+        $instance = $DB->get_record('enrol', ['id' => $instanceid], '*', MUST_EXIST);
+
+        enrol_cohort_sync(new \null_progress_trace(), $course->id);
+        $this->assertEquals(2, $DB->count_records('user_enrolments', ['enrolid' => $instanceid]));
+
+        // Removing a member from the cohort suspends the enrolment.
+        cohort_remove_member($cohort->id, $user1->id);
+        $ue = $DB->get_record('user_enrolments', ['enrolid' => $instanceid, 'userid' => $user1->id], '*', MUST_EXIST);
+        $this->assertEquals(ENROL_USER_SUSPENDED, $ue->status);
+        $this->assertFalse($DB->record_exists('role_assignments', ['userid' => $user1->id, 'itemid' => $instanceid,
+            'component' => 'enrol_cohort']));
+
+        // A subsequent sync must not touch the suspended enrolment: nothing is reported
+        // and the enrolment instance is not loaded again for it.
+        $trace = new \progress_trace_buffer(new \text_progress_trace(), false);
+        enrol_cohort_sync($trace, $course->id);
+        $trace->finished();
+        $output = $trace->get_buffer();
+        $this->assertStringNotContainsString('suspending', $output);
+        $this->assertStringNotContainsString('unsassigning', $output);
+        $this->assertStringNotContainsString("$user1->id ==>", $output);
+
+        $ue = $DB->get_record('user_enrolments', ['enrolid' => $instanceid, 'userid' => $user1->id], '*', MUST_EXIST);
+        $this->assertEquals(ENROL_USER_SUSPENDED, $ue->status);
+
+        // Make sure the enrolment instance is not loaded for the suspended enrolment: count reads during the
+        // unenrol phase by comparing against a run where there is nothing to do at all.
+        $DB->delete_records('user_enrolments', ['enrolid' => $instanceid, 'userid' => $user1->id]);
+        $reads = $DB->perf_get_reads();
+        enrol_cohort_sync(new \null_progress_trace(), $course->id);
+        $baseline = $DB->perf_get_reads() - $reads;
+
+        $ue->id = $DB->insert_record('user_enrolments', $ue);
+        $reads = $DB->perf_get_reads();
+        enrol_cohort_sync(new \null_progress_trace(), $course->id);
+        $this->assertSame($baseline, $DB->perf_get_reads() - $reads);
+    }
 }
