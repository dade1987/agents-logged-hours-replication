diff --git a/public/enrol/cohort/tests/sync_test.php b/public/enrol/cohort/tests/sync_test.php
index 2809deda139..ef58d9880cd 100644
--- a/public/enrol/cohort/tests/sync_test.php
+++ b/public/enrol/cohort/tests/sync_test.php
@@ -746,4 +746,60 @@ final class sync_test extends \advanced_testcase {
         $this->assertTrue(groups_is_member($group1->id, $user4->id));
         $this->assertTrue(groups_is_member($group2->id, $user4->id));
     }
+
+    /**
+     * Already suspended enrolments must not be selected and processed again on subsequent syncs.
+     *
+     * @covers ::enrol_cohort_sync
+     */
+    public function test_sync_skips_already_suspended_enrolments(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $cohortplugin = enrol_get_plugin('cohort');
+        $studentrole = $DB->get_record('role', ['shortname' => 'student'], '*', MUST_EXIST);
+
+        $course = $this->getDataGenerator()->create_course();
+        $user = $this->getDataGenerator()->create_user();
+        $cohort = $this->getDataGenerator()->create_cohort();
+
+        $this->disable_plugin(); // Prevents event sync.
+        $id = $cohortplugin->add_instance($course, ['customint1' => $cohort->id, 'roleid' => $studentrole->id]);
+        $instance = $DB->get_record('enrol', ['id' => $id], '*', MUST_EXIST);
+        cohort_add_member($cohort->id, $user->id);
+        $this->enable_plugin();
+
+        $cohortplugin->set_config('unenrolaction', ENROL_EXT_REMOVED_SUSPENDNOROLES);
+
+        enrol_cohort_sync(new \null_progress_trace(), $course->id);
+        $this->assertTrue($DB->record_exists('user_enrolments',
+            ['enrolid' => $instance->id, 'userid' => $user->id, 'status' => ENROL_USER_ACTIVE]));
+
+        // Remove the cohort member using the low level DB api to prevent events.
+        $DB->delete_records('cohort_members', ['cohortid' => $cohort->id, 'userid' => $user->id]);
+
+        // First sync suspends the enrolment.
+        $trace = new \progress_trace_buffer(new \text_progress_trace(), false);
+        enrol_cohort_sync($trace, $course->id);
+        $trace->finished();
+        $this->assertStringContainsString("suspending: {$user->id} ==> {$course->id}", $trace->get_buffer());
+        $ue = $DB->get_record('user_enrolments', ['enrolid' => $instance->id, 'userid' => $user->id], '*', MUST_EXIST);
+        $this->assertEquals(ENROL_USER_SUSPENDED, $ue->status);
+
+        // Subsequent syncs must leave the already suspended enrolment alone.
+        $trace = new \progress_trace_buffer(new \text_progress_trace(), false);
+        enrol_cohort_sync($trace, $course->id);
+        $trace->finished();
+        $this->assertStringNotContainsString('suspending', $trace->get_buffer());
+        $this->assertStringNotContainsString('unenrolling', $trace->get_buffer());
+        $this->assertEquals($ue, $DB->get_record('user_enrolments', ['id' => $ue->id], '*', MUST_EXIST));
+
+        // When unenrolling is configured, suspended enrolments are still removed.
+        $cohortplugin->set_config('unenrolaction', ENROL_EXT_REMOVED_UNENROL);
+        $trace = new \progress_trace_buffer(new \text_progress_trace(), false);
+        enrol_cohort_sync($trace, $course->id);
+        $trace->finished();
+        $this->assertStringContainsString("unenrolling: {$user->id} ==> {$course->id}", $trace->get_buffer());
+        $this->assertFalse($DB->record_exists('user_enrolments', ['enrolid' => $instance->id, 'userid' => $user->id]));
+    }
 }
