+    /**
+     * Test the constructor rejects a defaultunit that is not in the restricted units.
+     */
+    public function test_constructor_rejects_defaultunit_not_in_units(): void {
+        $mform = $this->get_test_form();
+        $this->expectException(\coding_exception::class);
+        $mform->addElement('duration', 'testel', null, ['units' => [DAYSECS, WEEKSECS]]);
+    }
+
+    /**
+     * Test exportValue copes when the timeunit (and number) were not submitted, e.g. disabled controls.
+     */
+    public function test_export_value_missing_timeunit(): void {
+        $mform = $this->get_test_form();
+        $el = $mform->addElement('duration', 'testel', null, ['defaultunit' => HOURSECS]);
+
+        $values = ['testel' => ['number' => '2']];
+        $this->assertEquals(2 * HOURSECS, $el->exportValue($values));
+
+        $values = ['testel' => ['timeunit' => DAYSECS]];
+        $this->assertEquals(0, $el->exportValue($values));
+    }
+
