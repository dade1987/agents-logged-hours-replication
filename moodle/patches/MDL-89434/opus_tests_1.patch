@@ -285,8 +291,12 @@ class MoodleQuickForm_duration extends MoodleQuickForm_group {
     function exportValue(&$submitValues, $assoc = false) {
         // Get the values from all the child elements.
         $valuearray = [];
+        $elementvalues = $submitValues[$this->getName()] ?? [];
+        if (!is_array($elementvalues)) {
+            $elementvalues = [];
+        }
         foreach ($this->_elements as $element) {
-            $thisexport = $element->exportValue($submitValues[$this->getName()], true);
+            $thisexport = $element->exportValue($elementvalues, true);
             if (!is_null($thisexport)) {
                 $valuearray += $thisexport;
             }
@@ -299,7 +309,17 @@ class MoodleQuickForm_duration extends MoodleQuickForm_group {
         if ($this->_options['optional'] && empty($valuearray['enabled'])) {
             return $this->_prepareValue(0, $assoc);
         }
-        return $this->_prepareValue(
-                (int) round($valuearray['number'] * $valuearray['timeunit']), $assoc);
+
+        // Child controls may not have been submitted (for example, if they were disabled
+        // in the browser), so fall back to sensible defaults.
+        $number = $valuearray['number'] ?? 0;
+        if (!is_numeric($number)) {
+            $number = 0;
+        }
+        $unit = $valuearray['timeunit'] ?? $this->_options['defaultunit'];
+        if (!is_numeric($unit)) {
+            $unit = $this->_options['defaultunit'];
+        }
+        return $this->_prepareValue((int) round($number * $unit), $assoc);
     }
