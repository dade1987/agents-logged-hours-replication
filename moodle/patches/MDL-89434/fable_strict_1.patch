@@ -0,0 +1,9 @@
+issueNumber: MDL-89434
+notes:
+  core_form:
+    - message: >-
+        The `duration` form element constructor now throws a `coding_exception`
+        when the `units` option is specified and the `defaultunit` option (which
+        defaults to `MINSECS`) is not one of the specified units. Callers restricting
+        `units` must also pass a `defaultunit` that is a member of that set.
+      type: changed
diff --git a/public/lib/form/duration.php b/public/lib/form/duration.php
index f21cec34eb7..d3637e809a6 100644
--- a/public/lib/form/duration.php
+++ b/public/lib/form/duration.php
@@ -67,7 +67,8 @@ class MoodleQuickForm_duration extends MoodleQuickForm_group {
     *      'defaultunit' => 1|MINSECS|HOURSECS|DAYSECS|WEEKSECS - the default unit to display when
     *              the time is blank. If not specified, minutes is used.
     *      'units' => array containing some or all of 1, MINSECS, HOURSECS, DAYSECS and WEEKSECS
-    *              which unit choices to offer.
+    *              which unit choices to offer. If specified, 'defaultunit' must be one of these
+    *              units, otherwise a coding_exception is thrown.
     *      'allownegative' => true/false - are durations < 0 allowed? (default false)
     * @param mixed $attributes Either a typical HTML attribute string or an associative array
     */
@@ -108,6 +109,13 @@ class MoodleQuickForm_duration extends MoodleQuickForm_group {
             }
             krsort($displayunits, SORT_NUMERIC);
             $this->_options['units'] = $displayunits;
+
+            // The default unit must be one of the units offered.
+            if (!array_key_exists($this->_options['defaultunit'], $displayunits)) {
+                throw new coding_exception($this->_options['defaultunit'] .
+                        ' is not one of the units offered by this MoodleQuickForm_duration ' .
+                        'element. The defaultunit option must be a member of the units option.');
+            }
         }
     }
 
@@ -285,8 +293,12 @@ class MoodleQuickForm_duration extends MoodleQuickForm_group {
     function exportValue(&$submitValues, $assoc = false) {
         // Get the values from all the child elements.
         $valuearray = [];
+        $groupvalues = $submitValues[$this->getName()] ?? [];
+        if (!is_array($groupvalues)) {
+            $groupvalues = [];
+        }
         foreach ($this->_elements as $element) {
-            $thisexport = $element->exportValue($submitValues[$this->getName()], true);
+            $thisexport = $element->exportValue($groupvalues, true);
             if (!is_null($thisexport)) {
                 $valuearray += $thisexport;
             }
@@ -299,7 +311,17 @@ class MoodleQuickForm_duration extends MoodleQuickForm_group {
         if ($this->_options['optional'] && empty($valuearray['enabled'])) {
             return $this->_prepareValue(0, $assoc);
         }
-        return $this->_prepareValue(
-                (int) round($valuearray['number'] * $valuearray['timeunit']), $assoc);
+
+        // Child elements may not have submitted a value, for example if they were disabled
+        // (disabled form controls are not submitted by the browser). Fall back to sensible defaults.
+        $number = $valuearray['number'] ?? 0;
+        if (!is_numeric($number)) {
+            $number = 0;
+        }
+        $timeunit = $valuearray['timeunit'] ?? $this->_options['defaultunit'];
+        if (!is_numeric($timeunit)) {
+            $timeunit = $this->_options['defaultunit'];
+        }
+        return $this->_prepareValue((int) round($number * $timeunit), $assoc);
     }
 }
