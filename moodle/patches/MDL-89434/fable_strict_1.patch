+    /**
+     * Test exportValue() when the child controls were not submitted (e.g. because they were disabled).
+     *
+     * Disabled form controls are not submitted by the browser, so the timeunit and/or number
+     * keys may be missing from the submitted values.
+     */
+    public function test_export_value_missing_child_values(): void {
+        $mform = $this->get_test_form();
+        $el = $mform->addElement('duration', 'testel', null, ['defaultunit' => HOURSECS]);
+
+        // Nothing at all submitted for this element.
+        $values = [];
+        $this->assertNull($el->exportValue($values, true));
+        $this->assertNull($el->exportValue($values));
+
+        // Element submitted, but none of the children were.
+        $values = ['testel' => []];
+        $this->assertNull($el->exportValue($values, true));
+        $this->assertNull($el->exportValue($values));
+
+        // Only the number was submitted: the default unit should be used.
+        $values = ['testel' => ['number' => '2']];
+        $this->assertEquals(['testel' => 2 * HOURSECS], $el->exportValue($values, true));
+        $this->assertEquals(2 * HOURSECS, $el->exportValue($values));
+
+        // Only the unit was submitted: the number should be treated as 0.
+        $values = ['testel' => ['timeunit' => DAYSECS]];
+        $this->assertEquals(['testel' => 0], $el->exportValue($values, true));
+        $this->assertEquals(0, $el->exportValue($values));
+    }
+
+    /**
+     * Test exportValue() with restricted units when the timeunit was not submitted.
+     */
+    public function test_export_value_missing_timeunit_restricted_units(): void {
+        $mform = $this->get_test_form();
+        $el = $mform->addElement('duration', 'testel', null,
+                ['units' => [DAYSECS, WEEKSECS], 'defaultunit' => WEEKSECS]);
+
+        $values = ['testel' => ['number' => '3']];
+        $this->assertEquals(['testel' => 3 * WEEKSECS], $el->exportValue($values, true));
+        $this->assertEquals(3 * WEEKSECS, $el->exportValue($values));
+    }
+
+    /**
+     * Test validateSubmitValue() does not fail when the child controls were not submitted.
+     */
+    public function test_validate_submit_value_missing_child_values(): void {
+        $form = new temp_form_duration(null, null, 'post', '', null, true);
+        /** @var \MoodleQuickForm_duration $element */
+        $element = $form->get_form()->addElement('duration', 'testel', '');
+
+        $values = ['testel' => ['number' => '10']];
+        $this->assertNull($element->validateSubmitValue($values));
+
+        $values = ['testel' => []];
+        $this->assertNull($element->validateSubmitValue($values));
+
+        $values = [];
+        $this->assertNull($element->validateSubmitValue($values));
+    }
+
