diff --git a/public/lib/form/tests/duration_test.php b/public/lib/form/tests/duration_test.php
index d225e45425b..d6986ecfbbb 100644
--- a/public/lib/form/tests/duration_test.php
+++ b/public/lib/form/tests/duration_test.php
@@ -223,6 +223,36 @@ final class duration_test extends \basic_testcase {
             );
         }
     }
+
+    /**
+     * exportValue falls back to the default unit when timeunit is not submitted.
+     */
+    public function test_export_value_missing_timeunit(): void {
+        $mform = $this->get_test_form();
+        $el = $mform->addElement('duration', 'testel', '', ['defaultunit' => HOURSECS]);
+
+        $values = ['testel' => ['number' => 2]];
+        $this->assertEquals(2 * HOURSECS, $el->exportValue($values));
+
+        $values = ['testel' => ['timeunit' => HOURSECS]];
+        $this->assertEquals(0, $el->exportValue($values));
+    }
+
+    /**
+     * defaultunit must be one of the restricted units.
+     */
+    public function test_constructor_defaultunit_not_in_units(): void {
+        $this->expectException(\coding_exception::class);
+        new \MoodleQuickForm_duration('x', '', ['units' => [DAYSECS, WEEKSECS]]);
+    }
+
+    /**
+     * A valid defaultunit within the restricted units is accepted.
+     */
+    public function test_constructor_defaultunit_in_units(): void {
+        $el = new \MoodleQuickForm_duration('x', '', ['units' => [DAYSECS, WEEKSECS], 'defaultunit' => DAYSECS]);
+        $this->assertInstanceOf(\MoodleQuickForm_duration::class, $el);
+    }
 }
 
