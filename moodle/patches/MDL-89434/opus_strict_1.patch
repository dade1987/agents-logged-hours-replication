+    /**
+     * Test exportValue when the time unit was not submitted (e.g. the select was disabled in the browser).
+     */
+    public function test_export_value_missing_timeunit(): void {
+        $mform = $this->get_test_form();
+        $el = $mform->addElement('duration', 'testel', null, ['defaultunit' => HOURSECS]);
+        // Clear the current values of the child controls, so nothing can be used as a fallback.
+        $el->setValue(['number' => '', 'timeunit' => '']);
+
+        $values = ['testel' => ['number' => '2']];
+        $this->assertEquals(['testel' => 2 * HOURSECS], $el->exportValue($values, true));
+        $this->assertEquals(2 * HOURSECS, $el->exportValue($values));
+        $this->assertNull($el->validateSubmitValue($values));
+    }
+
+    /**
+     * Test exportValue when the number was not submitted.
+     */
+    public function test_export_value_missing_number(): void {
+        $mform = $this->get_test_form();
+        $el = $mform->addElement('duration', 'testel');
+        // Clear the current values of the child controls, so nothing can be used as a fallback.
+        $el->setValue(['number' => '', 'timeunit' => '']);
+
+        $values = ['testel' => ['timeunit' => HOURSECS]];
+        $this->assertEquals(['testel' => 0], $el->exportValue($values, true));
+        $this->assertEquals(0, $el->exportValue($values));
+    }
+
+    /**
+     * Test exportValue and validateSubmitValue when nothing at all was submitted for the element.
+     */
+    public function test_export_value_nothing_submitted(): void {
+        $mform = $this->get_test_form();
+        $el = $mform->addElement('duration', 'testel');
+        // Clear the current values of the child controls, so nothing can be used as a fallback.
+        $el->setValue(['number' => '', 'timeunit' => '']);
+
+        $values = [];
+        $this->assertEquals(0, $el->exportValue($values));
+        $this->assertNull($el->validateSubmitValue($values));
+    }
