diff --git a/public/lib/form/tests/duration_test.php b/public/lib/form/tests/duration_test.php
index d225e45425b..3a9d1d65774 100644
--- a/public/lib/form/tests/duration_test.php
+++ b/public/lib/form/tests/duration_test.php
@@ -81,6 +81,26 @@ final class duration_test extends \basic_testcase {
         $this->assertStringNotContainsString('value="3600"', $html);
     }
 
+    /**
+     * Test that a defaultunit outside the restricted units set is rejected.
+     */
+    public function test_constructor_rejects_defaultunit_not_in_units(): void {
+        $mform = $this->get_test_form();
+        $this->expectException(\coding_exception::class);
+        $mform->addElement('duration', 'testel', null, ['units' => [DAYSECS, WEEKSECS]]);
+    }
+
+    /**
+     * Test exportValue copes with missing (disabled) child controls.
+     */
+    public function test_export_value_missing_timeunit(): void {
+        [$mform, $element] = $this->get_test_form_and_element();
+        $submit = ['testel' => ['number' => '3']];
+        $this->assertEquals(3 * MINSECS, $element->exportValue($submit));
+        $submit = ['testel' => ['number' => '']];
+        $this->assertEquals(0, $element->exportValue($submit));
+    }
+
     /**
      * Testcase for testing units (seconds, minutes, hours and days)
      */
