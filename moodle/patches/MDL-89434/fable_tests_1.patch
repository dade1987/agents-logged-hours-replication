+    /**
+     * Test constructor with limited units and an explicit default unit from that set.
+     */
+    public function test_constructor_limited_units_with_default_unit(): void {
+        $mform = $this->get_test_form();
+        $element = $mform->addElement('duration', 'testel', null,
+                ['units' => [DAYSECS, WEEKSECS], 'defaultunit' => WEEKSECS, 'optional' => false]);
+        $this->assertEquals([0, WEEKSECS], $element->seconds_to_unit(0));
+        $html = $mform->toHtml();
+        $html = preg_replace('~ +>~', '>', $html); // Clean HTML to avoid spurious errors.
+        $this->assertStringContainsString('<option value="604800" selected>weeks</option>', $html);
+        $this->assertStringContainsString('<option value="86400">days</option>', $html);
+        $this->assertStringNotContainsString('value="60"', $html);
+    }
+
+    /**
+     * Test constructor rejects a default unit that is not in the restricted units set.
+     *
+     * Here the class default unit (minutes) is not in the units offered, so this is a misconfiguration.
+     */
+    public function test_constructor_rejects_implicit_default_unit_not_in_units(): void {
+        $mform = $this->get_test_form();
+        $this->expectException(\coding_exception::class);
+        $mform->addElement('duration', 'testel', null, ['units' => [DAYSECS, WEEKSECS]]);
+    }
+
+    /**
+     * Test constructor rejects an explicit default unit that is not in the restricted units set.
+     */
+    public function test_constructor_rejects_explicit_default_unit_not_in_units(): void {
+        $mform = $this->get_test_form();
+        $this->expectException(\coding_exception::class);
+        $mform->addElement('duration', 'testel', null,
+                ['units' => [DAYSECS, WEEKSECS], 'defaultunit' => HOURSECS]);
+    }
+
