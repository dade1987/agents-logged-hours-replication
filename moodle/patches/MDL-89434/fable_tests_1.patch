+        /** @var \MoodleQuickForm_duration $element */
+        $element = $form->get_form()->addElement('duration', 'testel', '', ['units' => [DAYSECS, WEEKSECS],
+                'defaultunit' => WEEKSECS]);
+
+        $this->assertNull($element->validateSubmitValue(['testel' => ['number' => '1']]));
+        $this->assertNull($element->validateSubmitValue(['testel' => []]));
+        $this->assertNull($element->validateSubmitValue([]));
+    }
+
