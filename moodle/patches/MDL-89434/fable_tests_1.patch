     }
 
+    /**
+     * Data provider for {@see test_export_value_missing_submitted_values()}.
+     *
+     * @return array test cases.
+     */
+    public static function export_value_missing_submitted_values_cases(): array {
+        return [
+            'nothing submitted for the element at all' => [0, [], []],
+            'nothing submitted for the child controls' => [0, [], ['testel' => []]],
+            'timeunit not submitted (disabled select), fall back to default unit' =>
+                    [120, ['defaultunit' => MINSECS], ['testel' => ['number' => '2']]],
+            'timeunit not submitted, with a different default unit' =>
+                    [2 * DAYSECS, ['defaultunit' => DAYSECS], ['testel' => ['number' => '2']]],
+            'timeunit not submitted, with restricted units' =>
+                    [3 * WEEKSECS, ['units' => [DAYSECS, WEEKSECS], 'defaultunit' => WEEKSECS],
+                            ['testel' => ['number' => '3']]],
+            'number not submitted (disabled text), treated as zero' =>
+                    [0, [], ['testel' => ['timeunit' => HOURSECS]]],
+            'number submitted empty, treated as zero' =>
+                    [0, [], ['testel' => ['number' => '', 'timeunit' => HOURSECS]]],
+            'optional and disabled, nothing submitted for the child controls' =>
+                    [0, ['optional' => true], ['testel' => ['enabled' => 1]]],
+            'optional and enabled, timeunit not submitted' =>
+                    [5 * MINSECS, ['optional' => true], ['testel' => ['number' => '5', 'enabled' => 1]]],
+        ];
+    }
+
+    /**
+     * Test exportValue when some or all of the child controls were not submitted.
+     *
+     * This happens when the child controls are disabled (for example by disabledIf or hideIf),
+     * because disabled form controls are not submitted by the browser.
+     *
+     * @dataProvider export_value_missing_submitted_values_cases
+     * @param int|null $expected expected value returned by the element.
+     * @param array $options options to create the element with.
+     * @param array $values the submitted values.
+     */
+    public function test_export_value_missing_submitted_values(?int $expected, array $options, array $values): void {
+        $mform = $this->get_test_form();
+        $el = $mform->addElement('duration', 'testel', null, $options);
+
+        $this->assertSame($expected, $el->exportValue($values));
+        $this->assertSame(['testel' => $expected], $el->exportValue($values, true));
+    }
+
+    /**
+     * Test validateSubmitValue when the child controls were not submitted (e.g. disabled).
+     */
+    public function test_validate_submit_value_missing_submitted_values(): void {
