+    protected function is_module_unrestricted(cm_info $cm): bool {
+        if (!empty($cm->availability)) {
+            return false;
+        }
+        if ($cm->groupmode == SEPARATEGROUPS) {
+            return false;
+        }
+        if (!empty($cm->groupingid)) {
+            return false;
+        }
+        // Section restrictions are applied on top of the module ones, so the section must be unrestricted too.
