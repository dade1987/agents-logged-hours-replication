diff --git a/public/completion/tests/progress_test.php b/public/completion/tests/progress_test.php
index 32d8fe5fb5d..a0a0229c9a2 100644
--- a/public/completion/tests/progress_test.php
+++ b/public/completion/tests/progress_test.php
@@ -577,4 +577,133 @@ final class progress_test extends \advanced_testcase {
         $completion->update_state($cm2, COMPLETION_COMPLETE, $user2->id);
         $this->assertEquals(100, \core_completion\progress::get_course_progress_percentage($course, $user2->id));
     }
+
+    /**
+     * Tests course progress percentage with group restrictions applied to a section (not to the activity).
+     */
+    public function test_course_progress_percentage_with_section_group_restrictions(): void {
+        global $DB;
+
+        set_config('enableavailability', 1);
+
+        // Create a course with completion enabled and two sections.
+        $course = $this->getDataGenerator()->create_course([
+            'enablecompletion' => 1,
+            'numsections' => 2,
+            'format' => 'topics',
+        ]);
+
+        // Create and enrol two students in the course.
+        $user1 = $this->getDataGenerator()->create_user();
+        $user2 = $this->getDataGenerator()->create_user();
+        $studentrole = $DB->get_record('role', ['shortname' => 'student']);
+        $this->getDataGenerator()->enrol_user($user1->id, $course->id, $studentrole->id);
+        $this->getDataGenerator()->enrol_user($user2->id, $course->id, $studentrole->id);
+
+        // Create a group and add user1.
+        $group1 = $this->getDataGenerator()->create_group(['courseid' => $course->id, 'name' => 'Group 1']);
+        $this->getDataGenerator()->create_group_member(['groupid' => $group1->id, 'userid' => $user1->id]);
+
+        /** @var \mod_assign_generator $assigngenerator */
+        $assigngenerator = $this->getDataGenerator()->get_plugin_generator('mod_assign');
+
+        // Activity 1 lives in section 1, which is restricted to group1. The activity itself has no restriction.
+        $activity1 = $assigngenerator->create_instance([
+            'course' => $course->id,
+            'section' => 1,
+            'completion' => COMPLETION_ENABLED,
+        ]);
+        $availabilityjson = json_encode(tree::get_root_json(
+            [\availability_group\condition::get_json($group1->id)],
+            tree::OP_AND,
+            false,
+        ));
+        $DB->set_field('course_sections', 'availability', $availabilityjson, ['course' => $course->id, 'section' => 1]);
+
+        // Activity 2 lives in section 2 and is visible to all users.
+        $activity2 = $assigngenerator->create_instance([
+            'course' => $course->id,
+            'section' => 2,
+            'completion' => COMPLETION_ENABLED,
+        ]);
+        rebuild_course_cache($course->id, true);
+
+        $cm1 = get_coursemodule_from_id('assign', $activity1->cmid);
+        $cm2 = get_coursemodule_from_id('assign', $activity2->cmid);
+
+        // User1 (in group1) sees both activities.
+        $this->setUser($user1);
+        $completion = new \completion_info($course);
+        $this->assertEqualsCanonicalizing([$cm1->id, $cm2->id],
+            array_keys($completion->get_user_activities_with_completion($user1->id)));
+        $completion->update_state($cm2, COMPLETION_COMPLETE, $user1->id);
+        $this->assertEquals(50, \core_completion\progress::get_course_progress_percentage($course, $user1->id));
+
+        // User2 (not in group1) only sees the activity in the unrestricted section.
+        $this->setUser($user2);
+        $completion = new \completion_info($course);
+        $this->assertEquals([$cm2->id], array_keys($completion->get_user_activities_with_completion($user2->id)));
+        $this->assertEquals(0, \core_completion\progress::get_course_progress_percentage($course, $user2->id));
+        $completion->update_state($cm2, COMPLETION_COMPLETE, $user2->id);
+        $this->assertEquals(100, \core_completion\progress::get_course_progress_percentage($course, $user2->id));
+    }
+
+    /**
+     * Tests that the course progress percentage is memoised within a request and invalidated when
+     * completion state, course structure or tracked status changes.
+     */
+    public function test_course_progress_percentage_request_cache(): void {
+        global $DB;
+
+        $course = $this->getDataGenerator()->create_course(['enablecompletion' => 1, 'numsections' => 2]);
+
+        $user = $this->getDataGenerator()->create_user();
+        $studentrole = $DB->get_record('role', ['shortname' => 'student']);
+        $this->getDataGenerator()->enrol_user($user->id, $course->id, $studentrole->id);
+
+        /** @var \mod_assign_generator $assigngenerator */
+        $assigngenerator = $this->getDataGenerator()->get_plugin_generator('mod_assign');
+        $activity1 = $assigngenerator->create_instance([
+            'course' => $course->id,
+            'section' => 1,
+            'completion' => COMPLETION_ENABLED,
+        ]);
+        $activity2 = $assigngenerator->create_instance([
+            'course' => $course->id,
+            'section' => 1,
+            'completion' => COMPLETION_ENABLED,
+        ]);
+        $cm1 = get_coursemodule_from_id('assign', $activity1->cmid);
+        $cm2 = get_coursemodule_from_id('assign', $activity2->cmid);
+
+        $this->setUser($user);
+        $completion = new \completion_info($course);
+
+        $this->assertEquals(0, \core_completion\progress::get_course_progress_percentage($course, $user->id));
+
+        // Repeated calls reuse the memoised value: no further database query is required.
+        $reads = $DB->perf_get_reads();
+        $this->assertEquals(0, \core_completion\progress::get_course_progress_percentage($course, $user->id));
+        $this->assertEquals(0, \core_completion\progress::get_course_progress_percentage($course, $user->id));
+        $this->assertEquals($reads, $DB->perf_get_reads());
+
+        // Completing an activity within the same request is reflected immediately.
+        $completion->update_state($cm1, COMPLETION_COMPLETE, $user->id);
+        $this->assertEquals(50, \core_completion\progress::get_course_progress_percentage($course, $user->id));
+
+        // Hiding an activity (structural change) is reflected immediately.
+        set_coursemodule_visible($cm2->id, 0);
+        $this->assertEquals(100, \core_completion\progress::get_course_progress_percentage($course, $user->id));
+        set_coursemodule_visible($cm2->id, 1);
+        $this->assertEquals(50, \core_completion\progress::get_course_progress_percentage($course, $user->id));
+
+        // Marking the course complete is reflected immediately.
+        $ccompletion = new completion_completion(['course' => $course->id, 'userid' => $user->id]);
+        $ccompletion->mark_complete();
+        $this->assertEquals(100, \core_completion\progress::get_course_progress_percentage($course, $user->id));
+
+        // Losing the tracked status is reflected immediately.
+        unassign_capability('moodle/course:isincompletionreports', $studentrole->id);
+        $this->assertNull(\core_completion\progress::get_course_progress_percentage($course, $user->id));
+    }
 }
