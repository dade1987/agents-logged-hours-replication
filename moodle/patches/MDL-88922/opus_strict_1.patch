diff --git a/public/completion/tests/progress_test.php b/public/completion/tests/progress_test.php
index 32d8fe5fb5d..9e527800daa 100644
--- a/public/completion/tests/progress_test.php
+++ b/public/completion/tests/progress_test.php
@@ -577,4 +577,93 @@ final class progress_test extends \advanced_testcase {
         $completion->update_state($cm2, COMPLETION_COMPLETE, $user2->id);
         $this->assertEquals(100, \core_completion\progress::get_course_progress_percentage($course, $user2->id));
     }
+
+    /**
+     * Tests that group restrictions on a section still exclude its activities (no fast path bypass).
+     */
+    public function test_course_progress_percentage_with_section_group_restriction(): void {
+        global $DB;
+
+        set_config('enableavailability', 1);
+
+        $course = $this->getDataGenerator()->create_course([
+            'enablecompletion' => 1,
+            'numsections' => 1,
+            'format' => 'topics',
+        ]);
+        $user1 = $this->getDataGenerator()->create_user();
+        $user2 = $this->getDataGenerator()->create_user();
+        $studentrole = $DB->get_record('role', ['shortname' => 'student']);
+        $this->getDataGenerator()->enrol_user($user1->id, $course->id, $studentrole->id);
+        $this->getDataGenerator()->enrol_user($user2->id, $course->id, $studentrole->id);
+        $group1 = $this->getDataGenerator()->create_group(['courseid' => $course->id]);
+        $this->getDataGenerator()->create_group_member(['groupid' => $group1->id, 'userid' => $user1->id]);
+
+        $assigngenerator = $this->getDataGenerator()->get_plugin_generator('mod_assign');
+        $activity1 = $assigngenerator->create_instance([
+            'course' => $course->id,
+            'section' => 0,
+            'completion' => COMPLETION_ENABLED,
+        ]);
+        $assigngenerator->create_instance([
+            'course' => $course->id,
+            'section' => 1,
+            'completion' => COMPLETION_ENABLED,
+        ]);
+
+        // Restrict section 1 (not the activity itself) to group1, shown to others greyed out.
+        $availabilityjson = json_encode(tree::get_root_json(
+            [\availability_group\condition::get_json($group1->id)],
+            tree::OP_AND,
+            true,
+        ));
+        $DB->set_field('course_sections', 'availability', $availabilityjson, ['course' => $course->id, 'section' => 1]);
+        rebuild_course_cache($course->id, true);
+
+        $cm1 = get_coursemodule_from_id('assign', $activity1->cmid);
+
+        $this->setUser($user1);
+        $completion = new \completion_info($course);
+        $completion->update_state($cm1, COMPLETION_COMPLETE, $user1->id);
+        $this->assertEquals(50, progress::get_course_progress_percentage($course, $user1->id));
+
+        $this->setUser($user2);
+        $completion = new \completion_info($course);
+        $completion->update_state($cm1, COMPLETION_COMPLETE, $user2->id);
+        $this->assertEquals(100, progress::get_course_progress_percentage($course, $user2->id));
+    }
+
+    /**
+     * Tests that course progress is memoised per request and invalidated by completion changes.
+     */
+    public function test_course_progress_percentage_request_cache(): void {
+        global $DB;
+
+        $course = $this->getDataGenerator()->create_course(['enablecompletion' => 1]);
+        $user = $this->getDataGenerator()->create_user();
+        $studentrole = $DB->get_record('role', ['shortname' => 'student']);
+        $this->getDataGenerator()->enrol_user($user->id, $course->id, $studentrole->id);
+
+        $assign1 = $this->getDataGenerator()->create_module('assign', ['course' => $course->id],
+            ['completion' => COMPLETION_TRACKING_MANUAL]);
+        $this->getDataGenerator()->create_module('assign', ['course' => $course->id],
+            ['completion' => COMPLETION_TRACKING_MANUAL]);
+
+        $this->setUser($user);
+        $this->assertEquals(0, progress::get_course_progress_percentage($course, $user->id));
+
+        // A repeated call within the same request returns the memoised value.
+        $this->assertEquals(0, progress::get_course_progress_percentage($course, $user->id));
+
+        // Changing completion state invalidates the memoised value.
+        $completion = new \completion_info($course);
+        $cm1 = get_coursemodule_from_id('assign', $assign1->cmid);
+        $completion->update_state($cm1, COMPLETION_COMPLETE, $user->id);
+        $this->assertEquals(50, progress::get_course_progress_percentage($course, $user->id));
+
+        // Course structure changes (new cacherev) invalidate it too.
+        $this->getDataGenerator()->create_module('assign', ['course' => $course->id],
+            ['completion' => COMPLETION_TRACKING_MANUAL]);
+        $this->assertEquals(33.33, round(progress::get_course_progress_percentage($course, $user->id), 2));
+    }
 }
