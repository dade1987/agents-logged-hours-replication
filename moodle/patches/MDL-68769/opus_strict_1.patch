@@ -56,7 +56,7 @@ class refresh_mod_calendar_events_task extends adhoc_task {
 
         // Is course id set?
         if (isset($this->get_custom_data()->courseid)) {
-            $courseid = $this->get_custom_data()->courseid;
+            $courseid = (int) $this->get_custom_data()->courseid;
         } else {
             $courseid = 0;
