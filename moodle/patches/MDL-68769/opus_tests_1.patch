+++ b/public/lib/classes/task/refresh_mod_calendar_events_task.php
@@ -71,7 +71,16 @@ class refresh_mod_calendar_events_task extends adhoc_task {
             }
             // Refresh events.
             mtrace('Refreshing events for ' . $plugin->name);
-            course_module_bulk_update_calendar_events($plugin->name, $courseid);
+            try {
+                course_module_bulk_update_calendar_events($plugin->name, $courseid);
+            } catch (\Throwable $e) {
+                // An error here (e.g. an activity or course deleted after this task was queued) must not
+                // make the whole task fail, otherwise it would be retried forever. Report it and move on.
+                mtrace('Error refreshing events for ' . $plugin->name . ': ' . $e->getMessage());
+                if (!empty($e->debuginfo)) {
+                    mtrace('Debug info: ' . $e->debuginfo);
+                }
+            }
         }
     }
 }
