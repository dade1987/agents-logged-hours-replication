+namespace core\task;
+
+/**
+ * Unit tests for the refresh_mod_calendar_events_task adhoc task.
+ *
+ * @package   core
+ * @copyright 2026 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \core\task\refresh_mod_calendar_events_task
+ */
+final class refresh_mod_calendar_events_task_test extends \advanced_testcase {
+
+    /**
+     * Test the task runs normally.
+     */
+    public function test_execute(): void {
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course();
+        $this->getDataGenerator()->create_module('assign', ['course' => $course->id]);
+
+        $task = new refresh_mod_calendar_events_task();
+        $task->set_custom_data(['courseid' => $course->id, 'plugins' => ['assign']]);
+
+        $this->expectOutputRegex('/Refreshing events for assign/');
+        $task->execute();
+    }
+
+    /**
+     * Test that an orphaned/broken activity does not make the task throw an exception (and loop in faildelay).
+     */
+    public function test_execute_with_broken_activity(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $course = $this->getDataGenerator()->create_course();
+        $this->getDataGenerator()->create_module('assign', ['course' => $course->id]);
+
+        // Simulate the course being removed from under the activity.
+        $DB->delete_records('course', ['id' => $course->id]);
+
+        $task = new refresh_mod_calendar_events_task();
+        $task->set_custom_data(['courseid' => $course->id, 'plugins' => ['assign']]);
+
+        ob_start();
+        $task->execute();
+        $output = ob_get_clean();
+
+        $this->assertStringContainsString('Refreshing events for assign', $output);
+        $this->assertStringContainsString('Error refreshing events for assign', $output);
+    }
+}
