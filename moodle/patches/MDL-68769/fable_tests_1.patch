@@ -897,8 +897,16 @@ function course_module_bulk_update_calendar_events($modulename, $courseid = 0) {
     }
 
     foreach ($instances as $instance) {
-        if ($cm = get_coursemodule_from_instance($modulename, $instance->id, $instance->course)) {
-            course_module_calendar_event_update_process($instance, $cm);
+        try {
+            if ($cm = get_coursemodule_from_instance($modulename, $instance->id, $instance->course)) {
+                course_module_calendar_event_update_process($instance, $cm);
+            }
+        } catch (\moodle_exception $e) {
+            // The module instance, course module or course may have been deleted (or orphaned) between the time this
+            // process was requested and now. Failing here would make the whole task fail (and be retried forever), so
+            // just report the problem and carry on with the remaining instances.
+            mtrace("Unable to refresh calendar events for {$modulename} instance {$instance->id} " .
+                "(course {$instance->course}): " . $e->getMessage());
         }
     }
     return true;
