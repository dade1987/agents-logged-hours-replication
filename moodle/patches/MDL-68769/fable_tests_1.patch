     }
 
+    /**
+     * Test that orphaned module instances do not make the bulk update of calendar events fail (MDL-68769).
+     */
+    public function test_course_module_bulk_update_calendar_events_orphaned(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $course = $this->getDataGenerator()->create_course(['enablecompletion' => COMPLETION_ENABLED]);
+        $course2 = $this->getDataGenerator()->create_course(['enablecompletion' => COMPLETION_ENABLED]);
+        $assign = $this->getDataGenerator()->create_module('assign', [
+            'course' => $course,
+            'completionexpected' => time(),
+            'duedate' => time(),
+        ]);
+        $assign2 = $this->getDataGenerator()->create_module('assign', [
+            'course' => $course2,
+            'completionexpected' => time(),
+            'duedate' => time(),
+        ]);
+
+        // Orphan the first assignment by removing its course and course module records directly.
+        $DB->delete_records('course_modules', ['id' => $assign->cmid]);
+        $DB->delete_records('course', ['id' => $course->id]);
+
+        // Orphan the second assignment by removing its course only, so the course module still points to a
+        // course that does not exist any more.
+        $DB->delete_records('course', ['id' => $course2->id]);
+
+        // This must not throw an exception, it should just report the problem.
+        $this->assertTrue(course_module_bulk_update_calendar_events('assign'));
+        $output = $this->getActualOutputForAssertion();
+        $this->assertStringContainsString('Unable to refresh calendar events for assign instance ' . $assign2->id, $output);
+        $this->assertStringNotContainsString('Unable to refresh calendar events for assign instance ' . $assign->id, $output);
+    }
+
