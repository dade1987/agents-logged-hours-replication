+namespace core\task;
+
+/**
+ * Unit tests for the refresh_mod_calendar_events_task adhoc task.
+ *
+ * @package   core
+ * @copyright 2020 Moodle Pty Ltd
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ * @covers    \core\task\refresh_mod_calendar_events_task
+ */
+final class refresh_mod_calendar_events_task_test extends \advanced_testcase {
+    /**
+     * The task refreshes the events of the module instances of a given course.
+     */
+    public function test_execute_for_course(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $course = $this->getDataGenerator()->create_course(['enablecompletion' => \COMPLETION_ENABLED]);
+        $assign = $this->getDataGenerator()->create_module('assign', [
+            'course' => $course,
+            'completionexpected' => time(),
+            'duedate' => time(),
+        ]);
+
+        // Remove the events, the task should recreate them.
+        $DB->delete_records('event', ['modulename' => 'assign', 'instance' => $assign->id]);
+        $this->assertEquals(0, $DB->count_records('event', ['modulename' => 'assign', 'instance' => $assign->id]));
+
+        $task = new refresh_mod_calendar_events_task();
+        $task->set_custom_data(['courseid' => $course->id, 'plugins' => ['assign']]);
+        $task->execute();
+        $this->expectOutputRegex('/Refreshing events for assign/');
+
+        $this->assertGreaterThan(0, $DB->count_records('event', ['modulename' => 'assign', 'instance' => $assign->id]));
+    }
+
+    /**
+     * The task must not fail when the course it was queued for has been deleted in the meantime (MDL-68769).
+     */
+    public function test_execute_for_deleted_course(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $course = $this->getDataGenerator()->create_course(['enablecompletion' => \COMPLETION_ENABLED]);
+        $this->getDataGenerator()->create_module('assign', [
+            'course' => $course,
+            'completionexpected' => time(),
+            'duedate' => time(),
+        ]);
+
+        // Simulate a course that was deleted after the task was queued (leaving orphaned module records behind).
+        $DB->delete_records('course', ['id' => $course->id]);
+
+        $task = new refresh_mod_calendar_events_task();
+        $task->set_custom_data(['courseid' => $course->id]);
+        $task->execute();
+        $this->expectOutputRegex("/Course with ID {$course->id} does not exist/");
+    }
+
+    /**
+     * The task must not fail when it refreshes all the modules of the site and some of them are orphaned (MDL-68769).
+     */
+    public function test_execute_with_orphaned_modules(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $course = $this->getDataGenerator()->create_course(['enablecompletion' => \COMPLETION_ENABLED]);
+        $assign = $this->getDataGenerator()->create_module('assign', [
+            'course' => $course,
+            'completionexpected' => time(),
+            'duedate' => time(),
+        ]);
+
+        // Simulate a course that was deleted leaving orphaned module records behind.
+        $DB->delete_records('course', ['id' => $course->id]);
+
+        $task = new refresh_mod_calendar_events_task();
+        $task->set_custom_data(['plugins' => ['assign']]);
+        $task->execute();
+        $this->expectOutputRegex('/Unable to refresh calendar events for assign instance ' . $assign->id . '/');
+    }
+}
