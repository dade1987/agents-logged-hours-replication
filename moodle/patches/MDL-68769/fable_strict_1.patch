+namespace core\task;
+
+/**
+ * Unit tests for the refresh_mod_calendar_events_task adhoc task.
+ *
+ * @package   core
+ * @covers    \core\task\refresh_mod_calendar_events_task
+ * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+final class refresh_mod_calendar_events_task_test extends \advanced_testcase {
+    /**
+     * The task must complete (and so be removed from the queue) even when it refers to orphaned data.
+     *
+     * If the task threw an exception it would be retried with an increasing fail delay forever (MDL-68769).
+     */
+    public function test_execute_with_orphaned_data(): void {
+        global $DB;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $course = $this->getDataGenerator()->create_course(['enablecompletion' => COMPLETION_ENABLED]);
+        $assign = $this->getDataGenerator()->create_module('assign', [
+            'course' => $course,
+            'completionexpected' => time(),
+            'duedate' => time(),
+        ]);
+
+        // Simulate the course being deleted while the module and course module records are left behind.
+        $DB->delete_records('course', ['id' => $course->id]);
+
+        $task = new refresh_mod_calendar_events_task();
+        $task->set_custom_data(['courseid' => $course->id, 'plugins' => ['assign']]);
+
+        ob_start();
+        $task->execute();
+        $output = ob_get_clean();
+
+        $this->assertStringContainsString('Refreshing events for assign', $output);
+        $this->assertStringContainsString('Could not refresh calendar events for assign instance ' . $assign->id, $output);
+    }
+}
