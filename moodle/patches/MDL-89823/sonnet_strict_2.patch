+    /**
+     * Build the value which is hashed and stored for a token.
+     *
+     * The raw secret is bound to the token's scopes and expiry using an HMAC, so the stored hash only
+     * verifies if neither has been changed since the token was created. The HMAC is used rather than
+     * simple concatenation because bcrypt ignores everything after the first 72 bytes.
+     *
+     * @param string $secret The raw secret.
+     * @param string[] $scopes The scopes granted to the token.
+     * @param int|null $expirytime The expiry timestamp, or null if none.
+     * @return string
+     */
+    protected static function get_hash_input(
+        #[\SensitiveParameter]
+        string $secret,
+        array $scopes,
+        ?int $expirytime,
+    ): string {
+        $integrity = json_encode([
+            'scopes' => implode(' ', $scopes),
+            'expirytime' => $expirytime,
+        ]);
+
+        return hash_hmac('sha256', $integrity, $secret);
+    }
