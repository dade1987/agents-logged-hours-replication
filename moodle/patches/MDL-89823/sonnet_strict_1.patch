+    /**
+     * Build the value which is hashed and verified for a token.
+     *
+     * The scopes and expiry are bound to the secret, so changing either in the database
+     * invalidates the token.
+     *
+     * @param string $secret The raw secret.
+     * @param string $scopes The space-separated scopes.
+     * @param int|null $expirytime The expiry timestamp.
+     * @return string
+     */
+    protected static function get_integrity_payload(
+        #[\SensitiveParameter]
+        string $secret,
+        string $scopes,
+        ?int $expirytime,
+    ): string {
+        return hash_hmac(
+            'sha256',
+            json_encode([$scopes, $expirytime === null ? null : (int) $expirytime]),
+            $secret,
+        );
+    }
