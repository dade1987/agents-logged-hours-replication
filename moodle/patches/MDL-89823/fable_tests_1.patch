+    /**
+     * Bind a raw secret to the scopes and expiry it was issued with, ready for hashing.
+     *
+     * The stored hash covers not just the secret but an integrity check value calculated from the
+     * scopes and the expiry time. Should either be changed in the database (say, to widen a
+     * token's remit or extend its life), the hash no longer verifies and the token stops working.
+     *
+     * The secret is used as the HMAC key rather than concatenated, so the result stays a fixed
+     * 64 characters: bcrypt only looks at the first 72 bytes of its input, and the secret alone
+     * is already 64 of them.
+     *
+     * @param string $secret The raw secret.
+     * @param string[] $scopes The scopes the token was issued with.
+     * @param int|null $expirytime The expiry timestamp the token was issued with.
+     * @return string The value to hash, or to verify against the stored hash.
+     */
+    public static function get_hashable_secret(
+        #[\SensitiveParameter]
+        string $secret,
+        array $scopes,
+        ?int $expirytime,
+    ): string {
+        $integrity = implode('|', [
+            implode(' ', $scopes),
+            $expirytime === null ? '' : (string) $expirytime,
+        ]);
+
+        return hash_hmac('sha256', $integrity, $secret);
+    }
