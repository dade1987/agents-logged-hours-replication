+    /**
+     * Editing the row in the database to widen or extend a token leaves it unable to verify.
+     *
+     * @param array $tampering The fields to overwrite directly in the database.
+     */
+    #[DataProvider('tampered_token_provider')]
+    public function test_validate_token_rejects_tampered_row(array $tampering): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $user = $this->getDataGenerator()->create_user();
+        $repository = new api_token_repository();
+
+        $token = $repository->create_token('Test', 'correctsecret', $user->id, ['scope'], null, time() + 3600);
+
+        // The untouched row verifies.
+        $this->assertEquals($token->get_id(), $repository->validate_token($token->get_id(), 'correctsecret')->get_id());
+
+        $DB->update_record('rest_api_tokens', (object) (['id' => $token->get_id()] + $tampering));
+
+        $this->expectException(\core\exception\invalid_api_token_exception::class);
+        $repository->validate_token($token->get_id(), 'correctsecret');
+    }
+
+    /**
+     * Data provider for tampered row tests.
+     *
+     * @return array<string, array[]>
+     */
+    public static function tampered_token_provider(): array {
+        return [
+            'scope added' => [['scopes' => 'scope otherscope']],
+            'scope replaced' => [['scopes' => 'otherscope']],
+            'expiry extended' => [['expirytime' => time() + YEARSECS]],
+            'expiry removed' => [['expirytime' => null]],
+        ];
+    }
+
+    /**
+     * The integrity value changes with every input, and is a fixed length however long they are.
+     */
+    public function test_get_hashable_secret(): void {
+        $base = api_token_repository::get_hashable_secret('secret', ['a', 'b'], 1700000000);
+
+        $this->assertSame(64, strlen($base));
+        $this->assertSame($base, api_token_repository::get_hashable_secret('secret', ['a', 'b'], 1700000000));
+        $this->assertNotSame($base, api_token_repository::get_hashable_secret('other', ['a', 'b'], 1700000000));
+        $this->assertNotSame($base, api_token_repository::get_hashable_secret('secret', ['a'], 1700000000));
+        $this->assertNotSame($base, api_token_repository::get_hashable_secret('secret', ['a', 'b', 'c'], 1700000000));
+        $this->assertNotSame($base, api_token_repository::get_hashable_secret('secret', ['a', 'b'], 1700000001));
+        $this->assertNotSame($base, api_token_repository::get_hashable_secret('secret', ['a', 'b'], null));
+        // Fixed length whatever the scopes, so bcrypt's 72 byte limit never truncates the integrity check.
+        $this->assertSame(64, strlen(api_token_repository::get_hashable_secret(
+            bin2hex(random_bytes(32)),
+            array_fill(0, 50, 'core_grades:grade:read'),
+            null,
+        )));
