+        global $DB;
+
+        $this->resetAfterTest();
+
+        $user = $this->getDataGenerator()->create_user();
+        $repository = new api_token_repository();
+
+        $token = $repository->create_token(
+            'Test',
+            'correctsecret',
+            $user->id,
+            ['scope'],
+            null,
+            time() + HOURSECS,
+        );
+
+        // The untouched token validates.
+        $this->assertEquals($token->get_id(), $repository->validate_token($token->get_id(), 'correctsecret')->get_id());
