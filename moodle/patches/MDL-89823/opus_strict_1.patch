+    /**
+     * Combine a secret with an integrity check value calculated from the token's scopes and expiry.
+     *
+     * The result is what gets hashed for storage, and what a presented secret is verified against,
+     * so any change to the stored scopes or expiry makes the stored hash stop matching.
+     *
+     * The value is an HMAC keyed with the secret, which keeps it to a fixed 64 characters: the
+     * default password hashing algorithm (bcrypt) ignores anything beyond 72 bytes, so simply
+     * appending the scopes to the secret could leave them outside of what is actually hashed.
+     *
+     * @param string $secret The raw secret.
+     * @param string[] $scopes The scopes granted to the token.
+     * @param int|null $expirytime The token expiry timestamp, or null if it never expires.
+     * @return string
+     */
+    protected static function get_hashable_secret(
+        #[\SensitiveParameter]
+        string $secret,
+        array $scopes,
+        ?int $expirytime,
+    ): string {
+        $integrity = json_encode([
+            'scopes' => array_values(array_map('strval', $scopes)),
+            'expirytime' => $expirytime,
+        ]);
+
+        return hash_hmac('sha256', $integrity, $secret);
+    }
