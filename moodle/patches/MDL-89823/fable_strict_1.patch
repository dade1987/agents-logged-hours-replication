+    /**
+     * Combine a raw secret with the token's scopes and expiry into the value which is hashed and stored.
+     *
+     * The scopes and expiry act as an integrity check: they are folded into the value before it is
+     * hashed, so the stored hash only verifies while the row still carries the scopes and expiry the
+     * token was issued with. Editing either directly in the database invalidates the token rather than
+     * extending its remit.
+     *
+     * The combined value is itself digested first, because bcrypt only considers the first 72 bytes of
+     * its input and a 64 character secret followed by a list of scopes would otherwise be truncated,
+     * silently dropping the very data the check is meant to cover.
+     *
+     * @param string $secret The raw secret.
+     * @param string $scopes The scopes, space separated as they are stored.
+     * @param int|null $expirytime The expiry timestamp, or null if the token never expires.
+     * @return string
+     */
+    protected static function get_hashable_secret(
+        #[\SensitiveParameter]
+        string $secret,
+        string $scopes,
+        ?int $expirytime,
+    ): string {
+        $integrity = implode("\n", [
+            $scopes,
+            $expirytime === null ? '' : (string) $expirytime,
+        ]);
+
+        return hash('sha256', "{$secret}\n{$integrity}");
+    }
+
