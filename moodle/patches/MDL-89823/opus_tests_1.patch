+    /**
+     * Tampering with the remit of a token directly in the database invalidates it.
+     *
+     * @param string $field The field to tamper with.
+     * @param callable $value Produces the new value from the original record.
+     */
+    #[DataProvider('tampered_token_provider')]
+    public function test_validate_token_detects_tampering(string $field, callable $value): void {
+        global $DB;
+
+        $this->resetAfterTest();
+
+        $user = $this->getDataGenerator()->create_user();
+        $repository = new api_token_repository();
+
+        $token = $repository->create_token(
+            'Test',
+            'correctsecret',
+            $user->id,
+            ['scope:one', 'scope:two'],
+            null,
+            time() + HOURSECS,
+        );
+
+        // Untouched, the token validates.
+        $this->assertEquals($token->get_id(), $repository->validate_token($token->get_id(), 'correctsecret')->get_id());
+
+        $record = $DB->get_record('rest_api_tokens', ['id' => $token->get_id()], '*', MUST_EXIST);
+        $DB->set_field('rest_api_tokens', $field, $value($record), ['id' => $token->get_id()]);
+
+        $this->expectException(\core\exception\invalid_api_token_exception::class);
+        $repository->validate_token($token->get_id(), 'correctsecret');
+    }
+
+    /**
+     * Data provider for {@see test_validate_token_detects_tampering}.
+     *
+     * @return array
+     */
+    public static function tampered_token_provider(): array {
+        return [
+            'scope added' => ['scopes', fn($record) => $record->scopes . ' scope:three'],
+            'scope removed' => ['scopes', fn($record) => 'scope:one'],
+            'scopes reordered' => ['scopes', fn($record) => 'scope:two scope:one'],
+            'expiry extended' => ['expirytime', fn($record) => $record->expirytime + YEARSECS],
+            'expiry removed' => ['expirytime', fn($record) => null],
+            'owner changed' => ['userid', fn($record) => $record->userid + 1],
+        ];
+    }
