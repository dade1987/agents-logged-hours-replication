+    /**
+     * Combine a raw secret with an integrity value derived from the token's remit.
+     *
+     * The result is what is hashed for storage, and what is verified against that hash. Binding the
+     * owner, scopes and expiry into it means that any change to those values in the database
+     * invalidates the token, so its remit cannot be extended without knowing the secret.
+     *
+     * A keyed digest is used rather than simple concatenation because password_hash() (bcrypt)
+     * only considers the first 72 bytes of its input, which would silently drop the integrity value.
+     *
+     * @param string $secret The raw secret.
+     * @param int $userid The owner of the token.
+     * @param string $scopes The scopes, space separated, exactly as stored.
+     * @param int|null $expirytime The expiry timestamp, or null if the token never expires.
+     * @return string
+     */
+    protected static function get_hashable_secret(
+        #[\SensitiveParameter]
+        string $secret,
+        int $userid,
+        string $scopes,
+        ?int $expirytime,
+    ): string {
+        $integrity = implode("\n", [
+            $userid,
+            $scopes,
+            $expirytime ?? '',
+        ]);
+
+        return hash_hmac('sha256', $integrity, $secret);
+    }
