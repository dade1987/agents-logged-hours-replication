+    /**
+     * Modifying the scopes or expiry directly in the database invalidates the token.
+     */
+    public function test_validate_token_detects_tampering(): void {
+        global $DB;
+        $this->resetAfterTest();
+
+        $user = $this->getDataGenerator()->create_user();
+        $repository = new api_token_repository();
+        $future = time() + DAYSECS;
+
+        $token = $repository->create_token('Test', 'secret', $user->id, ['scope'], null, $future);
+        $this->assertEquals($token->get_id(), $repository->validate_token($token->get_id(), 'secret')->get_id());
+
+        $DB->set_field('rest_api_tokens', 'scopes', 'scope otherscope', ['id' => $token->get_id()]);
+        try {
+            $repository->validate_token($token->get_id(), 'secret');
+            $this->fail('Expected exception');
+        } catch (\core\exception\invalid_api_token_exception $e) {
+            $this->assertInstanceOf(\core\exception\invalid_api_token_exception::class, $e);
+        }
+
+        $DB->set_field('rest_api_tokens', 'scopes', 'scope', ['id' => $token->get_id()]);
+        $DB->set_field('rest_api_tokens', 'expirytime', $future + DAYSECS, ['id' => $token->get_id()]);
+        $this->expectException(\core\exception\invalid_api_token_exception::class);
+        $repository->validate_token($token->get_id(), 'secret');
+    }
