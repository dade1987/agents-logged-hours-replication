+    /**
+     * Build the value which is hashed and stored for a token.
+     *
+     * The scopes and expiry are bound into the hashed value, so a token whose scopes or expiry were
+     * modified directly in the database no longer verifies.
+     *
+     * @param string $secret The raw secret.
+     * @param string[] $scopes The scopes granted to the token.
+     * @param int|null $expirytime The expiry timestamp.
+     * @return string
+     */
+    protected static function get_hash_input(
+        #[\SensitiveParameter]
+        string $secret,
+        array $scopes,
+        ?int $expirytime,
+    ): string {
+        $scopes = array_values(array_unique($scopes));
+        sort($scopes);
+
+        $data = json_encode([
+            'scopes' => $scopes,
+            'expirytime' => $expirytime === null ? null : (int) $expirytime,
+        ]);
+
+        // An HMAC keyed by the secret keeps the result short enough (64 characters) for bcrypt, which
+        // ignores everything beyond 72 bytes, so no part of the integrity data is truncated.
+        return hash_hmac('sha256', $data, $secret);
+    }
