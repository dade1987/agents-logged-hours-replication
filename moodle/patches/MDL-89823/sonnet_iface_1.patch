+    /**
+     * Combine the raw secret with the token scopes and expiry, so that the stored hash also protects them.
+     *
+     * If the scopes or expiry are modified directly in the database, verification will fail.
+     *
+     * @param string $secret The raw secret.
+     * @param string[] $scopes The scopes.
+     * @param int|null $expirytime The expiry timestamp.
+     * @return string
+     */
+    protected function get_integrity_secret(
+        #[\SensitiveParameter]
+        string $secret,
+        array $scopes,
+        ?int $expirytime,
+    ): string {
+        return json_encode([$secret, array_values($scopes), $expirytime]);
+    }
+
+    /**
+     * Pre-hash a secret so that input of any length can be safely passed to password_hash.
+     *
+     * Bcrypt truncates its input, so the value is first reduced to a fixed-length digest.
+     *
+     * @param string $secret The value to pre-hash.
+     * @return string
+     */
+    protected function prehash_secret(
+        #[\SensitiveParameter]
+        string $secret,
+    ): string {
+        return hash('sha256', $secret);
+    }
