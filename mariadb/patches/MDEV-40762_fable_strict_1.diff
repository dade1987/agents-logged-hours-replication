diff --git a/mysql-test/main/desc_index_range.test b/mysql-test/main/desc_index_range.test
index 36f4c406..1f52d486 100644
--- a/mysql-test/main/desc_index_range.test
+++ b/mysql-test/main/desc_index_range.test
@@ -396,3 +396,46 @@ eval EXPLAIN $query;
 eval $query;
 
 drop table t20;
+
+--echo #
+--echo # MDEV-40762 Wrong MAX() result with GROUP BY when loose index scan
+--echo #            uses DESC key part
+--echo #
+
+# The ASC index comes first and is chosen for the loose index scan, but
+# the key part of the MIN/MAX argument used to be taken from the last
+# examined index (the DESC one), making the scan read MIN instead of MAX
+# and vice versa.
+create table t1 (a int, b int, key k_asc (a, b), key k_desc (a, b desc));
+insert into t1 values (1, 9), (1, 6), (1, 3), (2, 5), (2, 7);
+let $query=
+SELECT a, MAX(b), MIN(b) FROM t1 GROUP BY a;
+eval EXPLAIN $query;
+eval $query;
+let $query=
+SELECT a, MAX(b) FROM t1 GROUP BY a;
+eval EXPLAIN $query;
+eval $query;
+let $query=
+SELECT a, MIN(b) FROM t1 GROUP BY a;
+eval EXPLAIN $query;
+eval $query;
+drop table t1;
+
+# The DESC index comes first and is chosen for the loose index scan, but
+# the key part of the MIN/MAX argument used to be taken from the ASC one.
+create table t1 (a int, b int, key k_desc (a, b desc), key k_asc (a, b));
+insert into t1 values (1, 9), (1, 6), (1, 3), (2, 5), (2, 7);
+let $query=
+SELECT a, MAX(b), MIN(b) FROM t1 GROUP BY a;
+eval EXPLAIN $query;
+eval $query;
+let $query=
+SELECT a, MAX(b) FROM t1 GROUP BY a;
+eval EXPLAIN $query;
+eval $query;
+let $query=
+SELECT a, MIN(b) FROM t1 GROUP BY a;
+eval EXPLAIN $query;
+eval $query;
+drop table t1;
