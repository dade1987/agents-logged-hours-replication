 je
 NULL
 #
+# MDEV-39817 JSON_ARRAYAGG() returns garbage because of off-by-one error
+#
+set session group_concat_max_len = 9;
+create temporary table t (c varchar(20) character set latin1);
+insert into t values ('ab'), ('cd'), ('ef');
+select json_arrayagg(c order by c) from t;
+json_arrayagg(c order by c)
+["ab","cd"]
+Warnings:
+Warning	1260	Row 3 was cut by JSON_ARRAYAGG()
+select json_arrayagg(c) from t;
+json_arrayagg(c)
+["ab","cd"]
+Warnings:
+Warning	1260	Row 3 was cut by JSON_ARRAYAGG()
+set session group_concat_max_len = 10;
+select json_arrayagg(c order by c) from t;
+json_arrayagg(c order by c)
+["ab","cd"]
+Warnings:
+Warning	1260	Row 3 was cut by JSON_ARRAYAGG()
+drop temporary table t;
+set session group_concat_max_len = default;
