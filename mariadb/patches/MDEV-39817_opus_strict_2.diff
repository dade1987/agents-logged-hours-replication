diff --git a/sql/item_jsonfunc.cc b/sql/item_jsonfunc.cc
index cf5bb9be..e16f8e40 100644
--- a/sql/item_jsonfunc.cc
+++ b/sql/item_jsonfunc.cc
@@ -4101,6 +4101,18 @@ void Item_func_json_arrayagg::cut_max_length(String *result,
     return;
   }
 
+  /*
+    We need room for at least one byte of the new value plus the closing
+    quote. If there is none (old_length can be equal to max_length),
+    drop the new value completely; otherwise max_length-1 could be less
+    than old_length, which would produce a negative length cut.
+  */
+  if (old_length + 1 >= max_length)
+  {
+    result->length(old_length);
+    return;
+  }
+
   Item_func_group_concat::cut_max_length(result, old_length, max_length-1);
   result->append('"');
 }
