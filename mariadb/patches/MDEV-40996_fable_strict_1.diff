diff --git a/client/mysqltest.cc b/client/mysqltest.cc
index d43b1c79..f4d8ea9b 100644
--- a/client/mysqltest.cc
+++ b/client/mysqltest.cc
@@ -5340,8 +5340,8 @@ void do_sync_with_master(struct st_command *command)
   long offset= 0;
   char *p= command->first_argument;
   const char *offset_start= p;
-  char *start, *buff= 0;
-  start= const_cast<char*>("");
+  const char *connection_name= "";
+  char *buff= 0, *buff_start= 0;
 
   if (*offset_start)
   {
@@ -5358,15 +5358,22 @@ void do_sync_with_master(struct st_command *command)
       p++;
       while (*p && my_isspace(charset_info, *p))
         p++;
-      start= buff= (char*)my_malloc(PSI_NOT_INSTRUMENTED, strlen(p)+1,
-                                    MYF(MY_WME|MY_FAE));
-      get_string(&buff, &p, command);
+      buff_start= buff= (char*)my_malloc(PSI_NOT_INSTRUMENTED, strlen(p)+1,
+                                         MYF(MY_WME|MY_FAE));
+      /*
+        get_string() returns the parsed string, or, if the argument is a
+        '$variable', the value of that variable. Use the returned pointer,
+        not the raw buffer, so that
+          --sync_with_master 0, $connection_name
+        works.
+      */
+      connection_name= get_string(&buff, &p, command);
     }
     command->last_argument= p;
   }
-  do_sync_with_master2(command, offset, start);
-  if (buff)
-    my_free(start);
+  do_sync_with_master2(command, offset, connection_name);
+  if (buff_start)
+    my_free(buff_start);
   return;
 }
 
