+#
+# MDEV-39194 SUM(b'1100') and SUM(DISTINCT b'1100') return different
+#            numeric results for the same BIT literal
+#
+SELECT SUM(b'1100'), SUM(DISTINCT b'1100');
+SUM(b'1100')	SUM(DISTINCT b'1100')
+12	12
+SELECT AVG(b'1100'), AVG(DISTINCT b'1100');
+AVG(b'1100')	AVG(DISTINCT b'1100')
+12.0000	12.0000
+SELECT SUM(0x0C), SUM(DISTINCT 0x0C);
+SUM(0x0C)	SUM(DISTINCT 0x0C)
+12	12
+SELECT SUM(0xFFFFFFFFFFFFFFFF), SUM(DISTINCT 0xFFFFFFFFFFFFFFFF);
+SUM(0xFFFFFFFFFFFFFFFF)	SUM(DISTINCT 0xFFFFFFFFFFFFFFFF)
+18446744073709551615	18446744073709551615
