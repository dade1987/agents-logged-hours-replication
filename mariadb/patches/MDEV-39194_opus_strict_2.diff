+++ b/sql/item_sum.cc
@@ -916,7 +916,16 @@ bool Aggregator_distinct::setup(THD *thd)
     if (always_null)
       DBUG_RETURN(FALSE);
 
-    Field *field= arg->type_handler()->
+    /*
+      Use cast_to_int_type_handler() to get the numeric data type that
+      the argument has in numeric context, e.g. hex hybrid literals
+      (0xHHHH, b'BBBB') behave as BIGINT UNSIGNED, and ENUM/SET as BIGINT.
+      This is consistent with what Item_sum_sum::fix_length_and_dec() and
+      Item_sum_avg::fix_length_and_dec() do. Otherwise, a DOUBLE field
+      of a too small precision (based on the argument string length)
+      could be created and the values would be truncated (MDEV-39194).
+    */
+    Field *field= arg->cast_to_int_type_handler()->
                     make_num_distinct_aggregator_field(thd->mem_root, arg);
     if (!field || !(table= create_virtual_tmp_table(thd, field)))
       DBUG_RETURN(TRUE);
