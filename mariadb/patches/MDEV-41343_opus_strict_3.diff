diff --git a/mysql-test/main/deny_revoke_public.result b/mysql-test/main/deny_revoke_public.result
index a82947a6..fc66de2d 100644
--- a/mysql-test/main/deny_revoke_public.result
+++ b/mysql-test/main/deny_revoke_public.result
@@ -165,6 +165,38 @@ REVOKE DENY SELECT ON test.t1 FROM r1;
 DROP USER u_role@localhost;
 DROP ROLE r1;
 #
+# MDEV-41343 REVOKE DENY ... FROM PUBLIC bypass via unrelated
+# column-level UPDATE grant on mysql.global_priv
+#
+CREATE USER u_colpriv@localhost;
+GRANT SELECT ON test.t1 TO u_colpriv@localhost;
+GRANT UPDATE (Host) ON mysql.global_priv TO u_colpriv@localhost;
+DENY SELECT ON test.t1 TO PUBLIC;
+connect  con_colpriv1, localhost, u_colpriv,,test;
+SELECT * FROM t1;
+ERROR 42000: SELECT command denied to user 'u_colpriv'@'localhost' for table `test`.`t1`
+UPDATE mysql.global_priv SET Priv='{}' WHERE User='u_colpriv';
+ERROR 42000: UPDATE command denied to user 'u_colpriv'@'localhost' for column 'Priv' in table 'global_priv'
+# Should FAIL - UPDATE(Host) does not allow changing Priv
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+ERROR 42000: SELECT, GRANT command denied to user 'u_colpriv'@'localhost' for table `test`.`t1`
+SELECT * FROM t1;
+ERROR 42000: SELECT command denied to user 'u_colpriv'@'localhost' for table `test`.`t1`
+disconnect con_colpriv1;
+connection default;
+GRANT UPDATE (Priv) ON mysql.global_priv TO u_colpriv@localhost;
+connect  con_colpriv2, localhost, u_colpriv,,test;
+SELECT * FROM t1;
+ERROR 42000: SELECT command denied to user 'u_colpriv'@'localhost' for table `test`.`t1`
+# Should succeed - UPDATE(Priv) is enough to edit the DENY entries
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+SELECT * FROM t1;
+id	data
+1	100
+disconnect con_colpriv2;
+connection default;
+DROP USER u_colpriv@localhost;
+#
 # Known limitation: denying the bypass's own privilege is unrecoverable
 #
 DENY UPDATE ON *.* TO PUBLIC;
diff --git a/mysql-test/main/deny_revoke_public.test b/mysql-test/main/deny_revoke_public.test
index 9df13f0a..5d63a1cc 100644
--- a/mysql-test/main/deny_revoke_public.test
+++ b/mysql-test/main/deny_revoke_public.test
@@ -190,6 +190,41 @@ REVOKE DENY SELECT ON test.t1 FROM r1;
 DROP USER u_role@localhost;
 DROP ROLE r1;
 
+--echo #
+--echo # MDEV-41343 REVOKE DENY ... FROM PUBLIC bypass via unrelated
+--echo # column-level UPDATE grant on mysql.global_priv
+--echo #
+CREATE USER u_colpriv@localhost;
+GRANT SELECT ON test.t1 TO u_colpriv@localhost;
+GRANT UPDATE (Host) ON mysql.global_priv TO u_colpriv@localhost;
+DENY SELECT ON test.t1 TO PUBLIC;
+
+connect (con_colpriv1, localhost, u_colpriv,,test);
+--error ER_TABLEACCESS_DENIED_ERROR
+SELECT * FROM t1;
+--error ER_COLUMNACCESS_DENIED_ERROR
+UPDATE mysql.global_priv SET Priv='{}' WHERE User='u_colpriv';
+--echo # Should FAIL - UPDATE(Host) does not allow changing Priv
+--error ER_TABLEACCESS_DENIED_ERROR
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+--error ER_TABLEACCESS_DENIED_ERROR
+SELECT * FROM t1;
+disconnect con_colpriv1;
+connection default;
+
+GRANT UPDATE (Priv) ON mysql.global_priv TO u_colpriv@localhost;
+
+connect (con_colpriv2, localhost, u_colpriv,,test);
+--error ER_TABLEACCESS_DENIED_ERROR
+SELECT * FROM t1;
+--echo # Should succeed - UPDATE(Priv) is enough to edit the DENY entries
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+SELECT * FROM t1;
+disconnect con_colpriv2;
+connection default;
+
+DROP USER u_colpriv@localhost;
+
 --echo #
 --echo # Known limitation: denying the bypass's own privilege is unrecoverable
 --echo #
diff --git a/sql/sql_acl.cc b/sql/sql_acl.cc
index 70984625..26ddf2bc 100644
--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -14419,13 +14419,27 @@ bool Sql_cmd_grant::should_bypass_revoke_deny(THD *thd)
       return false;
   }
 
-  /* Does current user have UPDATE grant for mysql.global_priv ? */
+  /*
+    Does current user have UPDATE grant for mysql.global_priv ?
+    DENY entries are stored in the Priv column, so the user must be able
+    to UPDATE that column (either through table/db/global level UPDATE
+    or through a column-level UPDATE(Priv) grant). A column-level UPDATE
+    on some other column (e.g. Host) is not sufficient.
+  */
   TABLE_LIST tl;
   tl.init_one_table(&MYSQL_SCHEMA_NAME, &MYSQL_TABLE_NAME[USER_TABLE],
                     NULL, TL_WRITE);
-  return !check_access(thd, UPDATE_ACL, tl.db.str, &tl.grant.privilege,
-                       &tl.grant.m_internal, 0, 1) &&
-         !check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE);
+  if (check_access(thd, UPDATE_ACL, tl.db.str, &tl.grant.privilege,
+                   &tl.grant.m_internal, 0, 1) ||
+      check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE))
+    return false;
+
+  /*
+    check_grant() above succeeds also when UPDATE is granted only on some
+    columns of the table. Verify that the Priv column is updatable.
+  */
+  return (get_column_grant(thd, &tl.grant, tl.db.str, tl.table_name.str,
+                           "Priv"_Lex_ident_column) & UPDATE_ACL) != NO_ACL;
 }
 
 
