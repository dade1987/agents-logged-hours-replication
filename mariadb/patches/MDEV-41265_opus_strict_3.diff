@@ -2550,4 +2550,41 @@ eq	counter
 1	4
 1	5
 DROP FUNCTION f1;
+#
+# MDEV-41265 SELECT/ UPDATE RETURNING INTO a single row-field fails with ER_WRONG_NUMBER_OF_COLUMNS_IN_SELECT
+#
+CREATE TABLE t1 (a INT, b VARCHAR(10));
+INSERT INTO t1 VALUES (10,'b10');
+CREATE PROCEDURE p1()
+BEGIN
+DECLARE r0 ROW (a INT, b VARCHAR(10));
+SELECT a INTO r0.a FROM t1;
+SELECT r0.a;
+END;
+$$
+CALL p1;
+r0.a
+10
+DROP PROCEDURE p1;
+CREATE PROCEDURE p1()
+BEGIN
+DECLARE r0 ROW (a INT, b VARCHAR(10));
+SELECT a, b INTO r0.a FROM t1;
+END;
+$$
+CALL p1;
+ERROR 21000: The used SELECT statements have a different number of columns
+DROP PROCEDURE p1;
+CREATE PROCEDURE p1()
+BEGIN
+DECLARE r0 ROW TYPE OF t1;
+SELECT b INTO r0.b FROM t1;
+SELECT r0.b;
+END;
+$$
+CALL p1;
+r0.b
+b10
+DROP PROCEDURE p1;
+DROP TABLE t1;
 # End of 11.8 tests
