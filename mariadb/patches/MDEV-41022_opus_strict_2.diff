diff --git a/storage/innobase/fts/fts0que.cc b/storage/innobase/fts/fts0que.cc
index b8f22076..b9012880 100644
--- a/storage/innobase/fts/fts0que.cc
+++ b/storage/innobase/fts/fts0que.cc
@@ -2726,6 +2726,12 @@ fts_query_phrase_search(
 	tokens = ib_vector_create(heap_alloc, sizeof(fts_string_t), 4);
 	orig_tokens = ib_vector_create(heap_alloc, sizeof(fts_string_t), 4);
 
+	/* Remember the search mode, so that it can be restored once
+	the phrase or proximity search is done. Otherwise the following
+	terms of the query would still be treated as phrase terms,
+	e.g. a wildcard term would not be expanded in the FTS cache. */
+	const ulint		saved_flags = query->flags;
+
 	if (query->distance != ULINT_UNDEFINED && query->distance > 0) {
 		query->flags = FTS_PROXIMITY;
 	} else {
@@ -2893,6 +2899,9 @@ fts_query_phrase_search(
 	/* Don't need it anymore. */
 	query->matched = NULL;
 
+	/* Restore the search mode. */
+	query->flags = saved_flags;
+
 	return(query->error);
 }
 
