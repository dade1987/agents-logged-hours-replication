diff --git a/mysql-test/suite/innodb_fts/r/optimize_ext_ilist.result b/mysql-test/suite/innodb_fts/r/optimize_ext_ilist.result
new file mode 100644
index 00000000..8932c59e
--- /dev/null
+++ b/mysql-test/suite/innodb_fts/r/optimize_ext_ilist.result
@@ -0,0 +1,28 @@
+#
+# MDEV-40621 InnoDB: Failing assertion: doc_id == src_node->last_doc_id
+#
+CREATE TABLE t1 (id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
+body MEDIUMTEXT, FULLTEXT KEY ftidx (body)) ENGINE=InnoDB;
+INSERT INTO t1 (body) SELECT REPEAT('megaword ', 30) FROM seq_1_to_260;
+SET @saved_optimize_fulltext_only = @@GLOBAL.innodb_optimize_fulltext_only;
+SET GLOBAL innodb_optimize_fulltext_only = ON;
+DELETE FROM t1 WHERE id = 1;
+OPTIMIZE TABLE t1;
+Table	Op	Msg_type	Msg_text
+test.t1	optimize	status	OK
+SELECT COUNT(*) FROM t1 WHERE MATCH(body) AGAINST('megaword' IN BOOLEAN MODE);
+COUNT(*)
+259
+DELETE FROM t1 WHERE id IN (2, 130, 260);
+OPTIMIZE TABLE t1;
+Table	Op	Msg_type	Msg_text
+test.t1	optimize	status	OK
+SELECT COUNT(*) FROM t1 WHERE MATCH(body) AGAINST('megaword' IN BOOLEAN MODE);
+COUNT(*)
+256
+SELECT COUNT(*) FROM t1 WHERE MATCH(body) AGAINST('+megaword' IN BOOLEAN MODE)
+AND id IN (1, 2, 130, 260);
+COUNT(*)
+0
+SET GLOBAL innodb_optimize_fulltext_only = @saved_optimize_fulltext_only;
+DROP TABLE t1;
diff --git a/mysql-test/suite/innodb_fts/t/optimize_ext_ilist.test b/mysql-test/suite/innodb_fts/t/optimize_ext_ilist.test
new file mode 100644
index 00000000..ce4a839d
--- /dev/null
+++ b/mysql-test/suite/innodb_fts/t/optimize_ext_ilist.test
@@ -0,0 +1,25 @@
+--source include/have_innodb.inc
+--source include/have_sequence.inc
+
+--echo #
+--echo # MDEV-40621 InnoDB: Failing assertion: doc_id == src_node->last_doc_id
+--echo #
+
+# The ilist of a word in the FTS auxiliary index table must be read
+# completely by OPTIMIZE TABLE even when it is stored off-page.
+
+CREATE TABLE t1 (id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
+                 body MEDIUMTEXT, FULLTEXT KEY ftidx (body)) ENGINE=InnoDB;
+INSERT INTO t1 (body) SELECT REPEAT('megaword ', 30) FROM seq_1_to_260;
+SET @saved_optimize_fulltext_only = @@GLOBAL.innodb_optimize_fulltext_only;
+SET GLOBAL innodb_optimize_fulltext_only = ON;
+DELETE FROM t1 WHERE id = 1;
+OPTIMIZE TABLE t1;
+SELECT COUNT(*) FROM t1 WHERE MATCH(body) AGAINST('megaword' IN BOOLEAN MODE);
+DELETE FROM t1 WHERE id IN (2, 130, 260);
+OPTIMIZE TABLE t1;
+SELECT COUNT(*) FROM t1 WHERE MATCH(body) AGAINST('megaword' IN BOOLEAN MODE);
+SELECT COUNT(*) FROM t1 WHERE MATCH(body) AGAINST('+megaword' IN BOOLEAN MODE)
+  AND id IN (1, 2, 130, 260);
+SET GLOBAL innodb_optimize_fulltext_only = @saved_optimize_fulltext_only;
+DROP TABLE t1;
