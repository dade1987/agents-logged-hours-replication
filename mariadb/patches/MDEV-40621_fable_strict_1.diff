+    byte *external_ilist= btr_copy_externally_stored_field(
+      &external_len, ilist_data, index->table->space->zip_size(),
+      ilist_len, ilist_heap);
+    if (!external_ilist)
+    {
+      /* Incomplete externally stored field (fresh insert being
+      rolled back); pretend that the record does not exist. */
+      mem_heap_free(ilist_heap);
+      return DB_SUCCESS;
+    }
+    ilist_data= external_ilist;
+    ilist_len= external_len;
+  }
