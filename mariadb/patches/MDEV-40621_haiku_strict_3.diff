diff --git a/storage/innobase/fts/fts0exec.cc b/storage/innobase/fts/fts0exec.cc
index 197eebc6..6271ab9b 100644
--- a/storage/innobase/fts/fts0exec.cc
+++ b/storage/innobase/fts/fts0exec.cc
@@ -764,6 +764,29 @@ dberr_t AuxRecordReader::default_word_processor(
   ulint ilist_len;
   const byte* ilist_data= rec_get_nth_field(rec, offsets, 6, &ilist_len);
 
+  /* A large ilist may be stored off-page. rec_get_nth_field() then
+  returns only the locally stored prefix, so the complete ilist must
+  be fetched, otherwise the node would be truncated and the optimizer
+  would decode garbage or fail its consistency checks. */
+  mem_heap_t* ilist_heap= nullptr;
+  if (ilist_data && ilist_len != UNIV_SQL_NULL && ilist_len > 0 &&
+      rec_offs_nth_extern(offsets, 6))
+  {
+    ilist_heap= mem_heap_create(ilist_len + 1000);
+    ulint external_len;
+    byte *external_ilist=
+      btr_copy_externally_stored_field(&external_len, ilist_data,
+                                       index->table->space->zip_size(),
+                                       ilist_len, ilist_heap);
+    if (!external_ilist)
+    {
+      mem_heap_free(ilist_heap);
+      return DB_CORRUPTION;
+    }
+    ilist_data= external_ilist;
+    ilist_len= external_len;
+  }
+
   fts_word_t *word;
   bool is_word_init= false;
 
@@ -808,6 +831,11 @@ dberr_t AuxRecordReader::default_word_processor(
       node->ilist= static_cast<byte*>(ut_malloc_nokey(ilist_len));
       memcpy(node->ilist, ilist_data, ilist_len);
     }
+    if (ilist_heap)
+    {
+      mem_heap_free(ilist_heap);
+      ilist_heap= nullptr;
+    }
     if (ilist_len == 0) return DB_SUCCESS_LOCKED_REC;
   }
 
