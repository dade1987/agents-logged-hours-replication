diff --git a/sql/item_jsonfunc.cc b/sql/item_jsonfunc.cc
index 615d0cb4..55213e4f 100644
--- a/sql/item_jsonfunc.cc
+++ b/sql/item_jsonfunc.cc
@@ -4799,6 +4799,14 @@ bool json_compare_arrays_in_order(json_engine_t *js, json_engine_t *value)
       return FALSE;
     if (js->value_type != value->value_type)
     {
+      /*
+        Skip the just-read values if they are non-scalar (they opened a new
+        level), then skip the rest of the arrays being compared.
+      */
+      if (!json_value_scalar(js))
+        json_skip_level(js);
+      if (!json_value_scalar(value))
+        json_skip_level(value);
       json_skip_current_level(js, value);
       return FALSE;
     }
@@ -4809,10 +4817,22 @@ bool json_compare_arrays_in_order(json_engine_t *js, json_engine_t *value)
       return FALSE;
     }
   }
-  res= (value->state == JST_ARRAY_END || value->state == JST_OBJ_END ?
-        TRUE : FALSE);
-  json_skip_current_level(js, value);
-  return res;
+  /*
+    The arrays are equal only if both of them got exhausted at the same
+    time, i.e. both are at the end now. Otherwise one of them has more
+    elements than the other (e.g. '[1]' vs '[]') and they do not match.
+    Note that when an engine is at JST_ARRAY_END its stack is already
+    popped, so calling json_skip_level() on it would skip the parent
+    structure. Hence only skip the one(s) that did not reach the end yet.
+  */
+  if (js->state == JST_ARRAY_END && value->state == JST_ARRAY_END)
+    return TRUE;
+
+  if (js->state != JST_ARRAY_END)
+    json_skip_level(js);
+  if (value->state != JST_ARRAY_END)
+    json_skip_level(value);
+  return FALSE;
 }
 
 
