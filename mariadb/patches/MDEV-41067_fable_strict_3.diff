+#
+# MDEV-41067: wrong result with json_overlaps when one of the arguments
+# has an empty nested array element
+#
+SELECT JSON_OVERLAPS('[[1]]', '[[]]');
+JSON_OVERLAPS('[[1]]', '[[]]')
+0
+SELECT JSON_OVERLAPS('[[1]]', '[[],123]');
+JSON_OVERLAPS('[[1]]', '[[],123]')
+0
+SELECT JSON_OVERLAPS('[[]]', '[[1]]');
+JSON_OVERLAPS('[[]]', '[[1]]')
+0
+SELECT JSON_OVERLAPS('[[]]', '[[]]');
+JSON_OVERLAPS('[[]]', '[[]]')
+1
+SELECT JSON_OVERLAPS('[[1,2]]', '[[1]]');
+JSON_OVERLAPS('[[1,2]]', '[[1]]')
+0
+SELECT JSON_OVERLAPS('[[1]]', '[[1,2]]');
+JSON_OVERLAPS('[[1]]', '[[1,2]]')
+0
+SELECT JSON_OVERLAPS('[[1],2]', '[[],2]');
+JSON_OVERLAPS('[[1],2]', '[[],2]')
+1
+SELECT JSON_OVERLAPS('[[[1]],2]', '[[[1]],3]');
+JSON_OVERLAPS('[[[1]],2]', '[[[1]],3]')
+1
+SELECT JSON_OVERLAPS('[[[1]],2]', '[[[1],5]],3]');
+JSON_OVERLAPS('[[[1]],2]', '[[[1],5]],3]')
+0
+SELECT JSON_OVERLAPS('{"a":[1]}', '{"a":[]}');
+JSON_OVERLAPS('{"a":[1]}', '{"a":[]}')
+0
+SELECT JSON_OVERLAPS('{"a":[]}', '{"a":[]}');
+JSON_OVERLAPS('{"a":[]}', '{"a":[]}')
+1
+SELECT JSON_OVERLAPS('{"a":[[1],2]}', '{"a":[1,3]}');
+JSON_OVERLAPS('{"a":[[1],2]}', '{"a":[1,3]}')
+0
 # End of 11.4 tests
