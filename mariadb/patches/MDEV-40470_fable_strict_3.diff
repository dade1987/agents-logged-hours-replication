diff --git a/sql/structs.h b/sql/structs.h
index aed4dacb..2faa7d4f 100644
--- a/sql/structs.h
+++ b/sql/structs.h
@@ -256,7 +256,17 @@ struct LEX_USER: public AUTHID
   USER_AUTH *auth;
   bool has_auth()
   {
-    return auth && (auth->plugin.length || auth->auth_str.length || auth->pwtext.length);
+    /*
+      An authentication specification can be a chain of alternatives
+      (IDENTIFIED VIA a OR b OR c). The first element may be empty
+      (e.g. IDENTIFIED VIA '' OR ...), so every element must be checked.
+    */
+    for (USER_AUTH *a= auth; a; a= a->next)
+    {
+      if (a->plugin.length || a->auth_str.length || a->pwtext.length)
+        return true;
+    }
+    return false;
   }
 };
 
