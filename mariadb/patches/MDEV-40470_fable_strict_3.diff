+  '' OR mysql_native_password;
+--error ER_DBACCESS_DENIED_ERROR
+GRANT PROXY ON u1@localhost TO u2@localhost IDENTIFIED VIA
+  '' OR mysql_native_password USING '*B7B19DAB1B8A9CAE43FD5D58A5C5B0F3E8E8CBB3';
