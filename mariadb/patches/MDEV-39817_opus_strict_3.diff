diff --git a/sql/item_jsonfunc.cc b/sql/item_jsonfunc.cc
index cf5bb9be..4e00fcd4 100644
--- a/sql/item_jsonfunc.cc
+++ b/sql/item_jsonfunc.cc
@@ -4101,7 +4101,55 @@ void Item_func_json_arrayagg::cut_max_length(String *result,
     return;
   }
 
-  Item_func_group_concat::cut_max_length(result, old_length, max_length-1);
+  /*
+    The last added value is a JSON string. We cut it to max_length-1 bytes
+    and then append the closing quote.
+    old_length is the length of the result before the separator and the
+    new value were appended, so it can be equal to max_length (and thus
+    bigger than max_length-1). Also the cut must keep at least the opening
+    quote of the value, otherwise we would produce garbage (MDEV-39817).
+    In such cases drop the new value (and the separator) completely.
+  */
+  const uint cut_length= max_length - 1;
+  const char *ptr= result->ptr();
+  const char *quote= old_length < result->length() ?
+    (const char *) memchr(ptr + old_length, '"',
+                          result->length() - old_length) : NULL;
+  if (!quote || (uint) (quote - ptr) >= cut_length)
+  {
+    result->length(old_length);
+    return;
+  }
+  const size_t quote_pos= quote - ptr;
+
+  Item_func_group_concat::cut_max_length(result, old_length, cut_length);
+  if (result->length() <= quote_pos)
+  {
+    result->length(old_length);
+    return;
+  }
+
+  /*
+    Don't leave an incomplete escape sequence (like '\' or '\u00')
+    at the end of the cut value.
+  */
+  ptr= result->ptr();
+  const size_t end= result->length();
+  for (size_t i= quote_pos + 1; i < end; )
+  {
+    if (ptr[i] == '\\')
+    {
+      size_t esc_len= (i + 1 < end && ptr[i + 1] == 'u') ? 6 : 2;
+      if (i + esc_len > end)
+      {
+        result->length(i);
+        break;
+      }
+      i+= esc_len;
+    }
+    else
+      i++;
+  }
   result->append('"');
 }
 
