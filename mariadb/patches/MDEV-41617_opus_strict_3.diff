+insert t1 (id, a) values (3, 'c1');
+update t1 set a= 'a3' where id = 1;
+check table t1 extended;
+Table	Op	Msg_type	Msg_text
+test.t1	check	status	OK
+select * from t1 force index (v) order by v;
+id	a	v
+1	a3	v-a3
+2	b1	v-b1
+3	c1	v-c1
+set debug_dbug= default;
+drop table t1;
 # End of 10.6 tests
