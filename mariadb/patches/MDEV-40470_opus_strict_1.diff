diff --git a/sql/sql_acl.cc b/sql/sql_acl.cc
index d4a7606d..6a55af9a 100644
--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -7131,8 +7131,13 @@ static bool copy_and_check_auth(LEX_USER *to, LEX_USER *from, THD *thd)
 {
   to->auth= from->auth;
 
-  // if changing auth for an existing user
-  if (has_auth(to, thd->lex) && find_user_exact(to->host.str, to->user.str))
+  /*
+    If changing auth for an existing user. Note that any IDENTIFIED clause
+    (to->auth != NULL) changes the authentication, even if it specifies
+    an empty password or an empty plugin name, so check it as well.
+  */
+  if ((to->auth || has_auth(to, thd->lex)) &&
+      find_user_exact(to->host.str, to->user.str))
   {
     mysql_mutex_unlock(&acl_cache->lock);
     bool res= check_alter_user(thd, to->host.str, to->user.str);
diff --git a/sql/structs.h b/sql/structs.h
index aed4dacb..cf695173 100644
--- a/sql/structs.h
+++ b/sql/structs.h
@@ -256,7 +256,14 @@ struct LEX_USER: public AUTHID
   USER_AUTH *auth;
   bool has_auth()
   {
-    return auth && (auth->plugin.length || auth->auth_str.length || auth->pwtext.length);
+    /*
+      Any element of the authentication chain may carry authentication
+      data, e.g. IDENTIFIED VIA '' OR mysql_native_password USING ...
+    */
+    for (USER_AUTH *a= auth; a; a= a->next)
+      if (a->plugin.length || a->auth_str.length || a->pwtext.length)
+        return true;
+    return false;
   }
 };
 
