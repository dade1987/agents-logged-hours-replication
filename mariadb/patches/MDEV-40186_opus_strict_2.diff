+insert t1 select seq % 10, seq, seq from seq_1_to_80;
+flush status;
+delete from t1 where a=3 and c>60;
+select * from information_schema.session_status where variable_name like 'handler_r%' and variable_value>0;
+VARIABLE_NAME	VARIABLE_VALUE
+HANDLER_READ_KEY	1
+HANDLER_READ_NEXT	8
+select * from t1 where a=3 order by b;
+a	b	c
+3	3	3
+3	13	13
+3	23	23
+3	33	33
+3	43	43
+3	53	53
+delete from t1;
+insert t1 select seq % 10, seq, seq from seq_1_to_80;
+flush status;
+delete from t1 where a=3;
+select * from information_schema.session_status where variable_name like 'handler_r%' and variable_value>0;
+VARIABLE_NAME	VARIABLE_VALUE
+HANDLER_READ_KEY	1
+HANDLER_READ_NEXT	8
+select count(*) from t1 where a=3;
+count(*)
+0
+delete from t1;
+insert t1 select seq % 10, seq, seq from seq_1_to_80;
+delete from t1 where a=3 and c>40 order by a desc, b desc;
+select * from t1 where a=3 order by b;
+a	b	c
+3	3	3
+3	13	13
+3	23	23
+3	33	33
+select count(*) from t1;
+count(*)
+76
+# End of 10.11 tests
