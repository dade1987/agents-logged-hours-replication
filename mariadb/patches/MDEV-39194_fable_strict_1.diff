 }
 
 
+Field *
+Type_handler_hex_hybrid::make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
+                                                            const Item *item)
+                                                            const
+{
+  /*
+    A hex hybrid (0xHH, b'0101') behaves as an unsigned integer in a numeric
+    context, e.g. SUM(DISTINCT 0x0C). Store it into an unsigned BIGINT field,
+    like Type_handler_int_result does. The generic string-result version
+    creates a Field_double with item->max_length, which is the octet length
+    of the literal (1 for 0x0C), so the integer value would be truncated to
+    the largest value fitting into that display width (12 -> 9).
+  */
+  return new(mem_root)
+         Field_longlong(NULL, MAX_BIGINT_WIDTH,
+                        (uchar *) (item->maybe_null() ? "" : 0),
+                        item->maybe_null() ? 1 : 0, Field::NONE,
+                        &item->name, 0, true);
+}
+
+
 /***********************************************************************/
 
