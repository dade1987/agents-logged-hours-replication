diff --git a/sql/sql_base.cc b/sql/sql_base.cc
index 379337af..66f144e7 100644
--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -4994,8 +4994,15 @@ bool open_and_lock_internal_tables(TABLE *table, bool lock_table)
   TABLE_LIST *tmp= table->internal_tables;
   DML_prelocking_strategy prelocking_strategy;
 
-  if (open_tables(thd, thd->lex->create_info, &tmp, &counter, 0,
-                  &prelocking_strategy))
+  /*
+    The table that owns the internal tables may have been flushed by the
+    caller (for example ALTER TABLE ... LOCK=EXCLUSIVE calls
+    wait_while_table_is_used()). We must not back off and reopen tables
+    in this case, as that would close the tables already opened and locked
+    by the statement. Use MYSQL_OPEN_IGNORE_FLUSH to avoid this.
+  */
+  if (open_tables(thd, thd->lex->create_info, &tmp, &counter,
+                  MYSQL_OPEN_IGNORE_FLUSH, &prelocking_strategy))
     goto err;
 
