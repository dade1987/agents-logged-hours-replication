+#
+# MDEV-31808 Server crash upon altering table with NEXTVAL for default
+# under exclusive lock
+#
+create sequence s;
+create table t (a int default(nextval(s)), b int);
+insert into t (b) values (1);
+alter table t force, algorithm=copy, lock=exclusive;
+insert into t (b) values (2);
+select * from t;
+a	b
+1	1
+2	2
+drop table t;
+drop sequence s;
 # End of 10.6 tests
