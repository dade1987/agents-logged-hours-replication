index 00000000..13b9fc49
--- /dev/null
+++ b/mysql-test/suite/binlog/r/binlog_gtid_slave_pos_autocommit_off.result
@@ -0,0 +1,46 @@
+ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;
+SET @old_gtid_slave_pos= @@GLOBAL.gtid_slave_pos;
+# Implicit commit (DROP TABLE) after SET GLOBAL gtid_slave_pos
+SET autocommit=0;
+CREATE TABLE t1 (c INT) ENGINE=MyISAM;
+SET GLOBAL gtid_slave_pos="0-1-100";
+INSERT INTO t1 VALUES (0);
+DROP TABLE not_there;
+ERROR 42S02: Unknown table 'test.not_there'
+COMMIT;
+# SAVEPOINT after SET GLOBAL gtid_slave_pos
+SET GLOBAL gtid_slave_pos="0-1-101";
+INSERT INTO t1 VALUES (1);
+SAVEPOINT s1;
+INSERT INTO t1 VALUES (2);
+ROLLBACK TO SAVEPOINT s1;
+Warnings:
+Warning	1196	Some non-transactional changed tables couldn't be rolled back
+COMMIT;
+# Explicit transaction after SET GLOBAL gtid_slave_pos
+SET GLOBAL gtid_slave_pos="0-1-102";
+BEGIN;
+INSERT INTO t1 VALUES (3);
+SAVEPOINT s2;
+INSERT INTO t1 VALUES (4);
+ROLLBACK TO SAVEPOINT s2;
+Warnings:
+Warning	1196	Some non-transactional changed tables couldn't be rolled back
+COMMIT;
+SELECT * FROM t1 ORDER BY c;
+c
+0
+1
+2
+3
+4
+SELECT @@GLOBAL.gtid_slave_pos;
+@@GLOBAL.gtid_slave_pos
+0-1-102
+SELECT domain_id, server_id, seq_no FROM mysql.gtid_slave_pos;
+domain_id	server_id	seq_no
+0	1	102
+# Cleanup
+SET autocommit=1;
+DROP TABLE t1;
+SET GLOBAL gtid_slave_pos= @old_gtid_slave_pos;
diff --git a/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test b/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test
new file mode 100644
index 00000000..19fc8098
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test
@@ -0,0 +1,60 @@
+#
+# MDEV-22848: Assertion `trx_is_registered_for_2pc(trx)' failed in
+#             innobase_xa_prepare on DROP and in innobase_savepoint on
+#             SAVEPOINT
+#
+# SET GLOBAL gtid_slave_pos with @@autocommit=0 writes the new position to
+# the (InnoDB) mysql.gtid_slave_pos table outside of any user transaction.
+# The engine must not stay registered in the session's transaction after the
+# position has been committed, otherwise a later implicit commit (DROP TABLE)
+# or SAVEPOINT in the same connection would try to prepare/savepoint an
+# engine transaction that no longer exists.
+#
+--source include/have_innodb.inc
+--source include/have_log_bin.inc
+# Writing the gtid_slave_pos table is format independent, so just use one
+# format to reduce test time.
+--source include/have_binlog_format_mixed.inc
+
+--let $old_slave_pos_engine= query_get_value(SHOW TABLE STATUS FROM mysql LIKE 'gtid_slave_pos', Engine, 1)
+ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;
+
+SET @old_gtid_slave_pos= @@GLOBAL.gtid_slave_pos;
+
+--echo # Implicit commit (DROP TABLE) after SET GLOBAL gtid_slave_pos
+SET autocommit=0;
+CREATE TABLE t1 (c INT) ENGINE=MyISAM;
+SET GLOBAL gtid_slave_pos="0-1-100";
+INSERT INTO t1 VALUES (0);
+--error ER_BAD_TABLE_ERROR
+DROP TABLE not_there;
+COMMIT;
+
+--echo # SAVEPOINT after SET GLOBAL gtid_slave_pos
+SET GLOBAL gtid_slave_pos="0-1-101";
+INSERT INTO t1 VALUES (1);
+SAVEPOINT s1;
+INSERT INTO t1 VALUES (2);
+ROLLBACK TO SAVEPOINT s1;
+COMMIT;
+
+--echo # Explicit transaction after SET GLOBAL gtid_slave_pos
+SET GLOBAL gtid_slave_pos="0-1-102";
+BEGIN;
+INSERT INTO t1 VALUES (3);
+SAVEPOINT s2;
+INSERT INTO t1 VALUES (4);
+ROLLBACK TO SAVEPOINT s2;
+COMMIT;
+
+SELECT * FROM t1 ORDER BY c;
+SELECT @@GLOBAL.gtid_slave_pos;
+SELECT domain_id, server_id, seq_no FROM mysql.gtid_slave_pos;
+
+--echo # Cleanup
+SET autocommit=1;
+DROP TABLE t1;
+SET GLOBAL gtid_slave_pos= @old_gtid_slave_pos;
+--disable_query_log
+--eval ALTER TABLE mysql.gtid_slave_pos ENGINE=$old_slave_pos_engine
+--enable_query_log
diff --git a/sql/rpl_gtid.cc b/sql/rpl_gtid.cc
index 9004aea2..2a7f4071 100644
--- a/sql/rpl_gtid.cc
+++ b/sql/rpl_gtid.cc
@@ -699,6 +699,30 @@ rpl_slave_state::record_gtid(THD *thd, const rpl_gtid *gtid, uint64 sub_id,
   */
   suspended_wfc= thd->suspend_subsequent_commits();
   thd->lex->reset_n_backup_query_tables_list(&lex_backup);
+
+  /*
+    The option bits must be adjusted _before_ the gtid_pos table is opened
+    and locked. When the row is written outside of any user transaction
+    (!in_transaction), the storage engine (eg. InnoDB) must not register
+    itself at the transaction (thd->transaction->all) level, which it would
+    do in external_lock() if OPTION_NOT_AUTOCOMMIT or OPTION_BEGIN were
+    still set (eg. SET GLOBAL gtid_slave_pos with @@autocommit=0, MDEV-22848).
+    Otherwise the engine transaction would be fully committed and
+    de-registered by the statement-level ha_commit_trans() below, but the
+    stale registration in thd->transaction->all would remain and cause a
+    later COMMIT/SAVEPOINT in the same connection to call the engine's
+    prepare/savepoint for a transaction that is no longer registered.
+  */
+  if (!in_transaction)
+  {
+    DBUG_PRINT("info", ("resetting OPTION_BEGIN"));
+    thd->variables.option_bits&=
+      ~(ulonglong)(OPTION_NOT_AUTOCOMMIT |OPTION_BEGIN |OPTION_BIN_LOG |
+                   OPTION_GTID_BEGIN);
+  }
+  else
+    thd->variables.option_bits&= ~(ulonglong)OPTION_BIN_LOG;
+
   tlist.init_one_table(&MYSQL_SCHEMA_NAME, &gtid_pos_table_name, NULL, TL_WRITE);
   if ((err= open_and_lock_tables(thd, &tlist, FALSE, 0)))
     goto end;
@@ -714,16 +738,6 @@ rpl_slave_state::record_gtid(THD *thd, const rpl_gtid *gtid, uint64 sub_id,
   thd->wsrep_ignore_table= true; // Do not replicate mysql.gtid_slave_pos table
 #endif
 
