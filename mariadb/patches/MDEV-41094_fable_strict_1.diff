+--echo #
+--echo # MDEV-41094 KDF() silently reduces large PBKDF2 iteration counts
+--echo #            to weak 32-bit aliases
+--echo #
+# 2^32+1000 must not alias to 1000 iterations
+SELECT HEX(KDF('foo','bar',4294968296,'pbkdf2_hmac',256));
+SELECT HEX(KDF('foo','bar',2147483648,'pbkdf2_hmac',256));
+SELECT HEX(KDF('foo','bar',9223372036854775807,'pbkdf2_hmac',256));
+SELECT HEX(KDF('foo','bar',18446744073709551615,'pbkdf2_hmac',256));
+SELECT HEX(KDF('foo','bar',4294968296)) = HEX(KDF('foo','bar',1000));
+
+--echo #
