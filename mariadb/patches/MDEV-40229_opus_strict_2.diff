diff --git a/mysql-test/main/vector_innodb.test b/mysql-test/main/vector_innodb.test
index e083d958..2d0cbcd8 100644
--- a/mysql-test/main/vector_innodb.test
+++ b/mysql-test/main/vector_innodb.test
@@ -382,4 +382,26 @@ INSERT INTO t1 VALUES (0,'');
 # cleanup
 DROP TABLE t2,t1;
 
+--echo #
+--echo # MDEV-40229 I_S.VECTOR_INDEXES: Unclear or inconsistent semantics
+--echo #            of INDEX_SIZE
+--echo #
+create table t1 (id int auto_increment primary key,
+                 v vector(20) not null, vector index (v)) engine=innodb;
+# the vector index table has a clustered index and two secondary indexes,
+# all of them must be counted
+select index_length >= 3 * @@innodb_page_size as all_indexes_counted
+from information_schema.tables
+where table_schema = database() and table_name = 't1';
+insert into t1 (v) select vec_fromtext(concat('[', group_concat(round(rand(1),3)), ']'))
+  from seq_1_to_20 s1, seq_1_to_2000 s2 group by s2.seq;
+# ANALYZE TABLE must update statistics of the vector index too
+--disable_result_log
+analyze table t1;
+--enable_result_log
+select index_length > 10 * @@innodb_page_size as analyzed
+from information_schema.tables
+where table_schema = database() and table_name = 't1';
+drop table t1;
+
 --echo # End of 11.8 tests
diff --git a/sql/handler.cc b/sql/handler.cc
index 56a784d3..3495613d 100644
--- a/sql/handler.cc
+++ b/sql/handler.cc
@@ -5676,7 +5676,27 @@ handler::ha_analyze(THD* thd, HA_CHECK_OPT* check_opt)
               m_lock_type != F_UNLCK);
   mark_trx_read_write();
 
-  return analyze(thd, check_opt);
+  int result= analyze(thd, check_opt);
+  if (result != HA_ADMIN_OK && result != HA_ADMIN_ALREADY_DONE)
+    return result;
+
+  /*
+    Analyze high-level indexes too, so that their statistics
+    (e.g. INDEX_LENGTH in I_S.TABLES) are up to date after ANALYZE TABLE
+  */
+  for (uint i= table->s->keys; i < table->s->total_keys; i++)
+  {
+    DBUG_ASSERT(table->s->hlindexes() == 1);
+    if (table->hlindex_open(i) || table->hlindex_lock(i))
+      return HA_ADMIN_FAILED;
+    int error= table->hlindex->file->analyze(thd, check_opt);
+    if (error == HA_ADMIN_OK)
+      result= HA_ADMIN_OK;
+    else if (error != HA_ADMIN_ALREADY_DONE &&
+             error != HA_ADMIN_NOT_IMPLEMENTED)
+      return error;
+  }
+  return result;
 }
 
 
diff --git a/sql/sql_show.cc b/sql/sql_show.cc
index ed108adf..c90b27b7 100644
--- a/sql/sql_show.cc
+++ b/sql/sql_show.cc
@@ -6083,13 +6083,20 @@ static int get_schema_tables_record(THD *thd, TABLE_LIST *tables,
 
       if (show_table->s->hlindexes())
       {
