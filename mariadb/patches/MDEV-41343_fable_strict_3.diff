diff --git a/sql/sql_acl.cc b/sql/sql_acl.cc
index 70984625..1c585942 100644
--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -14423,9 +14423,25 @@ bool Sql_cmd_grant::should_bypass_revoke_deny(THD *thd)
   TABLE_LIST tl;
   tl.init_one_table(&MYSQL_SCHEMA_NAME, &MYSQL_TABLE_NAME[USER_TABLE],
                     NULL, TL_WRITE);
-  return !check_access(thd, UPDATE_ACL, tl.db.str, &tl.grant.privilege,
-                       &tl.grant.m_internal, 0, 1) &&
-         !check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE);
+  if (check_access(thd, UPDATE_ACL, tl.db.str, &tl.grant.privilege,
+                   &tl.grant.m_internal, 0, 1) ||
+      check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE))
+    return false;
+
+  /*
+    check_grant() is satisfied by an UPDATE grant on *any* column of the
+    table, leaving the column bits still to be verified in want_privilege.
+    DENYs live in the Priv column, so a column-level UPDATE grant only on,
+    say, Host, does not give the power to undo the DENY by hand and must
+    not be accepted as a bypass. Require UPDATE on the Priv column itself.
+  */
+  if (!tl.grant.want_privilege)
+    return true;  // table-level UPDATE
+
+  access_t acc= get_column_grant(thd, &tl.grant, tl.db.str,
+                                 tl.table_name.str,
+                                 Lex_ident_column(STRING_WITH_LEN("Priv")));
+  return (acc & UPDATE_ACL) == UPDATE_ACL;
 }
 
 
