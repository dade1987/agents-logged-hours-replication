diff --git a/mysql-test/main/win_bit.result b/mysql-test/main/win_bit.result
index ac7625be..fd73808e 100644
--- a/mysql-test/main/win_bit.result
+++ b/mysql-test/main/win_bit.result
@@ -115,3 +115,44 @@ pk	a	b	bit_or	bit_and	bit_xor
 8	2	16	208	0	192
 drop table t1;
 drop table t2;
+#
+# MDEV-40689: Wrong result: BIT_AND/BIT_OR/BIT_XOR in WINDOW functions
+#             over a frame containing NULL
+#
+CREATE TABLE t1 (pk INT PRIMARY KEY, a INT, b INT);
+INSERT INTO t1 VALUES
+(1,0,NULL),(2,0,1),(3,0,2),(4,0,NULL),(5,0,3),
+(6,1,7),(7,1,NULL),(8,1,6);
+SELECT pk, b,
+BIT_AND(b) OVER w AS bit_and,
+BIT_OR(b)  OVER w AS bit_or,
+BIT_XOR(b) OVER w AS bit_xor
+FROM t1
+WINDOW w AS (ORDER BY pk ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)
+ORDER BY pk;
+pk	b	bit_and	bit_or	bit_xor
+1	NULL	18446744073709551615	0	0
+2	1	1	1	1
+3	2	0	3	3
+4	NULL	2	2	2
+5	3	3	3	3
+6	7	3	7	4
+7	NULL	7	7	7
+8	6	6	6	6
+SELECT pk, a, b,
+BIT_AND(b) OVER w AS bit_and,
+BIT_OR(b)  OVER w AS bit_or,
+BIT_XOR(b) OVER w AS bit_xor
+FROM t1
+WINDOW w AS (PARTITION BY a ORDER BY pk ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING)
+ORDER BY pk;
+pk	a	b	bit_and	bit_or	bit_xor
+1	0	NULL	1	1	1
+2	0	1	0	3	3
+3	0	2	0	3	3
+4	0	NULL	2	3	1
+5	0	3	3	3	3
+6	1	7	7	7	7
+7	1	NULL	6	7	1
+8	1	6	6	6	6
+DROP TABLE t1;
