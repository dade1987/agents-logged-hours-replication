diff --git a/mysql-test/suite/innodb_fts/mdev_40621.result b/mysql-test/suite/innodb_fts/mdev_40621.result
new file mode 100644
index 00000000..43aa1103
--- /dev/null
+++ b/mysql-test/suite/innodb_fts/mdev_40621.result
@@ -0,0 +1,15 @@
+# MDEV-40621 OPTIMIZE with externally stored FTS ilist
+CREATE TABLE t1 (id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY, body MEDIUMTEXT,
+FULLTEXT KEY ftidx (body)) ENGINE=InnoDB;
+INSERT INTO t1 (body) SELECT REPEAT('megaword ', 30) FROM seq_1_to_260;
+SET @save_opt= @@GLOBAL.innodb_optimize_fulltext_only;
+SET GLOBAL innodb_optimize_fulltext_only = ON;
+DELETE FROM t1 WHERE id = 1;
+OPTIMIZE TABLE t1;
+Table	Op	Msg_type	Msg_text
+test.t1	optimize	status	OK
+SET GLOBAL innodb_optimize_fulltext_only = @save_opt;
+SELECT COUNT(*) FROM t1 WHERE MATCH(body) AGAINST('megaword');
+COUNT(*)
+259
+DROP TABLE t1;
