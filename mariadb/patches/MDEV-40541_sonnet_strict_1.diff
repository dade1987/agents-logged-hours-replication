--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -3704,7 +3704,13 @@ privilege_t acl_get(const char *host, const char *ip,
   acl_entry *entry;
   DBUG_ENTER("acl_get");
 
-  tmp_db= strmov(strmov(key, safe_str(ip)) + 1, user) + 1;
+  /*
+    Roles are looked up with empty host and ip. Use a marker that cannot be
