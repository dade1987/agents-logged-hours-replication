diff --git a/sql/sql_base.cc b/sql/sql_base.cc
index eabad770..f0647d5e 100644
--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -876,8 +876,16 @@ int close_thread_tables(THD *thd) noexcept
       /*
         For simple locking we cleanup it here because we don't close thread
         tables. For prelocking we close it when we do close thread tables.
+
+        Under LOCK TABLES a trigger or a stored function body (a
+        sub-statement) calls close_thread_tables() while the top-level
+        statement is still executing and still uses the fixed vcol
+        expressions of its tables (e.g. to re-calculate virtual columns
+        after BEFORE triggers). Cleaning them up here would leave the
+        top-level statement with unfixed expressions, so postpone the
+        cleanup until the top-level statement closes its tables.
       */
-      if (thd->locked_tables_mode != LTM_PRELOCKED)
+      if (thd->locked_tables_mode != LTM_PRELOCKED && !thd->in_sub_stmt)
         table->vcol_cleanup_expr(thd);
     }
 
