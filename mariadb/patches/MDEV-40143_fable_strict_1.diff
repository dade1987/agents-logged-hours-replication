+#
+# MDEV-40143 Inconsistent ST_IsValid() result between VIEW, CTE and
+# TEMPORARY TABLE over RIGHT JOIN with ST_Dimension() predicate
+#
+CREATE TABLE t0 (c0 INT, c1 POINT);
+INSERT INTO t0 VALUES (-4, Point(0,0)), (6, NULL), (9, Point(1,1));
+CREATE VIEW v0 AS
+SELECT ST_IsValid(a.c1) AS vc_0 FROM t0 AS a RIGHT JOIN t0 AS b
+ON a.c0 <=> b.c0 WHERE ST_Dimension(b.c1) >= 0;
+SELECT vc_0 FROM v0 WHERE vc_0 > 0;
+vc_0
+1
+1
+WITH CTE AS (
+SELECT ST_IsValid(a.c1) AS vc_0 FROM t0 AS a RIGHT JOIN t0 AS b
+ON a.c0 <=> b.c0 WHERE ST_Dimension(b.c1) >= 0)
+SELECT vc_0 FROM CTE WHERE vc_0 > 0;
+vc_0
+1
+1
+CREATE TEMPORARY TABLE temp_t AS
+SELECT ST_IsValid(a.c1) AS vc_0 FROM t0 AS a RIGHT JOIN t0 AS b
+ON a.c0 <=> b.c0 WHERE ST_Dimension(b.c1) >= 0;
+SELECT vc_0 FROM temp_t WHERE vc_0 > 0;
+vc_0
+1
+1
+# NULL result must not stick to the following rows
+SELECT c0, ST_IsValid(c1) FROM t0 ORDER BY c0;
+c0	ST_IsValid(c1)
+-4	1
+6	NULL
+9	1
+DROP TABLE temp_t;
+DROP VIEW v0;
+DROP TABLE t0;
+#
+# End of 12.3 tests
+#
