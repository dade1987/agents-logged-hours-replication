+  */
+  null_value= 0;
   if ((args[0]->null_value ||
       !(geometry= Geometry::construct(&buffer, wkb->ptr(), wkb->length()))))
   {
     if (!args[0]->null_value)
       my_error(ER_GIS_INVALID_DATA, MYF(0), func_name());
     null_value= 1;
