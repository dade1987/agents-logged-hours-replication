diff --git a/mysql-test/suite/roles/acl_cache_role_user-40541.test b/mysql-test/suite/roles/acl_cache_role_user-40541.test
new file mode 100644
index 00000000..a04c0153
--- /dev/null
+++ b/mysql-test/suite/roles/acl_cache_role_user-40541.test
@@ -0,0 +1,39 @@
+#
+# MDEV-40541 role vs user@localhost acl_cache key confusion
+#
+# The acl_cache key used to be ip\0user\0db. A role is looked up with an
+# empty host and ip, and a user connected over the unix socket has
+# host='localhost' and no ip, so the cached entry of r1@localhost was
+# returned for the role r1.
+#
+--source include/not_embedded.inc
+
+create database db;
+create table db.t1(a varchar(40));
+insert into db.t1 values ('role-cache-collision-row');
+
+create role r1;
+create user r1@localhost;
+create user u1@'127.0.0.1';
+
+grant select on db.* to r1@localhost;
+grant r1 to u1@'127.0.0.1';
+
+--connect (r1,localhost,r1,,)
+# populate the acl_cache with the entry for r1@localhost
+select a from db.t1;
+
+--connect (u1,127.0.0.1,u1,,)
+set role r1;
+select current_role();
+# the role r1 has no privileges on db.*
+--error ER_TABLEACCESS_DENIED_ERROR
+select a from db.t1;
+
+connection default;
+disconnect r1;
+disconnect u1;
+drop user u1@'127.0.0.1';
+drop user r1@localhost;
+drop role r1;
+drop database db;
diff --git a/sql/sql_acl.cc b/sql/sql_acl.cc
index d4a7606d..1f6c30ae 100644
--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -645,7 +645,7 @@ bool ROLE_GRANT_PAIR::init(MEM_ROOT *mem, const char *username,
 }
 
 #define IP_ADDR_STRLEN (3 + 1 + 3 + 1 + 3 + 1 + 3)
-#define ACL_KEY_LENGTH (IP_ADDR_STRLEN + 1 + NAME_LEN + \
+#define ACL_KEY_LENGTH (HOSTNAME_LENGTH + 1 + IP_ADDR_STRLEN + 1 + NAME_LEN + \
                         1 + USERNAME_LENGTH + 1)
 
 #if defined(HAVE_OPENSSL)
@@ -3704,7 +3704,15 @@ privilege_t acl_get(const char *host, const char *ip,
   acl_entry *entry;
   DBUG_ENTER("acl_get");
 
-  tmp_db= strmov(strmov(key, safe_str(ip)) + 1, user) + 1;
+  /*
+    The cache key must include the host too, not only the ip. Roles are
+    looked up with an empty host and ip, while a user connected over a unix
+    socket has host="localhost" and no ip. Without the host in the key, the
+    cached privileges of user 'foo'@'localhost' would be returned for the
+    role 'foo' (and vice versa). See MDEV-40541.
+  */
+  tmp_db= strmov(strmov(strmov(key, safe_str(host)) + 1, safe_str(ip)) + 1,
+                 user) + 1;
   end= strnmov(tmp_db, db, key + sizeof(key) - tmp_db);
 
   if (end >= key + sizeof(key)) // db name was truncated
