+#
+# MDEV-40153 Assertion `rec->field->head()->charset == nullptr' failed in Type_handler_row::Column_definition_prepare_stage1
+#
+CREATE PACKAGE pk_crash AS TYPE r IS RECORD (b BLOB); FUNCTION f RETURN r; END;
+$$
+DROP PACKAGE pk_crash;
+CREATE PACKAGE pk1 AS
+TYPE r IS RECORD (a VARBINARY(10), b BLOB, c VARCHAR(10) CHARACTER SET latin1);
+FUNCTION f RETURN r;
+PROCEDURE p(x r);
+END;
+$$
+CREATE PACKAGE BODY pk1 AS
+FUNCTION f RETURN r AS
+v r;
+BEGIN
+v.a:= 'a';
+v.b:= 'b';
+v.c:= 'c';
+RETURN v;
+END;
+PROCEDURE p(x r) AS
+BEGIN
+NULL;
+END;
+END;
+$$
+DROP PACKAGE pk1;
+# End of 13.1 tests
