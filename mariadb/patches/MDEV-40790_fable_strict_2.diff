diff --git a/sql/sql_type_row.cc b/sql/sql_type_row.cc
index c72cab62..555df6ca 100644
--- a/sql/sql_type_row.cc
+++ b/sql/sql_type_row.cc
@@ -135,6 +135,43 @@ class my_var_sp_row_field: public my_var_sp
 };
 
 
+/*
+  This class handles fields of a ROW SP variable whose structure is not
+  known at parse time (ROW TYPE OF table, ROW TYPE OF cursor) when it's used
+  as a OUT parameter in a stored procedure, e.g.:
+    SELECT a INTO spvar_row_type_of.a FROM t1;
+  The field offset is resolved at run time, by name.
+*/
+class my_var_sp_row_field_by_name: public my_var_sp
+{
+  const LEX_CSTRING m_field_name;
+public:
+  my_var_sp_row_field_by_name(const Lex_ident_sys_st &varname,
+                              const sp_rcontext_addr &varaddr,
+                              const Lex_ident_sys_st &field_name,
+                              sp_head *s)
+   :my_var_sp(varname, varaddr,
+              &type_handler_double/*Not really used*/, s),
+    m_field_name(field_name)
+  { }
+  bool check_assignability(THD *thd, const List<Item> &select_list,
+                           bool *assign_as_row) const override
+  {
+    *assign_as_row= false;
+    return select_list.elements == 1;
+  }
+  bool set(THD *thd, Item *item) override
+  {
+    uint field_offset;
+    sp_rcontext *ctx= get_rcontext(thd->spcont);
+    if (ctx->find_row_field_by_name_or_error(&field_offset, offset(),
+                                             m_field_name))
+      return true;
+    return ctx->set_variable_row_field(thd, offset(), field_offset, &item);
+  }
+};
+
+
 my_var *Type_handler_row::make_outvar(THD *thd,
                                       const Lex_ident_sys_st &name,
                                       const sp_rcontext_addr &addr,
@@ -159,11 +196,24 @@ my_var *Type_handler_row::make_outvar_field(THD *thd,
   DBUG_ASSERT(t);
