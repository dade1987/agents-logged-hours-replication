@@ -1031,3 +1031,39 @@ t2	CREATE TABLE `t2` (
   `b` varchar(3) CHARACTER SET latin1 COLLATE latin1_swedish_ci DEFAULT NULL,
   `c` time DEFAULT NULL
 ) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
+#
+# MDEV-40790 SELECT INTO row_type_of.field crashes the server
+#
+CREATE TABLE t1 (a INT,b VARCHAR(10));
+INSERT INTO t1 VALUES (10,'b10');
+CREATE PROCEDURE p1()
+BEGIN
+DECLARE c1 CURSOR FOR SELECT * FROM t1;
+BEGIN
+DECLARE r0 ROW TYPE OF c1;
+SELECT a,b INTO r0.a,r0.b FROM t1;
+SELECT r0.a, r0.b;
+SELECT a INTO r0.b FROM t1;
+SELECT r0.a, r0.b;
+END;
+END;
+$$
+CREATE PROCEDURE p2()
+BEGIN
+DECLARE c1 CURSOR FOR SELECT * FROM t1;
+BEGIN
+DECLARE r0 ROW TYPE OF c1;
+SELECT a INTO r0.c FROM t1;
+END;
+END;
+$$
+CALL p1();
+r0.a	r0.b
+10	b10
+r0.a	r0.b
+10	10
+CALL p2();
+ERROR HY000: Row variable 'r0' does not have a field 'c'
+DROP PROCEDURE p1;
+DROP PROCEDURE p2;
+DROP TABLE t1;
