+--error ER_PART_WRONG_VALUE
+EXECUTE IMMEDIATE 'CREATE TABLE t1 (c DATE)
+  PARTITION BY RANGE COLUMNS(c)
+  INTERVAL ? DAY
+  (PARTITION p0 VALUES LESS THAN (''2026-04-20''))' USING 1;
+
+--error ER_PART_WRONG_VALUE
+PREPARE s FROM 'CREATE TABLE t1 (x INT) WITH SYSTEM VERSIONING
+  PARTITION BY SYSTEM_TIME INTERVAL ? DAY PARTITIONS 3';
