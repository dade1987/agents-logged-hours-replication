diff --git a/mysql-test/main/partition_range_interval.result b/mysql-test/main/partition_range_interval.result
index 6f7abf6d..4b6e1e9c 100644
--- a/mysql-test/main/partition_range_interval.result
+++ b/mysql-test/main/partition_range_interval.result
@@ -2557,3 +2557,24 @@ INTERVAL "hello" DAY
 PARTITION p0 VALUES LESS THAN ('2026-04-20')
 );
 ERROR HY000: Wrong parameters for partitioned `t1`: wrong value for 'INTERVAL'
+#
+# MDEV-40978 PREPARE with INTERVAL ? in Partition DDL Crashes the Server
+#
+PREPARE s FROM 'CREATE TABLE t1 (c DATE)
+  PARTITION BY RANGE COLUMNS(c)
+  INTERVAL ? DAY
+  (PARTITION p0 VALUES LESS THAN (?))';
+ERROR HY000: Wrong parameters for partitioned `t1`: wrong value for 'INTERVAL'
+PREPARE s FROM 'CREATE TABLE t1 (c DATE)
+  PARTITION BY RANGE COLUMNS(c)
+  INTERVAL (? + 1) DAY
+  (PARTITION p0 VALUES LESS THAN (''2026-04-20''))';
+ERROR HY000: Wrong parameters for partitioned `t1`: wrong value for 'INTERVAL'
+EXECUTE IMMEDIATE 'CREATE TABLE t1 (c DATE)
+  PARTITION BY RANGE COLUMNS(c)
+  INTERVAL ? DAY
+  (PARTITION p0 VALUES LESS THAN (''2026-04-20''))' USING 1;
+ERROR HY000: Wrong parameters for partitioned `t1`: wrong value for 'INTERVAL'
+PREPARE s FROM 'CREATE TABLE t1 (x INT) WITH SYSTEM VERSIONING
+  PARTITION BY SYSTEM_TIME INTERVAL ? DAY PARTITIONS 3';
+ERROR HY000: Wrong parameters for partitioned `t1`: wrong value for 'INTERVAL'
diff --git a/mysql-test/main/partition_range_interval.test b/mysql-test/main/partition_range_interval.test
