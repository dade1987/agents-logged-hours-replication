   /* 1. assign INTERVAL to interval.step */
   if (interval->fix_fields_if_needed_for_scalar(thd, &interval))
     return true;
+  /*
+    The interval value is evaluated at parse time, so it can not depend
+    on a prepared statement parameter, which has no value yet.
+  */
+  if (interval->with_param())
+  {
+    my_error(ER_PART_WRONG_VALUE, MYF(0), table_name, "INTERVAL");
+    return true;
+  }
