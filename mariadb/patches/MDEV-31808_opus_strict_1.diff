+#
+# MDEV-31808 Server crash upon altering table with NEXTVAL for
+# default under exclusive lock
+#
+CREATE SEQUENCE s;
+CREATE TABLE t (a INT DEFAULT(NEXTVAL(s)), b INT);
+INSERT INTO t (b) VALUES (1),(2);
+ALTER TABLE t FORCE, ALGORITHM=COPY, LOCK=EXCLUSIVE;
+ALTER TABLE t ADD c INT, ALGORITHM=COPY, LOCK=EXCLUSIVE;
+INSERT INTO t (b) VALUES (3);
+SELECT * FROM t;
+a	b	c
+1	1	NULL
+2	2	NULL
+3	3	NULL
+DROP TABLE t;
+DROP SEQUENCE s;
+# End of 10.6 tests (MDEV-31808)
