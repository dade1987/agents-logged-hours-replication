+  the log file header cannot be rewritten in read-only mode. */
+  if (UNIV_UNLIKELY(high_level_read_only || recv_sys.rpo))
+    return;
+
   thd_wait_begin(thd, THD_WAIT_DISKIO);
   tpool::tpool_wait_begin();
   lsn_t wait_lsn;
