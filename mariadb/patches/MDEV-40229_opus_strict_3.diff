diff --git a/sql/handler.cc b/sql/handler.cc
index 56a784d3..7e2cb7af 100644
--- a/sql/handler.cc
+++ b/sql/handler.cc
@@ -5676,7 +5676,27 @@ handler::ha_analyze(THD* thd, HA_CHECK_OPT* check_opt)
               m_lock_type != F_UNLCK);
   mark_trx_read_write();
 
-  return analyze(thd, check_opt);
+  int error= analyze(thd, check_opt);
+  if (error != HA_ADMIN_OK && error != HA_ADMIN_ALREADY_DONE)
+    return error;
+  /*
+    Analyze vector (high-level) indexes too, so that their statistics,
+    in particular their size as shown in INDEX_LENGTH, are up to date.
+  */
+  if (table->file == this)
+  {
+    for (uint i= table->s->keys; i < table->s->total_keys; i++)
+    {
+      DBUG_ASSERT(table->s->hlindexes() == 1);
+      if (table->hlindex_open(i) || table->hlindex_lock(i))
+        return HA_ADMIN_FAILED;
+      int hl_error= table->hlindex->file->analyze(thd, check_opt);
+      if (hl_error != HA_ADMIN_OK && hl_error != HA_ADMIN_ALREADY_DONE &&
+          hl_error != HA_ADMIN_NOT_IMPLEMENTED)
+        return hl_error;
+    }
+  }
+  return error;
 }
 
 
