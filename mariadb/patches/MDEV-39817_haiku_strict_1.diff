+/*
+  Checks whether the JSON array elements in [s, s + *len) end inside a string
+  literal. If so, returns true and sets *open_pos to the position of the
+  opening quote of that string. An incomplete escape sequence at the very end
+  is not kept: *len is reduced to its start.
+*/
+static bool json_ends_in_string(const char *s, size_t *len, size_t *open_pos)
+{
+  bool in_string= false;
+  size_t i= 0, n= *len;
+
+  while (i < n)
+  {
+    char c= s[i];
+    if (!in_string)
+    {
+      if (c == '"')
+      {
+        in_string= true;
+        *open_pos= i;
+      }
+      i++;
+    }
+    else if (c == '"')
+    {
+      in_string= false;
+      i++;
+    }
+    else if (c == '\\')
+    {
+      size_t esc_len= (i + 1 < n && s[i + 1] == 'u') ? 6 : 2;
+      if (i + esc_len > n)
+      {
+        *len= i;
+        break;
+      }
+      i+= esc_len;
+    }
+    else
+      i++;
+  }
+  return in_string;
+}
