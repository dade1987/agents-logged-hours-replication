diff --git a/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read_checksum.test b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read_checksum.test
new file mode 100644
index 00000000..a65050a6
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read_checksum.test
@@ -0,0 +1,28 @@
+# MDEV-40544: Assertion fail / Memory leak in `mariadb-binlog --force-read`
+#
+# A checksum failure under --force-read must be output as an Unknown event
+# only, without an accompanying error. Reporting both an error and an event
+# triggered an assertion in Log_event::read_log_event(IO_CACHE*, ...) on
+# debug builds, and leaked the Unknown event on release builds.
+
+--source include/have_debug.inc
+--source include/have_binlog_format_mixed.inc # format-agnostic
+
+RESET MASTER;
+FLUSH BINARY LOGS;
+
+--let $MYSQLD_DATADIR= `SELECT @@datadir`
+--let SEARCH_FILE= $MYSQLTEST_VARDIR/tmp/binlog_mysqlbinlog_force_read_checksum.sql
+
+--echo #MYSQL_BINLOG --verify-binlog-checksum --force-read --debug=d,simulate_checksum_test_failure --result-file=SEARCH_FILE #MYSQLD_DATADIR/master-bin.000001 2>&1
+--exec $MYSQL_BINLOG --verify-binlog-checksum --force-read --debug=d,simulate_checksum_test_failure --result-file=$SEARCH_FILE $MYSQLD_DATADIR/master-bin.000001 2>&1
+
+--let SEARCH_PATTERN= # Unknown event.*
+--let SEARCH_ABORT= NOT FOUND
+--source include/search_pattern_in_file.inc
+
+--let SEARCH_PATTERN= crc check failed
+--let SEARCH_ABORT= FOUND
+--source include/search_pattern_in_file.inc
+
+--remove_file $SEARCH_FILE
