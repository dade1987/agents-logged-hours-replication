 a	b	c
 1	2	NULL
 drop table t1;
+#
+# MDEV-31225 Signal 11 after select with nested ROW in IN predicate
+#            and in_predicate_conversion_threshold=1
+#
+SET @@in_predicate_conversion_threshold=1;
+CREATE TABLE t1 (a INT);
+SELECT 1 FROM t1 WHERE ROW(a,(a,a)) IN ((1,(1,1)),(2,(2,null)));
+1
+INSERT INTO t1 VALUES (1),(2),(3);
+SELECT a FROM t1 WHERE ROW(a,(a,a)) IN ((1,(1,1)),(2,(2,null)));
+a
+1
+SELECT a FROM t1 WHERE ROW((a,a),a) IN (((1,1),1),((3,3),3));
+a
+1
+3
+DROP TABLE t1;
+SET @@in_predicate_conversion_threshold=default;
 # End of 11.4 tests
