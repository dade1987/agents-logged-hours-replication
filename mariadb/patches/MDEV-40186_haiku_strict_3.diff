diff --git a/storage/heap/hp_delete.c b/storage/heap/hp_delete.c
index 9579fb51..a560d89d 100644
--- a/storage/heap/hp_delete.c
+++ b/storage/heap/hp_delete.c
@@ -71,12 +71,24 @@ int hp_rb_delete_key(HP_INFO *info, register HP_KEYDEF *keyinfo,
   size_t old_allocated;
   int res;
 
-  if (flag) 
-    info->last_pos= NULL; /* For heap_rnext/heap_rprev */
-
   custom_arg.keyseg= keyinfo->seg;
   custom_arg.key_length= hp_rb_make_key(keyinfo, info->recbuf, record, recpos);
   custom_arg.search_flag= SEARCH_SAME;
+
+  if (flag)
+  {
+    info->last_pos= NULL; /* For heap_rnext/heap_rprev */
+    /*
+      The record being deleted is the current position of the index scan.
+      heap_rnext()/heap_rprev() will have to restart the search, and must do
+      it from the key of this record, not from the original search key
+      (which may be only a prefix of the index, e.g. in "a=3" on key (a,b)).
+      Save the packed key (without the trailing record pointer).
+    */
+    info->lastkey_len= custom_arg.key_length - sizeof(uchar*);
+    memcpy(info->lastkey, info->recbuf, info->lastkey_len);
+  }
+
   old_allocated= keyinfo->rb_tree.allocated;
   res= tree_delete(&keyinfo->rb_tree, info->recbuf, custom_arg.key_length,
                    &custom_arg);
