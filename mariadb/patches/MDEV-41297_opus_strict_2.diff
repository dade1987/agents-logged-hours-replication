       if (my_ci_strnncollsp(seg->charset, data1, len1, data2, len2))
         return 1;
@@ -684,6 +689,8 @@ int hp_key_cmp(HP_KEYDEF *keydef, const uchar *rec, const uchar *key,
       const uchar *rec_data;
 
       memcpy(&key_data, key + 4, HP_PTR_SIZE);
+      if (!key_blob_len)
