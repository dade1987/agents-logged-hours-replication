+++ b/storage/heap/hp_delete.c
@@ -71,12 +71,25 @@ int hp_rb_delete_key(HP_INFO *info, register HP_KEYDEF *keyinfo,
   size_t old_allocated;
   int res;
 
-  if (flag) 
-    info->last_pos= NULL; /* For heap_rnext/heap_rprev */
-
   custom_arg.keyseg= keyinfo->seg;
   custom_arg.key_length= hp_rb_make_key(keyinfo, info->recbuf, record, recpos);
   custom_arg.search_flag= SEARCH_SAME;
+  if (flag)
+  {
+    /*
+      For heap_rnext/heap_rprev: the current tree position is removed,
+      so the scan has to be restarted. Remember the complete key of the
+      deleted record (including the record pointer) and mark that with
+      last_find_flag == HA_READ_AFTER_KEY. heap_rnext/heap_rprev will then
+      restart the scan from the deleted key, not from the key that was
+      originally used by heap_rkey(), so that the already scanned rows are
+      not visited again.
+    */
+    info->last_pos= NULL;
+    memcpy(info->lastkey, info->recbuf, custom_arg.key_length);
+    info->lastkey_len= custom_arg.key_length;
+    info->last_find_flag= HA_READ_AFTER_KEY;
+  }
   old_allocated= keyinfo->rb_tree.allocated;
   res= tree_delete(&keyinfo->rb_tree, info->recbuf, custom_arg.key_length,
                    &custom_arg);
