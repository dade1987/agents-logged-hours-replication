diff --git a/sql/item_geofunc.h b/sql/item_geofunc.h
index d830e440..25e0c609 100644
--- a/sql/item_geofunc.h
+++ b/sql/item_geofunc.h
@@ -1104,6 +1104,22 @@ class Item_func_isvalid: public Item_long_func_args_geometry
     static LEX_CSTRING name= {STRING_WITH_LEN("st_isvalid") };
     return name;
   }
+  /*
+    ST_IsValid() returns NULL not only for a NULL argument but also when
+    the geometry cannot be validated (Geometry::is_valid() fails), so the
+    result is nullable regardless of the argument's nullability.  Declare
+    that explicitly, as the other spatial predicates (ST_IsEmpty,
+    ST_Dimension, ...) do, so that the optimizer never treats the function
+    as NOT NULL and the metadata matches the values actually produced.
+  */
+  bool fix_length_and_dec(THD *thd) override
+  {
+    decimals= 0;
+    max_length= 2;
+    set_maybe_null();
+    return FALSE;
+  }
+  decimal_digits_t decimal_precision() const override { return 1; }
   Item *shallow_copy(THD *thd) const override
   { return get_item_copy<Item_func_isvalid>(thd, this); }
 };
