diff --git a/sql/sql_type.cc b/sql/sql_type.cc
index 74917bbc..6fd4c3a9 100644
--- a/sql/sql_type.cc
+++ b/sql/sql_type.cc
@@ -2415,6 +2415,26 @@ Type_handler_int_result::make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
 }
 
 
+/**
+  Hex hybrid literals (0xHHHH, b'0101') behave as unsigned integers
+  in numeric context, e.g. in SUM() and AVG().
+  Create an unsigned BIGINT field, so the value is not truncated
+  according to the (string) length of the literal, as a DOUBLE field
+  created by default would do.
+*/
+Field *
+Type_handler_hex_hybrid::make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
+                                                            const Item *item)
+                                                            const
+{
+  return new(mem_root)
+         Field_longlong(NULL, MAX_BIGINT_WIDTH,
+                        (uchar *) (item->maybe_null() ? "" : 0),
+                        item->maybe_null() ? 1 : 0, Field::NONE,
+                        &item->name, 0, true/*unsigned*/);
+}
+
+
 /***********************************************************************/
 
