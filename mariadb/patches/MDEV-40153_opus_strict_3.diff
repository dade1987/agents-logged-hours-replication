-    DBUG_ASSERT(rec->field->head()->charset == nullptr); // Not prepared
+    /*
+      Make sure the record structure has not been prepared yet.
+      Note, we cannot test charset==nullptr here: data types like
+      BLOB, BINARY, VARBINARY, or data types with an explicit
+      CHARACTER SET/COLLATE clause, get a non-NULL charset at parse time.
+      FIELDFLAG_MAYBE_NULL is set by sp_head::fill_spvar_definition()
+      on prepared definitions only.
+    */
+    DBUG_ASSERT(!f_maybe_null(rec->field->head()->pack_flag)); // Not prepared
     Row_definition_list *row= rec->field->deep_copy(thd);
