diff --git a/sql/sql_type_row.cc b/sql/sql_type_row.cc
index 97d48ed3..14666d5c 100644
--- a/sql/sql_type_row.cc
+++ b/sql/sql_type_row.cc
@@ -252,7 +252,15 @@ bool Type_handler_row::
   {
     DBUG_ASSERT(rec->field);
     DBUG_ASSERT(rec->field->elements);
-    DBUG_ASSERT(rec->field->head()->charset == nullptr); // Not prepared
+    /*
+      Note, we cannot use "rec->field->head()->charset == nullptr" here
+      as an indicator that rec->field has not been prepared yet:
+      binary string data types (BLOB, BINARY, VARBINARY, etc) get
+      their charset set to &my_charset_bin already at parse time,
+      so the first member's charset can be non-null in an unprepared
+      record structure. The "rec" structure itself is never prepared
+      in place: it's always deep-copied before preparation.
+    */
     Row_definition_list *row= rec->field->deep_copy(thd);
     if (!row || thd->lex->sphead->row_fill_field_definitions(thd, row))
       return true; // Error
