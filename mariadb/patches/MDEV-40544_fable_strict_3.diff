diff --git a/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read.test b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read.test
new file mode 100644
index 00000000..96e8bd9b
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read.test
@@ -0,0 +1,42 @@
+#
+# Purpose:
+#   mariadb-binlog --force-read is documented as "output invalid events as
+# 'Unknown event's rather than error". When an event failed its checksum
+# verification, Log_event::read_log_event() both returned an Unknown_log_event
+# substitute and set an error message, which triggered an assertion in debug
+# builds (DBUG_ASSERT(!res)) and leaked the substitute event in release
+# builds (a second, "hopelessly corrupted", Unknown_log_event was returned
+# instead).
+#
+# Methodology:
+#   Simulate a checksum failure for every event using the
+# simulate_checksum_test_failure debug point and run mariadb-binlog with
+# --verify-binlog-checksum --force-read. It must succeed, print each event as
+# an Unknown event, and print no error.
+#
+# References:
+#   MDEV-40544: Assertion fail / Memory leak in mariadb-binlog --force-read
+#
+
+--source include/have_debug.inc
+--source include/have_log_bin.inc
+
+RESET MASTER;
+FLUSH BINARY LOGS;
+
+--let $MYSQLD_DATADIR= `SELECT @@datadir`
+--let $outfile= $MYSQLTEST_VARDIR/tmp/binlog_mysqlbinlog_force_read.out
+
+--echo # MYSQL_BINLOG --verify-binlog-checksum --force-read --debug=d,simulate_checksum_test_failure MYSQLD_DATADIR/master-bin.000001
+--exec $MYSQL_BINLOG --verify-binlog-checksum --force-read --debug=d,simulate_checksum_test_failure $MYSQLD_DATADIR/master-bin.000001 > $outfile 2>&1
+
+--let SEARCH_FILE= $outfile
+--let SEARCH_PATTERN= # Unknown event
+--source include/search_pattern_in_file.inc
+
+--let SEARCH_PATTERN= ERROR
+--source include/search_pattern_in_file.inc
+
+--remove_file $outfile
+
+--echo # End of test
