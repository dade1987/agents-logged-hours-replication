+#
+# MDEV-40762 Wrong MAX() result with GROUP BY when loose index scan
+#            uses DESC key part
+#
+# The MIN/MAX key part must be taken from the index chosen for the
+# loose index scan, not from the last index that was examined.
+create table t1 (a int, b int, key k_desc (a, b desc), key k_asc (a, b));
+insert into t1 values (1,23),(3,45),(1,11),(3,88),(3,70),(4,NULL),(1,14),(4,NULL),(4,8);
+EXPLAIN SELECT a, MAX(b) FROM t1 GROUP BY a;
+id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
+1	SIMPLE	t1	range	NULL	k_desc	5	NULL	#	Using index for group-by
+SELECT a, MAX(b) FROM t1 GROUP BY a;
+a	MAX(b)
+1	23
+3	88
+4	8
+EXPLAIN SELECT a, MIN(b) FROM t1 GROUP BY a;
+id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
+1	SIMPLE	t1	range	NULL	k_desc	10	NULL	#	Using index for group-by
+SELECT a, MIN(b) FROM t1 GROUP BY a;
+a	MIN(b)
+1	11
+3	45
+4	8
+EXPLAIN SELECT a, MIN(b), MAX(b) FROM t1 GROUP BY a;
+id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
+1	SIMPLE	t1	range	NULL	k_desc	10	NULL	#	Using index for group-by
+SELECT a, MIN(b), MAX(b) FROM t1 GROUP BY a;
+a	MIN(b)	MAX(b)
+1	11	23
+3	45	88
+4	8	8
+drop table t1;
+create table t1 (a int, b int, key k_asc (a, b), key k_desc (a, b desc));
+insert into t1 values (1,23),(3,45),(1,11),(3,88),(3,70),(4,NULL),(1,14),(4,NULL),(4,8);
+EXPLAIN SELECT a, MAX(b) FROM t1 GROUP BY a;
+id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
+1	SIMPLE	t1	range	NULL	k_asc	5	NULL	#	Using index for group-by
+SELECT a, MAX(b) FROM t1 GROUP BY a;
+a	MAX(b)
+1	23
+3	88
+4	8
+EXPLAIN SELECT a, MIN(b) FROM t1 GROUP BY a;
+id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
+1	SIMPLE	t1	range	NULL	k_asc	10	NULL	#	Using index for group-by
+SELECT a, MIN(b) FROM t1 GROUP BY a;
+a	MIN(b)
+1	11
+3	45
+4	8
+EXPLAIN SELECT a, MIN(b), MAX(b) FROM t1 GROUP BY a;
+id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
+1	SIMPLE	t1	range	NULL	k_asc	10	NULL	#	Using index for group-by
+SELECT a, MIN(b), MAX(b) FROM t1 GROUP BY a;
+a	MIN(b)	MAX(b)
+1	11	23
+3	45	88
+4	8	8
+drop table t1;
