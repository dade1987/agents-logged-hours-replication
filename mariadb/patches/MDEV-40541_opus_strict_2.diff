-#define ACL_KEY_LENGTH (IP_ADDR_STRLEN + 1 + NAME_LEN + \
+/*
+  acl_cache key is: <ip or '@'host> \0 <user> \0 <db>
+  The first part can be a host name (prefixed by '@') when ip is not known,
+  e.g. for local socket connections or for roles (empty host).
+*/
+#define ACL_KEY_LENGTH (1 + HOSTNAME_LENGTH + 1 + NAME_LEN + \
                         1 + USERNAME_LENGTH + 1)
 
 #if defined(HAVE_OPENSSL)
@@ -3704,7 +3709,23 @@ privilege_t acl_get(const char *host, const char *ip,
   acl_entry *entry;
   DBUG_ENTER("acl_get");
 
-  tmp_db= strmov(strmov(key, safe_str(ip)) + 1, user) + 1;
+  /*
+    The cache key must uniquely identify (host, ip, user). When ip is
+    known it determines the result. When it is not (local socket connections,
+    roles), use the host name instead, prefixed with '@', a character that
+    can never appear in an ip address. This way a role "r1" (empty host and
+    ip) and a user "r1@localhost" connected via socket get different keys.
+  */
+  if (ip && ip[0])
+    tmp_db= strnmov(key, ip, HOSTNAME_LENGTH + 1);
+  else
+  {
+    key[0]= '@';
+    tmp_db= strnmov(key + 1, safe_str(host), HOSTNAME_LENGTH);
+  }
+  *tmp_db++= 0;
+  tmp_db= strnmov(tmp_db, user, USERNAME_LENGTH);
