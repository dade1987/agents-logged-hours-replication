diff --git a/mysql-test/suite/roles/role_user_acl_cache.result b/mysql-test/suite/roles/role_user_acl_cache.result
new file mode 100644
index 00000000..a01d0706
--- /dev/null
+++ b/mysql-test/suite/roles/role_user_acl_cache.result
@@ -0,0 +1,33 @@
+#
+# MDEV-40541 role vs user@localhost acl_cache key confusion
+#
+create database db;
+create table db.t1(a varchar(40));
+insert into db.t1 values ('role-cache-collision-row');
+create role r1;
+create user r1@localhost identified by 'r1pass';
+create user u1@'127.0.0.1' identified by 'u1pass';
+grant select on db.* to r1@localhost;
+grant r1 to u1@'127.0.0.1';
+connect r1,localhost,r1,r1pass;
+select a from db.t1;
+a
+role-cache-collision-row
+connect u1,127.0.0.1,u1,u1pass,,$MASTER_MYPORT;
+set role r1;
+show grants;
+Grants for u1@127.0.0.1
+GRANT USAGE ON *.* TO `r1`
+GRANT USAGE ON *.* TO `u1`@`127.0.0.1` IDENTIFIED BY PASSWORD '*4C5C0A2C80D7567C7CFBDFC09409901AADC4B390'
+GRANT `r1` TO `u1`@`127.0.0.1`
+select a from db.t1;
+ERROR 42000: SELECT command denied to user 'u1'@'127.0.0.1' for table `db`.`t1`
+use db;
+ERROR 42000: Access denied for user 'u1'@'127.0.0.1' to database 'db'
+disconnect u1;
+disconnect r1;
+connection default;
+drop role r1;
+drop user r1@localhost;
+drop user u1@'127.0.0.1';
+drop database db;
diff --git a/mysql-test/suite/roles/role_user_acl_cache.test b/mysql-test/suite/roles/role_user_acl_cache.test
new file mode 100644
index 00000000..5420c990
--- /dev/null
+++ b/mysql-test/suite/roles/role_user_acl_cache.test
@@ -0,0 +1,34 @@
+--source include/not_embedded.inc
+--echo #
+--echo # MDEV-40541 role vs user@localhost acl_cache key confusion
+--echo #
+create database db;
+create table db.t1(a varchar(40));
+insert into db.t1 values ('role-cache-collision-row');
+
+create role r1;
+create user r1@localhost identified by 'r1pass';
+create user u1@'127.0.0.1' identified by 'u1pass';
+
+grant select on db.* to r1@localhost;
+grant r1 to u1@'127.0.0.1';
+
+connect r1,localhost,r1,r1pass;
+select a from db.t1;
+
+connect u1,127.0.0.1,u1,u1pass,,$MASTER_MYPORT;
+set role r1;
+--sorted_result
+show grants;
+--error ER_TABLEACCESS_DENIED_ERROR
+select a from db.t1;
+--error ER_DBACCESS_DENIED_ERROR
+use db;
+disconnect u1;
+disconnect r1;
+
+connection default;
+drop role r1;
+drop user r1@localhost;
+drop user u1@'127.0.0.1';
+drop database db;
