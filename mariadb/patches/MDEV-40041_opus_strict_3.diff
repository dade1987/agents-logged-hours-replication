--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -876,8 +876,12 @@ int close_thread_tables(THD *thd) noexcept
       /*
         For simple locking we cleanup it here because we don't close thread
         tables. For prelocking we close it when we do close thread tables.
+        Under LOCK TABLES with prelocking (e.g. a trigger or a stored
+        function) we must not cleanup in a sub-statement, as the tables
+        are still in use by the top-level statement: the cleanup is done
+        when the top-level statement closes its tables.
       */
-      if (thd->locked_tables_mode != LTM_PRELOCKED)
+      if (thd->locked_tables_mode != LTM_PRELOCKED && !thd->in_sub_stmt)
