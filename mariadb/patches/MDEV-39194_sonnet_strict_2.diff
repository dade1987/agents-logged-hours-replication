@@ -2415,6 +2415,26 @@ Type_handler_int_result::make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
 }
 
 
+/*
+  Hex hybrid literals (0xHH, X'HH', b'01') have a short string length, but
+  their numeric value can be much larger than what a DOUBLE field of that
+  length can hold (the value would be truncated by the field's length).
+  Use an unsigned BIGINT field, as store_hex_hybrid() expects.
+*/
+Field *
+Type_handler_hex_hybrid::make_num_distinct_aggregator_field(
+                                                         MEM_ROOT *mem_root,
+                                                         const Item *item)
+                                                         const
+{
+  return new(mem_root)
+         Field_longlong(NULL, MAX_BIGINT_WIDTH,
+                        (uchar *) (item->maybe_null() ? "" : 0),
+                        item->maybe_null() ? 1 : 0, Field::NONE,
+                        &item->name, 0, true);
+}
+
+
