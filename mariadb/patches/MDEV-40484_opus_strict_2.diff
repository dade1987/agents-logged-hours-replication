diff --git a/sql/sql_view.cc b/sql/sql_view.cc
index ab2d4df9..2bde053b 100644
--- a/sql/sql_view.cc
+++ b/sql/sql_view.cc
@@ -880,6 +880,133 @@ static File_option view_timestamp_parameters[]=
 static LEX_CSTRING view_file_type[]= {{STRING_WITH_LEN("VIEW") }};
 
 
+/*
+  View .frm file_version history:
+    version 1 - before 10.0.5
+    version 2 - empty definer_host means a role
+    version 3 - definer_user and definer_host are escaped
+                (see write_escaped_string() in parse_file.cc)
+*/
+static const ulonglong VIEW_FILE_VERSION_ESCAPED_DEFINER= 3;
+
+
+/**
+  Escape a definer user or host name for storing in a view .frm file.
+
+  definer_user and definer_host are stored as plain (FILE_OPTIONS_STRING)
+  values, terminated by '\n'. A user name (or host name) containing '\n'
+  could otherwise inject arbitrary parameters (e.g. definer_host or suid)
+  into the view definition file. Must be in sync with read_escaped_string().
+*/
+
+static bool escape_definer_part(THD *thd, LEX_CSTRING *str)
+{
+  if (!str->str)
+    return false;
+  char *buf= (char*) thd->alloc(str->length * 2 + 1);
+  if (!buf)
+    return true;
+  char *to= buf;
+  for (const char *ptr= str->str, *end= str->str + str->length;
+       ptr < end; ptr++)
+  {
+    switch (*ptr) {
+    case '\\': *to++= '\\'; *to++= '\\'; break;
+    case '\n': *to++= '\\'; *to++= 'n';  break;
+    case '\0': *to++= '\\'; *to++= '0';  break;
+    case 26:   *to++= '\\'; *to++= 'z';  break;
+    case '\'': *to++= '\\'; *to++= '\''; break;
+    default:   *to++= *ptr;
+    }
+  }
+  *to= '\0';
+  str->str= buf;
+  str->length= to - buf;
+  return false;
+}
+
+
+/**
+  Unescape a definer user or host name read from a view .frm file
+  (in place: the unescaped string is never longer than the escaped one).
+
+  @retval false OK
+  @retval true  wrong escape sequence
+*/
+
+static bool unescape_definer_part(LEX_CSTRING *str)
+{
+  if (!str->str || !str->length)
+    return false;
+  LEX_STRING tmp= { const_cast<char*>(str->str), str->length };
+  if (read_escaped_string(str->str, str->str + str->length, &tmp))
+    return true;
+  str->length= tmp.length;
+  return false;
+}
+
+
+/**
+  Unescape definer of a view, read from a view .frm file, if the
+  file format stores it escaped.
+*/
+
+static bool unescape_view_definer(TABLE_LIST *view)
+{
+  if (view->file_version < VIEW_FILE_VERSION_ESCAPED_DEFINER)
+    return false;
+  if (unescape_definer_part(&view->definer.user) ||
+      unescape_definer_part(&view->definer.host))
+  {
+    my_error(ER_FPARSER_ERROR_IN_PARAMETER, MYF(0), "definer",
+             view->definer.user.str ? view->definer.user.str : "");
+    return true;
+  }
+  return false;
+}
+
+
+/**
+  Write a view .frm file, escaping definer_user and definer_host.
+  The TABLE_LIST is left unchanged.
+*/
+
+static bool write_view_definition_file(THD *thd, const LEX_CSTRING *dir,
+                                       const LEX_CSTRING *file,
+                                       TABLE_LIST *view)
+{
+  LEX_CSTRING user= view->definer.user, host= view->definer.host;
+  ulonglong file_version= view->file_version;
+  bool res;
+
+  /*
+    The file is going to be written in the latest format, where
+    an empty definer_host means a role. See mysql_make_view().
+  */
+  if (file_version < 2 && view->definer.host.str &&
+      !view->definer.host.str[0])
+    view->definer.host= host_not_specified;
+
+  if (escape_definer_part(thd, &view->definer.user) ||
+      escape_definer_part(thd, &view->definer.host))
+  {
+    view->definer.user= user;
+    view->definer.host= host;
+    my_error(ER_OUT_OF_RESOURCES, MYF(0));
+    return true;
+  }
+  view->file_version= VIEW_FILE_VERSION_ESCAPED_DEFINER;
+
+  res= sql_create_definition_file(dir, file, view_file_type,
+                                  (uchar*) view, view_parameters);
+
+  view->definer.user= user;
+  view->definer.host= host;
+  view->file_version= file_version;
+  return res;
+}
+
