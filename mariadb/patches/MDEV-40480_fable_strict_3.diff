 POINT(37.646944 -75.761111)	їєі
 drop table t1, t2;
 # End of 10.5 tests
+#
+# MDEV-40480 LOAD DATA leaves a stale STORED generated column after a
+#            BEFORE INSERT trigger changes its base column
+#
+CREATE TABLE t1 (
+id   INT PRIMARY KEY,
+v    INT NOT NULL,
+g    INT GENERATED ALWAYS AS (v * 2) STORED,
+vg   INT GENERATED ALWAYS AS (v * 3) VIRTUAL,
+note VARCHAR(20)
+);
+CREATE TRIGGER t1_bi BEFORE INSERT ON t1 FOR EACH ROW SET NEW.v = 20;
+LOAD DATA INFILE 'MYSQLTEST_VARDIR/tmp/mdev40480.txt' INTO TABLE t1
+FIELDS TERMINATED BY '\t' LINES TERMINATED BY '\n' (id, v, note);
+SELECT id, v, g, vg, note, g = v * 2 AS invariant_holds FROM t1 ORDER BY id;
+id	v	g	vg	note	invariant_holds
+2	20	40	60	new	1
+3	20	40	60	old	1
+LOAD DATA INFILE 'MYSQLTEST_VARDIR/tmp/mdev40480.txt' INTO TABLE t1
+FIELDS TERMINATED BY '\t' LINES TERMINATED BY '\n' (@id, v, note)
+SET id = @id + 10;
+SELECT id, v, g, vg, note, g = v * 2 AS invariant_holds FROM t1 ORDER BY id;
+id	v	g	vg	note	invariant_holds
+2	20	40	60	new	1
+3	20	40	60	old	1
+12	20	40	60	new	1
+13	20	40	60	old	1
+DROP TABLE t1;
+# End of 10.11 tests
diff --git a/mysql-test/main/loaddata.test b/mysql-test/main/loaddata.test
