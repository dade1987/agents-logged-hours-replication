diff --git a/mysql-test/suite/plugins/t/server_audit_reinstall.test b/mysql-test/suite/plugins/t/server_audit_reinstall.test
new file mode 100644
index 00000000..402fea08
--- /dev/null
+++ b/mysql-test/suite/plugins/t/server_audit_reinstall.test
@@ -0,0 +1,38 @@
+--source include/not_embedded.inc
+
+if (!$SERVER_AUDIT_SO) {
+  skip No SERVER_AUDIT plugin;
+}
+
+--echo #
+--echo # MDEV-34074 plugins.thread_pool_server_audit crashes in get_loc_info()
+--echo #            with null pointer dereference
+--echo #
+
+install plugin server_audit soname 'server_audit';
+--disable_warnings
+uninstall plugin server_audit;
+--enable_warnings
+# the plugin is actually unloaded by this connection after the statement
+# above completes, before the next statement is processed
+select 1;
+
+connect (con1,localhost,root,,);
+# make the session copy its dynamic (plugin) variables from the global ones
+# while the plugin is not loaded
+--disable_result_log
+show session variables like 'server_audit%';
+--enable_result_log
+# used to crash in the audit plugin with the thread-local variable being NULL
+install plugin server_audit soname 'server_audit';
+select 1;
+create table t1 (a int);
+insert into t1 values (1);
+select * from t1;
+drop table t1;
+--disable_warnings
+uninstall plugin server_audit;
+--enable_warnings
+disconnect con1;
+connection default;
+select 1;
