index 74917bbc..2cb29efd 100644
--- a/sql/sql_type.cc
+++ b/sql/sql_type.cc
@@ -2415,6 +2415,25 @@ Type_handler_int_result::make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
 }
 
 
+/**
+  A hex/bit hybrid literal (0xHH, b'0101') is an integer value in numeric
+  context. Use a longlong field for its DISTINCT aggregator, the same way as
+  for other integer results. A double field would be sized by item->max_length
+  (the number of bytes) and get truncated, e.g. b'1100' would become 9.
+*/
+Field *
+Type_handler_hex_hybrid::make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
+                                                            const Item *item)
+                                                            const
+{
+  return new(mem_root)
+         Field_longlong(NULL, item->max_length,
+                        (uchar *) (item->maybe_null() ? "" : 0),
+                        item->maybe_null() ? 1 : 0, Field::NONE,
+                        &item->name, 0, item->unsigned_flag);
+}
+
+
