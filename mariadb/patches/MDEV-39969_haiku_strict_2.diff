diff --git a/sql/json_table.cc b/sql/json_table.cc
index e5ac6008..b772bf25 100644
--- a/sql/json_table.cc
+++ b/sql/json_table.cc
@@ -384,6 +384,22 @@ static void store_json_in_field(Field *f, const json_engine_t *je)
     }
     break;
   }
+  case JSON_VALUE_NUMBER:
+    if (f->type() == MYSQL_TYPE_BIT)
+    {
+      /*
+        A BIT field stores a binary string, so the textual form of the
+        number ("0") must not be stored as is: it would be taken as the
+        byte 0x30. Convert the number to its numeric value instead.
+      */
+      int err;
+      char *end;
+      double d= my_strntod_8bit(&my_charset_latin1, (char*) je->value,
+                                je->value_len, &end, &err);
+      f->store(d);
+      return;
+    }
+    break;
   default:
     break;
   };
