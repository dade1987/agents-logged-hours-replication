diff --git a/mysql-test/main/to_date_var.test b/mysql-test/main/to_date_var.test
new file mode 100644
index 00000000..aeffd483
--- /dev/null
+++ b/mysql-test/main/to_date_var.test
@@ -0,0 +1,13 @@
+--echo # MDEV-41657 TO_DATE no longer works as a variable
+CREATE TABLE t1 (to_date DATE);
+INSERT INTO t1 VALUES ('2020-01-01');
+SELECT to_date FROM t1;
+DROP TABLE t1;
+SET @to_date=1;
+SELECT @to_date;
+DELIMITER $$;
+BEGIN NOT ATOMIC
+  DECLARE to_date INT DEFAULT 5;
+  SELECT to_date;
+END $$
+DELIMITER ;$$
