+select json_object_filter_keys(@obj, '["c"]');
+ERROR 70100: Query execution was interrupted (max_statement_time exceeded)
+select json_object_to_array(@obj);
+ERROR 70100: Query execution was interrupted (max_statement_time exceeded)
+select json_schema_valid('{"type":"array"}', @arr);
+ERROR 70100: Query execution was interrupted (max_statement_time exceeded)
+SET debug_dbug= @old_debug;
+disconnect u2;
+connection default;
+set global max_allowed_packet=default;
+#
+# End of 11.4 tests
+#
