+#
+# MDEV-39742 11.4 JSON functions not interuptable
+#
+set global max_allowed_packet=1073741824;
+connect u2,localhost,root;
+set group_concat_max_len= 1000000000;
+set @obj=concat_ws('','{', repeat('"a":"b",', 1250000/2), '"c":"d"}');
+set @arr=concat_ws('','[', repeat('1234567,', 1250000/2), '2345678]');
+set max_statement_time=0.0001;
+SET @old_debug= @@debug_dbug;
+SET debug_dbug='+d,json_pause_execution';
+select json_array_intersect('[1234567]', @arr);
