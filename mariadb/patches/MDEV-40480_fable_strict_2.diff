+      if (fields.elements)
       {
-        DBUG_ASSERT(table == item_field->field->table);
-        result|= table->update_virtual_fields(table->file,
-                                              VCOL_UPDATE_FOR_WRITE);
+        Item_field *item_field= fields.head()->field_for_view_update();
+        DBUG_ASSERT(!item_field || table == item_field->field->table);
       }
+#endif
+      result|= table->update_virtual_fields(table->file,
