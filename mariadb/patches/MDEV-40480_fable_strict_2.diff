+#
+# MDEV-40480 LOAD DATA leaves a stale STORED generated column after a
+#            BEFORE INSERT trigger changes its base column
+#
+CREATE TABLE t1 (
+id INT PRIMARY KEY,
+v INT NOT NULL,
+g INT GENERATED ALWAYS AS (v * 2) STORED,
+vg INT GENERATED ALWAYS AS (v * 3) VIRTUAL,
+note VARCHAR(20)
+);
+CREATE TRIGGER t1_bi BEFORE INSERT ON t1 FOR EACH ROW SET NEW.v = 20;
+LOAD DATA INFILE 'MYSQLTEST_VARDIR/tmp/t1.tsv' INTO TABLE t1 (id, v, note);
+LOAD DATA INFILE 'MYSQLTEST_VARDIR/tmp/t1.tsv' INTO TABLE t1 (@a, v, note) SET id = @a + 1;
+LOAD DATA INFILE 'MYSQLTEST_VARDIR/tmp/t1.tsv' INTO TABLE t1 (id, v, note) SET id = 4;
+SELECT id, v, g, vg, g = v * 2 AS invariant_holds FROM t1 ORDER BY id;
+id	v	g	vg	invariant_holds
+2	20	40	60	1
+3	20	40	60	1
+4	20	40	60	1
+DROP TABLE t1;
+# End of 10.6 tests
