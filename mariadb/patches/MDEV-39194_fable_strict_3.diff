+Field *
+Type_handler_hex_hybrid::make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
+                                                            const Item *item)
+                                                            const
+{
+  /*
+    In numeric context a hex hybrid (0xFF, b'1100') is an unsigned integer.
+    The inherited string handler would create a Field_double whose length
+    is item->max_length, i.e. the number of bytes of the literal (1 for
+    b'1100'), so storing the value 12 into it would be truncated to 9.
+    Use a BIGINT UNSIGNED field instead, like Type_handler_int_result does,
+    so that SUM(DISTINCT b'1100') and AVG(DISTINCT 0xFF) see the same
+    values as SUM(b'1100') and AVG(0xFF).
+  */
+  return new(mem_root)
+         Field_longlong(NULL, MY_INT64_NUM_DECIMAL_DIGITS,
+                        (uchar *) (item->maybe_null() ? "" : 0),
+                        item->maybe_null() ? 1 : 0, Field::NONE,
+                        &item->name, 0, true);
+}
+
+
 bool Type_handler_hex_hybrid::
        Item_hybrid_func_fix_attributes(THD *thd,
                                        const LEX_CSTRING &func_name,
