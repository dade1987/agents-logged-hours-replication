diff --git a/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test b/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test
new file mode 100644
index 00000000..9e533a97
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test
@@ -0,0 +1,45 @@
+#
+# MDEV-22848: Assertion `trx_is_registered_for_2pc(trx)' failed in
+#             innobase_xa_prepare on DROP and in innobase_savepoint on
+#             SAVEPOINT
+#
+# With autocommit=0, SET GLOBAL gtid_slave_pos updated the (InnoDB)
+# mysql.gtid_slave_pos table, leaving InnoDB registered in the multi-statement
+# transaction of the connection even though the InnoDB transaction itself
+# had been committed. A following implicit commit (eg. DROP TABLE) or
+# SAVEPOINT in the same connection then hit assertions in InnoDB.
+#
+--source include/have_innodb.inc
+--source include/have_log_bin.inc
+--source include/have_binlog_format_mixed.inc
+
+--let $old_slave_pos_engine= query_get_value(SHOW TABLE STATUS FROM mysql LIKE 'gtid_slave_pos', Engine, 1)
+
+ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;
+
+SET autocommit=0;
+CREATE TABLE t1 (c INT) ENGINE=MyISAM;
+SET GLOBAL gtid_slave_pos="0-1-100";
+INSERT INTO t1 VALUES (0);
+--error ER_BAD_TABLE_ERROR
+DROP TABLE not_there;
+COMMIT;
+
+SET GLOBAL gtid_slave_pos="0-1-200";
+INSERT INTO t1 VALUES (1);
+SAVEPOINT sp1;
+INSERT INTO t1 VALUES (2);
+RELEASE SAVEPOINT sp1;
+COMMIT;
+
+SELECT * FROM t1 ORDER BY c;
+DROP TABLE t1;
+COMMIT;
+SET autocommit=1;
+
+# Cleanup
+--disable_query_log
+--eval ALTER TABLE mysql.gtid_slave_pos ENGINE=$old_slave_pos_engine
+--enable_query_log
+RESET MASTER;
+SET GLOBAL gtid_slave_pos="";
diff --git a/sql/rpl_gtid.cc b/sql/rpl_gtid.cc
index 9004aea2..f82085ba 100644
--- a/sql/rpl_gtid.cc
+++ b/sql/rpl_gtid.cc
@@ -699,6 +699,30 @@ rpl_slave_state::record_gtid(THD *thd, const rpl_gtid *gtid, uint64 sub_id,
   */
   suspended_wfc= thd->suspend_subsequent_commits();
   thd->lex->reset_n_backup_query_tables_list(&lex_backup);
+
+  /*
+    The option bits must be adjusted _before_ opening and locking the table.
+    Otherwise, if the user has set autocommit=0 (OPTION_NOT_AUTOCOMMIT) or is
+    inside a BEGIN (OPTION_BEGIN), the storage engine (eg. InnoDB) will at
+    external_lock() time register itself as a participant in the
+    "all" (multi-statement) transaction of the THD. The ha_commit_trans(thd,
+    FALSE) below would then only be a statement commit, leaving the engine
+    registered in thd->transaction->all.ha_list even though the engine
+    transaction itself got committed (as we cleared OPTION_NOT_AUTOCOMMIT).
+    A later implicit or explicit COMMIT (or SAVEPOINT) in the user connection
+    would then find a stale registration, leading to assertions like
+    `trx_is_registered_for_2pc(trx)' in InnoDB (MDEV-22848).
+  */
+  if (!in_transaction)
+  {
+    DBUG_PRINT("info", ("resetting OPTION_BEGIN"));
+    thd->variables.option_bits&=
+      ~(ulonglong)(OPTION_NOT_AUTOCOMMIT |OPTION_BEGIN |OPTION_BIN_LOG |
+                   OPTION_GTID_BEGIN);
+  }
+  else
+    thd->variables.option_bits&= ~(ulonglong)OPTION_BIN_LOG;
+
   tlist.init_one_table(&MYSQL_SCHEMA_NAME, &gtid_pos_table_name, NULL, TL_WRITE);
   if ((err= open_and_lock_tables(thd, &tlist, FALSE, 0)))
     goto end;
@@ -714,16 +738,6 @@ rpl_slave_state::record_gtid(THD *thd, const rpl_gtid *gtid, uint64 sub_id,
   thd->wsrep_ignore_table= true; // Do not replicate mysql.gtid_slave_pos table
 #endif
 
