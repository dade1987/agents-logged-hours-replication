diff --git a/mysql-test/suite/archive/archive.result b/mysql-test/suite/archive/archive.result
index fa2b4f7e..af1f84e9 100644
--- a/mysql-test/suite/archive/archive.result
+++ b/mysql-test/suite/archive/archive.result
@@ -12906,3 +12906,34 @@ t1	CREATE TEMPORARY TABLE `t1` (
   `b` varchar(10) DEFAULT NULL
 ) ENGINE=ARCHIVE DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
 drop table t1;
+#
+# MDEV-24245 REPAIR on ARCHIVE table destroys TEXT data
+#
+CREATE TABLE t1 (a INT, t TEXT, b BLOB) ENGINE=ARCHIVE;
+INSERT INTO t1 VALUES (1,'Testtext','blobdata'),(2,REPEAT('x',300),NULL),
+(3,NULL,REPEAT('y',1000));
+SELECT a, t, LENGTH(t), LENGTH(b), b=REPEAT('y',1000) FROM t1;
+a	t	LENGTH(t)	LENGTH(b)	b=REPEAT('y',1000)
+1	Testtext	8	8	0
+2		300	NULL	NULL
+3	NULL	NULL	1000	1
+REPAIR TABLE t1;
+Table	Op	Msg_type	Msg_text
+test.t1	repair	status	OK
+SELECT a, t, LENGTH(t), LENGTH(b), b=REPEAT('y',1000) FROM t1;
+a	t	LENGTH(t)	LENGTH(b)	b=REPEAT('y',1000)
+1	Testtext	8	8	0
+2		300	NULL	NULL
+3	NULL	NULL	1000	1
+OPTIMIZE TABLE t1;
+Table	Op	Msg_type	Msg_text
+test.t1	optimize	status	OK
+SELECT a, t, LENGTH(t), LENGTH(b), b=REPEAT('y',1000) FROM t1;
+a	t	LENGTH(t)	LENGTH(b)	b=REPEAT('y',1000)
+1	Testtext	8	8	0
+2		300	NULL	NULL
+3	NULL	NULL	1000	1
+CHECK TABLE t1;
+Table	Op	Msg_type	Msg_text
+test.t1	check	status	OK
+DROP TABLE t1;
diff --git a/mysql-test/suite/archive/archive.test b/mysql-test/suite/archive/archive.test
index 94a6e0c4..029c7000 100644
--- a/mysql-test/suite/archive/archive.test
