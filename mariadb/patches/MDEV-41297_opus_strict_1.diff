diff --git a/mysql-test/suite/heap/blob_empty_pad.result b/mysql-test/suite/heap/blob_empty_pad.result
new file mode 100644
index 00000000..8113634f
--- /dev/null
+++ b/mysql-test/suite/heap/blob_empty_pad.result
@@ -0,0 +1,45 @@
+#
+# MDEV-41297 Wrong result upon DISTINCT/GROUP BY/UNION on TEXT with
+# empty and all-space values
+#
+CREATE TABLE t1 (a TEXT);
+INSERT INTO t1 VALUES (''),('   ');
+SELECT COUNT(*) FROM (SELECT DISTINCT a FROM t1) AS d;
+COUNT(*)
+1
+SELECT COUNT(DISTINCT a) FROM t1;
+COUNT(DISTINCT a)
+1
+SELECT COUNT(*) FROM (SELECT a FROM t1 GROUP BY a) AS g;
+COUNT(*)
+1
+SELECT COUNT(*) FROM (SELECT a FROM t1 WHERE LENGTH(a)=0 UNION SELECT a FROM t1 WHERE LENGTH(a)=3) AS u;
+COUNT(*)
+1
+DROP TABLE t1;
+CREATE TABLE t1 (a TEXT CHARACTER SET latin1);
+INSERT INTO t1 VALUES (''),('   ');
+SELECT COUNT(*) FROM (SELECT DISTINCT a FROM t1) AS d;
+COUNT(*)
+1
+SELECT COUNT(DISTINCT a) FROM t1;
+COUNT(DISTINCT a)
+1
+SELECT COUNT(*) FROM (SELECT a FROM t1 GROUP BY a) AS g;
+COUNT(*)
+1
+SELECT COUNT(*) FROM (SELECT a FROM t1 WHERE LENGTH(a)=0 UNION SELECT a FROM t1 WHERE LENGTH(a)=3) AS u;
+COUNT(*)
+1
+DROP TABLE t1;
+# NO PAD collation: the values stay different
+CREATE TABLE t1 (a TEXT CHARACTER SET utf8mb4 COLLATE utf8mb4_nopad_bin);
+INSERT INTO t1 VALUES (''),('   ');
+SELECT COUNT(*) FROM (SELECT DISTINCT a FROM t1) AS d;
+COUNT(*)
+2
+SELECT COUNT(DISTINCT a) FROM t1;
+COUNT(DISTINCT a)
+2
+DROP TABLE t1;
+# End of tests
diff --git a/mysql-test/suite/heap/blob_empty_pad.test b/mysql-test/suite/heap/blob_empty_pad.test
new file mode 100644
index 00000000..debde908
--- /dev/null
+++ b/mysql-test/suite/heap/blob_empty_pad.test
@@ -0,0 +1,29 @@
+--echo #
+--echo # MDEV-41297 Wrong result upon DISTINCT/GROUP BY/UNION on TEXT with
+--echo # empty and all-space values
+--echo #
+
+CREATE TABLE t1 (a TEXT);
+INSERT INTO t1 VALUES (''),('   ');
+SELECT COUNT(*) FROM (SELECT DISTINCT a FROM t1) AS d;
+SELECT COUNT(DISTINCT a) FROM t1;
+SELECT COUNT(*) FROM (SELECT a FROM t1 GROUP BY a) AS g;
+SELECT COUNT(*) FROM (SELECT a FROM t1 WHERE LENGTH(a)=0 UNION SELECT a FROM t1 WHERE LENGTH(a)=3) AS u;
+DROP TABLE t1;
+
+CREATE TABLE t1 (a TEXT CHARACTER SET latin1);
+INSERT INTO t1 VALUES (''),('   ');
+SELECT COUNT(*) FROM (SELECT DISTINCT a FROM t1) AS d;
+SELECT COUNT(DISTINCT a) FROM t1;
+SELECT COUNT(*) FROM (SELECT a FROM t1 GROUP BY a) AS g;
+SELECT COUNT(*) FROM (SELECT a FROM t1 WHERE LENGTH(a)=0 UNION SELECT a FROM t1 WHERE LENGTH(a)=3) AS u;
+DROP TABLE t1;
+
+--echo # NO PAD collation: the values stay different
+CREATE TABLE t1 (a TEXT CHARACTER SET utf8mb4 COLLATE utf8mb4_nopad_bin);
+INSERT INTO t1 VALUES (''),('   ');
+SELECT COUNT(*) FROM (SELECT DISTINCT a FROM t1) AS d;
+SELECT COUNT(DISTINCT a) FROM t1;
+DROP TABLE t1;
+
+--echo # End of tests
