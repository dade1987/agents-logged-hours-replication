diff --git a/mysql-test/suite/heap/blob_pad_space_empty.result b/mysql-test/suite/heap/blob_pad_space_empty.result
new file mode 100644
index 00000000..5f6cf301
--- /dev/null
+++ b/mysql-test/suite/heap/blob_pad_space_empty.result
@@ -0,0 +1,20 @@
+#
+# MDEV-41297: an empty and an all-space TEXT value are equal under the
+# PAD SPACE collation, so they must form one value in HEAP internal
+# temporary tables (DISTINCT, GROUP BY, UNION, COUNT(DISTINCT)).
+#
+CREATE TABLE t1 (a TEXT);
+INSERT INTO t1 VALUES (''),('   ');
+SELECT COUNT(*) FROM (SELECT DISTINCT a FROM t1) AS d;
+COUNT(*)
+1
+SELECT COUNT(DISTINCT a) FROM t1;
+COUNT(DISTINCT a)
+1
+SELECT COUNT(*) FROM (SELECT a FROM t1 GROUP BY a) AS g;
+COUNT(*)
+1
+SELECT COUNT(*) FROM (SELECT a FROM t1 WHERE LENGTH(a)=0 UNION SELECT a FROM t1 WHERE LENGTH(a)=3) AS u;
+COUNT(*)
+1
+DROP TABLE t1;
