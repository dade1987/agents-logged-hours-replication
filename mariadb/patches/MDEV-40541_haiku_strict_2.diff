                         1 + USERNAME_LENGTH + 1)
+/* first byte of acl_cache keys for roles; never a valid first byte of an ip */
+#define ACL_ROLE_CACHE_KEY_PREFIX '\1'
 
 #if defined(HAVE_OPENSSL)
 /*
@@ -3701,10 +3703,21 @@ privilege_t acl_get(const char *host, const char *ip,
