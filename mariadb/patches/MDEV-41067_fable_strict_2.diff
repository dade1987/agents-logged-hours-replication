diff --git a/mysql-test/main/func_json.result b/mysql-test/main/func_json.result
index 2f791dc4..d7e75b64 100644
--- a/mysql-test/main/func_json.result
+++ b/mysql-test/main/func_json.result
@@ -5776,4 +5776,38 @@ JSON_SCHEMA_VALID(@schema, @value)
 SELECT JSON_SCHEMA_VALID( '{"enum": ["x"]}', CONVERT(CONCAT('"', REPEAT('e', 100000), '"') USING ucs2)) AS r;
 r
 0
+#
+# MDEV-41067: wrong result with json_overlaps when one of the arguments
+# has an empty nested array element
+#
+SELECT JSON_OVERLAPS('[[1]]', '[[]]');
+JSON_OVERLAPS('[[1]]', '[[]]')
+0
+SELECT JSON_OVERLAPS('[[]]', '[[1]]');
+JSON_OVERLAPS('[[]]', '[[1]]')
+0
+SELECT JSON_OVERLAPS('[[1]]', '[[],123]');
+JSON_OVERLAPS('[[1]]', '[[],123]')
+0
+SELECT JSON_OVERLAPS('[[1,2]]', '[[1]]');
+JSON_OVERLAPS('[[1,2]]', '[[1]]')
+0
+SELECT JSON_OVERLAPS('[[1]]', '[[1,2]]');
+JSON_OVERLAPS('[[1]]', '[[1,2]]')
+0
+SELECT JSON_OVERLAPS('[[1]]', '[[1]]');
+JSON_OVERLAPS('[[1]]', '[[1]]')
+1
+SELECT JSON_OVERLAPS('[[]]', '[[]]');
+JSON_OVERLAPS('[[]]', '[[]]')
+1
+SELECT JSON_OVERLAPS('{"a":[1]}', '{"a":[]}');
+JSON_OVERLAPS('{"a":[1]}', '{"a":[]}')
+0
+SELECT JSON_OVERLAPS('{"a":[]}', '{"a":[1]}');
+JSON_OVERLAPS('{"a":[]}', '{"a":[1]}')
+0
+SELECT JSON_OVERLAPS('{"a":[]}', '{"a":[]}');
+JSON_OVERLAPS('{"a":[]}', '{"a":[]}')
+1
 # End of 11.4 tests
