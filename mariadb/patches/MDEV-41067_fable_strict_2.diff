diff --git a/sql/item_jsonfunc.cc b/sql/item_jsonfunc.cc
index 615d0cb4..d821cf86 100644
--- a/sql/item_jsonfunc.cc
+++ b/sql/item_jsonfunc.cc
@@ -4809,7 +4809,12 @@ bool json_compare_arrays_in_order(json_engine_t *js, json_engine_t *value)
       return FALSE;
     }
   }
-  res= (value->state == JST_ARRAY_END || value->state == JST_OBJ_END ?
+  /*
+    Nested arrays are compared in order and must be identical, so both of
+    them have to be exhausted at the same time. If only one of them has
+    reached its end (for example [1] and []), the arrays are different.
+  */
+  res= (js->state == JST_ARRAY_END && value->state == JST_ARRAY_END ?
         TRUE : FALSE);
   json_skip_current_level(js, value);
   return res;
