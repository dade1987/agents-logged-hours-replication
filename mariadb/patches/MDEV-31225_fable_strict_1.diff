--- a/sql/sql_tvc.cc
+++ b/sql/sql_tvc.cc
@@ -894,6 +894,16 @@ static bool cmp_row_types(Item* item1, Item* item2)
   {
     Item *inner= item1->element_index(i);
     Item *outer= item2->element_index(i);
+    /*
+      Nested rows, e.g. ROW(a,(a,a)) IN ((1,(1,1)),...), cannot be
+      materialized: the row type handler does not support
+      subquery_type_allows_materialization() and a column of a derived
+      table cannot be of a row type. Treat them as a type mismatch so that
+      the IN predicate is not converted into an IN subquery.
+    */
+    if (inner->type() == Item::ROW_ITEM || outer->type() == Item::ROW_ITEM ||
+        inner->cols() != 1 || outer->cols() != 1)
+      return true;
     if (!inner->type_handler()->subquery_type_allows_materialization(inner,
                                                                      outer,
                                                                      true))
