@@ -8970,6 +8970,24 @@ Type_handler_hex_hybrid::cast_to_int_type_handler() const
 }
 
 
+/*
+  A hex hybrid value (e.g. b'1100' or 0x0C) is an unsigned integer of up to
+  8 bytes. Use an unsigned BIGINT field for the SUM(DISTINCT)/AVG(DISTINCT)
+  temporary storage, not the default DOUBLE field: the DOUBLE field would be
+  sized from the byte length of the literal (e.g. 1 for b'1100'), so its
+  values would be truncated to that many digits (12 would become 9).
+*/
+Field *Type_handler_hex_hybrid::
+  make_num_distinct_aggregator_field(MEM_ROOT *mem_root, const Item *item) const
+{
+  return new(mem_root)
+         Field_longlong(NULL, item->max_length,
+                        (uchar *) (item->maybe_null() ? "" : 0),
+                        item->maybe_null() ? 1 : 0, Field::NONE,
+                        &item->name, 0, true);
+}
+
+
 bool Type_handler_hex_hybrid::
        Item_hybrid_func_fix_attributes(THD *thd,
                                        const LEX_CSTRING &func_name,
