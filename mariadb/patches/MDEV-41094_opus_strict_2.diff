diff --git a/sql/item_strfunc.cc b/sql/item_strfunc.cc
index 34e47988..611e711b 100644
--- a/sql/item_strfunc.cc
+++ b/sql/item_strfunc.cc
@@ -572,9 +572,14 @@ String *Item_func_kdf::val_str(String *buf)
   else
   {
     longlong iter= arg_count > 2 ? args[2]->val_int() : 1000;
-    if (iter <= 0)
+    /*
+      PKCS5_PBKDF2_HMAC() takes the iteration count as int. Reject values
+      that do not fit instead of silently truncating them to a (possibly
+      much smaller) 32-bit alias. Large unsigned values are negative here.
+    */
+    if (iter <= 0 || iter > INT_MAX32)
     {
-      if (!args[2]->null_value)
+      if (arg_count > 2 && !args[2]->null_value)
         invalid_argument_error(func_name(),
           ErrConvInteger({iter, args[2]->unsigned_flag}).ptr());
     }
