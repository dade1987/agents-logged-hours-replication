--- a/mysql-test/main/func_kdf.result
+++ b/mysql-test/main/func_kdf.result
@@ -181,5 +181,34 @@ SELECT KDF('secret','salt') IS NOT NULL;
 KDF('secret','salt') IS NOT NULL
 1
 #
+# MDEV-41094 KDF() silently reduces large PBKDF2 iteration counts
+#             to weak 32-bit aliases
+#
+SELECT KDF('secret','salt',4294968296,'pbkdf2_hmac',256);
+KDF('secret','salt',4294968296,'pbkdf2_hmac',256)
+NULL
+Warnings:
+Warning	3047	Invalid argument error: 4294968296 in function kdf.
+SELECT KDF('secret','salt',4294968297,'pbkdf2_hmac',256);
+KDF('secret','salt',4294968297,'pbkdf2_hmac',256)
+NULL
+Warnings:
+Warning	3047	Invalid argument error: 4294968297 in function kdf.
+SELECT KDF('secret','salt',2147483648,'pbkdf2_hmac',256);
+KDF('secret','salt',2147483648,'pbkdf2_hmac',256)
+NULL
+Warnings:
+Warning	3047	Invalid argument error: 2147483648 in function kdf.
+SELECT KDF('secret','salt',18446744073709551615,'pbkdf2_hmac',256);
+KDF('secret','salt',18446744073709551615,'pbkdf2_hmac',256)
+NULL
+Warnings:
+Warning	3047	Invalid argument error: 18446744073709551615 in function kdf.
+SELECT KDF('secret','salt',4294967296);
+KDF('secret','salt',4294967296)
+NULL
+Warnings:
+Warning	3047	Invalid argument error: 4294967296 in function kdf.
+#
 # End of 11.4 tests
 #
