diff --git a/sql/sql_acl.cc b/sql/sql_acl.cc
index de8a27c9..1601ddcd 100644
--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -339,6 +339,7 @@ ulong role_global_merges= 0, role_db_merges= 0, role_table_merges= 0,
 
 #ifndef NO_EMBEDDED_ACCESS_CHECKS
 static bool ignore_max_password_errors(const ACL_USER *acl_user);
+static bool check_password_lifetime(THD *thd, const ACL_USER &acl_user);
 static void update_hostname(acl_host_and_ip *host, const char *hostname);
 static bool show_proxy_grants (THD *, const char *, const char *,
                                char *, size_t);
@@ -12888,6 +12889,14 @@ int acl_setauthorization(THD *thd, const LEX_USER *user)
     return 1;
   }
 
+  /*
+    Security_context::init() has reset password_expired, so recompute it
+    for the new user. Otherwise a user with an expired password could
+    bypass ER_MUST_CHANGE_PASSWORD with SET SESSION AUTHORIZATION to itself.
+  */
+  sctx->password_expired= acl_user->password_expired ||
+                          check_password_lifetime(thd, *acl_user);
+
   mysql_audit_notify_connection_change_user(thd, &save_security_ctx);
   save_security_ctx.destroy();
   return 0;
