diff --git a/mysql-test/main/func_kdf.test b/mysql-test/main/func_kdf.test
index 279323ed..c0096804 100644
--- a/mysql-test/main/func_kdf.test
+++ b/mysql-test/main/func_kdf.test
@@ -72,6 +72,20 @@ SELECT KDF('secret','salt',1000,999);
 SELECT KDF('secret','salt',1000,'pbkdf2_hmac') IS NOT NULL;
 SELECT KDF('secret','salt') IS NOT NULL;
 
+--echo #
+--echo # MDEV-41094 KDF() silently reduces large PBKDF2 iteration counts
+--echo #            to weak 32-bit aliases
+--echo #
+# iteration counts that do not fit into a 32-bit int must be rejected,
+# not silently truncated (4294968296 must not alias to 1000)
+select hex(kdf('foo', 'bar', 2147483648, 'pbkdf2_hmac'));
+select hex(kdf('foo', 'bar', 4294968296, 'pbkdf2_hmac'));
+select hex(kdf('foo', 'bar', 4294968297, 'pbkdf2_hmac'));
+select hex(kdf('foo', 'bar', 9223372036854775807, 'pbkdf2_hmac'));
+select hex(kdf('foo', 'bar', 18446744073709551615, 'pbkdf2_hmac'));
+select hex(kdf('foo', 'bar', cast(4294968296 as unsigned), 'pbkdf2_hmac'));
+select hex(kdf('foo', 'bar', 4294968296));
+
 --echo #
 --echo # End of 11.4 tests
 --echo #
