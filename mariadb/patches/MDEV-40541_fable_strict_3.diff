--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -644,8 +644,13 @@ bool ROLE_GRANT_PAIR::init(MEM_ROOT *mem, const char *username,
   return false;
 }
 
-#define IP_ADDR_STRLEN (3 + 1 + 3 + 1 + 3 + 1 + 3)
-#define ACL_KEY_LENGTH (IP_ADDR_STRLEN + 1 + NAME_LEN + \
+/*
+  The acl_cache key is "<ip or host>\0<user>\0<db>". The first part is the
+  ip of the connection or, when the connection has no ip (unix socket,
+  named pipe, shared memory), its host name ("localhost"). It must be
+  large enough for any host name.
+*/
+#define ACL_KEY_LENGTH (HOSTNAME_LENGTH + 1 + NAME_LEN + \
                         1 + USERNAME_LENGTH + 1)
 
 #if defined(HAVE_OPENSSL)
@@ -3704,7 +3709,19 @@ privilege_t acl_get(const char *host, const char *ip,
   acl_entry *entry;
   DBUG_ENTER("acl_get");
 
-  tmp_db= strmov(strmov(key, safe_str(ip)) + 1, user) + 1;
+  /*
+    Roles are looked up with an empty host and an empty ip. A connection
+    over a unix socket, named pipe or shared memory has no ip either, but
+    its host is "localhost". If the key only used the ip, the role 'r1'
+    and the user 'r1'@'localhost' would share the same cache entry, and
+    one would get the privileges of the other (MDEV-40541). Use the host
+    name in the key when there is no ip to keep them apart.
+  */
+  const char *key_host= (ip && ip[0]) ? ip : safe_str(host);
+  DBUG_ASSERT(strlen(key_host) <= HOSTNAME_LENGTH);
+  tmp_db= strnmov(key, key_host, HOSTNAME_LENGTH);
+  *tmp_db++= 0;
+  tmp_db= strmov(tmp_db, user) + 1;
   end= strnmov(tmp_db, db, key + sizeof(key) - tmp_db);
 
   if (end >= key + sizeof(key)) // db name was truncated
