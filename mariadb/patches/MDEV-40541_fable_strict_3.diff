diff --git a/mysql-test/suite/roles/role_user_localhost_cache.test b/mysql-test/suite/roles/role_user_localhost_cache.test
new file mode 100644
index 00000000..96aa9729
--- /dev/null
+++ b/mysql-test/suite/roles/role_user_localhost_cache.test
@@ -0,0 +1,55 @@
+#
+# MDEV-40541 role vs user@localhost acl_cache key confusion
+#
+# A role is looked up in the acl_cache with an empty host and ip, a
+# connection over a unix socket has no ip either. Make sure that the role
+# 'r1' and the user 'r1'@'localhost' do not share an acl_cache entry.
+#
+--source include/not_embedded.inc
+
+create database db;
+create table db.t1(a varchar(40));
+insert into db.t1 values ('role-cache-collision-row');
+
+create role r1;
+create user r1@localhost identified by 'r1pass';
+create user u1@'127.0.0.1' identified by 'u1pass';
+
+grant select on db.* to r1@localhost;
+grant r1 to u1@'127.0.0.1';
+
+# populate the acl_cache with the entry for r1@localhost
+--connect (r1,localhost,r1,r1pass,,,,)
+select a from db.t1;
+
+# the role r1 has no privileges on db, so u1 must not see the table
+--connect (u1,127.0.0.1,u1,u1pass,,,,)
+set role r1;
+show grants;
+--error ER_TABLEACCESS_DENIED_ERROR
+select a from db.t1;
+
+# and the other way around: the role must not inherit the user's cache
+# entry when the role is looked up first
+connection default;
+flush privileges;
+grant insert on db.* to r1;
+--connect (u1b,127.0.0.1,u1,u1pass,,,,)
+set role r1;
+--error ER_TABLEACCESS_DENIED_ERROR
+select a from db.t1;
+insert into db.t1 values ('inserted-by-role');
+--connect (r1b,localhost,r1,r1pass,,,,)
+select a from db.t1;
+--error ER_TABLEACCESS_DENIED_ERROR
+insert into db.t1 values ('must-fail');
+
+connection default;
+disconnect r1;
+disconnect u1;
+disconnect u1b;
+disconnect r1b;
+drop user r1@localhost;
+drop user u1@'127.0.0.1';
+drop role r1;
+drop database db;
