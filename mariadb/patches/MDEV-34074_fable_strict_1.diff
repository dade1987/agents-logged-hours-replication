diff --git a/mysql-test/suite/plugins/t/server_audit.test b/mysql-test/suite/plugins/t/server_audit.test
index 91c69a8f..023ba219 100644
--- a/mysql-test/suite/plugins/t/server_audit.test
+++ b/mysql-test/suite/plugins/t/server_audit.test
@@ -293,3 +293,24 @@ remove_file $MYSQLD_DATADIR/server_audit.log;
 --echo #
 install plugin server_audit soname 'server_audit';
 uninstall plugin server_audit;
+
+--echo #
+--echo # MDEV-34074 plugins.thread_pool_server_audit crashes in get_loc_info()
+--echo #            with null pointer dereference
+--echo #
+# At this point the plugin is still "busy": this connection holds a
+# reference to it. Executing any statement releases the reference, the
+# plugin gets unloaded and the global values of its thread-local
+# variables are freed.
+select 1;
+connect (con1,localhost,root,,);
+# Synchronize the session variables of the new connection with the
+# global ones while the plugin is not loaded.
+show variables like 'server_audit%';
+# Reinstalling the plugin re-registers its thread-local variables,
+# and the session value of the new connection must be refreshed.
+install plugin server_audit soname 'server_audit';
+select 1;
+uninstall plugin server_audit;
+disconnect con1;
+connection default;
