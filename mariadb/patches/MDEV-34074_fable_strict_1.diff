+    /*
+      The bookmark already exists, that is the plugin was installed before,
+      then uninstalled, and now it is installed again. When the plugin was
+      uninstalled, the global values of its thread-local variables were
+      freed (see plugin_vars_free_values()), so all THDs that synchronized
+      their session variables in between got, e.g. NULL for
+      PLUGIN_VAR_MEMALLOC strings. Now the plugin will set new global
+      default values, and every existing THD has to re-read them. Bump
+      the version so that sync_dynamic_session_variables() refreshes this
+      variable in all sessions that have the previous value.
+    */
+    global_system_variables.dynamic_variables_version++;
+    max_system_variables.dynamic_variables_version++;
+    result->version= global_system_variables.dynamic_variables_version;
+  }
