diff --git a/mysql-test/main/set_authorization.result b/mysql-test/main/set_authorization.result
index 71194c22..8c6ae358 100644
--- a/mysql-test/main/set_authorization.result
+++ b/mysql-test/main/set_authorization.result
@@ -148,4 +148,17 @@ set session authorization root@localhost;
 -- Tracker : SESSION_TRACK_SCHEMA
 -- 
 
+#
+# MDEV-40336 SET SESSION AUTHORIZATION un-expires passwords
+#
+create user u1@localhost;
+alter user u1@localhost password expire;
+connect con1,localhost,root;
+set session authorization u1@localhost;
+select 2;
+ERROR HY000: You must SET PASSWORD before executing this statement
+disconnect con1;
+connection default;
+drop user u1@localhost;
+
 # End of 12.0 tests
