diff --git a/sql/parse_file.cc b/sql/parse_file.cc
index f4aae130..64866495 100644
--- a/sql/parse_file.cc
+++ b/sql/parse_file.cc
@@ -148,6 +148,17 @@ write_parameter(IO_CACHE *file, const uchar* base, File_option *parameter)
   case FILE_OPTIONS_STRING:
   {
     LEX_STRING *val_s= (LEX_STRING *)(base + parameter->offset);
+    /*
+      Unescaped strings are newline-terminated in the file. A newline
+      inside the value would be parsed as the end of the value and the
+      rest as other parameters, so it can never be written here.
+    */
+    if (val_s->length && memchr(val_s->str, '\n', val_s->length))
+    {
+      my_error(ER_FPARSER_ERROR_IN_PARAMETER, MYF(0), parameter->name.str,
+               "");
+      DBUG_RETURN(TRUE);
+    }
     if (my_b_write(file, (const uchar *)val_s->str, val_s->length))
       DBUG_RETURN(TRUE);
     break;
