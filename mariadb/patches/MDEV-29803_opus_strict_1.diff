diff --git a/mysql-test/suite/binlog/r/binlog_mysqlbinlog_gtid_strict_mode_default.result b/mysql-test/suite/binlog/r/binlog_mysqlbinlog_gtid_strict_mode_default.result
new file mode 100644
index 00000000..fbc378ab
--- /dev/null
+++ b/mysql-test/suite/binlog/r/binlog_mysqlbinlog_gtid_strict_mode_default.result
@@ -0,0 +1,16 @@
+RESET MASTER;
+CREATE TABLE t1 (a int);
+CREATE TABLE t2 (a int);
+DROP TABLE t1, t2;
+FLUSH BINARY LOGS;
+# Replay master-bin.000001 read from the remote server
+DROP TABLE IF EXISTS t1, t2;
+FLUSH BINARY LOGS;
+# Default: no error about out of order GTIDs
+# MYSQL_BINLOG MYSQLD_DATADIR/master-bin.000001 MYSQLD_DATADIR/master-bin.000002 > OUT_FILE 2> ERR_FILE
+NOT FOUND /Found out of order GTID/ in binlog.err
+# Explicit --gtid-strict-mode: error about out of order GTIDs
+# MYSQL_BINLOG --gtid-strict-mode MYSQLD_DATADIR/master-bin.000001 MYSQLD_DATADIR/master-bin.000002 > OUT_FILE 2> ERR_FILE
+FOUND 1 /ERROR: Found out of order GTID/ in binlog.err
+RESET MASTER;
+End of the tests
diff --git a/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_strict_mode_default.test b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_strict_mode_default.test
new file mode 100644
index 00000000..b77a1a0a
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_strict_mode_default.test
@@ -0,0 +1,48 @@
+#
+# MDEV-29803: Unexpected ERROR: Found out of order GTID after replaying
+#             binlog read from remote
+#
+# mariadb-binlog --gtid-strict-mode must be disabled by default, to be
+# consistent with the server's default of gtid_strict_mode=OFF. Binary logs
+# which the server was allowed to write (e.g. after replaying old events with
+# their original GTIDs) must be readable by mariadb-binlog without extra
+# options. Explicitly specifying --gtid-strict-mode must still error.
+#
+
+--source include/have_log_bin.inc
+
+RESET MASTER;
+CREATE TABLE t1 (a int);
+CREATE TABLE t2 (a int);
+DROP TABLE t1, t2;
+FLUSH BINARY LOGS;
+
+--echo # Replay master-bin.000001 read from the remote server
+--exec $MYSQL_BINLOG --read-from-remote-server -uroot --protocol=tcp --port=$MASTER_MYPORT master-bin.000001 | $MYSQL test 2>&1
+
+DROP TABLE IF EXISTS t1, t2;
+FLUSH BINARY LOGS;
+
+--let MYSQLD_DATADIR=`select @@datadir`
+--let OUT_FILE=$MYSQLTEST_VARDIR/tmp/binlog.out
+--let ERR_FILE=$MYSQLTEST_VARDIR/tmp/binlog.err
+
+--echo # Default: no error about out of order GTIDs
+--echo # MYSQL_BINLOG MYSQLD_DATADIR/master-bin.000001 MYSQLD_DATADIR/master-bin.000002 > OUT_FILE 2> ERR_FILE
+--exec $MYSQL_BINLOG $MYSQLD_DATADIR/master-bin.000001 $MYSQLD_DATADIR/master-bin.000002 > $OUT_FILE 2> $ERR_FILE
+--let SEARCH_FILE=$ERR_FILE
+--let SEARCH_PATTERN=Found out of order GTID
+--source include/search_pattern_in_file.inc
+
+--echo # Explicit --gtid-strict-mode: error about out of order GTIDs
+--echo # MYSQL_BINLOG --gtid-strict-mode MYSQLD_DATADIR/master-bin.000001 MYSQLD_DATADIR/master-bin.000002 > OUT_FILE 2> ERR_FILE
+--error 1
+--exec $MYSQL_BINLOG --gtid-strict-mode $MYSQLD_DATADIR/master-bin.000001 $MYSQLD_DATADIR/master-bin.000002 > $OUT_FILE 2> $ERR_FILE
+--let SEARCH_PATTERN=ERROR: Found out of order GTID
+--source include/search_pattern_in_file.inc
+
+--remove_file $OUT_FILE
+--remove_file $ERR_FILE
+RESET MASTER;
+
+--echo End of the tests
