diff --git a/mysql-test/suite/roles/acl_cache_role_user-40541.result b/mysql-test/suite/roles/acl_cache_role_user-40541.result
new file mode 100644
index 00000000..675ddfce
--- /dev/null
+++ b/mysql-test/suite/roles/acl_cache_role_user-40541.result
@@ -0,0 +1,38 @@
+#
+# MDEV-40541 role vs user@localhost acl_cache key confusion
+#
+# A role lookup in the acl_cache is done with an empty host and an
+# empty ip. A user connected over a unix socket also has an empty ip,
+# so the privileges cached for user r1@localhost must not be
+# returned for the role r1.
+#
+create database db;
+create table db.t1(a varchar(40));
+insert into db.t1 values ('role-cache-collision-row');
+create role r1;
+create user r1@localhost identified by 'r1pass';
+create user u1@'127.0.0.1' identified by 'u1pass';
+grant select on db.* to r1@localhost;
+grant r1 to u1@'127.0.0.1';
+connect  r1,localhost,r1,r1pass;
+select a from db.t1;
+a
+role-cache-collision-row
+connect  u1,127.0.0.1,u1,u1pass;
+set role r1;
+show grants;
+Grants for u1@127.0.0.1
+GRANT `r1` TO `u1`@`127.0.0.1`
+GRANT USAGE ON *.* TO `u1`@`127.0.0.1`
+GRANT USAGE ON *.* TO `r1`
+select a from db.t1;
+ERROR 42000: SELECT command denied to user 'u1'@'localhost' for table `db`.`t1`
+use db;
+ERROR 42000: Access denied for user 'u1'@'localhost' to database 'db'
+connection default;
+disconnect r1;
+disconnect u1;
+drop user u1@'127.0.0.1';
+drop user r1@localhost;
+drop role r1;
+drop database db;
diff --git a/mysql-test/suite/roles/acl_cache_role_user-40541.test b/mysql-test/suite/roles/acl_cache_role_user-40541.test
new file mode 100644
index 00000000..f16964ab
--- /dev/null
+++ b/mysql-test/suite/roles/acl_cache_role_user-40541.test
@@ -0,0 +1,38 @@
+--source include/not_embedded.inc
+--echo #
+--echo # MDEV-40541 role vs user@localhost acl_cache key confusion
+--echo #
+--echo # A role lookup in the acl_cache is done with an empty host and an
+--echo # empty ip. A user connected over a unix socket also has an empty ip,
+--echo # so the privileges cached for user r1@localhost must not be
+--echo # returned for the role r1.
+--echo #
+create database db;
+create table db.t1(a varchar(40));
+insert into db.t1 values ('role-cache-collision-row');
+
+create role r1;
+create user r1@localhost identified by 'r1pass';
+create user u1@'127.0.0.1' identified by 'u1pass';
+
+grant select on db.* to r1@localhost;
+grant r1 to u1@'127.0.0.1';
+
+--connect (r1,localhost,r1,r1pass)
+select a from db.t1;
+
+--connect (u1,127.0.0.1,u1,u1pass)
+set role r1;
+show grants;
+--error ER_TABLEACCESS_DENIED_ERROR
+select a from db.t1;
+--error ER_DBACCESS_DENIED_ERROR
+use db;
+
+--connection default
+--disconnect r1
+--disconnect u1
+drop user u1@'127.0.0.1';
+drop user r1@localhost;
+drop role r1;
+drop database db;
