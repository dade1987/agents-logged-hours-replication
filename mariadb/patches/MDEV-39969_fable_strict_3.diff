diff --git a/sql/json_table.cc b/sql/json_table.cc
index e5ac6008..94782757 100644
--- a/sql/json_table.cc
+++ b/sql/json_table.cc
@@ -384,6 +384,25 @@ static void store_json_in_field(Field *f, const json_engine_t *je)
     }
     break;
   }
+  case JSON_VALUE_NUMBER:
+  {
+    /*
+      Field_bit::store(const char*, ...) interprets the string as a
+      binary bit string (like INSERT of a string literal into a BIT
+      column), so a JSON number like 0 (the character '0') would be
+      stored as 0x30 and get truncated to the maximum value.
+      Convert JSON numbers to a numeric value before storing them.
+    */
+    if (f->type() == MYSQL_TYPE_BIT)
+    {
+      my_decimal dec;
+      str2my_decimal(E_DEC_FATAL_ERROR & ~E_DEC_OVERFLOW,
+                     (const char *) je->value, je->value_len, je->s.cs, &dec);
+      f->store_decimal(&dec);
+      return;
+    }
+    break;
+  }
   default:
     break;
   };
