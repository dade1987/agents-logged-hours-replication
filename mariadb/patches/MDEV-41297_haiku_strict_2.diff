diff --git a/mysql-test/suite/heap/blob_pad_empty.test b/mysql-test/suite/heap/blob_pad_empty.test
new file mode 100644
index 00000000..c81a0911
--- /dev/null
+++ b/mysql-test/suite/heap/blob_pad_empty.test
@@ -0,0 +1,26 @@
+#
+# MDEV-41297: an empty and an all-space TEXT value are equal under the
+# PAD SPACE collation.  HEAP must not treat a zero-length stored blob
+# (NULL chain pointer) as a comparison failure.
+#
+
+--disable_warnings
+drop table if exists t1;
+--enable_warnings
+
+create table t1 (a text) engine=memory;
+insert into t1 values (''),('   ');
+select count(*) from (select distinct a from t1) as d;
+select count(distinct a) from t1;
+select count(*) from (select a from t1 group by a) as g;
+select count(*) from (select a from t1 where length(a)=0 union select a from t1 where length(a)=3) as u;
+drop table t1;
+
+--echo # Reverse insertion order
+create table t1 (a text) engine=memory;
+insert into t1 values ('   '),('');
+select count(*) from (select distinct a from t1) as d;
+select count(distinct a) from t1;
+select count(*) from (select a from t1 group by a) as g;
+select count(*) from (select a from t1 where length(a)=0 union select a from t1 where length(a)=3) as u;
+drop table t1;
diff --git a/storage/heap/hp_blob.c b/storage/heap/hp_blob.c
index 3763b949..1a1fa5d2 100644
--- a/storage/heap/hp_blob.c
+++ b/storage/heap/hp_blob.c
@@ -919,7 +919,9 @@ int hp_read_blobs(HP_INFO *info, uchar *record, const uchar *pos)
   @param data_len  Total blob data length (from record's packlength bytes)
 
   @return Pointer into info->blob_buff with contiguous blob data,
-          or NULL on allocation failure.
+          a non-NULL pointer for a zero-length value (its chain pointer is
+          NULL, but an empty value is not a failure), or NULL on allocation
+          failure.
 */
 
 const uchar *hp_materialize_one_blob(HP_INFO *info,
@@ -930,8 +932,16 @@ const uchar *hp_materialize_one_blob(HP_INFO *info,
   uint visible= share->visible;
   uint recbuffer= share->block.recbuffer;
 
-  if (data_len == 0 || !chain)
-    return chain;
+  /*
+    A zero-length value has no run chain (hp_write_blobs() stores NULL).
+    Callers treat a NULL return as failure, so return a valid empty buffer
+    instead; they compare by length and never read from it.
+  */
+  if (data_len == 0)
+    return (const uchar*) "";
+
+  if (!chain)
+    return NULL;
 
   if (hp_is_single_rec(chain, visible))
     return chain;                         /* Case A: no header, data at offset 0 */
