 (SELECT COLUMN_NAME ORDER BY 1);
 TABLE_SCHEMA	x	ORDINAL_POSITION
+#
+# MDEV-39911 MariaDB crash triggered by ST_CONVEXHULL and ST_SIMPLIFY
+#            string concatenation
+#
+# The simplify methods of the multi-element geometries reserved room
+# only for the SRID and the WKB header before writing the element count
+# with q_append().  When the result buffer was a small stack buffer,
+# such as the separator buffer of CONCAT_WS, the write overflowed it.
+#
+SELECT LENGTH(CONCAT_WS(ST_SIMPLIFY(ST_GEOMFROMTEXT('MULTILINESTRING((0 0,5 5,0 10),(0 0,-5 5,0 10))'), 5), 7, 5)) AS len;
+len
+97
+SELECT ST_ASTEXT(ST_SIMPLIFY(ST_GEOMFROMTEXT('MULTILINESTRING((0 0,5 5,0 10),(0 0,-5 5,0 10))'), 5)) AS g;
+g
+MULTILINESTRING((0 0,0 10),(0 0,0 10))
+SELECT LENGTH(CONCAT_WS(ST_SIMPLIFY(ST_GEOMFROMTEXT('POLYGON((0 0,10 0,10 10,0 10,0 0))'), 1), 7, 5)) AS len;
+len
+99
+SELECT LENGTH(CONCAT_WS(ST_SIMPLIFY(ST_GEOMFROMTEXT('MULTIPOLYGON(((0 0,10 0,10 10,0 10,0 0)))'), 1), 7, 5)) AS len;
+len
+108
+SELECT LENGTH(CONCAT_WS(ST_SIMPLIFY(ST_GEOMFROMTEXT('GEOMETRYCOLLECTION(POINT(1 1))'), 1), 7, 5)) AS len;
+len
+36
+SELECT LENGTH(CONCAT_WS(ST_SIMPLIFY(ST_GEOMFROMTEXT('LINESTRING(0 0,5 5,0 10)'), 5), 7, 5)) AS len;
+len
+47
