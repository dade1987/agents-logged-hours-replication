+++ b/sql/ha_partition.cc
@@ -11137,8 +11137,18 @@ void ha_partition::release_auto_increment()
         If the current auto_increment values is lower than the reserved
         value, and the reserved value was reserved by this thread,
         we can lower the reserved value.
+
+        We must only give back values which belong to the last interval
+        reserved by this thread, i.e. next_insert_id must not be below the
+        start of that interval. next_insert_id can be below it if
+        restore_auto_increment() was called after a failed insert of the
+        first row of a newly reserved interval: it then points into (or at
+        the end of) an earlier interval of this statement, and the values
+        between the two intervals may have been handed out to (and used by)
+        other threads in the meantime (MDEV-40995).
       */
       if (next_insert_id < next_auto_inc_val &&
+          next_insert_id >= auto_inc_interval_for_cur_row.minimum() &&
           auto_inc_interval_for_cur_row.maximum() >= next_auto_inc_val)
       {
         THD *thd= ha_thd();
