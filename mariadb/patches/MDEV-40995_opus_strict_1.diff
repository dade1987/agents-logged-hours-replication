--- /dev/null
+++ b/mysql-test/suite/parts/r/mdev_40995.result
@@ -0,0 +1,57 @@
+#
+# MDEV-40995 concurrent INSERT ... SELECT on a partitioned InnoDB table
+# can leave the AUTO_INCREMENT counter behind MAX(pk)
+#
+CREATE TABLE t1 (
+id BIGINT NOT NULL AUTO_INCREMENT,
+pk2 INT NOT NULL,
+c1 INT NOT NULL, c2 INT NOT NULL, c3 INT NOT NULL,
+c4 VARCHAR(32) NOT NULL,
+PRIMARY KEY (id, pk2),
+UNIQUE KEY uk1 (pk2, c1, c2, c3, c4)
+) ENGINE=InnoDB
+PARTITION BY LIST (pk2)
+(PARTITION p1 VALUES IN (1), PARTITION p2 VALUES IN (2));
+CREATE TABLE src (c1 INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;
+INSERT INTO src VALUES (1),(2),(3),(4),(5),(6),(7),(8);
+INSERT INTO t1 (pk2, c1, c2, c3, c4) VALUES (1, 4, 0, 0, 'x');
+CREATE FUNCTION f(x INT) RETURNS INT NO SQL
+BEGIN
+IF x = 4 THEN
+DO GET_LOCK('mdev40995', 300);
+DO RELEASE_LOCK('mdev40995');
+END IF;
+RETURN x;
+END|
+SELECT GET_LOCK('mdev40995', 0);
+GET_LOCK('mdev40995', 0)
+1
+connect con1,localhost,root,,;
+INSERT INTO t1 (pk2, c1, c2, c3, c4) SELECT 1, f(c1), 0, 0, 'x' FROM src;
+connection default;
+connect con2,localhost,root,,;
+INSERT INTO t1 (pk2, c1, c2, c3, c4) VALUES (2, 1, 0, 0, 'y');
+connection default;
+SELECT RELEASE_LOCK('mdev40995');
+RELEASE_LOCK('mdev40995')
+1
+connection con1;
+ERROR 23000: Duplicate entry '1-4-0-0-x' for key 'uk1'
+disconnect con1;
+connection con2;
+INSERT INTO t1 (pk2, c1, c2, c3, c4) VALUES (2, 2, 0, 0, 'y');
+disconnect con2;
+connection default;
+SELECT * FROM t1 ORDER BY id, pk2;
+id	pk2	c1	c2	c3	c4
+1	1	4	0	0	x
+5	2	1	0	0	y
+10	2	2	0	0	y
+SELECT AUTO_INCREMENT > (SELECT MAX(id) FROM t1) AS counter_ahead
+FROM information_schema.TABLES
+WHERE table_schema = 'test' AND table_name = 't1';
+counter_ahead
+1
+DROP FUNCTION f;
+DROP TABLE t1, src;
+# End of 10.11 tests
diff --git a/mysql-test/suite/parts/t/mdev_40995.test b/mysql-test/suite/parts/t/mdev_40995.test
new file mode 100644
index 00000000..dd92eda0
--- /dev/null
+++ b/mysql-test/suite/parts/t/mdev_40995.test
@@ -0,0 +1,76 @@
+--source include/have_partition.inc
+--source include/have_innodb.inc
+
+--echo #
+--echo # MDEV-40995 concurrent INSERT ... SELECT on a partitioned InnoDB table
+--echo # can leave the AUTO_INCREMENT counter behind MAX(pk)
+--echo #
+
+CREATE TABLE t1 (
+  id BIGINT NOT NULL AUTO_INCREMENT,
+  pk2 INT NOT NULL,
+  c1 INT NOT NULL, c2 INT NOT NULL, c3 INT NOT NULL,
+  c4 VARCHAR(32) NOT NULL,
+  PRIMARY KEY (id, pk2),
+  UNIQUE KEY uk1 (pk2, c1, c2, c3, c4)
+) ENGINE=InnoDB
+PARTITION BY LIST (pk2)
+ (PARTITION p1 VALUES IN (1), PARTITION p2 VALUES IN (2));
+
+CREATE TABLE src (c1 INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;
+INSERT INTO src VALUES (1),(2),(3),(4),(5),(6),(7),(8);
+
+# Pre-seeded row that makes the 4th row of the INSERT ... SELECT fail
+INSERT INTO t1 (pk2, c1, c2, c3, c4) VALUES (1, 4, 0, 0, 'x');
+
+DELIMITER |;
+CREATE FUNCTION f(x INT) RETURNS INT NO SQL
+BEGIN
+  IF x = 4 THEN
+    DO GET_LOCK('mdev40995', 300);
+    DO RELEASE_LOCK('mdev40995');
+  END IF;
+  RETURN x;
+END|
+DELIMITER ;|
+
+SELECT GET_LOCK('mdev40995', 0);
+
+--connect con1,localhost,root,,
+# Reserves [2,3) for row 1, [3,5) for rows 2-3, then waits before row 4
+--send INSERT INTO t1 (pk2, c1, c2, c3, c4) SELECT 1, f(c1), 0, 0, 'x' FROM src
+
+--connection default
+let $wait_condition=
+  SELECT COUNT(*) = 1 FROM information_schema.processlist
+  WHERE state = 'User lock' AND info LIKE 'INSERT INTO t1%';
+--source include/wait_condition.inc
+
+--connect con2,localhost,root,,
+# Takes the value right after con1's second interval
+INSERT INTO t1 (pk2, c1, c2, c3, c4) VALUES (2, 1, 0, 0, 'y');
+
+--connection default
+SELECT RELEASE_LOCK('mdev40995');
+
+--connection con1
+# Row 4 reserves a new interval and fails; the unused values must not be
+# given back below the start of that interval
+--error ER_DUP_ENTRY
+--reap
+--disconnect con1
+
+--connection con2
+INSERT INTO t1 (pk2, c1, c2, c3, c4) VALUES (2, 2, 0, 0, 'y');
+--disconnect con2
+
+--connection default
+SELECT * FROM t1 ORDER BY id, pk2;
+SELECT AUTO_INCREMENT > (SELECT MAX(id) FROM t1) AS counter_ahead
+FROM information_schema.TABLES
+WHERE table_schema = 'test' AND table_name = 't1';
+
+DROP FUNCTION f;
+DROP TABLE t1, src;
+
+--echo # End of 10.11 tests
