diff --git a/storage/archive/ha_archive.cc b/storage/archive/ha_archive.cc
index 2d623507..cdaeca65 100644
--- a/storage/archive/ha_archive.cc
+++ b/storage/archive/ha_archive.cc
@@ -1306,6 +1306,48 @@ int ha_archive::unpack_row(azio_stream *file_to_read, uchar *record)
   }
   if (ptr != end)
     DBUG_RETURN(HA_ERR_WRONG_IN_RECORD);
+
+  /*
+    Field_blob::unpack() leaves blob data pointers pointing into
+    record_buffer. record_buffer is reused by pack_row() (e.g. when
+    optimize()/repair() re-writes the row it has just read) and may also be
+    reallocated by fix_rec_buff(), which would leave the blobs pointing at
+    overwritten or freed memory. Copy the blob data into our own blob buffer
+    so that the unpacked row does not depend on record_buffer anymore.
+  */
+  if (table->s->blob_fields)
+  {
+    uint *blob, *blob_end;
+    size_t total_blob_length= 0;
+    char *last;
+
+    for (blob= table->s->blob_field, blob_end= blob + table->s->blob_fields;
+         blob != blob_end; blob++)
+    {
+      Field_blob *field= (Field_blob*) table->field[*blob];
+      if (!field->is_null_in_record(record))
+        total_blob_length+= field->get_length();
+    }
+
+    if (buffer.alloc(total_blob_length))
+      DBUG_RETURN(HA_ERR_OUT_OF_MEM);
+    last= (char*) buffer.ptr();
+
+    for (blob= table->s->blob_field, blob_end= blob + table->s->blob_fields;
+         blob != blob_end; blob++)
+    {
+      Field_blob *field= (Field_blob*) table->field[*blob];
+      if (field->is_null_in_record(record))
+        continue;
+      uint32 length= field->get_length();
+      if (length)
+      {
+        memcpy(last, field->get_ptr(), length);
+        field->set_ptr(length, (uchar*) last);
+        last+= length;
+      }
+    }
+  }
   DBUG_RETURN(0);
 }
 
