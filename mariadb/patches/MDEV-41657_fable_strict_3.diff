@@ -372,3 +372,31 @@ DROP TABLE t1;
 
 DROP PROCEDURE p1;
 DROP PROCEDURE p2;
+
+--echo #
+--echo # MDEV-41657 TO_DATE no longer works as a variable
+--echo #
+
+CREATE TABLE to_date (to_date INT);
+INSERT INTO to_date VALUES (1);
+SELECT to_date FROM to_date;
+SELECT to_date.to_date FROM to_date;
+DROP TABLE to_date;
+
+DELIMITER $$;
+BEGIN NOT ATOMIC
+  DECLARE to_date INT DEFAULT 2;
+  SET to_date= to_date + 1;
+  SELECT to_date;
+END
+$$
+DELIMITER ;$$
+
+SET @to_date= 3;
+SELECT @to_date;
+
+SET SQL_MODE=ORACLE;
+SELECT TO_DATE('2001-02-03','YYYY-MM-DD') AS c1;
+SET SQL_MODE=DEFAULT;
+
+--echo # End of 12.3 tests
