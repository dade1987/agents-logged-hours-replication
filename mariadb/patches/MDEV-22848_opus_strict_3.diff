diff --git a/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test b/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test
new file mode 100644
index 00000000..ad95588e
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test
@@ -0,0 +1,28 @@
+#
+# MDEV-22848 Assertion `trx_is_registered_for_2pc(trx)' failed in
+# innobase_xa_prepare on DROP and in innobase_savepoint on SAVEPOINT
+#
+# Setting @@global.gtid_slave_pos with autocommit=0 must not leave a stale
+# InnoDB registration in the session's normal transaction.
+#
+
+--source include/have_innodb.inc
+--source include/have_log_bin.inc
+--source include/have_binlog_format_mixed.inc
+
+SET @save_slave_pos= @@GLOBAL.gtid_slave_pos;
+
+SET autocommit=0;
+CREATE TABLE t1 (c INT) ENGINE=MyISAM;
+SET GLOBAL gtid_slave_pos="0-1-100";
+INSERT INTO t1 VALUES (0);
+--error ER_BAD_TABLE_ERROR
+DROP TABLE not_there;
+
+SET GLOBAL gtid_slave_pos="0-1-101";
+SAVEPOINT sp;
+COMMIT;
+
+SET autocommit=1;
+DROP TABLE t1;
+SET GLOBAL gtid_slave_pos= @save_slave_pos;
diff --git a/sql/rpl_gtid.cc b/sql/rpl_gtid.cc
index 9004aea2..acc07972 100644
--- a/sql/rpl_gtid.cc
+++ b/sql/rpl_gtid.cc
@@ -699,6 +699,28 @@ rpl_slave_state::record_gtid(THD *thd, const rpl_gtid *gtid, uint64 sub_id,
   */
   suspended_wfc= thd->suspend_subsequent_commits();
   thd->lex->reset_n_backup_query_tables_list(&lex_backup);
+
+  /*
+    The option bits must be adjusted before the table is opened and locked.
+    Otherwise, if the current session runs with autocommit=0 (or inside
+    BEGIN), the storage engine would register itself in the normal
+    ("all") transaction from external_lock(), while the statement commit
+    below (done with OPTION_NOT_AUTOCOMMIT|OPTION_BEGIN cleared) makes the
+    engine commit and deregister its transaction. That would leave a stale
+    engine entry in thd->transaction->all, which later trips assertions
+    like trx_is_registered_for_2pc() in InnoDB on the next commit or
+    SAVEPOINT (MDEV-22848).
+  */
+  if (!in_transaction)
+  {
+    DBUG_PRINT("info", ("resetting OPTION_BEGIN"));
+    thd->variables.option_bits&=
+      ~(ulonglong)(OPTION_NOT_AUTOCOMMIT |OPTION_BEGIN |OPTION_BIN_LOG |
+                   OPTION_GTID_BEGIN);
+  }
+  else
+    thd->variables.option_bits&= ~(ulonglong)OPTION_BIN_LOG;
+
   tlist.init_one_table(&MYSQL_SCHEMA_NAME, &gtid_pos_table_name, NULL, TL_WRITE);
   if ((err= open_and_lock_tables(thd, &tlist, FALSE, 0)))
     goto end;
@@ -714,16 +736,6 @@ rpl_slave_state::record_gtid(THD *thd, const rpl_gtid *gtid, uint64 sub_id,
   thd->wsrep_ignore_table= true; // Do not replicate mysql.gtid_slave_pos table
 #endif
 
