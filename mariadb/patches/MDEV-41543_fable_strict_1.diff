diff --git a/mysql-test/suite/versioning/t/partition.test b/mysql-test/suite/versioning/t/partition.test
index 0cb6cc14..2592da49 100644
--- a/mysql-test/suite/versioning/t/partition.test
+++ b/mysql-test/suite/versioning/t/partition.test
@@ -2868,7 +2868,59 @@ repair table t;
 drop table t;
 set timestamp=default;
 
---echo # End of 10.11 tests
+--echo #
+--echo # MDEV-41543 Changing INTERVAL of SYSTEM_TIME partitioning does not move history to the new partitions
+--echo #
+
+set @@session.time_zone='+00:00';
+create table t1 (x int,
+  row_start timestamp(6) as row start invisible,
+  row_end timestamp(6) as row end invisible,
+  period for system_time (row_start, row_end)) with system versioning
+partition by system_time interval 1 hour
+starts '2000-01-01 00:00:00' partitions 4;
+set timestamp= unix_timestamp('2000-01-01 00:30:00');
+insert t1 values (0);
+set timestamp= unix_timestamp('2000-01-01 01:30:00');
+update t1 set x= 1;
+set timestamp= unix_timestamp('2000-01-01 02:30:00');
+update t1 set x= 2;
+select x, row_end from t1 partition (p0);
+select x, row_end from t1 partition (p1);
+select x, row_end from t1 partition (p2);
+select x from t1 partition (pn);
+# Changed INTERVAL must rebuild the table and redistribute the history
+alter table t1 partition by system_time interval 2 hour
+starts '2000-01-01 00:00:00';
+--replace_result $default_engine DEFAULT_ENGINE
+show create table t1;
+select x, row_end from t1 partition (p0);
+select x, row_end from t1 partition (p1);
+select x, row_end from t1 partition (p2);
+select x from t1 partition (pn);
+# Changed STARTS must rebuild the table as well
+alter table t1 partition by system_time interval 2 hour
+starts '2000-01-01 01:00:00';
+--replace_result $default_engine DEFAULT_ENGINE
+show create table t1;
+select x, row_end from t1 partition (p0);
+select x, row_end from t1 partition (p1);
+select x, row_end from t1 partition (p2);
+select x from t1 partition (pn);
+# Unchanged INTERVAL and STARTS: fast alter, history stays in place
+alter table t1 partition by system_time interval 2 hour
+starts '2000-01-01 01:00:00';
+--replace_result $default_engine DEFAULT_ENGINE
+show create table t1;
+select x, row_end from t1 partition (p0);
+select x, row_end from t1 partition (p1);
+select x, row_end from t1 partition (p2);
+select x from t1 partition (pn);
+drop table t1;
+set timestamp= default;
+set @@session.time_zone= default;
+
+# End of 10.11 tests
 
 set global innodb_stats_persistent= @save_persistent;
 --source suite/versioning/common_finish.inc
