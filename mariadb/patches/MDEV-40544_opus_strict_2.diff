diff --git a/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read_checksum.test b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read_checksum.test
new file mode 100644
index 00000000..762c330e
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read_checksum.test
@@ -0,0 +1,16 @@
+#
+# MDEV-40544 Assertion fail / Memory leak in `mariadb-binlog --force-read`
+#
+# With --force-read, an event failing the checksum test must be output as an
+# Unknown event without also returning an error.
+#
+--source include/have_debug.inc
+--source include/have_binlog_format_mixed.inc
+RESET MASTER;
+FLUSH BINARY LOGS;
+
+--let $MYSQLD_DATADIR= `SELECT @@datadir`
+--echo # MYSQL_BINLOG --verify-binlog-checksum --force-read --debug=d,simulate_checksum_test_failure MYSQLD_DATADIR/master-bin.000001
+--exec $MYSQL_BINLOG --verify-binlog-checksum --force-read --debug=d,simulate_checksum_test_failure $MYSQLD_DATADIR/master-bin.000001 > /dev/null 2>&1
+
+--echo # End of test
