diff --git a/client/mysqltest.cc b/client/mysqltest.cc
index d43b1c79..6f3519db 100644
--- a/client/mysqltest.cc
+++ b/client/mysqltest.cc
@@ -676,6 +676,8 @@ void free_replace_regex();
 
 /* Used by sleep */
 void check_eol_junk_line(const char *eol);
+/* Used by sync_with_master */
+void check_eol_junk(const char *eol);
 
 void free_all_replace(){
   free_replace();
@@ -5335,14 +5337,32 @@ void do_sync_with_master2(struct st_command *command, long offset,
   return;
 }
 
+/*
+  sync_with_master [offset [, connection_name]]
+
+  Both the offset and the connection name may be given as $variables
+  (e.g. "--sync_with_master 0, $connection"), so the arguments are
+  evaluated (variables expanded) before they are parsed.
+*/
+
 void do_sync_with_master(struct st_command *command)
 {
   long offset= 0;
-  char *p= command->first_argument;
-  const char *offset_start= p;
+  DYNAMIC_STRING ds_args;
+  char *p;
+  const char *offset_start;
   char *start, *buff= 0;
   start= const_cast<char*>("");
 
+  /* Expand $variables in the arguments */
+  init_dynamic_string(&ds_args, "", 256, 256);
+  do_eval(&ds_args, command->first_argument, command->end, FALSE);
+  p= ds_args.str;
+
+  while (*p && my_isspace(charset_info, *p))
+    p++;
+  offset_start= p;
+
   if (*offset_start)
   {
     for (; my_isdigit(charset_info, *p); p++)
@@ -5362,11 +5382,14 @@ void do_sync_with_master(struct st_command *command)
                                     MYF(MY_WME|MY_FAE));
       get_string(&buff, &p, command);
     }
-    command->last_argument= p;
+    /* Everything left must be whitespace or a trailing comment */
+    check_eol_junk(p);
   }
+  command->last_argument= command->end;
   do_sync_with_master2(command, offset, start);
   if (buff)
     my_free(start);
+  dynstr_free(&ds_args);
   return;
 }
 
