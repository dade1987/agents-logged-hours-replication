@@ -55,6 +55,12 @@ int heap_rkey(HP_INFO *info, uchar *record, int inx, const uchar *key,
       info->update= HA_STATE_NO_KEY;
       DBUG_RETURN(my_errno= HA_ERR_KEY_NOT_FOUND);
     }
+    /*
+      Remember the found key (with its record pointer) so that
+      heap_rnext()/heap_rprev() can restart the search from it if the
+      current element gets removed from the tree.
+    */
+    hp_rb_save_lastkey(info, keyinfo, pos);
     memcpy(&pos, pos + keyinfo->get_key_length(keyinfo, pos), sizeof(uchar*));
     info->current_ptr= pos;
   }
