diff --git a/storage/heap/heapdef.h b/storage/heap/heapdef.h
index 1880a983..fc6e9532 100644
--- a/storage/heap/heapdef.h
+++ b/storage/heap/heapdef.h
@@ -104,6 +104,20 @@ extern ha_rows hp_rows_in_memory(size_t reclength, size_t index_size,
                           size_t memory_limit);
 extern size_t hp_memory_needed_per_row(size_t reclength);
 
+/*
+  Save the key of the rb-tree element that was just read, together with
+  its record pointer, into info->lastkey. If the current element is later
+  removed from the tree (e.g. by heap_delete()) and info->last_pos is thus
+  invalidated, heap_rnext()/heap_rprev() use this key to restart the search
+  from the last found key instead of from the original search key.
+*/
+static inline void hp_rb_save_lastkey(HP_INFO *info, HP_KEYDEF *keyinfo,
+                                      const uchar *key)
+{
+  info->lastkey_len= keyinfo->get_key_length(keyinfo, key) + sizeof(uchar*);
+  memcpy(info->lastkey, key, info->lastkey_len);
+}
+
 extern mysql_mutex_t THR_LOCK_heap;
 
 extern PSI_memory_key hp_key_memory_HP_SHARE;
diff --git a/storage/heap/hp_rfirst.c b/storage/heap/hp_rfirst.c
index 1b1610ac..0f20c6b6 100644
--- a/storage/heap/hp_rfirst.c
+++ b/storage/heap/hp_rfirst.c
@@ -34,20 +34,15 @@ int heap_rfirst(HP_INFO *info, uchar *record, int inx)
     if ((pos = tree_search_edge(&keyinfo->rb_tree, info->parents,
                                 &info->last_pos, offsetof(TREE_ELEMENT, left))))
     {
+      /*
+        Remember the found key (with its record pointer) so that subsequent
+        heap_rnext()/heap_rprev() calls can restart the search from it if
+        the current element gets removed from the tree (DELETE queries).
+      */
+      hp_rb_save_lastkey(info, keyinfo, pos);
       memcpy(&pos, pos + keyinfo->get_key_length(keyinfo, pos), sizeof(uchar*));
       info->current_ptr = pos;
       memcpy(record, pos, (size_t)share->reclength);
-      /*
-        If we're performing index_first on a table that was taken from
-        table cache, info->lastkey_len is initialized to previous query.
-        Thus we set info->lastkey_len to proper value for subsequent
-        heap_rnext() calls.
-        This is needed for DELETE queries only, otherwise this variable is
-        not used.
-        Note that the same workaround may be needed for heap_rlast(), but
-        for now heap_rlast() is never used for DELETE queries.
-      */
-      info->lastkey_len= 0;
       info->update = HA_STATE_AKTIV;
     }
     else
