diff --git a/storage/heap/hp_rnext.c b/storage/heap/hp_rnext.c
index a07d8fae..c683685e 100644
--- a/storage/heap/hp_rnext.c
+++ b/storage/heap/hp_rnext.c
@@ -60,15 +60,10 @@ int heap_rnext(HP_INFO *info, uchar *record)
     else if (!info->lastkey_len)
     {
       /*
-        We enter this branch only for DELETE queries after heap_rfirst(). E.g.
-        DELETE FROM t1 WHERE a<10. As last key position is not available
-        (last key is removed by heap_delete()), we must restart search as it
-        is done in heap_rfirst().
-
-        It should be safe to handle this situation without this branch. That is
-        branch below should find smallest element in a tree as lastkey_len is
-        zero. tree_search_edge() is a kind of optimisation here as it should be
-        faster than tree_search_key().
+        No last found key is saved (should not normally happen, as every
+        successful read of a BTREE key saves the found key in info->lastkey).
+        As last key position is not available either, restart the search
+        from the smallest element in the tree, as it is done in heap_rfirst().
       */
       pos= tree_search_edge(&keyinfo->rb_tree, info->parents,
                             &info->last_pos, offsetof(TREE_ELEMENT, left));
@@ -77,21 +72,25 @@ int heap_rnext(HP_INFO *info, uchar *record)
     else
     {
       /*
-        We enter this branch only for DELETE queries after heap_rkey(). E.g.
-        DELETE FROM t1 WHERE a=10. As last key position is not available
-        (last key is removed by heap_delete()), we must restart search as it
-        is done in heap_rkey().
+        We enter this branch only for DELETE (or UPDATE) queries after
+        heap_rkey()/heap_rnext(). E.g. DELETE FROM t1 WHERE a=10. As last
+        key position is not available (last key is removed by heap_delete()),
+        we must restart the search. info->lastkey holds the full key (with
+        the record pointer) of the last found element, so we search for the
+        first element after it. This way we continue the scan exactly where
+        we left it, without re-reading the keys that were not deleted.
       */
       custom_arg.keyseg = keyinfo->seg;
       custom_arg.key_length = info->lastkey_len;
-      custom_arg.search_flag = SEARCH_SAME | SEARCH_FIND;
-      info->last_find_flag= HA_READ_KEY_OR_NEXT;
+      custom_arg.search_flag = SEARCH_SAME;
+      info->last_find_flag= HA_READ_AFTER_KEY;
       pos= tree_search_key(&keyinfo->rb_tree, info->lastkey, info->parents,
                            &info->last_pos, info->last_find_flag, &custom_arg);
       info->key_version= info->s->key_version;
     }
     if (pos)
     {
+      hp_rb_save_lastkey(info, keyinfo, pos);
       memcpy(&pos, pos + keyinfo->get_key_length(keyinfo, pos), sizeof(uchar*));
       info->current_ptr = pos;
     }
