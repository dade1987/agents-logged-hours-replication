diff --git a/mysql-test/suite/rpl/r/rpl_row_trigger_error.result b/mysql-test/suite/rpl/r/rpl_row_trigger_error.result
new file mode 100644
index 00000000..24f3124c
--- /dev/null
+++ b/mysql-test/suite/rpl/r/rpl_row_trigger_error.result
@@ -0,0 +1,42 @@
+include/master-slave.inc
+[connection master]
+connection slave;
+call mtr.add_suppression("Can.t update table 'aud' in stored function/trigger");
+call mtr.add_suppression("Slave: At line 1 in test.ai Error_code: 4094");
+call mtr.add_suppression("Could not execute Write_rows");
+call mtr.add_suppression("Error running query, slave SQL thread aborted");
+include/stop_slave.inc
+SET @sav= @@global.slave_run_triggers_for_rbr;
+SET @@global.slave_run_triggers_for_rbr= ENFORCE;
+include/start_slave.inc
+connection master;
+CREATE TABLE t1 (a INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;
+CREATE TABLE aud (a INT) ENGINE=InnoDB;
+CREATE TRIGGER ai AFTER INSERT ON t1 FOR EACH ROW INSERT INTO aud VALUES (NEW.a);
+connection slave;
+connection master;
+INSERT INTO t1 VALUES (1);
+# the slave must stop with an error at trying to "re-"execute the trigger.
+connection slave;
+include/wait_for_slave_sql_error.inc [errno=1442]
+SET @@global.slave_run_triggers_for_rbr= NO;
+include/start_slave.inc
+connection master;
+connection slave;
+SELECT a FROM t1 ORDER BY a;
+a
+1
+# ENFORCE re-runs the master's trigger on the slave, but the audit row
+# was not going to be written twice.
+SELECT COUNT(*) AS aud_rows_on_slave FROM aud;
+aud_rows_on_slave
+1
+connection slave;
+include/stop_slave.inc
+SET @@global.slave_run_triggers_for_rbr= @sav;
+include/start_slave.inc
+connection master;
+DROP TRIGGER ai;
+DROP TABLE t1, aud;
+connection slave;
+include/rpl_end.inc
diff --git a/mysql-test/suite/rpl/t/rpl_row_trigger_error.test b/mysql-test/suite/rpl/t/rpl_row_trigger_error.test
new file mode 100644
index 00000000..ef262bb0
--- /dev/null
+++ b/mysql-test/suite/rpl/t/rpl_row_trigger_error.test
@@ -0,0 +1,57 @@
+# MDEV-40824 slave_run_triggers_for_rbr enabled slave ignores after-insert
+#            trigger's error
+#
+# The slave applier must stop with an error when an AFTER INSERT trigger
+# run on the slave (slave_run_triggers_for_rbr=ENFORCE) fails.
+
+--source include/have_binlog_format_row.inc
+--source include/have_innodb.inc
+--source include/master-slave.inc
+
+--connection slave
+call mtr.add_suppression("Can.t update table 'aud' in stored function/trigger");
+call mtr.add_suppression("Slave: At line 1 in test.ai Error_code: 4094");
+call mtr.add_suppression("Could not execute Write_rows");
+call mtr.add_suppression("Error running query, slave SQL thread aborted");
+--source include/stop_slave.inc
+SET @sav= @@global.slave_run_triggers_for_rbr;
+SET @@global.slave_run_triggers_for_rbr= ENFORCE;
+--source include/start_slave.inc
+
+--connection master
+CREATE TABLE t1 (a INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;
+CREATE TABLE aud (a INT) ENGINE=InnoDB;
+CREATE TRIGGER ai AFTER INSERT ON t1 FOR EACH ROW INSERT INTO aud VALUES (NEW.a);
+--sync_slave_with_master
+
+--connection master
+INSERT INTO t1 VALUES (1);
+
+--echo # the slave must stop with an error at trying to "re-"execute the trigger.
+--connection slave
+let $slave_sql_errno= 1442;
+--source include/wait_for_slave_sql_error.inc
+
+# Recover the slave
+SET @@global.slave_run_triggers_for_rbr= NO;
+--source include/start_slave.inc
+
+# now must catch up.
+--connection master
+--sync_slave_with_master
+
+SELECT a FROM t1 ORDER BY a;
+--echo # ENFORCE re-runs the master's trigger on the slave, but the audit row
+--echo # was not going to be written twice.
+SELECT COUNT(*) AS aud_rows_on_slave FROM aud;
+
+# --- cleanup ---
+--connection slave
+--source include/stop_slave.inc
+SET @@global.slave_run_triggers_for_rbr= @sav;
+--source include/start_slave.inc
+--connection master
+DROP TRIGGER ai;
+DROP TABLE t1, aud;
+--sync_slave_with_master
+--source include/rpl_end.inc
diff --git a/sql/log_event_server.cc b/sql/log_event_server.cc
index 411b9c6d..ad335fab 100644
--- a/sql/log_event_server.cc
+++ b/sql/log_event_server.cc
@@ -7780,8 +7780,14 @@ Write_rows_log_event::write_row(rpl_group_info *rgi,
   else
   {
     error= m_write_record->write_record();
-
-    DBUG_RETURN(error ? m_write_record->last_errno() : 0);
+    /*
+      An error raised by a trigger (e.g AFTER INSERT) does not set
+      last_errno, which is only set upon a handler error. Make sure
+      a failed write_record() is never reported as success.
+    */
+    DBUG_RETURN(error ?
+                (m_write_record->last_errno() ?
+                 m_write_record->last_errno() : HA_ERR_GENERIC) : 0);
   }
 
