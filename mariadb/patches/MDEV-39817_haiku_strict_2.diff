diff --git a/sql/item_jsonfunc.cc b/sql/item_jsonfunc.cc
index cf5bb9be..646cf387 100644
--- a/sql/item_jsonfunc.cc
+++ b/sql/item_jsonfunc.cc
@@ -4101,6 +4101,27 @@ void Item_func_json_arrayagg::cut_max_length(String *result,
     return;
   }
 
+  /*
+    old_length is the length of the complete JSON array elements that were
+    already added. The row that exceeded max_length starts after the
+    separator (if any) that precedes it.
+  */
+  size_t row_start= old_length;
+  if (old_length)
+    row_start+= get_separator()->length();
+
+  /*
+    If there is no room for the opening quote of the new row (plus the
+    closing quote we are about to append), drop the whole new row and
+    the separator. Cutting at max_length-1 would otherwise produce an
+    invalid JSON array, e.g. ["ab","cd""] or ["ab",""].
+  */
+  if (max_length - 1 <= row_start)
+  {
+    Item_func_group_concat::cut_max_length(result, old_length, old_length);
+    return;
+  }
+
   Item_func_group_concat::cut_max_length(result, old_length, max_length-1);
   result->append('"');
 }
