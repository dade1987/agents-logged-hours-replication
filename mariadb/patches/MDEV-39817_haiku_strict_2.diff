 Warning	1260	Row 1 was cut by JSON_ARRAYAGG()
 drop table t1;
 SET group_concat_max_len= default;
+#
+# MDEV-39817: JSON_ARRAYAGG() returns garbage because of off-by-one
+# error in the truncation of the result
+#
+set session group_concat_max_len = 9;
+create temporary table t (c varchar(20) character set latin1);
+insert into t values ('ab'), ('cd'), ('ef');
+select json_arrayagg(c order by c) from t;
+json_arrayagg(c order by c)
+["ab","cd"]
+Warnings:
+Warning	1260	Row 3 was cut by JSON_ARRAYAGG()
+drop temporary table t;
+SET group_concat_max_len= default;
 create table t1 (col1 json);
 insert into t1 values('{"color":"red", "size":1}' );
 insert into t1 values('{"color":"blue", "size":2}' );
