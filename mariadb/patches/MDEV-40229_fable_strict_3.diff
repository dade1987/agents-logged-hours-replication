diff --git a/mysql-test/main/vector.result b/mysql-test/main/vector.result
index 536a52f1..b8462219 100644
--- a/mysql-test/main/vector.result
+++ b/mysql-test/main/vector.result
@@ -909,3 +909,20 @@ where table_schema = database() and table_name = 't1';
 has_index_length
 1
 drop table t1;
+#
+# MDEV-40229 - INDEX_LENGTH must include the whole vector index table,
+#              and ANALYZE TABLE must also analyze the vector index
+#
+create table t1 (id int auto_increment primary key, v vector(1) not null, vector index (v)) engine=myisam;
+insert into t1 (v) values (vec_fromtext('[1]')),(vec_fromtext('[2]')),(vec_fromtext('[3]'));
+flush tables;
+set @ilen_before=(select index_length from information_schema.tables where table_schema = database() and table_name = 't1');
+analyze table t1;
+Table	Op	Msg_type	Msg_text
+test.t1	analyze	status	Engine-independent statistics collected
+test.t1	analyze	status	OK
+set @ilen_after=(select index_length from information_schema.tables where table_schema = database() and table_name = 't1');
+select @ilen_before > 0 as has_index_length, @ilen_after >= @ilen_before as not_smaller_after_analyze;
+has_index_length	not_smaller_after_analyze
+1	1
+drop table t1;
