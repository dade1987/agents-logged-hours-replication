diff --git a/sql/handler.cc b/sql/handler.cc
index 56a784d3..c31eb937 100644
--- a/sql/handler.cc
+++ b/sql/handler.cc
@@ -5676,7 +5676,30 @@ handler::ha_analyze(THD* thd, HA_CHECK_OPT* check_opt)
               m_lock_type != F_UNLCK);
   mark_trx_read_write();
 
-  return analyze(thd, check_opt);
+  int error= analyze(thd, check_opt);
+  if (error && error != HA_ADMIN_ALREADY_DONE)
+    return error;
+
+  /*
+    Also analyze high-level (vector) index tables, so that their
+    statistics (and thus the index size as reported by
+    INFORMATION_SCHEMA.TABLES.INDEX_LENGTH) are refreshed together with
+    the statistics of the main table.
+  */
+  if (table->file == this)
+  {
+    for (uint i= table->s->keys; i < table->s->total_keys; i++)
+    {
+      DBUG_ASSERT(table->s->hlindexes() == 1);
+      if (table->hlindex_open(i) || table->hlindex_lock(i))
+        return HA_ADMIN_FAILED;
+      int err= table->hlindex->file->analyze(thd, check_opt);
+      if (err && err != HA_ADMIN_ALREADY_DONE &&
+          err != HA_ADMIN_NOT_IMPLEMENTED)
+        return err;
+    }
+  }
+  return error;
 }
 
 
diff --git a/sql/sql_show.cc b/sql/sql_show.cc
index ed108adf..7288fa91 100644
--- a/sql/sql_show.cc
+++ b/sql/sql_show.cc
@@ -6087,8 +6087,17 @@ static int get_schema_tables_record(THD *thd, TABLE_LIST *tables,
           if (show_table->hlindex || !show_table->hlindex_open(show_table->s->keys))
           {
               handler *hi= show_table->hlindex->file;
-              if (!hi->info(HA_STATUS_VARIABLE))
-                  file->stats.index_file_length+= hi->stats.data_file_length;
+              /*
+                The whole hlindex table is an index of the main table,
+                so both its data and its index parts count towards
+                INDEX_LENGTH. Use the same flags as for the main table,
+                so that the statistics are refreshed consistently
+                (e.g. with innodb_stats_on_metadata=ON).
+              */
+              if (!hi->info(HA_STATUS_VARIABLE | HA_STATUS_TIME |
+                            HA_STATUS_VARIABLE_EXTRA))
+                  file->stats.index_file_length+= hi->stats.data_file_length +
+                                                  hi->stats.index_file_length;
           }
       }
 
