diff --git a/sql/sql_view.cc b/sql/sql_view.cc
index ab2d4df9..f3b0c19d 100644
--- a/sql/sql_view.cc
+++ b/sql/sql_view.cc
@@ -1064,6 +1064,23 @@ static int mysql_register_view(THD *thd, DDL_LOG_STATE *ddl_log_state,
   view->view_suid= lex->create_view->suid;
   view->with_check= lex->create_view->check;
 
+  /*
+    The definer is written to the .frm file as plain text, one parameter
+    per line, and is not escaped. A newline in the user or host name would
+    be read back as separate parameters (MDEV-40484), so refuse it.
+  */
+  if ((lex->definer->user.length &&
+       memchr(lex->definer->user.str, '\n', lex->definer->user.length)) ||
+      (lex->definer->host.length &&
+       memchr(lex->definer->host.str, '\n', lex->definer->host.length)))
+  {
+    my_printf_error(ER_UNKNOWN_ERROR,
+                    "Definer user or host name must not contain a newline",
+                    MYF(0));
+    error= -1;
+    goto err;
+  }
+
   DBUG_EXECUTE_IF("simulate_register_view_failure",
                   {
                     my_error(ER_OUT_OF_RESOURCES, MYF(0));
