new file mode 100644
index 00000000..b10cd65f
--- /dev/null
+++ b/mysql-test/suite/csv/delete_chain.result
@@ -0,0 +1,14 @@
+#
+# MDEV-40636 CSV crashes on DELETE
+#
+create table t1 (id int not null, pad char(10) not null) engine=csv;
+insert t1 select seq,'AAAAAAAAAA' from seq_1_to_2048;
+select count(*) from t1;
+count(*)
+2048
+delete from t1 where id % 2 = 0;
+select count(*), min(id), max(id) from t1;
+count(*)	min(id)	max(id)
+1024	1	2047
+drop table t1;
+# End of 10.6 tests
