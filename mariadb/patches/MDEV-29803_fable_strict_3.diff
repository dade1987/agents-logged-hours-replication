index 00000000..894d8433
--- /dev/null
+++ b/mysql-test/suite/binlog/r/binlog_mysqlbinlog_gtid_strict_mode_default.result
@@ -0,0 +1,24 @@
+RESET MASTER;
+CREATE TABLE t1 (a int);
+CREATE TABLE t2 (a int);
+DROP TABLE t1, t2;
+FLUSH BINARY LOGS;
+# Replay the first binlog on the same server. The GTIDs are re-used,
+# so the second binlog has out of order GTIDs relative to the first.
+# MYSQL_BINLOG --read-from-remote-server master-bin.000001 | MYSQL
+DROP TABLE IF EXISTS t1, t2;
+FLUSH BINARY LOGS;
+# By default (no --gtid-strict-mode), processing both binlogs should
+# succeed without errors
+# MYSQL_BINLOG master-bin.000001 master-bin.000002 > /dev/null 2> err_out
+NOT FOUND /Found out of order GTID/ in mysqlbinlog_err.out
+# With -vvv (and no --gtid-strict-mode), a warning should be issued
+# MYSQL_BINLOG -vvv master-bin.000001 master-bin.000002 > /dev/null 2> err_out
+FOUND 1 /WARNING: Found out of order GTID/ in mysqlbinlog_err.out
+# With --gtid-strict-mode explicitly provided, mariadb-binlog should
+# error
+# MYSQL_BINLOG --gtid-strict-mode master-bin.000001 master-bin.000002 > /dev/null 2> err_out
+FOUND 1 /ERROR: Found out of order GTID/ in mysqlbinlog_err.out
+# Cleanup
+RESET MASTER;
+End of the tests
