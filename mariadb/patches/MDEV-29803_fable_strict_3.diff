diff --git a/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_strict_mode_default.test b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_strict_mode_default.test
new file mode 100644
index 00000000..9da9f1a3
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_strict_mode_default.test
@@ -0,0 +1,61 @@
+#
+# Purpose:
+#   Ensure that mariadb-binlog, by default, does not error when a binary log
+# contains out of order GTIDs. The server's gtid_strict_mode is off by
+# default, so binary logs can legitimately contain non-monotonic sequence
+# numbers (e.g. when the output of mariadb-binlog is replayed on the same
+# server, which re-uses the original GTIDs). Only when --gtid-strict-mode is
+# explicitly provided should mariadb-binlog error on out of order GTIDs.
+#
+# References:
+#   MDEV-29803: Unexpected ERROR: Found out of order GTID after replaying
+#               binlog read from remote
+#   MDEV-4989: Support for GTID in mysqlbinlog
+#
+--source include/have_log_bin.inc
+
+RESET MASTER;
+CREATE TABLE t1 (a int);
+CREATE TABLE t2 (a int);
+DROP TABLE t1, t2;
+FLUSH BINARY LOGS;
+
+--echo # Replay the first binlog on the same server. The GTIDs are re-used,
+--echo # so the second binlog has out of order GTIDs relative to the first.
+--echo # MYSQL_BINLOG --read-from-remote-server master-bin.000001 | MYSQL
+--exec $MYSQL_BINLOG --read-from-remote-server -uroot --protocol=tcp --port=$MASTER_MYPORT master-bin.000001 | $MYSQL test 2>&1
+
+DROP TABLE IF EXISTS t1, t2;
+FLUSH BINARY LOGS;
+
+--let $datadir= `select @@datadir`
+--let $err_out= $MYSQLTEST_VARDIR/tmp/mysqlbinlog_err.out
+
+--echo # By default (no --gtid-strict-mode), processing both binlogs should
+--echo # succeed without errors
+--echo # MYSQL_BINLOG master-bin.000001 master-bin.000002 > /dev/null 2> err_out
+--exec $MYSQL_BINLOG $datadir/master-bin.000001 $datadir/master-bin.000002 > /dev/null 2> $err_out
+--let SEARCH_FILE= $err_out
+--let SEARCH_PATTERN= Found out of order GTID
+--source include/search_pattern_in_file.inc
+--remove_file $err_out
+
+--echo # With -vvv (and no --gtid-strict-mode), a warning should be issued
+--echo # MYSQL_BINLOG -vvv master-bin.000001 master-bin.000002 > /dev/null 2> err_out
+--exec $MYSQL_BINLOG -vvv $datadir/master-bin.000001 $datadir/master-bin.000002 > /dev/null 2> $err_out
+--let SEARCH_PATTERN= WARNING: Found out of order GTID
+--source include/search_pattern_in_file.inc
+--remove_file $err_out
+
+--echo # With --gtid-strict-mode explicitly provided, mariadb-binlog should
+--echo # error
+--echo # MYSQL_BINLOG --gtid-strict-mode master-bin.000001 master-bin.000002 > /dev/null 2> err_out
+--error 1
+--exec $MYSQL_BINLOG --gtid-strict-mode $datadir/master-bin.000001 $datadir/master-bin.000002 > /dev/null 2> $err_out
+--let SEARCH_PATTERN= ERROR: Found out of order GTID
+--source include/search_pattern_in_file.inc
+--remove_file $err_out
+
+--echo # Cleanup
+RESET MASTER;
+--echo End of the tests
