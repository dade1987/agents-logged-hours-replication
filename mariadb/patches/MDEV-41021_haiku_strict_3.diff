+/** Validate SET GLOBAL innodb_log_archive.
+Changing the value is not possible in read-only mode, because the
+log header would have to be rewritten.
+@return 0 if the value can be assigned, 1 on error */
+static int innodb_log_archive_check(THD*, st_mysql_sys_var*, void *save,
+                                    st_mysql_value *value)
+{
+  my_bool archive;
+
+  if (value->value_type(value) == MYSQL_VALUE_TYPE_STRING)
+  {
+    char buff[8];
+    int len= sizeof buff;
+    const char *str= value->val_str(value, buff, &len);
+    if (!str)
+      return 1;
+    if (!my_strcasecmp_latin1(str, "ON"))
+      archive= 1;
+    else if (!my_strcasecmp_latin1(str, "OFF"))
+      archive= 0;
+    else
+      return 1;
+  }
+  else
+  {
+    long long tmp;
+    if (value->val_int(value, &tmp) < 0 || (tmp != 0 && tmp != 1))
+      return 1;
+    archive= tmp != 0;
+  }
+
+  *static_cast<my_bool*>(save)= archive;
+
+  if (archive != log_sys.archive &&
+      (srv_read_only_mode || recv_sys.rpo))
+  {
+    my_error(ER_INNODB_READ_ONLY, MYF(0));
+    return 1;
+  }
+
+  return 0;
+}
+
 static void innodb_log_archive_update(THD *thd, st_mysql_sys_var*,
                                       void *, const void *save) noexcept
 {
