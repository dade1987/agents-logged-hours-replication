diff --git a/mysql-test/suite/innodb_gis/r/rtree_lock_wait_rescan.result b/mysql-test/suite/innodb_gis/r/rtree_lock_wait_rescan.result
new file mode 100644
index 00000000..87bfa125
--- /dev/null
+++ b/mysql-test/suite/innodb_gis/r/rtree_lock_wait_rescan.result
@@ -0,0 +1,38 @@
+#
+# MDEV-40404 Assertion !lock.is_locked_or_waiting() failed
+# in buf_page_t::init() on R-tree search after lock wait
+#
+CREATE TABLE t1 (
+id INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
+pt POINT NOT NULL,
+SPATIAL INDEX(pt)
+) ENGINE=InnoDB;
+CREATE PROCEDURE p1(IN imax INT)
+BEGIN
+DECLARE i INT DEFAULT 0;
+DECLARE CONTINUE HANDLER FOR SQLEXCEPTION BEGIN END;
+SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
+SET SESSION autocommit = 0;
+WHILE i < imax DO
+INSERT INTO t1 (pt) VALUES (ST_GeomFromText(CONCAT('POINT(', FLOOR(RAND() * 10), ' ', FLOOR(RAND() * 10), ')')));
+SELECT id, ST_AsText(pt) FROM t1 WHERE ST_Within(pt, ST_GeomFromText('POLYGON((0 0, 100 0, 100 100, 0 100, 0 0))')) LIMIT 3;
+IF i MOD 5 = 4 THEN
+ROLLBACK;
+END IF;
+SET i = i + 1;
+END WHILE;
+ROLLBACK;
+END$$
+connect  con1,localhost,root,,test;
+connect  con2,localhost,root,,test;
+connection con1;
+CALL p1(5000);
+connection con2;
+CALL p1(5000);
+connection con1;
+connection con2;
+connection default;
+disconnect con1;
+disconnect con2;
+DROP PROCEDURE p1;
+DROP TABLE t1;
