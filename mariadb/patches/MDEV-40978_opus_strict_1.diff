 PARTITION p0 VALUES LESS THAN ('2026-04-20')
 );
+
+--echo #
+--echo # MDEV-40978 PREPARE with INTERVAL ? in Partition DDL crashes the server
+--echo #
+--error ER_PART_WRONG_VALUE
+PREPARE s FROM 'CREATE TABLE t7(c DATE)
+  PARTITION BY RANGE COLUMNS(c)
+  INTERVAL ? DAY
+  (PARTITION p0 VALUES LESS THAN (?))';
+
+--error ER_PART_WRONG_VALUE
+PREPARE s FROM 'CREATE TABLE t7(c DATE)
+  PARTITION BY RANGE COLUMNS(c)
+  INTERVAL ?+1 DAY
+  (PARTITION p0 VALUES LESS THAN (''2026-04-20''))';
+
+--error ER_PART_WRONG_VALUE
+EXECUTE IMMEDIATE 'CREATE TABLE t7(c DATE)
+  PARTITION BY RANGE COLUMNS(c)
+  INTERVAL ? DAY
+  (PARTITION p0 VALUES LESS THAN (''2026-04-20''))' USING 1;
+
+--error ER_PART_WRONG_VALUE
+PREPARE s FROM 'CREATE TABLE t7(c INT) WITH SYSTEM VERSIONING
+  PARTITION BY SYSTEM_TIME INTERVAL ? DAY
+  (PARTITION p0 HISTORY, PARTITION pn CURRENT)';
