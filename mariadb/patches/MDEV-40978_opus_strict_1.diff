+  PARTITION BY RANGE COLUMNS(c)
+  INTERVAL ? DAY
+  (PARTITION p0 VALUES LESS THAN (''2026-04-20''))' USING 1;
+ERROR HY000: Wrong parameters for partitioned `t7`: wrong value for 'INTERVAL'
+PREPARE s FROM 'CREATE TABLE t7(c INT) WITH SYSTEM VERSIONING
