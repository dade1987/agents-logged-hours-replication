diff --git a/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read_checksum.test b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read_checksum.test
new file mode 100644
index 00000000..343b2c5e
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_force_read_checksum.test
@@ -0,0 +1,31 @@
+# MDEV-40544: Assertion fail / Memory leak in `mariadb-binlog --force-read`
+#
+# With --force-read, an event that fails the checksum verification (or is
+# explicitly refused, like MySQL 8.0 TRANSACTION_PAYLOAD_EVENT) must be output
+# as an Unknown event with a warning, not reported as an error together with
+# the substitute event (which asserted in debug builds and leaked the event in
+# release builds).
+
+--source include/have_debug.inc
+--source include/have_binlog_format_mixed.inc # format-agnostic
+
+RESET MASTER;
+FLUSH BINARY LOGS;
+
+--let SEARCH_FILE= $MYSQLTEST_VARDIR/tmp/binlog_mysqlbinlog_force_read_checksum.out
+--let $MYSQLD_DATADIR= `SELECT @@datadir`
+
+--echo #MYSQL_BINLOG --verify-binlog-checksum --force-read --debug=d,simulate_checksum_test_failure #MYSQLD_DATADIR/master-bin.000001 > #SEARCH_FILE 2>&1
+--exec $MYSQL_BINLOG --verify-binlog-checksum --force-read --debug=d,simulate_checksum_test_failure $MYSQLD_DATADIR/master-bin.000001 > $SEARCH_FILE 2>&1
+
+--echo # The checksum failure is reported as a warning, not an error
+--let SEARCH_PATTERN= WARNING: Event crc check failed
+--source include/search_pattern_in_file.inc
+--let SEARCH_PATTERN= ERROR: .*Event crc check failed
+--source include/search_pattern_in_file.inc
+
+--echo # The corrupt event is output as an Unknown event
+--let SEARCH_PATTERN= # [Uu]nknown [Ee]vent
+--source include/search_pattern_in_file.inc
+
+--remove_file $SEARCH_FILE
