diff --git a/mysql-test/suite/innodb_fts/r/optimize_extern_ilist.result b/mysql-test/suite/innodb_fts/r/optimize_extern_ilist.result
new file mode 100644
index 00000000..89477367
--- /dev/null
+++ b/mysql-test/suite/innodb_fts/r/optimize_extern_ilist.result
@@ -0,0 +1,18 @@
+#
+# MDEV-40621 InnoDB: Failing assertion: doc_id == src_node->last_doc_id
+#
+CREATE TABLE t1 (id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
+body MEDIUMTEXT, FULLTEXT KEY ftidx (body)) ENGINE=InnoDB;
+INSERT INTO t1 (body) SELECT REPEAT('megaword ', 30) FROM seq_1_to_260;
+SET @save_fulltext_only = @@GLOBAL.innodb_optimize_fulltext_only;
+SET GLOBAL innodb_optimize_fulltext_only = ON;
+DELETE FROM t1 WHERE id = 1;
+OPTIMIZE TABLE t1;
+Table	Op	Msg_type	Msg_text
+test.t1	optimize	status	OK
+SELECT COUNT(*) FROM t1 WHERE MATCH(body) AGAINST('megaword');
+COUNT(*)
+259
+SET GLOBAL innodb_optimize_fulltext_only = @save_fulltext_only;
+DROP TABLE t1;
+# End of 13.1 tests
