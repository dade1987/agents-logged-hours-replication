diff --git a/mysql-test/main/deny_revoke_public.result b/mysql-test/main/deny_revoke_public.result
index a82947a6..f2bb5e21 100644
--- a/mysql-test/main/deny_revoke_public.result
+++ b/mysql-test/main/deny_revoke_public.result
@@ -165,6 +165,43 @@ REVOKE DENY SELECT ON test.t1 FROM r1;
 DROP USER u_role@localhost;
 DROP ROLE r1;
 #
+# MDEV-41343 REVOKE DENY ... FROM PUBLIC bypass via unrelated
+# column-level UPDATE grant on mysql.global_priv
+#
+CREATE USER u_sel@localhost;
+GRANT SELECT ON test.t1 TO u_sel@localhost;
+CREATE USER u_host@localhost;
+GRANT UPDATE (Host) ON mysql.global_priv TO u_host@localhost;
+CREATE USER u_priv@localhost;
+GRANT UPDATE (Priv) ON mysql.global_priv TO u_priv@localhost;
+DENY SELECT ON test.t1 TO PUBLIC;
+connect  con_sel, localhost, u_sel,,test;
+SELECT * FROM t1;
+ERROR 42000: SELECT command denied to user 'u_sel'@'localhost' for table `test`.`t1`
+disconnect con_sel;
+# UPDATE on an unrelated column only: no bypass
+connect  con_host, localhost, u_host,,;
+UPDATE mysql.global_priv SET Priv='{}' WHERE User='u_sel';
+ERROR 42000: UPDATE command denied to user 'u_host'@'localhost' for column 'Priv' in table 'global_priv'
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+ERROR 42000: SELECT, GRANT command denied to user 'u_host'@'localhost' for table `test`.`t1`
+disconnect con_host;
+connect  con_sel, localhost, u_sel,,test;
+SELECT * FROM t1;
+ERROR 42000: SELECT command denied to user 'u_sel'@'localhost' for table `test`.`t1`
+disconnect con_sel;
+# UPDATE on the Priv column, where DENYs are stored: bypass allowed
+connect  con_priv, localhost, u_priv,,;
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+disconnect con_priv;
+connect  con_sel, localhost, u_sel,,test;
+SELECT * FROM t1;
+id	data
+1	100
+disconnect con_sel;
+connection default;
+DROP USER u_sel@localhost, u_host@localhost, u_priv@localhost;
+#
 # Known limitation: denying the bypass's own privilege is unrecoverable
 #
 DENY UPDATE ON *.* TO PUBLIC;
diff --git a/mysql-test/main/deny_revoke_public.test b/mysql-test/main/deny_revoke_public.test
