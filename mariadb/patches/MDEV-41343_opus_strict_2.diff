+
+DROP USER u_sel@localhost, u_host@localhost, u_priv@localhost;
+
 --echo #
 --echo # Known limitation: denying the bypass's own privilege is unrecoverable
 --echo #
diff --git a/sql/sql_acl.cc b/sql/sql_acl.cc
index 70984625..79d75cb3 100644
--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -14423,9 +14423,37 @@ bool Sql_cmd_grant::should_bypass_revoke_deny(THD *thd)
   TABLE_LIST tl;
   tl.init_one_table(&MYSQL_SCHEMA_NAME, &MYSQL_TABLE_NAME[USER_TABLE],
                     NULL, TL_WRITE);
-  return !check_access(thd, UPDATE_ACL, tl.db.str, &tl.grant.privilege,
-                       &tl.grant.m_internal, 0, 1) &&
-         !check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE);
+  if (check_access(thd, UPDATE_ACL, tl.db.str, &tl.grant.privilege,
+                   &tl.grant.m_internal, 0, 1) ||
+      check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE))
+    return false;
+
+  /*
+    check_grant() succeeds when UPDATE is granted on *some* column only,
+    leaving the rest of the check in grant.want_privilege for the
+    column-level check. DENY entries are stored in the Priv column, so
+    UPDATE must cover that column (MDEV-41343).
+  */
+  if (!(tl.grant.want_privilege & UPDATE_ACL))
+    return true;                                // table level (or higher)
+
+  Security_context *sctx= thd->security_ctx;
+  const Lex_ident_column priv_column(STRING_WITH_LEN("Priv"));
+  privilege_t want_access(tl.grant.want_privilege & UPDATE_ACL);
+
+  if (tl.grant.privilege.denied_privs(want_access))
+    return false;
+
+  mysql_rwlock_rdlock(&LOCK_grant);
+  tl.grant.refresh(sctx, tl.db.str, tl.table_name.str);
+  access_t acc= merge_same_level(
+      check_grant_column_int(tl.grant.grant_table_user, priv_column),
+      check_grant_column_int(tl.grant.grant_table_role, priv_column),
+      check_grant_column_int(tl.grant.grant_public, priv_column));
+  acc.merge_with_parent(tl.grant.privilege);
+  mysql_rwlock_unlock(&LOCK_grant);
+
+  return !(want_access & ~acc);
 }
 
 
