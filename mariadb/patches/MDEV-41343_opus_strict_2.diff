@@ -190,6 +190,48 @@ REVOKE DENY SELECT ON test.t1 FROM r1;
 DROP USER u_role@localhost;
 DROP ROLE r1;
 
+--echo #
+--echo # MDEV-41343 REVOKE DENY ... FROM PUBLIC bypass via unrelated
+--echo # column-level UPDATE grant on mysql.global_priv
+--echo #
+CREATE USER u_sel@localhost;
+GRANT SELECT ON test.t1 TO u_sel@localhost;
+CREATE USER u_host@localhost;
+GRANT UPDATE (Host) ON mysql.global_priv TO u_host@localhost;
+CREATE USER u_priv@localhost;
+GRANT UPDATE (Priv) ON mysql.global_priv TO u_priv@localhost;
+DENY SELECT ON test.t1 TO PUBLIC;
+
+connect (con_sel, localhost, u_sel,,test);
+--error ER_TABLEACCESS_DENIED_ERROR
+SELECT * FROM t1;
+disconnect con_sel;
+
+--echo # UPDATE on an unrelated column only: no bypass
+connect (con_host, localhost, u_host,,);
+--error ER_COLUMNACCESS_DENIED_ERROR
+UPDATE mysql.global_priv SET Priv='{}' WHERE User='u_sel';
+--error ER_TABLEACCESS_DENIED_ERROR
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+disconnect con_host;
+
+connect (con_sel, localhost, u_sel,,test);
+--error ER_TABLEACCESS_DENIED_ERROR
+SELECT * FROM t1;
+disconnect con_sel;
+
+--echo # UPDATE on the Priv column, where DENYs are stored: bypass allowed
+connect (con_priv, localhost, u_priv,,);
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+disconnect con_priv;
+
+connect (con_sel, localhost, u_sel,,test);
+SELECT * FROM t1;
+disconnect con_sel;
