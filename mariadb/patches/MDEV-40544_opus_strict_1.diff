+--echo #
+--echo # MDEV-40544: Assertion fail / Memory leak in `mariadb-binlog --force-read`
+--echo #
+# A checksum failure under --force-read must produce an Unknown event,
+# not an error (and not both).
+--let SEARCH_PATTERN= ^.*?# [Uu]nknown [Ee]vent
+--echo #mariadb_binlog --debug=d,simulate_checksum_test_failure #binlog_file 2>&1
+--exec $mariadb_binlog --debug=d,simulate_checksum_test_failure $binlog_file 2>&1
+--source include/search_pattern_in_file.inc
+--remove_file $SEARCH_FILE
