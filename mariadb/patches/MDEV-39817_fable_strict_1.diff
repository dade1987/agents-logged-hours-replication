diff --git a/sql/item_jsonfunc.cc b/sql/item_jsonfunc.cc
index cf5bb9be..768b62f1 100644
--- a/sql/item_jsonfunc.cc
+++ b/sql/item_jsonfunc.cc
@@ -4101,7 +4101,53 @@ void Item_func_json_arrayagg::cut_max_length(String *result,
     return;
   }
 
+  /*
+    The last appended value is a JSON string: <separator>"...".
+    Find the position of its opening quote, skipping the separator.
+  */
+  const char *ptr= result->ptr();
+  uint start= old_length;
+  while (start < result->length() && ptr[start] != '"')
+    start++;
+
+  /*
+    There must be room for at least the opening and the closing quotes,
+    i.e. for an empty string '""'. Otherwise we can neither cut the value
+    nor close it properly (and max_length-1 could even be smaller than
+    old_length, making the cut below read outside of the appended value),
+    so drop the whole last value together with its separator.
+  */
+  if (max_length < start + 2)
+  {
+    result->length(old_length);
+    return;
+  }
+
   Item_func_group_concat::cut_max_length(result, old_length, max_length-1);
+
+  /*
+    Make sure we did not cut in the middle of a JSON escape sequence
+    (\X or \uXXXX), which would produce an invalid JSON string.
+  */
+  {
+    uint cut_length= result->length();
+    uint i= start + 1;
+    while (i < cut_length)
+    {
+      if (ptr[i] == '\\')
+      {
+        uint esc_length= (i + 1 < cut_length && ptr[i + 1] == 'u') ? 6 : 2;
+        if (i + esc_length > cut_length)
+        {
+          result->length(i);
+          break;
+        }
+        i+= esc_length;
+      }
+      else
+        i++;
+    }
+  }
   result->append('"');
 }
 
