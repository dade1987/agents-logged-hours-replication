@@ -10832,5 +10832,24 @@ COERCIBILITY(@col_type)	COERCIBILITY('binary(128)')
 5	6
 DROP TABLE t1;
 #
+# MDEV-39530 Collation mix issue after update
+#
+SET NAMES utf8mb3 COLLATE utf8mb3_uca1400_ai_ci;
+CREATE TABLE t1 (id INT NOT NULL PRIMARY KEY, path VARCHAR(800) NOT NULL DEFAULT '')
+ENGINE=Aria CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci;
+INSERT INTO t1 VALUES (1,'text');
+SELECT IF((@p:=(SELECT f.path FROM t1 f WHERE f.id=1 AND f.path REGEXP '^xx'))!='',1,2) AS c;
+c
+2
+SELECT IF((@p:=(SELECT f.path FROM t1 f WHERE f.id=1))!='',1,2) AS c;
+c
+1
+SELECT COERCIBILITY(@p:=(SELECT f.path FROM t1 f WHERE f.id=1)) AS c1,
+COLLATION(@p:=(SELECT f.path FROM t1 f WHERE f.id=1)) AS c2;
+c1	c2
+5	utf8mb3_unicode_ci
+DROP TABLE t1;
+SET NAMES utf8mb3;
+#
 # End of 11.6 tests
