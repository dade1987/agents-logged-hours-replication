diff --git a/sql/sql_base.cc b/sql/sql_base.cc
index 544df995..71ec6c7a 100644
--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -9371,17 +9371,23 @@ fill_record_n_invoke_before_triggers(THD *thd, TABLE *table,
     /*
       Re-calculate virtual fields to cater for cases when base columns are
       updated by the triggers.
+
+      Note that the list of fields may be empty, e.g. in LOAD DATA without
+      a SET clause (MDEV-40480), where the row values are stored directly
+      into the table fields before this function is called. Virtual fields
+      must be re-calculated in that case as well.
     */
-    if (table->vfield && fields.elements)
+    if (table->vfield)
     {
-      Item *fld= (Item_field*) fields.head();
-      Item_field *item_field= fld->field_for_view_update();
-      if (item_field)
+#ifndef DBUG_OFF
+      if (fields.elements)
       {
-        DBUG_ASSERT(table == item_field->field->table);
-        result|= table->update_virtual_fields(table->file,
-                                              VCOL_UPDATE_FOR_WRITE);
+        Item_field *item_field= fields.head()->field_for_view_update();
+        DBUG_ASSERT(!item_field || table == item_field->field->table);
       }
+#endif
+      result|= table->update_virtual_fields(table->file,
+                                            VCOL_UPDATE_FOR_WRITE);
     }
   }
   return result;
