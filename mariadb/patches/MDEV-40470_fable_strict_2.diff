diff --git a/sql/structs.h b/sql/structs.h
index aed4dacb..ef399fed 100644
--- a/sql/structs.h
+++ b/sql/structs.h
@@ -256,7 +256,16 @@ struct LEX_USER: public AUTHID
   USER_AUTH *auth;
   bool has_auth()
   {
-    return auth && (auth->plugin.length || auth->auth_str.length || auth->pwtext.length);
+    /*
+      Authentication can be a chain of plugins (IDENTIFIED VIA a OR b ...).
+      Check the whole chain, not only the first element, otherwise
+      IDENTIFIED VIA '' OR plugin USING 'xxx' would be considered as
+      "no authentication specified".
+    */
+    for (USER_AUTH *a= auth; a; a= a->next)
+      if (a->plugin.length || a->auth_str.length || a->pwtext.length)
+        return true;
+    return false;
   }
 };
 
