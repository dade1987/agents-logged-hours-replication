+/*
+  Fields of ROW TYPE OF table/cursor variables: the field list is not known
+  at parse time, so the field is resolved by name at execution time.
+*/
+class my_var_sp_row_field_by_name: public my_var_sp
+{
+  LEX_CSTRING m_field_name;
+public:
+  my_var_sp_row_field_by_name(const Lex_ident_sys_st &varname,
+                              const sp_rcontext_addr &varaddr,
+                              const Lex_ident_sys_st &field, sp_head *s)
+   :my_var_sp(varname, varaddr,
+              &type_handler_double/*Not really used*/, s),
+    m_field_name(field)
+  { }
+  bool check_assignability(THD *thd, const List<Item> &select_list,
+                           bool *assign_as_row) const override
+  {
+    *assign_as_row= false;
+    return select_list.elements == 1;
+  }
+  bool set(THD *thd, Item *item) override
+  {
+    sp_rcontext *rctx= get_rcontext(thd->spcont);
+    uint field_idx;
+    if (rctx->find_row_field_by_name_or_error(&field_idx, offset(),
+                                              m_field_name))
+      return true;
+    return rctx->set_variable_row_field(thd, offset(), field_idx, &item);
+  }
+};
+
