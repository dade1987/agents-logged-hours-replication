+#
+# MDEV-40484 ambiguous view frm parsing when username includes \n
+#
+create user 'root
+definer_host=localhost
+suid=1'@localhost;
+grant create, create view, create routine, select on test.* to 'root
+definer_host=localhost
+suid=1'@localhost;
+connect  u,localhost,'root
+definer_host=localhost
+suid=1',,test;
+select group_concat(user,'@',host) from mysql.global_priv;
+ERROR 42000: SELECT command denied to user 'root
+definer_host=localhost
+suid=1'@'localhost' for table `mysql`.`global_priv`
+create function f() returns text sql security invoker
+return (select group_concat(user,'@',host) from mysql.global_priv);
+create view v as select f();
+select * from v;
+ERROR HY000: View 'test.v' references invalid table(s) or column(s) or function(s) or definer/invoker of view lack rights to use them
+disconnect u;
+connection default;
+select * from v;
+ERROR HY000: View 'test.v' references invalid table(s) or column(s) or function(s) or definer/invoker of view lack rights to use them
+show create view v;
+View	Create View	character_set_client	collation_connection
+v	CREATE ALGORITHM=UNDEFINED DEFINER=`root
+definer_host=localhost
+suid=1`@`localhost` SQL SECURITY DEFINER VIEW `v` AS select `f`() AS `f()`	latin1	latin1_swedish_ci
+drop view v;
+drop function f;
+drop user 'root
+definer_host=localhost
+suid=1'@localhost;
