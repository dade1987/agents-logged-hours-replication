diff --git a/sql/sql_base.cc b/sql/sql_base.cc
index eabad770..bcafebc3 100644
--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -9373,12 +9373,17 @@ fill_record_n_invoke_before_triggers(THD *thd, TABLE *table,
     }
 
     /*
-      Re-calculate virtual fields to cater for cases when base columns are
-      updated by the triggers.
+      The trigger may have run a statement (e.g. SET) that closed the tables
+      opened under LOCK TABLES, which cleans up the session-dependent virtual
+      column expressions. Refix them before they are evaluated.
     */
     if (table->vfield)
+    {
+      if (table->vcol_fix_expr(thd))
+        return TRUE;
       result|= table->update_virtual_fields(table->file,
                                             VCOL_UPDATE_FOR_WRITE);
+    }
   }
   return result;
 }
diff --git a/sql/table.cc b/sql/table.cc
index d4cb5a79..27ea1ca2 100644
--- a/sql/table.cc
+++ b/sql/table.cc
@@ -3874,10 +3874,13 @@ bool TABLE::vcol_fix_expr(THD *thd)
   if (pos_in_table_list->placeholder() || vcol_refix_list.is_empty())
     return false;
 
-  if (!thd->stmt_arena->is_conventional() &&
-      vcol_refix_list.head()->expr->fixed())
+  if (vcol_refix_list.head()->expr->fixed())
   {
-    /* NOTE: Under trigger we already have fixed expressions */
+    /*
+      Expressions are still fixed, nothing to do. This is the case under
+      a trigger or stored routine, which keeps the expressions fixed while
+      it runs.
+    */
     return false;
   }
 
