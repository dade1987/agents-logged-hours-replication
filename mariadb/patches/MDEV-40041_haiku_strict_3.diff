diff --git a/mysql-test/suite/vcol/r/vcol_session_func_trigger.result b/mysql-test/suite/vcol/r/vcol_session_func_trigger.result
new file mode 100644
index 00000000..2df31ce6
--- /dev/null
+++ b/mysql-test/suite/vcol/r/vcol_session_func_trigger.result
@@ -0,0 +1,16 @@
+#
+# MDEV-40041 Assertion `fixed()' failed in Item_func_connection_id::val_int
+# on INSERT w/ TRIGGER under LOCK TABLES
+#
+SET sql_mode='';
+CREATE TABLE t (c INT);
+LOCK TABLE t WRITE;
+CREATE OR REPLACE TABLE t (a INT AS (CONNECTION_ID()));
+CREATE TRIGGER a BEFORE INSERT ON t FOR EACH ROW SET @a:=1;
+INSERT INTO t VALUES ('');
+SELECT a = CONNECTION_ID() AS same FROM t;
+same
+1
+UNLOCK TABLES;
+DROP TABLE t;
+SET sql_mode=DEFAULT;
