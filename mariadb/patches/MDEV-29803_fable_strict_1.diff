diff --git a/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_replay.test b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_replay.test
new file mode 100644
index 00000000..a88c2301
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_replay.test
@@ -0,0 +1,65 @@
+#
+# Purpose:
+#   Binary logs of a server that does not run with gtid_strict_mode may contain
+# GTIDs whose sequence numbers are not monotonically increasing, e.g. after
+# re-applying the output of mariadb-binlog (which explicitly sets
+# gtid_seq_no) to the server that produced it. mariadb-binlog must be able to
+# process such logs without error by default, i.e. its --gtid-strict-mode
+# option must be off by default, like the server's gtid_strict_mode.
+#
+# References:
+#   MDEV-29803: Unexpected ERROR: Found out of order GTID after replaying
+#               binlog read from remote
+#   MDEV-4989: Support for GTID in mysqlbinlog
+#
+--source include/have_log_bin.inc
+
+--let $datadir= `select @@datadir`
+--let $out_file= $MYSQLTEST_VARDIR/tmp/mysqlbinlog_gtid_replay.out
+--let $err_file= $MYSQLTEST_VARDIR/tmp/mysqlbinlog_gtid_replay.err
+
+SET @save_gtid_strict_mode= @@global.gtid_strict_mode;
+SET @@global.gtid_strict_mode= 0;
+
+RESET MASTER;
+CREATE TABLE t1 (a INT);
+CREATE TABLE t2 (a INT);
+DROP TABLE t1, t2;
+FLUSH BINARY LOGS;
+
+--echo # Re-apply the first binlog read from the remote server. The replayed
+--echo # events keep their original GTIDs, so the second binlog contains
+--echo # sequence numbers lower than the ones already logged.
+--exec $MYSQL_BINLOG --read-from-remote-server -uroot --protocol=tcp --port=$MASTER_MYPORT master-bin.000001 | $MYSQL test 2>&1
+
+DROP TABLE IF EXISTS t1, t2;
+FLUSH BINARY LOGS;
+
+--echo # Processing both binlogs must succeed by default
+--echo # MYSQL_BINLOG datadir/master-bin.000001 datadir/master-bin.000002 > out_file 2> err_file
+--exec $MYSQL_BINLOG $datadir/master-bin.000001 $datadir/master-bin.000002 > $out_file 2> $err_file
+--let SEARCH_FILE= $err_file
+--let SEARCH_PATTERN= Found out of order GTID
+--source include/search_pattern_in_file.inc
+
+--echo # Processing both binlogs must still error with --gtid-strict-mode
+--echo # MYSQL_BINLOG --gtid-strict-mode datadir/master-bin.000001 datadir/master-bin.000002 > out_file 2> err_file
+--error 1
+--exec $MYSQL_BINLOG --gtid-strict-mode $datadir/master-bin.000001 $datadir/master-bin.000002 > $out_file 2> $err_file
+--let SEARCH_FILE= $err_file
+--let SEARCH_PATTERN= ERROR: Found out of order GTID
+--source include/search_pattern_in_file.inc
+
+--echo # Processing both binlogs with -vvv must only warn
+--echo # MYSQL_BINLOG -vvv datadir/master-bin.000001 datadir/master-bin.000002 > out_file 2> err_file
+--exec $MYSQL_BINLOG -vvv $datadir/master-bin.000001 $datadir/master-bin.000002 > $out_file 2> $err_file
+--let SEARCH_FILE= $err_file
+--let SEARCH_PATTERN= WARNING: Found out of order GTID
+--source include/search_pattern_in_file.inc
+
+--remove_file $out_file
+--remove_file $err_file
+SET @@global.gtid_strict_mode= @save_gtid_strict_mode;
+RESET MASTER;
+
+--echo # End of test
