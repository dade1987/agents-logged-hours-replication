diff --git a/mysql-test/suite/binlog/r/binlog_mysqlbinlog_gtid_replay.result b/mysql-test/suite/binlog/r/binlog_mysqlbinlog_gtid_replay.result
new file mode 100644
index 00000000..8eacbc62
--- /dev/null
+++ b/mysql-test/suite/binlog/r/binlog_mysqlbinlog_gtid_replay.result
@@ -0,0 +1,24 @@
+SET @save_gtid_strict_mode= @@global.gtid_strict_mode;
+SET @@global.gtid_strict_mode= 0;
+RESET MASTER;
+CREATE TABLE t1 (a INT);
+CREATE TABLE t2 (a INT);
+DROP TABLE t1, t2;
+FLUSH BINARY LOGS;
+# Re-apply the first binlog read from the remote server. The replayed
+# events keep their original GTIDs, so the second binlog contains
+# sequence numbers lower than the ones already logged.
+DROP TABLE IF EXISTS t1, t2;
+FLUSH BINARY LOGS;
+# Processing both binlogs must succeed by default
+# MYSQL_BINLOG datadir/master-bin.000001 datadir/master-bin.000002 > out_file 2> err_file
+NOT FOUND /Found out of order GTID/ in mysqlbinlog_gtid_replay.err
+# Processing both binlogs must still error with --gtid-strict-mode
+# MYSQL_BINLOG --gtid-strict-mode datadir/master-bin.000001 datadir/master-bin.000002 > out_file 2> err_file
+FOUND 1 /ERROR: Found out of order GTID/ in mysqlbinlog_gtid_replay.err
+# Processing both binlogs with -vvv must only warn
+# MYSQL_BINLOG -vvv datadir/master-bin.000001 datadir/master-bin.000002 > out_file 2> err_file
+FOUND 3 /WARNING: Found out of order GTID/ in mysqlbinlog_gtid_replay.err
+SET @@global.gtid_strict_mode= @save_gtid_strict_mode;
+RESET MASTER;
+# End of test
