diff --git a/sql/ha_partition.cc b/sql/ha_partition.cc
index 411e1d30..7cf4be05 100644
--- a/sql/ha_partition.cc
+++ b/sql/ha_partition.cc
@@ -11137,8 +11137,13 @@ void ha_partition::release_auto_increment()
         If the current auto_increment values is lower than the reserved
         value, and the reserved value was reserved by this thread,
         we can lower the reserved value.
+        next_insert_id must also be inside the last interval reserved by
+        this thread, otherwise the values between next_insert_id and the
+        start of that interval could have been reserved (and used) by
+        other threads (MDEV-40995).
       */
       if (next_insert_id < next_auto_inc_val &&
+          next_insert_id >= auto_inc_interval_for_cur_row.minimum() &&
           auto_inc_interval_for_cur_row.maximum() >= next_auto_inc_val)
       {
         THD *thd= ha_thd();
diff --git a/sql/handler.h b/sql/handler.h
index cb408d1b..b958dbbd 100644
--- a/sql/handler.h
+++ b/sql/handler.h
@@ -4114,6 +4114,16 @@ class handler :public Sql_alloc
     */
     next_insert_id= (prev_insert_id > 0) ? prev_insert_id :
       insert_id_for_cur_row;
+    /*
+      If the failed row was the first one taken from a freshly reserved
+      interval, prev_insert_id is the end of the previous interval, and
+      the values between the two intervals may have been reserved (and
+      used) by other connections meanwhile. Never move the cursor below
+      the start of the currently reserved interval: the failed row's
+      value is the first value of that interval and is the one to re-use.
+    */
+    if (next_insert_id < auto_inc_interval_for_cur_row.minimum())
+      next_insert_id= auto_inc_interval_for_cur_row.minimum();
   }
 
   virtual void update_create_info(HA_CREATE_INFO *create_info) {}
