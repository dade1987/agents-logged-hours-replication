diff --git a/sql/sql_acl.cc b/sql/sql_acl.cc
index 70984625..a1f40e99 100644
--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -14419,13 +14419,25 @@ bool Sql_cmd_grant::should_bypass_revoke_deny(THD *thd)
       return false;
   }
 
-  /* Does current user have UPDATE grant for mysql.global_priv ? */
+  /*
+    Does current user have UPDATE grant on the whole mysql.global_priv table
+    (global, database or table level)? A column-level UPDATE grant on some
+    column (e.g. UPDATE (Host)) is not enough: it does not allow arbitrary
+    modification of the DENY entries stored in the Priv column.
+  */
   TABLE_LIST tl;
   tl.init_one_table(&MYSQL_SCHEMA_NAME, &MYSQL_TABLE_NAME[USER_TABLE],
                     NULL, TL_WRITE);
-  return !check_access(thd, UPDATE_ACL, tl.db.str, &tl.grant.privilege,
-                       &tl.grant.m_internal, 0, 1) &&
-         !check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE);
+  if (check_access(thd, UPDATE_ACL, tl.db.str, &tl.grant.privilege,
+                   &tl.grant.m_internal, 0, 1) ||
+      check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE))
+    return false;
+
+  /*
+    check_grant() accepts column-level privileges as satisfying the request
+    at table level, so verify that UPDATE is actually granted on the table.
+  */
+  return (tl.grant.privilege & UPDATE_ACL) == UPDATE_ACL;
 }
 
 
