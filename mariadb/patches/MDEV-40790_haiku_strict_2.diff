+/*
+  This class handles fields of a ROW variable declared with
+  "ROW TYPE OF table" or "ROW TYPE OF cursor" when used as an OUT
+  variable in SELECT INTO, e.g.:
+    DECLARE r ROW TYPE OF t1;
+    SELECT a, b INTO r.a, r.b FROM t1;
+  The field list of such a variable is not known at parse time,
+  so the field is looked up by name at runtime.
+*/
+class my_var_sp_row_field_by_name: public my_var_sp
+{
+  LEX_CSTRING m_field_name;
+public:
+  my_var_sp_row_field_by_name(const Lex_ident_sys_st &varname,
+                              const sp_rcontext_addr &varaddr,
+                              const Lex_ident_sys_st &field,
+                              sp_head *s)
+   :my_var_sp(varname, varaddr,
+              &type_handler_double/*Not really used*/, s),
+    m_field_name(field)
+  { }
+  bool check_assignability(THD *thd, const List<Item> &select_list,
+                           bool *assign_as_row) const override
+  {
+    *assign_as_row= false;
+    return select_list.elements == 1;
+  }
+  bool set(THD *thd, Item *item) override
+  {
+    sp_rcontext *ctx= get_rcontext(thd->spcont);
+    uint field_idx;
+    if (ctx->find_row_field_by_name_or_error(&field_idx, offset(),
+                                             m_field_name))
+      return true;
+    return ctx->set_variable_row_field(thd, offset(), field_idx, &item);
+  }
+};
+
+
 my_var *Type_handler_row::make_outvar(THD *thd,
                                       const Lex_ident_sys_st &name,
                                       const sp_rcontext_addr &addr,
@@ -159,6 +198,16 @@ my_var *Type_handler_row::make_outvar_field(THD *thd,
   DBUG_ASSERT(t);
