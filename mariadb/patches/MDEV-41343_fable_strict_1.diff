diff --git a/mysql-test/main/deny_revoke_public.result b/mysql-test/main/deny_revoke_public.result
index a82947a6..a7c4de6f 100644
--- a/mysql-test/main/deny_revoke_public.result
+++ b/mysql-test/main/deny_revoke_public.result
@@ -144,6 +144,40 @@ connection default;
 REVOKE UPDATE ON mysql.global_priv FROM u_proc@localhost;
 DROP USER u_proc@localhost;
 #
+# MDEV-41343 REVOKE DENY ... FROM PUBLIC bypass via unrelated
+# column-level UPDATE grant on mysql.global_priv
+#
+# DENYs live in the Priv column; UPDATE on another column must not
+# enable the bypass, UPDATE (Priv) must.
+#
+CREATE USER u_colgrant@localhost;
+GRANT SELECT ON test.t1 TO u_colgrant@localhost;
+GRANT UPDATE (Host) ON mysql.global_priv TO u_colgrant@localhost;
+DENY SELECT ON test.t1 TO PUBLIC;
+connect  con_colgrant1, localhost, u_colgrant,,test;
+UPDATE mysql.global_priv SET Priv='{}';
+ERROR 42000: UPDATE command denied to user 'u_colgrant'@'localhost' for column 'Priv' in table 'global_priv'
+SELECT * FROM t1;
+ERROR 42000: SELECT command denied to user 'u_colgrant'@'localhost' for table `test`.`t1`
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+ERROR 42000: SELECT, GRANT command denied to user 'u_colgrant'@'localhost' for table `test`.`t1`
+SELECT * FROM t1;
+ERROR 42000: SELECT command denied to user 'u_colgrant'@'localhost' for table `test`.`t1`
+disconnect con_colgrant1;
+connection default;
+GRANT UPDATE (Priv) ON mysql.global_priv TO u_colgrant@localhost;
+connect  con_colgrant2, localhost, u_colgrant,,test;
+SELECT * FROM t1;
+ERROR 42000: SELECT command denied to user 'u_colgrant'@'localhost' for table `test`.`t1`
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+SELECT * FROM t1;
+id	data
+1	100
+disconnect con_colgrant2;
+connection default;
+REVOKE UPDATE (Host, Priv) ON mysql.global_priv FROM u_colgrant@localhost;
+DROP USER u_colgrant@localhost;
+#
 # A role is not PUBLIC: no bypass, even with UPDATE on mysql.global_priv
 #
 CREATE ROLE r1;
diff --git a/mysql-test/main/deny_revoke_public.test b/mysql-test/main/deny_revoke_public.test
