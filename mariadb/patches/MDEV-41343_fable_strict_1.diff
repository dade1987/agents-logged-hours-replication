+
 --echo #
 --echo # A role is not PUBLIC: no bypass, even with UPDATE on mysql.global_priv
 --echo #
diff --git a/sql/sql_acl.cc b/sql/sql_acl.cc
index 70984625..6280578c 100644
--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -14423,9 +14423,33 @@ bool Sql_cmd_grant::should_bypass_revoke_deny(THD *thd)
   TABLE_LIST tl;
   tl.init_one_table(&MYSQL_SCHEMA_NAME, &MYSQL_TABLE_NAME[USER_TABLE],
                     NULL, TL_WRITE);
-  return !check_access(thd, UPDATE_ACL, tl.db.str, &tl.grant.privilege,
-                       &tl.grant.m_internal, 0, 1) &&
-         !check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE);
+  if (check_access(thd, UPDATE_ACL, tl.db.str, &tl.grant.privilege,
+                   &tl.grant.m_internal, 0, 1) ||
+      check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE))
+    return false;
+
+  /*
+    check_grant() succeeds when UPDATE is granted on at least some columns
+    of the table, leaving the rest to be verified per column
+    (tl.grant.want_privilege != 0). DENYs are stored in the Priv column, so
+    an UPDATE grant on any other column (e.g. UPDATE (Host)) is not enough
+    to hand-edit them. Check that the Priv column itself is updatable.
+    The check must be silent: a failure here only means "no bypass", and
+    the normal privilege checks report their own errors.
+  */
+  if (tl.grant.want_privilege)
+  {
+    Dummy_error_handler err_handler;
+    thd->push_internal_handler(&err_handler);
+    bool denied= check_grant_column(thd, &tl.grant, tl.db.str,
+                                    tl.table_name.str,
+                                    Lex_ident_column(STRING_WITH_LEN("Priv")),
+                                    thd->security_ctx);
+    thd->pop_internal_handler();
+    if (denied)
+      return false;
+  }
+  return true;
 }
 
 
