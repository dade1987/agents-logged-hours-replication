diff --git a/mysql-test/suite/roles/acl_cache_role_vs_localhost.test b/mysql-test/suite/roles/acl_cache_role_vs_localhost.test
new file mode 100644
index 00000000..3b926bd0
--- /dev/null
+++ b/mysql-test/suite/roles/acl_cache_role_vs_localhost.test
@@ -0,0 +1,33 @@
+#
+# MDEV-40541 role vs user@localhost acl_cache key confusion
+#
+--source include/not_embedded.inc
+
+create database db;
+create table db.t1(a varchar(40));
+insert into db.t1 values ('role-cache-collision-row');
+
+create role r1;
+create user r1@localhost identified by 'r1pass';
+create user u1@'127.0.0.1' identified by 'u1pass';
+
+grant select on db.* to r1@localhost;
+grant r1 to u1@'127.0.0.1';
+
+connect r1,localhost,r1,r1pass;
+select a from db.t1;
+
+connect u1,127.0.0.1,u1,u1pass;
+set role r1;
+show grants;
+--replace_regex /'u1'@'[^']*'/'u1'@'HOST'/
+--error ER_TABLEACCESS_DENIED_ERROR
+select a from db.t1;
+
+disconnect u1;
+disconnect r1;
+connection default;
+drop user r1@localhost;
+drop user u1@'127.0.0.1';
+drop role r1;
+drop database db;
