-  tmp_db= strmov(strmov(key, safe_str(ip)) + 1, user) + 1;
+  /*
+    The cache key is <type><ip>\0<user>\0<db>. Roles are looked up with
+    empty host and ip, while a user connected to localhost via a socket has
+    host "localhost" but no ip, so both used to produce the same key. The
+    first byte distinguishes role lookups
+    from user lookups, so that a role and a user@localhost with the same
+    name do not share a cache entry.
+  */
+  key[0]= ((host && host[0]) || (ip && ip[0])) ? 'u' : 'r';
+  tmp_db= strmov(strmov(key + 1, safe_str(ip)) + 1, user) + 1;
   end= strnmov(tmp_db, db, key + sizeof(key) - tmp_db);
 
   if (end >= key + sizeof(key)) // db name was truncated
