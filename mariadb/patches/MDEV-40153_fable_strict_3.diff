diff --git a/sql/sql_type_row.cc b/sql/sql_type_row.cc
index 97d48ed3..4b792389 100644
--- a/sql/sql_type_row.cc
+++ b/sql/sql_type_row.cc
@@ -252,7 +252,17 @@ bool Type_handler_row::
   {
     DBUG_ASSERT(rec->field);
     DBUG_ASSERT(rec->field->elements);
-    DBUG_ASSERT(rec->field->head()->charset == nullptr); // Not prepared
+    /*
+      Note, rec->field is never prepared itself: it's always deep-copied
+      before preparing (see also sp_variable_declarations_finalize() and
+      LEX::declare_type_ref_cursor()). It's not possible to test here
+      that rec->field is not prepared by checking that "charset" of its
+      members is nullptr: the parser can set "charset" explicitly for
+      some data types already at the parse time, e.g.:
+        TYPE r IS RECORD (a BLOB);
+        TYPE r IS RECORD (a VARBINARY(10));
+        TYPE r IS RECORD (a VARCHAR(10) CHARACTER SET utf8mb4);
+    */
     Row_definition_list *row= rec->field->deep_copy(thd);
     if (!row || thd->lex->sphead->row_fill_field_definitions(thd, row))
       return true; // Error
