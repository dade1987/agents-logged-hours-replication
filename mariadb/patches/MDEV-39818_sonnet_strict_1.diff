diff --git a/mysql-test/suite/innodb/r/fk_backtick_name.result b/mysql-test/suite/innodb/r/fk_backtick_name.result
new file mode 100644
index 00000000..447a1f9f
--- /dev/null
+++ b/mysql-test/suite/innodb/r/fk_backtick_name.result
@@ -0,0 +1,13 @@
+#
+# MDEV-39818 backtick in FK names breaks SHOW CREATE TABLE
+#
+CREATE TABLE p (a INT PRIMARY KEY) ENGINE=InnoDB;
+CREATE TABLE t1 (a INT, CONSTRAINT `foo `` bar` FOREIGN KEY (a) REFERENCES p(a)) ENGINE=InnoDB;
+SHOW CREATE TABLE t1;
+Table	Create Table
+t1	CREATE TABLE `t1` (
+  `a` int(11) DEFAULT NULL,
+  KEY `foo `` bar` (`a`),
+  CONSTRAINT `foo `` bar` FOREIGN KEY (`a`) REFERENCES `p` (`a`)
+) ENGINE=InnoDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
+DROP TABLE t1, p;
