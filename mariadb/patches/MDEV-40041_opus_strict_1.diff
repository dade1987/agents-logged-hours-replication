diff --git a/sql/sql_base.cc b/sql/sql_base.cc
index eabad770..4aa586dc 100644
--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -876,8 +876,13 @@ int close_thread_tables(THD *thd) noexcept
       /*
         For simple locking we cleanup it here because we don't close thread
         tables. For prelocking we close it when we do close thread tables.
+        Don't do it at the end of a sub-statement (e.g. a statement inside
+        a trigger or a stored function executed under LOCK TABLES): the
+        tables may still be in use by the calling statement, which will
+        evaluate virtual column expressions after the sub-statement ends.
+        The cleanup will be done at the end of the top-level statement.
       */
-      if (thd->locked_tables_mode != LTM_PRELOCKED)
+      if (thd->locked_tables_mode != LTM_PRELOCKED && !thd->in_sub_stmt)
         table->vcol_cleanup_expr(thd);
     }
 
