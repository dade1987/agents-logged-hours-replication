+#
+# MDEV-39969 Incorrect result of JSON_TABLE with BIT
+#
+SELECT ord, i, b+0, HEX(b)
+FROM JSON_TABLE('[0,1]', '$[*]' COLUMNS (
+ord FOR ORDINALITY,
+i INT PATH '$',
+b BIT(1) PATH '$')) AS jt
+ORDER BY ord;
+ord	i	b+0	HEX(b)
+1	0	0	0
+2	1	1	1
+SELECT ord, b+0, HEX(b)
+FROM JSON_TABLE('[0,1,5,127,255,true,false]', '$[*]' COLUMNS (
+ord FOR ORDINALITY,
+b BIT(8) PATH '$')) AS jt
+ORDER BY ord;
+ord	b+0	HEX(b)
+1	0	0
+2	1	1
+3	5	5
+4	127	7F
+5	255	FF
+6	1	1
+7	0	0
