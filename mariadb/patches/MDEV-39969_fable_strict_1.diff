diff --git a/sql/json_table.cc b/sql/json_table.cc
index e5ac6008..c106bde0 100644
--- a/sql/json_table.cc
+++ b/sql/json_table.cc
@@ -384,6 +384,24 @@ static void store_json_in_field(Field *f, const json_engine_t *je)
     }
     break;
   }
+  case JSON_VALUE_NUMBER:
+  {
+    /*
+      Field_bit::store(const char*, ...) treats the string as a binary
+      bit-string rather than a number. So a JSON number must be converted
+      to a numeric value first, otherwise '0' would be stored as the
+      byte 0x30, and '1' as 0x31, etc.
+    */
+    if (f->type() == MYSQL_TYPE_BIT)
+    {
+      my_decimal dec;
+      str2my_decimal(0, (const char *) je->value, je->value_len, je->s.cs,
+                     &dec);
+      f->store_decimal(&dec);
+      return;
+    }
+    break;
+  }
   default:
     break;
   };
