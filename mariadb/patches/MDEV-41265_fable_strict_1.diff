@@ -2551,3 +2551,65 @@ eq	counter
 1	5
 DROP FUNCTION f1;
 # End of 11.8 tests
+#
+# MDEV-41265 SELECT/UPDATE RETURNING INTO a single row-field fails with
+#            ER_WRONG_NUMBER_OF_COLUMNS_IN_SELECT, even though the
+#            column count matches
+#
+CREATE TABLE t1 (a INT, b VARCHAR(10));
+INSERT INTO t1 VALUES (10,'b10');
+CREATE PROCEDURE p1()
+BEGIN
+DECLARE r0 ROW (a INT, b VARCHAR(10));
+SELECT a INTO r0.a FROM t1;
+SELECT r0.a;
+END;
+$$
+CALL p1;
+r0.a
+10
+DROP PROCEDURE p1;
+CREATE PROCEDURE p2()
+BEGIN
+DECLARE r0 ROW (a INT, b VARCHAR(10));
+UPDATE t1 SET a=a+1 RETURNING a INTO r0.a;
+SELECT r0.a;
+END;
+$$
+CALL p2;
+r0.a
+11
+DROP PROCEDURE p2;
+CREATE PROCEDURE p3()
+BEGIN
+DECLARE r0 ROW (a INT, b VARCHAR(10));
+SELECT a, b INTO r0.a FROM t1;
+SELECT r0.a;
+END;
+$$
+CALL p3;
+ERROR 21000: The used SELECT statements have a different number of columns
+DROP PROCEDURE p3;
+CREATE PROCEDURE p4()
+BEGIN
+DECLARE r0 ROW TYPE OF t1;
+SELECT a INTO r0.a FROM t1;
+SELECT r0.a;
+END;
+$$
+CALL p4;
+r0.a
+11
+DROP PROCEDURE p4;
+CREATE PROCEDURE p5()
+BEGIN
+DECLARE r0 ROW TYPE OF t1;
+SELECT a, b INTO r0.a FROM t1;
+SELECT r0.a;
+END;
+$$
+CALL p5;
+ERROR 21000: The used SELECT statements have a different number of columns
+DROP PROCEDURE p5;
+DROP TABLE t1;
+# End of 12.3 tests
