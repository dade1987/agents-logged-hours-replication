diff --git a/mysql-test/main/deny_revoke_public.result b/mysql-test/main/deny_revoke_public.result
index a82947a6..d27f5b76 100644
--- a/mysql-test/main/deny_revoke_public.result
+++ b/mysql-test/main/deny_revoke_public.result
@@ -165,6 +165,31 @@ REVOKE DENY SELECT ON test.t1 FROM r1;
 DROP USER u_role@localhost;
 DROP ROLE r1;
 #
+# MDEV-41343 REVOKE DENY ... FROM PUBLIC bypass via unrelated
+# column-level UPDATE grant on mysql.global_priv
+#
+# Only a table-level UPDATE on mysql.global_priv enables the bypass.
+# UPDATE on some column other than Priv does not let the user modify
+# the stored DENYs, so it must not lift the PUBLIC-wide DENY either.
+#
+CREATE USER u_colpriv@localhost;
+GRANT SELECT ON test.t1 TO u_colpriv@localhost;
+GRANT UPDATE (Host) ON mysql.global_priv TO u_colpriv@localhost;
+DENY SELECT ON test.t1 TO PUBLIC;
+connect  con_colpriv, localhost, u_colpriv,,test;
+SELECT * FROM t1;
+ERROR 42000: SELECT command denied to user 'u_colpriv'@'localhost' for table `test`.`t1`
+UPDATE mysql.global_priv SET Priv='{}' WHERE User='u_colpriv';
+ERROR 42000: UPDATE command denied to user 'u_colpriv'@'localhost' for column 'Priv' in table 'global_priv'
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+ERROR 42000: SELECT, GRANT command denied to user 'u_colpriv'@'localhost' for table `test`.`t1`
+SELECT * FROM t1;
+ERROR 42000: SELECT command denied to user 'u_colpriv'@'localhost' for table `test`.`t1`
+disconnect con_colpriv;
+connection default;
+REVOKE DENY SELECT ON test.t1 FROM PUBLIC;
+DROP USER u_colpriv@localhost;
+#
 # Known limitation: denying the bypass's own privilege is unrecoverable
 #
 DENY UPDATE ON *.* TO PUBLIC;
