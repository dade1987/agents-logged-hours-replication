diff --git a/sql/sql_acl.cc b/sql/sql_acl.cc
index 70984625..088176be 100644
--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -14419,13 +14419,21 @@ bool Sql_cmd_grant::should_bypass_revoke_deny(THD *thd)
       return false;
   }
 
-  /* Does current user have UPDATE grant for mysql.global_priv ? */
+  /*
+    Does current user have UPDATE grant for the whole mysql.global_priv
+    table? check_grant() returns success also when the user has only
+    column-level UPDATE on some columns (the actual column check is
+    deferred, and want_privilege keeps the still unresolved bits). Such a
+    user cannot modify the Priv column where DENYs are stored, so an
+    unrelated column grant (e.g. UPDATE (Host)) must not enable the bypass.
+  */
   TABLE_LIST tl;
   tl.init_one_table(&MYSQL_SCHEMA_NAME, &MYSQL_TABLE_NAME[USER_TABLE],
                     NULL, TL_WRITE);
   return !check_access(thd, UPDATE_ACL, tl.db.str, &tl.grant.privilege,
                        &tl.grant.m_internal, 0, 1) &&
-         !check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE);
+         !check_grant(thd, UPDATE_ACL, &tl, FALSE, 1, TRUE) &&
+         tl.grant.want_privilege == NO_ACL;
 }
 
 
