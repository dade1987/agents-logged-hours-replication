diff --git a/mysql-test/suite/archive/archive.result b/mysql-test/suite/archive/archive.result
index fa2b4f7e..51a5ebf4 100644
--- a/mysql-test/suite/archive/archive.result
+++ b/mysql-test/suite/archive/archive.result
@@ -12906,3 +12906,30 @@ t1	CREATE TEMPORARY TABLE `t1` (
   `b` varchar(10) DEFAULT NULL
 ) ENGINE=ARCHIVE DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
 drop table t1;
+#
+# MDEV-24245 REPAIR on ARCHIVE Database destroys TEXT Data
+#
+create table t1 (a text, b blob, c int) engine=archive;
+insert into t1 values ('Testtext', 'blobdata', 1), (repeat('x', 300), null, 2), (null, 'z', 3);
+select a, b, c from t1;
+a	b	c
+Testtext	blobdata	1
	NULL	2
+NULL	z	3
+repair table t1;
+Table	Op	Msg_type	Msg_text
+test.t1	repair	status	OK
+select a, b, c from t1;
+a	b	c
+Testtext	blobdata	1
	NULL	2
+NULL	z	3
+optimize table t1;
+Table	Op	Msg_type	Msg_text
+test.t1	optimize	status	OK
+select a, b, c from t1;
+a	b	c
+Testtext	blobdata	1
	NULL	2
+NULL	z	3
+drop table t1;
