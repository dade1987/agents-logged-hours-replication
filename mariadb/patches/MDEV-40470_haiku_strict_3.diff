diff --git a/sql/structs.h b/sql/structs.h
index aed4dacb..70582430 100644
--- a/sql/structs.h
+++ b/sql/structs.h
@@ -256,7 +256,16 @@ struct LEX_USER: public AUTHID
   USER_AUTH *auth;
   bool has_auth()
   {
-    return auth && (auth->plugin.length || auth->auth_str.length || auth->pwtext.length);
+    /*
+      Check every alternative of "IDENTIFIED VIA x OR y ...", not only the
+      first one: e.g. "IDENTIFIED VIA '' OR mysql_native_password USING
+      PASSWORD('...')" has an empty first alternative, but still sets
+      the authentication of the account.
+    */
+    for (USER_AUTH *a= auth; a; a= a->next)
+      if (a->plugin.length || a->auth_str.length || a->pwtext.length)
+        return true;
+    return false;
   }
 };
 
