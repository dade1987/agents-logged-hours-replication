diff --git a/sql/sql_type.cc b/sql/sql_type.cc
index 74917bbc..d8fd30a2 100644
--- a/sql/sql_type.cc
+++ b/sql/sql_type.cc
@@ -8970,6 +8970,26 @@ Type_handler_hex_hybrid::cast_to_int_type_handler() const
 }
 
 
+/*
+  SUM(DISTINCT 0xHHHH), AVG(DISTINCT b'1100') etc. aggregate the numeric
+  value of the hex hybrid, i.e. an unsigned integer. The generic
+  Type_handler::make_num_distinct_aggregator_field() would create a DOUBLE
+  field using the literal's octet length (e.g. 1 for b'1100') as the display
+  width, so 12 would be truncated to 9.
+*/
+Field *
+Type_handler_hex_hybrid::make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
+                                                            const Item *item)
+                                                            const
+{
+  return new(mem_root)
+         Field_longlong(NULL, MY_INT64_NUM_DECIMAL_DIGITS,
+                        (uchar *) (item->maybe_null() ? "" : 0),
+                        item->maybe_null() ? 1 : 0, Field::NONE,
+                        &item->name, 0, true/*unsigned*/);
+}
+
+
 bool Type_handler_hex_hybrid::
        Item_hybrid_func_fix_attributes(THD *thd,
                                        const LEX_CSTRING &func_name,
