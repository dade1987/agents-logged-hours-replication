diff --git a/sql/ha_partition.cc b/sql/ha_partition.cc
index 411e1d30..7070da29 100644
--- a/sql/ha_partition.cc
+++ b/sql/ha_partition.cc
@@ -11137,8 +11137,17 @@ void ha_partition::release_auto_increment()
         If the current auto_increment values is lower than the reserved
         value, and the reserved value was reserved by this thread,
         we can lower the reserved value.
+
+        The values given back must all belong to the interval last reserved
+        by this statement, i.e. next_insert_id must not be below its
+        minimum. A next_insert_id below the interval would mean that
+        restore_auto_increment() moved it back across an interval boundary
+        after a failed row; the values between the intervals may have been
+        reserved and inserted by other sessions, so lowering the shared
+        counter onto them would later hand out existing ids (MDEV-40995).
       */
       if (next_insert_id < next_auto_inc_val &&
+          next_insert_id >= auto_inc_interval_for_cur_row.minimum() &&
           auto_inc_interval_for_cur_row.maximum() >= next_auto_inc_val)
       {
         THD *thd= ha_thd();
diff --git a/sql/handler.h b/sql/handler.h
index cb408d1b..cd64a6cd 100644
--- a/sql/handler.h
+++ b/sql/handler.h
@@ -4111,9 +4111,22 @@ class handler :public Sql_alloc
       for this first row, so no id was generated since the INSERT started, so
       we should set next_insert_id to 0; if insert_id_for_cur_row is not 0, it
       is the generated id of the first and failed row, so we use it.
+
+      The value must never be moved below the interval currently reserved
+      for this statement (auto_inc_interval_for_cur_row): if the failed row
+      was the first one drawn from a freshly reserved interval, prev_insert_id
+      is the end of the *previous* interval, and the values between the two
+      intervals may have been reserved and used by other sessions in the
+      meantime. Re-using them, or giving them back to the shared counter in
+      release_auto_increment() (see ha_partition), would hand out values
+      that already exist in the table (MDEV-40995). The failed row's own
+      value, the minimum of the current interval, is still free and is the
+      correct value to continue from.
     */
     next_insert_id= (prev_insert_id > 0) ? prev_insert_id :
       insert_id_for_cur_row;
+    if (next_insert_id < auto_inc_interval_for_cur_row.minimum())
+      next_insert_id= auto_inc_interval_for_cur_row.minimum();
   }
 
   virtual void update_create_info(HA_CREATE_INFO *create_info) {}
