diff --git a/sql/sql_base.cc b/sql/sql_base.cc
index eabad770..6c7ca441 100644
--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -876,8 +876,14 @@ int close_thread_tables(THD *thd) noexcept
       /*
         For simple locking we cleanup it here because we don't close thread
         tables. For prelocking we close it when we do close thread tables.
+
+        Under LTM_PRELOCKED_UNDER_LOCK_TABLES we must not cleanup the
+        expressions at the end of a sub-statement (e.g. a statement inside
+        a trigger or a stored function): the tables may still be in use by
+        the top-level statement, which will do the cleanup when it closes
+        its tables.
       */
-      if (thd->locked_tables_mode != LTM_PRELOCKED)
+      if (thd->locked_tables_mode != LTM_PRELOCKED && !thd->in_sub_stmt)
         table->vcol_cleanup_expr(thd);
     }
 
