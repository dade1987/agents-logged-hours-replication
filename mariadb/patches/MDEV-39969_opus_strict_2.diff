diff --git a/sql/json_table.cc b/sql/json_table.cc
index e5ac6008..6e247474 100644
--- a/sql/json_table.cc
+++ b/sql/json_table.cc
@@ -384,6 +384,23 @@ static void store_json_in_field(Field *f, const json_engine_t *je)
     }
     break;
   }
+  case JSON_VALUE_NUMBER:
+  {
+    if (f->type() == MYSQL_TYPE_BIT)
+    {
+      /*
+        A JSON number must be stored into a BIT column as a number,
+        not as a string of its digits (which would be interpreted
+        as a binary string, e.g. '0' -> 0x30).
+      */
+      my_decimal dec;
+      str2my_decimal(E_DEC_OOM, (const char *) je->value, je->value_len,
+                     je->s.cs, &dec);
+      f->store_decimal(&dec);
+      return;
+    }
+    break;
+  }
   default:
     break;
   };
