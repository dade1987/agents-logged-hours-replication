+#
+# MDEV-39969 Incorrect result of JSON_TABLE with BIT
+#
+SELECT ord, i, b+0, HEX(b)
+FROM JSON_TABLE('[0,1]', '$[*]' COLUMNS (ord FOR ORDINALITY, i INT PATH '$',
