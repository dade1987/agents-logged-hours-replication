diff --git a/sql/json_table.cc b/sql/json_table.cc
index e5ac6008..275d29d8 100644
--- a/sql/json_table.cc
+++ b/sql/json_table.cc
@@ -384,6 +384,24 @@ static void store_json_in_field(Field *f, const json_engine_t *je)
     }
     break;
   }
+  case JSON_VALUE_NUMBER:
+    if (f->type() == MYSQL_TYPE_BIT)
+    {
+      /*
+        Storing a string into a BIT field copies its bytes as-is,
+        so the number "0" would be stored as the byte 0x30.
+        Convert the JSON number to an integer instead.
+      */
+      int err;
+      char *end;
+      bool unsigned_fl= !(je->num_flags & JSON_NUM_NEG);
+      ulonglong nr= je->s.cs->strntoull10rnd((const char *) je->value,
+                                             je->value_len, unsigned_fl,
+                                             &end, &err);
+      f->store((longlong) nr, unsigned_fl);
+      return;
+    }
+    break;
   default:
     break;
   };
