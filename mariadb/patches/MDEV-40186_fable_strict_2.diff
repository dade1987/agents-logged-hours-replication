-
   custom_arg.keyseg= keyinfo->seg;
   custom_arg.key_length= hp_rb_make_key(keyinfo, info->recbuf, record, recpos);
   custom_arg.search_flag= SEARCH_SAME;
+  if (flag)
+  {
+    /*
+      The current index position is going away. Remember the full key
+      (together with the row position) of the deleted record, so that
+      heap_rnext()/heap_rprev() can restart the search from the last
+      found key instead of from the original search key.
+    */
+    info->last_pos= NULL; /* For heap_rnext/heap_rprev */
+    memcpy(info->lastkey, info->recbuf,
+           custom_arg.key_length + sizeof(uchar*));
+    info->lastkey_len= custom_arg.key_length;
+    info->lastkey_with_rowid= 1;
+  }
   old_allocated= keyinfo->rb_tree.allocated;
   res= tree_delete(&keyinfo->rb_tree, info->recbuf, custom_arg.key_length,
                    &custom_arg);
