+#
+# MDEV-40186 MEMORY tables incorrectly restart index scan on DELETE
+#
+create table t1 (a int, b int, c int, key (a, b) using btree) engine=heap;
+insert t1 select seq % 10, seq, seq from seq_1_to_80;
+flush status;
+delete from t1 where a=3 and c>60;
+select variable_name, variable_value from information_schema.session_status where variable_name like 'handler_r%' and variable_value>0;
+variable_name	variable_value
+HANDLER_READ_KEY	1
+HANDLER_READ_NEXT	8
+select * from t1 where a=3 order by b;
