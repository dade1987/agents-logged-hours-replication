index 9579fb51..92e3cb62 100644
--- a/storage/heap/hp_delete.c
+++ b/storage/heap/hp_delete.c
@@ -71,12 +71,23 @@ int hp_rb_delete_key(HP_INFO *info, register HP_KEYDEF *keyinfo,
   size_t old_allocated;
   int res;
 
