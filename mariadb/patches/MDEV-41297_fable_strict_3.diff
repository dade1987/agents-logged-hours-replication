diff --git a/mysql-test/suite/heap/blob_group_by.result b/mysql-test/suite/heap/blob_group_by.result
index d46a2297..48c9a702 100644
--- a/mysql-test/suite/heap/blob_group_by.result
+++ b/mysql-test/suite/heap/blob_group_by.result
@@ -60,3 +60,55 @@ HEX(val)	cnt
 0107	2
 DROP TABLE t1;
 # End of MDEV-38975 GROUP BY blob tests
+#
+# MDEV-41297 Wrong result upon DISTINCT/GROUP BY/UNION on TEXT with
+#            empty and all-space values
+#
+# Under a PAD SPACE collation '' and '   ' are one value. An empty
+# blob is stored with a NULL chain pointer; hp_materialize_one_blob()
+# must still hand a valid pointer to the collation comparison.
+#
+CREATE TABLE t1 (a TEXT);
+INSERT INTO t1 VALUES (''),('   ');
+SELECT COUNT(*) FROM (SELECT DISTINCT a FROM t1) AS d;
+COUNT(*)
+1
+SELECT COUNT(DISTINCT a) FROM t1;
+COUNT(DISTINCT a)
+1
+SELECT COUNT(*) FROM (SELECT a FROM t1 GROUP BY a) AS g;
+COUNT(*)
+1
+SELECT COUNT(*) FROM (SELECT a FROM t1 WHERE LENGTH(a)=0 UNION SELECT a FROM t1 WHERE LENGTH(a)=3) AS u;
+COUNT(*)
+1
+SELECT COUNT(*) FROM (SELECT a FROM t1 WHERE LENGTH(a)=3 UNION SELECT a FROM t1 WHERE LENGTH(a)=0) AS u;
+COUNT(*)
+1
+DROP TABLE t1;
+CREATE TABLE t1 (a TEXT CHARACTER SET latin1);
+INSERT INTO t1 VALUES ('   '),('');
+SELECT COUNT(*) FROM (SELECT DISTINCT a FROM t1) AS d;
+COUNT(*)
+1
+SELECT COUNT(DISTINCT a) FROM t1;
+COUNT(DISTINCT a)
+1
+SELECT COUNT(*) FROM (SELECT a FROM t1 GROUP BY a) AS g;
+COUNT(*)
+1
+DROP TABLE t1;
+# NO PAD collation: '' and '   ' stay two distinct values
+CREATE TABLE t1 (a TEXT COLLATE utf8mb4_bin);
+INSERT INTO t1 VALUES (''),('   ');
+SELECT COUNT(*) FROM (SELECT DISTINCT a FROM t1) AS d;
+COUNT(*)
+2
+SELECT COUNT(DISTINCT a) FROM t1;
+COUNT(DISTINCT a)
+2
+SELECT COUNT(*) FROM (SELECT a FROM t1 GROUP BY a) AS g;
+COUNT(*)
+2
+DROP TABLE t1;
+# End of MDEV-41297 tests
