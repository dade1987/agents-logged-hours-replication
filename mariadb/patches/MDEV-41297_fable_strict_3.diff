diff --git a/storage/heap/hp_blob.c b/storage/heap/hp_blob.c
index 3763b949..b8cd5bf2 100644
--- a/storage/heap/hp_blob.c
+++ b/storage/heap/hp_blob.c
@@ -920,18 +920,26 @@ int hp_read_blobs(HP_INFO *info, uchar *record, const uchar *pos)
 
   @return Pointer into info->blob_buff with contiguous blob data,
           or NULL on allocation failure.
+          A zero-length blob always returns a valid (non-NULL) pointer:
+          hp_write_blobs() stores a NULL chain pointer for an empty value,
+          and the callers treat NULL as a failure. Under a PAD SPACE
+          collation an empty value and an all-space value compare equal,
+          so the empty value must reach the collation comparison.
 */
 
 const uchar *hp_materialize_one_blob(HP_INFO *info,
                                      const uchar *chain,
                                      uint32 data_len)
 {
+  static const uchar empty_blob[1]= { 0 };
   HP_SHARE *share= info->s;
   uint visible= share->visible;
   uint recbuffer= share->block.recbuffer;
 
-  if (data_len == 0 || !chain)
-    return chain;
+  if (data_len == 0)
+    return empty_blob;
+  if (!chain)
+    return NULL;                              /* Corrupt: data without chain */
 
   if (hp_is_single_rec(chain, visible))
     return chain;                         /* Case A: no header, data at offset 0 */
