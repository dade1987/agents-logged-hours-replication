diff --git a/sql/ha_partition.cc b/sql/ha_partition.cc
index 411e1d30..2c8bf1ea 100644
--- a/sql/ha_partition.cc
+++ b/sql/ha_partition.cc
@@ -11137,8 +11137,19 @@ void ha_partition::release_auto_increment()
         If the current auto_increment values is lower than the reserved
         value, and the reserved value was reserved by this thread,
         we can lower the reserved value.
+
+        The values we give back must all belong to the interval last
+        reserved by this statement, i.e. next_insert_id must lie inside
+        [minimum(), maximum()) of auto_inc_interval_for_cur_row. If
+        next_insert_id is below the start of that interval (which can happen
+        after a failed row was rolled back with restore_auto_increment()),
+        the values between next_insert_id and the start of the interval may
+        have been reserved and used by other statements, and lowering the
+        shared counter onto them would hand out already existing ids
+        (MDEV-40995).
       */
       if (next_insert_id < next_auto_inc_val &&
+          next_insert_id >= auto_inc_interval_for_cur_row.minimum() &&
           auto_inc_interval_for_cur_row.maximum() >= next_auto_inc_val)
       {
         THD *thd= ha_thd();
diff --git a/sql/handler.h b/sql/handler.h
index cb408d1b..6faf4a9f 100644
--- a/sql/handler.h
+++ b/sql/handler.h
@@ -4111,9 +4111,25 @@ class handler :public Sql_alloc
       for this first row, so no id was generated since the INSERT started, so
       we should set next_insert_id to 0; if insert_id_for_cur_row is not 0, it
       is the generated id of the first and failed row, so we use it.
+
+      The restored value must never fall below the start of the interval
+      that is currently reserved for this statement
+      (auto_inc_interval_for_cur_row). If the failed row was the first row
+      drawn from a freshly reserved interval, prev_insert_id is the upper
+      bound of the *previous* interval, and the values between the two
+      intervals may meanwhile have been reserved and used by other
+      statements (e.g. on a partitioned table, where the values are handed
+      out from a table wide counter). Re-using such a value would hand out
+      an id that already exists, and returning it to the engine in
+      release_auto_increment() would move the engine's counter backwards.
+      Instead, re-use the first value of the current interval, which was
+      reserved for this statement and is not yet used.
     */
     next_insert_id= (prev_insert_id > 0) ? prev_insert_id :
       insert_id_for_cur_row;
+    if (next_insert_id > 0 &&
+        next_insert_id < auto_inc_interval_for_cur_row.minimum())
+      next_insert_id= auto_inc_interval_for_cur_row.minimum();
   }
 
   virtual void update_create_info(HA_CREATE_INFO *create_info) {}
