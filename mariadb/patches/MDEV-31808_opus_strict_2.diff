diff --git a/sql/sql_base.cc b/sql/sql_base.cc
index 379337af..c67f6c0d 100644
--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -4994,8 +4994,16 @@ bool open_and_lock_internal_tables(TABLE *table, bool lock_table)
   TABLE_LIST *tmp= table->internal_tables;
   DML_prelocking_strategy prelocking_strategy;
 
-  if (open_tables(thd, thd->lex->create_info, &tmp, &counter, 0,
-                  &prelocking_strategy))
+  /*
+    The table that is being altered may already be flushed (for example
+    ALTER TABLE ... LOCK=EXCLUSIVE calls wait_while_table_is_used(), which
+    marks its TABLE_SHARE as flushed). Opening the internal tables must not
+    try to back off and reopen all tables in this case, as that would close
+    and unlock tables in use by the caller (MDEV-31808).
+    We hold proper MDL locks on all tables, so ignoring flush is safe.
+  */
+  if (open_tables(thd, thd->lex->create_info, &tmp, &counter,
+                  MYSQL_OPEN_IGNORE_FLUSH, &prelocking_strategy))
     goto err;
 
   if (lock_table)
