diff --git a/mysql-test/suite/sql_sequence/default.result b/mysql-test/suite/sql_sequence/default.result
index a6f6d127..34b887b4 100644
--- a/mysql-test/suite/sql_sequence/default.result
+++ b/mysql-test/suite/sql_sequence/default.result
@@ -346,4 +346,19 @@ id1	id2
 9	1
 drop table t1,t2,t3;
 drop sequence s1,s2;
+#
+# MDEV-31808 Server crash upon altering table with NEXTVAL for default
+#            under exclusive lock
+#
+CREATE SEQUENCE s;
+CREATE TABLE t (a INT DEFAULT(NEXTVAL(s)), b INT);
+INSERT INTO t (b) VALUES (1),(2);
+ALTER TABLE t FORCE, ALGORITHM=COPY, LOCK=EXCLUSIVE;
+ALTER TABLE t ADD c INT DEFAULT(NEXTVAL(s)), ALGORITHM=COPY, LOCK=EXCLUSIVE;
+SELECT * FROM t;
+a	b	c
+1	1	3
+2	2	4
+DROP TABLE t;
+DROP SEQUENCE s;
 # End of 10.6 tests
