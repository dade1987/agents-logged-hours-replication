+/*
+  This class handles fields of a ROW variable declared as
+  "ROW TYPE OF table" or "ROW TYPE OF cursor" when it's used as an INTO
+  variable, e.g.: SELECT a,b INTO r0.a,r0.b FROM t1;
+  The structure of such variables is not known at parse time,
+  so the field is looked up by name at runtime.
+*/
+class my_var_sp_row_field_by_name: public my_var_sp
+{
+  const LEX_CSTRING m_field_name;
+public:
+  my_var_sp_row_field_by_name(const Lex_ident_sys_st &varname,
+                              const sp_rcontext_addr &varaddr,
+                              const LEX_CSTRING &field_name, sp_head *s)
+   :my_var_sp(varname, varaddr, &type_handler_null, s),
+    m_field_name(field_name)
+  { }
+  bool check_assignability(THD *thd, const List<Item> &select_list,
+                           bool *assign_as_row) const override
+  {
+    *assign_as_row= false;
+    return select_list.elements != 1;
+  }
+  bool set(THD *thd, Item *item) override
+  {
+    return get_rcontext(thd->spcont)->
+             set_variable_composite_by_name(thd, offset(), m_field_name, &item);
+  }
+};
+
