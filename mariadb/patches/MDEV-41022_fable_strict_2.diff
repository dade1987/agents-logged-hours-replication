+--echo # MDEV-41022 Wildcard term returns no rows when combined with a phrase
+--echo # in boolean search
 --echo #
+CREATE TABLE t (id INT AUTO_INCREMENT PRIMARY KEY, txt TEXT, FULLTEXT(txt))
+ENGINE=InnoDB;
+INSERT INTO t (txt) VALUES ('auth code out');
+# The row is still in the in-memory FTS index cache
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"zzzz" aut*' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"auth code" -cod*' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"auth code" aut*' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"auth code" @2 aut*' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('aut* "zzzz"' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"zzzz" +aut*' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"zzzz" auth' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('aut*' IN BOOLEAN MODE);
+# Sync the cache to the auxiliary tables; the results must not change
+SET @saved_optimize_fulltext_only = @@GLOBAL.innodb_optimize_fulltext_only;
+SET GLOBAL innodb_optimize_fulltext_only=ON;
+OPTIMIZE TABLE t;
+SET GLOBAL innodb_optimize_fulltext_only=@saved_optimize_fulltext_only;
