+SELECT id FROM t WHERE MATCH(txt) AGAINST('"auth code" -cod*' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"auth code" aut*' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"auth code" @2 aut*' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('aut* "zzzz"' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"zzzz" +aut*' IN BOOLEAN MODE);
+DROP TABLE t;
 
+--echo #
+--echo # End of 10.11 tests
