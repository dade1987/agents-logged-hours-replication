diff --git a/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_default_nonstrict.test b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_default_nonstrict.test
new file mode 100644
index 00000000..788f823e
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_default_nonstrict.test
@@ -0,0 +1,38 @@
+#
+# MDEV-29803: Unexpected ERROR: Found out of order GTID after replaying
+#             binlog read from remote
+#
+# A server running with gtid_strict_mode=OFF is allowed to binlog out of
+# order GTIDs (e.g. when replaying old mysqlbinlog output). mariadb-binlog
+# must not fail on such binary logs unless --gtid-strict-mode is explicitly
+# requested.
+#
+--source include/have_log_bin.inc
+
+RESET MASTER;
+CREATE TABLE t1 (a INT);
+CREATE TABLE t2 (a INT);
+DROP TABLE t1, t2;
+FLUSH BINARY LOGS;
+
+--exec $MYSQL_BINLOG --read-from-remote-server -uroot --protocol=tcp --port=$MASTER_MYPORT master-bin.000001 | $MYSQL test 2>&1
+
+DROP TABLE IF EXISTS t1, t2;
+FLUSH BINARY LOGS;
+
+--let $datadir= `SELECT @@datadir`
+
+--echo # Default (non-strict) mode must succeed
+--exec $MYSQL_BINLOG $datadir/master-bin.000001 $datadir/master-bin.000002 > $MYSQLTEST_VARDIR/tmp/mdev29803.sql
+
+--echo # Explicit --gtid-strict-mode must still detect the out of order GTID
+--error 1
+--exec $MYSQL_BINLOG --gtid-strict-mode $datadir/master-bin.000001 $datadir/master-bin.000002 > $MYSQLTEST_VARDIR/tmp/mdev29803.sql 2> $MYSQLTEST_VARDIR/tmp/mdev29803.err
+--let SEARCH_FILE=$MYSQLTEST_VARDIR/tmp/mdev29803.err
+--let SEARCH_PATTERN=ERROR: Found out of order GTID
+--source include/search_pattern_in_file.inc
+
+--remove_file $MYSQLTEST_VARDIR/tmp/mdev29803.sql
+--remove_file $MYSQLTEST_VARDIR/tmp/mdev29803.err
+
+--echo End of the tests
