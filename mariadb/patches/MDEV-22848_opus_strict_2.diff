diff --git a/sql/rpl_gtid.cc b/sql/rpl_gtid.cc
index 9004aea2..681ccfc5 100644
--- a/sql/rpl_gtid.cc
+++ b/sql/rpl_gtid.cc
@@ -699,6 +699,30 @@ rpl_slave_state::record_gtid(THD *thd, const rpl_gtid *gtid, uint64 sub_id,
   */
   suspended_wfc= thd->suspend_subsequent_commits();
   thd->lex->reset_n_backup_query_tables_list(&lex_backup);
+
+  /*
+    The option bits must be adjusted before the table is opened and locked.
+    The storage engine (eg. InnoDB) registers itself in the transaction
+    (THD::transaction->all) in external_lock() depending on
+    OPTION_NOT_AUTOCOMMIT / OPTION_BEGIN. If we are not in a transaction
+    (eg. SET GLOBAL gtid_slave_pos with autocommit=0), the update of the
+    gtid table is committed separately by the ha_commit_trans(thd, FALSE)
+    below. If the engine had been registered in the "all" transaction, it
+    would remain there after that commit, while the engine itself considers
+    its transaction as committed and deregistered. A later commit of the
+    user transaction would then call prepare/commit/savepoint for an engine
+    transaction that is not registered (MDEV-22848).
+  */
+  if (!in_transaction)
+  {
+    DBUG_PRINT("info", ("resetting OPTION_BEGIN"));
+    thd->variables.option_bits&=
+      ~(ulonglong)(OPTION_NOT_AUTOCOMMIT |OPTION_BEGIN |OPTION_BIN_LOG |
+                   OPTION_GTID_BEGIN);
+  }
+  else
+    thd->variables.option_bits&= ~(ulonglong)OPTION_BIN_LOG;
+
   tlist.init_one_table(&MYSQL_SCHEMA_NAME, &gtid_pos_table_name, NULL, TL_WRITE);
   if ((err= open_and_lock_tables(thd, &tlist, FALSE, 0)))
     goto end;
