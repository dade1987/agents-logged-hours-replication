diff --git a/sql/item_jsonfunc.cc b/sql/item_jsonfunc.cc
index cf5bb9be..a690d74e 100644
--- a/sql/item_jsonfunc.cc
+++ b/sql/item_jsonfunc.cc
@@ -4094,13 +4094,24 @@ void Item_func_json_arrayagg::cut_max_length(String *result,
   if (result->length() == 0)
     return;
 
-  if (result->ptr()[result->length() - 1] != '"' ||
-      max_length == 0)
+  if (result->ptr()[result->length() - 1] != '"')
   {
     Item_func_group_concat::cut_max_length(result, old_length, max_length);
     return;
   }
 
+  /*
+    The closing quote has to fit too. If there is no room left for
+    anything of the current row besides it, drop the whole row.
+    Note that max_length - 1 can be less than old_length here, so it must
+    not be passed down: the cut would go backwards and produce garbage.
+  */
+  if (max_length <= old_length + 1)
+  {
+    result->length(old_length);
+    return;
+  }
+
   Item_func_group_concat::cut_max_length(result, old_length, max_length-1);
   result->append('"');
 }
