-      json_skip_current_level(js, value);
+      json_skip_rest_of_level(js);
+      json_skip_rest_of_level(value);
       return FALSE;
     }
-    res= check_overlaps(js, value, true);
-    if (!res)
+    if (!check_overlaps(js, value, true))
     {
+      /* check_overlaps() has consumed the compared elements. */
       json_skip_current_level(js, value);
