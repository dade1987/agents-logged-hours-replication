-         js->state == JST_VALUE && value->state == JST_VALUE)
+  for (;;)
   {
+    bool js_end, value_end;
+
+    if (json_scan_next(js) || json_scan_next(value))
+      return FALSE;
+
+    js_end= js->state != JST_VALUE;
+    value_end= value->state != JST_VALUE;
+
+    if (js_end || value_end)
+    {
+      /*
+        At least one of the arrays is exhausted. The arrays are equal only
+        if both are exhausted. Otherwise skip the remaining elements of
+        the other array (the element is scanned but not read yet, so
+        skipping the current level consumes it and the array end).
+      */
+      if (!js_end)
+        json_skip_level(js);
+      if (!value_end)
+        json_skip_level(value);
+      return js_end && value_end;
+    }
+
     if (json_read_value(js) || json_read_value(value))
       return FALSE;
