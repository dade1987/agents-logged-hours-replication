+/*
+  Skip the rest of the array (or object) whose element has just been read
+  into the engine. If the element itself is a non-scalar, skip it first.
+*/
+static void json_skip_rest_of_level(json_engine_t *je)
+{
+  if (!json_value_scalar(je))
+    json_skip_level(je);
+  json_skip_level(je);
+}
+
