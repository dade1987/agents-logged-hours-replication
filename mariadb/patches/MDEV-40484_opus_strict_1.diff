diff --git a/sql/sql_view.cc b/sql/sql_view.cc
index ab2d4df9..638e2dd0 100644
--- a/sql/sql_view.cc
+++ b/sql/sql_view.cc
@@ -1061,6 +1061,27 @@ static int mysql_register_view(THD *thd, DDL_LOG_STATE *ddl_log_state,
   view->algorithm= lex->create_view->algorithm;
   view->definer.user= lex->definer->user;
   view->definer.host= lex->definer->host;
+  /*
+    definer_user and definer_host are stored in the view .frm file
+    unescaped, as \n-terminated values. A '\n' inside would make the
+    file ambiguous (allowing injection of arbitrary view parameters),
+    so such definers cannot be stored.
+  */
+  {
+    const LEX_CSTRING *bad= NULL;
+    if (view->definer.user.length &&
+        memchr(view->definer.user.str, '\n', view->definer.user.length))
+      bad= &view->definer.user;
+    else if (view->definer.host.length &&
+             memchr(view->definer.host.str, '\n', view->definer.host.length))
+      bad= &view->definer.host;
+    if (bad)
+    {
+      my_error(ER_WRONG_VALUE, MYF(0), "DEFINER", bad->str);
+      error= -1;
+      goto err;
+    }
+  }
   view->view_suid= lex->create_view->suid;
   view->with_check= lex->create_view->check;
 
