@@ -2047,4 +2047,40 @@ connection default;
 disconnect con1;
 drop user foo@localhost;
 drop schema foo;
+#
+# MDEV-40484 ambiguous view frm parsing when username includes \n
+#
+create user 'root
+definer_host=localhost
+suid=1'@localhost;
+grant all on test.* to 'root
+definer_host=localhost
+suid=1'@localhost;
+connect u,localhost,'root
+definer_host=localhost
+suid=1';
+select group_concat(user,'@',host) from mysql.global_priv;
+ERROR 42000: SELECT command denied to user 'root
+definer_host=localhost
+suid=1'@'localhost' for table `mysql`.`global_priv`
+create function f() returns text sql security invoker
+return (select group_concat(user,'@',host) from mysql.global_priv);
+create view v as select f();
+ERROR HY000: Incorrect DEFINER value: 'root
+definer_host=localhost
+suid=1'
+select * from v;
+ERROR 42S02: Table 'test.v' doesn't exist
+disconnect u;
+connection default;
+create definer='a\nb'@localhost view v as select 1;
+ERROR HY000: Incorrect DEFINER value: 'a
+b'
+create definer=a@'local\nhost' view v as select 1;
+ERROR HY000: Incorrect DEFINER value: 'local
+host'
+drop function f;
+drop user 'root
+definer_host=localhost
+suid=1'@localhost;
 # End of 10.6 tests
