 --echo # End of 10.5 tests
+
+--echo #
+--echo # MDEV-40470 GRANT PROXY with empty password incorrectly checks
+--echo #            grantor's privileges
+--echo #
+CREATE USER u1@localhost;
+CREATE USER u2@localhost IDENTIFIED BY 'oldpassword';
+GRANT ALL PRIVILEGES ON *.* TO u2@localhost WITH GRANT OPTION;
+show create user u2@localhost;
+connect u,localhost,u1;
+SHOW GRANTS;
+--error ER_DBACCESS_DENIED_ERROR
+GRANT PROXY ON u1@localhost TO u2@localhost IDENTIFIED VIA '' OR mysql_native_password USING PASSWORD('newpassword');
+--error ER_DBACCESS_DENIED_ERROR
+GRANT PROXY ON u1@localhost TO u2@localhost IDENTIFIED VIA '';
+--error ER_DBACCESS_DENIED_ERROR
+GRANT PROXY ON u1@localhost TO u2@localhost IDENTIFIED BY '';
+--error ER_DBACCESS_DENIED_ERROR
+GRANT PROXY ON u1@localhost TO u2@localhost IDENTIFIED BY 'newpassword';
+# granting proxy without touching authentication is still allowed
+GRANT PROXY ON u1@localhost TO u2@localhost;
+disconnect u;
+connection default;
+show create user u2@localhost;
+show grants for u2@localhost;
+drop user u1@localhost;
+drop user u2@localhost;
