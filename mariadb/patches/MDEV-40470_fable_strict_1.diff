+--echo # End of 10.6 tests
diff --git a/sql/sql_acl.cc b/sql/sql_acl.cc
index d4a7606d..f8d3b648 100644
--- a/sql/sql_acl.cc
+++ b/sql/sql_acl.cc
@@ -7131,8 +7131,18 @@ static bool copy_and_check_auth(LEX_USER *to, LEX_USER *from, THD *thd)
 {
   to->auth= from->auth;
 
-  // if changing auth for an existing user
-  if (has_auth(to, thd->lex) && find_user_exact(to->host.str, to->user.str))
+  /*
+    If changing auth for an existing user.
+    Any IDENTIFIED clause (even with an empty plugin/password, e.g.
+    IDENTIFIED VIA '' OR mysql_native_password USING PASSWORD('x') or
+    IDENTIFIED BY '') replaces the user's authentication data, so it must
+    be checked against the ALTER USER privilege (MDEV-40470).
+    LEX_USER::has_auth() only looks at the first USER_AUTH in the chain
+    and treats an empty one as "not specified", which is not what we
+    want here.
+  */
+  if ((to->auth || has_auth(to, thd->lex)) &&
+      find_user_exact(to->host.str, to->user.str))
   {
     mysql_mutex_unlock(&acl_cache->lock);
     bool res= check_alter_user(thd, to->host.str, to->user.str);
