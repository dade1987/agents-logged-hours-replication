diff --git a/sql/json_table.cc b/sql/json_table.cc
index e5ac6008..f32c25e7 100644
--- a/sql/json_table.cc
+++ b/sql/json_table.cc
@@ -384,6 +384,24 @@ static void store_json_in_field(Field *f, const json_engine_t *je)
     }
     break;
   }
+  case JSON_VALUE_NUMBER:
+    if (f->type() == MYSQL_TYPE_BIT)
+    {
+      /*
+        Storing the textual representation of a number into a BIT field
+        would store the raw bytes of the string (e.g. '0' is 0x30).
+        Convert the JSON number to an integer value instead.
+      */
+      char *end;
+      int err;
+      bool is_unsigned= !(je->num_flags & JSON_NUM_NEG);
+      ulonglong nr= je->s.cs->strntoull10rnd((const char *) je->value,
+                                             je->value_len, is_unsigned,
+                                             &end, &err);
+      f->store((longlong) nr, is_unsigned);
+      return;
+    }
+    break;
   default:
     break;
   };
