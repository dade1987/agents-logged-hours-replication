+/*
+  This class handles fields of a ROW SP variable whose structure is not
+  known at parse time, e.g.:
+    DECLARE r0 ROW TYPE OF t1;      -- or ROW TYPE OF cursor
+    SELECT a INTO r0.a FROM t1;
+  The field offset is resolved by name at run time.
+*/
+class my_var_sp_row_field_by_name: public my_var_sp
+{
+  const LEX_CSTRING m_field_name;
+public:
+  my_var_sp_row_field_by_name(const Lex_ident_sys_st &varname,
+                              const sp_rcontext_addr &varaddr,
+                              const Lex_ident_sys_st &field_name,
+                              sp_head *s)
+   :my_var_sp(varname, varaddr,
+              &type_handler_double/*Not really used*/, s),
+    m_field_name(field_name)
+  { }
+  bool check_assignability(THD *thd, const List<Item> &select_list,
+                           bool *assign_as_row) const override
+  {
+    *assign_as_row= false;
+    return select_list.elements != 1;
+  }
+  bool set(THD *thd, Item *item) override
+  {
+    sp_rcontext *ctx= get_rcontext(thd->spcont);
+    uint field_idx;
+    if (ctx->find_row_field_by_name_or_error(&field_idx, offset(),
+                                             m_field_name))
+      return true;
+    return ctx->set_variable_row_field(thd, offset(), field_idx, &item);
+  }
+};
