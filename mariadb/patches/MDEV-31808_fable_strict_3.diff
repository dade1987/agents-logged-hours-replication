diff --git a/sql/sql_base.cc b/sql/sql_base.cc
index 379337af..2e4fe5e4 100644
--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -4994,8 +4994,23 @@ bool open_and_lock_internal_tables(TABLE *table, bool lock_table)
   TABLE_LIST *tmp= table->internal_tables;
   DML_prelocking_strategy prelocking_strategy;
 
-  if (open_tables(thd, thd->lex->create_info, &tmp, &counter, 0,
-                  &prelocking_strategy))
+  /*
+    We use MYSQL_OPEN_IGNORE_FLUSH here as we may be called while the
+    statement already has tables open and locked, possibly in a state
+    where the TABLE_SHARE of one of them has been marked as flushed by
+    the statement itself (for example ALTER TABLE ... ALGORITHM=COPY,
+    LOCK=EXCLUSIVE calls wait_while_table_is_used(), which flushes the
+    table definition cache entry of the altered table before this
+    function is called for the new temporary table). Without this flag
+    open_table() would detect thd->open_tables->s->tdc->flushed and
+    request a back-off, closing and reopening all tables of the statement
+    behind the back of the caller (and the storage engines, which may
+    already have a statement transaction started), which leads to crashes.
+    Ignoring the flush is safe: the tables we open here are used only for
+    the duration of the statement and are protected by metadata locks.
+  */
+  if (open_tables(thd, thd->lex->create_info, &tmp, &counter,
+                  MYSQL_OPEN_IGNORE_FLUSH, &prelocking_strategy))
     goto err;
 
   if (lock_table)
