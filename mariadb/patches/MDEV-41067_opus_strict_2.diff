+/*
+  Compare two arrays element by element, in order. Both arrays must have
+  the same number of elements and the i-th element of the first array
+  must match the i-th element of the second one.
+
+  On return both engines are positioned at the end of their arrays
+  (unless a parse error occurred).
+*/
 bool json_compare_arrays_in_order(json_engine_t *js, json_engine_t *value)
 {
   bool res= false;
-  while (json_scan_next(js) == 0 && json_scan_next(value) == 0 &&
-         js->state == JST_VALUE && value->state == JST_VALUE)
+  const int js_level= json_get_level(js);
+  const int value_level= json_get_level(value);
+
+  for (;;)
   {
-    if (json_read_value(js) || json_read_value(value))
-      return FALSE;
-    if (js->value_type != value->value_type)
-    {
-      json_skip_current_level(js, value);
-      return FALSE;
-    }
-    res= check_overlaps(js, value, true);
-    if (!res)
+    if (json_scan_next(js) || json_scan_next(value))
+      goto end;
+    if (js->state != JST_VALUE || value->state != JST_VALUE)
     {
-      json_skip_current_level(js, value);
-      return FALSE;
+      /*
+        At least one of the arrays has ended. The arrays match only
+        if both of them have ended at the same time, i.e. they have
+        the same number of elements.
+      */
+      res= (js->state == JST_ARRAY_END && value->state == JST_ARRAY_END);
+      goto end;
     }
+    if (json_read_value(js) || json_read_value(value))
+      goto end;
+    if (js->value_type != value->value_type)
+      goto end;
+    if (!check_overlaps(js, value, true))
+      goto end;
   }
-  res= (value->state == JST_ARRAY_END || value->state == JST_OBJ_END ?
-        TRUE : FALSE);
-  json_skip_current_level(js, value);
+
+end:
+  /* Skip whatever is left of the arrays being compared. */
+  json_skip_to_level(js, js_level);
+  json_skip_to_level(value, value_level);
   return res;
 }
 
