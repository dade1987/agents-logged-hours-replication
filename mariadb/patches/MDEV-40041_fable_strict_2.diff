diff --git a/sql/sql_base.cc b/sql/sql_base.cc
index eabad770..1a376386 100644
--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -876,8 +876,18 @@ int close_thread_tables(THD *thd) noexcept
       /*
         For simple locking we cleanup it here because we don't close thread
         tables. For prelocking we close it when we do close thread tables.
+
+        If we are in prelocked mode under LOCK TABLES, the tables are not
+        closed either, so we have to clean up here too, but only when we
+        are closing tables for the top-level statement (the one that
+        entered prelocked mode, i.e. the one that requires prelocking).
+        A sub-statement (e.g. a statement inside a trigger body) must not
+        clean up the expressions as they are still in use by the top-level
+        statement (see MDEV-40041).
       */
-      if (thd->locked_tables_mode != LTM_PRELOCKED)
+      if (thd->locked_tables_mode == LTM_LOCK_TABLES ||
+          (thd->locked_tables_mode == LTM_PRELOCKED_UNDER_LOCK_TABLES &&
+           thd->lex->requires_prelocking()))
         table->vcol_cleanup_expr(thd);
     }
 
