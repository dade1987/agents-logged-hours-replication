diff --git a/storage/innobase/fts/fts0exec.cc b/storage/innobase/fts/fts0exec.cc
index 197eebc6..07ed79f9 100644
--- a/storage/innobase/fts/fts0exec.cc
+++ b/storage/innobase/fts/fts0exec.cc
@@ -764,6 +764,28 @@ dberr_t AuxRecordReader::default_word_processor(
   ulint ilist_len;
   const byte* ilist_data= rec_get_nth_field(rec, offsets, 6, &ilist_len);
 
+  /* A large ilist may be stored off-page. In that case
+  rec_get_nth_field() returns only the local prefix, which holds the
+  external reference, so the whole ilist must be fetched from the
+  external pages before it is copied into the node. */
+  mem_heap_t* ilist_heap= nullptr;
+  if (ilist_data && ilist_len != UNIV_SQL_NULL &&
+      rec_offs_nth_extern(offsets, 6))
+  {
+    ilist_heap= mem_heap_create(ilist_len + 1000);
+    ulint external_len;
+    const byte* external_ilist= btr_copy_externally_stored_field(
+      &external_len, ilist_data, index->table->space->zip_size(),
+      ilist_len, ilist_heap);
+    if (!external_ilist)
+    {
+      mem_heap_free(ilist_heap);
+      return DB_CORRUPTION;
+    }
+    ilist_data= external_ilist;
+    ilist_len= external_len;
+  }
+
   fts_word_t *word;
   bool is_word_init= false;
 
@@ -808,8 +830,13 @@ dberr_t AuxRecordReader::default_word_processor(
       node->ilist= static_cast<byte*>(ut_malloc_nokey(ilist_len));
       memcpy(node->ilist, ilist_data, ilist_len);
     }
-    if (ilist_len == 0) return DB_SUCCESS_LOCKED_REC;
+    if (ilist_len == 0)
+    {
+      if (ilist_heap) mem_heap_free(ilist_heap);
+      return DB_SUCCESS_LOCKED_REC;
+    }
   }
+  if (ilist_heap) mem_heap_free(ilist_heap);
 
   if (this->total_memory)
   {
