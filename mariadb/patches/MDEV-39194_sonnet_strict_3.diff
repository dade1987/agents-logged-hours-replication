+Field *
+Type_handler_hex_hybrid::make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
+                                                            const Item *item)
+                                                            const
+{
+  /*
+    Hex/bit literals are numbers in numeric context. Their max_length is
+    the length in bytes, so a DOUBLE field with that length would truncate
+    the value. Use an unsigned BIGINT field.
+  */
+  return new(mem_root)
+         Field_longlong(NULL, MAX_BIGINT_WIDTH,
+                        (uchar *) (item->maybe_null() ? "" : 0),
+                        item->maybe_null() ? 1 : 0, Field::NONE,
+                        &item->name, 0, true);
+}
+
