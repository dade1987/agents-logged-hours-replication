+SELECT id FROM t WHERE MATCH(txt) AGAINST('"zzzz" aut*' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"auth code" aut*' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('aut* "zzzz"' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"zzzz" +aut*' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"zzzz" auth' IN BOOLEAN MODE);
+SELECT id FROM t WHERE MATCH(txt) AGAINST('"zzzz" aut*' IN BOOLEAN MODE);
+DROP TABLE t;
diff --git a/storage/innobase/fts/fts0que.cc b/storage/innobase/fts/fts0que.cc
index b8f22076..afc11f86 100644
--- a/storage/innobase/fts/fts0que.cc
+++ b/storage/innobase/fts/fts0que.cc
@@ -2720,6 +2720,13 @@ fts_query_phrase_search(
 	mem_heap_t*		heap = mem_heap_create(sizeof(fts_string_t));
 	ib_alloc_t*		heap_alloc;
 	ulint			num_token;
+	/* The query flags are temporarily overridden with FTS_PHRASE
+	or FTS_PROXIMITY while the phrase is being searched; they must
+	be restored afterwards, otherwise subsequent terms of the same
+	query (e.g. a wildcard term following the phrase) would be
+	processed as if they were part of a phrase and would not be
+	looked up in the FTS index cache. */
+	const ulint		saved_flags = query->flags;
 
 	heap_alloc = ib_heap_allocator_create(heap);
 
@@ -2893,6 +2900,9 @@ fts_query_phrase_search(
 	/* Don't need it anymore. */
 	query->matched = NULL;
 
+	/* Restore the original query flags. */
+	query->flags = saved_flags;
+
 	return(query->error);
 }
 
