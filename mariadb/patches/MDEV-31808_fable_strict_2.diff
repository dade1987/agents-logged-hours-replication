@@ -4994,8 +4994,17 @@ bool open_and_lock_internal_tables(TABLE *table, bool lock_table)
   TABLE_LIST *tmp= table->internal_tables;
   DML_prelocking_strategy prelocking_strategy;
 
-  if (open_tables(thd, thd->lex->create_info, &tmp, &counter, 0,
-                  &prelocking_strategy))
+  /*
+    We may already have tables opened and locked by the current statement
+    (for example ALTER TABLE ... LOCK=EXCLUSIVE has called
+    wait_while_table_is_used() which marked the share of the altered table
+    as flushed). open_tables() must not back off and close all tables
+    opened so far in that case, as the caller keeps using them and
+    thd->lock; thus ignore flush requests here. MDL locks on the internal
+    tables are still taken as usual.
+  */
+  if (open_tables(thd, thd->lex->create_info, &tmp, &counter,
+                  MYSQL_OPEN_IGNORE_FLUSH, &prelocking_strategy))
     goto err;
 
   if (lock_table)
@@ -5004,7 +5013,13 @@ bool open_and_lock_internal_tables(TABLE *table, bool lock_table)
