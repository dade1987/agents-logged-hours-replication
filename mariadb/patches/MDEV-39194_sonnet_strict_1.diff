+Field *
+Type_handler_hex_hybrid::make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
+                                                            const Item *item)
+                                                            const
+{
+  /*
+    Hex/bit literals are numbers in numeric context, but item->max_length is
+    the length in bytes, which must not limit the value (e.g. b'1100').
+  */
+  return new(mem_root)
+         Field_longlong(NULL, MY_INT64_NUM_DECIMAL_DIGITS,
+                        (uchar *) (item->maybe_null() ? "" : 0),
+                        item->maybe_null() ? 1 : 0, Field::NONE,
+                        &item->name, 0, true);
+}
+
