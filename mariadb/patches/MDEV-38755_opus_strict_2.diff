diff --git a/mysql-test/main/spatial_utility_function_collect.result b/mysql-test/main/spatial_utility_function_collect.result
index cd3b3885..cf7aa57c 100644
--- a/mysql-test/main/spatial_utility_function_collect.result
+++ b/mysql-test/main/spatial_utility_function_collect.result
@@ -260,3 +260,26 @@ DROP TABLE t1;
 #
 SELECT 1 FROM dual WHERE group_concat(1, 1);
 ERROR HY000: Invalid use of group function
+#
+# MDEV-38755 ST_COLLECT(1) IS NULL is false
+#
+SELECT ST_COLLECT(1), ST_COLLECT(1) IS NULL, ST_COLLECT(1) IS NOT NULL;
+ST_COLLECT(1)	ST_COLLECT(1) IS NULL	ST_COLLECT(1) IS NOT NULL
+NULL	1	0
+SELECT ST_COLLECT(NULL) IS NULL, ST_COLLECT(POINT(1,1)) IS NULL;
+ST_COLLECT(NULL) IS NULL	ST_COLLECT(POINT(1,1)) IS NULL
+1	0
+CREATE TABLE t1 (a int, p point);
+INSERT INTO t1 VALUES (1, NULL), (2, POINT(1,1));
+SELECT a, ST_COLLECT(p) IS NULL FROM t1 GROUP BY a;
+a	ST_COLLECT(p) IS NULL
+1	1
+2	0
+SELECT ST_COLLECT(p) IS NULL FROM t1 WHERE a=1;
+ST_COLLECT(p) IS NULL
+1
+SELECT ST_COLLECT(p) IS NULL FROM t1;
+ST_COLLECT(p) IS NULL
+0
+DROP TABLE t1;
+# End of 12.2 tests
