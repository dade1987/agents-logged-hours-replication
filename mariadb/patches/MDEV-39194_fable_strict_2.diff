+Field *
+Type_handler_hex_hybrid::make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
+                                                            const Item *item)
+                                                            const
+{
+  /*
+    In a numeric context (e.g. SUM(DISTINCT 0x0C) or SUM(DISTINCT b'1100'))
+    a hex hybrid literal behaves as an unsigned integer. Don't use the
+    default Field_double: it would be created with the string octet length
+    of the literal (e.g. 1) as the field length, so the integer value
+    would be truncated by Field_double::store() (e.g. 12 -> 9).
+  */
+  return new(mem_root)
+         Field_longlong(NULL, MAX_BIGINT_WIDTH,
+                        (uchar *) (item->maybe_null() ? "" : 0),
+                        item->maybe_null() ? 1 : 0, Field::NONE,
+                        &item->name, 0, true);
+}
+
+
 bool Type_handler_hex_hybrid::
        Item_hybrid_func_fix_attributes(THD *thd,
                                        const LEX_CSTRING &func_name,
