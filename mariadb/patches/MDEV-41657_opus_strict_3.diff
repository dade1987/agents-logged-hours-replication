+--echo #
+--echo # MDEV-41657 TO_DATE no longer works as a variable
+--echo #
+
+SET sql_mode=DEFAULT;
+CREATE TABLE t1 (to_date INT);
+INSERT INTO t1 (to_date) VALUES (1);
+SELECT to_date FROM t1;
+DROP TABLE t1;
+SELECT 1 AS to_date;
+
+DELIMITER $$;
+CREATE PROCEDURE p1()
+BEGIN
+  DECLARE to_date DATE DEFAULT '2001-01-01';
+  SELECT to_date;
+END;
+$$
+DELIMITER ;$$
+CALL p1();
+DROP PROCEDURE p1;
+
+SET sql_mode=ORACLE;
+DELIMITER $$;
+DECLARE
+  to_date DATE := TO_DATE('2001-01-01', 'YYYY-MM-DD');
+BEGIN
+  SELECT to_date FROM DUAL;
+END;
+$$
+DELIMITER ;$$
+SET sql_mode=DEFAULT;
+
