diff --git a/sql/spatial.cc b/sql/spatial.cc
index d1ed5bb8..06c8b761 100644
--- a/sql/spatial.cc
+++ b/sql/spatial.cc
@@ -3320,6 +3320,21 @@ bool Gis_geometry_collection::init_from_wkt(Gis_read_stream *trs, String *wkb)
     {
       for (;;)
       {
+        LEX_STRING name;
+        Class_info *ci;
+        /*
+          Nested GEOMETRYCOLLECTION is not allowed. Check this before
+          parsing the next geometry, otherwise a deeply nested collection
+          would cause unbounded recursion and a stack overrun.
+        */
+        if (trs->next_symbol() && !trs->lookup_next_word(&name) &&
+            (ci= find_class(name.str, name.length)) &&
+            ci->m_type_id == wkb_geometrycollection)
+        {
+          trs->set_error_msg("Unexpected GEOMETRYCOLLECTION");
+          return 1;
+        }
+
         if (!(g= create_from_wkt(&buffer, trs, wkb)))
           return 1;
 
