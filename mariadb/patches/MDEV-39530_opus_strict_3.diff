+--echo # End of 10.3 tests
+
+--echo #
+--echo # MDEV-39530 Collation mix issue after update
+--echo #
+
+SET NAMES utf8mb3 COLLATE utf8mb3_uca1400_ai_ci;
+CREATE TABLE t1 (id INT PRIMARY KEY, path VARCHAR(800) NOT NULL DEFAULT '')
+  CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci;
+INSERT INTO t1 VALUES (1,'text');
+SELECT IF((@p:=(SELECT path FROM t1 WHERE id=1 AND path REGEXP '^xx'))!='',1,2) AS c1;
+SELECT IF((@p:=(SELECT path FROM t1 WHERE id=1))!='',1,2) AS c1;
+SELECT (@p:=path)='TEXT' AS c1, COLLATION(@p:=path) AS c2, COERCIBILITY(@p:=path) AS c3 FROM t1;
+SELECT COERCIBILITY(@p:='a'), COERCIBILITY(@p:=NULL), COERCIBILITY(@p:=1);
+DROP TABLE t1;
+SET NAMES DEFAULT;
+
+--echo # End of 12.3 tests
diff --git a/sql/item_func.cc b/sql/item_func.cc
index 07b811eb..6761c82e 100644
--- a/sql/item_func.cc
+++ b/sql/item_func.cc
@@ -4849,9 +4849,15 @@ bool Item_func_set_user_var::fix_fields(THD *thd, Item **ref)
   if (!m_var_entry->charset() || !null_item)
     m_var_entry->set_charset(args[0]->collation.derivation == DERIVATION_NUMERIC ?
                              &my_charset_numeric : args[0]->collation.collation);
+  /*
+    Use DERIVATION_USERVAR, like Item_func_get_user_var does, so that
+    the result of "@a:=expr" has the same derivation as a later "@a".
+    DERIVATION_COERCIBLE caused "Illegal mix of collations" when
+    compared to a string literal (MDEV-39530).
+  */
   collation.set(m_var_entry->charset(),
                 args[0]->collation.derivation == DERIVATION_NUMERIC ?
-                DERIVATION_NUMERIC : DERIVATION_COERCIBLE);
+                DERIVATION_NUMERIC : DERIVATION_USERVAR);
   switch (args[0]->result_type()) {
   case STRING_RESULT:
   case TIME_RESULT:
@@ -4916,7 +4922,7 @@ Item_func_set_user_var::fix_length_and_dec(THD *thd)
   }
   else
   {
-    collation.set(DERIVATION_COERCIBLE);
+    collation.set(DERIVATION_USERVAR);
     fix_length_and_charset(args[0]->max_char_length(),
                            args[0]->collation.collation);
   }
