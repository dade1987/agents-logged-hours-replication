diff --git a/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_strict_mode_default.test b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_strict_mode_default.test
new file mode 100644
index 00000000..3014871e
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_mysqlbinlog_gtid_strict_mode_default.test
@@ -0,0 +1,57 @@
+#
+# Purpose:
+#
+# MDEV-29803: Unexpected ERROR: Found out of order GTID after replaying binlog
+#             read from remote
+#
+# The output of mariadb-binlog contains SET @@session.gtid_seq_no statements,
+# so replaying it into the very server the binlog was read from re-uses the
+# original GTIDs and makes the server (whose gtid_strict_mode is off by
+# default) write out of order GTIDs into its next binary log. A subsequent
+# mariadb-binlog invocation on those logs must not fail: gtid-strict-mode of
+# mariadb-binlog is off by default, consistently with the server, and the out
+# of order GTIDs are only reported when --gtid-strict-mode is given explicitly.
+#
+# References:
+#   MDEV-4989: Support for GTID in mysqlbinlog
+#   MDEV-29803: Unexpected ERROR: Found out of order GTID after replaying
+#               binlog read from remote
+#
+--source include/have_log_bin.inc
+
+reset master;
+create table t1 (a int);
+create table t2 (a int);
+drop table t1, t2;
+flush binary logs;
+
+--echo # Replay the first binlog, read from the remote server, into the server
+--exec $MYSQL_BINLOG --read-from-remote-server -uroot --protocol=tcp --port=$MASTER_MYPORT master-bin.000001 | $MYSQL test 2>&1
+
+drop table if exists t1, t2;
+flush binary logs;
+
+--let $datadir= `select @@datadir`
+--let $assert_file= $MYSQLTEST_VARDIR/tmp/binlog_mysqlbinlog_gtid_strict_mode_default.out
+
+--echo # By default mariadb-binlog must succeed and report nothing about the
+--echo # out of order GTIDs
+--exec $MYSQL_BINLOG $datadir/master-bin.000001 $datadir/master-bin.000002 > $assert_file 2>&1
+--let SEARCH_FILE= $assert_file
+--let SEARCH_PATTERN= (ERROR|WARNING): Found out of order GTID
+--source include/search_pattern_in_file.inc
+
+--echo # With --gtid-strict-mode the out of order GTID must be reported as error
+--error 1
+--exec $MYSQL_BINLOG --gtid-strict-mode $datadir/master-bin.000001 $datadir/master-bin.000002 > $assert_file 2>&1
+--let SEARCH_PATTERN= ERROR: Found out of order GTID. Got 0-1-1 after 0-1-3
+--source include/search_pattern_in_file.inc
+
+--echo # With --skip-gtid-strict-mode -vvv the out of order GTIDs must be
+--echo # reported as warnings, and the run must succeed
+--exec $MYSQL_BINLOG --skip-gtid-strict-mode -vvv $datadir/master-bin.000001 $datadir/master-bin.000002 > $assert_file 2>&1
+--let SEARCH_PATTERN= WARNING: Found out of order GTID. Got 0-1-1 after 0-1-3
+--source include/search_pattern_in_file.inc
+
+--remove_file $assert_file
+--echo End of the tests
