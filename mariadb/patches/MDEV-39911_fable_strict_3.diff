@@ -538,3 +538,22 @@ ST_SIMPLIFY(ST_GEOMFROMTEXT('POLYGON((10 2,5 2,5 10,-5 10,-5 2,-10 2,-10 -2,-5 -
 'global_status')
 ORDER BY TABLE_SCHEMA + 2 DESC, TABLE_NAME, ORDINAL_POSITION,
 (SELECT COLUMN_NAME ORDER BY 1);
+
+--echo #
+--echo # MDEV-39911 MariaDB crash triggered by ST_CONVEXHULL and ST_SIMPLIFY
+--echo #           string concatenation
+--echo #
+
+# CONCAT_WS evaluates its separator into a String with a small stack buffer.
+# The simplify methods reserved fewer bytes than they wrote with q_append,
+# which overflowed that buffer.
+SELECT LENGTH(CONCAT_WS(ST_SIMPLIFY(ST_GEOMFROMTEXT('MULTILINESTRING((0 0,5 5,0 10),(0 0,-5 5,0 10))'), 5), 7, 5)) AS l;
+SELECT ST_ASTEXT(ST_SIMPLIFY(ST_GEOMFROMTEXT('MULTILINESTRING((0 0,5 5,0 10),(0 0,-5 5,0 10))'), 5)) AS g;
+SELECT LENGTH(CONCAT_WS(ST_SIMPLIFY(ST_GEOMFROMTEXT('LINESTRING(0 0,5 5,0 10)'), 5), 7, 5)) AS l;
+SELECT LENGTH(CONCAT_WS(ST_SIMPLIFY(ST_GEOMFROMTEXT('POLYGON((0 0,0 10,10 10,10 0,0 0))'), 1), 7, 5)) AS l;
+SELECT LENGTH(CONCAT_WS(ST_SIMPLIFY(ST_GEOMFROMTEXT('MULTIPOLYGON(((0 0,0 10,10 10,10 0,0 0)))'), 1), 7, 5)) AS l;
+SELECT LENGTH(CONCAT_WS(ST_SIMPLIFY(ST_GEOMFROMTEXT('GEOMETRYCOLLECTION(POINT(1 1))'), 1), 7, 5)) AS l;
+
+--echo #
+--echo # End of 11.8 tests
+--echo #
