diff --git a/sql/item_jsonfunc.cc b/sql/item_jsonfunc.cc
index cf5bb9be..9b0a642b 100644
--- a/sql/item_jsonfunc.cc
+++ b/sql/item_jsonfunc.cc
@@ -4101,6 +4101,22 @@ void Item_func_json_arrayagg::cut_max_length(String *result,
     return;
   }
 
+  /*
+    The value is a JSON string. To keep a well-formed prefix of it we need
+    room for the separator (if this is not the first value), the opening
+    quote and the closing quote that is appended below. If there is no such
+    room, max_length - 1 can be smaller than old_length and
+    Item_func_group_concat::cut_max_length() would be called with an
+    end pointer before the start pointer, producing garbage. In that case
+    drop the whole value (together with the separator) instead.
+  */
+  uint sep_length= old_length ? (uint) separator->length() : 0;
+  if (max_length < old_length + sep_length + 2)
+  {
+    result->length(old_length);
+    return;
+  }
+
   Item_func_group_concat::cut_max_length(result, old_length, max_length-1);
   result->append('"');
 }
