diff --git a/sql/set_var.cc b/sql/set_var.cc
index 4fe16d54..a93c6cac 100644
--- a/sql/set_var.cc
+++ b/sql/set_var.cc
@@ -1031,6 +1031,16 @@ int set_var_authorization::check(THD *thd)
   else
   if (thd->in_active_multi_stmt_transaction())
     my_error(ER_CANT_SET_IN_TRANSACTION, MYF(0), "SESSION AUTHORIZATION");
+  else
+  if (thd->security_ctx->password_expired)
+  {
+    /*
+      A user with an expired password must not be able to escape the
+      sandbox mode (and get a fresh, un-expired security context)
+      by re-authorizing as itself or as any other user.
+    */
+    my_error(ER_MUST_CHANGE_PASSWORD, MYF(0));
+  }
   else
     return 0;
 
