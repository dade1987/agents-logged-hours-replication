+
+
+bool sp_revoke_privileges(THD *thd, const char *sp_db, const char *sp_name,
+                          const Sp_handler *sph)
+{
+  int result;
+  Silence_routine_definer_errors error_handler;
+  DBUG_ENTER("sp_revoke_privileges");
+
+  Grant_tables tables;
+  const uint tables_to_open= Table_user | Table_db | Table_tables_priv |
+                             Table_columns_priv | Table_procs_priv |
+                             Table_proxies_priv | Table_roles_mapping;
+  if ((result= tables.open_and_lock(thd, tables_to_open, TL_WRITE)))
+    DBUG_RETURN(result != 1);
+
+  DBUG_ASSERT(!thd->is_current_stmt_binlog_format_row());
+
+  /* Be sure to pop this before exiting this scope! */
+  thd->push_internal_handler(&error_handler);
+
+  mysql_rwlock_wrlock(&LOCK_grant);
+  mysql_mutex_lock(&acl_cache->lock);
+
+  sp_revoke_privileges_from_hash(thd, tables.procs_priv_table().table(),
+                                 sp_db, sp_name, sph);
+  /*
+    "DROP PACKAGE pkg" implicitly performs "DROP PACKAGE BODY pkg",
+    so privileges granted on the PACKAGE BODY must be revoked as well.
+  */
+  if (sph->type() == SP_TYPE_PACKAGE)
+    sp_revoke_privileges_from_hash(thd, tables.procs_priv_table().table(),
+                                   sp_db, sp_name, &sp_handler_package_body);
 
   mysql_mutex_unlock(&acl_cache->lock);
   mysql_rwlock_unlock(&LOCK_grant);
