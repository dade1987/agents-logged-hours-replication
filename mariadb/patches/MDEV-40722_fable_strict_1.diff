+
+DELIMITER $$;
+CREATE PACKAGE pkg1 AS
+  FUNCTION f RETURN VARCHAR2(64);
+END
+$$
+CREATE PACKAGE BODY pkg1 AS
+  FUNCTION f RETURN VARCHAR2(64) AS
+    BEGIN RETURN 'benign';
+  END;
+END
+$$
