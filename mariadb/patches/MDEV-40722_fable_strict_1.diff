+SELECT host,db,user,routine_name,routine_type,proc_priv FROM mysql.procs_priv ORDER BY routine_type;
+DROP PACKAGE pkg1;
+SELECT host,db,user,routine_name,routine_type,proc_priv FROM mysql.procs_priv ORDER BY routine_type;
+SHOW GRANTS FOR reader@localhost;
+DROP USER reader@localhost;
