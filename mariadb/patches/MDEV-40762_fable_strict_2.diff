+               final),
+  key idx_desc (interval_id, exchange_id, base_asset, quote_asset,
+                open_time desc),
+  key idx_desc_final (interval_id, exchange_id, base_asset, quote_asset,
+                      open_time desc, final)
+) engine=innodb default charset=utf8mb4 collate=utf8mb4_bin;
