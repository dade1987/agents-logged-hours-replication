+#
+# MDEV-40762 Wrong MAX() result with GROUP BY when loose index scan
+#            uses DESC key part
+#
+# The MIN/MAX argument column is ASC in one index and DESC in another.
+# The key part (and thus the ASC/DESC flag used by the loose index scan)
+# must belong to the index that was actually chosen.
+create table t1 (a int not null, b int not null,
+key k_asc (a, b), key k_desc (a, b desc));
+insert into t1 values (1,1),(1,2),(1,3),(2,10),(2,20),(2,30),(3,5);
+explain select a, max(b) from t1 group by a;
+id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
+1	SIMPLE	t1	range	NULL	k_asc	4	NULL	#	Using index for group-by
+select a, max(b) from t1 group by a;
+a	max(b)
+1	3
+2	30
+3	5
+explain select a, min(b) from t1 group by a;
+id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
+1	SIMPLE	t1	range	NULL	k_asc	4	NULL	#	Using index for group-by
+select a, min(b) from t1 group by a;
+a	min(b)
+1	1
+2	10
+3	5
+explain select a, min(b), max(b) from t1 group by a;
+id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
+1	SIMPLE	t1	range	NULL	k_asc	4	NULL	#	Using index for group-by
+select a, min(b), max(b) from t1 group by a;
+a	min(b)	max(b)
+1	1	3
+2	10	30
+3	5	5
+drop table t1;
+create table t1 (a int not null, b int not null,
+key k_desc (a, b desc), key k_asc (a, b));
+insert into t1 values (1,1),(1,2),(1,3),(2,10),(2,20),(2,30),(3,5);
+explain select a, max(b) from t1 group by a;
+id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
+1	SIMPLE	t1	range	NULL	k_desc	4	NULL	#	Using index for group-by
+select a, max(b) from t1 group by a;
+a	max(b)
+1	3
+2	30
+3	5
+explain select a, min(b) from t1 group by a;
+id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
+1	SIMPLE	t1	range	NULL	k_desc	4	NULL	#	Using index for group-by
+select a, min(b) from t1 group by a;
+a	min(b)
+1	1
+2	10
+3	5
+drop table t1;
+create table t (
+interval_id char(4) not null,
+exchange_id varchar(32) not null,
+base_asset varchar(15) not null,
+quote_asset varchar(15) not null,
+open_time datetime not null,
+symbol varchar(30) not null,
+final char(1) not null default 'Y',
+primary key (interval_id, exchange_id, base_asset, quote_asset, open_time,
+symbol),
+key idx_asc (interval_id, exchange_id, base_asset, quote_asset, open_time,
+final),
+key idx_desc (interval_id, exchange_id, base_asset, quote_asset,
+open_time desc),
+key idx_desc_final (interval_id, exchange_id, base_asset, quote_asset,
+open_time desc, final)
+) engine=innodb default charset=utf8mb4 collate=utf8mb4_bin;
+insert into t (interval_id, exchange_id, base_asset, quote_asset, open_time,
+symbol)
+select '1M', 'binance', 'BTC', 'USDT', '2026-01-01' + interval seq month,
