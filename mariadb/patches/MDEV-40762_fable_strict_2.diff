+       'BTCUSDT' from seq_0_to_5;
+insert into t (interval_id, exchange_id, base_asset, quote_asset, open_time,
+               symbol)
+select '1M', 'binance', 'ETH', 'USDT', '2026-01-01' + interval seq month,
+       'ETHUSDT' from seq_0_to_3;
+insert into t (interval_id, exchange_id, base_asset, quote_asset, open_time,
+               symbol)
+select '1M', 'kraken', 'BTC', 'USD', '2026-01-01' + interval seq month,
+       'BTCUSD' from seq_0_to_2;
+
+select interval_id, exchange_id, base_asset, quote_asset,
+       max(open_time) as open_time_max
+from t
+where exchange_id = 'binance'
+group by interval_id, exchange_id, base_asset, quote_asset;
+
+select a.interval_id, a.exchange_id, a.base_asset, a.quote_asset,
+       a.open_time, b.open_time_max
+from t as a
+join (
+  select interval_id, exchange_id, base_asset, quote_asset,
+         max(open_time) as open_time_max
+  from t
+  where exchange_id = 'binance'
+  group by interval_id, exchange_id, base_asset, quote_asset
+) as b
+  on a.interval_id = b.interval_id
+ and a.exchange_id = b.exchange_id
+ and a.base_asset = b.base_asset
+ and a.quote_asset = b.quote_asset
+ and a.open_time = b.open_time_max
+order by a.base_asset;
+
+drop table t;
