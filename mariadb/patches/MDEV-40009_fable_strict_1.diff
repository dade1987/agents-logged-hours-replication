diff --git a/sql/sys_vars.inl b/sql/sys_vars.inl
index 0f8aa1eb..0251e629 100644
--- a/sql/sys_vars.inl
+++ b/sql/sys_vars.inl
@@ -3099,9 +3099,28 @@ class Sys_var_path: public sys_var
 
   static bool from_item(THD *thd, Sql_path *path, Item *item)
   {
+    /*
+      Sql_path::from_text() parses the value as utf8mb3 (the identifier
+      character set). Convert the value to utf8mb3 if needed. Note that
+      val_str_ascii() is not sufficient here, as for a non-ASCII-compatible
+      character set (e.g. swe7) it converts to latin1, which would then be
+      misinterpreted as utf8mb3 (MDEV-40009).
+    */
+    CHARSET_INFO *cs= &my_charset_utf8mb3_general_ci;
+    StringBuffer<STRING_BUFFER_USUAL_SIZE> tmp;
     String *value, buffer;
-    if (!(value= item->val_str_ascii(&buffer)))
+    if (!(value= item->val_str(&tmp)))
       return true;
+    uint32 unused;
+    if (String::needs_conversion(value->length(), value->charset(),
+                                 cs, &unused))
+    {
+      uint errors;
+      if (buffer.copy(value->ptr(), value->length(), value->charset(),
+                      cs, &errors))
+        return true;
+      value= &buffer;
+    }
     return path->from_text(thd->variables, value);
   }
 
