diff --git a/mysql-test/suite/innodb_gis/r/rtree_search_lock_wait.result b/mysql-test/suite/innodb_gis/r/rtree_search_lock_wait.result
new file mode 100644
index 00000000..9d06ce27
--- /dev/null
+++ b/mysql-test/suite/innodb_gis/r/rtree_search_lock_wait.result
@@ -0,0 +1,25 @@
+#
+# MDEV-40404 void buf_page_t::init(uint32_t, page_id_t):
+# Assertion `!lock.is_locked_or_waiting()' failed
+#
+CREATE TABLE t1 (
+id INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
+pt POINT NOT NULL,
+SPATIAL INDEX(pt)
+) ENGINE=InnoDB;
+INSERT INTO t1 (pt) VALUES (ST_GeomFromText('POINT(1 1)'));
+connect  con1,localhost,root,,test;
+BEGIN;
+INSERT INTO t1 (pt) VALUES (ST_GeomFromText('POINT(2 2)'));
+connect  con2,localhost,root,,test;
+SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
+SELECT id, ST_AsText(pt) FROM t1 WHERE ST_Within(pt, ST_GeomFromText('POLYGON((0 0, 100 0, 100 100, 0 100, 0 0))')) ORDER BY id;
+connection con1;
+ROLLBACK;
+connection con2;
+id	ST_AsText(pt)
+1	POINT(1 1)
+connection default;
+disconnect con1;
+disconnect con2;
+DROP TABLE t1;
diff --git a/mysql-test/suite/innodb_gis/t/rtree_search_lock_wait.test b/mysql-test/suite/innodb_gis/t/rtree_search_lock_wait.test
new file mode 100644
index 00000000..ad497333
--- /dev/null
+++ b/mysql-test/suite/innodb_gis/t/rtree_search_lock_wait.test
@@ -0,0 +1,43 @@
+--source include/have_innodb.inc
+--source include/count_sessions.inc
+
+--echo #
+--echo # MDEV-40404 void buf_page_t::init(uint32_t, page_id_t):
+--echo # Assertion `!lock.is_locked_or_waiting()' failed
+--echo #
+
+CREATE TABLE t1 (
+  id INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
+  pt POINT NOT NULL,
+  SPATIAL INDEX(pt)
+) ENGINE=InnoDB;
+
+INSERT INTO t1 (pt) VALUES (ST_GeomFromText('POINT(1 1)'));
+
+--connect (con1,localhost,root,,test)
+BEGIN;
+INSERT INTO t1 (pt) VALUES (ST_GeomFromText('POINT(2 2)'));
+
+--connect (con2,localhost,root,,test)
+SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
+--send SELECT id, ST_AsText(pt) FROM t1 WHERE ST_Within(pt, ST_GeomFromText('POLYGON((0 0, 100 0, 100 100, 0 100, 0 0))')) ORDER BY id
+
+--connection con1
+# Wait until the SELECT is blocked by the uncommitted INSERT
+let $wait_condition=
+  SELECT COUNT(*) = 1 FROM information_schema.innodb_trx
+  WHERE trx_state = 'LOCK WAIT';
+--source include/wait_condition.inc
+ROLLBACK;
+
+# The SELECT must now re-scan the page while holding a latch on
+# its private copy of the page.
+--connection con2
+--reap
+
+--connection default
+--disconnect con1
+--disconnect con2
+DROP TABLE t1;
+
+--source include/wait_until_count_sessions.inc
