diff --git a/storage/heap/hp_rnext.c b/storage/heap/hp_rnext.c
index a07d8fae..53b9c6fc 100644
--- a/storage/heap/hp_rnext.c
+++ b/storage/heap/hp_rnext.c
@@ -57,6 +57,21 @@ int heap_rnext(HP_INFO *info, uchar *record)
                             offsetof(TREE_ELEMENT, left),
                             offsetof(TREE_ELEMENT, right));
     }
+    else if (info->lastkey_is_found)
+    {
+      /*
+        The previously found key (with the row pointer) is saved in lastkey.
+        The row was deleted, so restart the search from that key, not from
+        the original search key, and take the first key after it.
+      */
+      custom_arg.keyseg = keyinfo->seg;
+      custom_arg.key_length = info->lastkey_len;
+      custom_arg.search_flag = SEARCH_SAME;
+      info->last_find_flag= HA_READ_AFTER_KEY;
+      pos= tree_search_key(&keyinfo->rb_tree, info->lastkey, info->parents,
+                           &info->last_pos, HA_READ_AFTER_KEY, &custom_arg);
+      info->key_version= info->s->key_version;
+    }
     else if (!info->lastkey_len)
     {
       /*
@@ -92,7 +107,12 @@ int heap_rnext(HP_INFO *info, uchar *record)
     }
     if (pos)
     {
-      memcpy(&pos, pos + keyinfo->get_key_length(keyinfo, pos), sizeof(uchar*));
+      /* Remember the found key, to be able to restart after a DELETE */
+      uint key_len= keyinfo->get_key_length(keyinfo, pos);
+      memcpy(info->lastkey, pos, key_len + sizeof(uchar*));
+      info->lastkey_len= key_len;
+      info->lastkey_is_found= 1;
+      memcpy(&pos, pos + key_len, sizeof(uchar*));
       info->current_ptr = pos;
     }
     else
