diff --git a/mysql-test/suite/plugins/t/server_audit_reinstall.test b/mysql-test/suite/plugins/t/server_audit_reinstall.test
new file mode 100644
index 00000000..f5ef5411
--- /dev/null
+++ b/mysql-test/suite/plugins/t/server_audit_reinstall.test
@@ -0,0 +1,36 @@
+--source include/not_embedded.inc
+
+if (!$SERVER_AUDIT_SO) {
+  skip No SERVER_AUDIT plugin;
+}
+
+--echo #
+--echo # MDEV-34074 plugins.thread_pool_server_audit crashes in get_loc_info()
+--echo #            with null pointer dereference
+--echo #
+
+install plugin server_audit soname 'server_audit';
+# The plugin is referenced by this connection, so the uninstall only marks
+# it as deleted. It is reaped (and the global value of its thread-local
+# variables freed) when this connection releases it at the next statement.
+--disable_warnings
+uninstall plugin server_audit;
+--enable_warnings
+select 1;
+
+# A new connection that copies the global dynamic (plugin) variables into
+# its session while server_audit is not loaded gets a NULL copy of
+# server_audit's thread-local variable.
+connect (con1,localhost,root,,);
+show session variables like 'no_such_variable';
+# Installing the plugin again must re-initialize the session copy;
+# the audit event emitted for this statement used to dereference NULL.
+install plugin server_audit soname 'server_audit';
+select 1;
+set global server_audit_logging=off;
+disconnect con1;
+connection default;
+--disable_warnings
+uninstall plugin server_audit;
+--enable_warnings
+select 1;
