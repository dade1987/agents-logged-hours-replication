diff --git a/plugin/type_xmltype/sql_type_xmltype.cc b/plugin/type_xmltype/sql_type_xmltype.cc
index 0dd2e1ab..77de9cf6 100644
--- a/plugin/type_xmltype/sql_type_xmltype.cc
+++ b/plugin/type_xmltype/sql_type_xmltype.cc
@@ -170,6 +170,34 @@ const Type_handler *Type_handler_xmltype::
 }
 
 
+/*
+  Numeric aggregate functions (SUM, AVG, VARIANCE/STDDEV) do not make
+  sense for XMLTYPE. Raise an error instead of silently converting
+  the XML text to a number (which would truncate everything to 0).
+*/
+bool Type_handler_xmltype::
+  Item_sum_sum_fix_length_and_dec(Item_sum_sum *item) const
+{
+  LEX_CSTRING name= {STRING_WITH_LEN("sum") };
+  return Item_func_or_sum_illegal_param(name);
+}
+
+
+bool Type_handler_xmltype::
+  Item_sum_avg_fix_length_and_dec(Item_sum_avg *item) const
+{
+  LEX_CSTRING name= {STRING_WITH_LEN("avg") };
+  return Item_func_or_sum_illegal_param(name);
+}
+
+
+bool Type_handler_xmltype::
+  Item_sum_variance_fix_length_and_dec(Item_sum_variance *item) const
+{
+  return Item_func_or_sum_illegal_param(item);
+}
+
+
 
