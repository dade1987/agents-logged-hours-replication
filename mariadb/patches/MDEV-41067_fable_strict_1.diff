diff --git a/sql/item_jsonfunc.cc b/sql/item_jsonfunc.cc
index 615d0cb4..caf1ebfa 100644
--- a/sql/item_jsonfunc.cc
+++ b/sql/item_jsonfunc.cc
@@ -4809,9 +4809,25 @@ bool json_compare_arrays_in_order(json_engine_t *js, json_engine_t *value)
       return FALSE;
     }
   }
-  res= (value->state == JST_ARRAY_END || value->state == JST_OBJ_END ?
+  /*
+    Nested arrays are equal only if both of them have been exhausted at the
+    same time, i.e. they have the same number of elements. If one array ended
+    while the other still has elements (e.g. '[1]' vs '[]' or '[1,2]' vs '[1]')
+    they are not equal.
+  */
+  res= ((js->state == JST_ARRAY_END || js->state == JST_OBJ_END) &&
+        (value->state == JST_ARRAY_END || value->state == JST_OBJ_END) ?
         TRUE : FALSE);
-  json_skip_current_level(js, value);
+  /*
+    Skip the remaining elements of the array that has not been exhausted
+    yet. An array that has already ended must not be skipped, as its level
+    has already been popped and json_skip_level() would then skip the rest
+    of the enclosing structure (e.g. the "123" in '[[],123]').
+  */
+  if (js->state != JST_ARRAY_END && js->state != JST_OBJ_END)
+    json_skip_level(js);
+  if (value->state != JST_ARRAY_END && value->state != JST_OBJ_END)
+    json_skip_level(value);
   return res;
 }
 
