diff --git a/sql/sql_base.cc b/sql/sql_base.cc
index eabad770..12e11c02 100644
--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -876,8 +876,16 @@ int close_thread_tables(THD *thd) noexcept
       /*
         For simple locking we cleanup it here because we don't close thread
         tables. For prelocking we close it when we do close thread tables.
+
+        Don't do the cleanup from inside a sub-statement (a trigger or a
+        stored function body executed under LOCK TABLES, i.e. in
+        LTM_PRELOCKED_UNDER_LOCK_TABLES mode): the vcol expressions were
+        fixed by the top-level statement, which may still need them after
+        the sub-statement returns (e.g. to re-calculate virtual columns
+        after BEFORE triggers). The cleanup will be done when the top-level
+        statement closes its tables.
       */
-      if (thd->locked_tables_mode != LTM_PRELOCKED)
+      if (thd->locked_tables_mode != LTM_PRELOCKED && !thd->in_sub_stmt)
         table->vcol_cleanup_expr(thd);
     }
 
