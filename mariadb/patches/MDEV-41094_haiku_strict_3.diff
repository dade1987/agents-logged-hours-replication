 SELECT KDF('secret','salt',1000,'pbkdf2_hmac') IS NOT NULL;
 SELECT KDF('secret','salt') IS NOT NULL;
 
+--echo #
+--echo # MDEV-41094 KDF() silently reduces large PBKDF2 iteration counts
+--echo #
+# Iteration counts above INT_MAX must be rejected, not truncated to a
+# 32-bit alias (2^32 + n would otherwise derive the same key as n).
+SELECT KDF('foo','bar',2147483648,'pbkdf2_hmac',256);
+SELECT KDF('foo','bar',4294968296,'pbkdf2_hmac',256);
+
 --echo #
 --echo # End of 11.4 tests
