+    /*
+      Sql_path::from_text() parses the value as utf8mb3,
+      so convert the value from its own character set to utf8mb3.
+      Using val_str_ascii() here was wrong: it converts non-ASCII
+      character sets (e.g. swe7, ucs2) to latin1, which can produce
+      byte sequences that are not well-formed utf8mb3.
+    */
+    StringBuffer<STRING_BUFFER_USUAL_SIZE> tmp;
+    String *res;
+    uint errors;
+    if (!(res= item->val_str(&tmp)))
+      return true;
+    StringBuffer<STRING_BUFFER_USUAL_SIZE> value;
+    if (value.copy(res->ptr(), res->length(), item->collation.collation,
+                   &my_charset_utf8mb3_general_ci, &errors))
       return true;
-    return path->from_text(thd->variables, value);
+    return path->from_text(thd->variables, &value);
