diff --git a/sql/sql_base.cc b/sql/sql_base.cc
index 544df995..e1748dd3 100644
--- a/sql/sql_base.cc
+++ b/sql/sql_base.cc
@@ -9372,16 +9372,28 @@ fill_record_n_invoke_before_triggers(THD *thd, TABLE *table,
       Re-calculate virtual fields to cater for cases when base columns are
       updated by the triggers.
     */
-    if (table->vfield && fields.elements)
+    if (table->vfield)
     {
-      Item *fld= (Item_field*) fields.head();
-      Item_field *item_field= fld->field_for_view_update();
-      if (item_field)
+      /*
+        The list may be empty, e.g. LOAD DATA with a column list and no SET
+        clause (the column list is kept in a different list). The trigger
+        may still have changed base columns in record[0], so the virtual
+        and stored generated columns must be recalculated in that case too.
+      */
+      bool recalc= true;
+      if (fields.elements)
       {
-        DBUG_ASSERT(table == item_field->field->table);
+        Item *fld= (Item_field*) fields.head();
+        Item_field *item_field= fld->field_for_view_update();
+        recalc= item_field != NULL;
+        if (item_field)
+        {
+          DBUG_ASSERT(table == item_field->field->table);
+        }
+      }
+      if (recalc)
         result|= table->update_virtual_fields(table->file,
                                               VCOL_UPDATE_FOR_WRITE);
-      }
     }
   }
   return result;
