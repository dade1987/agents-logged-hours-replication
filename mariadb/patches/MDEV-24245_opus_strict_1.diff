diff --git a/mysql-test/suite/archive/archive.result b/mysql-test/suite/archive/archive.result
index fa2b4f7e..7870f0ab 100644
--- a/mysql-test/suite/archive/archive.result
+++ b/mysql-test/suite/archive/archive.result
@@ -12906,3 +12906,30 @@ t1	CREATE TEMPORARY TABLE `t1` (
   `b` varchar(10) DEFAULT NULL
 ) ENGINE=ARCHIVE DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
 drop table t1;
+#
+# MDEV-24245 REPAIR on ARCHIVE table destroys TEXT data
+#
+create table t1 (a text, b int, c text) engine=archive;
+insert t1 values ('Testtext', 1, repeat('x', 1000)), (NULL, 2, 'abc'), ('', 3, NULL);
+select a, b, md5(c) from t1;
+a	b	md5(c)
+Testtext	1	398533d48111e9f664b1f64cb10c4b63
+NULL	2	900150983cd24fb0d6963f7d28e17f72
+	3	NULL
+repair table t1;
+Table	Op	Msg_type	Msg_text
+test.t1	repair	status	OK
+select a, b, md5(c) from t1;
+a	b	md5(c)
+Testtext	1	398533d48111e9f664b1f64cb10c4b63
+NULL	2	900150983cd24fb0d6963f7d28e17f72
+	3	NULL
+optimize table t1;
+Table	Op	Msg_type	Msg_text
+test.t1	optimize	status	OK
+select a, b, md5(c) from t1;
+a	b	md5(c)
+Testtext	1	398533d48111e9f664b1f64cb10c4b63
+NULL	2	900150983cd24fb0d6963f7d28e17f72
+	3	NULL
+drop table t1;
