+["ab","cd",""]
+Warnings:
+Warning	1260	Row 3 was cut by JSON_ARRAYAGG()
+set session group_concat_max_len = 13;
+select json_arrayagg(c order by c) from t;
+json_arrayagg(c order by c)
+["ab","cd","e"]
+Warnings:
