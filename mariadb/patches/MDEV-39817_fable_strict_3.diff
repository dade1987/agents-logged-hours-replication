diff --git a/sql/item_jsonfunc.cc b/sql/item_jsonfunc.cc
index cf5bb9be..3e6bd743 100644
--- a/sql/item_jsonfunc.cc
+++ b/sql/item_jsonfunc.cc
@@ -4101,6 +4101,27 @@ void Item_func_json_arrayagg::cut_max_length(String *result,
     return;
   }
 
+  /*
+    The last appended value is a JSON string. We cut it to max_length-1
+    bytes and then append the closing quote, so that the result stays
+    a valid JSON string.
+
+    However, there must be enough room after the previous content
+    (old_length) for the separator, the opening quote and the closing
+    quote. Otherwise max_length-1 could be smaller than old_length, and
+    Item_func_group_concat::cut_max_length() would be called with
+    an end pointer that precedes the start pointer, which results in
+    garbage (an arbitrarily long, uninitialized result).
+    In that case drop the whole last value, including the separator.
+  */
+  size_t min_length= (size_t) old_length +
+                     (old_length ? separator->length() : 0) + 2;
+  if ((size_t) max_length < min_length)
+  {
+    result->length(old_length);
+    return;
+  }
+
   Item_func_group_concat::cut_max_length(result, old_length, max_length-1);
   result->append('"');
 }
