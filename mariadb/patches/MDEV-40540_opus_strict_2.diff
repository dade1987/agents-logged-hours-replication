diff --git a/mysql-test/main/gis_stack_noasan.result b/mysql-test/main/gis_stack_noasan.result
new file mode 100644
index 00000000..c77d0c2d
--- /dev/null
+++ b/mysql-test/main/gis_stack_noasan.result
@@ -0,0 +1,12 @@
+#
+# MDEV-40540 ST_GeomFromWKB stack overrun on deeply nested GeometryCollection
+#
+set @a=concat(0x0107000000, repeat(0x010000000107000000, 120000), 0x00000000);
+SELECT ST_GeomFromWKB(@a);
+ERROR HY000: Thread stack overrun:  'used bytes' used of a 'available' byte stack, and 'X' bytes needed. Consider increasing the thread_stack system variable.
+set @b=concat(0x00000000, @a);
+SELECT ST_AsText(@b);
+ERROR HY000: Thread stack overrun:  'used bytes' used of a 'available' byte stack, and 'X' bytes needed. Consider increasing the thread_stack system variable.
+SELECT ST_Area(@b);
+ERROR HY000: Thread stack overrun:  'used bytes' used of a 'available' byte stack, and 'X' bytes needed. Consider increasing the thread_stack system variable.
+# End of 10.6 tests
diff --git a/mysql-test/main/gis_stack_noasan.test b/mysql-test/main/gis_stack_noasan.test
new file mode 100644
index 00000000..ba413fcb
--- /dev/null
+++ b/mysql-test/main/gis_stack_noasan.test
@@ -0,0 +1,22 @@
+--source include/have_geometry.inc
+--source include/not_asan.inc
+--source include/not_msan.inc
+--source include/not_ubsan.inc
+
+--echo #
+--echo # MDEV-40540 ST_GeomFromWKB stack overrun on deeply nested GeometryCollection
+--echo #
+set @a=concat(0x0107000000, repeat(0x010000000107000000, 120000), 0x00000000);
+--replace_regex /overrun:  [0-9]* bytes used of a [0-9]* byte stack, and [0-9]* bytes needed/overrun:  'used bytes' used of a 'available' byte stack, and 'X' bytes needed/
+--error ER_STACK_OVERRUN_NEED_MORE
+SELECT ST_GeomFromWKB(@a);
+
+set @b=concat(0x00000000, @a);
+--replace_regex /overrun:  [0-9]* bytes used of a [0-9]* byte stack, and [0-9]* bytes needed/overrun:  'used bytes' used of a 'available' byte stack, and 'X' bytes needed/
+--error ER_STACK_OVERRUN_NEED_MORE
+SELECT ST_AsText(@b);
+--replace_regex /overrun:  [0-9]* bytes used of a [0-9]* byte stack, and [0-9]* bytes needed/overrun:  'used bytes' used of a 'available' byte stack, and 'X' bytes needed/
+--error ER_STACK_OVERRUN_NEED_MORE
+SELECT ST_Area(@b);
+
+--echo # End of 10.6 tests
