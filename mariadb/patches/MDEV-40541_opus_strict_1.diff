diff --git a/mysql-test/suite/roles/acl_cache_role_localhost.test b/mysql-test/suite/roles/acl_cache_role_localhost.test
new file mode 100644
index 00000000..e2678268
--- /dev/null
+++ b/mysql-test/suite/roles/acl_cache_role_localhost.test
@@ -0,0 +1,47 @@
+#
+# MDEV-40541 role vs user@localhost acl_cache key confusion
+#
+--source include/not_embedded.inc
+
+create database db;
+create table db.t1(a varchar(40));
+insert into db.t1 values ('role-cache-collision-row');
+
+create role r1;
+create user r1@localhost;
+create user u1@'127.0.0.1';
+
+grant select on db.* to r1@localhost;
+grant r1 to u1@'127.0.0.1';
+
+--echo # user r1@localhost first, then role r1
+connect r1,localhost,r1,,;
+select a from db.t1;
+
+connect u1,127.0.0.1,u1,,;
+set role r1;
+show grants;
+--error ER_TABLEACCESS_DENIED_ERROR
+select a from db.t1;
+disconnect u1;
+disconnect r1;
+
+connection default;
+flush privileges;
+
+--echo # role r1 first, then user r1@localhost
+connect u1,127.0.0.1,u1,,;
+set role r1;
+--error ER_TABLEACCESS_DENIED_ERROR
+select a from db.t1;
+
+connect r1,localhost,r1,,;
+select a from db.t1;
+disconnect r1;
+disconnect u1;
+
+connection default;
+drop user r1@localhost;
+drop user u1@'127.0.0.1';
+drop role r1;
+drop database db;
