+select json_overlaps('[[1]]', '[[],123]');
+json_overlaps('[[1]]', '[[],123]')
+0
+select json_overlaps('[[]]', '[[1]]');
+json_overlaps('[[]]', '[[1]]')
+0
+select json_overlaps('[[]]', '[[]]');
+json_overlaps('[[]]', '[[]]')
+1
+select json_overlaps('[[1]]', '[[],[1]]');
+json_overlaps('[[1]]', '[[],[1]]')
+1
+select json_overlaps('[[1]]', '[[[5],[1]]]');
+json_overlaps('[[1]]', '[[[5],[1]]]')
+0
+select json_overlaps('{"a":[1]}', '{"a":[]}');
