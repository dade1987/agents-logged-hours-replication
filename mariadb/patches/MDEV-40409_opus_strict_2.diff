@@ -3320,6 +3322,19 @@ bool Gis_geometry_collection::init_from_wkt(Gis_read_stream *trs, String *wkb)
     {
       for (;;)
       {
+        /*
+          Nested GEOMETRYCOLLECTION is not allowed. Check it before
+          recursing into create_from_wkt(), otherwise a deeply nested
+          input would overrun the stack before the error is detected.
+        */
+        if (trs->next_symbol() && !trs->lookup_next_word(&next_word) &&
+            find_class(next_word.str, next_word.length) ==
+              &geometrycollection_class)
+        {
+          trs->set_error_msg("Unexpected GEOMETRYCOLLECTION");
+          return 1;
+        }
+
