diff --git a/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test b/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test
new file mode 100644
index 00000000..af2e7a5c
--- /dev/null
+++ b/mysql-test/suite/binlog/t/binlog_gtid_slave_pos_autocommit_off.test
@@ -0,0 +1,60 @@
+#
+# MDEV-22848 Assertion `trx_is_registered_for_2pc(trx)' failed in
+#            innobase_xa_prepare on DROP and in innobase_savepoint on
+#            SAVEPOINT
+#
+# SET GLOBAL gtid_slave_pos with autocommit=0 used to open and lock the
+# mysql.gtid_slave_pos table with the multi-statement transaction flags still
+# set, so that the storage engine registered itself in the enclosing
+# transaction. The GTID position was then committed as a separate (autocommit)
+# transaction, leaving the storage engine registered in the enclosing
+# transaction, but with its own transaction already committed and
+# deregistered. A later 2PC commit (DROP TABLE with a binlogged non-transactional
+# update pending) or SAVEPOINT then hit assertions in InnoDB.
+#
+
+--source include/have_innodb.inc
+--source include/have_log_bin.inc
+--source include/have_binlog_format_mixed.inc
+
+--let old_slave_pos_engine= query_get_value(SHOW TABLE STATUS FROM mysql LIKE 'gtid_slave_pos', Engine, 1)
+SET @old_gtid_slave_pos= @@GLOBAL.gtid_slave_pos;
+
+# The bug needs a transactional engine supporting 2PC for the table.
+ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;
+RESET MASTER;
+
+SET autocommit=0;
+CREATE TABLE t1 (c INT) ENGINE=MyISAM;
+SET GLOBAL gtid_slave_pos="0-1-100";
+INSERT INTO t1 VALUES (0);
+--error ER_BAD_TABLE_ERROR
+DROP TABLE not_there;
+INSERT INTO t1 VALUES (1);
+SAVEPOINT sp1;
+INSERT INTO t1 VALUES (2);
+COMMIT;
+SELECT * FROM t1 ORDER BY c;
+SELECT @@GLOBAL.gtid_slave_pos;
+
+# Same, with the position update inside a transaction that has already
+# used a transactional table, is rejected and must not break the transaction.
+CREATE TABLE t2 (c INT) ENGINE=InnoDB;
+INSERT INTO t2 VALUES (1);
+--error ER_CANT_DO_THIS_DURING_AN_TRANSACTION
+SET GLOBAL gtid_slave_pos="0-1-200";
+SAVEPOINT sp2;
+INSERT INTO t2 VALUES (2);
+COMMIT;
+SELECT * FROM t2 ORDER BY c;
+SELECT @@GLOBAL.gtid_slave_pos;
+
+DROP TABLE t1, t2;
+SET autocommit=1;
+
+# Cleanup
+RESET MASTER;
+--disable_query_log
+SET GLOBAL gtid_slave_pos= @old_gtid_slave_pos;
+--eval ALTER TABLE mysql.gtid_slave_pos ENGINE=$old_slave_pos_engine
+--enable_query_log
