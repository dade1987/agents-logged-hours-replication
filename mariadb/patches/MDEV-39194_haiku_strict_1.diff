diff --git a/sql/sql_type.cc b/sql/sql_type.cc
index 74917bbc..8bef0e87 100644
--- a/sql/sql_type.cc
+++ b/sql/sql_type.cc
@@ -9020,6 +9020,25 @@ int Type_handler_hex_hybrid::
 }
 
 
+/*
+  Hex hybrid values are unsigned integers of up to 8 bytes.
+  Use an unsigned BIGINT field for the DISTINCT aggregator rather than the
+  generic DOUBLE field, whose length is the item's max_length (a byte count
+  here, not a decimal digit count). A DOUBLE field of length 1 would truncate
+  values to a single digit, e.g. SUM(DISTINCT b'1100') would return 9 not 12.
+*/
+Field *Type_handler_hex_hybrid::
+       make_num_distinct_aggregator_field(MEM_ROOT *mem_root,
+                                          const Item *item) const
+{
+  return new(mem_root)
+         Field_longlong(NULL, item->max_length,
+                        (uchar *) (item->maybe_null() ? "" : 0),
+                        item->maybe_null() ? 1 : 0, Field::NONE,
+                        &item->name, 0, true);
+}
+
+
 longlong Type_handler_hex_hybrid::
        Item_func_hybrid_field_type_val_int(Item_func_hybrid_field_type *item)
                                            const
