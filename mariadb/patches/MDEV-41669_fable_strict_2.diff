diff --git a/storage/innobase/row/row0import.cc b/storage/innobase/row/row0import.cc
index c589b8f2..786f4b9d 100644
--- a/storage/innobase/row/row0import.cc
+++ b/storage/innobase/row/row0import.cc
@@ -5007,6 +5007,18 @@ row_import_for_mysql(
 	table->file_unreadable = false;
 	table->flags2 &= ~DICT_TF2_DISCARDED & ((1U << DICT_TF2_BITS) - 1);
 
+	/* The imported records were written with DB_TRX_ID=0, which
+	would make them visible to any read view, including read views
+	that were created before the IMPORT started. Mark all indexes
+	as having been created by this transaction, so that older read
+	views will report DB_MISSING_HISTORY (ER_TABLE_DEF_CHANGED)
+	instead of returning data that is not part of the snapshot. */
+	for (dict_index_t* index = dict_table_get_first_index(table);
+	     index != NULL;
+	     index = dict_table_get_next_index(index)) {
+		index->trx_id = trx->id;
+	}
+
 	/* Set autoinc value read from .cfg file, if one was specified.
 	Otherwise, read the PAGE_ROOT_AUTO_INC and set it to table autoinc. */
 	row_import_autoinc(table, prebuilt, autoinc);
