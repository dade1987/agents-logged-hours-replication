diff --git a/sql/json_table.cc b/sql/json_table.cc
index e5ac6008..6bbf7e8e 100644
--- a/sql/json_table.cc
+++ b/sql/json_table.cc
@@ -384,6 +384,30 @@ static void store_json_in_field(Field *f, const json_engine_t *je)
     }
     break;
   }
+
+  case JSON_VALUE_NUMBER:
+  {
+    /*
+      Field_bit::store(const char*, ...) treats the string as a binary
+      representation of the value, not as a decimal number, so storing
+      a JSON number "0" into a BIT column would store the byte 0x30.
+      Convert the JSON number into an integer and store it as a number.
+    */
+    if (f->type() == MYSQL_TYPE_BIT)
+    {
+      int error= 0;
+      char *end;
+      bool unsigned_val= !(je->num_flags & JSON_NUM_NEG);
+      longlong nr= (longlong) je->s.cs->strntoull10rnd((const char *) je->value,
+                                                       je->value_len,
+                                                       unsigned_val,
+                                                       &end, &error);
+      f->store(nr, unsigned_val);
+      return;
+    }
+    break;
+  }
+
   default:
     break;
   };
