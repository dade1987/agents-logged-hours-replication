diff --git a/sql/handler.cc b/sql/handler.cc
index 56a784d3..37e537cf 100644
--- a/sql/handler.cc
+++ b/sql/handler.cc
@@ -5674,9 +5674,27 @@ handler::ha_analyze(THD* thd, HA_CHECK_OPT* check_opt)
 {
   DBUG_ASSERT(table_share->tmp_table != NO_TMP_TABLE ||
               m_lock_type != F_UNLCK);
+  int error;
   mark_trx_read_write();
 
-  return analyze(thd, check_opt);
+  if ((error= analyze(thd, check_opt)))
+    return error;
+  /*
+    Update statistics of high-level indexes too, otherwise e.g.
+    INFORMATION_SCHEMA.TABLES.INDEX_LENGTH would not reflect the
+    actual size of the vector index after ANALYZE.
+  */
+  for (uint i= table->s->keys; i < table->s->total_keys; i++)
+  {
+    DBUG_ASSERT(table->s->hlindexes() == 1);
+    if (table->hlindex_open(i) || table->hlindex_lock(i))
+      return HA_ADMIN_FAILED;
+    int hl_error= table->hlindex->file->analyze(thd, check_opt);
+    if (hl_error && hl_error != HA_ADMIN_ALREADY_DONE &&
+        hl_error != HA_ADMIN_NOT_IMPLEMENTED)
+      return hl_error;
+  }
+  return error;
 }
 
 
diff --git a/sql/sql_show.cc b/sql/sql_show.cc
index ed108adf..a668fa3f 100644
--- a/sql/sql_show.cc
+++ b/sql/sql_show.cc
@@ -6083,13 +6083,21 @@ static int get_schema_tables_record(THD *thd, TABLE_LIST *tables,
 
       if (show_table->s->hlindexes())
       {
-          // make sure hlindex is opened
-          if (show_table->hlindex || !show_table->hlindex_open(show_table->s->keys))
-          {
-              handler *hi= show_table->hlindex->file;
-              if (!hi->info(HA_STATUS_VARIABLE))
-                  file->stats.index_file_length+= hi->stats.data_file_length;
-          }
+        // make sure hlindex is opened
+        if (show_table->hlindex ||
+            !show_table->hlindex_open(show_table->s->keys))
+        {
+          /*
+            The size of a high-level (vector) index is the total size
+            of its secondary table: both its data and its own indexes.
+            Request the same kind of statistics as for the main table,
+            so that both are equally up to date.
+          */
+          handler *hi= show_table->hlindex->file;
+          if (!hi->info(HA_STATUS_VARIABLE | HA_STATUS_TIME))
+            file->stats.index_file_length+= hi->stats.data_file_length +
+                                            hi->stats.index_file_length;
+        }
       }
 
       enum row_type row_type = file->get_row_type();
