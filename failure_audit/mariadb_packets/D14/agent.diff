diff --git a/sql/json_table.cc b/sql/json_table.cc
index e5ac6008..c698cfd0 100644
--- a/sql/json_table.cc
+++ b/sql/json_table.cc
@@ -384,6 +384,24 @@ static void store_json_in_field(Field *f, const json_engine_t *je)
     }
     break;
   }
+  case JSON_VALUE_NUMBER:
+    if (f->type() == MYSQL_TYPE_BIT)
+    {
+      /*
+        Field_bit::store(const char*) treats its argument as raw binary
+        data, so the text "0" would be read as 0x30 and overflow BIT(1).
+        Convert the number to its numeric value instead.
+      */
+      int error;
+      char *end;
+      st_append_json(&res_tmp, je->s.cs, je->value, je->value_len);
+      double nr= my_ci_strntod(je->s.cs, (char *) res_tmp.ptr(),
+                               res_tmp.length(), &end, &error);
+      f->store(nr);
+      return;
+    }
+    break;
+
   default:
     break;
   };