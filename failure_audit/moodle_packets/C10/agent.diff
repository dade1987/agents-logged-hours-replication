+    /**
+     * Test show_navigation_footer is not shown on stealth activities.
+     */
+    public function test_show_navigation_footer_stealth(): void {
+        $this->resetAfterTest();
+        set_config('allowstealth', 1);
+
+        $course = $this->getDataGenerator()->create_course([
+            'format' => 'topics',
+            'enablelinearnav' => 1,
+        ]);
+        $visiblepage = $this->getDataGenerator()->create_module('page', ['course' => $course->id]);
+        $stealthpage = $this->getDataGenerator()->create_module('page', [
+            'course' => $course->id,
+            'visibleoncoursepage' => 0,
+        ]);
+
+        // Standard activity shows the navigation footer.
+        $moodlepage = new \moodle_page();
+        $moodlepage->set_course($course);
+        $moodlepage->set_cm(get_coursemodule_from_id('page', $visiblepage->cmid), $course);
+        $this->assertTrue(linearnavigationsettings::show_navigation_footer($moodlepage));
+
+        // Stealth activity does not show the navigation footer.
+        $moodlepage = new \moodle_page();
+        $moodlepage->set_course($course);
+        $moodlepage->set_cm(get_coursemodule_from_id('page', $stealthpage->cmid), $course);
+        $this->assertFalse(linearnavigationsettings::show_navigation_footer($moodlepage));
+    }
