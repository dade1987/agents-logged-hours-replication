diff --git a/public/mod/forum/tests/externallib_test.php b/public/mod/forum/tests/externallib_test.php
index 9f260e6abd7..f283285e46e 100644
--- a/public/mod/forum/tests/externallib_test.php
+++ b/public/mod/forum/tests/externallib_test.php
@@ -326,6 +326,105 @@ final class externallib_test extends \core_external\tests\externallib_testcase {
         $this->assertFalse($response['pinned']);
     }
 
+    /**
+     * Test the set read state web service.
+     *
+     * @covers \mod_forum_external::set_read_state
+     */
+    public function test_mod_forum_set_read_state(): void {
+        global $CFG, $DB;
+
+        $this->resetAfterTest(true);
+
+        // Allow users to manually mark posts as read.
+        $CFG->forum_usermarksread = 1;
+        $CFG->forum_trackreadposts = 1;
+
+        // Create a user tracking forums and an author.
+        $user = self::getDataGenerator()->create_user(['trackforums' => 1]);
+        $author = self::getDataGenerator()->create_user();
+
+        $course = self::getDataGenerator()->create_course();
+        self::getDataGenerator()->enrol_user($user->id, $course->id);
+        self::getDataGenerator()->enrol_user($author->id, $course->id);
+
+        $forum = self::getDataGenerator()->create_module('forum', [
+            'course' => $course->id,
+            'trackingtype' => FORUM_TRACKING_FORCED,
+        ]);
+
+        $record = new \stdClass();
+        $record->course = $course->id;
+        $record->userid = $author->id;
+        $record->forum = $forum->id;
+        $discussion = self::getDataGenerator()->get_plugin_generator('mod_forum')->create_discussion($record);
+        $postid = $discussion->firstpost;
+
+        self::setUser($user);
+
+        // The post is unread.
+        $this->assertFalse($DB->record_exists('forum_read', ['userid' => $user->id, 'postid' => $postid]));
+
+        // Mark it as read.
+        $response = mod_forum_external::set_read_state($postid, true);
+        $response = external_api::clean_returnvalue(mod_forum_external::set_read_state_returns(), $response);
+        $this->assertEquals($postid, $response['post']['id']);
+        $this->assertFalse($response['post']['unread']);
+        $this->assertTrue($response['post']['capabilities']['controlreadstatus']);
+        $this->assertTrue($DB->record_exists('forum_read', ['userid' => $user->id, 'postid' => $postid]));
+
+        // Marking it as read again is harmless.
+        $response = mod_forum_external::set_read_state($postid, true);
+        $response = external_api::clean_returnvalue(mod_forum_external::set_read_state_returns(), $response);
+        $this->assertFalse($response['post']['unread']);
+        $this->assertEquals(1, $DB->count_records('forum_read', ['userid' => $user->id, 'postid' => $postid]));
+
+        // Mark it as unread.
+        $response = mod_forum_external::set_read_state($postid, false);
+        $response = external_api::clean_returnvalue(mod_forum_external::set_read_state_returns(), $response);
+        $this->assertTrue($response['post']['unread']);
+        $this->assertFalse($DB->record_exists('forum_read', ['userid' => $user->id, 'postid' => $postid]));
+
+        // Invalid post.
+        try {
+            mod_forum_external::set_read_state(-1, true);
+            $this->fail('Exception expected due to invalid post id.');
+        } catch (\moodle_exception $e) {
+            $this->assertEquals('invalidpostid', $e->errorcode);
+        }
+
+        // Users not enrolled in the course cannot access the post.
+        $otheruser = self::getDataGenerator()->create_user(['trackforums' => 1]);
+        self::setUser($otheruser);
+        try {
+            mod_forum_external::set_read_state($postid, true);
+            $this->fail('Exception expected due to missing access.');
+        } catch (\moodle_exception $e) {
+            $this->assertEquals('requireloginerror', $e->errorcode);
+        }
+
+        // Manual marking disabled site wide.
+        self::setUser($user);
+        $CFG->forum_usermarksread = 0;
+        try {
+            mod_forum_external::set_read_state($postid, true);
+            $this->fail('Exception expected because manual mark as read is disabled.');
+        } catch (\moodle_exception $e) {
+            $this->assertEquals('cannotcontrolreadstatus', $e->errorcode);
+        }
+        $CFG->forum_usermarksread = 1;
+
+        // Forum not tracked by the user.
+        $DB->set_field('forum', 'trackingtype', FORUM_TRACKING_OFF, ['id' => $forum->id]);
+        \cache::make('mod_forum', 'forum_is_tracked')->purge();
+        try {
+            mod_forum_external::set_read_state($postid, true);
+            $this->fail('Exception expected because the forum is not tracked.');
+        } catch (\moodle_exception $e) {
+            $this->assertEquals('cannotcontrolreadstatus', $e->errorcode);
+        }
+    }
+
