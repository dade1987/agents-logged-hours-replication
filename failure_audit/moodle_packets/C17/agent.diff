+namespace core_courseformat\output\local\linearnavigation;
+
+use core_courseformat\formatactions;
+
+/**
+ * Tests for the linear navigation footer content class.
+ *
+ * @package    core_courseformat
+ * @category   test
+ * @copyright  2026 Moodle Pty Ltd
+ * @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(footer_content::class)]
+final class footer_content_test extends \advanced_testcase {
+    #[\Override]
+    public static function setupBeforeClass(): void {
+        global $CFG;
+        require_once($CFG->dirroot . '/course/lib.php');
+    }
+
+    /**
+     * Test the first and last activity detection.
+     *
+     * @param array $cmsdef The course modules definition.
+     * @param array $hiddensections The section numbers to hide.
+     * @param string $role The role of the user viewing the footer.
+     * @param array $expected The expected first/last values for each module.
+     */
+    #[\PHPUnit\Framework\Attributes\DataProvider('boundaries_provider')]
+    public function test_boundaries(
+        array $cmsdef,
+        array $hiddensections,
+        string $role,
+        array $expected,
+    ): void {
+        global $PAGE;
+
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course(['numsections' => 3, 'enablelinearnav' => 1]);
+        $user = $generator->create_and_enrol($course, $role);
+
+        $cms = [];
+        foreach ($cmsdef as $name => $cmdef) {
+            $cms[$name] = $generator->create_module(
+                $cmdef['type'] ?? 'page',
+                array_merge(['course' => $course->id, 'name' => $name], $cmdef['options'] ?? []),
+            );
+        }
+        foreach ($hiddensections as $sectionnum) {
+            $sectioninfo = get_fast_modinfo($course)->get_section_info($sectionnum);
+            formatactions::section($course)->update($sectioninfo, ['visible' => 0]);
+        }
+
+        $this->setUser($user);
+        $output = $PAGE->get_renderer('core');
+        $courseurl = course_get_url($course)->out(false);
+
+        foreach ($expected as $name => [$isfirst, $islast]) {
+            $cminfo = get_fast_modinfo($course)->get_cm($cms[$name]->cmid);
+            $footer = new footer_content($cminfo);
+            $this->assertSame($isfirst, $footer->is_first_activity(), "Unexpected first value for $name");
+            $this->assertSame($islast, $footer->is_last_activity(), "Unexpected last value for $name");
+
+            $data = $footer->export_for_template($output);
+            $this->assertSame($isfirst, $data['isfirst']);
+            $this->assertSame($islast, $data['islast']);
+            if ($isfirst) {
+                $this->assertNull($data['previousurl'], "Unexpected previous URL for $name");
+            } else {
+                $this->assertStringContainsString("/cms/{$cminfo->id}/previous", $data['previousurl']);
+            }
+            if ($islast) {
+                $this->assertNull($data['nexturl'], "Unexpected next URL for $name");
+                $this->assertSame($courseurl, $data['courseurl']);
+            } else {
+                $this->assertStringContainsString("/cms/{$cminfo->id}/next", $data['nexturl']);
+                $this->assertNull($data['courseurl'], "Unexpected course URL for $name");
+            }
+        }
+    }
+
+    /**
+     * Data provider for test_boundaries.
+     *
+     * @return array
+     */
+    public static function boundaries_provider(): array {
+        return [
+            'Single activity' => [
+                'cmsdef' => [
+                    'cm1' => ['options' => ['section' => 1]],
+                ],
+                'hiddensections' => [],
+                'role' => 'student',
+                'expected' => [
+                    'cm1' => [true, true],
+                ],
+            ],
+            'Activities in the same section' => [
+                'cmsdef' => [
+                    'cm1' => ['options' => ['section' => 1]],
+                    'cm2' => ['options' => ['section' => 1]],
+                    'cm3' => ['options' => ['section' => 1]],
+                ],
+                'hiddensections' => [],
+                'role' => 'student',
+                'expected' => [
+                    'cm1' => [true, false],
+                    'cm2' => [false, false],
+                    'cm3' => [false, true],
+                ],
+            ],
+            'Activities in different sections' => [
+                'cmsdef' => [
+                    'cm1' => ['options' => ['section' => 0]],
+                    'cm2' => ['options' => ['section' => 2]],
+                    'cm3' => ['options' => ['section' => 3]],
+                ],
+                'hiddensections' => [],
+                'role' => 'student',
+                'expected' => [
+                    'cm1' => [true, false],
+                    'cm2' => [false, false],
+                    'cm3' => [false, true],
+                ],
+            ],
+            'Hidden activities are ignored for students' => [
+                'cmsdef' => [
+                    'cm1' => ['options' => ['section' => 1, 'visible' => 0]],
+                    'cm2' => ['options' => ['section' => 1]],
+                    'cm3' => ['options' => ['section' => 2]],
+                    'cm4' => ['options' => ['section' => 2, 'visible' => 0]],
+                ],
+                'hiddensections' => [],
+                'role' => 'student',
+                'expected' => [
+                    'cm2' => [true, false],
+                    'cm3' => [false, true],
+                ],
+            ],
+            'Hidden activities are navigable for editing teachers' => [
+                'cmsdef' => [
+                    'cm1' => ['options' => ['section' => 1, 'visible' => 0]],
+                    'cm2' => ['options' => ['section' => 1]],
+                    'cm3' => ['options' => ['section' => 2]],
+                    'cm4' => ['options' => ['section' => 2, 'visible' => 0]],
+                ],
+                'hiddensections' => [],
+                'role' => 'editingteacher',
+                'expected' => [
+                    'cm1' => [true, false],
+                    'cm2' => [false, false],
+                    'cm3' => [false, false],
+                    'cm4' => [false, true],
+                ],
+            ],
+            'Activities without URL are ignored' => [
+                'cmsdef' => [
+                    'cm1' => ['type' => 'label', 'options' => ['section' => 1]],
+                    'cm2' => ['options' => ['section' => 1]],
+                    'cm3' => ['options' => ['section' => 2]],
+                    'cm4' => ['type' => 'label', 'options' => ['section' => 2]],
+                ],
+                'hiddensections' => [],
+                'role' => 'student',
+                'expected' => [
+                    'cm2' => [true, false],
+                    'cm3' => [false, true],
+                ],
+            ],
+            'Hidden sections are ignored for students' => [
+                'cmsdef' => [
+                    'cm1' => ['options' => ['section' => 1]],
+                    'cm2' => ['options' => ['section' => 2]],
+                    'cm3' => ['options' => ['section' => 3]],
+                ],
+                'hiddensections' => [1, 3],
+                'role' => 'student',
+                'expected' => [
+                    'cm2' => [true, true],
+                ],
+            ],
+            'Hidden sections are navigable for editing teachers' => [
+                'cmsdef' => [
+                    'cm1' => ['options' => ['section' => 1]],
+                    'cm2' => ['options' => ['section' => 2]],
+                    'cm3' => ['options' => ['section' => 3]],
+                ],
+                'hiddensections' => [1, 3],
+                'role' => 'editingteacher',
+                'expected' => [
+                    'cm1' => [true, false],
+                    'cm2' => [false, false],
+                    'cm3' => [false, true],
+                ],
+            ],
+        ];
+    }
+
+    /**
+     * Test the first and last activity detection with subsections.
+     */
+    public function test_boundaries_with_subsections(): void {
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $generator = $this->getDataGenerator();
+        $course = $generator->create_course(['numsections' => 2, 'enablelinearnav' => 1]);
+        $user = $generator->create_and_enrol($course, 'student');
+
+        $cm1 = $generator->create_module('page', ['course' => $course->id, 'section' => 1]);
+        $subsection = $generator->create_module('subsection', ['course' => $course->id, 'section' => 1]);
+        $delegatedsection = get_fast_modinfo($course)->get_section_info_by_component('mod_subsection', $subsection->id);
+        $cm2 = $generator->create_module('page', ['course' => $course->id, 'section' => $delegatedsection->sectionnum]);
+        $cm3 = $generator->create_module('page', ['course' => $course->id, 'section' => $delegatedsection->sectionnum]);
+
+        $this->setUser($user);
+        $modinfo = get_fast_modinfo($course);
+
+        $footer = new footer_content($modinfo->get_cm($cm1->cmid));
+        $this->assertTrue($footer->is_first_activity());
+        $this->assertFalse($footer->is_last_activity());
+
+        $footer = new footer_content($modinfo->get_cm($cm2->cmid));
+        $this->assertFalse($footer->is_first_activity());
+        $this->assertFalse($footer->is_last_activity());
+
+        $footer = new footer_content($modinfo->get_cm($cm3->cmid));
+        $this->assertFalse($footer->is_first_activity());
+        $this->assertTrue($footer->is_last_activity());
+    }
+}
