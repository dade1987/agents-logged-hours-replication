             'completion' => $this->export_completion($output),
         ];
     }
 
+    /**
+     * Check if the current course module is the first navigable activity of the course.
+     *
+     * Hidden activities, activities without a URL, activities not displayable on the course page and
+     * activities in sections the user cannot see are ignored.
+     *
+     * @return bool
+     */
+    public function is_first_activity(): bool {
+        $navigablecms = $this->get_navigable_cms();
+        $index = array_search((int) $this->cminfo->id, $navigablecms, true);
+        if ($index === false) {
+            // The current module is not part of the navigable sequence (for example, it is hidden from the
+            // course page), so there is no previous module to go to.
+            return empty($navigablecms);
+        }
+        return $index === 0;
+    }
+
+    /**
+     * Check if the current course module is the last navigable activity of the course.
+     *
+     * Hidden activities, activities without a URL, activities not displayable on the course page and
+     * activities in sections the user cannot see are ignored.
+     *
+     * @return bool
+     */
+    public function is_last_activity(): bool {
+        $navigablecms = $this->get_navigable_cms();
+        $index = array_search((int) $this->cminfo->id, $navigablecms, true);
+        if ($index === false) {
+            // The current module is not part of the navigable sequence (for example, it is hidden from the
+            // course page), so there is no next module to go to.
+            return empty($navigablecms);
+        }
+        return $index === count($navigablecms) - 1;
+    }
+
+    /**
+     * Get the ordered list of the course module IDs the user can navigate to in the course.
+     *
+     * The list follows the course page order, including activities inside subsections, and only contains
+     * the current activity and the activities the user can navigate to.
+     *
+     * @return int[]
+     */
+    private function get_navigable_cms(): array {
+        $modinfo = $this->cminfo->get_modinfo();
+        $currentsection = $this->get_current_section();
+        $result = [];
+        foreach ($modinfo->get_section_info_all() as $section) {
+            if ($section->is_delegated()) {
+                // Delegated sections are included as part of their parent section.
+                continue;
+            }
+            if (!$this->is_section_navigable($section, $currentsection)) {
+                continue;
+            }
+            foreach ($this->get_all_section_cms($modinfo, $section) as $cm) {
+                if ($cm->id == $this->cminfo->id || $this->is_navigable_cm($cm)) {
+                    $result[] = (int) $cm->id;
+                }
+            }
+        }
+        return $result;
+    }
+
+    /**
+     * Get the section of the current course module; if the section is delegated, get the parent section.
+     *
+     * @return section_info
+     */
+    private function get_current_section(): section_info {
+        $section = $this->cminfo->get_section_info();
+        if (!$section->is_delegated()) {
+            return $section;
+        }
+
+        // If the section is delegated, we need to get the parent section.
+        return $section->get_component_instance()->get_parent_section() ?? $section;
+    }
+
+    /**
+     * Check if the section can be navigated to by the current user.
+     *
+     * Sections that are hidden, or whose restrictions are hidden (eye closed), are not navigable.
+     *
+     * @param section_info $section The section to check.
+     * @param section_info $currentsection The section containing the current course module.
+     * @return bool
+     */
+    private function is_section_navigable(section_info $section, section_info $currentsection): bool {
+        if ($section->id == $currentsection->id) {
+            // The current section is always considered navigable.
+            return true;
+        }
+        return $section->uservisible || ($section->visible && $section->availableinfo);
+    }
+
+    /**
+     * Check if a course module can be navigated to by the current user.
+     *
+     * @param cm_info $cm The course module to check.
+     * @return bool True if the course module is navigable, false otherwise.
+     */
+    private function is_navigable_cm(cm_info $cm): bool {
+        return
+            // Skip modules that don't have a URL (like labels).
+            !empty($cm->get_navigation_url())
+            // Skip modules that are not visible to the user.
+            && $cm->is_visible_on_course_page()
+            // Skip modules that are not displayable.
+            && modinfo::is_mod_type_visible_on_course($cm->modname);
+    }
+
+    /**
+     * Get all course modules in a section in order, including also activities inside sub-sections.
+     *
+     * @param modinfo $modinfo
+     * @param section_info $section
+     * @return cm_info[]
+     */
+    private function get_all_section_cms(modinfo $modinfo, section_info $section): array {
+        $sectioncms = [];
+        foreach ($section->get_sequence_cm_infos() as $cm) {
+            $delegatedsection = $cm->get_delegated_section_info();
+            if ($delegatedsection) {
+                $sectioncms = array_merge(
+                    $sectioncms,
+                    $this->get_all_section_cms($modinfo, $delegatedsection),
+                );
+            } else {
+                $sectioncms[] = $cm;
+            }
+        }
+        return $sectioncms;
+    }
+
