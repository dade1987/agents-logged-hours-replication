@@ -101,4 +101,36 @@ final class get_users_in_report_test extends \advanced_testcase {
         )['users'];
         $this->assertCount(1, $users);
     }
+
+    /**
+     * Test that custom profile fields used as identity fields get their display name resolved server-side.
+     */
+    public function test_get_users_in_report_custom_profile_field_labels(): void {
+        $this->resetAfterTest();
+
+        $dg = $this->getDataGenerator();
+        $this->setAdminUser();
+
+        // Create a custom profile field and make it an identity field.
+        $dg->create_custom_profile_field(['datatype' => 'text', 'shortname' => 'fruit', 'name' => 'Favourite fruit']);
+        set_config('showuseridentity', 'email,profile_field_fruit');
+
+        $course = $dg->create_course();
+        $quizgen = $dg->get_plugin_generator('mod_quiz');
+        $quiz = $quizgen->create_instance(['course' => $course->id, 'sumgrades' => 2]);
+
+        $result = get_users_in_report::execute(
+            $quiz->cmid,
+            'overview',
+            '{"attempts":"enrolled_with","onlygraded":"","search":"","onlyregraded":""}'
+        );
+        $result = \core_external\external_api::clean_returnvalue(get_users_in_report::execute_returns(), $result);
+
+        $this->assertSame(['fullname', 'email', 'profile_field_fruit'], $result['extrafields']);
+        $this->assertSame(
+            [get_string('fullname'), get_string('email'), 'Favourite fruit'],
+            $result['extrafieldlabels']
+        );
+        $this->assertDebuggingNotCalled();
+    }
