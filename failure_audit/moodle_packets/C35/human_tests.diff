+    /**
+     * Ensure that attribute-based injection works by using the `make` command.
+     */
+    public function test_attribute_injection_enabled(): void {
+        $example = di::make(\core\tests\di\example_class::class);
+        $this->assertInstanceOf(\core\formatting::class, $example->formatter);
+    }
+
+    /**
+     * Ensure that the make method returns a new instance, rather than a previously resolved one.
+     */
+    public function test_make_with_params(): void {
+        $first = di::make(\core\output\core_renderer::class, [
+            'page' => new \moodle_page(),
+            'target' => \RENDERER_TARGET_CLI,
+        ]);
+        $this->assertInstanceOf(\core\output\core_renderer::class, $first);
+
+        $second = di::make(\core\output\core_renderer::class, [
+            'page' => new \moodle_page(),
+            'target' => \RENDERER_TARGET_CLI,
+        ]);
+        $this->assertInstanceOf(\core\output\core_renderer::class, $second);
+
+        $this->assertNotSame($first, $second);
+    }
