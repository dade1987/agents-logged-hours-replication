diff --git a/public/lib/classes/router/middleware/cors_middleware.php b/public/lib/classes/router/middleware/cors_middleware.php
index b612fc12903..17138ebd5a6 100644
--- a/public/lib/classes/router/middleware/cors_middleware.php
+++ b/public/lib/classes/router/middleware/cors_middleware.php
@@ -32,31 +32,62 @@ use Slim\Routing\RouteContext;
 class cors_middleware implements MiddlewareInterface {
     #[\Override]
     public function process(ServerRequestInterface $request, RequestHandlerInterface $handler): ResponseInterface {
-        $acceptheader = $request->getHeaderLine('Accept');
-        $accepted = array_map(
-            fn (string $mimetype): string => trim(strtok($mimetype, ';')),
-            explode(',', $acceptheader),
-        );
-
         $response = $handler->handle($request);
 
-        $cors = in_array('application/json', $accepted);
-        $cors = $cors || $request->getMethod() === 'OPTIONS';
-        $cors = $cors || $request->getMethod() === 'HEAD';
-
-        if (!$cors) {
-            return $response;
-        }
-
         $routecontext = RouteContext::fromRequest($request);
         $routingresults = $routecontext->getRoutingResults();
         $methods = $routingresults->getAllowedMethods();
 
-        return $response
-            ->withHeader('Content-Type', 'application/json')
-            ->withHeader('Content-Disposition', 'inline')
+        // CORS headers must always be added, regardless of the Accept header supplied by the client.
+        // Browser requests made using fetch() typically send 'Accept: */*', and the browser will block access to
+        // any response which does not include the relevant CORS headers, even though the request was processed.
+        $response = $response
             ->withHeader('Access-Control-Allow-Origin', '*')
             ->withHeader('Access-Control-Allow-Methods', implode(',', $methods))
             ->withHeader('Access-Control-Allow-Headers', 'Content-Type, api_key, Authorization');
+
+        if ($this->should_set_json_content_type($request, $response)) {
+            $response = $response
+                ->withHeader('Content-Type', 'application/json')
+                ->withHeader('Content-Disposition', 'inline');
+        }
+
+        return $response;
+    }
+
+    /**
+     * Determine whether the response should be marked as a JSON response.
+     *
+     * A Content-Type set by the handler is always respected, and responses to requests which explicitly
+     * ask for HTML (for example a browser navigating to a page) are not forced to be JSON.
+     *
+     * @param ServerRequestInterface $request
+     * @param ResponseInterface $response
+     * @return bool
+     */
+    protected function should_set_json_content_type(
+        ServerRequestInterface $request,
+        ResponseInterface $response,
+    ): bool {
+        if ($response->hasHeader('Content-Type')) {
+            // The handler has already specified the type of content being returned.
+            return false;
+        }
+
+        if ($request->getMethod() === 'OPTIONS' || $request->getMethod() === 'HEAD') {
+            return true;
+        }
+
+        $accepted = array_map(
+            fn (string $mimetype): string => strtolower(trim(strtok($mimetype, ';'))),
+            explode(',', $request->getHeaderLine('Accept')),
+        );
+
+        if (in_array('application/json', $accepted)) {
+            return true;
+        }
+
+        // Only avoid setting the JSON content type where the client has explicitly asked for HTML.
+        return !in_array('text/html', $accepted) && !in_array('application/xhtml+xml', $accepted);
     }
 }
