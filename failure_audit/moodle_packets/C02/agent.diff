+namespace core\hook\output;
+
+/**
+ * Hook to allow subscribers to extend, augment or replace the output of a help icon.
+ *
+ * Dispatched by {@see \core\output\core_renderer::render_help_icon()} before the help icon template is rendered.
+ *
+ * Subscribers can:
+ * - modify the template context (text, completedoclink, title, url, etc.) to change the popover content;
+ * - add HTML immediately before or after the help icon, via {@see add_before_icon()} and {@see add_after_icon()};
+ * - replace the default help icon output entirely, via {@see set_replacement()}.
+ *
+ * @package    core
+ * @copyright  2026 Moodle
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\core\attribute\tags('output')]
+#[\core\attribute\label('Allows plugins to extend, augment or replace help icon output')]
+final class before_help_icon_rendered {
+    /** @var string[] HTML fragments to output before the help icon */
+    private array $beforeicon = [];
+
+    /** @var string[] HTML fragments to output after the help icon */
+    private array $aftericon = [];
+
+    /** @var string|null HTML which replaces the default help icon output */
+    private ?string $replacement = null;
+
+    /**
+     * Constructor.
+     *
+     * @param \renderer_base $renderer The renderer rendering the help icon
+     * @param string $identifier The help identifier (the keyword that defines the help page)
+     * @param string $component The component the help identifier belongs to
+     * @param \stdClass $context The mutable template context used to render the help icon
+     */
+    public function __construct(
+        /** @var \renderer_base The renderer rendering the help icon */
+        public readonly \renderer_base $renderer,
+        /** @var string The help identifier */
+        public readonly string $identifier,
+        /** @var string The component the help identifier belongs to */
+        public readonly string $component,
+        /** @var \stdClass The mutable template context */
+        private \stdClass $context,
+    ) {
+    }
+
+    /**
+     * Get the template context used to render the help icon.
+     *
+     * Callbacks may modify its properties directly.
+     *
+     * @return \stdClass
+     */
+    public function get_context(): \stdClass {
+        return $this->context;
+    }
+
+    /**
+     * Add HTML to be output immediately before the help icon.
+     *
+     * @param string $html The HTML fragment to add
+     */
+    public function add_before_icon(string $html): void {
+        if ($html !== '') {
+            $this->beforeicon[] = $html;
+        }
+    }
+
+    /**
+     * Add HTML to be output immediately after the help icon.
+     *
+     * @param string $html The HTML fragment to add
+     */
+    public function add_after_icon(string $html): void {
+        if ($html !== '') {
+            $this->aftericon[] = $html;
+        }
+    }
+
+    /**
+     * Replace the default help icon output.
+     *
+     * When set, the default help icon template is not rendered. Any HTML added with
+     * {@see add_before_icon()} and {@see add_after_icon()} is still output around the replacement.
+     *
+     * The last callback to call this method wins.
+     *
+     * @param string $html The replacement HTML fragment
+     */
+    public function set_replacement(string $html): void {
+        $this->replacement = $html;
+    }
+
+    /**
+     * Get the HTML to output before the help icon.
+     *
+     * @return string
+     */
+    public function get_before_icon(): string {
+        return implode('', $this->beforeicon);
+    }
+
+    /**
+     * Get the HTML to output after the help icon.
+     *
+     * @return string
+     */
+    public function get_after_icon(): string {
+        return implode('', $this->aftericon);
+    }
+
+    /**
+     * Get the replacement HTML, if one has been set.
+     *
+     * @return string|null
+     */
+    public function get_replacement(): ?string {
+        return $this->replacement;
+    }
+}
