@@ -360,6 +360,70 @@ final class logger_test extends \basic_testcase {
         // Remove the test dir and any content
         @remove_dir(dirname($file));
     }
+
+    /**
+     * Test file_logger stores relative paths (to $CFG->backuptempdir) and resolves them on the fly.
+     *
+     * @covers \file_logger
+     */
+    public function test_file_logger_relative_path(): void {
+        global $CFG;
+        $filename = 'test_file_logger_relative.log';
+        $lo = new mock_file_logger(backup::LOG_ERROR, true, true, $filename);
+        $this->assertEquals($filename, $lo->get_stored_path());
+        $this->assertEquals($CFG->backuptempdir . '/' . $filename, $lo->get_fullpath());
+        $this->assertTrue(file_exists($CFG->backuptempdir . '/' . $filename));
+        $this->assertTrue($lo->process('message1', backup::LOG_ERROR));
+
+        // Serialised logger must not contain the absolute path.
+        $serialised = serialize($lo);
+        $this->assertStringNotContainsString($CFG->backuptempdir, $serialised);
+        $this->assertStringContainsString($filename, $serialised);
+
+        // Absolute paths directly within backuptempdir are stored as relative ones too.
+        $lo2 = new mock_file_logger(backup::LOG_ERROR, true, true, $CFG->backuptempdir . '/' . $filename);
+        $this->assertEquals($filename, $lo2->get_stored_path());
+        $lo2->close();
+
+        $lo->close();
+        unlink($CFG->backuptempdir . '/' . $filename);
+
+        // Change the backuptempdir and unserialise: the path is rebuilt using the new directory.
+        $originalbackuptempdir = $CFG->backuptempdir;
+        $CFG->backuptempdir = $CFG->tempdir . '/backup_relocated_' . random_string(5);
+        try {
+            $restored = unserialize($serialised);
+            $this->assertEquals($filename, $restored->get_stored_path());
+            $this->assertEquals($CFG->backuptempdir . '/' . $filename, $restored->get_fullpath());
+            $this->assertTrue($restored->process('message2', backup::LOG_ERROR));
+            $restored->close();
+            $this->assertStringContainsString('message2', file_get_contents($CFG->backuptempdir . '/' . $filename));
+        } finally {
+            @remove_dir($CFG->backuptempdir);
+            $CFG->backuptempdir = $originalbackuptempdir;
+        }
+    }
+
+    /**
+     * Test file_logger unserialisation of legacy absolute paths.
+     *
+     * @covers \file_logger::__wakeup
+     */
+    public function test_file_logger_wakeup_legacy_absolute_path(): void {
+        global $CFG;
+        $filename = 'test_file_logger_legacy.log';
+        $lo = new mock_file_logger(backup::LOG_ERROR, true, true, $filename);
+        $lo->close();
+        // Simulate a logger serialised by an older version with an absolute (now missing) path.
+        $legacypath = $CFG->tempdir . '/nonexistent_' . random_string(5) . '/' . $filename;
+        $serialised = str_replace(serialize($filename), serialize($legacypath), serialize($lo));
+
+        $restored = unserialize($serialised);
+        $this->assertEquals($filename, $restored->get_stored_path());
+        $this->assertEquals($CFG->backuptempdir . '/' . $filename, $restored->get_fullpath());
+        $restored->close();
+        @unlink($CFG->backuptempdir . '/' . $filename);
+    }
 }
 
 
