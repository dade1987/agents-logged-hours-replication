diff --git a/public/backup/util/loggers/tests/logger_test.php b/public/backup/util/loggers/tests/logger_test.php
index 6cb5b54a4bc..1d5bcb02c68 100644
--- a/public/backup/util/loggers/tests/logger_test.php
